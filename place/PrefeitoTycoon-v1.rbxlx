		Category = "power", Tier = 2, Cost = 2500, W = 2, D = 2, PowerSupply = 60,
		Model = { Kind = "solar" },
	},
	{
		Id = "eolica", Name = "Usina Eólica", Desc = "Muita energia limpa.",
		Category = "power", Tier = 3, Cost = 15000, W = 2, D = 2, PowerSupply = 250,
		Model = { Kind = "wind" },
	},
	{
		Id = "termica", Name = "Usina Térmica", Desc = "Energia de sobra, poluição de sobra.",
		Category = "power", Tier = 4, Cost = 120000, W = 3, D = 3, PowerSupply = 1200, Jobs = 40,
		Pollution = 20, PollutionRadius = 8,
		Model = { Kind = "plant", Color = { 160, 160, 165 } },
	},
}

Buildings.List = list
Buildings.ById = {} :: { [string]: Building }
for index, def in list do
	(def :: any).Order = index
	Buildings.ById[def.Id] = def
end

function Buildings.Get(id: string): Building?
	return Buildings.ById[id]
end

-- Tamanho na grade depois de girar (rot 0..3; 1 e 3 trocam largura e profundidade)
function Buildings.Footprint(def: Building, rot: number): (number, number)
	if rot % 2 == 1 then
		return def.D, def.W
	end
	return def.W, def.D
end

return Buildings
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="97">
        <Properties>
          <string name="Name">CityMath</string>
          <string name="Source"><![CDATA[--[[
	CityMath (ModuleScript em ReplicatedStorage > Shared)          Prefeito Tycoon
	A conta da cidade: energia, felicidade, empregos, renda e quanta gente quer morar nela.
	PURO (sem API do Roblox): dá para testar no Lune. O servidor roda isso a cada passo da simulação
	e manda o resultado para o painel do jogador.

	API:
	  CityMath.TierFor(population) -> tier (tabela de Config.Tiers)
	  CityMath.Compute(state, ctx) -> Stats
	      ctx = { Population, Reelections?, DoubleIncome?, Visitors?, Event? (tabela de Config.Events) }
	  CityMath.StepPopulation(population, target, growth?) -> novaPopulação, quantosSaíram
	  CityMath.VaultCapacity(level, incomePerSec) -> $
]]

local Shared = script.Parent
local Config = require(Shared.Config)
local Buildings = require(Shared.Buildings)
local Grid = require(Shared.Grid)

local CityMath = {}

export type Stats = {
	Housing: number,
	Jobs: number,
	Workers: number,
	Staffing: number,
	PowerSupply: number,
	PowerDemand: number,
	PowerRatio: number,
	Happiness: number,
	TargetPopulation: number,
	IncomePerSec: number,
	Multiplier: number,
	Coverage: { [string]: number }, -- necessidade -> parte das moradias atendidas (0..1)
	NoRoad: { [number]: boolean }, -- uids dos prédios sem rua ligada
	NoRoadCount: number,
	Tier: number,
}

function CityMath.TierFor(population: number): any
	local best = Config.Tiers[1]
	for _, tier in Config.Tiers do
		if population >= tier.Population then
			best = tier
		end
	end
	return best
end

local function within(ax: number, az: number, bx: number, bz: number, radius: number): boolean
	return math.max(math.abs(ax - bx), math.abs(az - bz)) <= radius
end

function CityMath.Compute(state: Grid.State, ctx: any): Stats
	local population = math.max(0, tonumber(ctx.Population) or 0)
	local event = ctx.Event or {}
	local tier = CityMath.TierFor(population).Id
	local connected = Grid.Connected(state)

	local providers = {} -- { {cx, cz, need, radius} }
	local leisure = {} -- { {cx, cz, amount, radius} }
	local polluters = {}
	local homes = {} -- { {cx, cz, housing} }
	local noRoad: { [number]: boolean } = {}
	local noRoadCount = 0
	local supply, demand, jobs = 0, 0, 0
	local commerceIncome, industryIncome = 0, 0

	for uid, placed in state.Buildings do
		local def = Buildings.ById[placed.Id]
		if def and def.Category ~= "road" then
			local active = def.NoRoad == true or Grid.HasAccess(state, connected, placed)
			if not active then
				noRoad[uid] = true
				noRoadCount += 1
			else
				local cx, cz = Grid.Center(placed)
				supply += def.PowerSupply or 0
				demand += def.Power or 0
				jobs += def.Jobs or 0
				if def.Need then
					table.insert(providers, { cx, cz, def.Need, def.Radius or 0 })
				end
				if def.Leisure then
					table.insert(leisure, { cx, cz, def.Leisure, def.LeisureRadius or 0 })
				end
				if def.Pollution then
					table.insert(polluters, { cx, cz, def.Pollution, def.PollutionRadius or 0 })
				end
				if def.Housing then
					table.insert(homes, { cx, cz, def.Housing })
				end
				if def.Category == "commercial" then
					commerceIncome += def.Income or 0
				elseif def.Category == "industrial" then
					industryIncome += def.Income or 0
				end
			end
		end
	end

	supply *= event.Power or 1
	local powerRatio = if demand <= 0 then 1 else math.min(1, supply / demand)

	-- felicidade de cada moradia, pesada pelo número de vagas
	local H = Config.Happiness
	local activeNeeds = {}
	for _, need in Config.Needs do
		if tier >= need.Tier then
			table.insert(activeNeeds, need.Id)
		end
	end
	local coveredHousing: { [string]: number } = {}
	for _, need in Config.Needs do
		coveredHousing[need.Id] = 0
	end
	local housing = 0
	local happySum = 0
	local globalShift = (event.Happiness or 0) - H.NoPower * (1 - powerRatio)
	for _, home in homes do
		local hx, hz, size = home[1], home[2], home[3]
		local covered: { [string]: boolean } = {}
		for _, provider in providers do
			if not covered[provider[3]] and within(hx, hz, provider[1], provider[2], provider[4]) then
				covered[provider[3]] = true
			end
		end
		local score = H.Base
		for _, needId in activeNeeds do
			score += if covered[needId] then H.NeedCovered else -H.NeedMissing
		end
		for needId in covered do
			coveredHousing[needId] += size
		end
		local fun = 0
		for _, source in leisure do
			if within(hx, hz, source[1], source[2], source[4]) then
				fun += source[3]
			end
		end
		local dirt = 0
		for _, source in polluters do
			if within(hx, hz, source[1], source[2], source[4]) then
				dirt += source[3]
			end
		end
		score += math.min(fun, H.LeisureCap) - math.min(dirt, H.PollutionCap) + globalShift
		housing += size
		happySum += math.clamp(score, 0, 100) * size
	end
	local happiness = if housing > 0
		then happySum / housing
		else math.clamp(H.Base + globalShift, 0, 100)

	local coverage: { [string]: number } = {}
	for needId, amount in coveredHousing do
		coverage[needId] = if housing > 0 then amount / housing else 0
	end

	local P = Config.Population
	local fill = P.FillMin + (P.FillMax - P.FillMin) * happiness / 100
	local target = math.floor(housing * fill)

	local workers = math.floor(population * Config.WorkerShare)
	local staffing = if jobs > 0 then math.min(1, workers / jobs) else 0

	local multiplier = (1 + (tonumber(ctx.Reelections) or 0) * Config.Reelection.BonusPerTerm)
		* (if ctx.DoubleIncome then 2 else 1)
		* (event.Income or 1)
		* (1 + math.min(Config.Tourism.VisitorBonusCap, (tonumber(ctx.Visitors) or 0) * Config.Tourism.VisitorBonus))
	local income = population * Config.TaxPerResident * (event.Tax or 1)
		+ commerceIncome * staffing * (event.Commerce or 1)
		+ industryIncome * staffing * (event.Industry or 1)
	income *= (Config.PowerFloor + (1 - Config.PowerFloor) * powerRatio) * multiplier

	return {
		Housing = housing,
		Jobs = jobs,
		Workers = workers,
		Staffing = staffing,
		PowerSupply = supply,
		PowerDemand = demand,
		PowerRatio = powerRatio,
		Happiness = happiness,
		TargetPopulation = target,
		IncomePerSec = income,
		Multiplier = multiplier,
		Coverage = coverage,
		NoRoad = noRoad,
		NoRoadCount = noRoadCount,
		Tier = tier,
	}
end

function CityMath.StepPopulation(population: number, target: number, growth: number?): (number, number)
	local P = Config.Population
	if target > population then
		local add = math.max(1, math.ceil((target - population) * P.Step * (growth or 1)))
		return math.min(target, population + add), 0
	elseif target < population then
		local leaving = math.max(1, math.ceil((population - target) * P.LeaveStep))
		leaving = math.min(leaving, population - target)
		return population - leaving, leaving
	end
	return population, 0
end

function CityMath.VaultCapacity(level: number, incomePerSec: number): number
	local levels = Config.Vault.Levels
	local info = levels[math.clamp(level, 1, #levels)]
	return math.max(Config.Vault.MinCapacity * level, incomePerSec * 60 * info.Minutes)
end

return CityMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="98">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config (ModuleScript em ReplicatedStorage > Shared)          Prefeito Tycoon
	Todos os números do jogo num lugar só. PURO (sem API do Roblox): dá para testar no Lune.
	Mexer no balanceamento = mexer aqui. Os prédios ficam em Shared/Buildings.
]]

local Config = {}

Config.GameName = "Prefeito Tycoon"
Config.DataStoreName = "PrefeitoTycoon_v1"
Config.LeaderboardStores = {
	Stars = "PrefeitoTycoon_Stars_v1", -- recomendações recebidas (total)
	Population = "PrefeitoTycoon_Pop_v1", -- maior população já alcançada
}

-- ===== Mapa =====
Config.MaxPlayers = 8 -- um terreno por jogador
Config.GridSize = 24 -- terreno de 24 x 24 casas
Config.CellSize = 8 -- cada casa tem 8 studs
Config.LotRadius = 330 -- distância do centro do hub até o começo de cada terreno
Config.LotGroundY = 0 -- altura do chão dos terrenos (topo do chão)
Config.AvenueRow = 1 -- a fileira z = 1 é a Avenida (rua fixa, sempre ligada à Prefeitura)

-- Expansões do terreno: largura liberada (centralizada) e profundidade a partir da avenida
Config.Expansions = {
	{ Size = 12, Cost = 0 },
	{ Size = 16, Cost = 7500 },
	{ Size = 20, Cost = 90000 },
	{ Size = 24, Cost = 900000 },
}

-- ===== Economia =====
Config.StartCash = 1500
Config.SimInterval = 5 -- segundos entre cada passo da simulação da cidade
Config.TaxPerResident = 0.2 -- $ por morador por segundo
Config.WorkerShare = 0.6 -- parte da população que trabalha
Config.SellRefund = 0.5 -- demolir devolve 50% do preço
Config.PowerFloor = 0.4 -- sem energia nenhuma a cidade ainda rende 40% (nunca trava o jogador sem dinheiro)
Config.MaxCash = 1e15

-- Cofre da Prefeitura: a renda cai nele e o jogador precisa ir lá coletar (o loop do tycoon).
-- Capacidade = minutos de renda que cabem. Offline o cofre continua enchendo (com OfflineRate).
Config.Vault = {
	MinCapacity = 1500,
	Levels = {
		{ Minutes = 5, Cost = 0 },
		{ Minutes = 10, Cost = 4000 },
		{ Minutes = 20, Cost = 35000 },
		{ Minutes = 45, Cost = 300000 },
		{ Minutes = 120, Cost = 2500000 },
	},
	OfflineRate = 0.5,
	OfflineMaxHours = 12,
}

-- ===== Cidade =====
-- Níveis da cidade pela população: liberam prédios novos e novas necessidades dos moradores
Config.Tiers = {
	{ Id = 1, Name = "Vila", Population = 0 },
	{ Id = 2, Name = "Cidade", Population = 150 },
	{ Id = 3, Name = "Cidade Grande", Population = 1000 },
	{ Id = 4, Name = "Metrópole", Population = 5000 },
	{ Id = 5, Name = "Megalópole", Population = 20000 },
}

-- Necessidades: a partir de qual nível a falta dela começa a deixar o morador infeliz
Config.Needs = {
	{ Id = "comercio", Name = "Comércio", Tier = 1 },
	{ Id = "saude", Name = "Saúde", Tier = 1 },
	{ Id = "seguranca", Name = "Segurança", Tier = 2 },
	{ Id = "educacao", Name = "Educação", Tier = 2 },
}

Config.Happiness = {
	Base = 50,
	NeedCovered = 8, -- por necessidade atendida
	NeedMissing = 9, -- por necessidade em falta
	LeisureCap = 25, -- bônus máximo de lazer
	PollutionCap = 40, -- castigo máximo de poluição
	NoPower = 15, -- castigo inteiro quando falta energia (proporcional ao que falta)
	Unhappy = 40, -- abaixo disso os moradores começam a se mudar
	Attractive = 60, -- cidades a partir disso recebem quem se muda
}

Config.Population = {
	FillMin = 0.3, -- ocupação das casas com felicidade 0
	FillMax = 1.0, -- ocupação com felicidade 100
	Step = 0.2, -- quanto da diferença para a meta muda por passo
	LeaveStep = 0.2, -- parte dos insatisfeitos que vai embora por passo
}

-- ===== Reeleição (rebirth) =====
Config.Reelection = {
	Population = 5000, -- precisa ser Metrópole
	BonusPerTerm = 0.5, -- +50% de renda por mandato
	KeepStars = true,
}

-- ===== Turismo =====
Config.Tourism = {
	VisitorBonus = 0.05, -- +5% de renda por visitante na sua cidade
	VisitorBonusCap = 0.25,
	RecommendRewardSeconds = 60, -- quem recomenda ganha 60 s da própria renda
	RecommendMinReward = 100,
	OwnerRewardSeconds = 30, -- o dono ganha 30 s da renda dele
}

-- ===== Eventos globais (valem para todas as cidades do servidor) =====
Config.EventEvery = 600 -- segundos entre eventos
Config.EventDuration = 120
Config.Events = {
	{
		Id = "apagao",
		Name = "Apagão Regional",
		Text = "A rede caiu: as usinas produzem 40% a menos. Tenha energia sobrando!",
		Power = 0.6,
	},
	{
		Id = "feriado",
		Name = "Feriadão",
		Text = "Comércio vende o dobro, mas as indústrias param pela metade.",
		Commerce = 2,
		Industry = 0.5,
	},
	{
		Id = "calor",
		Name = "Onda de Calor",
		Text = "Todo mundo de mau humor: -12 de felicidade. Parques ajudam.",
		Happiness = -12,
	},
	{
		Id = "boom",
		Name = "Boom Imobiliário",
		Text = "Gente chegando: a população cresce 3x mais rápido e os impostos rendem +50%.",
		Growth = 3,
		Tax = 1.5,
	},
	{
		Id = "investidores",
		Name = "Rodada de Investimento",
		Text = "Investidores no hub: toda renda +30%.",
		Income = 1.3,
	},
}

-- ===== Nomes de cidade (sem texto livre: nada para filtrar) =====
Config.CityNameA = {
	"Nova", "Vila", "Porto", "São", "Santa", "Alto", "Campo", "Serra", "Monte", "Ribeirão",
	"Lago", "Rio", "Vale", "Ponta", "Barra", "Bela",
}
Config.CityNameB = {
	"Esperança", "Aurora", "Horizonte", "Dourada", "do Sol", "Verde", "das Pedras", "Alegre",
	"do Norte", "do Sul", "Brilhante", "dos Ventos", "Azul", "Serena", "Imperial", "Neon",
}

-- ===== Loja (0 = desligado; troque pelos Ids publicados no Creator Hub) =====
Config.GamePasses = {
	DoubleIncome = 0, -- renda x2
	AutoCollect = 0, -- o cofre cai direto no bolso
}
Config.DevProducts = {
	-- dinheiro = minutos da renda atual (mínimo garantido)
	{ Id = 0, Minutes = 10, Min = 5000 },
	{ Id = 0, Minutes = 60, Min = 40000 },
}

-- ===== Sons (sons oficiais e grátis da Roblox, os mesmos do Steal a Critter) =====
Config.Sounds = {
	Place = { Id = "rbxassetid://15675059323", Volume = 0.5, Speed = 1 }, -- Roblox_UI_Bright_Click
	Remove = { Id = "rbxassetid://15675075163", Volume = 0.5, Speed = 0.9 }, -- Roblox_UI_Delete
	Coin = { Id = "rbxassetid://127645268874265", Volume = 0.55, Speed = 1.2 }, -- CoinTransfer_01
	Click = { Id = "rbxassetid://15675032796", Volume = 0.4, Speed = 1 }, -- Roblox_UI_Small_Click
	Error = { Id = "rbxassetid://15675075163", Volume = 0.4, Speed = 0.8 },
	Upgrade = { Id = "rbxassetid://15675043410", Volume = 0.8, Speed = 1.1 }, -- Roblox_UI_Tonal_Stinger
	Fanfare = { Id = "rbxassetid://12222253", Volume = 0.7, Speed = 1 }, -- victory.wav
	Alert = { Id = "rbxassetid://17208361335", Volume = 0.6, Speed = 1 }, -- Notification High
	Whoosh = { Id = "rbxassetid://15675024286", Volume = 0.5, Speed = 1 }, -- Roblox_UI_Whoosh_01
}
Config.Music = { "rbxassetid://15675069601" } -- Roblox_UI_Loop_Calm_Music
Config.MusicVolume = 0.12

-- ===== Segurança =====
Config.ActionCooldown = 0.08 -- intervalo mínimo entre pedidos de construir/demolir
Config.AutosaveEvery = 60

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="99">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--[[
	Format (ModuleScript em ReplicatedStorage > Shared)          Prefeito Tycoon
	Números e tempos em texto. PURO (sem API do Roblox): dá para testar no Lune.

	API:
	  Format.Number(n, decimals?, thousandsSep?, decimalSep?) -> "1,234" / "1.234,5"
	  Format.Int(n, thousandsSep?)  -> inteiro com separador de milhar (arredonda para baixo)
	  Format.Short(n)               -> "1.5K", "2.3M" (placas e placares com pouco espaço)
	  Format.Time(seconds)          -> "4:05" (minutos:segundos, para contagens)
	  Format.Money(n)               -> "$1.5K" (dinheiro curto)
	  Format.Percent(p)             -> "88%" (p de 0 a 100)
]]

local Format = {}

function Format.Number(n: number, decimals: number?, thousandsSep: string?, decimalSep: string?): string
	if n ~= n or n == math.huge or n == -math.huge then
		return "0"
	end
	local places = decimals or 0
	local negative = n < 0
	n = math.abs(n)
	local scale = 10 ^ places
	local scaled = math.floor(n * scale + 0.5)
	local intPart = math.floor(scaled / scale)
	local fracPart = scaled - intPart * scale
	local digits = string.format("%d", intPart)
	local sep = thousandsSep or ","
	local out = digits
	if sep ~= "" and #digits > 3 then
		local first = #digits % 3
		local pieces = {}
		if first > 0 then
			table.insert(pieces, string.sub(digits, 1, first))
		end
		for i = first + 1, #digits, 3 do
			table.insert(pieces, string.sub(digits, i, i + 2))
		end
		out = table.concat(pieces, sep)
	end
	if places > 0 then
		out ..= (decimalSep or ".") .. string.format("%0" .. places .. "d", fracPart)
	end
	if negative and scaled > 0 then
		out = "-" .. out
	end
	return out
end

function Format.Int(n: number, thousandsSep: string?): string
	if n ~= n then
		return "0"
	end
	local whole = if n >= 0 then math.floor(n) else -math.floor(-n)
	return Format.Number(whole, 0, thousandsSep)
end

local SUFFIXES = { "", "K", "M", "B", "T" }

function Format.Short(n: number): string
	if n ~= n then
		return "0"
	end
	local negative = n < 0
	n = math.floor(math.abs(n))
	local text
	if n < 1000 then
		text = tostring(n)
	else
		local index = 1
		local value = n
		while value >= 1000 and index < #SUFFIXES do
			value /= 1000
			index += 1
		end
		if value >= 100 then
			text = string.format("%d", math.floor(value + 1e-9))
		elseif value >= 10 then
			text = string.format("%.1f", math.floor(value * 10 + 1e-6) / 10)
		else
			text = string.format("%.2f", math.floor(value * 100 + 1e-6) / 100)
		end
		if string.find(text, ".", 1, true) then
			text = string.gsub(text, "0+$", "")
			text = string.gsub(text, "%.$", "")
		end
		text ..= SUFFIXES[index]
	end
	return (if negative then "-" else "") .. text
end

function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

function Format.Money(n: number): string
	return "$" .. Format.Short(n)
end

function Format.Percent(p: number): string
	if p ~= p then
		return "0%"
	end
	return string.format("%d%%", math.floor(p + 0.5))
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="100">
        <Properties>
          <string name="Name">Grid</string>
          <string name="Source"><![CDATA[--[[
	Grid (ModuleScript em ReplicatedStorage > Shared)          Prefeito Tycoon
	A grade de um terreno: onde dá para construir, quem ocupa cada casa, ruas ligadas à Avenida.
	PURO (sem API do Roblox): dá para testar no Lune. O servidor e o cliente usam as mesmas regras.

	Coordenadas: x de 1 a N (esquerda -> direita olhando do hub), z de 1 a N (da avenida para o fundo).
	A fileira z = 1 é a Avenida: rua fixa que não se constrói nem se demole. Os prédios são guardados
	pela casa do canto (menor x, menor z) + rotação 0..3.

	API:
	  Grid.new() -> State
	  Grid.Bounds(level) -> x1, x2, z1, z2         área liberada pela expansão
	  Grid.CanPlace(state, level, def, x, z, rot) -> ok, motivo?
	  Grid.Place(state, def, x, z, rot) -> uid      (não confere nada: chame CanPlace antes)
	  Grid.Remove(state, uid) -> Placed?
	  Grid.At(state, x, z) -> uid?
	  Grid.Connected(state) -> { [cellIndex]: true }  ruas ligadas à Avenida (inclui a Avenida)
	  Grid.HasAccess(state, connected, placed) -> boolean
	  Grid.Serialize(state) -> { "id,x,z,r" }
	  Grid.Deserialize(list, level) -> State        (ignora o que for inválido)
	  Grid.Center(placed) -> cx, cz                 centro do prédio em "casas" (pode ser .5)
	  Grid.LocalPosition(cx, cz) -> lx, lz          em studs, relativo à frente-centro do terreno
]]

local Shared = script.Parent
local Config = require(Shared.Config)
local Buildings = require(Shared.Buildings)

export type Placed = { Uid: number, Id: string, X: number, Z: number, R: number, W: number, D: number }
export type State = { Buildings: { [number]: Placed }, Cells: { [number]: number }, NextUid: number, Count: number }

local Grid = {}

local N = Config.GridSize
local AVENUE = Config.AvenueRow

function Grid.new(): State
	return { Buildings = {}, Cells = {}, NextUid = 1, Count = 0 }
end

function Grid.Index(x: number, z: number): number
	return (z - 1) * N + x
end

function Grid.Bounds(level: number): (number, number, number, number)
	local expansions = Config.Expansions
	local info = expansions[math.clamp(level, 1, #expansions)]
	local size = math.min(info.Size, N)
	local x1 = math.floor((N - size) / 2) + 1
	return x1, x1 + size - 1, AVENUE + 1, math.min(N, AVENUE + size)
end

function Grid.At(state: State, x: number, z: number): number?
	if x < 1 or x > N or z < 1 or z > N then
		return nil -- fora da grade (sem isso o índice "dava a volta" para outra fileira)
	end
	return state.Cells[Grid.Index(x, z)]
end

function Grid.CanPlace(state: State, level: number, def: Buildings.Building?, x: number, z: number, rot: number): (boolean, string?)
	if not def then
		return false, "Prédio desconhecido"
	end
	if type(x) ~= "number" or type(z) ~= "number" or type(rot) ~= "number" then
		return false, "Posição inválida"
	end
	if x ~= math.floor(x) or z ~= math.floor(z) or rot ~= math.floor(rot) or rot < 0 or rot > 3 then
		return false, "Posição inválida"
	end
	local w, d = Buildings.Footprint(def, rot)
	local x1, x2, z1, z2 = Grid.Bounds(level)
	if x < x1 or z < z1 or x + w - 1 > x2 or z + d - 1 > z2 then
		return false, "Fora do terreno liberado"
	end
	for dz = 0, d - 1 do
		for dx = 0, w - 1 do
			if state.Cells[Grid.Index(x + dx, z + dz)] then
				return false, "Espaço ocupado"
			end
		end
	end
	return true, nil
end

function Grid.Place(state: State, def: Buildings.Building, x: number, z: number, rot: number): number
	local w, d = Buildings.Footprint(def, rot)
	local uid = state.NextUid
	state.NextUid += 1
	state.Buildings[uid] = { Uid = uid, Id = def.Id, X = x, Z = z, R = rot, W = w, D = d }
	state.Count += 1
	for dz = 0, d - 1 do
		for dx = 0, w - 1 do
			state.Cells[Grid.Index(x + dx, z + dz)] = uid
		end
	end
	return uid
end

function Grid.Remove(state: State, uid: number): Placed?
	local placed = state.Buildings[uid]
	if not placed then
		return nil
	end
	for dz = 0, placed.D - 1 do
		for dx = 0, placed.W - 1 do
			local index = Grid.Index(placed.X + dx, placed.Z + dz)
			if state.Cells[index] == uid then
				state.Cells[index] = nil
			end
		end
	end
	state.Buildings[uid] = nil
	state.Count -= 1
	return placed
end

local function isRoad(state: State, x: number, z: number): boolean
	if z == AVENUE then
		return true
	end
	local uid = state.Cells[Grid.Index(x, z)]
	if not uid then
		return false
	end
	local placed = state.Buildings[uid]
	if not placed then
		return false
	end
	local def = Buildings.ById[placed.Id]
	return def ~= nil and def.Category == "road"
end

-- Ruas ligadas à Avenida (busca em largura a partir de toda a fileira da Avenida)
function Grid.Connected(state: State): { [number]: boolean }
	local connected: { [number]: boolean } = {}
	local queue: { number } = {}
	for x = 1, N do
		local index = Grid.Index(x, AVENUE)
		connected[index] = true
		table.insert(queue, index)
	end
	local head = 1
	while head <= #queue do
		local index = queue[head]
		head += 1
		local x = (index - 1) % N + 1
		local z = (index - 1) // N + 1
		for _, step in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
			local nx, nz = x + step[1], z + step[2]
			if nx >= 1 and nx <= N and nz >= 1 and nz <= N then
				local nextIndex = Grid.Index(nx, nz)
				if not connected[nextIndex] and isRoad(state, nx, nz) then
					connected[nextIndex] = true
					table.insert(queue, nextIndex)
				end
			end
		end
	end
	return connected
end

-- O prédio encosta (de lado, não na diagonal) em alguma rua ligada?
function Grid.HasAccess(_state: State, connected: { [number]: boolean }, placed: Placed): boolean
	local function check(x: number, z: number): boolean
		return x >= 1 and x <= N and z >= 1 and z <= N and connected[Grid.Index(x, z)] == true
	end
	for dx = 0, placed.W - 1 do
		if check(placed.X + dx, placed.Z - 1) or check(placed.X + dx, placed.Z + placed.D) then
			return true
		end
	end
	for dz = 0, placed.D - 1 do
		if check(placed.X - 1, placed.Z + dz) or check(placed.X + placed.W, placed.Z + dz) then
			return true
		end
	end
	return false
end

function Grid.Center(placed: Placed): (number, number)
	return placed.X + (placed.W - 1) / 2, placed.Z + (placed.D - 1) / 2
end

-- Centro de uma casa (ou de um prédio, com cx/cz fracionários) em studs, relativo à frente-centro
-- do terreno. +X vai para a direita, +Z vai da avenida para o fundo.
function Grid.LocalPosition(cx: number, cz: number): (number, number)
	local cell = Config.CellSize
	return (cx - 0.5) * cell - N * cell / 2, (cz - 0.5) * cell
end

-- Casa da grade de um ponto local (inverso de LocalPosition). Pode cair fora de 1..N.
function Grid.CellAt(lx: number, lz: number): (number, number)
	local cell = Config.CellSize
	return math.floor((lx + N * cell / 2) / cell) + 1, math.floor(lz / cell) + 1
end

function Grid.Serialize(state: State): { string }
	local uids = {}
	for uid in state.Buildings do
		table.insert(uids, uid)
	end
	table.sort(uids)
	local out = table.create(#uids)
	for _, uid in uids do
		local placed = state.Buildings[uid]
		table.insert(out, string.format("%s,%d,%d,%d", placed.Id, placed.X, placed.Z, placed.R))
	end
	return out
end

function Grid.Deserialize(list: any, level: number): State
	local state = Grid.new()
	if type(list) ~= "table" then
		return state
	end
	for _, entry in list do
		if type(entry) == "string" then
			local id, xs, zs, rs = string.match(entry, "^([%w_]+),(%-?%d+),(%-?%d+),(%d)$")
			local def = id and Buildings.ById[id]
			if def then
				local x, z, rot = tonumber(xs) :: number, tonumber(zs) :: number, tonumber(rs) :: number
				if Grid.CanPlace(state, level, def, x, z, rot) then
					Grid.Place(state, def, x, z, rot)
				end
			end
		end
	end
	return state
end

return Grid
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="101">
        <Properties>
          <string name="Name">LotLayout</string>
          <string name="Source"><![CDATA[--[[
	LotLayout (ModuleScript em ReplicatedStorage > Shared)          Prefeito Tycoon
	Onde fica cada terreno no mundo. Servidor e cliente usam as mesmas contas.

	Os terrenos ficam em volta do hub (centro em 0, 0, 0). Cada terreno tem um CFrame na
	"frente-centro" (onde começa a Avenida): o -Z local olha para o hub e o +Z vai para o fundo.

	API:
	  LotLayout.CFrame(index) -> CFrame
	  LotLayout.CellCFrame(index, cx, cz) -> CFrame      centro de uma casa (ou de um prédio)
	  LotLayout.BuildingCFrame(index, placed) -> CFrame  centro + giro do prédio
	  LotLayout.SpawnCFrame(index) -> CFrame             onde o jogador aparece na cidade
	  LotLayout.ToCell(index, worldPosition) -> x, z     casa da grade embaixo de um ponto
	  LotLayout.Contains(index, worldPosition, margin?) -> boolean
]]

local Shared = script.Parent
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)

local LotLayout = {}

local cache: { [number]: CFrame } = {}

function LotLayout.CFrame(index: number): CFrame
	local cached = cache[index]
	if cached then
		return cached
	end
	local angle = (index - 1) * 2 * math.pi / Config.MaxPlayers
	local dir = Vector3.new(math.sin(angle), 0, math.cos(angle))
	local pos = dir * Config.LotRadius + Vector3.new(0, Config.LotGroundY, 0)
	-- girar em Y pelo próprio ângulo deixa o -Z local apontando para o hub (igual a lookAt(pos, pos - dir))
	local cf = CFrame.new(pos) * CFrame.Angles(0, angle, 0)
	cache[index] = cf
	return cf
end

function LotLayout.CellCFrame(index: number, cx: number, cz: number): CFrame
	local lx, lz = Grid.LocalPosition(cx, cz)
	return LotLayout.CFrame(index) * CFrame.new(lx, 0, lz)
end

function LotLayout.BuildingCFrame(index: number, placed: any): CFrame
	local cx, cz = Grid.Center(placed)
	return LotLayout.CellCFrame(index, cx, cz) * CFrame.Angles(0, -placed.R * math.pi / 2, 0)
end

function LotLayout.SpawnCFrame(index: number): CFrame
	return LotLayout.CFrame(index) * CFrame.new(0, 4, -50) * CFrame.Angles(0, math.pi, 0)
end

function LotLayout.ToCell(index: number, position: Vector3): (number, number)
	local p = LotLayout.CFrame(index):PointToObjectSpace(position)
	return Grid.CellAt(p.X, p.Z)
end

-- O ponto está dentro do terreno (grade + a área da Prefeitura na frente)?
function LotLayout.Contains(index: number, position: Vector3, margin: number?): boolean
	local p = LotLayout.CFrame(index):PointToObjectSpace(position)
	local half = Config.GridSize * Config.CellSize / 2
	local extra = margin or 0
	return math.abs(p.X) <= half + extra and p.Z >= -60 - extra and p.Z <= half * 2 + extra
end

return LotLayout
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="102">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="103">
      <Properties>
        <string name="Name">Game</string>
      </Properties>
      <Item class="ModuleScript" referent="104">
        <Properties>
          <string name="Name">City</string>
          <string name="Source"><![CDATA[--[[
	City (ModuleScript em ServerScriptService > Game)          Prefeito Tycoon
	A cidade de cada jogador enquanto ele joga: construir, demolir, simulação, cofre, expansões,
	migração de moradores entre cidades, turismo e reeleição.

	Tudo que o jogador pede chega em City.HandleRequest(player, ação, dados) e é conferido aqui
	(o cliente só desenha e pede). A conta da cidade é a mesma do painel: Shared/CityMath.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Buildings = require(Shared.Buildings)
local Grid = require(Shared.Grid)
local CityMath = require(Shared.CityMath)
local Format = require(Shared.Format)
local LotLayout = require(Shared.LotLayout)

local Game = script.Parent
local Data = require(Game.Data)
local Remotes = require(Game.Remotes)
local Lots = require(Game.Lots)
local Events = require(Game.Events)

local City = {}

type CityT = {
	Player: Player,
	Data: any,
	Lot: number,
	State: Grid.State,
	Population: number,
	Stats: CityMath.Stats,
	Visitors: number,
	Passes: { [string]: boolean },
	Cooldowns: { [string]: number },
	Notices: { [string]: number },
}

local cities: { [Player]: CityT } = {}

local function now(): number
	return os.clock()
end

local function today(): number
	return os.time() // 86400
end

local function cityName(data: any): string
	local a = Config.CityNameA[data.NameA] or Config.CityNameA[1]
	local b = Config.CityNameB[data.NameB] or Config.CityNameB[1]
	return a .. " " .. b
end

-- Avisos que não podem virar spam (cofre cheio, migração...): no máximo um a cada `every` segundos
local function noticeOnce(city: CityT, key: string, every: number, text: string, kind: string?)
	local t = now()
	if (city.Notices[key] or -math.huge) + every > t then
		return
	end
	city.Notices[key] = t
	Remotes.Notify(city.Player, text, kind)
end

local function cooldown(city: CityT, key: string, seconds: number): boolean
	local t = now()
	if (city.Cooldowns[key] or -math.huge) + seconds > t then
		return false
	end
	city.Cooldowns[key] = t
	return true
end

local function addCash(city: CityT, amount: number)
	local data = city.Data
	data.Cash = math.min(Config.MaxCash, data.Cash + amount)
	if amount > 0 then
		data.TotalEarned += amount
	end
end

local function compute(city: CityT): CityMath.Stats
	city.Stats = CityMath.Compute(city.State, {
		Population = city.Population,
		Reelections = city.Data.Reelections,
		DoubleIncome = city.Passes.DoubleIncome,
		Visitors = city.Visitors,
		Event = Events.Current(),
	})
	return city.Stats
end

local function vaultCapacity(city: CityT): number
	return CityMath.VaultCapacity(city.Data.VaultLevel, city.Stats.IncomePerSec)
end

local function refreshVaultText(city: CityT)
	if city.Passes.AutoCollect then
		Lots.SetVaultText(city.Lot, "COLETA AUTOMÁTICA")
		return
	end
	Lots.SetVaultText(city.Lot, Format.Money(city.Data.Vault) .. " / " .. Format.Money(vaultCapacity(city)))
end

function City.Sync(player: Player)
	local city = cities[player]
	if not city then
		return
	end
	local data = city.Data
	local stats = city.Stats
	local event = Events.Current()
	local nextExpansion = Config.Expansions[data.Expansion + 1]
	local nextVault = Config.Vault.Levels[data.VaultLevel + 1]
	Remotes.Stats:FireClient(player, {
		Lot = city.Lot,
		CityName = cityName(data),
		NameA = data.NameA,
		NameB = data.NameB,
		Cash = data.Cash,
		Vault = data.Vault,
		VaultCapacity = vaultCapacity(city),
		VaultLevel = data.VaultLevel,
		NextVaultCost = if nextVault then nextVault.Cost else nil,
		Expansion = data.Expansion,
		NextExpansionCost = if nextExpansion then nextExpansion.Cost else nil,
		Income = stats.IncomePerSec,
		Multiplier = stats.Multiplier,
		Population = city.Population,
		Target = stats.TargetPopulation,
		Housing = stats.Housing,
		Jobs = stats.Jobs,
		Workers = stats.Workers,
		Happiness = stats.Happiness,
		PowerSupply = stats.PowerSupply,
		PowerDemand = stats.PowerDemand,
		Coverage = stats.Coverage,
		NoRoad = stats.NoRoadCount,
		Tier = stats.Tier,
		TierReached = data.TierReached,
		Reelections = data.Reelections,
		Stars = data.Stars,
		Visitors = city.Visitors,
		Event = if event then event.Id else "",
		AutoCollect = city.Passes.AutoCollect == true,
		DoubleIncome = city.Passes.DoubleIncome == true,
		Tutorial = data.Tutorial,
	})
end

local function publish(city: CityT)
	local data = city.Data
	Lots.SetInfo(city.Lot, {
		CityName = cityName(data),
		Population = math.floor(city.Population),
		Stars = data.Stars,
		Happiness = math.floor(city.Stats.Happiness + 0.5),
	})
	local stats = city.Player:FindFirstChild("leaderstats")
	if stats then
		(stats :: any)["População"].Value = math.floor(city.Population);
		(stats :: any).Estrelas.Value = data.Stars
	end
	city.Player:SetAttribute("Population", math.floor(city.Population))
	city.Player:SetAttribute("PeakPopulation", data.PeakPopulation)
	city.Player:SetAttribute("Stars", data.Stars)
	refreshVaultText(city)
end

-- ======== Construção ========

local function placeOne(city: CityT, def: Buildings.Building, x: number, z: number, rot: number): (boolean, string?)
	local data = city.Data
	if def.Tier > data.TierReached then
		return false, def.Name .. " libera no nível " .. Config.Tiers[def.Tier].Name
	end
	local ok, reason = Grid.CanPlace(city.State, data.Expansion, def, x, z, rot)
	if not ok then
		return false, reason
	end
	if data.Cash < def.Cost then
		return false, "Falta dinheiro (" .. Format.Money(def.Cost) .. ")"
	end
	addCash(city, -def.Cost)
	local uid = Grid.Place(city.State, def, x, z, rot)
	Lots.Render(city.Lot, city.State.Buildings[uid])
	return true, nil
end

local function afterBuild(city: CityT)
	compute(city)
	Lots.SetWarnings(city.Lot, city.Stats.NoRoad)
	publish(city)
	City.Sync(city.Player)
end

local actions: { [string]: (CityT, any) -> () } = {}

actions.place = function(city, payload)
	if type(payload) ~= "table" or not cooldown(city, "build", Config.ActionCooldown) then
		return
	end
	local def = Buildings.ById[payload.Id]
	if not def then
		return
	end
	local ok, reason = placeOne(city, def, payload.X, payload.Z, payload.R)
	if ok then
		Remotes.Effect(city.Player, "placed", def.Id)
		afterBuild(city)
	else
		Remotes.Notify(city.Player, reason or "Não dá para construir aí", "erro")
	end
end

-- Arrastar ruas (e outros prédios 1x1): várias casas num pedido só
actions.line = function(city, payload)
	if type(payload) ~= "table" or type(payload.Cells) ~= "table" or not cooldown(city, "build", Config.ActionCooldown) then
		return
	end
	local def = Buildings.ById[payload.Id]
	if not def or def.W ~= 1 or def.D ~= 1 then
		return
	end
	local placedCount = 0
	local lastReason = nil
	for i, cell in payload.Cells do
		if i > 48 then
			break
		end
		if type(cell) == "table" then
			local ok, reason = placeOne(city, def, cell[1], cell[2], tonumber(payload.R) or 0)
			if ok then
				placedCount += 1
			else
				lastReason = reason
				if city.Data.Cash < def.Cost then
					break
				end
			end
		end
	end
	if placedCount > 0 then
		Remotes.Effect(city.Player, "placed", def.Id)
		afterBuild(city)
	elseif lastReason then
		Remotes.Notify(city.Player, lastReason, "erro")
	end
end

actions.remove = function(city, payload)
	if type(payload) ~= "table" or not cooldown(city, "build", Config.ActionCooldown) then
		return
	end
	local uids = if type(payload.Uids) == "table" then payload.Uids else { payload.Uid }
	local removed = 0
	for i, uid in uids do
		if i > 48 then
			break
		end
		local placed = type(uid) == "number" and city.State.Buildings[uid]
		if placed then
			local def = Buildings.ById[placed.Id]
			Grid.Remove(city.State, uid)
			Lots.Unrender(city.Lot, uid)
			if def then
				addCash(city, math.floor(def.Cost * Config.SellRefund))
			end
			removed += 1
		end
	end
	if removed > 0 then
		Remotes.Effect(city.Player, "removed", removed)
		afterBuild(city)
	end
end

-- Só pelo ProximityPrompt do cofre (Lots.OnVault): não é uma ação do Request, senão dava para coletar de longe
local function collectVault(city: CityT)
	local data = city.Data
	if data.Vault < 1 then
		return
	end
	local amount = math.floor(data.Vault)
	data.Vault -= amount
	addCash(city, amount)
	Remotes.Effect(city.Player, "collect", amount)
	refreshVaultText(city)
	City.Sync(city.Player)
end

actions.expand = function(city, _payload)
	local data = city.Data
	local nextInfo = Config.Expansions[data.Expansion + 1]
	if not nextInfo or not cooldown(city, "buy", 0.5) then
		return
	end
	if data.Cash < nextInfo.Cost then
		Remotes.Notify(city.Player, "Falta dinheiro para expandir (" .. Format.Money(nextInfo.Cost) .. ")", "erro")
		return
	end
	addCash(city, -nextInfo.Cost)
	data.Expansion += 1
	Lots.SetExpansion(city.Lot, data.Expansion)
	Remotes.Notify(city.Player, "Terreno expandido para " .. nextInfo.Size .. "x" .. nextInfo.Size .. "!", "ok")
	Remotes.Effect(city.Player, "upgrade")
	afterBuild(city)
end

actions.vault = function(city, _payload)
	local data = city.Data
	local nextInfo = Config.Vault.Levels[data.VaultLevel + 1]
	if not nextInfo or not cooldown(city, "buy", 0.5) then
		return
	end
	if data.Cash < nextInfo.Cost then
		Remotes.Notify(city.Player, "Falta dinheiro para o cofre (" .. Format.Money(nextInfo.Cost) .. ")", "erro")
		return
	end
	addCash(city, -nextInfo.Cost)
	data.VaultLevel += 1
	Remotes.Notify(city.Player, "Cofre maior: guarda " .. nextInfo.Minutes .. " min de renda.", "ok")
	Remotes.Effect(city.Player, "upgrade")
	refreshVaultText(city)
	City.Sync(city.Player)
end

actions.rename = function(city, payload)
	if type(payload) ~= "table" or not cooldown(city, "rename", 3) then
		return
	end
	local a, b = tonumber(payload.A), tonumber(payload.B)
	if not a or not b or not Config.CityNameA[a] or not Config.CityNameB[b] then
		return
	end
	city.Data.NameA, city.Data.NameB = a, b
	publish(city)
	City.Sync(city.Player)
end

actions.reelect = function(city, _payload)
	local data = city.Data
	if city.Population < Config.Reelection.Population or not cooldown(city, "reelect", 5) then
		Remotes.Notify(city.Player, "A reeleição pede " .. Format.Int(Config.Reelection.Population, ".") .. " moradores.", "erro")
		return
	end
	for uid in city.State.Buildings do
		Lots.Unrender(city.Lot, uid)
	end
	city.State = Grid.new()
	city.Population = 0
	data.Reelections += 1
	data.Cash = Config.StartCash
	data.Vault = 0
	data.VaultLevel = 1
	data.Expansion = 1
	data.TierReached = 1
	data.Population = 0
	data.Buildings = {}
	Lots.SetExpansion(city.Lot, 1)
	Remotes.NotifyAll(city.Player.DisplayName .. " foi reeleito prefeito de " .. cityName(data) .. "! (" .. data.Reelections .. "º mandato)", "evento")
	Remotes.Effect(city.Player, "reelected", data.Reelections)
	afterBuild(city)
end

local function teleport(player: Player, lot: number)
	local character = player.Character
	if character and character.PrimaryPart then
		character:PivotTo(LotLayout.SpawnCFrame(lot))
	end
end

actions.home = function(city, _payload)
	if cooldown(city, "teleport", 1.5) then
		teleport(city.Player, city.Lot)
	end
end

actions.visit = function(city, payload)
	local lot = type(payload) == "table" and tonumber(payload.Lot)
	if not lot or not Lots.OwnerOf(lot) or not cooldown(city, "teleport", 1.5) then
		return
	end
	teleport(city.Player, lot)
end

actions.recommend = function(city, payload)
	local lot = type(payload) == "table" and tonumber(payload.Lot)
	local owner = lot and Lots.OwnerOf(lot)
	local target = owner and cities[owner]
	if not target or target == city or not cooldown(city, "recommend", 1) then
		return
	end
	local data = city.Data
	if data.Recommended.Day ~= today() then
		data.Recommended = { Day = today(), Users = {} }
	end
	if table.find(data.Recommended.Users, owner.UserId) then
		Remotes.Notify(city.Player, "Você já recomendou essa cidade hoje.", "erro")
		return
	end
	table.insert(data.Recommended.Users, owner.UserId)
	target.Data.Stars += 1
	local T = Config.Tourism
	local mine = math.max(T.RecommendMinReward, math.floor(city.Stats.IncomePerSec * T.RecommendRewardSeconds))
	local theirs = math.max(T.RecommendMinReward, math.floor(target.Stats.IncomePerSec * T.OwnerRewardSeconds))
	addCash(city, mine)
	addCash(target, theirs)
	Remotes.Notify(city.Player, "Você recomendou " .. cityName(target.Data) .. " e ganhou " .. Format.Money(mine) .. "!", "ok")
	Remotes.Notify(owner, city.Player.DisplayName .. " recomendou a sua cidade! +1 estrela e " .. Format.Money(theirs), "ok")
	Remotes.Effect(owner, "star")
	publish(target)
	City.Sync(city.Player)
	City.Sync(owner)
end

actions.tutorial = function(city, payload)
	local step = type(payload) == "table" and tonumber(payload.Step)
	if step and step >= 0 and step <= 20 and step == math.floor(step) then
		city.Data.Tutorial = step
	end
end

function City.HandleRequest(player: Player, action: any, payload: any)
	local city = cities[player]
	if not city or type(action) ~= "string" then
		return
	end
	local handler = actions[action]
	if handler then
		handler(city, payload)
	end
end

-- ======== Simulação ========

local function countVisitors(city: CityT): number
	local count = 0
	for _, other in Players:GetPlayers() do
		if other ~= city.Player then
			local character = other.Character
			local rootPart = character and character.PrimaryPart
			if rootPart and LotLayout.Contains(city.Lot, rootPart.Position) then
				count += 1
			end
		end
	end
	return count
end

local function migrate(from: CityT, leaving: number)
	local best: CityT? = nil
	local bestScore = Config.Happiness.Attractive
	for _, other in cities do
		if other ~= from then
			local room = other.Stats.TargetPopulation - other.Population
			if room > 0 and other.Stats.Happiness >= bestScore then
				best = other
				bestScore = other.Stats.Happiness
			end
		end
	end
	if not best then
		return
	end
	local moving = math.min(leaving, math.floor(best.Stats.TargetPopulation - best.Population))
	if moving <= 0 then
		return
	end
	best.Population += moving
	noticeOnce(from, "moveOut", 45, ("%d moradores infelizes se mudaram para %s (de %s)."):format(moving, cityName(best.Data), best.Player.DisplayName), "erro")
	noticeOnce(best, "moveIn", 45, ("%d moradores vieram de %s porque aqui é melhor!"):format(moving, cityName(from.Data)), "ok")
end

local function step(city: CityT, dt: number)
	local data = city.Data
	city.Visitors = countVisitors(city)
	local stats = compute(city)
	local event = Events.Current()
	local newPop, leaving = CityMath.StepPopulation(city.Population, stats.TargetPopulation, event and event.Growth or 1)
	city.Population = newPop
	if leaving > 0 and stats.Happiness < Config.Happiness.Unhappy then
		migrate(city, leaving)
		noticeOnce(city, "unhappy", 90, "Os moradores estão infelizes e indo embora. Veja as necessidades no painel da Cidade.", "erro")
	end
	stats = compute(city) -- a renda usa a população nova
	data.Population = city.Population
	if city.Population > data.PeakPopulation then
		data.PeakPopulation = city.Population
	end

	local tier = CityMath.TierFor(city.Population)
	if tier.Id > data.TierReached then
		data.TierReached = tier.Id
		Remotes.Notify(city.Player, "Sua cidade virou " .. tier.Name .. "! Prédios novos liberados.", "ok")
		Remotes.Effect(city.Player, "tier", tier.Id)
	end

	local earned = stats.IncomePerSec * dt
	if city.Passes.AutoCollect then
		addCash(city, earned)
	else
		local capacity = vaultCapacity(city)
		if data.Vault < capacity then
			data.Vault = math.min(capacity, data.Vault + earned)
		elseif earned > 0 then
			noticeOnce(city, "vaultFull", 120, "O cofre da Prefeitura está CHEIO! Vá coletar ou aumente o cofre.", "erro")
		end
	end

	Lots.SetWarnings(city.Lot, stats.NoRoad)
	publish(city)
	City.Sync(city.Player)
end

-- ======== Entrar e sair ========

function City.Start(player: Player, profile: any): boolean
	local lot = Lots.Claim(player)
	if not lot then
		player:Kick("Servidor cheio de prefeitos. Tente outro servidor!")
		return false
	end
	local data = profile.Data
	if data.NameA == 0 or data.NameB == 0 then
		data.NameA = math.random(1, #Config.CityNameA)
		data.NameB = math.random(1, #Config.CityNameB)
	end
	data.Expansion = math.clamp(math.floor(tonumber(data.Expansion) or 1), 1, #Config.Expansions)
	data.VaultLevel = math.clamp(math.floor(tonumber(data.VaultLevel) or 1), 1, #Config.Vault.Levels)

	local city: CityT = {
		Player = player,
		Data = data,
		Lot = lot,
		State = Grid.Deserialize(data.Buildings, data.Expansion),
		Population = math.max(0, math.floor(tonumber(data.Population) or 0)),
		Stats = nil :: any,
		Visitors = 0,
		Passes = {},
		Cooldowns = {},
		Notices = {},
	}
	cities[player] = city

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local popValue = Instance.new("IntValue")
	popValue.Name = "População"
	popValue.Parent = leaderstats
	local starValue = Instance.new("IntValue")
	starValue.Name = "Estrelas"
	starValue.Parent = leaderstats
	leaderstats.Parent = player

	Lots.SetExpansion(lot, data.Expansion)
	for _, placed in city.State.Buildings do
		Lots.Render(lot, placed)
	end
	compute(city)
	Lots.SetWarnings(lot, city.Stats.NoRoad)

	-- o cofre encheu enquanto o jogador estava fora
	local last = tonumber(data.LastOnline) or 0
	if last > 0 and city.Stats.IncomePerSec > 0 then
		local away = math.clamp(os.time() - last, 0, Config.Vault.OfflineMaxHours * 3600)
		local capacity = vaultCapacity(city)
		local before = data.Vault
		data.Vault = math.min(capacity, data.Vault + city.Stats.IncomePerSec * away * Config.Vault.OfflineRate)
		local gained = data.Vault - before
		if gained >= 1 then
			task.delay(4, function()
				if player.Parent then
					Remotes.Notify(player, "Enquanto você estava fora, o cofre juntou " .. Format.Money(gained) .. ". Vá coletar na Prefeitura!", "ok")
				end
			end)
		end
	end

	publish(city)
	player:SetAttribute("Lot", lot)
	player:SetAttribute("Loaded", true)
	City.Sync(player)
	if player.Character then
		task.defer(teleport, player, lot)
	end
	return true
end

-- Copia a cidade para os dados (o save leva junto) e libera o terreno na hora,
-- antes do save final (que pode demorar): quem entra logo depois já ganha o terreno.
function City.Stop(player: Player)
	local city = cities[player]
	if not city then
		return
	end
	city.Data.Buildings = Grid.Serialize(city.State)
	city.Data.Population = math.floor(city.Population)
	cities[player] = nil
	Lots.Release(city.Lot)
end

function City.Get(player: Player): CityT?
	return cities[player]
end

function City.SetPass(player: Player, key: string, owned: boolean)
	local city = cities[player]
	if not city then
		return
	end
	city.Passes[key] = owned
	if key == "AutoCollect" and owned and city.Data.Vault > 0 then
		local amount = math.floor(city.Data.Vault)
		city.Data.Vault -= amount
		addCash(city, amount)
	end
	compute(city)
	publish(city)
	City.Sync(player)
end

-- Dinheiro de compras (Products): `minutes` minutos da renda atual, com um mínimo
function City.GrantIncomeMinutes(player: Player, minutes: number, minimum: number): number?
	local city = cities[player]
	if not city then
		return nil
	end
	local amount = math.max(minimum, math.floor(city.Stats.IncomePerSec * 60 * minutes))
	addCash(city, amount)
	Remotes.Effect(player, "collect", amount)
	City.Sync(player)
	return amount
end

function City.Init()
	Data.BeforeSave = function(player, data)
		local city = cities[player]
		if city and city.Data == data then
			data.Buildings = Grid.Serialize(city.State)
			data.Population = math.floor(city.Population)
		end
	end
	Lots.OnVault = function(player, index)
		local city = cities[player]
		if not city then
			return
		end
		if city.Lot ~= index then
			Remotes.Notify(player, "Esse cofre não é seu!", "erro")
			return
		end
		collectVault(city)
	end
	Remotes.Request.OnServerEvent:Connect(function(player, action, payload)
		local ok, err = pcall(City.HandleRequest, player, action, payload)
		if not ok then
			warn("[City] erro no pedido", action, err)
		end
	end)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(Config.SimInterval)
			local t = os.clock()
			local dt = math.min(t - last, Config.SimInterval * 3)
			last = t
			for _, city in cities do
				local ok, err = pcall(step, city, dt)
				if not ok then
					warn("[City] erro na simulação de", city.Player.Name, err)
				end
			end
		end
	end)
end

return City
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="105">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[--[[
	Data (ModuleScript em ServerScriptService > Game)          Prefeito Tycoon
	Salva e carrega o progresso de cada jogador com segurança (mesmo sistema do Steal a Critter v28):
	  • UpdateAsync com "trava de sessão": dois servidores nunca mexem nos dados do mesmo jogador
	  • várias tentativas quando o Roblox falha
	  • salva ao sair, a cada Config.AutosaveEvery segundos e quando o servidor fecha
	  • quem sai e volta no MESMO servidor espera o save da saída terminar
	  • guarda os recibos de compra para nunca entregar (nem cobrar) duas vezes
	Data.BeforeSave(player, data) é preenchido pelo City para copiar a cidade antes de cada save.
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(script.Parent.Remotes)

local Data = {}
Data.BeforeSave = nil :: ((Player, any) -> ())?

type Profile = {
	Data: any,
	CanSave: boolean,
	IsNew: boolean,
	Saving: boolean,
	Final: boolean,
}

local SESSION_TIMEOUT = 150 -- segundos: trava mais velha que isso = servidor antigo caiu
local MAX_RECEIPTS = 100

local profiles: { [Player]: Profile } = {}
local activeSaves = 0

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Data] DataStore indisponível:", result)
	end
end

local function defaultData()
	return {
		Cash = Config.StartCash,
		Vault = 0, -- dinheiro esperando no cofre da Prefeitura
		VaultLevel = 1,
		Expansion = 1,
		Buildings = {}, -- { "id,x,z,r" } (Shared/Grid.Serialize)
		Population = 0,
		TierReached = 1, -- maior nível da cidade neste mandato (os prédios liberados não travam de novo)
		Reelections = 0,
		Stars = 0, -- recomendações recebidas
		Recommended = { Day = 0, Users = {} }, -- cidades que você recomendou hoje (UserIds)
		PeakPopulation = 0,
		TotalEarned = 0,
		NameA = 0, -- índices em Config.CityNameA / CityNameB (0 = sorteia na primeira vez)
		NameB = 0,
		Tutorial = 0,
		LastOnline = 0,
		Receipts = {},
		Version = 1,
	}
end

local function reconcile(data: any)
	for key, value in defaultData() do
		if data[key] == nil then
			data[key] = value
		end
	end
	return data
end

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, item in value do
		copy[key] = deepCopy(item)
	end
	return copy
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function lockedByOther(value: any): boolean
	if type(value) ~= "table" or type(value.Session) ~= "table" then
		return false
	end
	local session = value.Session
	return session.JobId ~= game.JobId and os.time() - (tonumber(session.Time) or 0) < SESSION_TIMEOUT
end

-- v28: saves finais em andamento por UserId. Quem sai e volta no MESMO servidor precisa esperar
-- o save da saída terminar; senão carregava dados velhos e depois apagava o progresso da sessão anterior.
local finalSaving: { [number]: boolean } = {}

function Data.Load(player: Player): Profile
	local waitedFinal = 0
	while finalSaving[player.UserId] and waitedFinal < 75 and player.Parent do -- o pior caso do save final passa de 40 s
		waitedFinal += task.wait(0.25)
	end
	local loaded = false
	local result: any = nil
	local isNew = false

	if store then
		local attempts = 6
		for attempt = 1, attempts do
			if not player.Parent then
				break -- saiu enquanto carregava
			end
			local locked = false
			local ok, err = pcall(function()
				(store :: DataStore):UpdateAsync(keyFor(player), function(old)
					-- Outro servidor ainda está com esse jogador: espera (na última tentativa assume)
					if lockedByOther(old) and attempt < attempts then
						locked = true
						return nil
					end
					locked = false
					isNew = type(old) ~= "table"
					local data = reconcile(if type(old) == "table" then old else defaultData())
					data.Session = { JobId = game.JobId, Time = os.time() }
					result = data
					return data, { player.UserId }
				end)
			end)
			if ok and not locked then
				loaded = true
				break
			end
			if not ok then
				warn(("[Data] Falha ao carregar %s (tentativa %d): %s"):format(player.Name, attempt, tostring(err)))
				if RunService:IsStudio() then
					break -- no Studio sem acesso à API não adianta insistir
				end
			end
			task.wait(if locked then 3 else 2)
		end
	end

	local profile: Profile = {
		Data = if loaded and result then result else defaultData(),
		CanSave = loaded,
		IsNew = if loaded then isNew else true,
		Saving = false,
		Final = false,
	}
	profiles[player] = profile

	if not loaded then
		warn("[Data] O progresso de " .. player.Name .. " NÃO será salvo nesta sessão.")
		if RunService:IsStudio() then
			task.delay(4, function()
				if player.Parent then
					Remotes.Notify(player, "Studio: o salvamento está DESLIGADO. Publique e ligue 'Studio Access to API Services' para testar.", "erro")
				end
			end)
		end
	end
	return profile
end

function Data.Get(player: Player): Profile?
	return profiles[player]
end

-- Quantos saves estão em andamento (o servidor espera eles terminarem antes de fechar)
function Data.ActiveSaves(): number
	return activeSaves
end

-- isFinal = true quando o jogador está saindo (libera a trava e não salva mais nada dele)
function Data.Save(player: Player, isFinal: boolean?): boolean
	local profile = profiles[player]
	if not profile or not profile.CanSave or not store then
		return false
	end
	activeSaves += 1
	if isFinal then
		finalSaving[player.UserId] = true -- marcado já antes de esperar um autosave em andamento
	end
	local waited = 0
	local limit = if isFinal then 30 else 15
	while profile.Saving and waited < limit do
		waited += task.wait(0.1)
	end
	-- nunca dois saves do mesmo jogador ao mesmo tempo: se o outro ainda não acabou, este desiste
	-- (o save da saída espera mais e segue; o número SaveSeq impede o save velho de apagar o novo)
	if profile.Final or not profile.CanSave or (profile.Saving and not isFinal) then
		if isFinal and not profile.Saving then -- se outro save final ainda roda, ele mesmo limpa no fim
			finalSaving[player.UserId] = nil
		end
		activeSaves -= 1
		return false
	end
	profile.Saving = true
	if isFinal then
		profile.Final = true
	end

	-- a cidade (prédios, população, cofre) vive no módulo City enquanto o jogador joga
	if Data.BeforeSave then
		Data.BeforeSave(player, profile.Data)
	end
	-- só marca "online agora" depois de carregar (senão o cofre offline se perde)
	if player:GetAttribute("Loaded") then
		profile.Data.LastOnline = os.time()
	end
	-- "foto" dos dados agora; mudanças durante a espera entram no próximo save
	profile.Data.SaveSeq = (tonumber(profile.Data.SaveSeq) or 0) + 1
	local snapshot = deepCopy(profile.Data)

	local success = false
	local lostLock = false
	for attempt = 1, if isFinal then 5 else 3 do
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(keyFor(player), function(old)
				if lockedByOther(old) then
					lostLock = true
					return nil
				end
				lostLock = false
				if type(old) == "table" and (tonumber(old.SaveSeq) or 0) > snapshot.SaveSeq then
					return nil -- já tem um save mais novo guardado: não volta no tempo
				end
				snapshot.Session = if isFinal then nil else { JobId = game.JobId, Time = os.time() }
				return snapshot, { player.UserId }
			end)
		end)
		if ok then
			success = not lostLock
			break
		end
		warn(("[Data] Falha ao salvar %s (tentativa %d): %s"):format(player.Name, attempt, tostring(err)))
		task.wait(1)
	end

	if lostLock then
		-- Outro servidor assumiu os dados: este servidor para de salvar para não estragar nada
		warn("[Data] " .. player.Name .. " foi carregado em outro servidor; este servidor não salva mais.")
		profile.CanSave = false
		if player.Parent and not isFinal then
			player:Kick("Seu progresso foi aberto em outro servidor. Entre de novo!")
		end
	end

	profile.Saving = false
	if isFinal then
		finalSaving[player.UserId] = nil
	end
	activeSaves -= 1
	return success
end

function Data.HasReceipt(profile: Profile, purchaseId: string): boolean
	return table.find(profile.Data.Receipts, purchaseId) ~= nil
end

function Data.AddReceipt(profile: Profile, purchaseId: string)
	local receipts = profile.Data.Receipts
	table.insert(receipts, purchaseId)
	while #receipts > MAX_RECEIPTS do
		table.remove(receipts, 1)
	end
end

function Data.Remove(player: Player)
	profiles[player] = nil
end

return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="106">
        <Properties>
          <string name="Name">Events</string>
          <string name="Source"><![CDATA[--[[
	Events (ModuleScript em ServerScriptService > Game)          Prefeito Tycoon
	Eventos globais: a cada Config.EventEvery segundos um evento vale para todas as cidades por
	Config.EventDuration segundos. O cliente lê os atributos de ReplicatedStorage:
	  Event (Id ou ""), EventName, EventText, EventEnds (os.time), NextEvent (os.time)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(script.Parent.Remotes)

local Events = {}

local current: any = nil
local lastId = ""

function Events.Current(): any
	return current
end

local function setAttributes(event: any, ends: number, nextAt: number)
	ReplicatedStorage:SetAttribute("Event", if event then event.Id else "")
	ReplicatedStorage:SetAttribute("EventName", if event then event.Name else "")
	ReplicatedStorage:SetAttribute("EventText", if event then event.Text else "")
	ReplicatedStorage:SetAttribute("EventEnds", ends)
	ReplicatedStorage:SetAttribute("NextEvent", nextAt)
end

function Events.Start(id: string): boolean
	for _, event in Config.Events do
		if event.Id == id then
			current = event
			lastId = id
			local ends = os.time() + Config.EventDuration
			setAttributes(event, ends, ends + Config.EventEvery)
			Remotes.NotifyAll(event.Name .. "! " .. event.Text, "evento")
			return true
		end
	end
	return false
end

function Events.Stop()
	if current then
		Remotes.NotifyAll(current.Name .. " acabou.", "info")
	end
	current = nil
	setAttributes(nil, 0, os.time() + Config.EventEvery)
end

function Events.Init()
	setAttributes(nil, 0, os.time() + Config.EventEvery)
	task.spawn(function()
		while true do
			task.wait(Config.EventEvery)
			local options = {}
			for _, event in Config.Events do
				if event.Id ~= lastId then
					table.insert(options, event)
				end
			end
			if #options > 0 then
				Events.Start(options[math.random(1, #options)].Id)
				task.wait(Config.EventDuration)
				Events.Stop()
			end
		end
	end)
end

return Events
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="107">
        <Properties>
          <string name="Name">Leaderboards</string>
          <string name="Source"><![CDATA[--[[
	Leaderboards (ModuleScript em ServerScriptService > Game)          Prefeito Tycoon
	Placares globais no hub (OrderedDataStore): Prefeitos mais recomendados (estrelas) e
	Maiores cidades (pico de população). Grava os jogadores do servidor e lê o top 10 a cada 2 min.
	As placas são Workspace > Hub > BoardStars / BoardPopulation (o builder do lugar cria).
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)

local Leaderboards = {}

local REFRESH = 120

local boards = {
	{ Store = Config.LeaderboardStores.Stars, Attribute = "Stars", Part = "BoardStars", Title = "PREFEITOS MAIS RECOMENDADOS", Suffix = " ★" },
	{ Store = Config.LeaderboardStores.Population, Attribute = "PeakPopulation", Part = "BoardPopulation", Title = "MAIORES CIDADES", Suffix = " hab." },
}

local nameCache: { [number]: string } = {}

local function nameOf(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	nameCache[userId] = if ok then name else "?"
	return nameCache[userId]
end

local function boardLabel(partName: string, title: string): TextLabel?
	local hub = workspace:FindFirstChild("Hub")
	local target = hub and hub:FindFirstChild(partName)
	if not target or not target:IsA("BasePart") then
		return nil
	end
	local gui = target:FindFirstChild("BoardGui") :: SurfaceGui?
	if not gui then
		local newGui = Instance.new("SurfaceGui")
		newGui.Name = "BoardGui"
		newGui.Face = Enum.NormalId.Front
		newGui.PixelsPerStud = 30
		newGui.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.BackgroundColor3 = Color3.fromRGB(16, 20, 30)
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(235, 240, 255)
		label.TextYAlignment = Enum.TextYAlignment.Top
		label.Text = title
		label.Parent = newGui
		newGui.Parent = target
		gui = newGui
	end
	return (gui :: any).Text
end

local function refresh(board: any)
	local okStore, store = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, board.Store)
	if not okStore then
		return
	end
	for _, player in Players:GetPlayers() do
		local value = player:GetAttribute(board.Attribute)
		if type(value) == "number" and value > 0 then
			pcall(store.SetAsync, store, "u_" .. player.UserId, math.floor(value))
		end
	end
	local label = boardLabel(board.Part, board.Title)
	if not label then
		return
	end
	local ok, pages = pcall(store.GetSortedAsync, store, false, 10)
	if not ok then
		return
	end
	local lines = { board.Title, "" }
	for rank, entry in pages:GetCurrentPage() do
		local userId = tonumber(string.match(entry.key, "^u_(%d+)$"))
		local name = if userId then nameOf(userId) else "?"
		table.insert(lines, ("%d. %s  %s%s"):format(rank, name, Format.Short(entry.value), board.Suffix))
	end
	label.Text = table.concat(lines, "\n")
end

function Leaderboards.Init()
	local title = boardLabel("Title", "PREFEITO TYCOON")
	if title then
		title.Font = Enum.Font.GothamBlack
		title.TextYAlignment = Enum.TextYAlignment.Center
		title.TextColor3 = Color3.fromRGB(255, 196, 70)
		title.Text = "PREFEITO TYCOON\n\nConstrua a sua cidade.\nCresça, colete o cofre, roube moradores dos vizinhos."
	end
	task.spawn(function()
		task.wait(15)
		while true do
			for _, board in boards do
				local ok, err = pcall(refresh, board)
				if not ok then
					warn("[Leaderboards]", err)
				end
			end
			task.wait(REFRESH)
		end
	end)
end

return Leaderboards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="108">
        <Properties>
          <string name="Name">Lots</string>
          <string name="Source"><![CDATA[--[[
	Lots (ModuleScript em ServerScriptService > Game)          Prefeito Tycoon
	Os terrenos: monta o chão, a Avenida, a Prefeitura, o Cofre e o caminho até o hub; dá um
	terreno para cada jogador; desenha e apaga os prédios.

	No Workspace:  Lots > Lot1..Lot8
	  atributos: Owner (UserId, 0 = livre), OwnerName, CityName, Population, Stars, Happiness, Expansion
	  Buildings (Folder): um Model por prédio, com atributos Uid, Id, X, Z, R (o cliente lê daqui)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Buildings = require(Shared.Buildings)
local BuildingModels = require(Shared.BuildingModels)
local Grid = require(Shared.Grid)
local LotLayout = require(Shared.LotLayout)

local Lots = {}

type Lot = {
	Index: number,
	Model: Model,
	Buildings: Folder,
	Owner: Player?,
	Unlocked: Part,
	Sign: TextLabel,
	VaultLabel: TextLabel,
	VaultPrompt: ProximityPrompt,
	Rendered: { [number]: Model },
}

local lots: { Lot } = {}
local root: Folder

local CELL = Config.CellSize
local N = Config.GridSize
local SIZE = N * CELL

-- Chamado quando o dono aperta o cofre (o City preenche)
Lots.OnVault = nil :: ((Player, number) -> ())?

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function surfaceText(target: BasePart, face: Enum.NormalId, text: string, color: Color3): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	label.Parent = gui
	gui.Parent = target
	return label
end

local function buildLot(index: number): Lot
	local cf = LotLayout.CFrame(index)
	local function L(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end

	local model = Instance.new("Model")
	model.Name = "Lot" .. index
	model:SetAttribute("Index", index)
	model:SetAttribute("Owner", 0)
	model:SetAttribute("OwnerName", "")
	model:SetAttribute("CityName", "Terreno livre")
	model:SetAttribute("Population", 0)
	model:SetAttribute("Stars", 0)
	model:SetAttribute("Happiness", 0)
	model:SetAttribute("Expansion", 1)

	-- chão do terreno (área travada) + área liberada por cima
	local ground = part(model, "Ground", Vector3.new(SIZE, 1, SIZE), L(0, -0.5, SIZE / 2), Color3.fromRGB(46, 58, 46), Enum.Material.Ground)
	ground.CastShadow = false
	local unlocked = part(model, "Unlocked", Vector3.new(1, 0.1, 1), L(0, 0.05, SIZE / 2), Color3.fromRGB(86, 120, 76), Enum.Material.Grass)
	unlocked.CastShadow = false
	unlocked.CanCollide = false

	-- Avenida (fileira z = 1) de ponta a ponta
	local avenue = part(model, "Avenue", Vector3.new(SIZE, 0.3, CELL), L(0, 0.15, CELL / 2), Color3.fromRGB(38, 40, 46), Enum.Material.Asphalt)
	avenue.CastShadow = false
	for i = 0, 11 do
		local dash = part(model, "Dash", Vector3.new(6, 0.05, 0.4), L(-SIZE / 2 + 8 + i * 16, 0.32, CELL / 2), Color3.fromRGB(230, 200, 80), Enum.Material.Neon)
		dash.CastShadow = false
	end

	-- praça e Prefeitura na frente da Avenida (lado do hub)
	part(model, "Plaza", Vector3.new(SIZE, 0.4, 64), L(0, 0.2, -32), Color3.fromRGB(150, 146, 140), Enum.Material.Cobblestone).CastShadow = false
	local hall = Instance.new("Model")
	hall.Name = "Prefeitura"
	part(hall, "Body", Vector3.new(40, 16, 16), L(0, 8, -22), Color3.fromRGB(232, 226, 210), Enum.Material.Marble)
	part(hall, "Roof", Vector3.new(44, 2, 20), L(0, 17, -22), Color3.fromRGB(200, 194, 180), Enum.Material.Marble)
	local dome = part(hall, "Dome", Vector3.new(14, 14, 14), L(0, 18, -22), Color3.fromRGB(70, 110, 120), Enum.Material.Metal)
	dome.Shape = Enum.PartType.Ball
	part(hall, "Mast", Vector3.new(0.5, 10, 0.5), L(0, 29, -22), Color3.fromRGB(60, 60, 60), Enum.Material.Metal)
	part(hall, "Flag", Vector3.new(4, 2.6, 0.2), L(2.2, 32.5, -22), Color3.fromRGB(0, 150, 70), Enum.Material.Fabric)
	for i = -2, 2 do
		local column = part(hall, "Column", Vector3.new(16, 2, 2), L(i * 8, 8, -31.5), Color3.fromRGB(245, 242, 232), Enum.Material.Marble)
		column.Shape = Enum.PartType.Cylinder
		column.CFrame = L(i * 8, 8, -31.5) * CFrame.Angles(0, 0, math.rad(90))
	end
	part(hall, "Steps", Vector3.new(36, 1, 4), L(0, 0.5, -33), Color3.fromRGB(210, 206, 196), Enum.Material.Marble)
	for _, x in { -14, -6, 6, 14 } do
		part(hall, "Window", Vector3.new(3, 5, 0.2), L(x, 9, -30.05), Color3.fromRGB(255, 214, 140), Enum.Material.Neon)
	end
	-- placa com o nome da cidade (de frente para o hub)
	local signPart = part(hall, "Sign", Vector3.new(34, 4, 0.4), L(0, 13.5, -30.3), Color3.fromRGB(30, 34, 44), Enum.Material.SmoothPlastic)
	local sign = surfaceText(signPart, Enum.NormalId.Front, "TERRENO LIVRE", Color3.fromRGB(255, 230, 160))
	hall.Parent = model

	-- Cofre: a renda cai aqui e o dono vem buscar
	local vault = part(model, "Vault", Vector3.new(7, 7, 7), L(28, 3.5, -20), Color3.fromRGB(90, 96, 104), Enum.Material.DiamondPlate)
	part(model, "VaultTrim", Vector3.new(7.4, 0.8, 7.4), L(28, 6.6, -20), Color3.fromRGB(255, 200, 60), Enum.Material.Neon).CastShadow = false
	part(model, "VaultPad", Vector3.new(12, 0.3, 12), L(28, 0.45, -20), Color3.fromRGB(255, 200, 60), Enum.Material.Neon).CastShadow = false
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(220, 60)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 7, 0)
	billboard.MaxDistance = 200
	billboard.LightInfluence = 0
	local vaultLabel = Instance.new("TextLabel")
	vaultLabel.BackgroundTransparency = 1
	vaultLabel.Size = UDim2.fromScale(1, 1)
	vaultLabel.Font = Enum.Font.GothamBlack
	vaultLabel.TextScaled = true
	vaultLabel.TextColor3 = Color3.fromRGB(255, 220, 100)
	vaultLabel.TextStrokeTransparency = 0.4
	vaultLabel.Text = "COFRE"
	vaultLabel.Parent = billboard
	billboard.Parent = vault
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Coletar"
	prompt.ObjectText = "Cofre da Prefeitura"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = vault
	prompt.Triggered:Connect(function(player)
		if Lots.OnVault then
			Lots.OnVault(player, index)
		end
	end)

	-- caminho até o hub
	local inner = 120
	local outer = Config.LotRadius - 64
	local mid = (inner + outer) / 2
	local path = part(model, "Path", Vector3.new(18, 0.3, outer - inner + 2), L(0, 0.05, -(Config.LotRadius - mid)), Color3.fromRGB(70, 72, 78), Enum.Material.Asphalt)
	path.CastShadow = false
	for t = 0, 4 do
		local z = -(Config.LotRadius - inner) + 10 + t * (outer - inner - 20) / 4
		for _, x in { -11, 11 } do
			part(model, "Lamp", Vector3.new(0.5, 12, 0.5), L(x, 6, z), Color3.fromRGB(40, 40, 44), Enum.Material.Metal)
			local bulb = part(model, "Bulb", Vector3.new(1.2, 1.2, 1.2), L(x, 12.4, z), Color3.fromRGB(255, 214, 150), Enum.Material.Neon)
			bulb.Shape = Enum.PartType.Ball
			local light = Instance.new("PointLight")
			light.Range = 22
			light.Brightness = 1.2
			light.Color = Color3.fromRGB(255, 200, 140)
			light.Parent = bulb
		end
	end

	local folder = Instance.new("Folder")
	folder.Name = "Buildings"
	folder.Parent = model
	model.Parent = root

	return {
		Index = index,
		Model = model,
		Buildings = folder,
		Owner = nil,
		Unlocked = unlocked,
		Sign = sign,
		VaultLabel = vaultLabel,
		VaultPrompt = prompt,
		Rendered = {},
	}
end

function Lots.Init()
	root = Instance.new("Folder")
	root.Name = "Lots"
	root.Parent = workspace
	for index = 1, Config.MaxPlayers do
		lots[index] = buildLot(index)
		Lots.SetExpansion(index, 1)
	end
end

function Lots.Claim(player: Player): number?
	for _, lot in lots do
		if lot.Owner == player then
			return lot.Index
		end
	end
	for _, lot in lots do
		if lot.Owner == nil then
			lot.Owner = player
			lot.Model:SetAttribute("Owner", player.UserId)
			lot.Model:SetAttribute("OwnerName", player.DisplayName)
			return lot.Index
		end
	end
	return nil
end

function Lots.Release(index: number)
	local lot = lots[index]
	if not lot then
		return
	end
	lot.Owner = nil
	Lots.ClearBuildings(index)
	lot.Model:SetAttribute("Owner", 0)
	lot.Model:SetAttribute("OwnerName", "")
	lot.Model:SetAttribute("CityName", "Terreno livre")
	lot.Model:SetAttribute("Population", 0)
	lot.Model:SetAttribute("Stars", 0)
	lot.Model:SetAttribute("Happiness", 0)
	lot.Sign.Text = "TERRENO LIVRE"
	lot.VaultLabel.Text = "COFRE"
	Lots.SetExpansion(index, 1)
end

function Lots.OwnerOf(index: number): Player?
	local lot = lots[index]
	return lot and lot.Owner
end

function Lots.Count(): number
	return #lots
end

function Lots.SetInfo(index: number, info: { [string]: any })
	local lot = lots[index]
	if not lot then
		return
	end
	for key, value in info do
		if lot.Model:GetAttribute(key) ~= value then
			lot.Model:SetAttribute(key, value)
		end
	end
	if info.CityName and lot.Owner then
		lot.Sign.Text = string.upper(info.CityName)
	end
end

function Lots.SetVaultText(index: number, text: string)
	local lot = lots[index]
	if lot and lot.VaultLabel.Text ~= text then
		lot.VaultLabel.Text = text
	end
end

function Lots.SetExpansion(index: number, level: number)
	local lot = lots[index]
	if not lot then
		return
	end
	local x1, x2, z1, z2 = Grid.Bounds(level)
	local w = (x2 - x1 + 1) * CELL
	local d = (z2 - z1 + 1) * CELL
	local cx, cz = Grid.LocalPosition((x1 + x2) / 2, (z1 + z2) / 2)
	lot.Unlocked.Size = Vector3.new(w, 0.1, d)
	lot.Unlocked.CFrame = LotLayout.CFrame(index) * CFrame.new(cx, 0.05, cz)
	lot.Model:SetAttribute("Expansion", level)
end

function Lots.Render(index: number, placed: Grid.Placed)
	local lot = lots[index]
	local def = Buildings.ById[placed.Id]
	if not lot or not def then
		return
	end
	local old = lot.Rendered[placed.Uid]
	if old then
		old:Destroy()
	end
	local model = BuildingModels.Build(def)
	model.Name = tostring(placed.Uid)
	model:SetAttribute("Uid", placed.Uid)
	model:SetAttribute("Id", placed.Id)
	model:SetAttribute("X", placed.X)
	model:SetAttribute("Z", placed.Z)
	model:SetAttribute("R", placed.R)
	model:PivotTo(LotLayout.BuildingCFrame(index, placed))
	model.Parent = lot.Buildings
	lot.Rendered[placed.Uid] = model
end

function Lots.Unrender(index: number, uid: number)
	local lot = lots[index]
	local model = lot and lot.Rendered[uid]
	if model then
		model:Destroy()
		lot.Rendered[uid] = nil
	end
end

function Lots.ClearBuildings(index: number)
	local lot = lots[index]
	if not lot then
		return
	end
	lot.Buildings:ClearAllChildren()
	lot.Rendered = {}
end

-- Placa de aviso "SEM RUA" em cima dos prédios que não funcionam
function Lots.SetWarnings(index: number, noRoad: { [number]: boolean })
	local lot = lots[index]
	if not lot then
		return
	end
	for uid, model in lot.Rendered do
		local has = model:FindFirstChild("Warning")
		if noRoad[uid] and not has then
			local gui = Instance.new("BillboardGui")
			gui.Name = "Warning"
			gui.Size = UDim2.fromOffset(110, 30)
			gui.StudsOffsetWorldSpace = Vector3.new(0, 10, 0)
			gui.MaxDistance = 160
			gui.LightInfluence = 0
			gui.AlwaysOnTop = true
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
			label.TextColor3 = Color3.new(1, 1, 1)
			label.Font = Enum.Font.GothamBold
			label.TextScaled = true
			label.Text = "SEM RUA"
			label.Parent = gui
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 6)
			corner.Parent = label
			gui.Parent = model
		elseif not noRoad[uid] and has then
			has:Destroy()
		end
	end
end

return Lots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="109">
        <Properties>
          <string name="Name">Products</string>
          <string name="Source"><![CDATA[--[[
	Products (ModuleScript em ServerScriptService > Game)          Prefeito Tycoon
	Game passes (Renda x2, Cofre Automático) e produtos de dinheiro.
	Ids ficam em Shared/Config (0 = desligado). Nada aleatório é vendido.

	Passe comprado dentro do jogo: confiamos no evento PromptGamePassPurchaseFinished do SERVIDOR
	(logo depois da compra o UserOwnsGamePassAsync pode responder "não tem" por causa do cache).
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)

local Game = script.Parent
local Data = require(Game.Data)
local City = require(Game.City)
local Remotes = require(Game.Remotes)

local Products = {}

local function passKey(passId: number): string?
	if passId == 0 then
		return nil
	end
	for key, id in Config.GamePasses do
		if id == passId then
			return key
		end
	end
	return nil
end

function Products.CheckPasses(player: Player)
	for key, id in Config.GamePasses do
		if id ~= 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
			if ok and owns then
				City.SetPass(player, key, true)
			end
		end
	end
end

local function productFor(productId: number): any
	for _, product in Config.DevProducts do
		if product.Id ~= 0 and product.Id == productId then
			return product
		end
	end
	return nil
end

local function processReceipt(info: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local profile = player and Data.Get(player)
	if not player or not profile or profile.Final or not City.Get(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if Data.HasReceipt(profile, info.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local product = productFor(info.ProductId)
	if not product then
		warn("[Products] produto desconhecido", info.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local amount = City.GrantIncomeMinutes(player, product.Minutes, product.Min)
	if not amount then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Data.AddReceipt(profile, info.PurchaseId)
	-- só confirma depois de salvar o recibo junto com o dinheiro. Se não salvou, o Roblox tenta de novo;
	-- no mesmo servidor o recibo já está na memória (não entrega duas vezes)
	if not Data.Save(player) then
		warn("[Products] não salvou o recibo agora; o Roblox vai tentar de novo")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Remotes.Notify(player, "Obrigado! +" .. Format.Money(amount), "ok")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function Products.Init()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local key = purchased and passKey(passId)
		if key then
			City.SetPass(player, key, true)
			Remotes.Notify(player, "Passe ativado! Obrigado pelo apoio.", "ok")
		end
	end)
	-- o cliente pede para abrir a compra (o Id vem da Config, nunca do cliente)
	Remotes.Request.OnServerEvent:Connect(function(player, action, payload)
		if action == "buyPass" and type(payload) == "string" then
			local id = Config.GamePasses[payload]
			if type(id) == "number" and id ~= 0 then
				MarketplaceService:PromptGamePassPurchase(player, id)
			else
				Remotes.Notify(player, "Loja ainda não aberta.", "info")
			end
		elseif action == "buyCash" and type(payload) == "number" then
			local product = Config.DevProducts[payload]
			if product and product.Id ~= 0 then
				MarketplaceService:PromptProductPurchase(player, product.Id)
			else
				Remotes.Notify(player, "Loja ainda não aberta.", "info")
			end
		end
	end)
end

return Products
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="110">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes (ModuleScript em ServerScriptService > Game)          Prefeito Tycoon
	Canais entre servidor e jogadores. Ficam em ReplicatedStorage > Remotes.
	  Request  jogador -> servidor: (ação, dados)        tudo que o jogador pede passa por aqui
	  Stats    servidor -> jogador: (tabela)             painel da cidade, a cada passo da simulação
	  Notify   servidor -> jogador: (texto, tipo)        avisos ("info", "ok", "erro", "evento")
	  Effect   servidor -> jogador: (tipo, dados)        sons e efeitos ("placed", "collect"...)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local function makeEvent(name: string): RemoteEvent
	local event = Instance.new("RemoteEvent")
	event.Name = name
	event.Parent = folder
	return event
end

Remotes.Request = makeEvent("Request")
Remotes.Stats = makeEvent("Stats")
Remotes.NotifyEvent = makeEvent("Notify")
Remotes.EffectEvent = makeEvent("Effect")

folder.Parent = ReplicatedStorage

function Remotes.Notify(player: Player, text: string, kind: string?)
	Remotes.NotifyEvent:FireClient(player, text, kind or "info")
end

function Remotes.NotifyAll(text: string, kind: string?)
	Remotes.NotifyEvent:FireAllClients(text, kind or "info")
end

function Remotes.Effect(player: Player, kind: string, data: any?)
	Remotes.EffectEvent:FireClient(player, kind, data)
end

return Remotes
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="111">
      <Properties>
        <string name="Name">Main</string>
        <string name="Source"><![CDATA[--[[
	Main (Script em ServerScriptService)          Prefeito Tycoon
	Liga tudo: monta os terrenos, carrega e salva os jogadores, liga os eventos e a loja.
	Cada sistema começa dentro de um pcall: se um quebrar, o resto do jogo continua.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local LotLayout = require(ReplicatedStorage.Shared.LotLayout)

local Game = script.Parent:WaitForChild("Game")
local Data = require(Game.Data)
local Remotes = require(Game.Remotes)
local Lots = require(Game.Lots)
local Events = require(Game.Events)
local City = require(Game.City)
local Products = require(Game.Products)
local Leaderboards = require(Game.Leaderboards)

Players.CharacterAutoLoads = true

for _, system in { { "Lots", Lots }, { "Events", Events }, { "City", City }, { "Products", Products }, { "Leaderboards", Leaderboards } } do
	local ok, err = pcall((system[2] :: any).Init)
	if not ok then
		warn("[Main] " .. system[1] .. " não iniciou:", err)
	end
end

local function onCharacter(player: Player, character: Model)
	local lot = player:GetAttribute("Lot")
	if type(lot) ~= "number" then
		return
	end
	local humanoidRoot = character:WaitForChild("HumanoidRootPart", 10)
	if humanoidRoot and character.Parent then
		task.wait() -- deixa o Roblox terminar de posicionar o spawn
		character:PivotTo(LotLayout.SpawnCFrame(lot))
	end
end

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	local profile = Data.Load(player)
	if not player.Parent then
		-- saiu enquanto carregava: o Load já gravou a trava de sessão, então salva para soltar a trava
		Data.Save(player, true)
		Data.Remove(player)
		return
	end
	local ok, err = pcall(City.Start, player, profile)
	if not ok then
		warn("[Main] City.Start falhou para", player.Name, err)
		Remotes.Notify(player, "Erro ao abrir sua cidade. Entre de novo.", "erro")
		return
	end
	task.spawn(Products.CheckPasses, player)
end

local function onPlayerRemoving(player: Player)
	City.Stop(player) -- copia a cidade para os dados e libera o terreno antes do save (que pode demorar)
	Data.Save(player, true)
	Data.Remove(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- salva todo mundo de tempos em tempos
task.spawn(function()
	while true do
		task.wait(Config.AutosaveEvery)
		for _, player in Players:GetPlayers() do
			task.spawn(Data.Save, player)
		end
	end
end)

game:BindToClose(function()
	for _, player in Players:GetPlayers() do
		task.spawn(Data.Save, player, true)
	end
	local waited = 0
	task.wait(0.5)
	while Data.ActiveSaves() > 0 and waited < 25 do
		waited += task.wait(0.25)
	end
end)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="112">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">450</float>
      <float name="CharacterWalkSpeed">24</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="113">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="ModuleScript" referent="114">
        <Properties>
          <string name="Name">Ambience</string>
          <string name="Source"><![CDATA[--[[
	Ambience (ModuleScript em StarterPlayerScripts)          Prefeito Tycoon
	Clima da cidade: música baixinha e as pás das usinas eólicas girando (só perto da câmera).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)

local Ambience = {}

local SPIN = 1.2 -- radianos por segundo
local VIEW = 400

function Ambience.Init()
	if #Config.Music > 0 then
		local music = Instance.new("Sound")
		music.Name = "Music"
		music.SoundId = Config.Music[1]
		music.Volume = Config.MusicVolume
		music.Looped = true
		music.Parent = SoundService
		music:Play()
	end

	local turbines: { Model } = {}
	local function scan()
		table.clear(turbines)
		local lots = workspace:FindFirstChild("Lots")
		if not lots then
			return
		end
		for _, lot in lots:GetChildren() do
			local folder = lot:FindFirstChild("Buildings")
			if folder then
				for _, model in folder:GetChildren() do
					if model:GetAttribute("Id") == "eolica" then
						table.insert(turbines, model :: Model)
					end
				end
			end
		end
	end
	task.spawn(function()
		while true do
			pcall(scan)
			task.wait(3)
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		for _, model in turbines do
			local rotor = model.Parent and model:FindFirstChild("Rotor") :: BasePart?
			if rotor and (rotor.Position - camera.CFrame.Position).Magnitude < VIEW then
				local axis = rotor.CFrame.LookVector
				local spin = CFrame.fromAxisAngle(axis, SPIN * dt)
				local center = rotor.Position
				for _, blade in model:GetChildren() do
					if blade.Name == "Blade" and blade:IsA("BasePart") then
						local relative = blade.CFrame - center
						blade.CFrame = (spin * relative) + center
					end
				end
			end
		end
	end)
end

return Ambience
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="115">
        <Properties>
          <string name="Name">BuildMode</string>
          <string name="Source"><![CDATA[--[[
	BuildMode (ModuleScript em StarterPlayerScripts)          Prefeito Tycoon
	Modo construção: menu de prédios por categoria, fantasma na grade (verde = pode, vermelho = não),
	área de alcance do prédio, girar (R), arrastar ruas, demolir (X) e sair (Q).
	No PC: clique constrói. No celular: toque escolhe o lugar e o botão "Construir aqui" confirma.
	O servidor confere tudo de novo; aqui é só para mostrar.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Buildings = require(Shared.Buildings)
local BuildingModels = require(Shared.BuildingModels)
local Grid = require(Shared.Grid)
local Format = require(Shared.Format)
local LotLayout = require(Shared.LotLayout)

local Scripts = script.Parent
local UI = require(Scripts.UI)
local State = require(Scripts.State)
local HUD = require(Scripts.HUD)

local player = Players.LocalPlayer
local T = UI.Theme
local CELL = Config.CellSize

local BuildMode = {}

local active = false
local removing = false
local selected: Buildings.Building? = nil
local rotation = 0
local category = "road"

local ghost: Model? = nil
local ghostKey = ""
local ghostOk: boolean? = nil
local range: Part? = nil
local gridLines: Folder? = nil
local gridExpansion = 0
local highlight: Highlight? = nil
local dragPool: { Part } = {}

local target: { X: number, Z: number }? = nil -- casa do canto do prédio sob o cursor
local dragStart: { X: number, Z: number }? = nil

local palette: Frame
local cardList: ScrollingFrame
local tabButtons: { [string]: TextButton } = {}
local toolbar: Frame
local removeButton: TextButton
local confirmButton: TextButton
local hint: TextLabel
local buildButton: TextButton

local onChanged = Instance.new("BindableEvent")
BuildMode.Changed = onChanged.Event -- (ativo: boolean)

function BuildMode.IsActive(): boolean
	return active
end

local function describe(def: Buildings.Building): string
	local parts = {}
	if def.Housing then
		table.insert(parts, "+" .. def.Housing .. " moradores")
	end
	if def.Income then
		table.insert(parts, "$" .. def.Income .. "/s")
	end
	if def.Jobs then
		table.insert(parts, def.Jobs .. " empregos")
	end
	if def.Need then
		for _, need in Config.Needs do
			if need.Id == def.Need then
				table.insert(parts, need.Name .. " (alcance " .. (def.Radius or 0) .. ")")
			end
		end
	end
	if def.Leisure then
		table.insert(parts, "Felicidade +" .. def.Leisure)
	end
	if def.PowerSupply then
		table.insert(parts, "+" .. def.PowerSupply .. " energia")
	end
	if def.Power then
		table.insert(parts, "usa " .. def.Power .. " energia")
	end
	if def.Pollution then
		table.insert(parts, "polui " .. def.Pollution)
	end
	return table.concat(parts, " · ")
end

-- ===== Ponteiro -> casa da grade =====

local function groundPoint(screenPos: Vector2, isTouch: boolean): Vector3?
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local ray = if isTouch then camera:ScreenPointToRay(screenPos.X, screenPos.Y) else camera:ViewportPointToRay(screenPos.X, screenPos.Y)
	if ray.Direction.Y >= -1e-4 then
		return nil
	end
	local t = (Config.LotGroundY - ray.Origin.Y) / ray.Direction.Y
	if t < 0 or t > 2000 then
		return nil
	end
	return ray.Origin + ray.Direction * t
end

local function footprint(): (number, number)
	if selected then
		return Buildings.Footprint(selected, rotation)
	end
	return 1, 1
end

local function anchorFor(cx: number, cz: number): (number, number)
	local w, d = footprint()
	return cx - math.floor((w - 1) / 2), cz - math.floor((d - 1) / 2)
end

local function setTarget(screenPos: Vector2, isTouch: boolean)
	local lot = State.Lot()
	local point = groundPoint(screenPos, isTouch)
	if not lot or not point then
		target = nil
		return
	end
	local cx, cz = LotLayout.ToCell(lot, point)
	if removing then
		target = { X = cx, Z = cz }
	else
		local x, z = anchorFor(cx, cz)
		target = { X = x, Z = z }
	end
end

local function canAfford(def: Buildings.Building): (boolean, string?)
	local stats = State.Stats
	if not stats then
		return false, nil
	end
	if def.Tier > stats.TierReached then
		return false, "Libera em " .. Config.Tiers[def.Tier].Name
	end
	if stats.Cash < def.Cost then
		return false, "Falta dinheiro"
	end
	return true, nil
end

local function check(x: number, z: number): (boolean, string?)
	local stats = State.Stats
	local lot = State.Lot()
	if not selected or not stats or not lot then
		return false, nil
	end
	local ok, reason = canAfford(selected)
	if not ok then
		return false, reason
	end
	return Grid.CanPlace(State.Grid(lot), stats.Expansion, selected, x, z, rotation)
end

-- ===== Desenhos na grade =====

local function clearGhost()
	if ghost then
		ghost:Destroy()
		ghost = nil
	end
	if range then
		range:Destroy()
		range = nil
	end
	ghostKey = ""
	ghostOk = nil
end

local function hideDrag()
	for _, p in dragPool do
		p.Parent = nil
	end
end

local function dragCells(): { { number } }
	local cells = {}
	if not dragStart or not target then
		return cells
	end
	local dx, dz = target.X - dragStart.X, target.Z - dragStart.Z
	if math.abs(dx) >= math.abs(dz) then
		local stepX = if dx >= 0 then 1 else -1
		for x = dragStart.X, target.X, stepX do
			table.insert(cells, { x, dragStart.Z })
		end
	else
		local stepZ = if dz >= 0 then 1 else -1
		for z = dragStart.Z, target.Z, stepZ do
			table.insert(cells, { dragStart.X, z })
		end
	end
	while #cells > 48 do
		table.remove(cells)
	end
	return cells
end

local function showDrag(lot: number)
	local cells = dragCells()
	local state = State.Grid(lot)
	local stats = State.Stats
	local budget = if stats and selected then math.floor(stats.Cash / selected.Cost) else 0
	if selected and select(2, canAfford(selected)) ~= nil and select(2, canAfford(selected)) ~= "Falta dinheiro" then
		budget = 0 -- prédio ainda travado pelo nível da cidade
	end
	local placedCount = 0
	for i, cell in cells do
		local p = dragPool[i]
		if not p then
			p = UI.new("Part", {
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
				Material = Enum.Material.Neon,
				Transparency = 0.45,
				Size = Vector3.new(CELL - 0.4, 0.2, CELL - 0.4),
			})
			dragPool[i] = p
		end
		local ok = selected ~= nil and Grid.CanPlace(state, stats.Expansion, selected, cell[1], cell[2], rotation)
		if ok then
			placedCount += 1
			ok = placedCount <= budget
		end
		p.Color = if ok then T.Good else T.Bad
		p.CFrame = LotLayout.CellCFrame(lot, cell[1], cell[2]) * CFrame.new(0, 0.45, 0)
		p.Parent = workspace
	end
	for i = #cells + 1, #dragPool do
		dragPool[i].Parent = nil
	end
	if selected then
		hint.Text = ("%d x %s = %s"):format(math.min(placedCount, budget), selected.Name, Format.Money(math.min(placedCount, budget) * selected.Cost))
	end
end

local function drawGridLines()
	local stats = State.Stats
	local lot = State.Lot()
	if not stats or not lot then
		return
	end
	if gridLines and gridExpansion == stats.Expansion then
		return
	end
	if gridLines then
		gridLines:Destroy()
	end
	gridExpansion = stats.Expansion
	local folder = UI.new("Folder", { Name = "BuildGrid" })
	local x1, x2, z1, z2 = Grid.Bounds(stats.Expansion)
	local lotCf = LotLayout.CFrame(lot)
	local lx1, lz1 = Grid.LocalPosition(x1, z1)
	local lx2, lz2 = Grid.LocalPosition(x2, z2)
	lx1 -= CELL / 2
	lz1 -= CELL / 2
	lx2 += CELL / 2
	lz2 += CELL / 2
	local function line(cf: CFrame, size: Vector3)
		UI.new("Part", {
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(120, 230, 255),
			Transparency = 0.6,
			Size = size,
			CFrame = cf,
			Parent = folder,
		})
	end
	for x = x1, x2 + 1 do
		local lx = lx1 + (x - x1) * CELL
		line(lotCf * CFrame.new(lx, 0.12, (lz1 + lz2) / 2), Vector3.new(0.15, 0.05, lz2 - lz1))
	end
	for z = z1, z2 + 1 do
		local lz = lz1 + (z - z1) * CELL
		line(lotCf * CFrame.new((lx1 + lx2) / 2, 0.12, lz), Vector3.new(lx2 - lx1, 0.05, 0.15))
	end
	folder.Parent = workspace
	gridLines = folder
end

local function radiusOf(def: Buildings.Building): (number, Color3?)
	if def.Radius then
		return def.Radius, T.Teal
	elseif def.LeisureRadius then
		return def.LeisureRadius, T.Good
	elseif def.PollutionRadius then
		return def.PollutionRadius, Color3.fromRGB(150, 110, 60)
	end
	return 0, nil
end

local function updateGhost()
	local lot = State.Lot()
	if not active or removing or not selected or not target or not lot then
		clearGhost()
		return
	end
	local key = selected.Id
	if ghostKey ~= key then
		clearGhost()
		ghostKey = key
		local radius, color = radiusOf(selected)
		if radius > 0 and color then
			range = UI.new("Part", {
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
				Material = Enum.Material.ForceField,
				Color = color,
				Transparency = 0.2,
			})
		end
	end
	local w, d = footprint()
	local placed = { X = target.X, Z = target.Z, R = rotation, W = w, D = d }
	local ok, reason = check(target.X, target.Z)
	if not ghost or ghostOk ~= ok then
		-- remonta para trocar a cor (MakeGhost troca os materiais de uma vez só)
		ghostOk = ok
		local fresh = BuildingModels.Build(selected)
		BuildingModels.MakeGhost(fresh, ok)
		if ghost then
			ghost:Destroy()
		end
		ghost = fresh
		fresh.Parent = workspace
	end
	(ghost :: Model):PivotTo(LotLayout.BuildingCFrame(lot, placed) * CFrame.new(0, 0.06, 0))
	if range and selected then
		local radius = radiusOf(selected)
		local cx, cz = Grid.Center(placed :: any)
		range.Size = Vector3.new((2 * radius + w) * CELL, 0.3, (2 * radius + d) * CELL)
		range.CFrame = LotLayout.CellCFrame(lot, cx, cz) * CFrame.new(0, 0.2, 0)
		range.Parent = workspace
	end
	if not dragStart then
		hint.Text = if ok
			then ("%s · %s"):format(selected.Name, Format.Money(selected.Cost))
			else (reason or "Não dá para construir aqui")
	end
end

local function updateRemoveHighlight()
	local lot = State.Lot()
	if not active or not removing or not target or not lot then
		if highlight then
			highlight.Adornee = nil
		end
		return
	end
	local uid = Grid.At(State.Grid(lot), target.X, target.Z)
	local lotModel = State.LotModel(lot)
	local model = uid and lotModel and lotModel.Buildings:FindFirstChild(tostring(uid))
	if not highlight then
		highlight = UI.new("Highlight", {
			FillColor = T.Bad,
			OutlineColor = T.Bad,
			FillTransparency = 0.5,
			DepthMode = Enum.HighlightDepthMode.Occluded,
			Parent = workspace,
		})
	end
	(highlight :: Highlight).Adornee = model
	if model then
		local def = Buildings.ById[model:GetAttribute("Id")]
		hint.Text = if def
			then ("Demolir %s (devolve %s)"):format(def.Name, Format.Money(math.floor(def.Cost * Config.SellRefund)))
			else ""
	else
		hint.Text = "Escolha um prédio para demolir"
	end
end

-- ===== Ações =====

local function placeAtTarget()
	if not selected or not target then
		return
	end
	local ok, reason = check(target.X, target.Z)
	if not ok then
		UI.Toast(reason or "Não dá para construir aqui", "erro")
		return
	end
	State.Request("place", { Id = selected.Id, X = target.X, Z = target.Z, R = rotation })
end

local function removeAtTarget()
	local lot = State.Lot()
	if not target or not lot then
		return
	end
	local uid = Grid.At(State.Grid(lot), target.X, target.Z)
	if uid then
		State.Request("remove", { Uid = uid })
	end
end

local refreshCards: () -> ()

local function setRemoving(value: boolean)
	removing = value
	UI.SetButtonColor(removeButton, if removing then T.Bad else T.Card)
	removeButton.Text = if removing then "Demolindo (X)" else "Demolir (X)"
	if removing then
		selected = nil
		clearGhost()
	end
	refreshCards()
end

local function selectBuilding(def: Buildings.Building)
	if removing then
		setRemoving(false)
	end
	selected = def
	if def.W ~= def.D then
		rotation = 0
	end
	clearGhost()
	refreshCards()
	UI.Sound("Click")
end

local function rotate()
	rotation = (rotation + 1) % 4
	clearGhost()
	if selected then
		local lot = State.Lot()
		if lot and target then
			updateGhost()
		end
	end
end

function BuildMode.Exit()
	if not active then
		return
	end
	active = false
	dragStart = nil
	palette.Visible = false
	toolbar.Visible = false
	confirmButton.Visible = false
	clearGhost()
	hideDrag()
	if gridLines then
		gridLines:Destroy()
		gridLines = nil
	end
	if highlight then
		highlight.Adornee = nil
	end
	buildButton.Text = "Construir (B)"
	onChanged:Fire(false)
end

function BuildMode.Enter()
	if active or not State.Stats then
		return
	end
	UI.CloseModals()
	active = true
	palette.Visible = true
	toolbar.Visible = true
	confirmButton.Visible = UI.IsMobile()
	drawGridLines()
	refreshCards()
	buildButton.Text = "Fechar (B)"
	-- longe de casa? volta para a cidade
	local lot = State.Lot()
	local character = player.Character
	local rootPart = character and character.PrimaryPart
	if lot and rootPart and not LotLayout.Contains(lot, rootPart.Position, 80) then
		State.Request("home")
	end
	onChanged:Fire(true)
end

function BuildMode.Toggle()
	if active then
		BuildMode.Exit()
	else
		BuildMode.Enter()
	end
end

-- ===== Menu =====

refreshCards = function()
	for id, button in tabButtons do
		UI.SetButtonColor(button, if id == category then T.Teal:Lerp(T.Card, 0.55) else T.Card)
	end
	for _, child in cardList:GetChildren() do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	for _, def in Buildings.List do
		if def.Category == category then
			local affordable, reason = canAfford(def)
			local locked = reason ~= nil and reason ~= "Falta dinheiro"
			local card = UI.Button(cardList, "", {
				LayoutOrder = (def :: any).Order,
				Size = UDim2.fromOffset(170, 112),
				BackgroundColor3 = if selected == def then T.CardHover else T.Card,
			}, function()
				selectBuilding(def)
			end)
			if selected == def then
				UI.Stroke(card, T.Accent, 2, 0)
			end
			UI.Padding(card, 8)
			UI.Label(card, def.Name, 15, { Font = UI.FontBold, Size = UDim2.new(1, -30, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd })
			UI.Label(card, def.W .. "x" .. def.D, 12, {
				TextColor3 = T.Muted,
				TextXAlignment = Enum.TextXAlignment.Right,
				Size = UDim2.new(1, 0, 0, 16),
			})
			UI.Label(card, Format.Money(def.Cost), 16, {
				Font = UI.FontBlack,
				TextColor3 = if affordable then T.Accent else T.Bad,
				Position = UDim2.fromOffset(0, 20),
			})
			UI.Label(card, if locked then "🔒 " .. (reason :: string) else describe(def), 12, {
				TextColor3 = if locked then T.Warn else T.Muted,
				Position = UDim2.fromOffset(0, 44),
				Size = UDim2.new(1, 0, 0, 52),
				TextYAlignment = Enum.TextYAlignment.Top,
			})
		end
	end
end

local function buildUi()
	local gui = HUD.Gui()
	palette = UI.Panel(gui, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, -80, 1, -14),
		Size = UDim2.new(1, -200, 0, 176),
		Visible = false,
	})
	local tabs = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -20, 0, 32), Parent = palette })
	UI.List(tabs, Enum.FillDirection.Horizontal, 6)
	for i, cat in Buildings.Categories do
		tabButtons[cat.Id] = UI.Button(tabs, cat.Name, { LayoutOrder = i, Size = UDim2.fromOffset(104, 30), TextSize = 14 }, function()
			category = cat.Id
			refreshCards()
		end)
	end
	cardList = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(10, 46),
		Size = UDim2.new(1, -20, 1, -54),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = T.Line,
		Parent = palette,
	})
	UI.List(cardList, Enum.FillDirection.Horizontal, 8)

	toolbar = UI.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, -80, 1, -198),
		Size = UDim2.fromOffset(640, 40),
		Visible = false,
		Parent = gui,
	})
	UI.List(toolbar, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	UI.Button(toolbar, "Girar (R)", { LayoutOrder = 1, Size = UDim2.fromOffset(110, 38) }, rotate)
	removeButton = UI.Button(toolbar, "Demolir (X)", { LayoutOrder = 2, Size = UDim2.fromOffset(140, 38) }, function()
		setRemoving(not removing)
	end)
	confirmButton = UI.Button(toolbar, "Construir aqui", {
		LayoutOrder = 3,
		Size = UDim2.fromOffset(150, 38),
		BackgroundColor3 = T.Good:Lerp(T.Card, 0.4),
		Visible = false,
	}, function()
		if removing then
			removeAtTarget()
		else
			placeAtTarget()
		end
	end)
	local hintFrame = UI.Panel(toolbar, { LayoutOrder = 4, Size = UDim2.fromOffset(280, 38) })
	hint = UI.Label(hintFrame, "", 14, {
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(6, 0),
		Size = UDim2.new(1, -12, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
	})

	buildButton = HUD.AddButton("Construir (B)", 1, T.Accent:Lerp(T.Card, 0.55), BuildMode.Toggle)
end

-- ===== Entrada =====

local function onPointerMoved(position: Vector2, isTouch: boolean)
	if not active then
		return
	end
	setTarget(position, isTouch)
	if removing then
		updateRemoveHighlight()
	elseif dragStart then
		local lot = State.Lot()
		if lot then
			showDrag(lot)
		end
	else
		updateGhost()
	end
end

function BuildMode.Init()
	buildUi()
	selected = Buildings.ById.rua

	State.Changed.Event:Connect(function()
		if active then
			drawGridLines()
			refreshCards()
			ghostOk = nil -- dinheiro mudou: refaz o fantasma com a cor certa
			if target and not dragStart then
				if removing then
					updateRemoveHighlight()
				else
					updateGhost()
				end
			end
		end
	end)

	RunService.RenderStepped:Connect(function()
		if active and not UI.IsMobile() then
			onPointerMoved(UserInputService:GetMouseLocation(), false)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			local key = input.KeyCode
			if key == Enum.KeyCode.B then
				BuildMode.Toggle()
			elseif active and key == Enum.KeyCode.R then
				rotate()
			elseif active and key == Enum.KeyCode.X then
				setRemoving(not removing)
			elseif active and (key == Enum.KeyCode.Q or key == Enum.KeyCode.Escape) then
				BuildMode.Exit()
			end
		elseif active and input.UserInputType == Enum.UserInputType.MouseButton1 then
			setTarget(UserInputService:GetMouseLocation(), false)
			if removing then
				removeAtTarget()
			elseif selected and selected.W == 1 and selected.D == 1 and target then
				dragStart = { X = target.X, Z = target.Z }
				clearGhost()
				local lot = State.Lot()
				if lot then
					showDrag(lot)
				end
			else
				placeAtTarget()
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 or not dragStart then
			return
		end
		local cells = dragCells()
		dragStart = nil
		hideDrag()
		if not selected or #cells == 0 then
			return
		end
		if #cells == 1 then
			placeAtTarget()
		else
			State.Request("line", { Id = selected.Id, Cells = cells, R = rotation })
		end
	end)

	-- celular: o toque escolhe o lugar (o botão "Construir aqui" confirma)
	UserInputService.TouchTap:Connect(function(positions, processed)
		if not active or processed or #positions == 0 then
			return
		end
		local p = positions[1]
		onPointerMoved(Vector2.new(p.X, p.Y), true)
	end)
end

return BuildMode
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="116">
        <Properties>
          <string name="Name">Citizens</string>
          <string name="Source"><![CDATA[--[[
	Citizens (ModuleScript em StarterPlayerScripts)          Prefeito Tycoon
	Moradores andando pelas ruas (só enfeite, só no seu computador: o servidor não sabe deles).
	Quanto mais gente na cidade, mais pedestres (até um limite). Só desenha cidades perto da câmera.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Buildings = require(Shared.Buildings)
local LotLayout = require(Shared.LotLayout)

local Scripts = script.Parent
local State = require(Scripts.State)

local Citizens = {}

local MAX_PER_LOT = 14
local PER_WALKER = 30 -- 1 pedestre a cada 30 moradores
local VIEW_DISTANCE = 520
local N = Config.GridSize

local SHIRTS = {
	Color3.fromRGB(60, 90, 160), Color3.fromRGB(170, 60, 60), Color3.fromRGB(60, 140, 90),
	Color3.fromRGB(200, 170, 60), Color3.fromRGB(90, 90, 100), Color3.fromRGB(230, 230, 230),
	Color3.fromRGB(120, 70, 150), Color3.fromRGB(40, 40, 46),
}
local SKINS = { Color3.fromRGB(240, 205, 170), Color3.fromRGB(200, 150, 110), Color3.fromRGB(140, 95, 65), Color3.fromRGB(90, 60, 45) }

type Walker = { Body: Part, Head: Part, X: number, Z: number, Alive: boolean }

local folder: Folder
local walkers: { [number]: { Walker } } = {}

local function roadSet(lot: number): ({ [number]: boolean }, { { number } })
	local state = State.Grid(lot)
	local set, list = {}, {}
	for x = 1, N do
		set[Grid.Index(x, Config.AvenueRow)] = true
		table.insert(list, { x, Config.AvenueRow })
	end
	for _, placed in state.Buildings do
		local def = Buildings.ById[placed.Id]
		if def and def.Category == "road" then
			set[Grid.Index(placed.X, placed.Z)] = true
			table.insert(list, { placed.X, placed.Z })
		end
	end
	return set, list
end

local function makeWalker(lot: number, start: { number }): Walker
	local body = Instance.new("Part")
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.CanTouch = false
	body.CastShadow = false
	body.Size = Vector3.new(1.1, 2.4, 0.7)
	body.Color = SHIRTS[math.random(1, #SHIRTS)]
	body.Material = Enum.Material.SmoothPlastic
	local head = body:Clone()
	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.new(0.9, 0.9, 0.9)
	head.Color = SKINS[math.random(1, #SKINS)]
	local walker: Walker = { Body = body, Head = head, X = start[1], Z = start[2], Alive = true }
	local side = if math.random() < 0.5 then -2.8 else 2.8
	local cf = LotLayout.CellCFrame(lot, walker.X, walker.Z) * CFrame.new(side, 1.5, 0)
	body.CFrame = cf
	head.CFrame = cf * CFrame.new(0, 1.65, 0)
	body.Parent = folder
	head.Parent = folder

	task.spawn(function()
		while walker.Alive do
			local set = roadSet(lot)
			local options = {}
			for _, step in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
				local nx, nz = walker.X + step[1], walker.Z + step[2]
				if nx >= 1 and nx <= N and nz >= 1 and nz <= N and set[Grid.Index(nx, nz)] then
					table.insert(options, { nx, nz })
				end
			end
			if #options == 0 then
				task.wait(2)
			else
				local nextCell = options[math.random(1, #options)]
				local from = LotLayout.CellCFrame(lot, walker.X, walker.Z)
				local to = LotLayout.CellCFrame(lot, nextCell[1], nextCell[2])
				walker.X, walker.Z = nextCell[1], nextCell[2]
				local look = CFrame.lookAt(from.Position, to.Position)
				local goal = (look - look.Position + to.Position) * CFrame.new(side, 1.5, 0)
				local time = (to.Position - from.Position).Magnitude / 4.5
				TweenService:Create(body, TweenInfo.new(time, Enum.EasingStyle.Linear), { CFrame = goal }):Play()
				TweenService:Create(head, TweenInfo.new(time, Enum.EasingStyle.Linear), { CFrame = goal * CFrame.new(0, 1.65, 0) }):Play()
				task.wait(time + math.random() * 0.6)
			end
		end
		body:Destroy()
		head:Destroy()
	end)
	return walker
end

local function update()
	local camera = workspace.CurrentCamera
	local lots = workspace:FindFirstChild("Lots")
	if not camera or not lots then
		return
	end
	for _, lotModel in lots:GetChildren() do
		local index = lotModel:GetAttribute("Index")
		if type(index) == "number" then
			local list = walkers[index] or {}
			walkers[index] = list
			local near = (LotLayout.CFrame(index).Position - camera.CFrame.Position).Magnitude < VIEW_DISTANCE
			local population = lotModel:GetAttribute("Population") or 0
			local want = if near then math.clamp(population // PER_WALKER, 0, MAX_PER_LOT) else 0
			while #list > want do
				table.remove(list).Alive = false
			end
			if #list < want then
				local _, roads = roadSet(index)
				while #list < want and #roads > 0 do
					table.insert(list, makeWalker(index, roads[math.random(1, #roads)]))
				end
			end
		end
	end
end

function Citizens.Init()
	folder = Instance.new("Folder")
	folder.Name = "Citizens"
	folder.Parent = workspace
	task.spawn(function()
		while true do
			pcall(update)
			task.wait(2)
		end
	end)
end

return Citizens
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="117">
        <Properties>
          <string name="Name">CityPanel</string>
          <string name="Source"><![CDATA[--[[
	CityPanel (ModuleScript em StarterPlayerScripts)          Prefeito Tycoon
	Janela "Cidade" (tecla C): números, necessidades dos moradores, expandir terreno, aumentar o
	cofre, nome da cidade, reeleição e loja.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Scripts = script.Parent
local UI = require(Scripts.UI)
local State = require(Scripts.State)
local HUD = require(Scripts.HUD)

local T = UI.Theme

local CityPanel = {}

local modal: UI.Modal
local section: { [string]: any } = {}
local nameA, nameB = 1, 1
local nameDirty = false

local NEED_TIPS = {
	comercio = "Padaria, Mercado, Shopping",
	saude = "Posto de Saúde, Hospital",
	seguranca = "Delegacia, Bombeiros",
	educacao = "Escola, Universidade",
}

local function header(text: string, order: number)
	UI.Label(modal.Body, text, 17, { Font = UI.FontBlack, TextColor3 = T.Accent, LayoutOrder = order })
end

local function card(order: number, height: number): Frame
	local frame = UI.new("Frame", {
		BackgroundColor3 = T.Card,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -8, 0, height),
		LayoutOrder = order,
		Parent = modal.Body,
	})
	UI.Corner(frame, 8)
	UI.Padding(frame, 10)
	return frame
end

local function build()
	modal = UI.Modal("Sua Cidade", 560, 600)
	UI.List(modal.Body, nil, 8)

	-- números
	header("Números", 1)
	local numbers = card(2, 150)
	section.Numbers = UI.Label(numbers, "", 15, { Size = UDim2.fromScale(1, 1), TextYAlignment = Enum.TextYAlignment.Top })

	-- necessidades
	header("O que os moradores querem", 3)
	local needs = card(4, 30 * #Config.Needs + 34)
	UI.List(needs, nil, 6)
	section.Needs = {}
	for i, need in Config.Needs do
		local row = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = i, Parent = needs })
		local label = UI.Label(row, need.Name, 14, { Size = UDim2.new(0.55, 0, 1, 0) })
		local set = UI.Bar(row, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.55, 0, 0.5, 0), Size = UDim2.new(0.45, 0, 0, 8) })
		section.Needs[need.Id] = { Label = label, Set = set, Need = need }
	end
	UI.Label(needs, "Cada casa precisa estar no alcance de um prédio que atende a necessidade.", 12, {
		TextColor3 = T.Muted,
		LayoutOrder = 99,
		Size = UDim2.new(1, 0, 0, 28),
	})

	-- melhorias
	header("Melhorias", 5)
	local upgrades = card(6, 104)
	section.ExpandText = UI.Label(upgrades, "", 14, { Size = UDim2.new(1, -170, 0, 40) })
	section.Expand = UI.Button(upgrades, "Expandir", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(160, 38),
		BackgroundColor3 = T.Teal:Lerp(T.Card, 0.5),
	}, function()
		State.Request("expand")
	end)
	section.VaultText = UI.Label(upgrades, "", 14, { Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, -170, 0, 40) })
	section.Vault = UI.Button(upgrades, "Cofre maior", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 46),
		Size = UDim2.fromOffset(160, 38),
		BackgroundColor3 = T.Accent:Lerp(T.Card, 0.5),
	}, function()
		State.Request("vault")
	end)

	-- nome
	header("Nome da cidade", 7)
	local nameCard = card(8, 58)
	local function cycler(x: number, getter: () -> number, setter: (number) -> (), list: { string }): TextLabel
		UI.Button(nameCard, "◀", { Position = UDim2.fromOffset(x, 0), Size = UDim2.fromOffset(30, 38) }, function()
			setter((getter() - 2) % #list + 1)
			nameDirty = true
			CityPanel.RefreshName()
		end)
		local label = UI.Label(nameCard, "", 15, {
			Font = UI.FontBold,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(x + 32, 8),
			Size = UDim2.fromOffset(110, 22),
		})
		UI.Button(nameCard, "▶", { Position = UDim2.fromOffset(x + 144, 0), Size = UDim2.fromOffset(30, 38) }, function()
			setter(getter() % #list + 1)
			nameDirty = true
			CityPanel.RefreshName()
		end)
		return label
	end
	section.NameA = cycler(0, function()
		return nameA
	end, function(v)
		nameA = v
	end, Config.CityNameA)
	section.NameB = cycler(180, function()
		return nameB
	end, function(v)
		nameB = v
	end, Config.CityNameB)
	UI.Button(nameCard, "Salvar", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(110, 38),
	}, function()
		State.Request("rename", { A = nameA, B = nameB })
		nameDirty = false
	end)

	-- reeleição
	header("Reeleição", 9)
	local reelect = card(10, 96)
	section.ReelectText = UI.Label(reelect, "", 14, { Size = UDim2.new(1, -170, 1, 0), TextYAlignment = Enum.TextYAlignment.Top })
	local confirming = false
	section.Reelect = UI.Button(reelect, "Reeleição", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(160, 38),
		BackgroundColor3 = T.Event:Lerp(T.Card, 0.5),
	}, function()
		if not confirming then
			confirming = true
			section.Reelect.Text = "Confirmar?"
			task.delay(4, function()
				confirming = false
				section.Reelect.Text = "Reeleição"
			end)
			return
		end
		confirming = false
		section.Reelect.Text = "Reeleição"
		State.Request("reelect")
		modal.Close()
	end)

	-- loja
	header("Loja", 11)
	local shop = card(12, 96)
	UI.List(shop, Enum.FillDirection.Horizontal, 8)
	UI.Button(shop, "Renda x2\n(passe)", { LayoutOrder = 1, Size = UDim2.fromOffset(120, 70), TextSize = 14 }, function()
		State.Request("buyPass", "DoubleIncome")
	end)
	UI.Button(shop, "Cofre\nautomático", { LayoutOrder = 2, Size = UDim2.fromOffset(120, 70), TextSize = 14 }, function()
		State.Request("buyPass", "AutoCollect")
	end)
	for i, product in Config.DevProducts do
		UI.Button(shop, ("+%d min\nde renda"):format(product.Minutes), { LayoutOrder = 2 + i, Size = UDim2.fromOffset(120, 70), TextSize = 14 }, function()
			State.Request("buyCash", i)
		end)
	end
end

function CityPanel.RefreshName()
	section.NameA.Text = Config.CityNameA[nameA] or "?"
	section.NameB.Text = Config.CityNameB[nameB] or "?"
end

local function refresh(s: any)
	if not modal.IsOpen() then
		return
	end
	section.Numbers.Text = table.concat({
		("População: <b>%s</b> (meta %s, vagas %s)"):format(Format.Int(s.Population, "."), Format.Int(s.Target, "."), Format.Int(s.Housing, ".")),
		("Felicidade: <b>%s</b>   ·   Visitantes agora: <b>%d</b>"):format(Format.Percent(s.Happiness), s.Visitors),
		("Empregos: <b>%s</b> ocupados de %s"):format(Format.Int(math.min(s.Workers, s.Jobs), "."), Format.Int(s.Jobs, ".")),
		("Energia: <b>%s</b> produzida, %s usada"):format(Format.Int(s.PowerSupply, "."), Format.Int(s.PowerDemand, ".")),
		("Renda: <b>%s/s</b>   ·   bônus x%s"):format(Format.Money(s.Income), Format.Number(s.Multiplier, 2, ".", ",")),
		("Prédios sem rua: <b>%d</b>"):format(s.NoRoad),
	}, "\n")

	for id, row in section.Needs do
		local active = s.Tier >= row.Need.Tier
		local value = s.Coverage[id] or 0
		if active then
			row.Label.Text = ("%s <font color=\"#969EB2\">(%s)</font>"):format(row.Need.Name, NEED_TIPS[id] or "")
			row.Set(value, if value >= 0.8 then T.Good elseif value >= 0.4 then T.Warn else T.Bad)
		else
			row.Label.Text = ("%s <font color=\"#969EB2\">(a partir de %s)</font>"):format(row.Need.Name, Config.Tiers[row.Need.Tier].Name)
			row.Set(value, T.Line)
		end
	end

	local nextExpansion = Config.Expansions[s.Expansion + 1]
	if nextExpansion then
		section.ExpandText.Text = ("Terreno %dx%d → <b>%dx%d</b>"):format(Config.Expansions[s.Expansion].Size, Config.Expansions[s.Expansion].Size, nextExpansion.Size, nextExpansion.Size)
		section.Expand.Text = "Expandir " .. Format.Money(nextExpansion.Cost)
		section.Expand.Visible = true
	else
		section.ExpandText.Text = "Terreno no tamanho máximo."
		section.Expand.Visible = false
	end
	local levels = Config.Vault.Levels
	local nextVault = levels[s.VaultLevel + 1]
	if nextVault then
		section.VaultText.Text = ("Cofre guarda %d min de renda → <b>%d min</b>"):format(levels[s.VaultLevel].Minutes, nextVault.Minutes)
		section.Vault.Text = "Cofre " .. Format.Money(nextVault.Cost)
		section.Vault.Visible = true
	else
		section.VaultText.Text = "Cofre no tamanho máximo."
		section.Vault.Visible = false
	end

	if not nameDirty then
		nameA, nameB = s.NameA, s.NameB
		CityPanel.RefreshName()
	end

	local need = Config.Reelection.Population
	section.ReelectText.Text = ("Com %s moradores você pode se reeleger: a cidade recomeça do zero, mas toda renda ganha <b>+%d%%</b> para sempre. Agora: +%d%%."):format(
		Format.Int(need, "."),
		math.floor(Config.Reelection.BonusPerTerm * 100),
		math.floor(s.Reelections * Config.Reelection.BonusPerTerm * 100)
	)
	section.Reelect.Visible = s.Population >= need
end

function CityPanel.Init()
	build()
	HUD.AddButton("Cidade (C)", 2, nil, modal.Toggle)
	modal.OnOpen.Event:Connect(function()
		nameDirty = false
		if State.Stats then
			refresh(State.Stats)
		end
	end)
	State.Changed.Event:Connect(refresh)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.C then
			modal.Toggle()
		end
	end)
end

return CityPanel
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="118">
        <Properties>
          <string name="Name">ClientMain</string>
          <string name="Source"><![CDATA[--[[
	ClientMain (LocalScript em StarterPlayerScripts)          Prefeito Tycoon
	Liga a interface. Cada parte começa num pcall: se uma quebrar, o resto continua.
]]

local Scripts = script.Parent

for _, name in { "HUD", "BuildMode", "CityPanel", "Travel", "Citizens", "Tutorial", "Ambience" } do
	local module = Scripts:WaitForChild(name, 10)
	if module then
		local ok, err = pcall(function()
			require(module :: any).Init()
		end)
		if not ok then
			warn("[Cliente] " .. name .. " não iniciou:", err)
		end
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="119">
        <Properties>
          <string name="Name">HUD</string>
          <string name="Source"><![CDATA[--[[
	HUD (ModuleScript em StarterPlayerScripts)          Prefeito Tycoon
	Tela fixa: nome e nível da cidade, dinheiro e renda, cofre, números da cidade, evento ativo,
	botões principais e os avisos do servidor.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Scripts = script.Parent
local UI = require(Scripts.UI)
local State = require(Scripts.State)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local T = UI.Theme

local HUD = {}

-- Os outros módulos registram os botões principais aqui (Construir, Cidade, Viajar...)
local buttonBar: Frame
local gui: ScreenGui

function HUD.AddButton(text: string, order: number, color: Color3?, onClick: () -> ()): TextButton
	return UI.Button(buttonBar, text, {
		LayoutOrder = order,
		Size = UDim2.fromOffset(150, 46),
		BackgroundColor3 = color or T.Card,
		TextSize = 17,
	}, onClick)
end

function HUD.Gui(): ScreenGui
	return gui
end

local function floatText(text: string, color: Color3)
	local label = UI.Label(gui, text, 26, {
		Font = UI.FontBlack,
		TextColor3 = color,
		TextStrokeTransparency = 0.3,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 110),
		Size = UDim2.fromOffset(300, 34),
	})
	TweenService:Create(label, TweenInfo.new(1.2, Enum.EasingStyle.Quad), {
		Position = UDim2.new(0.5, 0, 0, 60),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
	task.delay(1.3, function()
		label:Destroy()
	end)
end

local function banner(title: string, subtitle: string)
	local frame = UI.Panel(gui, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.35),
		Size = UDim2.fromOffset(520, 110),
		BackgroundColor3 = T.Bg,
	})
	UI.Stroke(frame, T.Accent, 2, 0)
	UI.Label(frame, title, 34, {
		Font = UI.FontBlack,
		TextColor3 = T.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 16),
		Size = UDim2.new(1, 0, 0, 40),
	})
	UI.Label(frame, subtitle, 17, {
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(10, 62),
		Size = UDim2.new(1, -20, 0, 40),
	})
	task.delay(4, function()
		frame:Destroy()
	end)
end

function HUD.Init()
	gui = UI.Screen("HUD", 2)

	-- ===== Cidade (canto superior esquerdo) =====
	local cityCard = UI.Panel(gui, { Position = UDim2.fromOffset(14, 14), Size = UDim2.fromOffset(290, 106) })
	UI.Padding(cityCard, 12)
	local cityName = UI.Label(cityCard, "Carregando...", 20, { Font = UI.FontBlack, Size = UDim2.new(1, 0, 0, 24), TextTruncate = Enum.TextTruncate.AtEnd })
	local tierLabel = UI.Label(cityCard, "", 14, { TextColor3 = T.Muted, Position = UDim2.fromOffset(0, 28) })
	local setTier = UI.Bar(cityCard, { Position = UDim2.fromOffset(0, 52) })
	local tierNext = UI.Label(cityCard, "", 13, { TextColor3 = T.Muted, Position = UDim2.fromOffset(0, 62) })

	-- ===== Dinheiro (topo, centro) =====
	local moneyCard = UI.Panel(gui, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.fromOffset(300, 70) })
	local cash = UI.Label(moneyCard, "$0", 30, {
		Font = UI.FontBlack,
		TextColor3 = T.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 6),
		Size = UDim2.new(1, 0, 0, 34),
	})
	local income = UI.Label(moneyCard, "", 14, {
		TextColor3 = T.Good,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.new(1, 0, 0, 18),
	})
	local vaultCard = UI.Panel(gui, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 90), Size = UDim2.fromOffset(300, 30) })
	local vaultText = UI.Label(vaultCard, "", 13, {
		Font = UI.FontBold,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 2),
		Size = UDim2.new(1, 0, 0, 16),
		ZIndex = 2,
	})
	local setVault = UI.Bar(vaultCard, { Position = UDim2.new(0, 10, 1, -9), Size = UDim2.new(1, -20, 0, 5) })

	-- ===== Números (canto superior direito) =====
	local statsCard = UI.Panel(gui, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14), Size = UDim2.fromOffset(230, 132) })
	UI.Padding(statsCard, 10)
	UI.List(statsCard, nil, 4)
	local rows: { [string]: TextLabel } = {}
	for i, key in { "Pop", "Happy", "Power", "Jobs" } do
		local row = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = i, Parent = statsCard })
		UI.Label(row, ({ Pop = "População", Happy = "Felicidade", Power = "Energia", Jobs = "Empregos" })[key], 14, {
			TextColor3 = T.Muted,
			Size = UDim2.fromScale(0.5, 1),
		})
		rows[key] = UI.Label(row, "-", 15, {
			Font = UI.FontBold,
			TextXAlignment = Enum.TextXAlignment.Right,
			Position = UDim2.fromScale(0.4, 0),
			Size = UDim2.fromScale(0.6, 1),
		})
	end
	local warning = UI.Label(gui, "", 14, {
		Font = UI.FontBold,
		TextColor3 = T.Bad,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 150),
		Size = UDim2.fromOffset(300, 40),
	})

	-- ===== Evento =====
	local eventCard = UI.Panel(gui, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 128),
		Size = UDim2.fromOffset(420, 52),
		Visible = false,
	})
	UI.Stroke(eventCard, T.Event, 1.5, 0)
	local eventText = UI.Label(eventCard, "", 14, {
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(8, 4),
		Size = UDim2.new(1, -16, 1, -8),
	})

	-- ===== Botões =====
	buttonBar = UI.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		-- no celular o botão de pular fica no canto de baixo à direita: sobe a coluna
		Position = if UI.IsMobile() then UDim2.new(1, -14, 1, -170) else UDim2.new(1, -14, 1, -14),
		Size = UDim2.fromOffset(150, 230),
		Parent = gui,
	})
	local layout = UI.List(buttonBar, nil, 8, Enum.HorizontalAlignment.Right)
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom

	-- ===== Atualização =====
	local function refresh(s: any)
		cityName.Text = s.CityName
		local tiers = Config.Tiers
		local tier = tiers[s.Tier] or tiers[1]
		local term = if s.Reelections > 0 then ("  ·  %dº mandato"):format(s.Reelections + 1) else ""
		tierLabel.Text = tier.Name .. term .. ("  ·  ★ %d"):format(s.Stars)
		local nextTier = tiers[s.Tier + 1]
		if nextTier then
			local span = nextTier.Population - tier.Population
			setTier((s.Population - tier.Population) / span, T.Teal)
			tierNext.Text = ("%s / %s hab. até %s"):format(Format.Int(s.Population, "."), Format.Int(nextTier.Population, "."), nextTier.Name)
		else
			setTier(1, T.Accent)
			tierNext.Text = "Nível máximo!"
		end

		cash.Text = Format.Money(s.Cash)
		local mult = if s.Multiplier > 1.001 then ("  (x%s)"):format(Format.Number(s.Multiplier, 2, ".", ",")) else ""
		income.Text = "+" .. Format.Money(s.Income) .. "/s" .. mult
		if s.AutoCollect then
			vaultText.Text = "Cofre: coleta automática"
			setVault(1, T.Good)
		else
			local fill = if s.VaultCapacity > 0 then s.Vault / s.VaultCapacity else 0
			vaultText.Text = ("Cofre da Prefeitura: %s / %s"):format(Format.Money(s.Vault), Format.Money(s.VaultCapacity))
			setVault(fill, if fill >= 1 then T.Bad elseif fill > 0.8 then T.Warn else T.Accent)
		end

		rows.Pop.Text = ("%s / %s"):format(Format.Short(s.Population), Format.Short(s.Housing))
		local happy = s.Happiness
		rows.Happy.Text = Format.Percent(happy)
		rows.Happy.TextColor3 = if happy >= Config.Happiness.Attractive
			then T.Good
			elseif happy >= Config.Happiness.Unhappy then T.Warn
			else T.Bad
		rows.Power.Text = ("%s / %s"):format(Format.Short(s.PowerSupply), Format.Short(s.PowerDemand))
		rows.Power.TextColor3 = if s.PowerSupply >= s.PowerDemand then T.Good else T.Bad
		rows.Jobs.Text = ("%s / %s"):format(Format.Short(math.min(s.Workers, s.Jobs)), Format.Short(s.Jobs))

		local warnings = {}
		if s.NoRoad > 0 then
			table.insert(warnings, ("⚠ %d prédio(s) sem rua ligada à Avenida"):format(s.NoRoad))
		end
		if s.PowerSupply < s.PowerDemand then
			table.insert(warnings, "⚠ Falta energia: construa usinas")
		end
		warning.Text = table.concat(warnings, "\n")
	end
	State.Changed.Event:Connect(refresh)
	if State.Stats then
		refresh(State.Stats)
	end

	task.spawn(function()
		while true do
			local id = ReplicatedStorage:GetAttribute("Event")
			if type(id) == "string" and id ~= "" then
				local left = (ReplicatedStorage:GetAttribute("EventEnds") or 0) - os.time()
				eventCard.Visible = true
				eventText.Text = ("<b>%s</b> (%s)\n%s"):format(
					ReplicatedStorage:GetAttribute("EventName") or "",
					Format.Time(left),
					ReplicatedStorage:GetAttribute("EventText") or ""
				)
			else
				eventCard.Visible = false
			end
			task.wait(1)
		end
	end)

	-- ===== Servidor -> tela =====
	Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(text, kind)
		UI.Toast(text, kind)
	end)
	Remotes:WaitForChild("Effect").OnClientEvent:Connect(function(kind, data)
		if kind == "placed" then
			UI.Sound("Place")
		elseif kind == "removed" then
			UI.Sound("Remove")
		elseif kind == "collect" then
			UI.Sound("Coin")
			floatText("+" .. Format.Money(tonumber(data) or 0), T.Accent)
		elseif kind == "upgrade" or kind == "star" then
			UI.Sound("Upgrade")
		elseif kind == "tier" then
			UI.Sound("Fanfare")
			local tier = Config.Tiers[tonumber(data) or 1]
			banner(string.upper(tier and tier.Name or ""), "Sua cidade cresceu! Prédios novos no menu Construir.")
		elseif kind == "reelected" then
			UI.Sound("Fanfare")
			banner("REELEITO!", ("Mandato %d: toda renda com bônus permanente."):format((tonumber(data) or 0) + 1))
		end
	end)
end

return HUD
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="120">
        <Properties>
          <string name="Name">State</string>
          <string name="Source"><![CDATA[--[[
	State (ModuleScript em StarterPlayerScripts)          Prefeito Tycoon
	O que o cliente sabe da própria cidade: o último painel mandado pelo servidor (Stats) e a grade
	de qualquer terreno, montada a partir dos prédios no Workspace (Lots > LotN > Buildings).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Buildings = require(Shared.Buildings)
local Grid = require(Shared.Grid)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local State = {}

State.Stats = nil :: any
State.Changed = Instance.new("BindableEvent")

Remotes:WaitForChild("Stats").OnClientEvent:Connect(function(stats)
	State.Stats = stats
	State.Changed:Fire(stats)
end)

function State.Request(action: string, payload: any?)
	Remotes.Request:FireServer(action, payload)
end

function State.Lot(): number?
	local stats = State.Stats
	if stats then
		return stats.Lot
	end
	local lot = player:GetAttribute("Lot")
	return if type(lot) == "number" then lot else nil
end

function State.LotModel(index: number?): Model?
	local lots = workspace:FindFirstChild("Lots")
	if not lots or not index then
		return nil
	end
	return lots:FindFirstChild("Lot" .. index) :: Model?
end

-- Grade montada a partir dos modelos (cache por terreno; refaz quando um prédio entra ou sai)
local grids: { [number]: { State: Grid.State?, Dirty: boolean, Hooked: boolean } } = {}

function State.Grid(index: number): Grid.State
	local entry = grids[index]
	if not entry then
		entry = { State = nil, Dirty = true, Hooked = false }
		grids[index] = entry
	end
	local model = State.LotModel(index)
	local folder = model and model:FindFirstChild("Buildings")
	if folder and not entry.Hooked then
		entry.Hooked = true
		folder.ChildAdded:Connect(function()
			entry.Dirty = true
		end)
		folder.ChildRemoved:Connect(function()
			entry.Dirty = true
		end)
	end
	if entry.Dirty or not entry.State then
		local state = Grid.new()
		if folder then
			for _, child in folder:GetChildren() do
				local def = Buildings.ById[child:GetAttribute("Id")]
				local x, z, r = child:GetAttribute("X"), child:GetAttribute("Z"), child:GetAttribute("R")
				local uid = child:GetAttribute("Uid")
				if def and type(x) == "number" and type(z) == "number" and type(r) == "number" and type(uid) == "number" then
					state.NextUid = uid
					Grid.Place(state, def, x, z, r)
				end
			end
		end
		entry.State = state
		entry.Dirty = false
	end
	return entry.State :: Grid.State
end

function State.MarkDirty(index: number)
	local entry = grids[index]
	if entry then
		entry.Dirty = true
	end
end

return State
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="121">
        <Properties>
          <string name="Name">Travel</string>
          <string name="Source"><![CDATA[--[[
	Travel (ModuleScript em StarterPlayerScripts)          Prefeito Tycoon
	Janela "Viajar" (tecla V): as cidades do servidor, com prefeito, população, felicidade e estrelas.
	Visitar teleporta até a Prefeitura da cidade; Recomendar dá uma estrela (1 por cidade por dia)
	e dinheiro para os dois. Visitantes na sua cidade aumentam a sua renda.
	Também cria o botão "Minha cidade" (tecla H).
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Format = require(ReplicatedStorage:WaitForChild("Shared").Format)

local Scripts = script.Parent
local UI = require(Scripts.UI)
local State = require(Scripts.State)
local HUD = require(Scripts.HUD)

local player = Players.LocalPlayer
local T = UI.Theme

local Travel = {}

local modal: UI.Modal

local function refresh()
	if not modal.IsOpen() then
		return
	end
	for _, child in modal.Body:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local lots = workspace:FindFirstChild("Lots")
	if not lots then
		return
	end
	local entries = {}
	for _, lot in lots:GetChildren() do
		local owner = lot:GetAttribute("Owner")
		if type(owner) == "number" and owner ~= 0 then
			table.insert(entries, lot)
		end
	end
	table.sort(entries, function(a, b)
		return (a:GetAttribute("Population") or 0) > (b:GetAttribute("Population") or 0)
	end)
	for i, lot in entries do
		local index = lot:GetAttribute("Index")
		local mine = lot:GetAttribute("Owner") == player.UserId
		local row = UI.new("Frame", {
			BackgroundColor3 = if mine then T.CardHover else T.Card,
			BorderSizePixel = 0,
			Size = UDim2.new(1, -8, 0, 70),
			LayoutOrder = i,
			Parent = modal.Body,
		})
		UI.Corner(row, 8)
		UI.Padding(row, 10)
		UI.Label(row, ("%d. %s%s"):format(i, lot:GetAttribute("CityName") or "?", if mine then "  (sua)" else ""), 16, {
			Font = UI.FontBold,
			Size = UDim2.new(1, -230, 0, 22),
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		UI.Label(row, ("Prefeito %s  ·  %s hab.  ·  %d%% feliz  ·  ★ %d"):format(
			lot:GetAttribute("OwnerName") or "?",
			Format.Short(lot:GetAttribute("Population") or 0),
			lot:GetAttribute("Happiness") or 0,
			lot:GetAttribute("Stars") or 0
		), 13, {
			TextColor3 = T.Muted,
			Position = UDim2.fromOffset(0, 26),
			Size = UDim2.new(1, -230, 0, 20),
		})
		if not mine then
			UI.Button(row, "Visitar", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -116, 0.5, 0),
				Size = UDim2.fromOffset(104, 40),
			}, function()
				State.Request("visit", { Lot = index })
				modal.Close()
			end)
			UI.Button(row, "★ Recomendar", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(110, 40),
				TextSize = 14,
				BackgroundColor3 = T.Accent:Lerp(T.Card, 0.55),
			}, function()
				State.Request("recommend", { Lot = index })
			end)
		end
	end
	if #entries <= 1 then
		UI.Label(UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 60), LayoutOrder = 99, Parent = modal.Body }),
			"Nenhuma outra cidade neste servidor ainda. Chame os amigos: cidades vizinhas trocam moradores e estrelas!", 14, {
				TextColor3 = T.Muted,
				Size = UDim2.fromScale(1, 1),
			})
	end
end

function Travel.Init()
	modal = UI.Modal("Cidades do servidor", 620, 520)
	UI.List(modal.Body, nil, 8)
	modal.OnOpen.Event:Connect(refresh)
	HUD.AddButton("Viajar (V)", 3, nil, modal.Toggle)
	HUD.AddButton("Minha cidade (H)", 4, nil, function()
		State.Request("home")
	end)
	task.spawn(function()
		while true do
			task.wait(3)
			refresh()
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.V then
			modal.Toggle()
		elseif input.KeyCode == Enum.KeyCode.H then
			State.Request("home")
		end
	end)
end

return Travel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="122">
        <Properties>
          <string name="Name">Tutorial</string>
          <string name="Source"><![CDATA[--[[
	Tutorial (ModuleScript em StarterPlayerScripts)          Prefeito Tycoon
	Primeiros passos do prefeito novo. O passo atual fica salvo no servidor (Data.Tutorial).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Scripts = script.Parent
local UI = require(Scripts.UI)
local State = require(Scripts.State)
local HUD = require(Scripts.HUD)

local T = UI.Theme

local Tutorial = {}

local function count(id: string): number
	local lot = State.Lot()
	if not lot then
		return 0
	end
	local total = 0
	for _, placed in State.Grid(lot).Buildings do
		if placed.Id == id then
			total += 1
		end
	end
	return total
end

local collected = false

local STEPS = {
	{
		Text = "Bem-vindo, prefeito! Aperte <b>Construir (B)</b> e faça uma <b>Rua</b> saindo da Avenida (clique e arraste).",
		Done = function()
			return count("rua") >= 1
		end,
	},
	{
		Text = "Agora construa <b>4 Casas</b> (aba Moradia) encostadas na rua ou na Avenida.",
		Done = function()
			return count("casa") >= 4
		end,
	},
	{
		Text = "Casa sem luz fica vazia. Construa um <b>Gerador a Diesel</b> (aba Energia) encostado numa rua e longe das casas: ele polui.",
		Done = function()
			return count("gerador") >= 1
		end,
	},
	{
		Text = "Os moradores querem comércio: construa uma <b>Padaria</b> perto das casas. Ela dá empregos e renda.",
		Done = function()
			return count("padaria") >= 1
		end,
	},
	{
		Text = "A renda cai no <b>Cofre da Prefeitura</b> (na frente do seu terreno). Vá até ele e aperte <b>Coletar</b>.",
		Done = function()
			return collected or (State.Stats ~= nil and State.Stats.AutoCollect == true)
		end,
	},
}

function Tutorial.Init()
	local gui = HUD.Gui()
	local card = UI.Panel(gui, {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.fromOffset(290, 130),
		Visible = false,
	})
	UI.Stroke(card, T.Teal, 1.5, 0)
	UI.Padding(card, 12)
	local title = UI.Label(card, "", 13, { Font = UI.FontBold, TextColor3 = T.Teal })
	local text = UI.Label(card, "", 15, { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 1, -22), TextYAlignment = Enum.TextYAlignment.Top })

	ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Effect").OnClientEvent:Connect(function(kind)
		if kind == "collect" then
			collected = true
		end
	end)

	local step = -1
	task.spawn(function()
		while true do
			local stats = State.Stats
			if stats then
				if step < 0 then
					step = stats.Tutorial or 0
				end
				local current = STEPS[step + 1]
				if not current then
					card.Visible = false
					break
				end
				if current.Done() then
					step += 1
					State.Request("tutorial", { Step = step })
					UI.Sound("Upgrade")
					if not STEPS[step + 1] then
						UI.Toast("Tutorial concluído! Agora cresça até virar Cidade: mais casas, serviços e lazer. Abra o painel Cidade (C) para ver o que falta.", "ok")
					end
				else
					card.Visible = true
					title.Text = ("PRIMEIROS PASSOS  %d/%d"):format(step + 1, #STEPS)
					text.Text = current.Text
				end
			end
			task.wait(0.5)
		end
	end)
end

return Tutorial
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="123">
        <Properties>
          <string name="Name">UI</string>
          <string name="Source"><![CDATA[--[[
	UI (ModuleScript em StarterPlayerScripts)          Prefeito Tycoon
	Kit da interface: cores, botões, painéis, janelas, barras, avisos e sons.
	Visual escuro e sóbrio (público mais velho): fundo grafite, destaque âmbar e verde-água.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)

local player = Players.LocalPlayer

local UI = {}

UI.Theme = {
	Bg = Color3.fromRGB(18, 21, 28),
	Panel = Color3.fromRGB(26, 30, 40),
	Card = Color3.fromRGB(36, 41, 54),
	CardHover = Color3.fromRGB(46, 52, 68),
	Line = Color3.fromRGB(70, 78, 98),
	Text = Color3.fromRGB(236, 240, 248),
	Muted = Color3.fromRGB(150, 158, 178),
	Accent = Color3.fromRGB(255, 196, 70), -- âmbar (dinheiro)
	Teal = Color3.fromRGB(70, 214, 190),
	Good = Color3.fromRGB(90, 210, 120),
	Bad = Color3.fromRGB(235, 80, 80),
	Warn = Color3.fromRGB(240, 160, 60),
	Event = Color3.fromRGB(170, 120, 255),
}
UI.Font = Enum.Font.Gotham
UI.FontBold = Enum.Font.GothamBold
UI.FontBlack = Enum.Font.GothamBlack

function UI.IsMobile(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

function UI.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.Corner(target: Instance, radius: number?)
	UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 10), Parent = target })
end

function UI.Stroke(target: Instance, color: Color3?, thickness: number?, transparency: number?)
	UI.new("UIStroke", {
		Color = color or UI.Theme.Line,
		Thickness = thickness or 1,
		Transparency = transparency or 0.3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = target,
	})
end

function UI.Padding(target: Instance, px: number)
	UI.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		Parent = target,
	})
end

function UI.List(target: Instance, direction: Enum.FillDirection?, padding: number?, hAlign: Enum.HorizontalAlignment?): UIListLayout
	return UI.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		Parent = target,
	})
end

local scales: { UIScale } = {}

local function updateScales()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local size = camera.ViewportSize
	local scale = math.clamp(math.min(size.X / 1280, size.Y / 760), 0.62, 1.15)
	for _, uiScale in scales do
		uiScale.Scale = scale
	end
end

function UI.Screen(name: string, order: number?): ScreenGui
	local gui = UI.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = order or 1,
		IgnoreGuiInset = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	table.insert(scales, UI.new("UIScale", { Parent = gui }))
	updateScales()
	return gui
end

task.defer(function()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScales)
	end
	updateScales()
end)

function UI.Panel(parent: Instance, props: { [string]: any }?): Frame
	local frame = UI.new("Frame", {
		BackgroundColor3 = UI.Theme.Panel,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		Parent = parent,
	})
	if props then
		for key, value in props do
			(frame :: any)[key] = value
		end
	end
	UI.Corner(frame, 12)
	UI.Stroke(frame)
	return frame
end

function UI.Label(parent: Instance, text: string, size: number?, props: { [string]: any }?): TextLabel
	local label = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = UI.Theme.Text,
		Font = UI.Font,
		TextSize = size or 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		RichText = true,
		Size = UDim2.new(1, 0, 0, (size or 16) + 6),
		Parent = parent,
	})
	if props then
		for key, value in props do
			(label :: any)[key] = value
		end
	end
	return label
end

-- ===== Sons =====
local soundCache: { [string]: Sound } = {}

function UI.Sound(name: string)
	local info = Config.Sounds[name]
	if not info then
		return
	end
	local sound = soundCache[name]
	if not sound then
		sound = UI.new("Sound", { SoundId = info.Id, Volume = info.Volume, PlaybackSpeed = info.Speed, Parent = SoundService })
		soundCache[name] = sound
	end
	(sound :: Sound):Play()
end

local buttonBase: { [Instance]: Color3 } = setmetatable({}, { __mode = "k" }) :: any

function UI.Button(parent: Instance, text: string, props: { [string]: any }?, onClick: (() -> ())?): TextButton
	local base = (props and props.BackgroundColor3) or UI.Theme.Card
	local button = UI.new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = base,
		BorderSizePixel = 0,
		Text = text,
		TextColor3 = UI.Theme.Text,
		Font = UI.FontBold,
		TextSize = 16,
		Size = UDim2.fromOffset(120, 40),
		Parent = parent,
	})
	if props then
		for key, value in props do
			(button :: any)[key] = value
		end
	end
	UI.Corner(button, 8)
	buttonBase[button] = base
	button.MouseEnter:Connect(function()
		local color = buttonBase[button] or base
		TweenService:Create(button, TweenInfo.new(0.12), { BackgroundColor3 = color:Lerp(Color3.new(1, 1, 1), 0.12) }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.12), { BackgroundColor3 = buttonBase[button] or base }):Play()
	end)
	if onClick then
		button.Activated:Connect(function()
			UI.Sound("Click")
			onClick()
		end)
	end
	return button
end

-- Troca a cor de base de um botão criado por UI.Button (o hover passa a usar a nova)
function UI.SetButtonColor(button: TextButton, color: Color3)
	buttonBase[button] = color
	button.BackgroundColor3 = color
end

-- Barra de progresso: devolve a função set(0..1, cor?)
function UI.Bar(parent: Instance, props: { [string]: any }?): (number, Color3?) -> ()
	local back = UI.new("Frame", {
		BackgroundColor3 = UI.Theme.Bg,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 8),
		Parent = parent,
	})
	if props then
		for key, value in props do
			(back :: any)[key] = value
		end
	end
	UI.Corner(back, 4)
	local fill = UI.new("Frame", { BackgroundColor3 = UI.Theme.Teal, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), Parent = back })
	UI.Corner(fill, 4)
	return function(value: number, color: Color3?)
		fill.Size = UDim2.fromScale(math.clamp(value, 0, 1), 1)
		if color then
			fill.BackgroundColor3 = color
		end
	end
end

-- ===== Janelas (uma aberta por vez) =====
local modalGui: ScreenGui? = nil
local openModal: any = nil

export type Modal = { Frame: Frame, Body: ScrollingFrame, Open: () -> (), Close: () -> (), Toggle: () -> (), IsOpen: () -> boolean, OnOpen: BindableEvent }

function UI.Modal(title: string, width: number, height: number): Modal
	if not modalGui then
		modalGui = UI.Screen("Windows", 5)
	end
	local frame = UI.Panel(modalGui :: any, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		Visible = false,
		BackgroundColor3 = UI.Theme.Bg,
		BackgroundTransparency = 0.04,
	})
	UI.Label(frame, title, 22, {
		Font = UI.FontBlack,
		Position = UDim2.fromOffset(18, 12),
		Size = UDim2.new(1, -80, 0, 30),
	})
	local body = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(14, 52),
		Size = UDim2.new(1, -28, 1, -64),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = UI.Theme.Line,
		Parent = frame,
	})
	local modal: any = { Frame = frame, Body = body, OnOpen = Instance.new("BindableEvent") }
	function modal.IsOpen(): boolean
		return frame.Visible
	end
	function modal.Close()
		frame.Visible = false
		if openModal == modal then
			openModal = nil
		end
	end
	function modal.Open()
		if openModal and openModal ~= modal then
			openModal.Close()
		end
		openModal = modal
		frame.Visible = true
		modal.OnOpen:Fire()
	end
	function modal.Toggle()
		if frame.Visible then
			modal.Close()
		else
			modal.Open()
		end
	end
	UI.Button(frame, "✕", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(34, 34),
		TextSize = 18,
	}, modal.Close)
	return modal
end

function UI.CloseModals()
	if openModal then
		openModal.Close()
	end
end

-- ===== Avisos =====
local toastGui: ScreenGui? = nil
local toastHolder: Frame? = nil
local toasts: { Frame } = {}

function UI.Toast(text: string, kind: string?)
	if not toastGui then
		toastGui = UI.Screen("Toasts", 10)
		toastHolder = UI.new("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 190),
			Size = UDim2.fromOffset(520, 400),
			Parent = toastGui,
		})
		UI.List(toastHolder :: any, nil, 6, Enum.HorizontalAlignment.Center)
	end
	local color = ({
		ok = UI.Theme.Good,
		erro = UI.Theme.Bad,
		evento = UI.Theme.Event,
	})[kind or ""] or UI.Theme.Teal
	local card = UI.new("Frame", {
		BackgroundColor3 = UI.Theme.Panel,
		BackgroundTransparency = 0.05,
		Size = UDim2.fromOffset(500, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = math.floor(os.clock() * 100),
		Parent = toastHolder,
	})
	UI.Corner(card, 10)
	UI.Stroke(card, color, 1.5, 0)
	UI.Padding(card, 10)
	UI.Label(card, text, 16, { AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Center })
	if kind == "erro" then
		UI.Sound("Error")
	elseif kind == "evento" then
		UI.Sound("Alert")
	end
	table.insert(toasts, card)
	while #toasts > 4 do
		table.remove(toasts, 1):Destroy()
	end
	task.delay(if kind == "evento" then 7 else 4, function()
		local index = table.find(toasts, card)
		if index then
			table.remove(toasts, index)
		end
		card:Destroy()
	end)
end

return UI
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="124">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
</roblox>
