        <string name="Contents">[{"source":"SHOP","values":{"de":"SHOP","es":"TIENDA","fr":"BOUTIQUE","pt":"LOJA"}},{"source":"CRITTERS","values":{"de":"TIERCHEN","es":"CRIATURAS","fr":"CRÉATURES","pt":"BICHINHOS"}},{"source":"INDEX","values":{"de":"ALBUM","es":"ÁLBUM","fr":"ALBUM","pt":"ÁLBUM"}},{"source":"STYLE","values":{"de":"STIL","es":"ESTILO","fr":"STYLE","pt":"ESTILO"}},{"source":"REBIRTH","values":{"de":"WIEDERGEBURT","es":"RENACER","fr":"RENAISSANCE","pt":"RENASCER"}},{"source":"WORLDS","values":{"de":"WELTEN","es":"MUNDOS","fr":"MONDES","pt":"MUNDOS"}},{"source":"CODES","values":{"de":"CODES","es":"CÓDIGOS","fr":"CODES","pt":"CÓDIGOS"}},{"source":"INVITE","values":{"de":"EINLADEN","es":"INVITAR","fr":"INVITER","pt":"CONVIDAR"}},{"source":"HOME","values":{"de":"BASIS","es":"BASE","fr":"BASE","pt":"BASE"}},{"source":"PASS","values":{"de":"PASS","es":"PASE","fr":"PASSE","pt":"PASSE"}},{"source":"SETTINGS","values":{"de":"OPTIONEN","es":"AJUSTES","fr":"RÉGLAGES","pt":"AJUSTES"}},{"source":"INSTANT LOCK","values":{"de":"SOFORT-SPERRE","es":"CIERRE RÁPIDO","fr":"VERROU ÉCLAIR","pt":"TRAVA RÁPIDA"}},{"source":"SEASON PASS","values":{"de":"SAISONPASS","es":"PASE DE TEMPORADA","fr":"PASSE DE SAISON","pt":"PASSE DA TEMPORADA"}},{"source":"UPGRADES","values":{"de":"UPGRADES","es":"MEJORAS","fr":"AMÉLIORATIONS","pt":"MELHORIAS"}},{"source":"GAME PASSES (forever)","values":{"de":"GAME PASSES (für immer)","es":"GAME PASSES (para siempre)","fr":"GAME PASSES (pour toujours)","pt":"GAME PASSES (para sempre)"}},{"source":"SPECIAL OFFERS","values":{"de":"SONDERANGEBOTE","es":"OFERTAS ESPECIALES","fr":"OFFRES SPÉCIALES","pt":"OFERTAS ESPECIAIS"}},{"source":"GET A CRITTER (you choose!)","values":{"de":"HOL DIR EIN TIERCHEN (du wählst!)","es":"CONSIGUE UNA CRIATURA (¡tú eliges!)","fr":"OBTIENS UNE CRÉATURE (tu choisis !)","pt":"PEGUE UM BICHINHO (você escolhe!)"}},{"source":"Speed","values":{"de":"Tempo","es":"Velocidad","fr":"Vitesse","pt":"Velocidade"}},{"source":"Base Slots","values":{"de":"Basis-Plätze","es":"Espacios de la Base","fr":"Places de la base","pt":"Vagas da Base"}},{"source":"Treadmill","values":{"de":"Laufband","es":"Cinta de correr","fr":"Tapis de course","pt":"Esteira"}},{"source":"Run on the treadmill in your base: FREE speed!","values":{"de":"Lauf auf dem Laufband deiner Basis: GRATIS Tempo!","es":"Corre en la cinta de tu base: ¡velocidad GRATIS!","fr":"Cours sur le tapis de ta base : vitesse GRATUITE !","pt":"Corra na esteira da sua base: velocidade GRÁTIS!"}},{"source":"HOW?","values":{"de":"WIE?","es":"¿CÓMO?","fr":"COMMENT ?","pt":"COMO?"}},{"source":"BUY","values":{"de":"KAUFEN","es":"COMPRAR","fr":"ACHETER","pt":"COMPRAR"}},{"source":"OWNED","values":{"de":"GEKAUFT","es":"TUYO","fr":"ACQUIS","pt":"JÁ TEM"}},{"source":"MAX","values":{"de":"MAX","es":"MÁX","fr":"MAX","pt":"MÁX"}},{"source":"MAXED","values":{"de":"MAXIMAL","es":"AL MÁXIMO","fr":"AU MAX","pt":"NO MÁXIMO"}},{"source":"GET","values":{"de":"HOLEN","es":"OBTENER","fr":"OBTENIR","pt":"PEGAR"}},{"source":"ACTIVE","values":{"de":"AKTIV","es":"ACTIVO","fr":"ACTIF","pt":"ATIVO"}},{"source":"Roblox Premium","values":{"de":"Roblox Premium","es":"Roblox Premium","fr":"Roblox Premium","pt":"Roblox Premium"}},{"source":"Instant Lock","values":{"de":"Sofort-Sperre","es":"Cierre Rápido","fr":"Verrou Éclair","pt":"Trava Rápida"}},{"source":"Lock your base NOW, even while it recharges!","values":{"de":"Sperr deine Basis JETZT, auch beim Aufladen!","es":"¡Cierra tu base YA, aunque se esté recargando!","fr":"Verrouille ta base MAINTENANT, même en recharge !","pt":"Tranque sua base AGORA, mesmo recarregando!"}},{"source":"+1 pedestal for your base","values":{"de":"+1 Sockel für deine Basis","es":"+1 pedestal para tu base","fr":"+1 socle pour ta base","pt":"+1 pedestal para a sua base"}},{"source":"Go to the back of YOUR base and run on the treadmill!","values":{"de":"Geh nach hinten in DEINE Basis und lauf auf dem Laufband!","es":"¡Ve al fondo de TU base y corre en la cinta!","fr":"Va au fond de TA base et cours sur le tapis !","pt":"Vá até o fundo da SUA base e corra na esteira!"}},{"source":"Rebirth for more slots!","values":{"de":"Wiedergeburt für mehr Plätze!","es":"¡Renace para tener más espacios!","fr":"Renais pour avoir plus de places !","pt":"Renasça para ter mais vagas!"}},{"source":"Your base is FULL size!","values":{"de":"Deine Basis hat MAXIMALE Größe!","es":"¡Tu base tiene el tamaño MÁXIMO!","fr":"Ta base est à sa taille MAX !","pt":"Sua base está no tamanho MÁXIMO!"}},{"source":"SET ID","values":{"de":"ID EINTRAGEN","es":"PONER ID","fr":"METTRE ID","pt":"COLOCAR ID"}},{"source":"EQUIP BEST","values":{"de":"BESTE AUSRÜSTEN","es":"EQUIPAR MEJORES","fr":"ÉQUIPER LES MEILLEURS","pt":"EQUIPAR MELHORES"}},{"source":"EQUIP","values":{"de":"AUSRÜSTEN","es":"EQUIPAR","fr":"ÉQUIPER","pt":"EQUIPAR"}},{"source":"UNEQUIP","values":{"de":"ABLEGEN","es":"QUITAR","fr":"RETIRER","pt":"TIRAR"}},{"source":"PLACE","values":{"de":"PLATZIEREN","es":"COLOCAR","fr":"PLACER","pt":"COLOCAR"}},{"source":"PICK UP","values":{"de":"EINPACKEN","es":"GUARDAR","fr":"RAMASSER","pt":"GUARDAR"}},{"source":"SELL","values":{"de":"VERKAUFEN","es":"VENDER","fr":"VENDRE","pt":"VENDER"}},{"source":"MAX FUSE","values":{"de":"MAX FUSION","es":"FUSIÓN MÁX","fr":"FUSION MAX","pt":"FUSÃO MÁX"}},{"source":"FUSE!","values":{"de":"FUSIONIEREN!","es":"¡FUSIONAR!","fr":"FUSIONNER !","pt":"FUNDIR!"}},{"source":"FUSE?","values":{"de":"FUSIONIEREN?","es":"¿FUSIONAR?","fr":"FUSIONNER ?","pt":"FUNDIR?"}},{"source":"SELL?","values":{"de":"VERKAUFEN?","es":"¿VENDER?","fr":"VENDRE ?","pt":"VENDER?"}},{"source":"BUY?","values":{"de":"KAUFEN?","es":"¿COMPRAR?","fr":"ACHETER ?","pt":"COMPRAR?"}},{"source":"CANCEL","values":{"de":"ABBRECHEN","es":"CANCELAR","fr":"ANNULER","pt":"CANCELAR"}},{"source":"Tap a critter","values":{"de":"Tippe auf ein Tierchen","es":"Toca una criatura","fr":"Touche une créature","pt":"Toque num bichinho"}},{"source":"Tap a critter to see what you can do.","values":{"de":"Tippe auf ein Tierchen, um zu sehen, was du tun kannst.","es":"Toca una criatura para ver qué puedes hacer.","fr":"Touche une créature pour voir ce que tu peux faire.","pt":"Toque num bichinho para ver o que dá para fazer."}},{"source":"Nothing here with these filters.","values":{"de":"Nichts hier mit diesen Filtern.","es":"No hay nada con estos filtros.","fr":"Rien ici avec ces filtres.","pt":"Nada aqui com esses filtros."}},{"source":"No critters yet! Hatch eggs, then press PICK UP (R) on a critter in your base to put it in your backpack.","values":{"de":"Noch keine Tierchen! Brüte Eier aus und drück EINPACKEN (R) bei einem Tierchen in deiner Basis, um es in den Rucksack zu stecken.","es":"¡Aún no tienes criaturas! Eclosiona huevos y pulsa GUARDAR (R) sobre una criatura de tu base para meterla en la mochila.","fr":"Pas encore de créatures ! Fais éclore des œufs puis appuie sur RAMASSER (R) sur une créature de ta base pour la mettre dans ton sac.","pt":"Nenhum bichinho ainda! Choque ovos e aperte GUARDAR (R) num bichinho da sua base para pôr na mochila."}},{"source":"PET","values":{"de":"BEGLEITER","es":"MASCOTA","fr":"COMPAGNON","pt":"PET"}},{"source":"BASE","values":{"de":"BASIS","es":"BASE","fr":"BASE","pt":"BASE"}},{"source":"Show: All","values":{"de":"Zeigen: Alle","es":"Mostrar: Todo","fr":"Afficher : Tout","pt":"Mostrar: Tudo"}},{"source":"Show: Backpack","values":{"de":"Zeigen: Rucksack","es":"Mostrar: Mochila","fr":"Afficher : Sac","pt":"Mostrar: Mochila"}},{"source":"Show: Base","values":{"de":"Zeigen: Basis","es":"Mostrar: Base","fr":"Afficher : Base","pt":"Mostrar: Base"}},{"source":"Show: Pets","values":{"de":"Zeigen: Begleiter","es":"Mostrar: Mascotas","fr":"Afficher : Compagnons","pt":"Mostrar: Pets"}},{"source":"Rarity: All","values":{"de":"Seltenheit: Alle","es":"Rareza: Todas","fr":"Rareté : Toutes","pt":"Raridade: Todas"}},{"source":"World: All","values":{"de":"Welt: Alle","es":"Mundo: Todos","fr":"Monde : Tous","pt":"Mundo: Todos"}},{"source":"Sort: Best","values":{"de":"Sortieren: Beste","es":"Orden: Mejores","fr":"Tri : Meilleurs","pt":"Ordem: Melhores"}},{"source":"Sort: Rarity","values":{"de":"Sortieren: Seltenheit","es":"Orden: Rareza","fr":"Tri : Rareté","pt":"Ordem: Raridade"}},{"source":"Sort: Name","values":{"de":"Sortieren: Name","es":"Orden: Nombre","fr":"Tri : Nom","pt":"Ordem: Nome"}},{"source":"THEMES","values":{"de":"THEMEN","es":"TEMAS","fr":"THÈMES","pt":"TEMAS"}},{"source":"DECOR","values":{"de":"DEKO","es":"DECORACIÓN","fr":"DÉCO","pt":"ENFEITES"}},{"source":"TRAILS","values":{"de":"SPUREN","es":"ESTELAS","fr":"TRAÎNÉES","pt":"RASTROS"}},{"source":"TITLES","values":{"de":"TITEL","es":"TÍTULOS","fr":"TITRES","pt":"TÍTULOS"}},{"source":"USE","values":{"de":"BENUTZEN","es":"USAR","fr":"UTILISER","pt":"USAR"}},{"source":"IN USE","values":{"de":"AKTIV","es":"EN USO","fr":"UTILISÉ","pt":"EM USO"}},{"source":"REMOVE","values":{"de":"ENTFERNEN","es":"QUITAR","fr":"RETIRER","pt":"TIRAR"}},{"source":"CLEAR","values":{"de":"LEEREN","es":"VACIAR","fr":"VIDER","pt":"LIMPAR"}},{"source":"ON (tap: off)","values":{"de":"AN (tippen: aus)","es":"ACTIVO (toca: quitar)","fr":"ACTIF (touche : off)","pt":"LIGADO (toque: desliga)"}},{"source":"WEAR","values":{"de":"TRAGEN","es":"USAR","fr":"PORTER","pt":"USAR"}},{"source":"WEARING (off)","values":{"de":"GETRAGEN (aus)","es":"USANDO (quitar)","fr":"PORTÉ (retirer)","pt":"USANDO (tirar)"}},{"source":"Unlocked!","values":{"de":"Freigeschaltet!","es":"¡Desbloqueado!","fr":"Débloqué !","pt":"Liberado!"}},{"source":"Reward","values":{"de":"Belohnung","es":"Premio","fr":"Récompense","pt":"Prêmio"}},{"source":"Free","values":{"de":"Gratis","es":"Gratis","fr":"Gratuit","pt":"Grátis"}},{"source":"Free reward","values":{"de":"Gratis-Belohnung","es":"Premio gratis","fr":"Récompense gratuite","pt":"Prêmio grátis"}},{"source":"Loading...","values":{"de":"Lädt...","es":"Cargando...","fr":"Chargement...","pt":"Carregando..."}},{"source":"Season Pass reward","values":{"de":"Saisonpass-Belohnung","es":"Premio del Pase de Temporada","fr":"Récompense du passe de saison","pt":"Prêmio do Passe da Temporada"}},{"source":"Change the look of your whole base. Every world you unlock gives a new theme!","values":{"de":"Ändere das Aussehen deiner ganzen Basis. Jede freigeschaltete Welt gibt ein neues Thema!","es":"Cambia el aspecto de toda tu base. ¡Cada mundo que desbloqueas da un tema nuevo!","fr":"Change le look de toute ta base. Chaque monde débloqué donne un nouveau thème !","pt":"Mude o visual da sua base inteira. Cada mundo que você destrava dá um tema novo!"}},{"source":"Pick a spot (1-2 front, 3-6 sides, 7-8 back), then place a decoration you own.","values":{"de":"Wähle einen Platz (1-2 vorne, 3-6 Seiten, 7-8 hinten) und stell eine Deko auf, die du hast.","es":"Elige un lugar (1-2 frente, 3-6 lados, 7-8 fondo) y coloca una decoración que tengas.","fr":"Choisis une place (1-2 devant, 3-6 côtés, 7-8 fond) puis pose une déco que tu as.","pt":"Escolha uma vaga (1-2 frente, 3-6 lados, 7-8 fundo) e coloque um enfeite que você tem."}},{"source":"A colorful trail behind you. Some are bought, some are earned.","values":{"de":"Eine bunte Spur hinter dir. Manche kauft man, manche verdient man.","es":"Una estela de colores detrás de ti. Algunas se compran y otras se ganan.","fr":"Une traînée colorée derrière toi. Certaines s'achètent, d'autres se gagnent.","pt":"Um rastro colorido atrás de você. Uns são comprados, outros são conquistados."}},{"source":"A title above your head. Earn them by playing!","values":{"de":"Ein Titel über deinem Kopf. Verdien sie beim Spielen!","es":"Un título sobre tu cabeza. ¡Gánalos jugando!","fr":"Un titre au-dessus de ta tête. Gagne-les en jouant !","pt":"Um título em cima da sua cabeça. Ganhe jogando!"}},{"source":"Classic","values":{"de":"Klassisch","es":"Clásico","fr":"Classique","pt":"Clássico"}},{"source":"Garden","values":{"de":"Garten","es":"Jardín","fr":"Jardin","pt":"Jardim"}},{"source":"Candy","values":{"de":"Süßigkeiten","es":"Dulces","fr":"Bonbons","pt":"Doces"}},{"source":"Frost","values":{"de":"Frost","es":"Hielo","fr":"Givre","pt":"Gelo"}},{"source":"Lava","values":{"de":"Lava","es":"Lava","fr":"Lave","pt":"Lava"}},{"source":"Reef","values":{"de":"Riff","es":"Arrecife","fr":"Récif","pt":"Recife"}},{"source":"Galaxy","values":{"de":"Galaxie","es":"Galaxia","fr":"Galaxie","pt":"Galáxia"}},{"source":"Your base's own color.","values":{"de":"Die eigene Farbe deiner Basis.","es":"El color original de tu base.","fr":"La couleur d'origine de ta base.","pt":"A cor original da sua base."}},{"source":"Grass, wood and flowers.","values":{"de":"Gras, Holz und Blumen.","es":"Pasto, madera y flores.","fr":"Herbe, bois et fleurs.","pt":"Grama, madeira e flores."}},{"source":"Pink walls and giant lollipops.","values":{"de":"Rosa Wände und Riesenlutscher.","es":"Paredes rosas y piruletas gigantes.","fr":"Murs roses et sucettes géantes.","pt":"Paredes rosa e pirulitos gigantes."}},{"source":"Ice floor and snowy towers.","values":{"de":"Eisboden und verschneite Türme.","es":"Suelo de hielo y torres nevadas.","fr":"Sol de glace et tours enneigées.","pt":"Chão de gelo e torres com neve."}},{"source":"Dark stone and glowing lava.","values":{"de":"Dunkler Stein und glühende Lava.","es":"Piedra oscura y lava brillante.","fr":"Pierre sombre et lave brillante.","pt":"Pedra escura e lava brilhante."}},{"source":"Sand floor and coral walls.","values":{"de":"Sandboden und Korallenwände.","es":"Suelo de arena y paredes de coral.","fr":"Sol de sable et murs de corail.","pt":"Chão de areia e paredes de coral."}},{"source":"Space floor and floating planets.","values":{"de":"Weltraumboden und schwebende Planeten.","es":"Suelo espacial y planetas flotantes.","fr":"Sol spatial et planètes flottantes.","pt":"Chão espacial e planetas flutuando."}},{"source":"Flower Pot","values":{"de":"Blumentopf","es":"Maceta de Flores","fr":"Pot de fleurs","pt":"Vaso de Flores"}},{"source":"Lamp Post",