	---------------------------------------------------------------------
	-- v21: card pequeno no canto de baixo, à direita (em cima do botão de pular do celular), nada no meio
	local popup = create("Frame", {
		Name = "PopupCard",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -150),
		Size = UDim2.fromOffset(340, 190),
		BackgroundColor3 = PANEL,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	}, { corner(16), border(GOLD, 3) })
	autoScale(popup)
	local popupTitle = label({ Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 8), Text = "", TextColor3 = GOLD, ZIndex = 11, Parent = popup })
	local popupBody = label({
		Size = UDim2.new(1, -24, 1, -104),
		Position = UDim2.fromOffset(12, 46),
		Text = "",
		TextWrapped = true,
		ZIndex = 11,
		StrokeThickness = 1.5,
		Parent = popup,
	})
	local popupQueue = {}
	local function showNextPopup()
		if popup.Visible or #popupQueue == 0 then
			return
		end
		local item = table.remove(popupQueue, 1)
		popupTitle.Text = item[1]
		popupBody.Text = item[2]
		popup.Visible = true
		UI.popIn(popup)
		play("Rare")
	end
	button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.fromOffset(150, 44),
		BackgroundColor3 = GREEN,
		ZIndex = 12,
		Parent = popup,
	}, "OK!", function()
		popup.Visible = false
		play("Click")
		task.delay(0.2, showNextPopup)
	end)

	PopupEvent.OnClientEvent:Connect(function(title, body)
		table.insert(popupQueue, { tostring(title), tostring(body) })
		showNextPopup()
	end)
	showFact = function(title: string, body: string)
		table.insert(popupQueue, { title, body })
		showNextPopup()
	end

	NotifyEvent.OnClientEvent:Connect(function(text, kind)
		toast(tostring(text), kind)
		if kind == "error" then
			play("Error")
			if string.find(string.lower(tostring(text)), "cash", 1, true) then
				UI.shake(cashPanel)
			end
		end
	end)
end

---------------------------------------------------------------------
-- Dinheiro na tela
---------------------------------------------------------------------
local shownCash = 0
local function refreshCash()
	local cash = player:GetAttribute("Cash") or 0
	cashLabel.Text = Format.Money(cash)
	if cash > shownCash then
		UI.pulse(cashLabel, 0.1)
	end
	shownCash = cash
	if panels.Shop.Visible then
		refreshShop()
	end
	if panels.Worlds.Visible then
		refreshWorlds()
	end
	if panels.Rebirth.Visible then
		refreshRebirth()
	end
end

local function refreshIncome()
	local income = player:GetAttribute("Income") or 0
	local multiplier = player:GetAttribute("Multiplier") or 1
	local multiplierText = string.gsub(string.format("%.2f", multiplier), "%.?0+$", "")
	incomeLabel.Text = ("+%s/s   (x%s)"):format(Format.Money(income), multiplierText)
end

player:GetAttributeChangedSignal("Cash"):Connect(refreshCash)
player:GetAttributeChangedSignal("Income"):Connect(refreshIncome)
player:GetAttributeChangedSignal("Multiplier"):Connect(function()
	refreshIncome()
	if panels.Shop.Visible then
		refreshShop()
	end
end)
for _, attribute in { "SpeedLevel", "Rebirths", "IndexCount", "FriendBonus", "GroupBonus", "Slots", "SlotUpgrades", "TrainedSpeed", "TrainCap" } do
	player:GetAttributeChangedSignal(attribute):Connect(function()
		if panels.Shop.Visible then
			refreshShop()
		end
		if panels.Rebirth.Visible then
			refreshRebirth()
		end
	end)
end
player.AttributeChanged:Connect(function(attribute)
	if string.sub(attribute, 1, 5) == "Pass_" and panels.Shop.Visible then
		refreshShop()
	end
end)

local function refreshAdmin()
	adminButton.Visible = player:GetAttribute("IsAdmin") == true
end
player:GetAttributeChangedSignal("IsAdmin"):Connect(refreshAdmin)

local function refreshCarry()
	local carrying = player:GetAttribute("Carrying")
	if carrying then
		carryText.Text = "Carrying " .. tostring(carrying) .. "! RUN to YOUR BASE!"
		carryBanner.Visible = true
	else
		carryBanner.Visible = false
	end
end
player:GetAttributeChangedSignal("Carrying"):Connect(refreshCarry)

-- Tag [VIP] no chat
TextChatService.OnIncomingMessage = function(message: TextChatMessage)
	local properties = Instance.new("TextChatMessageProperties")
	local source = message.TextSource
	if source then
		local sender = Players:GetPlayerByUserId(source.UserId)
		if sender and sender:GetAttribute("Pass_VIP") then
			properties.PrefixText = "<font color='#FFD23C'>[VIP]</font> " .. message.PrefixText
		end
	end
	return properties
end

---------------------------------------------------------------------
-- Esconde "Steal" nos seus bichinhos e "Sell" nos dos outros
---------------------------------------------------------------------
-- Escudo de novato e "sem covardia" (o servidor confere de novo; aqui só esconde o botão)
local function canStealFrom(ownerUserId: any): boolean
	if typeof(ownerUserId) ~= "number" then
		return true
	end
	local map = workspace:FindFirstChild("Map")
	local plots = map and map:FindFirstChild("Plots")
	if plots then
		for _, plot in plots:GetChildren() do
			if plot:GetAttribute("OwnerUserId") == ownerUserId then
				local shield = plot:GetAttribute("ShieldUntil")
				if typeof(shield) == "number" and shield > workspace:GetServerTimeNow() then
					return false
				end
			end
		end
	end
	local owner = Players:GetPlayerByUserId(ownerUserId)
	local mine = tonumber(player:GetAttribute("Power")) or 0
	local theirs = owner and tonumber(owner:GetAttribute("Power")) or 0
	return not (mine > 0 and theirs * Config.BullyIncomeRatio < mine)
end

local function evaluatePrompt(prompt: Instance)
	if not prompt:IsA("ProximityPrompt") then
		return
	end
	local model = prompt:FindFirstAncestorOfClass("Model")
	if not model then
		return
	end
	local owner = model:GetAttribute("OwnerUserId")
	if prompt.Name == "StealPrompt" then
		prompt.Enabled = owner ~= player.UserId and canStealFrom(owner)
	elseif prompt.Name == "SellPrompt" or prompt.Name == "PickUpPrompt" or prompt.Name == "PetPrompt" then
		prompt.Enabled = owner == player.UserId
	end
end

local activeCritters = workspace:WaitForChild("ActiveCritters")
activeCritters.DescendantAdded:Connect(evaluatePrompt)
for _, descendant in activeCritters:GetDescendants() do
	evaluatePrompt(descendant)
end
activeCritters.ChildAdded:Connect(function(model)
	model:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
		for _, descendant in model:GetDescendants() do
			evaluatePrompt(descendant)
		end
	end)
end)

---------------------------------------------------------------------
-- Bichinhos "respirando" no pedestal + mutação Rainbow mudando de cor
---------------------------------------------------------------------
local IDLE_STYLE = { -- { altura do pulinho, velocidade, balanço em graus }
	Common = { 0.12, 2.2, 5 },
	Uncommon = { 0.15, 2.2, 6 },
	Rare = { 0.2, 2, 7 },
	Epic = { 0.25, 1.8, 8 },
	Legendary = { 0.4, 1.5, 10 },
	Mythic = { 0.6, 1.2, 12 },
	Secret = { 0.7, 1.1, 14 },
}
local animated: { [Instance]: { Phase: number, Skin: { BasePart }?, SkinCheck: number } } = {}

local function trackCritter(model: Instance)
	if model:IsA("Model") then
		animated[model] = { Phase = math.random() * 10, Skin = nil, SkinCheck = 0 }
	end
end
activeCritters.ChildAdded:Connect(trackCritter)
activeCritters.ChildRemoved:Connect(function(model)
	animated[model] = nil
end)
for _, model in activeCritters:GetChildren() do
	trackCritter(model)
end

RunService.RenderStepped:Connect(function()
	local now = os.clock()
	local camera = workspace.CurrentCamera
	local cameraPosition = if camera then camera.CFrame.Position else Vector3.zero
	for model, info in animated do
		local root = model:FindFirstChild("Root") :: BasePart?
		if root and (root.Position - cameraPosition).Magnitude < 80 then
			local state = model:GetAttribute("State")
			if (state == "Incubating" or state == "Hatching") and root.Anchored then
				-- ovo chocando: balança cada vez mais perto de chocar
				local home = model:GetAttribute("Home")
				local hatchAt = model:GetAttribute("HatchAt")
				if typeof(home) == "CFrame" then
					local left = if typeof(hatchAt) == "number" then hatchAt - workspace:GetServerTimeNow() else 10
					local power = if state == "Hatching" then 1 else math.clamp(1 - left / 12, 0.12, 0.8)
					local speed = 6 + power * 22
					local tilt = math.sin(now * speed + info.Phase) * power * 0.28
					root.CFrame = home * CFrame.new(0, math.abs(tilt) * 0.6, 0) * CFrame.Angles(tilt * 0.4, 0, tilt)
				end
			elseif state == "Placed" then
				local home = model:GetAttribute("Home")
				if root.Anchored and typeof(home) == "CFrame" then
					local style = IDLE_STYLE[model:GetAttribute("Rarity") or "Common"] or IDLE_STYLE.Common
					local t = now * style[2] + info.Phase
					local lift = (math.sin(t) + 1) * 0.5 * style[1]
					root.CFrame = home * CFrame.new(0, lift, 0) * CFrame.Angles(0, math.rad(math.sin(t * 0.5) * style[3]), 0)
				end
			end
			if model:GetAttribute("Mutation") == "Rainbow" then
				if not info.Skin or (#info.Skin == 0 and now - info.SkinCheck > 2) then
					info.SkinCheck = now
					local list = {}
					for _, part in model:GetDescendants() do
						-- modelo 3D (MeshPart) mantém a textura no Rainbow: pintar a cor dele não aparece
						if part:IsA("BasePart") and part:GetAttribute("Skin") and not part:IsA("MeshPart") then
							table.insert(list, part)
						end
					end
					info.Skin = list
				end
				for i, part in info.Skin :: { BasePart } do
					part.Color = Color3.fromHSV((now * 0.25 + i * 0.07) % 1, 0.75, 1)
				end
			end
		end
	end
end)

---------------------------------------------------------------------
-- Levou um BONK
---------------------------------------------------------------------
KnockbackEvent.OnClientEvent:Connect(function(velocity)
	if typeof(velocity) ~= "Vector3" then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return
	end
	play("Bonk")
	humanoid.PlatformStand = true
	root.AssemblyLinearVelocity = velocity
	root.AssemblyAngularVelocity = Vector3.new(math.random(-6, 6), math.random(-6, 6), math.random(-6, 6))
	task.delay(0.8, function()
		if humanoid.Parent then
			humanoid.PlatformStand = false
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end)

---------------------------------------------------------------------
-- Efeitos
---------------------------------------------------------------------
local function floatingText(position: Vector3, text: string, color: Color3)
	local anchor = create("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.new(0.2, 0.2, 0.2),
		CFrame = CFrame.new(position),
		Parent = workspace,
	})
	local billboard = create("BillboardGui", {
		Size = UDim2.fromOffset(200, 60),
		AlwaysOnTop = true,
		LightInfluence = 0,
		Adornee = anchor,
		Parent = anchor,
	})
	local textLabel = label({ Size = UDim2.fromScale(1, 1), Text = text, TextColor3 = color, StrokeThickness = 3, Parent = billboard })
	TweenService:Create(anchor, TweenInfo.new(0.9), { CFrame = CFrame.new(position + Vector3.new(0, 4, 0)) }):Play()
	TweenService:Create(textLabel, TweenInfo.new(0.9), { TextTransparency = 1 }):Play()
	task.delay(1, function()
		anchor:Destroy()
	end)
end

local function flash(color: Color3, strength: number?)
	local frame = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = 1 - (strength or 0.6),
		ZIndex = 40,
		Parent = gui,
	})
	TweenService:Create(frame, TweenInfo.new(0.8), { BackgroundTransparency = 1 }):Play()
	task.delay(0.85, function()
		frame:Destroy()
	end)
end

-- v21: o aviso grande ("MONSTER INVASION!", "LEVEL 5!") não cobre mais o meio da tela:
-- vira um card colorido no topo da coluna da esquerda, que pula ao aparecer e some sozinho
local shoutCard: Frame? = nil
local function bigText(text: string, color: Color3)
	if shoutCard then
		shoutCard:Destroy()
		shoutCard = nil
	end
	local frame = create("Frame", {
		Name = "Shout",
		LayoutOrder = 0,
		Size = UDim2.fromOffset(STACK_W, 42),
		BackgroundColor3 = DARK,
		BackgroundTransparency = 0.15,
		ZIndex = 32,
		Parent = leftStack,
	}, { corner(12), border(color, 3) })
	shoutCard = frame
	local textLabel = label({
		Size = UDim2.new(1, -14, 1, -8),
		Position = UDim2.fromOffset(7, 4),
		Text = text,
		TextColor3 = color,
		StrokeThickness = 3,
		ZIndex = 33,
		Parent = frame,
	})
	UI.popIn(frame)
	task.delay(2.2, function()
		if frame.Parent then
			local info = TweenInfo.new(0.4)
			TweenService:Create(frame, info, { BackgroundTransparency = 1 }):Play()
			TweenService:Create(textLabel, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			local stroke = frame:FindFirstChildOfClass("UIStroke")
			if stroke then
				TweenService:Create(stroke, info, { Transparency = 1 }):Play()
			end
			task.wait(0.45)
			frame:Destroy()
		end
		if shoutCard == frame then
			shoutCard = nil
		end
	end)
end

do
	---------------------------------------------------------------------
	-- OVO CHOCANDO: tela de suspense -> revela o bichinho
	---------------------------------------------------------------------
	local hatchScreen = create("TextButton", {
		Name = "HatchScreen",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(10, 10, 25),
		BackgroundTransparency = 0.35,
		Text = "",
		AutoButtonColor = false,
		Visible = false,
		ZIndex = 30,
		Parent = gui,
	})
	local hatchHolder = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.48),
		Size = UDim2.fromOffset(420, 470),
		BackgroundTransparency = 1,
		ZIndex = 30,
		Parent = hatchScreen,
	})
	autoScale(hatchHolder)
	-- v22: raios de sol girando atrás do ovo (na cor do ovo; na cor da raridade ao revelar)
	local hatchRays = create("Frame", {
		Name = "Rays",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(210, 170),
		Size = UDim2.fromOffset(560, 560),
		BackgroundTransparency = 1,
		ZIndex = 30,
		Parent = hatchHolder,
	})
	local rayFrames = {}
	for i = 1, 12 do
		local ray = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(if i % 2 == 0 then 30 else 18, 280),
			Rotation = i * 30,
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			ZIndex = 30,
			Parent = hatchRays,
		}, {
			create("UIGradient", {
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.35, 0.3), NumberSequenceKeypoint.new(1, 0) }),
				Rotation = 90,
			}),
		})
		rayFrames[i] = ray
	end
	local function setRays(color: Color3, transparency: number)
		for _, ray in rayFrames do
			ray.BackgroundColor3 = color
			ray.BackgroundTransparency = transparency
		end
	end
	-- v22: cascas do ovo voando na tela (pedacinhos nas cores do ovo)
	local function burstShells2D(colors: { Color3 }, count: number)
		local pieces = {}
		for i = 1, count do
			local angle = math.random() * math.pi * 2
			local speed = 260 + math.random() * 320
			local piece = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(210, 170),
				Size = UDim2.fromOffset(10 + math.random(0, 14), 8 + math.random(0, 10)),
				Rotation = math.random(0, 360),
				BackgroundColor3 = colors[1 + (i % #colors)],
				BorderSizePixel = 0,
				ZIndex = 34,
				Parent = hatchHolder,
			}, { corner(3) })
			pieces[i] = { Frame = piece, X = 210, Y = 170, VX = math.cos(angle) * speed, VY = math.sin(angle) * speed - 220, Spin = (math.random() - 0.5) * 900 }
		end
		local started = os.clock()
		local connection
		connection = RunService.RenderStepped:Connect(function(dt)
			dt = math.min(dt, 0.05)
			local age = os.clock() - started
			for _, p in pieces do
				p.VY += 900 * dt
				p.X += p.VX * dt
				p.Y += p.VY * dt
				p.Frame.Position = UDim2.fromOffset(p.X, p.Y)
				p.Frame.Rotation += p.Spin * dt
				if age > 0.5 then
					p.Frame.BackgroundTransparency = math.clamp((age - 0.5) / 0.4, 0, 1)
				end
			end
			if age > 0.95 then
				connection:Disconnect()
				for _, p in pieces do
					p.Frame:Destroy()
				end
			end
		end)
	end
	local hatchGlow = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(210, 170),
		Size = UDim2.fromOffset(330, 330),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.6,
		ZIndex = 30,
		Parent = hatchHolder,
	}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	create("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.6), NumberSequenceKeypoint.new(1, 0) }),
		Parent = hatchGlow,
	})
	local hatchViewport = create("ViewportFrame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(210, 170),
		Size = UDim2.fromOffset(320, 320),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(180, 180, 180),
		LightColor = WHITE,
		LightDirection = Vector3.new(-0.4, -1, 0.6),
		ZIndex = 31,
		Parent = hatchHolder,
	})
	local hatchCamera = create("Camera", { FieldOfView = 40, Parent = hatchViewport })
	local hatchCracks = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(210, 170),
		Size = UDim2.fromOffset(200, 220),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 32,
		Parent = hatchHolder,
	})
	hatchViewport.CurrentCamera = hatchCamera
	local hatchNew = label({ Position = UDim2.fromOffset(250, 10), Size = UDim2.fromOffset(150, 50), Text = "NEW!", TextColor3 = Color3.fromRGB(255, 240, 90), StrokeThickness = 3, Rotation = 12, ZIndex = 33, Visible = false, Parent = hatchHolder })
	local hatchMutation = label({ Position = UDim2.fromOffset(10, 320), Size = UDim2.new(1, -20, 0, 34), Text = "", ZIndex = 32, Visible = false, Parent = hatchHolder })
	local hatchName = label({ Position = UDim2.fromOffset(10, 352), Size = UDim2.new(1, -20, 0, 56), Text = "", StrokeThickness = 3, ZIndex = 32, Parent = hatchHolder })
	local hatchRarity = label({ Position = UDim2.fromOffset(10, 406), Size = UDim2.new(1, -20, 0, 36), Text = "", ZIndex = 32, Parent = hatchHolder })
	local hatchTap = label({ Position = UDim2.fromOffset(10, 444), Size = UDim2.new(1, -20, 0, 24), Text = "", TextColor3 = Color3.fromRGB(200, 200, 220), StrokeThickness = 1, ZIndex = 32, Parent = hatchHolder })
	local rainbowKeys = {}
	for i, color in Builder.RainbowColors do
		table.insert(rainbowKeys, ColorSequenceKeypoint.new((i - 1) / (#Builder.RainbowColors - 1), color))
	end
	local hatchRainbow = create("UIGradient", { Color = ColorSequence.new(rainbowKeys), Enabled = false, Parent = hatchRarity })

	local hatchQueue = {}
	local hatchBusy = false
	local hatchClosable = false
	local hatchModel: Model? = nil

	local frameRadius: number? = nil -- v22: raio fixo (o pulo de escala do bichinho aparece de verdade)
	local function frameModel(model: Model, spin: number)
		local boxCFrame, boxSize = model:GetBoundingBox()
		local radius = frameRadius or boxSize.Magnitude / 2
		local center = boxCFrame.Position
		local offset = CFrame.Angles(0, spin, 0) * Vector3.new(0, radius * 0.45, -radius * 2.35)
		hatchCamera.CFrame = CFrame.lookAt(center + offset, center)
	end

	local function setHatchModel(model: Model?)
		if hatchModel then
			hatchModel:Destroy()
		end
		hatchModel = model
		if model then
			local aura = model:FindFirstChild("Aura")
			if aura then
				aura:Destroy()
			end
			model:PivotTo(CFrame.identity)
			model.Parent = hatchViewport
			frameRadius = nil
			local _, boxSize = model:GetBoundingBox()
			frameRadius = boxSize.Magnitude / 2
			frameModel(model, 0)
		else
			frameRadius = nil
		end
	end

	local function closeHatch()
		hatchScreen.Visible = false
		setHatchModel(nil)
		hatchBusy = false
		hatchClosable = false
	end

	local function runHatch(info)
		hatchBusy = true
		hatchClosable = false
		local egg = Config.EggById[info.Egg]
		local def = Critters.ById[info.Critter]
		if not egg or not def then
			hatchBusy = false
			return
		end
		local rarity = Config.RarityByName[def.Rarity]
		local fast = #hatchQueue > 0 -- vários ovos ao mesmo tempo: mostra mais rápido

		-- 1) Suspense: o ovo treme cada vez mais
		hatchScreen.Visible = true
		hatchNew.Visible = false
		hatchMutation.Visible = false
		hatchRainbow.Enabled = false
		hatchGlow.BackgroundColor3 = egg.Accent
		setRays(egg.Accent, 0.6)
		hatchRays.Size = UDim2.fromOffset(560, 560)
		hatchName.Text = egg.Name
		hatchName.TextColor3 = egg.Color
		hatchRarity.Text = "..."
		hatchRarity.TextColor3 = WHITE
		hatchTap.Text = ""
		local eggModel = Builder.BuildEgg(egg)
		setHatchModel(eggModel)
		local suspense = if fast then 0.9 else math.max(0.8, Config.HatchRevealTime - 0.4)
		-- câmera aproxima devagar (zoom) enquanto o ovo treme
		hatchCamera.FieldOfView = 40
		TweenService:Create(hatchCamera, TweenInfo.new(suspense, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { FieldOfView = 24 }):Play()
		-- rachaduras aparecendo no ovo
		for _, crack in hatchCracks:GetChildren() do
			crack:Destroy()
		end
		for i = 1, 4 do
			task.delay(suspense * (0.25 + i * 0.16), function()
				if hatchModel ~= eggModel then
					return
				end
				local line = create("Frame", {
					AnchorPoint = Vector2.new(0.5, 0),
					Position = UDim2.new(0.5, math.random(-40, 40), 0.5, math.random(-60, 10)),
					Size = UDim2.fromOffset(5, 0),
					Rotation = math.random(-70, 70),
					BackgroundColor3 = WHITE,
					BorderSizePixel = 0,
					ZIndex = 32,
					Parent = hatchCracks,
				}, { create("UIStroke", { Color = DARK, Thickness = 1.5 }) })
				TweenService:Create(line, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(5, math.random(40, 80)) }):Play()
				play("Click")
			end)
		end
		local started = os.clock()
		local nextTick = 0
		while os.clock() - started < suspense do
			local t = (os.clock() - started) / suspense
			if hatchModel == eggModel then
				local shake = math.sin(os.clock() * (18 + t * 30)) * (0.08 + t * 0.35)
				eggModel:PivotTo(CFrame.Angles(0, 0, shake) * CFrame.new(0, math.abs(shake) * 0.4, 0))
			end
			if os.clock() - started >= nextTick then
				nextTick += 0.45 - t * 0.3
				local sound = sounds.Hatch
				if sound then
					sound.PlaybackSpeed = 1.2 + t * 1.3
					SoundService:PlayLocalSound(sound)
				end
			end
			hatchGlow.Rotation += 2 + t * 8
			hatchRays.Rotation += 0.4 + t * 1.6 -- os raios giram cada vez mais rápido
			RunService.RenderStepped:Wait()
		end

		-- 2) Revela!
		if sounds.Hatch then
			sounds.Hatch.PlaybackSpeed = Config.Sounds.Hatch.Speed
		end
		for _, crack in hatchCracks:GetChildren() do
			crack:Destroy()
		end
		flash(rarity.Color, 0.9) -- flash na cor da raridade
		play("Rare")
		-- v22: cascas voando nas cores do ovo, raios na cor da raridade (pulso) e o bichinho pula para fora
		burstShells2D({ egg.Color, egg.Accent, WHITE }, 18)
		setRays(rarity.Color, 0.35)
		hatchRays.Size = UDim2.fromOffset(420, 420)
		TweenService:Create(hatchRays, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(640, 640) }):Play()
		TweenService:Create(hatchCamera, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { FieldOfView = 40 }):Play()
		local critterModel = Builder.Build(def)
		if info.Mutation then
			Builder.ApplyMutation(critterModel, info.Mutation)
		end
		setHatchModel(critterModel)
		task.spawn(function()
			-- pulo de escala: 0.25 → 1.15 → 1 (só na tela; o modelo de verdade fica na base)
			local started = os.clock()
			while hatchModel == critterModel and os.clock() - started < 0.55 do
				local t = (os.clock() - started) / 0.55
				local f = if t < 0.5 then 0.25 + (t / 0.5) * 0.9 elseif t < 0.8 then 1.15 - ((t - 0.5) / 0.3) * 0.2 else 0.95 + ((t - 0.8) / 0.2) * 0.05
				pcall(function()
					critterModel:ScaleTo(f)
				end)
				RunService.RenderStepped:Wait()
			end
			if hatchModel == critterModel then
				pcall(function()
					critterModel:ScaleTo(1)
				end)
			end
		end)
		hatchGlow.BackgroundColor3 = if info.Mutation and Config.MutationByName[info.Mutation] then Config.MutationByName[info.Mutation].Color else rarity.Color
		hatchName.Text = def.Name
		hatchName.TextColor3 = WHITE
		local fullIncome = def.Income * Config.IncomeMultiplier(info.Mutation) * (if info.Shiny then Config.ShinyIncome else 1)
		hatchRarity.Text = string.upper(def.Rarity) .. "  -  " .. Format.Money(fullIncome) .. "/s grown"
		hatchRarity.TextColor3 = rarity.Color
		hatchRainbow.Enabled = Config.RarityIndex[def.Rarity] >= 6
		if info.Mutation then
			local mutation = Config.MutationByName[info.Mutation]
			hatchMutation.Text = string.upper(info.Mutation) .. " x" .. (if mutation then mutation.Income else 1)
			hatchMutation.TextColor3 = if mutation then mutation.Color else WHITE
			hatchMutation.Visible = true
		end
		if info.Shiny then
			-- SHINY (1 em 1000): texto dourado, som especial e confete
			hatchMutation.Text = "SHINY! x" .. Config.ShinyIncome .. (if info.Mutation then "  +  " .. hatchMutation.Text else "")
			hatchMutation.TextColor3 = GOLD
			hatchMutation.Visible = true
			play("Shiny")
			bigText("SHINY!", GOLD)
			Juice.Confetti(gui, 90, { GOLD, WHITE })
		end
		hatchNew.Visible = info.New == true
		hatchTap.Text = "Tap to continue"
		-- o nome aparece GRANDE, com pulo
		UI.popIn(hatchName)
		UI.pulse(hatchRarity, 0.25)
		local rank = Config.RarityIndex[def.Rarity] or 1
		if rank >= Config.AnnounceFromRarity then
			bigText(string.upper(def.Rarity) .. "!", rarity.Color)
			Juice.Confetti(gui, if rank >= 6 then 120 else 80)
			Juice.Shake(if rank >= 6 then 1.2 else 0.8, 0.7)
		elseif rank >= 4 or info.Mutation then
			Juice.Confetti(gui, 35)
			Juice.Shake(0.35, 0.35)
		end
		hatchHolder.Size = UDim2.fromOffset(380, 425)
		TweenService:Create(hatchHolder, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(420, 470) }):Play()

		-- 3) Gira o bichinho e fecha sozinho (ou tocando na tela)
		hatchClosable = true
		local showTime = if fast then 1.4 else 3.2
		local revealStart = os.clock()
		while hatchBusy and hatchModel == critterModel and os.clock() - revealStart < showTime do
			frameModel(critterModel, (os.clock() - revealStart) * 1.2)
			hatchGlow.Rotation += 1.5
			hatchRays.Rotation += 0.7
			RunService.RenderStepped:Wait()
		end
		if hatchModel == critterModel then
			closeHatch()
		end
	end

	hatchScreen.Activated:Connect(function()
		if hatchClosable then
			-- muitos ovos de uma vez (ex.: admin "Hatch Now"): tocar pula todos
			if #hatchQueue > 2 then
				local count = #hatchQueue
				table.clear(hatchQueue)
				toast(("+%d more critters hatched! Check your base."):format(count), "rare")
			end
			closeHatch()
		end
	end)

	task.spawn(function()
		while true do
			if not hatchBusy and #hatchQueue > 0 then
				local info = table.remove(hatchQueue, 1)
				local ok, err = pcall(runHatch, info)
				if not ok then
					warn("[Hatch]", err)
					closeHatch()
				end
			end
			task.wait(0.1)
		end
	end)

	-- Explosão de brilho quando alguém choca um ovo perto de você
	local function hatchBurst(position: Vector3, rarityName: string)
		local camera = workspace.CurrentCamera
		if camera and (camera.CFrame.Position - position).Magnitude > 150 then
			return
		end
		local rarity = Config.RarityByName[rarityName] or Config.Rarities[1]
		local index = Config.RarityIndex[rarity.Name] or 1
		local anchor = create("Part", {
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			Transparency = 1,
			Size = Vector3.new(0.2, 0.2, 0.2),
			CFrame = CFrame.new(position),
			Parent = workspace,
		})
		local emitter = create("ParticleEmitter", {
			Color = ColorSequence.new(rarity.Color, WHITE),
			LightEmission = 1,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) }),
			Speed = NumberRange.new(10, 22),
			SpreadAngle = Vector2.new(180, 180),
			Lifetime = NumberRange.new(0.5, 1),
			Drag = 3,
			Rate = 0,
			Parent = anchor,
		})
		emitter:Emit(12 + index * 6)
		task.delay(1.5, function()
			anchor:Destroy()
		end)
	end

	EffectEvent.OnClientEvent:Connect(function(kind, data)
		if kind == "Hatch" then
			if type(data) == "table" and type(data.Critter) == "string" and type(data.Egg) == "string" then
				table.insert(hatchQueue, data)
			end
		elseif kind == "HatchBurst" then
			if type(data) == "table" and typeof(data.Position) == "Vector3" then
				hatchBurst(data.Position, tostring(data.Rarity))
			end
		elseif kind == "Travel" then
			local world = Config.WorldById[tostring(data)]
			if world then
				play("Rare")
				flash(world.Color, 0.7)
				bigText(string.upper(world.Name), world.Color)
			end
		elseif kind == "WorldUnlocked" then
			local world = Config.WorldById[tostring(data)]
			if world then
				play("Rare")
				flash(world.Color, 0.8)
				bigText(string.upper(world.Name) .. " UNLOCKED!", world.Color)
				Juice.Confetti(gui, 100, { world.Color, WHITE, GOLD })
				Juice.Shake(0.9, 0.7)
			end
		elseif kind == "OpenWorlds" then
			if not panels.Worlds.Visible then
				openPanel("Worlds")
			end
		elseif kind == "Train" then
			play("Train")
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				floatingText(root.Position + Vector3.new(0, 3, 0), "+1 SPEED!", Color3.fromRGB(120, 220, 255))
			end
		elseif kind == "Purchase" then
			play("Buy")
		elseif kind == "Collect" then
			play("Coin")
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root and typeof(data) == "number" then
				floatingText(root.Position + Vector3.new(0, 3, 0), "+" .. Format.Money(data), Color3.fromRGB(120, 255, 120))
			end
		elseif kind == "Bonk" then
			if typeof(data) == "Vector3" then
				floatingText(data, "BONK!", Color3.fromRGB(255, 220, 60))
			end
		elseif kind == "Alarm" then
			flash(RED, 0.5)
			Juice.Shake(0.3, 0.3)
			bigText("INTRUDER!", Color3.fromRGB(255, 90, 90))
			task.spawn(function()
				for _ = 1, 3 do
					play("Alarm")
					task.wait(0.25)
				end
			end)
		elseif kind == "Stolen" then
			play("Rare")
			flash(GREEN)
			Juice.Shake(0.4, 0.3)
		elseif kind == "Rebirth" then
			play("Rare")
			flash(PURPLE)
			bigText("REBIRTH!", Color3.fromRGB(220, 170, 255))
			Juice.Confetti(gui, 110)
			Juice.Shake(1, 0.8)
		elseif kind == "Rain" then
			play("Rare")
			bigText("EGG RAIN!", Color3.fromRGB(140, 220, 255))
		elseif kind == "Lucky" then
			play("Rare")
			bigText("LUCKY EVENT!", Color3.fromRGB(140, 255, 160))
		elseif kind == "RareSpawn" then
			play("Rare")
		elseif kind == "Lock" then
			play("Buy")
		end
	end)
end


---------------------------------------------------------------------
-- Minha base: marcador "YOUR BASE" e botão de Instant Lock
---------------------------------------------------------------------
local plotsFolder = workspace:WaitForChild("Map"):WaitForChild("Plots")
local baseMarker: BillboardGui? = nil
local myPlot: Instance? = nil

local function refreshMarker()
	myPlot = nil
	for _, plot in plotsFolder:GetChildren() do
		if plot:GetAttribute("OwnerUserId") == player.UserId then
			myPlot = plot
		end
	end
	if baseMarker then
		baseMarker:Destroy()
		baseMarker = nil
	end
	local sign = myPlot and myPlot:FindFirstChild("Sign") :: BasePart?
	if sign then
		local marker = create("BillboardGui", {
			Name = "YourBaseMarker",
			ResetOnSpawn = false,
			Adornee = sign,
			Size = UDim2.fromOffset(190, 46),
			StudsOffsetWorldSpace = Vector3.new(0, 7, 0),
			AlwaysOnTop = true,
			LightInfluence = 0,
			Parent = playerGui,
		})
		label({ Size = UDim2.fromScale(1, 1), Text = "YOUR BASE", TextColor3 = Color3.fromRGB(120, 255, 120), StrokeThickness = 3, Parent = marker })
		baseMarker = marker
	end
end

-- Com streaming as bases podem chegar um pouco depois do script começar
local function watchPlot(plot: Instance)
	plot:GetAttributeChangedSignal("OwnerUserId"):Connect(refreshMarker)
end
for _, plot in plotsFolder:GetChildren() do
	watchPlot(plot)
end
plotsFolder.ChildAdded:Connect(function(plot)
	watchPlot(plot)
	refreshMarker()
end)
refreshMarker()

---------------------------------------------------------------------
-- TUTORIAL (primeiros 60 segundos)
---------------------------------------------------------------------
local isTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local TUTORIAL_STEPS = 6
local TUTORIAL_TEXT = {
	[1] = if isTouch then "Walk to the conveyor and tap BUY on an EGG!" else "Walk to the conveyor and press E to BUY an EGG!",
	[2] = "Your egg is going to your base. Follow it!",
	[3] = "Your egg is HATCHING... what will it be?!",
	[4] = "Your critter makes cash! Step on the GREEN pad to collect it!",
	[5] = "Step on the RED button to lock your base!",
	[6] = if isTouch then "Sneak into other bases and hold STEAL! Tap your bat to BONK thieves!" else "Sneak into other bases and hold E to STEAL! Click with your bat to BONK thieves!",
}

-- v21: faixa do tutorial menor (embaixo, no meio, mas baixinha)
local tutorialFrame = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -96),
	Size = UDim2.fromOffset(480, 54),
	BackgroundColor3 = Color3.fromRGB(30, 110, 220),
	Visible = false,
	ZIndex = 8,
	Parent = gui,
}, { corner(14), border(WHITE, 2.5), shine() })
autoScale(tutorialFrame)
local tutorialStepLabel = label({ Size = UDim2.new(0, 54, 1, -10), Position = UDim2.fromOffset(8, 5), Text = "1/" .. TUTORIAL_STEPS, TextColor3 = GOLD, ZIndex = 9, Parent = tutorialFrame })
local tutorialLabel = label({ Size = UDim2.new(1, -150, 1, -10), Position = UDim2.fromOffset(64, 5), Text = "", TextWrapped = true, ZIndex = 9, Parent = tutorialFrame })
button({
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -6, 0.5, 0),
	Size = UDim2.fromOffset(74, 38),
	BackgroundColor3 = GRAY,
	ZIndex = 9,
	Parent = tutorialFrame,
}, "SKIP", function()
	RequestEvent:FireServer("SkipTutorial")
end)

local targetAttachment = create("Attachment", { Name = "TutorialTarget", Parent = workspace.Terrain })
local tutorialBeam = create("Beam", {
	Attachment1 = targetAttachment,
	Color = ColorSequence.new(Color3.fromRGB(255, 240, 90)),
	Width0 = 0.8,
	Width1 = 0.8,
	FaceCamera = true,
	LightEmission = 1,
	Transparency = NumberSequence.new(0.15),
	Enabled = false,
	Parent = workspace.Terrain,
})
local tutorialArrow = create("BillboardGui", {
	Adornee = targetAttachment,
	Size = UDim2.fromOffset(80, 80),
	AlwaysOnTop = true,
	LightInfluence = 0,
	Enabled = false,
	ResetOnSpawn = false,
	Parent = playerGui,
})
label({ Size = UDim2.fromScale(1, 1), Text = "V", TextColor3 = Color3.fromRGB(255, 240, 90), StrokeThickness = 4, Parent = tutorialArrow })
local tutorialHighlight: Highlight? = nil

-- O primeiro ovo do jogador (para a seta do passo "chocar")
local function myEgg(): Model?
	for _, model in activeCritters:GetChildren() do
		if model:GetAttribute("Kind") == "Egg" and model:GetAttribute("OwnerUserId") == player.UserId then
			return model :: Model
		end
	end
	return nil
end

local function tutorialTarget(step: number): (Vector3?, Instance?)
	if not myPlot then
		return nil, nil
	end
	local origin = myPlot:FindFirstChild("Origin") :: BasePart?
	if not origin then
		return nil, nil
	end
	if step == 1 then
		return (origin.CFrame * CFrame.new(0, 2, -60)).Position, nil
	elseif step == 2 then
		return origin.Position + Vector3.new(0, 4, 0), nil
	elseif step == 3 then
		local egg = myEgg()
		local root = egg and egg:FindFirstChild("Root") :: BasePart?
		if egg and root then
			return root.Position + Vector3.new(0, 3, 0), egg
		end
		return origin.Position + Vector3.new(0, 4, 0), nil
	elseif step == 4 then
		local pad = myPlot:FindFirstChild("CollectPad") :: BasePart?
		return if pad then pad.Position + Vector3.new(0, 2, 0) else nil, pad
	elseif step == 5 then
		local lockButton = myPlot:FindFirstChild("LockButton") :: BasePart?
		return if lockButton then lockButton.Position + Vector3.new(0, 2, 0) else nil, lockButton
	end
	return nil, nil
end

local function refreshTutorial()
	local step = player:GetAttribute("TutorialStep")
	if tutorialHighlight then
		tutorialHighlight:Destroy()
		tutorialHighlight = nil
	end
	if typeof(step) ~= "number" then
		tutorialFrame.Visible = false
		tutorialBeam.Enabled = false
		tutorialArrow.Enabled = false
		return
	end
	tutorialFrame.Visible = true
	tutorialStepLabel.Text = step .. "/" .. TUTORIAL_STEPS
	tutorialLabel.Text = TUTORIAL_TEXT[step] or ""
	play("Rare")
	local _, part = tutorialTarget(step)
	if part then
		tutorialHighlight = create("Highlight", {
			FillColor = Color3.fromRGB(255, 240, 90),
			OutlineColor = WHITE,
			FillTransparency = 0.5,
			Parent = part,
		})
	end
end
player:GetAttributeChangedSignal("TutorialStep"):Connect(refreshTutorial)

local refreshTraining: () -> ()
do
	---------------------------------------------------------------------
	-- Esteira de treino: barra de progresso enquanto corre
	---------------------------------------------------------------------
	local trainFrame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -190),
		Size = UDim2.fromOffset(360, 46),
		BackgroundColor3 = Color3.fromRGB(25, 25, 40),
		Visible = false,
		ZIndex = 7,
		Parent = gui,
	}, { corner(12), border(Color3.fromRGB(120, 220, 255), 3) })
	autoScale(trainFrame)
	local trainFill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(60, 170, 240), ZIndex = 7, Parent = trainFrame }, { corner(12) })
	local trainText = label({ Size = UDim2.new(1, -12, 1, -8), Position = UDim2.fromOffset(6, 4), Text = "", ZIndex = 8, Parent = trainFrame })

	function refreshTraining()
		local training = player:GetAttribute("Training") == true
		trainFrame.Visible = training
		if not training then
			return
		end
		local trained = player:GetAttribute("TrainedSpeed") or 0
		local cap = player:GetAttribute("TrainCap") or Config.TreadmillBaseCap
		if trained >= cap then
			trainFill.Size = UDim2.fromScale(1, 1)
			trainText.Text = ("TREADMILL MAX +%d! Rebirth to train more"):format(cap)
		else
			local progress = math.clamp(player:GetAttribute("TrainProgress") or 0, 0, 1)
			trainFill.Size = UDim2.fromScale(progress, 1)
			trainText.Text = ("KEEP RUNNING!  Speed +%d/%d"):format(trained, cap)
		end
	end
	for _, attribute in { "Training", "TrainProgress", "TrainedSpeed", "TrainCap" } do
		player:GetAttributeChangedSignal(attribute):Connect(refreshTraining)
	end
end

-- Contagem regressiva em cima dos ovos chocando (cada tela calcula a sua)
local function refreshEggTimers(serverNow: number)
	local camera = workspace.CurrentCamera
	local cameraPosition = if camera then camera.CFrame.Position else Vector3.zero
	for _, model in activeCritters:GetChildren() do
		if model:GetAttribute("Kind") == "Egg" and model:GetAttribute("State") == "Incubating" then
			local root = model:FindFirstChild("Root") :: BasePart?
			local hatchAt = model:GetAttribute("HatchAt")
			if root and typeof(hatchAt) == "number" and (root.Position - cameraPosition).Magnitude < 90 then
				local info = root:FindFirstChild("Info")
				local line = info and info:FindFirstChild("ValueLine") :: TextLabel?
				if line then
					local left = math.max(0, math.ceil(hatchAt - serverNow))
					local waitFor = model:GetAttribute("WaitFor") -- ovo de clima esperando chuva/neve/noite
					if typeof(waitFor) == "string" then
						line.Text = "Waiting for " .. string.upper(waitFor) .. " (" .. Format.Time(left) .. ")"
					else
						line.Text = if left > 0 then "Hatch in " .. Format.Time(left) else "HATCHING!"
					end
				end
			end
		end
	end
end

---------------------------------------------------------------------
-- Atualizações contínuas (4x por segundo)
---------------------------------------------------------------------
local function timerText(name: string, attribute: string): string?
	local value = workspace:GetAttribute(attribute)
	if typeof(value) ~= "number" then
		return nil
	end
	return name .. " in " .. Format.Time(value - workspace:GetServerTimeNow())
end

local elapsed = 0
RunService.Heartbeat:Connect(function(dt)
	elapsed += dt
	if elapsed < 0.25 then
		return
	end
	elapsed = 0
	local serverNow = workspace:GetServerTimeNow()
	refreshEggTimers(serverNow)

	-- Eventos
	local rainUntil = workspace:GetAttribute("RainUntil")
	local luckyUntil = workspace:GetAttribute("LuckyUntil")
	local rainLeft = if typeof(rainUntil) == "number" then rainUntil - serverNow else 0
	local luckyLeft = if typeof(luckyUntil) == "number" then luckyUntil - serverNow else 0
	if rainLeft > 0 then
		eventBanner.Visible = true
		eventBanner.BackgroundColor3 = Color3.fromRGB(40, 130, 230)
		eventBannerText.Text = "EGG RAIN! Catch free eggs!  " .. Format.Time(rainLeft)
	elseif luckyLeft > 0 then
		eventBanner.Visible = true
		eventBanner.BackgroundColor3 = Color3.fromRGB(40, 170, 90)
		eventBannerText.Text = ("LUCKY EVENT! x%d rare eggs  %s"):format(Config.LuckyEggMultiplier, Format.Time(luckyLeft))
	else
		eventBanner.Visible = false
	end
	local texts = {}
	local rainText = timerText("Egg Rain", "NextRain")
	local luckyText = timerText("Lucky", "NextLucky")
	if rainText then
		table.insert(texts, rainText)
	end
	if luckyText then
		table.insert(texts, luckyText)
	end
	-- v26: critter da semana (o servidor publica nos atributos do Workspace)
	local weeklyName = workspace:GetAttribute("WeeklyName")
	local weeklyEnds = workspace:GetAttribute("WeeklyEnds")
	if typeof(weeklyName) == "string" and typeof(weeklyEnds) == "number" then
		local left = math.max(0, weeklyEnds - os.time())
		local days = math.floor(left / 86400)
		local hours = math.floor((left % 86400) / 3600)
		local leftText = if days > 0 then ("%dd %dh"):format(days, hours) elseif hours > 0 then ("%dh"):format(hours) else ("%dm"):format(math.max(1, math.floor(left / 60)))
		table.insert(texts, ("\u{2B50} Week: %s (%s left)"):format(weeklyName, leftText))
	end
	eventText.Text = table.concat(texts, "  |  ")
	eventStrip.Visible = #texts > 0 -- v21: sem evento marcado, o chip some

	-- Marcador e botão de Instant Lock
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if baseMarker and myPlot then
		local sign = myPlot:FindFirstChild("Sign") :: BasePart?
		if root and sign then
			local inMeadow = (player:GetAttribute("World") or "meadow") == "meadow"
			baseMarker.Enabled = inMeadow and (root.Position - sign.Position).Magnitude > 50
		end
	end
	local showInstant = false
	if myPlot then
		local lockedUntil = myPlot:GetAttribute("LockedUntil") or 0
		local cooldownUntil = myPlot:GetAttribute("CooldownUntil") or 0
		local productId = Config.DevProducts.InstantLock or 0
		showInstant = lockedUntil <= serverNow and cooldownUntil > serverNow and (productId > 0 or IS_STUDIO)
		-- v23: o dono vê os segundos da trava (e da recarga) na coluna da esquerda
		if lockedUntil > serverNow then
			lockBar.Visible = true
			lockBar.BackgroundColor3 = Color3.fromRGB(215, 60, 70)
			lockText.Text = ("\u{1F512} BASE LOCKED  %s"):format(Format.Time(lockedUntil - serverNow))
			lockFill.Size = UDim2.fromScale(math.clamp((lockedUntil - serverNow) / math.max(Config.LockDurationPass, 1), 0, 1), 1)
		elseif cooldownUntil > serverNow then
			lockBar.Visible = true
			lockBar.BackgroundColor3 = Color3.fromRGB(90, 90, 110)
			lockText.Text = ("\u{1F513} Lock ready in %s"):format(Format.Time(cooldownUntil - serverNow))
			lockFill.Size = UDim2.fromScale(1 - math.clamp((cooldownUntil - serverNow) / math.max(Config.LockCooldown, 1), 0, 1), 1)
		else
			lockBar.Visible = false
		end
	else
		lockBar.Visible = false
	end
	instantLockButton.Visible = showInstant

	-- Seta do tutorial: do jogador até o objetivo
	local step = player:GetAttribute("TutorialStep")
	local position = if typeof(step) == "number" then tutorialTarget(step) else nil
	if position and root then
		local attachment = root:FindFirstChild("TutorialAttachment") :: Attachment?
		if not attachment then
			attachment = create("Attachment", { Name = "TutorialAttachment", Parent = root })
		end
		tutorialBeam.Attachment0 = attachment
		targetAttachment.WorldPosition = position
		tutorialBeam.Enabled = true
		tutorialArrow.Enabled = true
		tutorialArrow.StudsOffsetWorldSpace = Vector3.new(0, 2 + math.abs(math.sin(os.clock() * 3)) * 1.5, 0)
	else
		tutorialBeam.Enabled = false
		tutorialArrow.Enabled = false
	end
end)

local camera = workspace.CurrentCamera
if camera then
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScales)
end
updateScales()

refreshCash()
refreshIncome()
refreshAdmin()
---------------------------------------------------------------------
-- JOGADORES NOVOS: escudo, vingança e "próximo objetivo"
---------------------------------------------------------------------
do
	local plots = workspace:WaitForChild("Map"):WaitForChild("Plots")
	local domes: { [Instance]: { Dome: BasePart, Label: TextLabel } } = {}

	-- Faixa "próximo objetivo" (v21: na coluna da esquerda)
	local goalFrame = create("Frame", {
		Name = "GoalBar",
		LayoutOrder = 25,
		Size = UDim2.fromOffset(STACK_W, 36),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.1,
		Visible = false,
		ZIndex = 30,
		Parent = leftStack,
	}, { corner(10), border(GOLD, 2) })
	local goalFill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(90, 70, 160),
		BorderSizePixel = 0,
		ZIndex = 30,
		Parent = goalFrame,
	}, { corner(10) })
	local goalText = label({ Size = UDim2.new(1, -12, 1, -8), Position = UDim2.fromOffset(6, 4), Text = "", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 31, Parent = goalFrame })

	-- Faixa da vingança (v21: na coluna da esquerda)
	local revengeFrame = create("Frame", {
		Name = "RevengeBar",
		LayoutOrder = 55,
		Size = UDim2.fromOffset(STACK_W, 30),
		BackgroundColor3 = Color3.fromRGB(200, 40, 50),
		Visible = false,
		ZIndex = 30,
		Parent = leftStack,
	}, { corner(10), border(WHITE, 2), shine() })
	local revengeText = label({ Size = UDim2.new(1, -12, 1, -8), Position = UDim2.fromOffset(6, 4), Text = "", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 31, Parent = revengeFrame })
	local revengeHighlight: Highlight? = nil

	local function setGoal(text: string, progress: number?)
		goalFrame.Visible = true
		goalText.Text = text
		goalFill.Size = UDim2.fromScale(math.clamp(progress or 0, 0, 1), 1)
	end

	local function isUnlocked(worldId: string): boolean
		local list = player:GetAttribute("WorldsUnlocked")
		return worldId == "meadow" or (typeof(list) == "string" and table.find(string.split(list, ","), worldId) ~= nil)
	end

	local function refreshGoal(serverNow: number, myShield: number)
		if myShield > serverNow then
			setGoal(("\u{1F6E1} New player shield: %s - nobody can steal from you!"):format(Format.Time(myShield - serverNow)), (myShield - serverNow) / Config.NewbieShieldSeconds)
			return
		end
		if typeof(player:GetAttribute("TutorialStep")) == "number" then
			goalFrame.Visible = false
			return
		end
		local cash = player:GetAttribute("Cash") or 0
		local income = player:GetAttribute("Income") or 0
		local free = player:GetAttribute("FreeSlots") or 0
		local slots = player:GetAttribute("Slots") or Config.StartSlots
		local bought = player:GetAttribute("SlotUpgrades") or 0
		local rebirths = player:GetAttribute("Rebirths") or 0
		if free > 0 and income < 200 then
			setGoal(("Goal: buy eggs to fill your base (%d free)"):format(free), 1 - free / slots)
			return
		end
		local slotCost = Config.SlotUpgradeCosts[bought + 1]
		if slotCost and slots < Config.MaxSlots and cash * 3 >= slotCost then
			setGoal(("Goal: +1 base slot in SHOP (%s)"):format(Format.Money(slotCost)), cash / slotCost)
			return
		end
		for index, world in Config.Worlds do
			if not isUnlocked(world.Id) then
				if rebirths < world.Rebirths then
					local cost = Config.RebirthCost(rebirths)
					setGoal(("Goal: REBIRTH %d (%s) to reach %s"):format(rebirths + 1, Format.Money(cost), world.Name), cash / cost)
				else
					setGoal(("Goal: unlock %s (%s)"):format(world.Name, Format.Money(world.Cash)), cash / math.max(world.Cash, 1))
				end
				return
			end
			if index == #Config.Worlds then
				local cost = Config.RebirthCost(rebirths)
				setGoal(("Goal: REBIRTH %d (%s) - x%g cash"):format(rebirths + 1, Format.Money(cost), 1 + (rebirths + 1) * Config.RebirthIncomeBonus), cash / cost)
			end
		end
	end

	local function refreshShields(serverNow: number): number
		local myShield = 0
		for _, plot in plots:GetChildren() do
			local shield = plot:GetAttribute("ShieldUntil")
			local active = typeof(shield) == "number" and shield > serverNow and plot:GetAttribute("OwnerUserId") ~= nil
			local entry = domes[plot]
			if active then
				if plot:GetAttribute("OwnerUserId") == player.UserId then
					myShield = shield
				end
				local origin = plot:FindFirstChild("Origin") :: BasePart?
				if not entry and origin then
					local dome = create("Part", {
						Name = "NewbieShield",
						Anchored = true,
						CanCollide = false,
						CanQuery = false,
						CanTouch = false,
						CastShadow = false,
						Material = Enum.Material.ForceField,
						Color = Color3.fromRGB(90, 220, 255),
						Size = Vector3.new(70, 40, 78),
						CFrame = CFrame.new(origin.Position),
						Parent = workspace,
					}, { create("SpecialMesh", { MeshType = Enum.MeshType.Sphere }) })
					local board = create("BillboardGui", {
						Size = UDim2.fromOffset(260, 60),
						StudsOffsetWorldSpace = Vector3.new(0, 24, 0),
						LightInfluence = 0,
						MaxDistance = 160,
						Parent = dome,
					})
					local text = label({ Size = UDim2.fromScale(1, 1), Text = "", TextColor3 = Color3.fromRGB(150, 235, 255), StrokeThickness = 3, Parent = board })
					entry = { Dome = dome, Label = text }
					domes[plot] = entry
				end
				if entry then
					entry.Label.Text = "\u{1F6E1} NEW PLAYER SHIELD " .. Format.Time(shield - serverNow)
				end
			elseif entry then
				entry.Dome:Destroy()
				domes[plot] = nil
			end
		end
		return myShield
	end

	local function refreshRevenge(serverNow: number)
		local untilTime = player:GetAttribute("RevengeUntil")
		local targetId = player:GetAttribute("RevengeTarget")
		local active = typeof(untilTime) == "number" and untilTime > serverNow
		revengeFrame.Visible = active
		local target = if active and typeof(targetId) == "number" then Players:GetPlayerByUserId(targetId) else nil
		if active then
			revengeText.Text = ("REVENGE! +%d speed %ds - chase %s!"):format(Config.RevengeSpeedBonus, math.ceil(untilTime - serverNow), if target then target.DisplayName else "the thief")
		end
		local character = target and target.Character
		if character then
			if not revengeHighlight or revengeHighlight.Parent ~= character then
				if revengeHighlight then
					revengeHighlight:Destroy()
				end
				revengeHighlight = create("Highlight", {
					FillColor = Color3.fromRGB(255, 60, 60),
					OutlineColor = WHITE,
					FillTransparency = 0.45,
					DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
					Parent = character,
				})
			end
		elseif revengeHighlight then
			revengeHighlight:Destroy()
			revengeHighlight = nil
		end
	end

	-- dinheiro "pulando" dos seus bichinhos (só na sua tela)
	local function moneyPops()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local multiplier = tonumber(player:GetAttribute("Multiplier")) or 1
		local count = 0
		for _, model in activeCritters:GetChildren() do
			if count >= 18 then
				break
			end
			if model:GetAttribute("OwnerUserId") == player.UserId and model:GetAttribute("State") == "Placed" then
				local root = model:FindFirstChild("Root") :: BasePart?
				local def = Critters.ById[model:GetAttribute("CritterId") or ""]
				if root and def and (root.Position - camera.CFrame.Position).Magnitude < 70 then
					count += 1
					local amount = def.Income * Config.IncomeMultiplier(model:GetAttribute("Mutation")) * multiplier * 2
					task.delay(count * 0.07, Juice.MoneyPop, root, "+" .. Format.Money(amount), nil, root.Size.Y + 2)
				end
			end
		end
	end

	local elapsedFair, elapsedPops = 0, 0
	RunService.Heartbeat:Connect(function(dt)
		elapsedFair += dt
		elapsedPops += dt
		if elapsedFair >= 0.5 then
			elapsedFair = 0
			local serverNow = workspace:GetServerTimeNow()
			local myShield = refreshShields(serverNow)
			refreshGoal(serverNow, myShield)
			refreshRevenge(serverNow)
		end
		if elapsedPops >= 2 then
			elapsedPops = 0
			if player:GetAttribute("MoneyPops") ~= false then -- dá para desligar em SETTINGS
				moneyPops()
			end
		end
	end)

	-- de vez em quando confere de novo quem pode ser roubado (escudo acabou, renda mudou...)
	task.spawn(function()
		while true do
			task.wait(2)
			for _, model in activeCritters:GetChildren() do
				local root = model:FindFirstChild("Root")
				local prompt = root and root:FindFirstChild("StealPrompt")
				if prompt then
					evaluatePrompt(prompt)
				end
			end
		end
	end)
end

---------------------------------------------------------------------
-- Mapa vivo: peças com Tag "Spin"/"Bob" giram e balançam (só na sua tela, sem pesar o servidor)
---------------------------------------------------------------------
do
	type Mover = { Base: CFrame, Center: CFrame, Speed: number, Axis: Vector3, Bob: number, Phase: number, Spin: boolean }
	local movers: { [Instance]: Mover } = {}
	local AXES = { X = Vector3.xAxis, Y = Vector3.yAxis, Z = Vector3.zAxis }

	local function track(instance: Instance)
		if movers[instance] then
			return
		end
		-- enfeite criado na hora pode chegar antes das peças: espera a primeira peça para achar o centro
		if instance:IsA("Model") and not instance:FindFirstChildWhichIsA("BasePart", true) then
			local connection
			connection = instance.DescendantAdded:Connect(function(descendant)
				if descendant:IsA("BasePart") then
					connection:Disconnect()
					task.defer(track, instance)
				end
			end)
			return
		end
		local base: CFrame
		if instance:IsA("Model") then
			base = instance:GetPivot()
		elseif instance:IsA("BasePart") then
			base = instance.CFrame
		else
			return
		end
		local center = base
		local pivot = instance:FindFirstChild("Pivot")
		if pivot and pivot:IsA("BasePart") then
			center = pivot.CFrame
		elseif instance:IsA("Model") then
			center = CFrame.new((instance :: Model):GetBoundingBox().Position)
		end
		local axis = AXES[tostring(instance:GetAttribute("SpinAxis") or "Y")] or Vector3.yAxis
		movers[instance] = {
			Base = base,
			Center = CFrame.new(center.Position),
			Speed = tonumber(instance:GetAttribute("SpinSpeed")) or 1,
			Axis = axis,
			Bob = if CollectionService:HasTag(instance, "Bob") then tonumber(instance:GetAttribute("BobHeight")) or 1 else 0,
			Phase = math.random() * 6,
			Spin = CollectionService:HasTag(instance, "Spin"),
		}
	end
	local function untrack(instance: Instance)
		movers[instance] = nil
	end
	for _, tag in { "Spin", "Bob" } do
		for _, instance in CollectionService:GetTagged(tag) do
			track(instance)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(track)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(untrack)
	end

	RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local cameraPosition = camera.CFrame.Position
		local t = os.clock()
		for instance, mover in movers do
			if not instance.Parent then
				movers[instance] = nil
				continue
			end
			if (mover.Center.Position - cameraPosition).Magnitude > (if player:GetAttribute("LowGfx") then 120 else 350) then
				continue
			end
			local offset = CFrame.identity
			if mover.Spin then
				offset = CFrame.fromAxisAngle(mover.Axis, (t * mover.Speed + mover.Phase) % (math.pi * 2))
			end
			local lift = Vector3.new(0, math.sin(t * 1.6 + mover.Phase) * mover.Bob, 0)
			local target = (mover.Center + lift) * offset * mover.Center:Inverse() * mover.Base
			if instance:IsA("Model") then
				instance:PivotTo(target)
			elseif instance:IsA("BasePart") then
				instance.CFrame = target
			end
		end
	end)
end

-- Barraquinhas do mapa (SHOP, INDEX, REBIRTH, CODES) abrem as janelas
ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
	if who ~= player or not CollectionService:HasTag(prompt, "OpenPanel") then
		return
	end
	local panelName = prompt:GetAttribute("Panel")
	if typeof(panelName) == "string" and panels[panelName] and not panels[panelName].Visible then
		openPanel(panelName)
	end
end)

---------------------------------------------------------------------
-- Telas novas da v7 (ficam em módulos separados, ao lado deste script)
---------------------------------------------------------------------
do
	local function scaleNow(guiObject: GuiObject)
		local camera = workspace.CurrentCamera
		local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
		local value = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.55, 1.25)
		local scale = Instance.new("UIScale")
		scale.Scale = value
		scale:SetAttribute("Base", value)
		scale.Parent = guiObject
	end
	local ctx = {
		gui = gui,
		leftStack = leftStack, -- v21: coluna de avisos da esquerda (itens com LayoutOrder; sem scaleNow!)
		stackWidth = STACK_W,
		topInset = TOP_INSET,
		makePanel = makePanel,
		panelOpened = panelOpened,
		toast = toast,
		play = play,
		scaleNow = scaleNow,
		RequestEvent = RequestEvent,
		EffectEvent = EffectEvent,
		InventoryEvent = RemotesFolder:WaitForChild("InventorySync") :: RemoteEvent,
		StyleEvent = RemotesFolder:WaitForChild("StyleSync") :: RemoteEvent,
		SeasonEvent = RemotesFolder:WaitForChild("SeasonSync") :: RemoteEvent,
		panels = panels,
		flash = flash,
		bigText = bigText,
		floatingText = floatingText,
		openPanel = openPanel,
		menuButton = menuButton,
		RemotesFolder = RemotesFolder,
	}
	require(script.Parent:WaitForChild("InventoryUI")).Init(ctx)
	require(script.Parent:WaitForChild("LabUI")).Init(ctx)
	require(script.Parent:WaitForChild("Atmos")).Init(ctx)
	require(script.Parent:WaitForChild("MeUI")).Init(ctx)
	require(script.Parent:WaitForChild("SocialUI")).Init(ctx)
	require(script.Parent:WaitForChild("MinigameUI")).Init(ctx)
	require(script.Parent:WaitForChild("ExploreUI")).Init(ctx)
	require(script.Parent:WaitForChild("NpcUI")).Init(ctx)
	require(script.Parent:WaitForChild("EventsUI")).Init(ctx)
	require(script.Parent:WaitForChild("StyleUI")).Init(ctx)
	require(script.Parent:WaitForChild("PassUI")).Init(ctx)
	require(script.Parent:WaitForChild("SettingsUI")).Init(ctx)
	require(script.Parent:WaitForChild("RetentionUI")).Init(ctx) -- v23: presentes de tempo + roleta diária
	require(script.Parent:WaitForChild("PetFollow")).Init()
	-- v21: montarias animadas e efeitos 3D do mundo (se algo der errado neles, o resto da tela continua)
	for _, name in { "MountFX", "WorldFX", "WorldLife" } do -- v27: WorldLife = mundos vivos + brincadeiras
		local ok, err = pcall(function()
			require(script.Parent:WaitForChild(name)).Init(ctx)
		end)
		if not ok then
			warn("[" .. name .. "]", err)
		end
	end
	updateScales() -- as janelas novas também ficam do tamanho certo no celular

	-- Celular deitado (tela baixa): menu em 3 colunas para não cobrir o botão de pular
	local function fitMenu()
		local camera = workspace.CurrentCamera
		local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
		local visible = 0
		for _, child in menu:GetChildren() do
			if child:IsA("GuiButton") and child.Visible then
				visible += 1
			end
		end
		local small = size.Y < 500 or visible > 14 -- muitos botões: 3 colunas para não descer demais
		menuColumns = if small then 3 else 2
		layoutMenu()
	end
	fitMenu()
	for _, child in menu:GetChildren() do
		if child:IsA("GuiButton") then
			child:GetPropertyChangedSignal("Visible"):Connect(fitMenu)
		end
	end
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitMenu)
	end
end

refreshCarry()
refreshTraining()
applyWorldSky()
refreshTutorial()
RequestEvent:FireServer("GetIndex")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="478">
        <Properties>
          <string name="Name">EventsUI</string>
          <string name="Source"><![CDATA[--[[
	EventsUI (ModuleScript em StarterPlayer > StarterPlayerScripts)
	Parte 25 (v11): o que os eventos ao vivo mostram na tela.
	  • faixa da comunidade (meta de ovos de todos os servidores) + festa do calendário
	  • votação (aparece só enquanto está aberta): 3 botões com os votos ao vivo
	  • invasão de monstros: quantos faltam e o tempo que sobra
	  • janela do MERCADOR (abre na barraca): ofertas da hora, preços claros e relógio de verdade
	Tudo vem dos atributos do Workspace (o servidor manda).
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Critters = require(Shared:WaitForChild("Critters"))
local Format = require(Shared:WaitForChild("Format"))
local UI = require(script.Parent:WaitForChild("UIKit"))
local Juice = require(script.Parent:WaitForChild("Juice"))

local EventsUI = {}

local C = UI.Colors
local create, corner, label, button = UI.create, UI.corner, UI.label, UI.button

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

function EventsUI.Init(ctx)
	local player = Players.LocalPlayer

	---------------------------------------------------------------------
	-- Faixa da comunidade e da festa (embaixo da contagem dos eventos)
	---------------------------------------------------------------------
	-- v21: tudo na coluna da esquerda (ctx.leftStack), sem scaleNow (a coluna já tem a escala)
	local stack = ctx.leftStack or ctx.gui
	local W = ctx.stackWidth or 300
	local strip = create("Frame", {
		Name = "CommunityStrip",
		LayoutOrder = 10,
		Size = UDim2.fromOffset(W, 26),
		BackgroundColor3 = C.Dark,
		BackgroundTransparency = 0.3,
		ZIndex = 30,
		Parent = stack,
	}, { corner(9) })
	local stripFill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(70, 150, 90), BackgroundTransparency = 0.3, ZIndex = 30, Parent = strip }, { corner(9) })
	local stripText = label({ Size = UDim2.new(1, -12, 1, -4), Position = UDim2.fromOffset(6, 2), Text = "", StrokeThickness = 1.5, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 31, Parent = strip })

	-- Votação
	local vote = create("Frame", {
		Name = "VoteBar",
		LayoutOrder = 40,
		Size = UDim2.fromOffset(W, 60),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.1,
		Visible = false,
		ZIndex = 30,
		Parent = stack,
	}, { corner(12), UI.border(C.Gold, 2) })
	local voteTitle = label({ Position = UDim2.fromOffset(8, 2), Size = UDim2.new(1, -16, 0, 20), Text = "VOTE THE NEXT EVENT!", TextColor3 = C.Gold, ZIndex = 31, Parent = vote })
	local voteButtons: { any } = {}
	for i = 1, 3 do
		local btn, text = button({
			Position = UDim2.new((i - 1) / 3, 4, 0, 24),
			Size = UDim2.new(1 / 3, -8, 0, 32),
			BackgroundColor3 = C.Blue,
			ZIndex = 31,
			Parent = vote,
		}, "", function()
			ctx.play("Click")
			ctx.RequestEvent:FireServer("Vote", i)
		end)
		voteButtons[i] = { Button = btn, Text = text }
	end

	-- Invasão
	local invasion = create("Frame", {
		Name = "InvasionBar",
		LayoutOrder = 45,
		Size = UDim2.fromOffset(W, 30),
		BackgroundColor3 = Color3.fromRGB(120, 40, 150),
		Visible = false,
		ZIndex = 30,
		Parent = stack,
	}, { corner(10), UI.border(C.White, 2) })
	local invasionText = label({ Size = UDim2.new(1, -12, 1, -6), Position = UDim2.fromOffset(6, 3), Text = "", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 31, Parent = invasion })

	local function refreshTop()
		local t = serverNow()
		-- comunidade
		local count = tonumber(workspace:GetAttribute("GlobalCount")) or 0
		local tier = tonumber(workspace:GetAttribute("GlobalTier")) or 0
		local goal = Config.GlobalGoals[tier + 1]
		local holidayId = workspace:GetAttribute("Holiday")
		local holiday = if typeof(holidayId) == "string" then Config.HolidayById[holidayId] else nil
		if goal then
			stripFill.Size = UDim2.fromScale(math.clamp(count / goal.Goal, 0, 1), 1)
			stripText.Text = ("Community: %s/%s eggs \u{2192} %s"):format(Format.Short(count), Format.Short(goal.Goal), goal.Name)
		else
			stripFill.Size = UDim2.fromScale(1, 1)
			stripText.Text = "Community: all goals reached!"
		end
		if holiday then
			stripText.Text = string.upper(holiday.Name) .. "! " .. stripText.Text
			stripFill.BackgroundColor3 = holiday.Color
		end
		-- votação
		local options = workspace:GetAttribute("VoteOptions")
		local voteUntil = workspace:GetAttribute("VoteUntil")
		vote.Visible = typeof(options) == "string" and typeof(voteUntil) == "number" and voteUntil > t
		if vote.Visible then
			local names = string.split(options, ",")
			local counts = string.split(tostring(workspace:GetAttribute("VoteCounts") or ""), ",")
			voteTitle.Text = ("VOTE THE NEXT EVENT!  %ds"):format(math.max(0, math.ceil(voteUntil - t)))
			for i, entry in voteButtons do
				local name = names[i]
				entry.Button.Visible = name ~= nil
				if name then
					entry.Text.Text = ("%s (%s)"):format(Config.VoteNames[name] or name, counts[i] or "0")
				end
			end
		end
		-- invasão
		local invasionUntil = workspace:GetAttribute("InvasionUntil")
		invasion.Visible = typeof(invasionUntil) == "number" and invasionUntil > t
		-- (v21: a coluna da esquerda empilha as faixas sozinha, pelo LayoutOrder)
		if invasion.Visible then
			local folder = workspace:FindFirstChild("Monsters")
			local left = if folder then #folder:GetChildren() else 0
			invasionText.Text = ("MONSTER INVASION! %d Grumblobs left - BONK them! %s"):format(left, Format.Time(math.max(0, invasionUntil - t)))
		end
	end

	---------------------------------------------------------------------
	-- MERCADOR
	---------------------------------------------------------------------
	local frame, content = ctx.makePanel("Merchant", "TRAVELING MERCHANT", C.Gold)
	create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = content })
	local status = label({ LayoutOrder = 0, Size = UDim2.new(1, -12, 0, 40), Text = "", TextColor3 = C.Gold, TextWrapped = true, ZIndex = 5, Parent = content })
	local rows: { any } = {}
	local shownStock = ""

	local function offerText(offer): (string, string)
		if offer.Kind == "Egg" then
			local egg = Config.EggById[offer.Id]
			return (if egg then egg.Name else "Egg") .. " (25% OFF)", Format.Money(offer.Price)
		elseif offer.Kind == "Critter" then
			local def = Critters.ById[offer.Id]
			return ("%s %s (%s)"):format(offer.Mutation or "", if def then def.Name else "Critter", if def then def.Rarity else ""), Format.Money(offer.Price)
		end
		local price = tonumber(player:GetAttribute("MerchantBoostPrice")) or 1000
		return ("2x Cash for %d minutes"):format(offer.Minutes or 10), Format.Money(price)
	end

	local function buildRows(stock: { any })
		for _, entry in rows do
			entry.Frame:Destroy()
		end
		rows = {}
		for index, offer in stock do
			local box = create("Frame", { LayoutOrder = index, Size = UDim2.new(1, -12, 0, 64), BackgroundColor3 = C.Row, ZIndex = 5, Parent = content }, { corner(12) })
			local title = label({ Position = UDim2.fromOffset(12, 4), Size = UDim2.new(0.62, -12, 0, 30), Text = "", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5, Parent = box })
			local price = label({ Position = UDim2.fromOffset(12, 34), Size = UDim2.new(0.62, -12, 0, 24), Text = "", TextColor3 = Color3.fromRGB(255, 230, 120), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5, Parent = box })
			local buy, buyText = button({
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.new(0.34, -10, 0, 48),
				BackgroundColor3 = C.Green,
				ZIndex = 6,
				Parent = box,
			}, "BUY", function()
				local entry = rows[index]
				if not entry or not entry.Available then
					ctx.toast(if workspace:GetAttribute("MerchantHere") == true then "You already bought this! New offers next hour." else "The merchant is away right now.", "info")
					return
				end
				local name, cost = offerText(offer)
				UI.confirm(ctx.gui, "BUY?", ("Buy %s for %s?"):format(name, cost), "BUY", C.Green, function()
					ctx.RequestEvent:FireServer("MerchantBuy", index)
				end, ctx.scaleNow)
			end)
			rows[index] = { Frame = box, Title = title, Price = price, Buy = buy, BuyText = buyText, Offer = offer }
		end
	end

	local function refreshMerchant()
		local raw = workspace:GetAttribute("MerchantStock")
		if typeof(raw) == "string" and raw ~= shownStock then
			shownStock = raw
			local ok, stock = pcall(function()
				return HttpService:JSONDecode(raw)
			end)
			if ok and type(stock) == "table" then
				buildRows(stock)
			end
		end
		local here = workspace:GetAttribute("MerchantHere") == true
		local t = serverNow()
		if here then
			local leaves = tonumber(workspace:GetAttribute("MerchantLeaves")) or t
			status.Text = ("The merchant is here for %s more! New offers every hour."):format(Format.Time(math.max(0, leaves - t)))
		else
			local arrives = tonumber(workspace:GetAttribute("MerchantArrives")) or t
			status.Text = ("The merchant is traveling. Back in %s (at the start of every hour, for 15 min)."):format(Format.Time(math.max(0, arrives - t)))
		end
		local bought = {}
		for _, key in string.split(tostring(player:GetAttribute("MerchantBought") or ""), ",") do
			if tonumber(key) then
				bought[tonumber(key)] = true
			end
		end
		for index, entry in rows do
			local name, cost = offerText(entry.Offer)
			entry.Title.Text = name
			entry.Price.Text = cost
			local done = bought[index] == true
			entry.BuyText.Text = if done then "BOUGHT" elseif here then "BUY" else "AWAY"
			entry.Buy.BackgroundColor3 = if done or not here then C.Gray else C.Green
			entry.Available = here and not done
		end
	end

	ctx.panelOpened.Merchant = refreshMerchant

	-- 2x por segundo
	task.spawn(function()
		while true do
			task.wait(0.5)
			refreshTop()
			if frame.Visible then
				refreshMerchant()
			end
		end
	end)

	ctx.EffectEvent.OnClientEvent:Connect(function(kind)
		if kind == "Invasion" then
			ctx.play("Alarm")
			ctx.bigText("MONSTER INVASION!", Color3.fromRGB(200, 120, 255))
			Juice.Shake(0.6, 0.5)
		elseif kind == "InvasionWon" then
			ctx.play("Rare")
			ctx.bigText("MONSTERS DEFEATED!", C.Gold)
			Juice.Confetti(ctx.gui, 80)
		elseif kind == "GoalReached" then
			ctx.play("Shiny")
			ctx.bigText("COMMUNITY GOAL!", C.Gold)
			Juice.Confetti(ctx.gui, 120, { C.Gold, C.Green, C.White })
		end
	end)
	return frame
end

return EventsUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="479">
        <Properties>
          <string name="Name">ExploreUI</string>
          <string name="Source"><![CDATA[--[[
	ExploreUI (ModuleScript em StarterPlayer > StarterPlayerScripts)
	Parte 22 (v13): o que a exploração mostra na tela.
	  • faixa da ILHA SECRETA (quando está aberta: tempo que sobra e onde fica o portal)
	  • ovos da caça que VOCÊ já achou somem só na sua tela
	  • minigame de PESCA: a setinha anda; toque quando ela estiver no verde (3 vezes)
	  • botão RIDE (esquerda): Skateboard, Go-Kart e Critter Ride (destravam pelo nível)
	A tela só pede; o servidor (Explore.luau / Mounts.luau) confere tudo.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local UI = require(script.Parent:WaitForChild("UIKit"))
local Juice = require(script.Parent:WaitForChild("Juice"))

local ExploreUI = {}

local C = UI.Colors
local create, corner, label, button = UI.create, UI.corner, UI.label, UI.button

function ExploreUI.Init(ctx)
	local player = Players.LocalPlayer

	---------------------------------------------------------------------
	-- Faixa da ilha secreta (fica na pilha de faixas do EventsUI)
	---------------------------------------------------------------------
	-- v21: na coluna da esquerda (sem scaleNow: a coluna já tem a escala)
	local stack = ctx.leftStack or ctx.gui
	local W = ctx.stackWidth or 300
	local islandBar = create("Frame", {
		Name = "IslandBar",
		LayoutOrder = 50,
		Size = UDim2.fromOffset(W, 30),
		BackgroundColor3 = Color3.fromRGB(30, 140, 120),
		Visible = false,
		ZIndex = 30,
		Parent = stack,
	}, { corner(10), UI.border(C.White, 2) })
	local islandText = label({ Size = UDim2.new(1, -12, 1, -6), Position = UDim2.fromOffset(6, 3), Text = "", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 31, Parent = islandBar })

	---------------------------------------------------------------------
	-- Caça aos ovos: esconde os que você já achou (só na sua tela)
	---------------------------------------------------------------------
	local function refreshHunt()
		local folder = workspace:FindFirstChild("HuntEggs")
		if not folder then
			return
		end
		local found = {}
		for _, key in string.split(tostring(player:GetAttribute("HuntFound") or ""), ",") do
			if key ~= "" then
				found[key] = true
			end
		end
		for _, egg in folder:GetChildren() do
			if egg:IsA("BasePart") then
				local done = found[tostring(egg:GetAttribute("HuntIndex"))] == true
				egg.LocalTransparencyModifier = if done then 1 else 0
				for _, child in egg:GetChildren() do
					if child:IsA("ProximityPrompt") then
						child.Enabled = not done
					elseif child:IsA("Sparkles") then
						child.Enabled = not done
					end
				end
			end
		end
	end
	player:GetAttributeChangedSignal("HuntFound"):Connect(refreshHunt)
	task.spawn(function()
		local folder = workspace:WaitForChild("HuntEggs", 60)
		if folder then
			folder.ChildAdded:Connect(function()
				task.defer(refreshHunt)
			end)
			refreshHunt()
		end
	end)

	---------------------------------------------------------------------
	-- Pesca
	---------------------------------------------------------------------
	local fishing = create("Frame", {
		Name = "FishingPanel",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.fromOffset(420, 190),
		BackgroundColor3 = C.Panel,
		Visible = false,
		ZIndex = 20,
		Parent = ctx.gui,
	}, { corner(18), UI.border(C.Blue, 4) })
	ctx.scaleNow(fishing)
	local fishTitle = label({ Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -20, 0, 30), Text = "TAP when the hook is in the GREEN!", TextColor3 = C.Gold, ZIndex = 21, Parent = fishing })
	local track = create("Frame", { Position = UDim2.fromOffset(20, 50), Size = UDim2.new(1, -40, 0, 34), BackgroundColor3 = C.Dark, ZIndex = 21, Parent = fishing }, { corner(10) })
	local zone = create("Frame", { Size = UDim2.fromScale(0.2, 1), BackgroundColor3 = C.Green, ZIndex = 22, Parent = track }, { corner(10) })
	local hook = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(0, 8, 1, 10), BackgroundColor3 = C.White, ZIndex = 23, Parent = track }, { corner(4) })
	local fishScore = label({ Position = UDim2.fromOffset(10, 90), Size = UDim2.new(1, -20, 0, 24), Text = "", ZIndex = 21, Parent = fishing })
	local cast: any = nil
	local function finishCast()
		if not cast then
			return
		end
		local done = cast
		cast = nil
		fishing.Visible = false
		ctx.RequestEvent:FireServer("FishCatch", { Token = done.Token, Score = done.Hits })
	end
	local function newZone()
		if cast then
			cast.ZoneStart = 0.1 + math.random() * 0.65
			cast.Speed = 0.7 + math.random() * 0.5 + cast.Round * 0.15
			zone.Position = UDim2.fromScale(cast.ZoneStart, 0)
		end
	end
	local function tap()
		if not cast or os.clock() - cast.LastTap < 0.25 then
			return
		end
		cast.LastTap = os.clock()
		local x = cast.X
		if x >= cast.ZoneStart and x <= cast.ZoneStart + 0.2 then
			cast.Hits += 1
			ctx.play("Coin")
		else
			ctx.play("Error")
		end
		cast.Round += 1
		fishScore.Text = ("Catches: %d / 3"):format(cast.Hits)
		if cast.Round >= 3 then
			task.delay(0.3, finishCast)
		else
			newZone()
		end
	end
	button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(0.6, 0, 0, 56),
		BackgroundColor3 = C.Blue,
		ZIndex = 22,
		Parent = fishing,
	}, "TAP!", tap)
	UserInputService.InputBegan:Connect(function(input, processed)
		if cast and not processed and (input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA) then
			tap()
		end
	end)
	RunService.RenderStepped:Connect(function(dt)
		if not cast then
			return
		end
		cast.T += dt * cast.Speed
		cast.X = (math.sin(cast.T * math.pi) + 1) / 2
		hook.Position = UDim2.fromScale(cast.X, 0.5)
		if os.clock() - cast.Started > 15 then
			finishCast() -- demorou demais: manda o que tem
		end
	end)

	---------------------------------------------------------------------
	-- Montarias
	---------------------------------------------------------------------
	-- v21: o botão RIDE fica na coluna da esquerda; a lista de montarias abre à direita dele
	local rideButton = button({
		Name = "RideButton",
		LayoutOrder = 20,
		Size = UDim2.fromOffset(74, 38),
		BackgroundColor3 = C.Orange,
		ZIndex = 32,
		Parent = stack,
	}, "\u{1F6F9} RIDE", function() end)
	local picker = create("Frame", {
		Name = "RidePicker",
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(1, 8, 0, 0),
		Size = UDim2.fromOffset(4 * 114, 38),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 32,
		Parent = rideButton,
	}, { create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
	local options = {}
	for order, mount in Config.Mounts do
		local btn, text = button({ LayoutOrder = order, Size = UDim2.fromOffset(108, 38), BackgroundColor3 = C.Blue, ZIndex = 33, Parent = picker }, mount.Name, function()
			ctx.play("Click")
			picker.Visible = false
			ctx.RequestEvent:FireServer("Ride", mount.Id)
		end)
		options[mount.Id] = { Button = btn, Text = text, Mount = mount }
	end
	button({ LayoutOrder = 10, Size = UDim2.fromOffset(108, 38), BackgroundColor3 = C.Gray, ZIndex = 33, Parent = picker }, "WALK", function()
		ctx.play("Click")
		picker.Visible = false
		ctx.RequestEvent:FireServer("Ride", "off")
	end)
	rideButton.Activated:Connect(function()
		ctx.play("Click")
		picker.Visible = not picker.Visible
		local level = tonumber(player:GetAttribute("Level")) or 1
		for _, entry in options do
			local open = level >= entry.Mount.Level
			entry.Button.BackgroundColor3 = if open then C.Blue else C.Gray
			entry.Text.Text = if open then ("%s +%d%%"):format(entry.Mount.Name, math.floor((entry.Mount.Speed - 1) * 100 + 0.5)) else ("%s (Lv %d)"):format(entry.Mount.Name, entry.Mount.Level)
		end
	end)

	---------------------------------------------------------------------
	local function refreshIsland()
		local t = workspace:GetServerTimeNow()
		local open = workspace:GetAttribute("IslandOpen") == true
		islandBar.Visible = open and not player:GetAttribute("InMinigame")
		if open then
			local left = math.max(0, (tonumber(workspace:GetAttribute("IslandUntil")) or t) - t)
			islandText.Text = ("SECRET ISLAND OPEN! %s left - portal next to the Giant Egg"):format(Format.Time(left))
		end
	end
	task.spawn(function()
		while true do
			task.wait(0.5)
			refreshIsland()
		end
	end)

	ctx.EffectEvent.OnClientEvent:Connect(function(kind, data)
		if kind == "FishStart" and type(data) == "table" then
			cast = { Token = data.Token, Hits = 0, Round = 0, T = math.random() * 2, X = 0, Speed = 1, ZoneStart = 0.4, LastTap = 0, Started = os.clock() }
			newZone()
			fishScore.Text = "Catches: 0 / 3"
			fishTitle.Text = "TAP when the hook is in the GREEN!"
			fishing.Visible = true
			ctx.play("Click")
		elseif kind == "FishCaught" then
			ctx.play("Rare")
			Juice.Confetti(ctx.gui, 20 + (tonumber(data) or 1) * 15, { C.Blue, C.White, C.Gold })
		elseif kind == "Chest" then
			ctx.play("Rare")
			Juice.Confetti(ctx.gui, 60, { C.Gold, C.White })
			if typeof(data) == "Vector3" then
				ctx.floatingText(data + Vector3.new(0, 4, 0), "TREASURE!", C.Gold)
			end
		elseif kind == "HuntFound" and type(data) == "table" then
			ctx.play("Coin")
			ctx.bigText(("HUNT EGG %d/%d"):format(tonumber(data.Count) or 0, tonumber(workspace:GetAttribute("HuntCount")) or 10), Color3.fromRGB(255, 150, 200))
		elseif kind == "Dig" and typeof(data) == "Vector3" then
			ctx.play("Bonk")
			ctx.floatingText(data + Vector3.new(0, 2, 0), "DIG!", Color3.fromRGB(220, 190, 130))
		elseif kind == "IslandOpen" then
			ctx.play("Rare")
			ctx.bigText("SECRET ISLAND!", Color3.fromRGB(90, 255, 210))
		end
	end)
end

return ExploreUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="480">
        <Properties>
          <string name="Name">InventoryUI</string>
          <string name="Source"><![CDATA[--[[
	InventoryUI (ModuleScript em StarterPlayer > StarterPlayerScripts)
	Tela "CRITTERS": mochila + bichinhos da base, pets equipados, filtros e fusão.
	  • toque num card para escolher; os botões de baixo mudam conforme o card
	  • EQUIP BEST equipa os 3 melhores pets de uma vez
	  • FUSE: 5 iguais viram 1 Gold; 5 Gold viram 1 Rainbow (sempre pede confirmação)
	  • v9: estágio (bebê/adulto/gigante), SHINY e FEED ALL (comida para a base: +15% por 10 min)
	A tela só PEDE; o servidor (Pets.luau) confere tudo e manda a lista nova.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Critters = require(Shared:WaitForChild("Critters"))
local Format = require(Shared:WaitForChild("Format"))
local Builder = require(Shared:WaitForChild("CritterBuilder"))
local UI = require(script.Parent:WaitForChild("UIKit"))
local Juice = require(script.Parent:WaitForChild("Juice"))

local InventoryUI = {}

local C = UI.Colors
local create, corner, label, button = UI.create, UI.corner, UI.label, UI.button

type Entry = { Key: string, Where: string, K: string?, U: number?, Id: string, M: string?, B: number?, S: boolean?, Equipped: boolean }

local WHERE = { "All", "Backpack", "Base", "Pets" }
local SORTS = { "Best", "Rarity", "Name" }

local function entryName(entry): string
	local def = Critters.ById[entry.Id]
	return (if entry.S then "Shiny " else "") .. (if entry.M then entry.M .. " " else "") .. (if def then def.Name else "?")
end

-- Estágio de crescimento pela data de nascimento (B)
local function entryStage(entry)
	local born = tonumber(entry.B) or 0
	local _, stage = Config.GrowthStage(workspace:GetServerTimeNow() - born)
	return stage
end

-- Renda na base (com estágio e shiny; sem o bônus de carinho/comida, que é passageiro)
local function entryIncome(entry): number
	local def = Critters.ById[entry.Id]
	if not def then
		return 0
	end
	return def.Income * Config.IncomeMultiplier(entry.M) * (if entry.S then Config.ShinyIncome else 1) * entryStage(entry).Income
end

function InventoryUI.Init(ctx)
	local player = game:GetService("Players").LocalPlayer
	local frame, content = ctx.makePanel("Critters", "CRITTERS", C.Teal)
	content.Position = UDim2.fromOffset(16, 152)
	content.Size = UDim2.new(1, -32, 1, -152 - 92)
	create("UIGridLayout", {
		CellSize = UDim2.fromOffset(108, 140),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = content,
	})

	-- Topo: resumo + EQUIP BEST
	local info = label({
		Position = UDim2.fromOffset(18, 64),
		Size = UDim2.new(0.5, -18, 0, 34),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = frame,
	})
	button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 62),
		Size = UDim2.new(0.25, -12, 0, 40),
		BackgroundColor3 = C.Green,
		ZIndex = 6,
		Parent = frame,
	}, "EQUIP BEST", function()
		ctx.play("Click")
		ctx.RequestEvent:FireServer("PetEquipBest")
	end)
	local feedCost = 0
	local _, feedText = button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0.75, -8, 0, 62),
		Size = UDim2.new(0.25, -12, 0, 40),
		BackgroundColor3 = C.Orange,
		ZIndex = 6,
		Parent = frame,
	}, "FEED ALL", function()
		ctx.play("Click")
		local cost = feedCost
		UI.confirm(
			ctx.gui,
			"FEED ALL?",
			("Feed every critter in your base for %s?\nThey earn +%d%% cash for 10 minutes. (Petting them is free: press T next to a critter!)"):format(
				Format.Money(cost),
				math.floor(Config.FeedBonus * 100)
			),
			"FEED!",
			C.Green,
			function()
				ctx.RequestEvent:FireServer("FeedAll", cost)
			end,
			ctx.scaleNow
		)
	end)

	-- Filtros (tocar troca a opção)
	local filters = { Where = 1, Rarity = 1, World = 1, Sort = 1 }
	local rarityOptions = { "All" }
	for _, rarity in Config.Rarities do
		table.insert(rarityOptions, rarity.Name)
	end
	local worldOptions = { "All" }
	for _, world in Config.Worlds do
		table.insert(worldOptions, world.Id)
	end
	table.insert(worldOptions, "special") -- clima, noite e híbridos
	local filterRow = create("Frame", {
		Position = UDim2.fromOffset(16, 106),
		Size = UDim2.new(1, -32, 0, 40),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = frame,
	}, {
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local render: () -> ()
	local function filterButton(order: number, key: string, options: { string }, names: (string) -> string)
		local btnText
		local _, text = button({
			LayoutOrder = order,
			Size = UDim2.new(0.25, -6, 1, 0),
			BackgroundColor3 = C.Row,
			ZIndex = 6,
			Parent = filterRow,
		}, "", function()
			ctx.play("Click")
			filters[key] = filters[key] % #options + 1
			btnText.Text = names(options[filters[key]])
			render()
		end)
		btnText = text
		btnText.Text = names(options[1])
	end
	filterButton(1, "Where", WHERE, function(value)
		return "Show: " .. value
	end)
	filterButton(2, "Rarity", rarityOptions, function(value)
		return "Rarity: " .. value
	end)
	filterButton(3, "World", worldOptions, function(value)
		local world = Config.WorldById[value]
		return "World: " .. (if world then string.split(world.Name, " ")[1] elseif value == "special" then "Special" else "All")
	end)
	filterButton(4, "Sort", SORTS, function(value)
		return "Sort: " .. value
	end)

	-- Barra de baixo: o card escolhido e as ações
	local actionBar = create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -10),
		Size = UDim2.new(1, -24, 0, 76),
		BackgroundColor3 = C.Row,
		ZIndex = 6,
		Parent = frame,
	}, { corner(14) })
	local selectedText = label({
		Position = UDim2.fromOffset(10, 6),
		Size = UDim2.new(0.34, -10, 1, -12),
		Text = "Tap a critter",
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		StrokeThickness = 1.5,
		ZIndex = 6,
		Parent = actionBar,
	})
	local actionHolder = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.new(0.66, -8, 0, 56),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = actionBar,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local actionSlots = {}
	for i = 1, 4 do
		local slot: any = { Callback = nil }
		local btn, text = button({
			LayoutOrder = i,
			Size = UDim2.new(0.25, -5, 1, 0),
			BackgroundColor3 = C.Gray,
			Visible = false,
			ZIndex = 6,
			Parent = actionHolder,
		}, "", function()
			if slot.Callback then
				ctx.play("Click")
				slot.Callback()
			end
		end)
		slot.Button = btn
		slot.Text = text
		actionSlots[i] = slot
	end

	local emptyLabel = label({
		Position = UDim2.fromOffset(30, 200),
		Size = UDim2.new(1, -60, 0, 80),
		Text = "",
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(200, 210, 230),
		StrokeThickness = 1.5,
		Visible = false,
		ZIndex = 6,
		Parent = frame,
	})

	-- Estado vindo do servidor
	local state = { Items = {}, Equipped = {}, Base = {}, Max = Config.InventoryMax, EquipMax = Config.PetEquipMax, FeedCost = 0 }
	local entries: { [string]: Entry } = {}
	local cards: { [string]: any } = {}
	local templates: { [string]: Model } = {}
	local selected: string? = nil

	local function template(id: string, mutation: string?): Model
		local key = id .. ":" .. (mutation or "")
		local cached = templates[key]
		if cached then
			return cached
		end
		local def = Critters.ById[id]
		local model = Builder.Build(def)
		local aura = model:FindFirstChild("Aura")
		if aura then
			aura:Destroy()
		end
		if mutation then
			Builder.ApplyMutation(model, mutation)
		end
		templates[key] = model
		return model
	end

	local function sameCount(id: string, mutation: string?): number
		local count = 0
		for _, entry in entries do
			if entry.Id == id and entry.M == mutation and not entry.S then -- shiny não entra na fusão
				count += 1
			end
		end
		return count
	end

	local function makeCard(entry: Entry)
		local def = Critters.ById[entry.Id]
		local rarity = Config.RarityByName[def.Rarity]
		local card = create("Frame", { BackgroundColor3 = C.Row, ZIndex = 5, Parent = content }, { corner(12) })
		local stroke = create("UIStroke", { Color = rarity.Color, Thickness = 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = card })
		local viewport = create("ViewportFrame", {
			Size = UDim2.new(1, -8, 0, 70),
			Position = UDim2.fromOffset(4, 4),
			BackgroundTransparency = 1,
			Ambient = Color3.fromRGB(170, 170, 170),
			LightColor = C.White,
			LightDirection = Vector3.new(-0.4, -1, 0.6),
			ZIndex = 5,
			Parent = card,
		})
		local model = template(entry.Id, entry.M):Clone()
		model.Parent = viewport
		local boxCFrame, boxSize = model:GetBoundingBox()
		local radius = boxSize.Magnitude / 2
		local camera = Instance.new("Camera")
		camera.FieldOfView = 40
		camera.CFrame = CFrame.lookAt(boxCFrame.Position + Vector3.new(radius * 0.8, radius * 0.6, -radius * 2.2), boxCFrame.Position)
		camera.Parent = viewport
		viewport.CurrentCamera = camera

		label({ Position = UDim2.fromOffset(4, 76), Size = UDim2.new(1, -8, 0, 20), Text = def.Name, ZIndex = 5, Parent = card })
		local mutationInfo = entry.M and Config.MutationByName[entry.M]
		label({
			Position = UDim2.fromOffset(4, 96),
			Size = UDim2.new(1, -8, 0, 16),
			Text = (if entry.S then "SHINY " else "") .. string.upper(if entry.M then entry.M else def.Rarity),
			TextColor3 = if entry.S then C.Gold elseif mutationInfo then mutationInfo.Color else rarity.Color,
			ZIndex = 5,
			Parent = card,
		})
		local incomeLabel = label({
			Position = UDim2.fromOffset(4, 114),
			Size = UDim2.new(1, -8, 0, 18),
			Text = "",
			TextColor3 = Color3.fromRGB(140, 255, 140),
			StrokeThickness = 1,
			ZIndex = 5,
			Parent = card,
		})
		-- estágio (canto de cima, à direita): BABY / GIANT
		local stageLabel = label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -4, 0, 4),
			Size = UDim2.fromOffset(50, 18),
			Text = "",
			TextColor3 = Color3.fromRGB(255, 220, 150),
			StrokeThickness = 1.5,
			ZIndex = 6,
			Parent = card,
		})
		local badge = create("Frame", {
			Position = UDim2.fromOffset(4, 4),
			Size = UDim2.fromOffset(46, 20),
			BackgroundColor3 = C.Blue,
			ZIndex = 6,
			Parent = card,
		}, { corner(8) })
		local badgeText = label({ Size = UDim2.new(1, -4, 1, -2), Position = UDim2.fromOffset(2, 1), Text = "", StrokeThickness = 1, ZIndex = 6, Parent = badge })
		local tap = create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 7, Parent = card })
		tap.Activated:Connect(function()
			ctx.play("Click")
			selected = entry.Key
			render()
		end)
		cards[entry.Key] = { Frame = card, Stroke = stroke, Rarity = rarity.Color, Badge = badge, BadgeText = badgeText, Income = incomeLabel, Stage = stageLabel }
	end

	local function setAction(i: number, text: string?, color: Color3?, callback: (() -> ())?)
		local slot = actionSlots[i]
		slot.Button.Visible = text ~= nil
		slot.Text.Text = text or ""
		slot.Button.BackgroundColor3 = color or C.Gray
		slot.Callback = callback
	end

	local function fuseAction(i: number, entry: Entry)
		local def = Critters.ById[entry.Id]
		local result = Config.FuseResult(entry.M)
		local count = sameCount(entry.Id, entry.M)
		if entry.S then
			setAction(i, "SHINY", C.Gray, function()
				ctx.toast("Shiny critters are too special to fuse!", "info")
			end)
			return
		end
		if not result then
			setAction(i, "MAX FUSE", C.Gray, function()
				ctx.toast("This critter can't be fused any further.", "info")
			end)
			return
		end
		local need = Config.FuseCount
		setAction(i, ("FUSE %d/%d"):format(math.min(count, need), need), if count >= need then C.Purple else C.Gray, function()
			if count < need then
				ctx.toast(("Get %d of the same %s to fuse them into a %s one!"):format(need, entryName(entry), string.upper(result)), "info")
				return
			end
			UI.confirm(
				ctx.gui,
				"FUSE?",
				("Fuse %d %s into 1 %s %s?\nIt makes x%d cash. The %d critters will be used up (backpack first)."):format(
					need,
					entryName(entry),
					string.upper(result),
					def.Name,
					Config.IncomeMultiplier(result),
					need
				),
				"FUSE!",
				C.Purple,
				function()
					ctx.RequestEvent:FireServer("PetFuse", { Id = entry.Id, M = entry.M or "" })
				end,
				ctx.scaleNow
			)
		end)
	end

	local function refreshActions()
		local entry = selected and entries[selected]
		if not entry then
			selected = nil
			selectedText.Text = "Tap a critter to see what you can do."
			for i = 1, 4 do
				setAction(i, nil)
			end
			return
		end
		local def = Critters.ById[entry.Id]
		local bonus = Config.PetBonusOf(def.Rarity, entry.M)
		selectedText.Text = ("%s (%s)\n%s/s  |  pet +%g%%"):format(entryName(entry), entryStage(entry).Name, Format.Money(entryIncome(entry)), math.floor(bonus * 1000 + 0.5) / 10)
		if entry.Where == "bag" then
			local key = entry.K :: string
			if entry.Equipped then
				setAction(1, "UNEQUIP", C.Gray, function()
					ctx.RequestEvent:FireServer("PetUnequip", key)
				end)
			else
				setAction(1, "EQUIP", C.Green, function()
					ctx.RequestEvent:FireServer("PetEquip", key)
				end)
			end
			setAction(2, "PLACE", C.Blue, function()
				ctx.RequestEvent:FireServer("PetPlace", key)
			end)
			fuseAction(3, entry)
			local price = math.floor(def.Price * Config.PriceMultiplier(entry.M) * (if entry.S then Config.ShinyIncome else 1) * Config.CritterSellRefund)
			setAction(4, "SELL " .. Format.Money(price), C.Red, function()
				UI.confirm(ctx.gui, "SELL?", ("Sell %s for %s?\nYou can't undo this."):format(entryName(entry), Format.Money(price)), "SELL", C.Red, function()
					ctx.RequestEvent:FireServer("PetSell", key)
				end, ctx.scaleNow)
			end)
		else
			local uid = entry.U :: number
			setAction(1, "PICK UP", C.Teal, function()
				ctx.RequestEvent:FireServer("PetStore", uid)
			end)
			fuseAction(2, entry)
			setAction(3, nil)
			setAction(4, nil)
		end
	end

	local function passes(entry: Entry): boolean
		local def = Critters.ById[entry.Id]
		local where = WHERE[filters.Where]
		local wanted = ({ Backpack = "bag", Base = "base" } :: { [string]: string })[where]
		if wanted and entry.Where ~= wanted then
			return false
		end
		if where == "Pets" and not entry.Equipped then
			return false
		end
		local rarity = rarityOptions[filters.Rarity]
		if rarity ~= "All" and def.Rarity ~= rarity then
			return false
		end
		local world = worldOptions[filters.World]
		if world ~= "All" and Config.IndexTabOf(def.World) ~= world then
			return false
		end
		return true
	end

	render = function()
		-- junta mochila + base
		local equippedSet = {}
		for _, key in state.Equipped do
			equippedSet[key] = true
		end
		local fresh: { [string]: Entry } = {}
		for _, item in state.Items do
			local key = "bag:" .. item.K
			fresh[key] = { Key = key, Where = "bag", K = item.K, Id = item.Id, M = item.M, B = item.B, S = item.S == true, Equipped = equippedSet[item.K] == true }
		end
		for _, item in state.Base do
			local key = "base:" .. item.U
			fresh[key] = { Key = key, Where = "base", U = item.U, Id = item.Id, M = item.M, B = item.B, S = item.Sh == true, Equipped = false }
		end
		entries = fresh
		for key, card in cards do
			if not fresh[key] then
				card.Frame:Destroy()
				cards[key] = nil
			end
		end
		if not frame.Visible then
			return -- os cards só são montados com a tela aberta (mais leve no celular)
		end

		local list = {}
		for key, entry in fresh do
			if passes(entry) then
				table.insert(list, entry)
			elseif cards[key] then
				cards[key].Frame.Visible = false
			end
		end
		local sort = SORTS[filters.Sort]
		table.sort(list, function(a, b)
			if a.Equipped ~= b.Equipped then
				return a.Equipped
			end
			local da, db = Critters.ById[a.Id], Critters.ById[b.Id]
			if sort == "Rarity" and da.Rarity ~= db.Rarity then
				return Config.RarityIndex[da.Rarity] > Config.RarityIndex[db.Rarity]
			elseif sort == "Name" and da.Name ~= db.Name then
				return da.Name < db.Name
			end
			local ia, ib = entryIncome(a), entryIncome(b)
			if ia ~= ib then
				return ia > ib
			end
			return a.Key < b.Key
		end)
		for order, entry in list do
			if not cards[entry.Key] then
				makeCard(entry)
			end
			local card = cards[entry.Key]
			card.Frame.Visible = true
			card.Frame.LayoutOrder = order
			local stage = entryStage(entry)
			card.Stage.Text = if stage.Name == "Adult" then "" else string.upper(stage.Name)
			card.Income.Text = Format.Money(entryIncome(entry)) .. "/s"
			if entry.Equipped then
				card.Badge.Visible = true
				card.Badge.BackgroundColor3 = C.Green
				card.BadgeText.Text = "PET"
			elseif entry.Where == "base" then
				card.Badge.Visible = true
				card.Badge.BackgroundColor3 = C.Blue
				card.BadgeText.Text = "BASE"
			else
				card.Badge.Visible = false
			end
			local isSelected = entry.Key == selected
			card.Stroke.Color = if isSelected then C.Gold else card.Rarity
			card.Stroke.Thickness = if isSelected then 5 else 3
		end

		local bonus = tonumber(player:GetAttribute("PetBonus")) or 0
		info.Text = ("Backpack %d/%d  |  Pets %d/%d  |  +%d%% cash"):format(#state.Items, state.Max, #state.Equipped, state.EquipMax, math.floor(bonus * 100 + 0.5))
		feedCost = tonumber(state.FeedCost) or 0
		feedText.Text = "FEED " .. Format.Money(feedCost)
		emptyLabel.Visible = #list == 0
		if #list == 0 then
			emptyLabel.Text = if next(fresh) == nil
				then "No critters yet! Hatch eggs, then press PICK UP (R) on a critter in your base to put it in your backpack."
				else "Nothing here with these filters."
		end
		refreshActions()
	end

	ctx.InventoryEvent.OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" then
			return
		end
		state = {
			Items = if type(payload.Items) == "table" then payload.Items else {},
			Equipped = if type(payload.Equipped) == "table" then payload.Equipped else {},
			Base = if type(payload.Base) == "table" then payload.Base else {},
			Max = tonumber(payload.Max) or Config.InventoryMax,
			EquipMax = tonumber(payload.EquipMax) or Config.PetEquipMax,
			FeedCost = tonumber(payload.FeedCost) or 0,
		}
		render()
	end)
	player:GetAttributeChangedSignal("PetBonus"):Connect(function()
		if frame.Visible then
			render()
		end
	end)

	-- Fusão deu certo: festa na tela
	ctx.EffectEvent.OnClientEvent:Connect(function(kind, data)
		if kind ~= "Fused" or type(data) ~= "table" then
			return
		end
		ctx.play("Rare")
		Juice.Confetti(ctx.gui, 90)
		Juice.Shake(0.5, 0.5)
	end)

	ctx.panelOpened.Critters = function()
		ctx.RequestEvent:FireServer("InventorySync")
		render()
	end
end

return InventoryUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="481">
        <Properties>
          <string name="Name">Juice</string>
          <string name="Source"><![CDATA[--[[
	Juice (ModuleScript em StarterPlayer > StarterPlayerScripts)
	Efeitos que deixam o jogo "gostoso" (tudo só na tela do jogador, sem pesar o servidor):
	  • Juice.Shake(força, duração)  - tremor de câmera
	  • Juice.Confetti(gui, quantidade) - chuva de confete na tela
	  • Juice.MoneyPop(parte, texto, cor) - "+$120" pulando de cima de um bichinho
	As animações usam TweenService.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Juice = {}

---------------------------------------------------------------------
-- Tremor de câmera: a força cai até zero (tween) e somamos um deslocamento na câmera a cada quadro
---------------------------------------------------------------------
local shakePower = Instance.new("NumberValue")
shakePower.Value = 0
local shakeBound = false

function Juice.Shake(power: number?, duration: number?)
	if Players.LocalPlayer and Players.LocalPlayer:GetAttribute("CameraShake") == false then
		return -- desligado em SETTINGS
	end
	shakePower.Value = math.max(shakePower.Value, power or 0.6)
	TweenService:Create(shakePower, TweenInfo.new(duration or 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = 0 }):Play()
	if shakeBound then
		return
	end
	shakeBound = true
	RunService:BindToRenderStep("JuiceShake", Enum.RenderPriority.Camera.Value + 1, function()
		local camera = workspace.CurrentCamera
		local p = shakePower.Value
		if not camera then
			return
		end
		if p <= 0.001 then
			RunService:UnbindFromRenderStep("JuiceShake")
			shakeBound = false
			return
		end
		local t = os.clock() * 40
		local offset = Vector3.new(math.noise(t, 0, 1), math.noise(0, t, 2), 0) * p
		camera.CFrame = camera.CFrame * CFrame.new(offset) * CFrame.Angles(0, 0, math.noise(t, t, 3) * p * 0.03)
	end)
end

---------------------------------------------------------------------
-- Confete
---------------------------------------------------------------------
local CONFETTI_COLORS = {
	Color3.fromRGB(255, 90, 120),
	Color3.fromRGB(255, 210, 60),
	Color3.fromRGB(90, 220, 120),
	Color3.fromRGB(80, 170, 255),
	Color3.fromRGB(190, 120, 255),
	Color3.fromRGB(255, 150, 60),
}

function Juice.Confetti(gui: Instance, count: number?, colors: { Color3 }?)
	local palette = colors or CONFETTI_COLORS
	local total = count or 70
	if Players.LocalPlayer and Players.LocalPlayer:GetAttribute("LowGfx") then
		total = math.floor(total / 3) -- gráficos leves: menos confete
	end
	for _ = 1, total do
		local piece = Instance.new("Frame")
		piece.BorderSizePixel = 0
		piece.BackgroundColor3 = palette[math.random(1, #palette)]
		piece.Size = UDim2.fromOffset(math.random(7, 12), math.random(12, 20))
		piece.AnchorPoint = Vector2.new(0.5, 0.5)
		piece.Position = UDim2.new(math.random(), 0, 0, -20 - math.random(0, 200))
		piece.Rotation = math.random(0, 360)
		piece.ZIndex = 50
		piece.Parent = gui
		local duration = 1.6 + math.random() * 1.2
		local tween = TweenService:Create(piece, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.25, 0, 1.1, 0),
			Rotation = piece.Rotation + math.random(-540, 540),
			BackgroundTransparency = 0.3,
		})
		tween.Completed:Connect(function()
			piece:Destroy()
		end)
		tween:Play()
	end
end

---------------------------------------------------------------------
-- Número de dinheiro saindo de cima de um bichinho
---------------------------------------------------------------------
function Juice.MoneyPop(adornee: BasePart, text: string, color: Color3?, height: number?)
	local gui = Instance.new("BillboardGui")
	gui.Adornee = adornee
	gui.Size = UDim2.fromOffset(120, 34)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height or 3, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 70
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color or Color3.fromRGB(120, 255, 120)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(15, 60, 20)
	stroke.Parent = label
	label.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Scale = 0.4
	scale.Parent = label
	gui.Parent = adornee
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	local rise = TweenService:Create(gui, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		StudsOffsetWorldSpace = Vector3.new(0, (height or 3) + 3.5, 0),
	})
	TweenService:Create(label, TweenInfo.new(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.6), { TextTransparency = 1 }):Play()
	TweenService:Create(stroke, TweenInfo.new(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.6), { Transparency = 1 }):Play()
	rise.Completed:Connect(function()
		gui:Destroy()
	end)
	rise:Play()
end

return Juice
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="482">
        <Properties>
          <string name="Name">LabUI</string>
          <string name="Source"><![CDATA[--[[
	LabUI (ModuleScript em StarterPlayer > StarterPlayerScripts)
	Parte 21: MIX LAB (laboratório atrás das bases). Junte 2 bichinhos da mochila e crie um HÍBRIDO!
	  • toque em 2 bichinhos da lista; se a dupla tem receita, o botão MIX acende
	  • receita que você ainda não descobriu aparece como "???" (surpresa!)
	  • dupla sem receita: nada é gasto
	  • RECIPES mostra o livro de receitas (descobertas + dicas das que faltam)
	Tudo é conferido no servidor (Pets.Mix).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Critters = require(Shared:WaitForChild("Critters"))
local Hybrids = require(Shared:WaitForChild("Hybrids"))
local UI = require(script.Parent:WaitForChild("UIKit"))
local Juice = require(script.Parent:WaitForChild("Juice"))

local LabUI = {}

local C = UI.Colors
local create, corner, label, button = UI.create, UI.corner, UI.label, UI.button

type Item = { K: string, Id: string, M: string?, B: number?, S: boolean? }

local function itemName(item: Item): string
	local def = Critters.ById[item.Id]
	return (if item.S then "Shiny " else "") .. (if item.M then item.M .. " " else "") .. (if def then def.Name else "?")
end

function LabUI.Init(ctx)
	local frame, content = ctx.makePanel("Lab", "MIX LAB", C.Teal)
	content.Position = UDim2.fromOffset(16, 200)
	content.Size = UDim2.new(1, -32, 1, -212)
	local grid = create("UIGridLayout", {
		CellSize = UDim2.fromOffset(142, 54),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = content,
	})

	local items: { Item } = {}
	local known: { [string]: boolean } = {}
	local pickA: string? = nil
	local pickB: string? = nil
	local showRecipes = false

	local function box(x: number, width: number, text: string): (Frame, TextLabel)
		local holder = create("Frame", {
			Position = UDim2.fromOffset(x, 68),
			Size = UDim2.fromOffset(width, 66),
			BackgroundColor3 = C.Row,
			ZIndex = 6,
			Parent = frame,
		}, { corner(14), UI.border(C.Teal, 2) })
		local textLabel = label({ Size = UDim2.new(1, -12, 1, -10), Position = UDim2.fromOffset(6, 5), Text = text, TextWrapped = true, ZIndex = 6, Parent = holder })
		return holder, textLabel
	end
	local slotA, slotAText = box(16, 176, "Pick critter 1")
	label({ Position = UDim2.fromOffset(194, 68), Size = UDim2.fromOffset(34, 66), Text = "+", TextColor3 = C.Gold, ZIndex = 6, Parent = frame })
	local slotB, slotBText = box(230, 176, "Pick critter 2")
	label({ Position = UDim2.fromOffset(408, 68), Size = UDim2.fromOffset(28, 66), Text = "=", TextColor3 = C.Gold, ZIndex = 6, Parent = frame })
	local _, resultText = box(438, 186, "?")

	local render: () -> ()
	local mixButton, mixText = button({
		Position = UDim2.fromOffset(16, 142),
		Size = UDim2.fromOffset(300, 48),
		BackgroundColor3 = C.Gray,
		ZIndex = 6,
		Parent = frame,
	}, "MIX!", function()
		local a = pickA
		local b = pickB
		if not a or not b then
			ctx.toast("Pick 2 critters from your backpack first!", "info")
			return
		end
		ctx.play("Click")
		ctx.RequestEvent:FireServer("Mix", { A = a, B = b })
	end)
	local _, recipesText = button({
		Position = UDim2.fromOffset(324, 142),
		Size = UDim2.fromOffset(300, 48),
		BackgroundColor3 = C.Purple,
		ZIndex = 6,
		Parent = frame,
	}, "RECIPES", function()
		ctx.play("Click")
		showRecipes = not showRecipes
		render()
	end)

	local function find(key: string?): Item?
		if not key then
			return nil
		end
		for _, item in items do
			if item.K == key then
				return item
			end
		end
		return nil
	end

	local function clearList()
		for _, child in content:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end

	local function renderRecipes()
		grid.CellSize = UDim2.new(1, -8, 0, 54)
		local count = 0
		for order, recipe in Hybrids.Recipes do
			local result = Critters.ById[recipe.Result]
			local a, b = Critters.ById[recipe.A], Critters.ById[recipe.B]
			local found = known[recipe.Result] == true
			if found then
				count += 1
			end
			local row = create("Frame", { LayoutOrder = order, BackgroundColor3 = C.Row, ZIndex = 5, Parent = content }, { corner(12) })
			local rarity = result and Config.RarityByName[result.Rarity]
			label({
				Size = UDim2.new(1, -16, 1, -8),
				Position = UDim2.fromOffset(8, 4),
				Text = if found and a and b and result
					then ("%s + %s = %s"):format(a.Name, b.Name, result.Name)
					else "??? + ??? = ???   HINT: " .. recipe.Hint,
				TextColor3 = if found and rarity then rarity.Color else Color3.fromRGB(200, 210, 230),
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				StrokeThickness = 1.5,
				ZIndex = 5,
				Parent = row,
			})
		end
		recipesText.Text = ("BACK  (%d/%d found)"):format(count, #Hybrids.Recipes)
	end

	local function renderItems()
		grid.CellSize = UDim2.fromOffset(142, 54)
		local count = 0
		for _ in known do
			count += 1
		end
		recipesText.Text = ("RECIPES %d/%d"):format(count, #Hybrids.Recipes)
		local list = table.clone(items)
		table.sort(list, function(x, y)
			local dx, dy = Critters.ById[x.Id], Critters.ById[y.Id]
			if dx.Name ~= dy.Name then
				return dx.Name < dy.Name
			end
			return x.K < y.K
		end)
		for order, item in list do
			local def = Critters.ById[item.Id]
			local rarity = Config.RarityByName[def.Rarity]
			local picked = item.K == pickA or item.K == pickB
			local cell = create("Frame", {
				LayoutOrder = order,
				BackgroundColor3 = if picked then C.Teal else C.Row,
				ZIndex = 5,
				Parent = content,
			}, { corner(12), UI.border(rarity.Color, 2) })
			label({
				Size = UDim2.new(1, -8, 1, -6),
				Position = UDim2.fromOffset(4, 3),
				Text = itemName(item) .. (if item.S then "\n(can't mix)" else "\n" .. def.Rarity),
				TextWrapped = true,
				TextColor3 = if item.S then C.Gold else C.White,
				StrokeThickness = 1.5,
				ZIndex = 5,
				Parent = cell,
			})
			local tap = create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 6, Parent = cell })
			tap.Activated:Connect(function()
				ctx.play("Click")
				if item.S then
					ctx.toast("Shiny critters are too special to mix!", "info")
					return
				end
				if pickA == item.K then
					pickA = nil
				elseif pickB == item.K then
					pickB = nil
				elseif not pickA then
					pickA = item.K
				else
					pickB = item.K
				end
				render()
			end)
		end
		if #list == 0 then
			local empty = create("Frame", { LayoutOrder = 1, BackgroundTransparency = 1, ZIndex = 5, Parent = content })
			label({ Size = UDim2.fromScale(1, 1), Text = "Your backpack is empty! Put critters in it (PICK UP)", TextWrapped = true, ZIndex = 5, Parent = empty })
			grid.CellSize = UDim2.new(1, -8, 0, 70)
		end
	end

	render = function()
		local a, b = find(pickA), find(pickB)
		pickA = if a then pickA else nil
		pickB = if b then pickB else nil
		slotAText.Text = if a then itemName(a) else "Pick critter 1"
		slotBText.Text = if b then itemName(b) else "Pick critter 2"
		local recipe = if a and b then Hybrids.Find(a.Id, b.Id) else nil
		if recipe then
			local result = Critters.ById[recipe.Result]
			resultText.Text = if known[recipe.Result] and result then result.Name else "??? (new!)"
			resultText.TextColor3 = C.Gold
			mixButton.BackgroundColor3 = C.Green
			mixText.Text = "MIX!"
		elseif a and b then
			resultText.Text = "These don't mix"
			resultText.TextColor3 = Color3.fromRGB(255, 150, 150)
			mixButton.BackgroundColor3 = C.Gray
			mixText.Text = "TRY ANOTHER PAIR"
		else
			resultText.Text = "?"
			resultText.TextColor3 = C.White
			mixButton.BackgroundColor3 = C.Gray
			mixText.Text = "MIX!"
		end
		if not frame.Visible then
			return
		end
		clearList()
		if showRecipes then
			renderRecipes()
		else
			renderItems()
		end
	end

	ctx.InventoryEvent.OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" then
			return
		end
		items = {}
		if type(payload.Items) == "table" then
			for _, item in payload.Items do
				if type(item) == "table" and type(item.K) == "string" and Critters.ById[item.Id] then
					table.insert(items, item)
				end
			end
		end
		known = {}
		if type(payload.Recipes) == "table" then
			for _, id in payload.Recipes do
				known[id] = true
			end
		end
		render()
	end)

	ctx.EffectEvent.OnClientEvent:Connect(function(kind, data)
		if kind == "Mixed" and type(data) == "table" then
			local def = Critters.ById[tostring(data.Critter)]
			pickA, pickB = nil, nil
			ctx.play("Rare")
			ctx.flash(C.Teal, 0.7)
			ctx.bigText(if data.New then "NEW HYBRID!" else "MIXED!", C.Gold)
			Juice.Confetti(ctx.gui, 100, { C.Teal, C.Gold, C.White })
			Juice.Shake(0.5, 0.5)
			if def then
				ctx.toast(("You made %s%s! It's in your backpack."):format(if data.Mutation then data.Mutation .. " " else "", def.Name), "rare")
			end
		elseif kind == "MixFail" then
			ctx.play("Error")
			UI.shake(slotA)
			UI.shake(slotB)
		end
	end)

	ctx.panelOpened.Lab = function()
		ctx.RequestEvent:FireServer("InventorySync")
		render()
	end
	return frame
end

return LabUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="483">
        <Properties>
          <string name="Name">MeUI</string>
          <string name="Source"><![CDATA[--[[
	MeUI (ModuleScript em StarterPlayer > StarterPlayerScripts)
	Parte 26 (v10): botão "QUESTS" no menu, com 3 abas:
	  • QUESTS: as 3 missões do dia (1 troca grátis) + bônus por completar as 3
	  • SKILLS: nível, pontos, árvore de habilidades (reset grátis 1x por dia) e a classe
	  • PROFILE: prestígio, recordes pessoais e conquistas
	A tela só PEDE; o servidor (Progress.luau) confere tudo e manda a lista nova ("ProgressSync").
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared:WaitForChild("Format"))
local Progression = require(Shared:WaitForChild("Progression"))
local UI = require(script.Parent:WaitForChild("UIKit"))
local Juice = require(script.Parent:WaitForChild("Juice"))

local MeUI = {}

local C = UI.Colors
local create, corner, label, button = UI.create, UI.corner, UI.label, UI.button

local TABS = { "QUESTS", "SKILLS", "PROFILE" }

local function hoursText(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	if hours > 0 then
		return ("%dh %02dm"):format(hours, minutes)
	end
	return ("%dm"):format(math.max(minutes, 1))
end

function MeUI.Init(ctx)
	local frame, content = ctx.makePanel("Me", "QUESTS", C.Orange)
	content.Position = UDim2.fromOffset(16, 116)
	content.Size = UDim2.new(1, -32, 1, -128)
	create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = content })

	local state: any = nil
	local receivedAt = os.clock()
	local tab = "QUESTS"
	local render: () -> ()

	-- abas
	local tabBar = create("Frame", {
		Position = UDim2.fromOffset(16, 64),
		Size = UDim2.new(1, -32, 0, 44),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = frame,
	}, {
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local tabButtons = {}
	for order, name in TABS do
		local btn = button({ LayoutOrder = order, Size = UDim2.new(1 / 3, -6, 1, 0), BackgroundColor3 = C.Row, ZIndex = 6, Parent = tabBar }, name, function()
			ctx.play("Click")
			tab = name
			render()
		end)
		tabButtons[name] = btn
	end

	-- botão no menu (com bolinha vermelha quando tem ponto de habilidade para gastar)
	local menuButton = ctx.menuButton(-1, "\u{1F4DC}", "QUESTS", C.Orange, function()
		ctx.openPanel("Me")
	end)
	local dot = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -8, 0, 8),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = C.Red,
		Visible = false,
		ZIndex = 8,
		Parent = menuButton,
	}, { corner(9), UI.border(C.White, 2) })

	local function clear()
		for _, child in content:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end

	local function row(order: number, height: number, color: Color3?): Frame
		return create("Frame", {
			LayoutOrder = order,
			Size = UDim2.new(1, -12, 0, height),
			BackgroundColor3 = color or C.Row,
			ZIndex = 5,
			Parent = content,
		}, { corner(12) })
	end

	local function text(parent: Instance, props: { [string]: any }): TextLabel
		props.ZIndex = props.ZIndex or 5
		props.Parent = parent
		props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
		return label(props)
	end

	local function bar(parent: Instance, position: UDim2, size: UDim2, fraction: number, color: Color3, caption: string)
		local back = create("Frame", { Position = position, Size = size, BackgroundColor3 = C.Dark, ZIndex = 5, Parent = parent }, { corner(8) })
		create("Frame", { Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1), BackgroundColor3 = color, ZIndex = 5, Parent = back }, { corner(8) })
		label({ Size = UDim2.fromScale(1, 1), Text = caption, StrokeThickness = 1.5, ZIndex = 6, Parent = back })
	end

	---------------------------------------------------------------------
	-- QUESTS
	---------------------------------------------------------------------
	local timerLabel: TextLabel? = nil
	local function renderQuests()
		local header = row(0, 40, C.Panel)
		timerLabel = text(header, {
			Position = UDim2.fromOffset(10, 4),
			Size = UDim2.new(1, -20, 1, -8),
			Text = "",
			TextColor3 = Color3.fromRGB(200, 215, 240),
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		for index, mission in state.Missions do
			local box = row(index, 84, if mission.Done then Color3.fromRGB(45, 95, 60) else C.Row)
			text(box, {
				Position = UDim2.fromOffset(12, 6),
				Size = UDim2.new(0.7, -12, 0, 30),
				Text = Progression.MissionText(mission.Kind, mission.Need),
			})
			bar(box, UDim2.fromOffset(12, 42), UDim2.new(0.7, -12, 0, 26), mission.Have / math.max(mission.Need, 1), C.Gold, ("%d / %d"):format(mission.Have, mission.Need))
			if mission.Done then
				text(box, {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -12, 0.5, 0),
					Size = UDim2.new(0.28, -12, 0, 40),
					Text = "DONE \u{2714}",
					TextColor3 = Color3.fromRGB(140, 255, 150),
					TextXAlignment = Enum.TextXAlignment.Center,
				})
			elseif not state.Swapped then
				button({
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -12, 0.5, 0),
					Size = UDim2.new(0.28, -12, 0, 48),
					BackgroundColor3 = C.Blue,
					ZIndex = 6,
					Parent = box,
				}, "SWAP (free)", function()
					ctx.play("Click")
					UI.confirm(ctx.gui, "SWAP QUEST?", "Get a different quest instead of this one?\nYou can swap 1 quest per day.", "SWAP", C.Blue, function()
						ctx.RequestEvent:FireServer("QuestSwap", index)
					end, ctx.scaleNow)
				end)
			else
				text(box, {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -12, 0.5, 0),
					Size = UDim2.new(0.28, -12, 0, 40),
					Text = "Reward: 5 min of cash",
					TextColor3 = Color3.fromRGB(255, 230, 120),
					TextWrapped = true,
					TextXAlignment = Enum.TextXAlignment.Center,
				})
			end
		end
		-- caça aos ovos do dia (v13)
		local huntFound = 0
		for _, key in string.split(tostring(Players.LocalPlayer:GetAttribute("HuntFound") or ""), ",") do
			if key ~= "" then
				huntFound += 1
			end
		end
		local huntTotal = tonumber(workspace:GetAttribute("HuntCount")) or 10
		local hunt = row(9, 44, if huntFound >= huntTotal then Color3.fromRGB(45, 95, 60) else C.Panel)
		text(hunt, {
			Position = UDim2.fromOffset(12, 4),
			Size = UDim2.new(1, -24, 1, -8),
			Text = ("EGG HUNT: %d/%d hidden eggs found in Meadow today (all 10 = FREE big egg!)"):format(huntFound, huntTotal),
			TextColor3 = Color3.fromRGB(255, 170, 210),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		local bonus = row(10, 60, if state.Bonus then Color3.fromRGB(45, 95, 60) else C.Panel)
		text(bonus, {
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(1, -24, 1, -12),
			Text = if state.Bonus
				then "ALL 3 DONE! You got a FREE egg. Come back tomorrow for new quests!"
				else "Finish all 3: a FREE egg from your best world + 60 pass XP. Each quest: 5 minutes of your cash.",
			TextColor3 = C.Gold,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
	end

	---------------------------------------------------------------------
	-- SKILLS
	---------------------------------------------------------------------
	local function renderSkills()
		local top = row(0, 70, C.Panel)
		text(top, { Position = UDim2.fromOffset(12, 4), Size = UDim2.new(0.5, -12, 0, 30), Text = ("LEVEL %d"):format(state.Level), TextColor3 = C.Gold })
		text(top, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 4),
			Size = UDim2.new(0.5, -12, 0, 30),
			Text = ("Skill points: %d"):format(state.Points),
			TextColor3 = if state.Points > 0 then Color3.fromRGB(140, 255, 150) else C.White,
			TextXAlignment = Enum.TextXAlignment.Right,
		})
		bar(top, UDim2.fromOffset(12, 38), UDim2.new(1, -24, 0, 24), state.XPInto / math.max(state.XPNeed, 1), C.Purple, ("XP %d / %d  (play, hatch, steal...)"):format(state.XPInto, state.XPNeed))
		for order, name in Progression.SkillOrder do
			local info = Progression.Skills[name]
			local value = state.Skills[name] or 0
			local box = row(order, 72)
			text(box, { Position = UDim2.fromOffset(12, 4), Size = UDim2.new(0.62, -12, 0, 28), Text = ("%s  %s"):format(info.Name, string.rep("\u{25A0}", value) .. string.rep("\u{25A1}", info.Max - value)) })
			text(box, {
				Position = UDim2.fromOffset(12, 32),
				Size = UDim2.new(0.66, -12, 0, 34),
				Text = info.Desc,
				TextColor3 = Color3.fromRGB(200, 215, 240),
				TextWrapped = true,
				StrokeThickness = 1,
			})
			local can = value < info.Max and state.Points > 0
			button({
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -12, 0.5, 0),
				Size = UDim2.new(0.28, -12, 0, 46),
				BackgroundColor3 = if can then C.Green else C.Gray,
				ZIndex = 6,
				Parent = box,
			}, if value >= info.Max then "MAX" else "+1", function()
				if not can then
					ctx.toast(if value >= info.Max then info.Name .. " is MAX!" else "No skill points. Level up to get more!", "info")
					return
				end
				ctx.play("Click")
				ctx.RequestEvent:FireServer("SkillUp", name)
			end)
		end
		local reset = row(5, 54, C.Panel)
		button({
			Position = UDim2.fromOffset(8, 5),
			Size = UDim2.new(1, -16, 1, -10),
			BackgroundColor3 = if state.ResetReady then C.Blue else C.Gray,
			ZIndex = 6,
			Parent = reset,
		}, if state.ResetReady then "RESET SKILLS (free, 1 per day)" else "Free reset used today", function()
			if not state.ResetReady then
				ctx.toast("You can reset your skills for free again tomorrow.", "info")
				return
			end
			UI.confirm(ctx.gui, "RESET SKILLS?", "Get all your skill points back to spend again?\nFree once per day.", "RESET", C.Blue, function()
				ctx.RequestEvent:FireServer("SkillReset")
			end, ctx.scaleNow)
		end)
		-- classe
		local classTitle = row(6, 34, C.Panel)
		text(classTitle, {
			Position = UDim2.fromOffset(12, 2),
			Size = UDim2.new(1, -24, 1, -4),
			Text = if state.ClassWait > 0 then ("CLASS (change again in %s)"):format(Format.Time(state.ClassWait)) else "CLASS (free to change)",
			TextColor3 = C.Gold,
		})
		for order, name in Progression.ClassOrder do
			local info = Progression.Classes[name]
			local chosen = state.Class == name
			local box = row(6 + order, 64, if chosen then Color3.fromRGB(70, 60, 30) else C.Row)
			if chosen then
				UI.border(C.Gold, 3).Parent = box
			end
			text(box, { Position = UDim2.fromOffset(12, 4), Size = UDim2.new(0.62, -12, 0, 28), Text = info.Name, TextColor3 = info.Color })
			text(box, { Position = UDim2.fromOffset(12, 32), Size = UDim2.new(0.66, -12, 0, 26), Text = info.Desc, TextColor3 = Color3.fromRGB(200, 215, 240), StrokeThickness = 1 })
			button({
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -12, 0.5, 0),
				Size = UDim2.new(0.28, -12, 0, 46),
				BackgroundColor3 = if chosen then C.Gold else C.Blue,
				ZIndex = 6,
				Parent = box,
			}, if chosen then "YOURS" else "CHOOSE", function()
				if chosen then
					return
				end
				ctx.play("Click")
				ctx.RequestEvent:FireServer("SetClass", name)
			end)
		end
	end

	---------------------------------------------------------------------
	-- PROFILE
	---------------------------------------------------------------------
	local function renderProfile()
		local records = state.Records or {}
		local prestigeBox = row(0, 110, C.Panel)
		local need = tonumber(state.PrestigeNeed) or Progression.PrestigeRebirths
		local ready = (state.Rebirths or 0) >= need
		text(prestigeBox, {
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(0.62, -12, 0, 30),
			Text = if state.Prestige > 0 then ("\u{2B50} PRESTIGE %d  (x%g cash)"):format(state.Prestige, 1 + state.Prestige * Progression.PrestigeBonus) else "PRESTIGE",
			TextColor3 = C.Gold,
		})
		text(prestigeBox, {
			Position = UDim2.fromOffset(12, 38),
			Size = UDim2.new(0.66, -12, 0, 66),
			Text = ("Needs %d rebirths (you have %d).\n+100%% cash forever, an aura and a star!"):format(need, state.Rebirths or 0),
			TextColor3 = Color3.fromRGB(200, 215, 240),
			TextWrapped = true,
			StrokeThickness = 1,
		})
		button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.new(0.28, -12, 0, 52),
			BackgroundColor3 = if ready then C.Purple else C.Gray,
			ZIndex = 6,
			Parent = prestigeBox,
		}, "PRESTIGE", function()
			if not ready then
				ctx.toast(("You need %d rebirths to Prestige."):format(need), "info")
				return
			end
			UI.confirm(
				ctx.gui,
				"PRESTIGE?",
				"Your cash and rebirths go back to 0.\nYou KEEP critters, worlds, slots, pets and styles.\nYou GET +100% cash forever, an aura and a star.",
				"PRESTIGE!",
				C.Purple,
				function()
					ctx.RequestEvent:FireServer("Prestige")
				end,
				ctx.scaleNow
			)
		end)

		local lines = {
			{ "Level", tostring(state.Level) },
			{ "Eggs hatched", Format.Short(records.Hatched or 0) },
			{ "Critters stolen", Format.Short(records.Steals or 0) },
			{ "Thieves BONKed", Format.Short(records.Defends or 0) },
			{ "Critters found", tostring(records.Collected or 0) },
			{ "Shiny critters", tostring(records.Shinies or 0) },
			{ "Hybrids made", tostring(records.Mixes or 0) },
			{ "Giant Eggs helped", tostring(records.GiantEggs or 0) },
			{ "Monsters defeated", tostring(records.Monsters or 0) },
			{ "Minigames played", tostring(records.Minigames or 0) },
			{ "Minigames won", tostring(records.MinigameWins or 0) },
			{ "Quest days", tostring(records.MissionDays or 0) },
			{ "Highest rebirth", tostring(records.PeakRebirths or 0) },
			{ "Best income", Format.Money(records.BestIncome or 0) .. "/s" },
			{ "Most cash", Format.Money(records.BestCash or 0) },
			{ "Total earned", Format.Money(records.TotalEarned or 0) },
			{ "Time played", hoursText(records.PlayTime or 0) },
		}
		local grid = create("Frame", {
			LayoutOrder = 1,
			Size = UDim2.new(1, -12, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			ZIndex = 5,
			Parent = content,
		}, {
			create("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 36), CellPadding = UDim2.fromOffset(8, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		for order, line in lines do
			local cell = create("Frame", { LayoutOrder = order, BackgroundColor3 = C.Row, ZIndex = 5, Parent = grid }, { corner(10) })
			text(cell, { Position = UDim2.fromOffset(10, 4), Size = UDim2.new(0.6, -10, 1, -8), Text = line[1], TextColor3 = Color3.fromRGB(200, 215, 240), StrokeThickness = 1 })
			text(cell, {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -10, 0, 4),
				Size = UDim2.new(0.4, -10, 1, -8),
				Text = line[2],
				TextColor3 = C.Gold,
				TextXAlignment = Enum.TextXAlignment.Right,
			})
		end

		local earned = {}
		for _, id in state.Achievements or {} do
			earned[id] = true
		end
		local count = 0
		for _ in earned do
			count += 1
		end
		local title = row(2, 34, C.Panel)
		text(title, {
			Position = UDim2.fromOffset(12, 2),
			Size = UDim2.new(1, -24, 1, -4),
			Text = ("ACHIEVEMENTS %d / %d"):format(count, #Progression.Achievements),
			TextColor3 = C.Gold,
		})
		local list = create("Frame", {
			LayoutOrder = 3,
			Size = UDim2.new(1, -12, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			ZIndex = 5,
			Parent = content,
		}, {
			create("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 66), CellPadding = UDim2.fromOffset(8, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		for order, achievement in Progression.Achievements do
			local got = earned[achievement.Id] == true
			local cell = create("Frame", { LayoutOrder = order, BackgroundColor3 = if got then Color3.fromRGB(45, 95, 60) else C.Row, ZIndex = 5, Parent = list }, { corner(10) })
			text(cell, { Position = UDim2.fromOffset(10, 3), Size = UDim2.new(1, -20, 0, 26), Text = (if got then "\u{2714} " else "\u{1F512} ") .. achievement.Name, TextColor3 = if got then C.Gold else C.White })
			text(cell, {
				Position = UDim2.fromOffset(10, 30),
				Size = UDim2.new(1, -20, 0, 32),
				Text = achievement.Desc,
				TextColor3 = Color3.fromRGB(200, 215, 240),
				TextWrapped = true,
				StrokeThickness = 1,
			})
		end
	end

	render = function()
		for name, btn in tabButtons do
			btn.BackgroundColor3 = if name == tab then C.Orange else C.Row
		end
		dot.Visible = state ~= nil and (state.Points or 0) > 0
		if not frame.Visible or not state then
			return
		end
		clear()
		timerLabel = nil
		if tab == "QUESTS" then
			renderQuests()
		elseif tab == "SKILLS" then
			renderSkills()
		else
			renderProfile()
		end
	end

	ctx.RemotesFolder:WaitForChild("ProgressSync").OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" or type(payload.Missions) ~= "table" then
			return
		end
		payload.Skills = if type(payload.Skills) == "table" then payload.Skills else {}
		payload.Level = tonumber(payload.Level) or 1
		payload.Points = tonumber(payload.Points) or 0
		payload.XPInto = tonumber(payload.XPInto) or 0
		payload.XPNeed = tonumber(payload.XPNeed) or 1
		payload.Prestige = tonumber(payload.Prestige) or 0
		payload.ClassWait = tonumber(payload.ClassWait) or 0
		state = payload
		receivedAt = os.clock()
		render()
	end)

	-- relógio de verdade das missões (troca à meia-noite UTC, igual para todo mundo)
	task.spawn(function()
		while true do
			task.wait(1)
			if frame.Visible and state and timerLabel then
				local left = (tonumber(state.DayEndsIn) or 0) - (os.clock() - receivedAt)
				timerLabel.Text = "New quests in " .. hoursText(left)
				if left <= 0 then
					ctx.RequestEvent:FireServer("ProgressSync")
					receivedAt = os.clock() + 86400 -- não pede de novo até a resposta chegar
				end
			end
		end
	end)

	-- festas
	ctx.EffectEvent.OnClientEvent:Connect(function(kind, data)
		if kind == "LevelUp" then
			ctx.play("Rare")
			ctx.bigText("LEVEL " .. tostring(data) .. "!", C.Purple)
			Juice.Confetti(ctx.gui, 60, { C.Purple, C.Gold, C.White })
		elseif kind == "Quest" then
			ctx.play("Coin")
		elseif kind == "QuestsAll" then
			ctx.play("Rare")
			ctx.bigText("ALL QUESTS DONE!", C.Gold)
			Juice.Confetti(ctx.gui, 90)
		elseif kind == "Achievement" then
			ctx.play("Rare")
			ctx.bigText("ACHIEVEMENT!", C.Gold)
			Juice.Confetti(ctx.gui, 50, { C.Gold, C.White })
		elseif kind == "SkillUp" then
			ctx.play("Buy")
		elseif kind == "Prestige" then
			ctx.play("Shiny")
			ctx.flash(C.Gold, 0.9)
			ctx.bigText("PRESTIGE " .. tostring(data) .. "!", C.Gold)
			Juice.Confetti(ctx.gui, 150, { C.Gold, C.Purple, C.White })
			Juice.Shake(1, 0.8)
		end
	end)

	ctx.panelOpened.Me = function()
		ctx.RequestEvent:FireServer("ProgressSync")
		render()
	end
	return frame
end

return MeUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="484">
        <Properties>
          <string name="Name">MinigameUI</string>
          <string name="Source"><![CDATA[--[[
	MinigameUI (ModuleScript em StarterPlayer > StarterPlayerScripts)
	Parte 23 (v12): o que o hub de minigames mostra na tela.
	  • faixa "OBBY RACE starting in 23s!" com JOIN / LEAVE (fila automática, entrada grátis)
	  • durante a rodada: o tempo e as informações do jogo (checkpoint, placar do topo, moedas, quem foi achado)
	  • contagem 3, 2, 1, GO!
	  • janela da CRITTER BATTLE: os dois bichinhos, vida, e os botões ATTACK / DEFEND / SPECIAL
	Tudo vem do servidor (atributos do Workspace/jogador e o RemoteEvent "BattleSync").
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Critters = require(Shared:WaitForChild("Critters"))
local Format = require(Shared:WaitForChild("Format"))
local Builder = require(Shared:WaitForChild("CritterBuilder"))
local UI = require(script.Parent:WaitForChild("UIKit"))
local Juice = require(script.Parent:WaitForChild("Juice"))

local MinigameUI = {}

local C = UI.Colors
local create, corner, label, button = UI.create, UI.corner, UI.label, UI.button

local ROLE_TEXT = {
	Cop = "You are a COP: BONK robbers to send them to jail!",
	Robber = "You are a ROBBER: grab the gold coins! The green button opens the jail.",
	Seeker = "You are the SEEKER: find and BONK the hiders!",
	Hider = "You are HIDING: don't let the seeker find you!",
}

function MinigameUI.Init(ctx)
	local player = Players.LocalPlayer

	---------------------------------------------------------------------
	-- Faixa (anúncio e rodada)
	---------------------------------------------------------------------
	-- v20: a faixa saiu do meio da tela; v21: ela é um item da coluna da esquerda (sem scaleNow)
	local bar = create("Frame", {
		Name = "MinigameBar",
		LayoutOrder = 60,
		Size = UDim2.fromOffset(ctx.stackWidth or 260, 46),
		BackgroundColor3 = Color3.fromRGB(40, 110, 170),
		Visible = false,
		ZIndex = 30, -- por cima da janela da batalha
		Parent = ctx.leftStack or ctx.gui,
	}, { corner(12), UI.border(C.White, 2) })
	local barText = label({ Position = UDim2.fromOffset(8, 3), Size = UDim2.new(0.7, -10, 1, -6), Text = "", TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 31, Parent = bar })
	local joinButton, joinText = button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.new(0.3, -6, 0, 34),
		BackgroundColor3 = C.Green,
		ZIndex = 31,
		Parent = bar,
	}, "JOIN", function()
		ctx.play("Click")
		ctx.RequestEvent:FireServer("MinigameJoin")
	end)

	local lastCountdown = 0
	local function refresh()
		local t = workspace:GetServerTimeNow()
		local mgState = workspace:GetAttribute("MgState")
		local gameId = workspace:GetAttribute("MgGame")
		local info = if typeof(gameId) == "string" then Config.MinigameById[gameId] else nil
		local mine = player:GetAttribute("InMinigame")
		if mgState == "announce" and info then
			local left = math.max(0, math.ceil((tonumber(workspace:GetAttribute("MgStarts")) or t) - t))
			local queued = player:GetAttribute("MgQueued") == true
			bar.Visible = true
			bar.BackgroundColor3 = Color3.fromRGB(40, 110, 170)
			barText.Text = ("%s in %ds\n%s (%d joined)"):format(string.upper(info.Name), left, if queued then "You're in!" else "Free!", tonumber(workspace:GetAttribute("MgQueue")) or 0)
			joinButton.Visible = true
			joinText.Text = if queued then "LEAVE" else "JOIN"
			joinButton.BackgroundColor3 = if queued then C.Gray else C.Green
		elseif (mgState == "play" or mgState == "results") and mine and info then
			bar.Visible = true
			joinButton.Visible = false
			bar.BackgroundColor3 = Color3.fromRGB(120, 60, 170)
			local left = math.max(0, (tonumber(workspace:GetAttribute("MgEnds")) or t) - t)
			local extra = ""
			local raw = workspace:GetAttribute("MgInfo")
			local data: any = {}
			if typeof(raw) == "string" then
				pcall(function()
					data = HttpService:JSONDecode(raw)
				end)
			end
			if type(data) ~= "table" then
				data = {}
			end
			local role = player:GetAttribute("MgRole")
			if mine == "Race" then
				extra = ("Checkpoint %d/4"):format(tonumber(player:GetAttribute("MgProgress")) or 0)
			elseif mine == "King" and type(data.Top) == "table" then
				local parts = {}
				for i, entry in data.Top do
					if i <= 3 then
						table.insert(parts, ("%s %d"):format(tostring(entry.N), tonumber(entry.S) or 0))
					end
				end
				extra = "Top: " .. table.concat(parts, "  ")
			elseif mine == "Cops" then
				extra = ("%s  |  coins %d/%d"):format(if role == "Cop" then "COP" else "ROBBER", tonumber(data.Coins) or 0, tonumber(data.Goal) or 0)
			elseif mine == "Hide" then
				local seekerLeft = math.ceil((tonumber(workspace:GetAttribute("MgSeekerAt")) or 0) - t)
				extra = ("%s  |  found %d/%d%s"):format(
					if role == "Seeker" then "SEEKER" else "HIDER",
					tonumber(data.Found) or 0,
					tonumber(data.Hiders) or 0,
					if seekerLeft > 0 then ("  |  seeker out in %ds"):format(seekerLeft) else ""
				)
			elseif mine == "Battle" then
				extra = "Pick your move below!"
			end
			barText.Text = ("%s  %s\n%s"):format(string.upper(info.Name), if mgState == "results" then "DONE!" else Format.Time(left), extra)
		else
			bar.Visible = false
		end
		-- 3, 2, 1, GO!
		local countdownEnd = tonumber(workspace:GetAttribute("MgCountdown")) or 0
		if mine and countdownEnd > t - 1 then
			local secondsLeft = math.ceil(countdownEnd - t)
			if secondsLeft ~= lastCountdown then
				lastCountdown = secondsLeft
				if secondsLeft > 0 and secondsLeft <= 3 then
					ctx.play("Click")
					ctx.bigText(tostring(secondsLeft), C.White)
				elseif secondsLeft == 0 then
					ctx.play("Rare")
					ctx.bigText("GO!", C.Green)
				end
			end
		end
	end

	player:GetAttributeChangedSignal("MgRole"):Connect(function()
		local role = player:GetAttribute("MgRole")
		if typeof(role) == "string" and ROLE_TEXT[role] then
			ctx.toast(ROLE_TEXT[role], "rare")
		end
	end)

	---------------------------------------------------------------------
	-- CRITTER BATTLE
	---------------------------------------------------------------------
	local panel = create("Frame", {
		Name = "BattlePanel",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(600, 300),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.05,
		Visible = false,
		ZIndex = 20,
		Parent = ctx.gui,
	}, { corner(18), UI.border(C.Purple, 4) })
	ctx.scaleNow(panel)
	local function side(x: number)
		local viewport = create("ViewportFrame", {
			Position = UDim2.new(x, 10, 0, 10),
			Size = UDim2.new(0.5, -20, 0, 120),
			BackgroundColor3 = Color3.fromRGB(30, 30, 50),
			Ambient = Color3.fromRGB(170, 170, 170),
			LightColor = C.White,
			LightDirection = Vector3.new(-0.4, -1, 0.6),
			ZIndex = 21,
			Parent = panel,
		}, { corner(12) })
		local camera = Instance.new("Camera")
		camera.FieldOfView = 40
		camera.Parent = viewport
		viewport.CurrentCamera = camera
		local name = label({ Position = UDim2.new(x, 10, 0, 132), Size = UDim2.new(0.5, -20, 0, 22), Text = "", ZIndex = 21, Parent = panel })
		local back = create("Frame", { Position = UDim2.new(x, 10, 0, 156), Size = UDim2.new(0.5, -20, 0, 22), BackgroundColor3 = C.Dark, ZIndex = 21, Parent = panel }, { corner(8) })
		local fill = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Green, ZIndex = 21, Parent = back }, { corner(8) })
		local hp = label({ Size = UDim2.fromScale(1, 1), Text = "", StrokeThickness = 1.5, ZIndex = 22, Parent = back })
		return { Viewport = viewport, Camera = camera, Name = name, Fill = fill, HP = hp, Shown = "" }
	end
	local me = side(0)
	local foe = side(0.5)
	local log = label({ Position = UDim2.fromOffset(10, 182), Size = UDim2.new(1, -20, 0, 34), Text = "", TextWrapped = true, TextColor3 = Color3.fromRGB(230, 220, 255), ZIndex = 21, Parent = panel })
	local moveButtons = {}
	for i, move in { "Attack", "Defend", "Special" } do
		local color = if move == "Attack" then C.Red elseif move == "Defend" then C.Blue else C.Gold
		local btn, text = button({
			Position = UDim2.new((i - 1) / 3, 8, 1, -76),
			Size = UDim2.new(1 / 3, -16, 0, 64),
			BackgroundColor3 = color,
			ZIndex = 22,
			Parent = panel,
		}, string.upper(move), function()
			ctx.play("Click")
			ctx.RequestEvent:FireServer("BattleMove", move)
		end)
		moveButtons[move] = { Button = btn, Text = text, Color = color }
	end

	local function showCritter(slot, critterId: string, mutation: string?)
		local key = critterId .. ":" .. tostring(mutation)
		if slot.Shown == key then
			return
		end
		slot.Shown = key
		for _, child in slot.Viewport:GetChildren() do
			if child:IsA("Model") then
				child:Destroy()
			end
		end
		local def = Critters.ById[critterId]
		local model: Model
		if def then
			model = Builder.Build(def)
			if mutation then
				Builder.ApplyMutation(model, mutation)
			end
		else
			-- Grumblob (o monstro da invasão)
			model = Instance.new("Model")
			local body = Instance.new("Part")
			body.Shape = Enum.PartType.Ball
			body.Size = Vector3.new(4, 4, 4)
			body.Color = Color3.fromRGB(150, 70, 200)
			body.Parent = model
			model.PrimaryPart = body
		end
		local aura = model:FindFirstChild("Aura")
		if aura then
			aura:Destroy()
		end
		model:PivotTo(CFrame.identity)
		model.Parent = slot.Viewport
		local boxCFrame, boxSize = model:GetBoundingBox()
		local radius = boxSize.Magnitude / 2
		slot.Camera.CFrame = CFrame.lookAt(boxCFrame.Position + Vector3.new(radius * 0.8, radius * 0.5, -radius * 2.2), boxCFrame.Position)
	end

	local battle: any = nil
	local hideAt = 0
	ctx.RemotesFolder:WaitForChild("BattleSync").OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" or type(payload.Me) ~= "table" or type(payload.Foe) ~= "table" then
			return
		end
		local previous = battle
		battle = payload
		panel.Visible = true
		for pair, slot in { [payload.Me] = me, [payload.Foe] = foe } do
			showCritter(slot, tostring(pair.Critter or ""), pair.M)
			local def = Critters.ById[tostring(pair.Critter or "")]
			slot.Name.Text = ("%s (%s)"):format(tostring(pair.Name), if def then def.Name else "Grumblob")
			local fraction = math.clamp((tonumber(pair.HP) or 0) / math.max(tonumber(pair.Max) or 1, 1), 0, 1)
			slot.Fill.Size = UDim2.fromScale(fraction, 1)
			slot.Fill.BackgroundColor3 = if fraction > 0.5 then C.Green elseif fraction > 0.25 then C.Gold else C.Red
			slot.HP.Text = ("%d / %d"):format(tonumber(pair.HP) or 0, tonumber(pair.Max) or 0)
		end
		log.Text = tostring(payload.Log or "")
		if payload.Done then
			hideAt = os.clock() + 4
			ctx.bigText(if payload.Won then "YOU WIN!" else "GOOD FIGHT!", if payload.Won then C.Gold else C.White)
			if payload.Won then
				ctx.play("Rare")
				Juice.Confetti(ctx.gui, 70)
			end
		elseif previous and previous.Log ~= payload.Log then
			ctx.play("Bonk")
			Juice.Shake(0.25, 0.25)
		end
	end)

	RunService.Heartbeat:Connect(function()
		if panel.Visible and battle then
			local t = workspace:GetServerTimeNow()
			local secondsLeft = math.max(0, math.ceil((tonumber(battle.Deadline) or t) - t))
			for move, entry in moveButtons do
				local chosen = battle.Chosen == move
				local waiting = move == "Special" and (tonumber(battle.Me.SpecialIn) or 0) > 0
				entry.Button.BackgroundColor3 = if battle.Done then C.Gray elseif chosen then C.White elseif waiting or battle.Chosen then C.Gray else entry.Color
				entry.Text.Text = if waiting then ("SPECIAL (%d)"):format(battle.Me.SpecialIn) elseif chosen then "OK!" else string.upper(move)
			end
			if not battle.Done and not battle.Chosen then
				log.Text = ("Turn %d  -  choose in %ds!   %s"):format(tonumber(battle.Turn) or 0, secondsLeft, tostring(battle.Log or ""))
			end
			if (hideAt > 0 and os.clock() > hideAt) or player:GetAttribute("InMinigame") ~= "Battle" then
				panel.Visible = false
				battle = nil
				hideAt = 0
			end
		end
	end)

	ctx.EffectEvent.OnClientEvent:Connect(function(kind)
		if kind == "MinigameAnnounce" then
			ctx.play("Rare")
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.25)
			local ok, err = pcall(refresh) -- um erro aqui nunca pode travar a faixa para sempre
			if not ok then
				warn("[MinigameUI]", err)
			end
		end
	end)
end

return MinigameUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="485">
        <Properties>
          <string name="Name">MountFX</string>
          <string name="Source"><![CDATA[--[[
	MountFX (ModuleScript em StarterPlayer > StarterPlayerScripts)
	v21: as MONTARIAS ganham vida na tela de cada jogador (o servidor continua só prendendo o modelo
	no personagem; nada muda na velocidade nem nas regras).
	  • Skate: rodas girando, balança de leve, empina ao acelerar, inclina nas curvas, poeira + faíscas
	  • Go-Kart: rodas girando, motor "tremendo", inclina nas curvas, fumaça no escapamento e rastro colorido
	  • Critter Ride: o bichinho dá pulinhos no ritmo da corrida, rebola, inclina nas curvas, coraçõezinhos
	Como funciona: a montaria do servidor fica INVISÍVEL só na sua tela e uma cópia local (ancorada) é
	desenhada em cima dela, todo frame, com a animação. Longe da câmera (FAR) a cópia some e a original volta.
	"Low graphics" (SETTINGS) desliga as partículas; a animação continua (é barata).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local MountFX = {}

local FAR = 220 -- studs: mais longe que isso não anima
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"

type Piece = { Server: BasePart, Local: BasePart, Rel: CFrame, Wheel: boolean, Radius: number }
type Rig = {
	Model: Model,
	Root: BasePart,
	Humanoid: Humanoid?,
	Kind: string,
	Pieces: { Piece },
	PivotRel: CFrame,
	Back: number,
	Fx: BasePart?,
	Emitters: { [string]: ParticleEmitter },
	Trails: { Trail },
	Spin: number,
	Lean: number,
	Pitch: number,
	LastSpeed: number,
	LastYaw: number,
	Step: number,
	Phase: number,
	Hidden: boolean?,
}

local rigs: { [Model]: Rig } = {}
local folder: Folder? = nil

local function angleDelta(from: number, to: number): number
	local d = (to - from) % (math.pi * 2)
	if d > math.pi then
		d -= math.pi * 2
	end
	return d
end

local function getFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "MountFX"
	f.Parent = workspace
	folder = f
	return f
end

local function emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	for key, value in props do
		(e :: any)[key] = value
	end
	e.Parent = parent
	return e
end

local function seq(a: number, b: number): NumberSequence
	return NumberSequence.new(a, b)
end

-- Partículas e rastros de cada montaria (ficam numa peça invisível atrás dela)
local function buildFx(rig: Rig, lowGfx: boolean)
	if lowGfx then
		return
	end
	local fx = Instance.new("Part")
	fx.Name = "Fx"
	fx.Anchored = true
	fx.CanCollide = false
	fx.CanQuery = false
	fx.CanTouch = false
	fx.CastShadow = false
	fx.Transparency = 1
	fx.Size = Vector3.new(1.4, 0.4, 0.6)
	fx.CFrame = rig.Root.CFrame
	fx.Parent = getFolder()
	rig.Fx = fx
	local kind = rig.Kind
	if kind == "skate" or kind == "critter" then
		rig.Emitters.Dust = emitter(fx, {
			Name = "Dust",
			Texture = SMOKE,
			Color = ColorSequence.new(Color3.fromRGB(225, 210, 180)),
			Size = seq(0.5, 1.8),
			Transparency = seq(0.55, 1),
			Lifetime = NumberRange.new(0.45, 0.8),
			Speed = NumberRange.new(2, 4),
			SpreadAngle = Vector2.new(25, 25),
			EmissionDirection = Enum.NormalId.Back,
			Rate = 0,
		})
	end
	if kind == "skate" then
		rig.Emitters.Sparks = emitter(fx, {
			Name = "Sparks",
			Texture = SPARK,
			Color = ColorSequence.new(Color3.fromRGB(255, 240, 150), Color3.fromRGB(255, 150, 40)),
			LightEmission = 1,
			Size = seq(0.3, 0),
			Lifetime = NumberRange.new(0.2, 0.4),
			Speed = NumberRange.new(6, 11),
			SpreadAngle = Vector2.new(35, 35),
			Acceleration = Vector3.new(0, -30, 0),
			EmissionDirection = Enum.NormalId.Back,
			Rate = 0,
		})
	elseif kind == "cart" then
		rig.Emitters.Smoke = emitter(fx, {
			Name = "Smoke",
			Texture = SMOKE,
			Color = ColorSequence.new(Color3.fromRGB(150, 150, 160), Color3.fromRGB(110, 110, 120)),
			Size = seq(0.6, 2.2),
			Transparency = seq(0.4, 1),
			Lifetime = NumberRange.new(0.6, 1.1),
			Speed = NumberRange.new(3, 5),
			SpreadAngle = Vector2.new(20, 20),
			RotSpeed = NumberRange.new(-60, 60),
			EmissionDirection = Enum.NormalId.Back,
			Rate = 6,
		})
		-- rastro colorido atrás das rodas de trás
		for i, x in { -0.95, 0.95 } do
			local a0 = Instance.new("Attachment")
			a0.Position = Vector3.new(x, 0.25, 0)
			a0.Parent = fx
			local a1 = Instance.new("Attachment")
			a1.Position = Vector3.new(x, -0.25, 0)
			a1.Parent = fx
			local trail = Instance.new("Trail")
			trail.Attachment0 = a0
			trail.Attachment1 = a1
			trail.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, if i == 1 then Color3.fromRGB(255, 120, 60) else Color3.fromRGB(80, 200, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 240, 120)),
			})
			trail.Transparency = NumberSequence.new(0.25, 1)
			trail.Lifetime = 0.35
			trail.LightEmission = 0.6
			trail.WidthScale = NumberSequence.new(1, 0.2)
			trail.Enabled = false
			trail.Parent = fx
			table.insert(rig.Trails, trail)
		end
	elseif kind == "critter" then
		rig.Emitters.Hearts = emitter(fx, {
			Name = "Hearts",
			Texture = SPARK,
			Color = ColorSequence.new(Color3.fromRGB(255, 120, 180), Color3.fromRGB(255, 200, 230)),
			LightEmission = 0.7,
			Size = seq(0.45, 0.1),
			Transparency = seq(0.1, 1),
			Lifetime = NumberRange.new(0.9, 1.4),
			Speed = NumberRange.new(2, 3.5),
			SpreadAngle = Vector2.new(40, 40),
			EmissionDirection = Enum.NormalId.Top,
			Rate = 1.5,
		})
	end
end

local function destroyRig(model: Model)
	local rig = rigs[model]
	if not rig then
		return
	end
	rigs[model] = nil
	for _, piece in rig.Pieces do
		if piece.Server.Parent then
			piece.Server.LocalTransparencyModifier = 0
		end
		piece.Local:Destroy()
	end
	if rig.Fx then
		rig.Fx:Destroy()
	end
end

local function buildRig(character: Model, model: Model)
	if rigs[model] then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local player = Players.LocalPlayer
	local owner = Players:GetPlayerFromCharacter(character)
	local kind = owner and owner:GetAttribute("Mounted")
	if typeof(kind) ~= "string" then
		-- o atributo ainda não chegou: descobre pelas peças
		if model:FindFirstChild("Deck") then
			kind = "skate"
		elseif model:FindFirstChild("Body") or model:FindFirstChild("Seat") then
			kind = "cart"
		elseif model:FindFirstChild("Root") then
			kind = "critter"
		else
			kind = "skate"
		end
	end
	local pivot = model:GetPivot()
	local _, size = model:GetBoundingBox()
	local rig: Rig = {
		Model = model,
		Root = root,
		Humanoid = character:FindFirstChildOfClass("Humanoid"),
		Kind = kind,
		Pieces = {},
		PivotRel = root.CFrame:ToObjectSpace(pivot),
		Back = size.Z / 2,
		Fx = nil,
		Emitters = {},
		Trails = {},
		Spin = 0,
		Lean = 0,
		Pitch = 0,
		LastSpeed = 0,
		LastYaw = 0,
		Step = 0,
		Phase = math.random() * 6,
	}
	local holder = getFolder()
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			local copy = part:Clone()
			for _, child in copy:GetChildren() do
				if child:IsA("JointInstance") or child:IsA("Constraint") or child:IsA("WeldConstraint") or child:IsA("ProximityPrompt") or child:IsA("BillboardGui") then
					child:Destroy()
				end
			end
			copy.Anchored = true
			copy.CanCollide = false
			copy.CanQuery = false
			copy.CanTouch = false
			copy.Massless = true
			copy.LocalTransparencyModifier = 0
			copy.Parent = holder
			local wheel = part.Name == "Wheel" and part:IsA("Part") and part.Shape == Enum.PartType.Cylinder
			table.insert(rig.Pieces, {
				Server = part,
				Local = copy,
				Rel = pivot:ToObjectSpace(part.CFrame),
				Wheel = wheel,
				Radius = math.max(part.Size.Y / 2, 0.2),
			})
			part.LocalTransparencyModifier = 1
		end
	end
	if #rig.Pieces == 0 then
		return
	end
	buildFx(rig, player:GetAttribute("LowGfx") == true)
	rigs[model] = rig
end

local function watchCharacter(character: Model)
	local function onMount(child: Instance)
		if child.Name == "Mount" and child:IsA("Model") then
			-- as peças podem chegar um pouquinho depois do modelo
			task.delay(0.15, function()
				if child.Parent == character then
					buildRig(character, child)
				end
			end)
		end
	end
	character.ChildAdded:Connect(onMount)
	character.ChildRemoved:Connect(function(child)
		if child:IsA("Model") and rigs[child] then
			destroyRig(child)
		end
	end)
	character.Destroying:Connect(function()
		for model, rig in rigs do
			if rig.Root.Parent == nil or rig.Root:IsDescendantOf(character) then
				destroyRig(model)
			end
		end
	end)
	for _, child in character:GetChildren() do
		onMount(child)
	end
end

local function watchPlayer(player: Player)
	player.CharacterAdded:Connect(watchCharacter)
	if player.Character then
		watchCharacter(player.Character)
	end
end

local function setHidden(rig: Rig, hidden: boolean)
	if rig.Hidden == hidden then
		return
	end
	rig.Hidden = hidden
	for _, piece in rig.Pieces do
		piece.Local.LocalTransparencyModifier = if hidden then 1 else 0
		if piece.Server.Parent then
			piece.Server.LocalTransparencyModifier = if hidden then 0 else 1
		end
	end
	for _, e in rig.Emitters do
		e.Enabled = not hidden
	end
end

local function stepRig(rig: Rig, dt: number, cameraPosition: Vector3, now: number)
	local root = rig.Root
	local cf = root.CFrame
	if (cf.Position - cameraPosition).Magnitude > FAR then
		setHidden(rig, true)
		return
	end
	setHidden(rig, false)
	-- o Roblox mexe no LocalTransparencyModifier do personagem ao dar zoom: garante todo frame
	for _, piece in rig.Pieces do
		if piece.Server.Parent then
			piece.Server.LocalTransparencyModifier = 1
		end
	end

	local vel = root.AssemblyLinearVelocity
	local flat = Vector3.new(vel.X, 0, vel.Z)
	local speed = flat.Magnitude
	local look = cf.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	local forwardSpeed = if flatLook.Magnitude > 0.01 then flat:Dot(flatLook.Unit) else 0
	local yaw = math.atan2(-look.X, -look.Z)
	local yawRate = angleDelta(rig.LastYaw, yaw) / dt
	rig.LastYaw = yaw
	local accel = (forwardSpeed - rig.LastSpeed) / dt
	rig.LastSpeed = forwardSpeed
	local moving = math.clamp(speed / 6, 0, 1)
	local grounded = true
	if rig.Humanoid then
		grounded = rig.Humanoid.FloorMaterial ~= Enum.Material.Air
	end

	-- inclina nas curvas e empina ao acelerar (suave)
	local leanGoal = math.clamp(-yawRate * 0.11 * math.clamp(speed / 14, 0, 1), -0.42, 0.42)
	rig.Lean += (leanGoal - rig.Lean) * (1 - math.exp(-dt * 8))
	local pitchGoal = math.clamp(accel * 0.012, -0.22, 0.28)
	if not grounded then
		pitchGoal += 0.12 -- no ar: nariz para cima
	end
	rig.Pitch += (pitchGoal - rig.Pitch) * (1 - math.exp(-dt * 5))

	local bob, roll, pitch, kind = 0, 0, 0, rig.Kind
	if kind == "skate" then
		bob = math.sin(now * 9 + rig.Phase) * 0.05 * moving
		roll = math.sin(now * 4.5 + rig.Phase) * 0.05 * moving
	elseif kind == "cart" then
		bob = math.sin(now * 38) * 0.02 * (0.35 + moving)
		roll = math.sin(now * 38 + 1) * 0.008
	elseif kind == "critter" then
		-- pulinhos no ritmo da corrida (igual aos pets)
		local rate = math.clamp(1.8 + speed * 0.12, 1.8, 4.4)
		if moving > 0.05 or rig.Step % 1 > 0.02 then
			rig.Step += dt * rate
		end
		local k = rig.Step % 1
		local amount = math.max(moving, if k > 0.02 then 0.3 else 0)
		bob = 4 * k * (1 - k) * 0.45 * amount
		roll = math.sin(rig.Step * math.pi) * math.rad(8) * moving
		pitch = -math.rad(9) * math.clamp(speed / 20, 0, 1)
	end

	local pivotWorld = cf * rig.PivotRel
	local visual = pivotWorld * CFrame.Angles(rig.Pitch + pitch, 0, rig.Lean + roll) * CFrame.new(0, bob, 0)
	if grounded then
		rig.Spin += forwardSpeed * dt
	end
	for _, piece in rig.Pieces do
		local target = visual * piece.Rel
		if piece.Wheel then
			target = target * CFrame.Angles(-rig.Spin / piece.Radius, 0, 0)
		end
		piece.Local.CFrame = target
	end

	-- efeitos
	local fx = rig.Fx
	if fx then
		fx.CFrame = visual * CFrame.new(0, 0.25, rig.Back - 0.2)
		local dust = rig.Emitters.Dust
		if dust then
			dust.Rate = if grounded then 16 * moving else 0
		end
		local sparks = rig.Emitters.Sparks
		if sparks then
			sparks.Rate = if grounded and speed > 15 then 12 + (speed - 15) * 1.5 else 0
		end
		local smoke = rig.Emitters.Smoke
		if smoke then
			smoke.Rate = 5 + 18 * moving
		end
		for _, trail in rig.Trails do
			trail.Enabled = speed > 8
		end
	end
end

function MountFX.Init()
	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		local character = player.Character
		if character then
			for model, rig in rigs do
				if rig.Root:IsDescendantOf(character) then
					destroyRig(model)
				end
			end
		end
	end)
	-- Low graphics ligado depois: tira as partículas
	Players.LocalPlayer:GetAttributeChangedSignal("LowGfx"):Connect(function()
		if Players.LocalPlayer:GetAttribute("LowGfx") == true then
			for _, rig in rigs do
				if rig.Fx then
					rig.Fx:Destroy()
					rig.Fx = nil
					rig.Emitters = {}
					rig.Trails = {}
				end
			end
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		dt = math.clamp(dt, 1 / 240, 0.1)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local cameraPosition = camera.CFrame.Position
		local now = os.clock()
		for model, rig in rigs do
			if not model.Parent or not rig.Root.Parent then
				destroyRig(model)
			else
				stepRig(rig, dt, cameraPosition, now)
			end
		end
	end)
end

return MountFX
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="486">
        <Properties>
          <string name="Name">NpcUI</string>
          <string name="Source"><![CDATA[--[[
	NpcUI (ModuleScript em StarterPlayer > StarterPlayerScripts)
	v14: conversa com o mascote Sneaky e com os ajudantes do mapa.
	  • Chegue perto e aperte "Talk" (E no PC, toque no celular): aparece o balão de conversa embaixo.
	  • NEXT mostra a próxima dica; BYE fecha. Fecha sozinho se você se afastar.
	  • Os personagens balançam de leve e viram o rosto para você quando chega perto
	    (isso é só na sua tela: não pesa no servidor).
	A conversa é só texto (não dá prêmio), então não precisa falar com o servidor.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local NPCs = require(Shared:WaitForChild("NPCs"))
local UI = require(script.Parent:WaitForChild("UIKit"))

local NpcUI = {}

local C = UI.Colors
local create, corner, label, button = UI.create, UI.corner, UI.label, UI.button

local TALK_DISTANCE = 18 -- longe disso a conversa fecha
local ANIMATE_DISTANCE = 90 -- só anima quem está perto (economiza no celular)
local LOOK_DISTANCE = 20 -- vira para você quando está a menos disso

function NpcUI.Init(ctx)
	local player = Players.LocalPlayer

	---------------------------------------------------------------------
	-- Balão de conversa
	---------------------------------------------------------------------
	local panel = create("Frame", {
		Name = "NpcDialog",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(560, 170),
		BackgroundColor3 = C.Panel,
		Visible = false,
		ZIndex = 30,
		Parent = ctx.gui,
	}, { corner(20), UI.border(C.Gold, 4) })
	ctx.scaleNow(panel)
	local nameLabel = label({
		Position = UDim2.fromOffset(18, 10),
		Size = UDim2.new(0.6, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.Gold,
		Text = "",
		ZIndex = 31,
		Parent = panel,
	})
	local lineLabel = label({
		Position = UDim2.fromOffset(18, 44),
		Size = UDim2.new(1, -36, 0, 66),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Text = "",
		ZIndex = 31,
		Parent = panel,
	})
	local counter = label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -18, 0, 12),
		Size = UDim2.fromOffset(80, 24),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Color3.fromRGB(200, 200, 220),
		Text = "",
		ZIndex = 31,
		Parent = panel,
	})

	local current: any = nil -- { Npc, Model, Index, Opened }
	local typing = 0
	-- cada NPC lembra onde a conversa parou (na próxima vez continua da dica seguinte)
	local lastIndex: { [string]: number } = {}

	local function close()
		current = nil
		panel.Visible = false
	end

	local nextButton, nextText
	local function showLine()
		if not current then
			return
		end
		local lines = current.Npc.Lines
		local index = current.Index
		lineLabel.Text = lines[index]
		lineLabel.MaxVisibleGraphemes = 0
		typing += 1
		local myTyping = typing
		counter.Text = ("%d/%d"):format(index, #lines)
		nextText.Text = if index >= #lines then "BYE" else "NEXT"
		nextButton.BackgroundColor3 = if index >= #lines then C.Gray else C.Green
		task.spawn(function()
			-- efeito de "digitando" (funciona com qualquer idioma: conta as letras do texto já traduzido)
			local total = utf8.len(lineLabel.ContentText) or #lineLabel.Text
			for shown = 1, total, 2 do
				if typing ~= myTyping then
					return
				end
				lineLabel.MaxVisibleGraphemes = shown
				task.wait(0.016)
			end
			if typing == myTyping then
				lineLabel.MaxVisibleGraphemes = -1
			end
		end)
	end

	nextButton, nextText = button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -12),
		Size = UDim2.fromOffset(150, 44),
		BackgroundColor3 = C.Green,
		ZIndex = 32,
		Parent = panel,
	}, "NEXT", function()
		if not current then
			return
		end
		ctx.play("Click")
		if lineLabel.MaxVisibleGraphemes ~= -1 then
			-- primeiro toque só termina de mostrar a frase
			typing += 1
			lineLabel.MaxVisibleGraphemes = -1
			return
		end
		if current.Index >= #current.Npc.Lines then
			close()
			return
		end
		current.Index += 1
		lastIndex[current.Npc.Id] = current.Index
		showLine()
	end)
	button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -176, 1, -12),
		Size = UDim2.fromOffset(110, 44),
		BackgroundColor3 = C.Red,
		ZIndex = 32,
		Parent = panel,
	}, "BYE", function()
		ctx.play("Click")
		close()
	end)

	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who ~= player then
			return
		end
		local id = prompt:GetAttribute("NpcId")
		local npc = typeof(id) == "string" and NPCs.ById[id]
		if not npc then
			return
		end
		if current and current.Npc == npc then
			close()
			return
		end
		local model = prompt:FindFirstAncestorWhichIsA("Model")
		local start = ((lastIndex[npc.Id] or 0) % #npc.Lines) + 1
		lastIndex[npc.Id] = start
		current = { Npc = npc, Model = model, Index = start, Opened = os.clock() }
		nameLabel.Text = npc.Name
		panel.Visible = true
		UI.popIn(panel)
		ctx.play("Click")
		showLine()
	end)

	-- fecha sozinho se você se afastar ou se o personagem sumir (streaming)
	task.spawn(function()
		while true do
			task.wait(0.5)
			if current then
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				local model = current.Model
				if not root or not model or not model.Parent then
					close()
				elseif (model:GetPivot().Position - root.Position).Magnitude > TALK_DISTANCE then
					close()
				end
			end
		end
	end)

	---------------------------------------------------------------------
	-- Animação leve: respira (sobe e desce) e vira para o jogador
	---------------------------------------------------------------------
	type Entry = { Model: Model, Base: CFrame, Yaw: number, Phase: number, Hop: number, IsMascot: boolean }
	local entries: { [Model]: Entry } = {}

	local function add(model: Instance)
		if not model:IsA("Model") or entries[model] then
			return
		end
		entries[model] = {
			Model = model,
			Base = model:GetPivot(),
			Yaw = 0,
			Phase = math.random() * math.pi * 2,
			Hop = 0,
			IsMascot = model:GetAttribute("NpcId") == "sneaky",
		}
	end
	for _, model in CollectionService:GetTagged("NPC") do
		add(model)
	end
	CollectionService:GetInstanceAddedSignal("NPC"):Connect(add)
	CollectionService:GetInstanceRemovedSignal("NPC"):Connect(function(model)
		entries[model :: Model] = nil
	end)

	local nextHop = os.clock() + 5
	RunService.Heartbeat:Connect(function(dt)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local now = os.clock()
		local focus = camera.Focus.Position
		local hopNow = now >= nextHop
		if hopNow then
			nextHop = now + 5 + math.random() * 4
		end
		for model, entry in entries do
			if not model.Parent then
				entries[model] = nil
				continue
			end
			local base = entry.Base
			if (base.Position - focus).Magnitude > ANIMATE_DISTANCE then
				continue
			end
			local talking = current ~= nil and current.Model == model
			local targetYaw = 0
			if root then
				local offset = base:PointToObjectSpace(root.Position)
				local flat = Vector3.new(offset.X, 0, offset.Z)
				if flat.Magnitude < LOOK_DISTANCE and flat.Magnitude > 0.5 then
					-- ângulo entre a frente (-Z) e a direção do jogador
					targetYaw = math.clamp(math.atan2(-flat.X, -flat.Z), -1.3, 1.3)
				end
			end
			entry.Yaw += (targetYaw - entry.Yaw) * math.min(1, dt * 5)
			-- o Sneaky dá pulinhos de vez em quando (quando tem alguém perto)
			if entry.IsMascot and hopNow and math.abs(targetYaw) > 0 then
				entry.Hop = 1
			end
			local hopY = 0
			if entry.Hop > 0 then
				entry.Hop = math.max(0, entry.Hop - dt * 2.5)
				hopY = math.sin((1 - entry.Hop) * math.pi) * 0.9
			end
			local speed = if talking then 6 else 2
			local bob = math.sin(now * speed + entry.Phase) * (if talking then 0.12 else 0.07)
			model:PivotTo(base * CFrame.new(0, bob + hopY, 0) * CFrame.Angles(0, entry.Yaw, 0))
		end
	end)
end

return NpcUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="487">
        <Properties>
          <string name="Name">PassUI</string>
          <string name="Source"><![CDATA[--[[
	PassUI (ModuleScript em StarterPlayer > StarterPlayerScripts)
	Tela "PASS": temporada atual, nível, barra de XP, os 30 níveis (trilha grátis e paga),
	níveis bônus e o placar da temporada. Recompensas chegam sozinhas ao subir de nível.
	O preço do passe aparece em Robux (lido do Roblox), sem pressão: o tempo que falta é o de verdade.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Seasons = require(Shared:WaitForChild("Seasons"))
local UI = require(script.Parent:WaitForChild("UIKit"))
local Juice = require(script.Parent:WaitForChild("Juice"))

local PassUI = {}

local C = UI.Colors
local create, corner, label, button = UI.create, UI.corner, UI.label, UI.button

local function themeById(id: string?)
	for _, theme in Seasons.Themes do
		if theme.Id == id then
			return theme
		end
	end
	return Seasons.Themes[1]
end

local function timeLeft(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local days = seconds // 86400
	local hours = (seconds % 86400) // 3600
	if days > 0 then
		return ("%dd %dh"):format(days, hours)
	end
	return ("%dh %dm"):format(hours, (seconds % 3600) // 60)
end

function PassUI.Init(ctx)
	local player = Players.LocalPlayer
	local frame, content = ctx.makePanel("Pass", "SEASON PASS", C.Gold)
	create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = content })

	local state: any = nil
	local priceText = "SET ID"
	local productId = Config.DevProducts.SeasonPass or 0
	if productId > 0 then
		priceText = "GET PASS"
		task.spawn(function()
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(productId, Enum.InfoType.Product)
			end)
			if ok and info and info.PriceInRobux then
				priceText = "R$ " .. info.PriceInRobux
			end
		end)
	end

	local xpFill: Frame? = nil
	local xpText: TextLabel? = nil
	local levelText: TextLabel? = nil

	local function clear()
		for _, child in content:GetChildren() do
			if not child:IsA("UIListLayout") then
				child:Destroy()
			end
		end
		xpFill, xpText, levelText = nil, nil, nil
	end

	local function refreshXP()
		if not state or not xpFill or not xpText or not levelText then
			return
		end
		local xp = tonumber(player:GetAttribute("SeasonXP")) or state.XP
		local level, into, need = Seasons.LevelFromXP(xp)
		levelText.Text = if level > Seasons.Levels then ("LEVEL 30 + BONUS %d"):format(level - Seasons.Levels) else ("LEVEL %d / %d"):format(level, Seasons.Levels)
		if need > 0 then
			xpFill.Size = UDim2.fromScale(math.clamp(into / need, 0, 1), 1)
			xpText.Text = ("%d / %d XP"):format(into, need)
		else
			xpFill.Size = UDim2.fromScale(1, 1)
			xpText.Text = "MAX!"
		end
	end

	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	local function render()
		clear()
		order = 0
		if not state then
			label({ LayoutOrder = 1, Size = UDim2.new(1, -12, 0, 40), Text = "Loading...", ZIndex = 5, Parent = content })
			return
		end
		local theme = themeById(state.Theme)
		local serverNow = workspace:GetServerTimeNow()
		label({
			LayoutOrder = nextOrder(),
			Size = UDim2.new(1, -12, 0, 36),
			Text = ("SEASON %d: %s"):format(state.Id, string.upper(theme.Name)),
			TextColor3 = theme.Color,
			ZIndex = 5,
			Parent = content,
		})
		label({
			LayoutOrder = nextOrder(),
			Size = UDim2.new(1, -12, 0, 26),
			Text = "Season ends in " .. timeLeft(state.EndsAt - serverNow),
			TextColor3 = Color3.fromRGB(210, 210, 230),
			StrokeThickness = 1,
			ZIndex = 5,
			Parent = content,
		})
		label({
			LayoutOrder = nextOrder(),
			Size = UDim2.new(1, -12, 0, 26),
			Text = "Rewards arrive by themselves when you level up!",
			TextColor3 = Color3.fromRGB(210, 210, 230),
			StrokeThickness = 1,
			ZIndex = 5,
			Parent = content,
		})
		levelText = label({ LayoutOrder = nextOrder(), Size = UDim2.new(1, -12, 0, 30), Text = "", TextColor3 = C.Gold, ZIndex = 5, Parent = content })
		local bar = create("Frame", {
			LayoutOrder = nextOrder(),
			Size = UDim2.new(1, -40, 0, 30),
			BackgroundColor3 = Color3.fromRGB(25, 25, 40),
			ZIndex = 5,
			Parent = content,
		}, { corner(10), UI.border(C.Dark, 2) })
		xpFill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = theme.Color, ZIndex = 5, Parent = bar }, { corner(10) })
		xpText = label({ Size = UDim2.new(1, -10, 1, -4), Position = UDim2.fromOffset(5, 2), Text = "", ZIndex = 6, Parent = bar })
		refreshXP()

		-- passe
		local hasPass = state.Pass or player:GetAttribute("SeasonPass") == true
		local left = Seasons.Levels - state.PaidGranted
		local passRow = create("Frame", { LayoutOrder = nextOrder(), Size = UDim2.new(1, -12, 0, 90), BackgroundColor3 = C.Row, ZIndex = 5, Parent = content }, { corner(14) })
		label({
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(0.62, -12, 0, 30),
			Text = if hasPass then "SEASON PASS ACTIVE!" elseif left <= 0 then "ALL PASS REWARDS UNLOCKED FOR FREE!" else ("SEASON PASS: +%d rewards left"):format(left),
			TextColor3 = C.Gold,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 5,
			Parent = passRow,
		})
		label({
			Position = UDim2.fromOffset(12, 40),
			Size = UDim2.new(0.62, -12, 0, 42),
			TextWrapped = true,
			Text = if hasPass then "Every PASS reward is yours. Bonus levels give extra cash." else "No pass? PASS rewards unlock for FREE at bonus levels 31-60!",
			TextColor3 = Color3.fromRGB(210, 210, 230),
			TextXAlignment = Enum.TextXAlignment.Left,
			StrokeThickness = 1,
			ZIndex = 5,
			Parent = passRow,
		})
		if not hasPass and left > 0 then
			button({
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.new(0.34, 0, 0, 52),
				BackgroundColor3 = if productId > 0 then C.Gold else C.Gray,
				ZIndex = 5,
				Parent = passRow,
			}, priceText, function()
				ctx.play("Click")
				if productId > 0 then
					MarketplaceService:PromptProductPurchase(player, productId)
				else
					ctx.toast("Studio: put the Season Pass product ID in Config.DevProducts.SeasonPass", "warning")
				end
			end)
		end

		label({
			LayoutOrder = nextOrder(),
			Size = UDim2.new(1, -12, 0, 56),
			Text = ("XP: Hatch +%d | Steal +%d | BONK +%d | Fuse +%d\nRebirth +%d | New world +%d | Daily +%d | Playing +%d/min"):format(
				Seasons.XP.Hatch,
				Seasons.XP.Steal,
				Seasons.XP.Defend,
				Seasons.XP.Fuse,
				Seasons.XP.Rebirth,
				Seasons.XP.World,
				Seasons.XP.Daily,
				Seasons.XP.Minute
			),
			TextWrapped = true,
			TextColor3 = Color3.fromRGB(200, 230, 255),
			StrokeThickness = 1,
			ZIndex = 5,
			Parent = content,
		})

		-- os 30 níveis
		for level = 1, Seasons.Levels do
			local row = create("Frame", { LayoutOrder = nextOrder(), Size = UDim2.new(1, -12, 0, 54), BackgroundColor3 = C.Row, ZIndex = 5, Parent = content }, { corner(12) })
			label({ Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(62, 38), Text = "Lv " .. level, TextColor3 = C.Gold, ZIndex = 5, Parent = row })
			local freeDone = state.Granted >= level
			local paidDone = state.PaidGranted >= level
			local free = create("Frame", {
				Position = UDim2.new(0, 76, 0, 5),
				Size = UDim2.new(0.5, -44, 1, -10),
				BackgroundColor3 = if freeDone then Color3.fromRGB(45, 120, 70) else Color3.fromRGB(45, 45, 70),
				ZIndex = 5,
				Parent = row,
			}, { corner(10) })
			label({
				Size = UDim2.new(1, -10, 1, -6),
				Position = UDim2.fromOffset(5, 3),
				Text = (if freeDone then "\u{2714} " else "") .. Seasons.RewardText(theme, Seasons.Reward(theme, level, "Free")),
				TextWrapped = true,
				StrokeThickness = 1,
				ZIndex = 5,
				Parent = free,
			})
			local paid = create("Frame", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -6, 0, 5),
				Size = UDim2.new(0.5, -44, 1, -10),
				BackgroundColor3 = if paidDone then Color3.fromRGB(150, 110, 30) else Color3.fromRGB(70, 55, 35),
				ZIndex = 5,
				Parent = row,
			}, { corner(10), UI.border(C.Gold, 2) })
			label({
				Size = UDim2.new(1, -10, 1, -6),
				Position = UDim2.fromOffset(5, 3),
				-- onde itens aleatórios pagos são proibidos (PolicyService), os ovos do passe viram dinheiro fixo
				Text = (if paidDone then "\u{2714} " else "PASS: ")
					.. Seasons.RewardText(theme, if player:GetAttribute("PolicyRandomRestricted") ~= false then Seasons.NoRandom(Seasons.Reward(theme, level, "Paid")) else Seasons.Reward(theme, level, "Paid")),
				TextWrapped = true,
				TextColor3 = if paidDone then C.White else Color3.fromRGB(255, 225, 150),
				StrokeThickness = 1,
				ZIndex = 5,
				Parent = paid,
			})
		end

		label({
			LayoutOrder = nextOrder(),
			Size = UDim2.new(1, -12, 0, 44),
			Text = ("BONUS LEVELS 31-60 (%d XP each): %d/%d done. %s"):format(
				Seasons.BonusCost,
				state.BonusGranted,
				Seasons.BonusLevels,
				if state.Pass then "Each gives 10 min of cash." else "Each unlocks the next PASS reward for free!"
			),
			TextWrapped = true,
			TextColor3 = C.Gold,
			StrokeThickness = 1.5,
			ZIndex = 5,
			Parent = content,
		})

		-- placar
		label({ LayoutOrder = nextOrder(), Size = UDim2.new(1, -12, 0, 32), Text = "SEASON TOP 10", TextColor3 = theme.Color, ZIndex = 5, Parent = content })
		if type(state.Top) ~= "table" or #state.Top == 0 then
			label({
				LayoutOrder = nextOrder(),
				Size = UDim2.new(1, -12, 0, 26),
				Text = "The leaderboard updates every minute (only in the published game).",
				TextColor3 = Color3.fromRGB(200, 200, 220),
				StrokeThickness = 1,
				ZIndex = 5,
				Parent = content,
			})
		else
			for rank, entry in state.Top do
				label({
					LayoutOrder = nextOrder(),
					Size = UDim2.new(1, -40, 0, 26),
					Text = ("%d. %s  -  %s XP"):format(rank, tostring(entry.Name), Format.Short(tonumber(entry.XP) or 0)),
					TextColor3 = if rank == 1 then C.Gold else C.White,
					TextXAlignment = Enum.TextXAlignment.Left,
					StrokeThickness = 1.5,
					ZIndex = 5,
					Parent = content,
				})
			end
		end
	end

	ctx.SeasonEvent.OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" then
			return
		end
		state = payload
		state.Granted = tonumber(state.Granted) or 0
		state.PaidGranted = tonumber(state.PaidGranted) or 0
		state.BonusGranted = tonumber(state.BonusGranted) or 0
		if frame.Visible then
			render()
		end
	end)
	player:GetAttributeChangedSignal("SeasonXP"):Connect(refreshXP)
	player:GetAttributeChangedSignal("SeasonPass"):Connect(function()
		if frame.Visible then
			ctx.RequestEvent:FireServer("SeasonSync")
		end
	end)

	-- subiu de nível: festa (e atualiza a tela se estiver aberta)
	ctx.EffectEvent.OnClientEvent:Connect(function(kind, level)
		if kind ~= "SeasonLevel" then
			return
		end
		ctx.play("Rare")
		Juice.Confetti(ctx.gui, 60)
		ctx.toast("SEASON LEVEL " .. tostring(level) .. "!", "rare")
		if frame.Visible then
			ctx.RequestEvent:FireServer("SeasonSync")
		end
	end)

	ctx.panelOpened.Pass = function()
		ctx.RequestEvent:FireServer("SeasonSync")
		render()
	end
end

return PassUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="488">
        <Properties>
          <string name="Name">PetFollow</string>
          <string name="Source"><![CDATA[--[[
	PetFollow (ModuleScript em StarterPlayer > StarterPlayerScripts)
	Desenha os pets equipados de TODOS os jogadores seguindo o dono, com animação (PetMotion):
	pulinhos ao andar, balanço, amassa/estica, pulo junto com o dono, brincadeiras quando parado.
	Tudo acontece só na tela de cada jogador (o servidor só diz quais pets cada um equipou,
	no atributo "Pets" do jogador), então não pesa o servidor nem a internet.
	No celular: pets longe da câmera somem, pets médios se mexem sem amassar, e o chão é
	conferido poucas vezes por segundo.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Critters = require(Shared:WaitForChild("Critters"))
local Builder = require(Shared:WaitForChild("CritterBuilder"))
local PetMotion = require(script.Parent:WaitForChild("PetMotion"))

local PetFollow = {}

-- cada peça do pet guarda onde fica em relação aos PÉS (para amassar/esticar em volta do chão)
type Piece = {
	Part: BasePart,
	Offset: Vector3, -- posição em relação aos pés
	Rotation: CFrame, -- giro da peça em relação aos pés
	Size: Vector3,
	Axes: { Vector3 }, -- eixos da peça (para amassar certo peças giradas)
	CanResize: boolean,
}

type Pet = {
	Model: Model,
	Pieces: { Piece },
	Parts: { BasePart },
	CFrames: { CFrame },
	Motion: PetMotion.State,
	GroundY: number,
	NextRay: number,
	Squashed: boolean,
	LastScaleY: number,
	Dust: ParticleEmitter?,
}
type View = { Key: string, Pets: { Pet } }

local PET_SIZE = 2.6 -- tamanho máximo de um pet (studs)
local VIEW_DISTANCE = 160
local SQUASH_DISTANCE = 70 -- mais longe que isso o pet anda sem amassar (economiza no celular)
-- lugar de cada pet atrás do dono (+Z = atrás)
local SLOTS = { Vector3.new(-3.4, 0, 3.2), Vector3.new(3.4, 0, 3.2), Vector3.new(0, 0, 5.8) }

local views: { [Player]: View } = {}
local folder: Folder
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function makeDust(root: BasePart, ground: number): ParticleEmitter
	local attachment = Instance.new("Attachment")
	attachment.Name = "Feet"
	attachment.Position = Vector3.new(0, -ground, 0)
	attachment.Parent = root
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Dust"
	emitter.Rate = 0
	emitter.Enabled = true
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(235, 225, 210))
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 1) })
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1.1) })
	emitter.Lifetime = NumberRange.new(0.35, 0.55)
	emitter.Speed = NumberRange.new(1.5, 3)
	emitter.SpreadAngle = Vector2.new(80, 10)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Drag = 4
	emitter.LightEmission = 0
	emitter.Parent = attachment
	return emitter
end

local function buildPet(entry: string, index: number): Pet?
	local id, mutation = string.match(entry, "^([^:]+):?(.*)$")
	local def = id and Critters.ById[id]
	if not def then
		return nil
	end
	local model, root, ground = Builder.Build(def)
	local aura = model:FindFirstChild("Aura")
	if aura then
		aura:Destroy()
	end
	if mutation and mutation ~= "" then
		Builder.ApplyMutation(model, mutation)
	end
	local _, size = model:GetBoundingBox()
	local biggest = math.max(size.X, size.Y, size.Z, 0.1)
	local scale = math.clamp(PET_SIZE / biggest, 0.15, 1)
	pcall(function()
		model:ScaleTo(scale)
	end)
	ground *= scale

	-- "esqueleto" feito à mão: tira as soldas e guarda cada peça em relação aos pés
	local feet = root.CFrame * CFrame.new(0, -ground, 0)
	local pieces: { Piece } = {}
	local parts: { BasePart } = {}
	local cframes: { CFrame } = {}
	local top = 0
	for _, d in model:GetDescendants() do
		if d:IsA("WeldConstraint") or d:IsA("Weld") or d:IsA("Motor6D") then
			d:Destroy()
		end
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
			local relative = feet:ToObjectSpace(part.CFrame)
			local rotation = relative - relative.Position
			table.insert(pieces, {
				Part = part,
				Offset = relative.Position,
				Rotation = rotation,
				Size = part.Size,
				Axes = { rotation.RightVector, rotation.UpVector, rotation.LookVector },
				-- bolas (olhos) ficam sempre redondas: só as outras peças amassam
				CanResize = part ~= root and not (part:IsA("Part") and part.Shape == Enum.PartType.Ball),
			})
			table.insert(parts, part)
			table.insert(cframes, part.CFrame)
			if part ~= root and part.Transparency < 1 then
				top = math.max(top, relative.Position.Y + part.Size.Y / 2)
			end
		end
	end
	model.Parent = folder
	local float = (Config.RarityIndex[def.Rarity] or 1) >= 5 or def.Float == true -- Lendário ou melhor voa
	return {
		Model = model,
		Pieces = pieces,
		Parts = parts,
		CFrames = cframes,
		Motion = PetMotion.new({ Float = float, Size = math.max(top, 0.5), Index = index }),
		GroundY = 0,
		NextRay = 0,
		Squashed = false,
		LastScaleY = 1,
		Dust = if float then nil else makeDust(root, ground),
	}
end

-- quanto um eixo da peça estica com a escala (sx, sy, sz) dos pés
local function stretch(axis: Vector3, sx: number, sy: number, sz: number): number
	return Vector3.new(axis.X * sx, axis.Y * sy, axis.Z * sz).Magnitude
end

-- põe as peças no lugar (amassando/esticando em volta dos pés se squash = true)
local function place(pet: Pet, feet: CFrame, scale: Vector3, squash: boolean)
	local sx, sy, sz = scale.X, scale.Y, scale.Z
	if not squash then
		sx, sy, sz = 1, 1, 1
	end
	local resize = squash and math.abs(sy - pet.LastScaleY) > 0.004
	local unsquash = not squash and pet.Squashed
	for i, piece in pet.Pieces do
		local o = piece.Offset
		pet.CFrames[i] = feet * CFrame.new(o.X * sx, o.Y * sy, o.Z * sz) * piece.Rotation
		if piece.CanResize and (resize or unsquash) then
			local axes = piece.Axes
			local size = piece.Size
			piece.Part.Size = Vector3.new(
				size.X * stretch(axes[1], sx, sy, sz),
				size.Y * stretch(axes[2], sx, sy, sz),
				size.Z * stretch(axes[3], sx, sy, sz)
			)
		end
	end
	if resize or unsquash then
		pet.LastScaleY = sy
	end
	pet.Squashed = squash
	workspace:BulkMoveTo(pet.Parts, pet.CFrames, Enum.BulkMoveMode.FireCFrameChanged)
end

local function clear(player: Player)
	local view = views[player]
	if view then
		for _, pet in view.Pets do
			pet.Model:Destroy()
		end
	end
	views[player] = nil
end

local function refresh(player: Player)
	local key = player:GetAttribute("Pets")
	key = if typeof(key) == "string" then key else ""
	local view = views[player]
	if view and view.Key == key then
		return
	end
	clear(player)
	local pets = {}
	for entry in string.gmatch(key, "[^,]+") do
		if #pets >= #SLOTS then
			break
		end
		local ok, pet = pcall(buildPet, entry, #pets + 1)
		if ok and pet then
			table.insert(pets, pet)
		elseif not ok then
			warn("[PetFollow] could not build pet", entry, pet)
		end
	end
	views[player] = { Key = key, Pets = pets }
end

local function watch(player: Player)
	refresh(player)
	player:GetAttributeChangedSignal("Pets"):Connect(function()
		refresh(player)
	end)
end

local function updateFilter()
	local ignore: { Instance } = { folder }
	local active = workspace:FindFirstChild("ActiveCritters")
	if active then
		table.insert(ignore, active)
	end
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(ignore, other.Character)
		end
	end
	rayParams.FilterDescendantsInstances = ignore
end

function PetFollow.Init()
	folder = Instance.new("Folder")
	folder.Name = "ClientPets"
	folder.Parent = workspace

	for _, other in Players:GetPlayers() do
		watch(other)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(clear)

	local nextFilter = 0
	RunService.RenderStepped:Connect(function(dt)
		local now = os.clock()
		if now >= nextFilter then
			nextFilter = now + 1
			updateFilter()
		end
		local camera = workspace.CurrentCamera
		local cameraPosition = if camera then camera.CFrame.Position else Vector3.zero
		local localPlayer = Players.LocalPlayer
		local hideOthers = localPlayer:GetAttribute("ShowOtherPets") == false
		local lowGfx = localPlayer:GetAttribute("LowGfx") == true
		local range = if lowGfx then VIEW_DISTANCE * 0.5 else VIEW_DISTANCE
		for owner, view in views do
			local character = owner.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local distance = if root then (root.Position - cameraPosition).Magnitude else math.huge
			local visible = root ~= nil
				and distance < range
				and not (hideOthers and owner ~= localPlayer)
				and not owner:GetAttribute("HidePets") -- esconde-esconde: os pets não entregam o esconderijo
			-- o dono pulou? (velocidade para cima; funciona para todos os jogadores)
			local rising = root ~= nil and root.AssemblyLinearVelocity.Y > 9
			local squash = not lowGfx and distance < SQUASH_DISTANCE
			for index, pet in view.Pets do
				if not visible or not root then
					if pet.Model.Parent then
						pet.Model.Parent = nil
					end
					pet.Motion.Position = nil
					continue
				end
				if not pet.Model.Parent then
					pet.Model.Parent = folder
				end
				local look = root.CFrame.LookVector
				local flatLook = Vector3.new(look.X, 0, look.Z)
				if flatLook.Magnitude < 0.01 then
					flatLook = Vector3.new(0, 0, -1)
				end
				flatLook = flatLook.Unit
				local facing = CFrame.lookAt(root.Position, root.Position + flatLook)
				local target = (facing * CFrame.new(SLOTS[index])).Position
				-- chão (poucas vezes por segundo)
				local here = pet.Motion.Position or target
				if now >= pet.NextRay then
					pet.NextRay = now + 0.12 + math.random() * 0.05
					local hit = workspace:Raycast(Vector3.new(here.X, root.Position.Y + 4, here.Z), Vector3.new(0, -24, 0), rayParams)
					pet.GroundY = if hit then hit.Position.Y else root.Position.Y - 3
				end
				local pose = PetMotion.Step(pet.Motion, dt, {
					Target = target,
					OwnerLook = flatLook,
					OwnerRising = rising,
					GroundY = pet.GroundY,
					Now = now,
				})
				place(pet, pose.CFrame, pose.Scale, squash)
				if pose.Landed and pet.Dust and squash then
					pet.Dust:Emit(if pose.Speed > 10 then 4 else 2)
				end
			end
		end
	end)
end

return PetFollow
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="489">
        <Properties>
          <string name="Name">PetMotion</string>
          <string name="Source"><![CDATA[--[[
	PetMotion (ModuleScript em StarterPlayer > StarterPlayerScripts)
	A "animação" dos pets que seguem o jogador. Só conta; quem move as peças é o PetFollow.
	Os modelos 3D são uma peça só (sem ossos), então a animação é feita mexendo o corpo inteiro:
	  • andando: pulinhos no ritmo da velocidade, balanço de um lado pro outro, inclina pra frente,
	    amassa quando pisa e estica no ar (sem mudar o volume), inclina nas curvas
	  • parado: respira, olha para os lados, dá pulinhos de alegria, gira ou se sacode de vez em quando
	  • dono pulou: o pet pula junto (cada um com um tiquinho de atraso) e amassa ao cair
	  • voadores (Lendário ou melhor): flutuam, batem "asas" (esticadinha rápida) e inclinam nas curvas
	Tudo roda só na tela de cada jogador.
]]

local PetMotion = {}

local TAU = math.pi * 2
local GRAVITY = 70
local MAX_SPEED = 42
local TELEPORT = 60

export type State = {
	Float: boolean,
	Size: number,
	Phase: number,
	Index: number,
	Seed: number,
	Position: Vector3?,
	Velocity: Vector3,
	Yaw: number,
	YawRate: number,
	Step: number,
	Moving: number,
	JumpY: number,
	JumpVel: number,
	JumpDelay: number,
	Squash: number,
	SquashVel: number,
	IdleFor: number,
	NextIdle: number,
	Action: string?,
	ActionT: number,
	WasOwnerUp: boolean,
}

export type Input = {
	Target: Vector3, -- lugar do pet atrás do dono
	OwnerLook: Vector3, -- para onde o dono olha (sem Y)
	OwnerRising: boolean, -- o dono está subindo (pulou)
	GroundY: number, -- altura do chão embaixo do pet
	Now: number,
}

export type Pose = {
	CFrame: CFrame, -- os PÉS do pet (centro embaixo), olhando para -Z
	Scale: Vector3, -- amassa/estica (X e Z iguais, Y diferente; volume ~1)
	Landed: boolean, -- acabou de pisar (poeirinha)
	Speed: number,
}

-- número "aleatório" fixo por pet (para cada pet ter o seu jeito)
local function hash(n: number): number
	local x = math.sin(n * 12.9898 + 78.233) * 43758.5453
	return x - math.floor(x)
end

local function angleDelta(from: number, to: number): number
	local d = (to - from) % TAU
	if d > math.pi then
		d -= TAU
	end
	return d
end

local function yawOf(direction: Vector3): number
	return math.atan2(-direction.X, -direction.Z)
end

function PetMotion.YawOf(direction: Vector3): number
	return yawOf(direction)
end

function PetMotion.new(options: { Float: boolean?, Size: number?, Index: number?, Seed: number? }): State
	local seed = options.Seed or math.random() * 1000
	return {
		Float = options.Float == true,
		Size = math.clamp(options.Size or 2, 0.4, 6),
		Phase = hash(seed) * TAU,
		Index = options.Index or 1,
		Seed = seed,
		Position = nil,
		Velocity = Vector3.zero,
		Yaw = 0,
		YawRate = 0,
		Step = 0,
		Moving = 0,
		JumpY = 0,
		JumpVel = 0,
		JumpDelay = -1,
		Squash = 0,
		SquashVel = 0,
		IdleFor = 0,
		NextIdle = 2 + hash(seed + 1) * 4,
		Action = nil,
		ActionT = 0,
		WasOwnerUp = false,
	}
end

-- próxima brincadeira de quando o pet está parado
local IDLE_ACTIONS = { "hop", "look", "spin", "wiggle", "hop", "look" }
local ACTION_TIME = { hop = 0.75, look = 1.8, spin = 0.7, wiggle = 0.55, loop = 1.1 }

local function pickAction(state: State, now: number): string
	local roll = hash(state.Seed + math.floor(now * 3))
	if state.Float then
		return if roll < 0.35 then "loop" elseif roll < 0.7 then "look" else "wiggle"
	end
	return IDLE_ACTIONS[1 + math.floor(roll * #IDLE_ACTIONS) % #IDLE_ACTIONS]
end

function PetMotion.Step(state: State, dt: number, input: Input): Pose
	dt = math.clamp(dt, 0, 0.1)
	local size = state.Size
	local sizeFactor = math.clamp(size / 2, 0.5, 1.4)
	local now = input.Now

	-- 1) SEGUIR: a velocidade vai atrás do lugar dele (suave, igual em 30 ou 60 FPS)
	local target = Vector3.new(input.Target.X, 0, input.Target.Z)
	local position = state.Position
	local landed = false
	if not position or (position - target).Magnitude > TELEPORT then
		position = target -- dono teleportou: o pet vai junto
		state.Velocity = Vector3.zero
	end
	local toTarget = target - position
	local distance = toTarget.Magnitude
	local wanted = toTarget * 6
	if wanted.Magnitude > MAX_SPEED then
		wanted = wanted.Unit * MAX_SPEED
	end
	if distance < 0.15 then
		wanted = Vector3.zero
	end
	state.Velocity = state.Velocity:Lerp(wanted, 1 - math.exp(-dt * 9))
	position += state.Velocity * dt
	state.Position = position
	local speed = state.Velocity.Magnitude
	local movingGoal = math.clamp((speed - 1) / 6, 0, 1)
	state.Moving += (movingGoal - state.Moving) * (1 - math.exp(-dt * 8))
	local moving = state.Moving

	-- 2) VIRAR: andando olha para onde vai; parado olha para onde o dono olha
	local look = input.OwnerLook
	local wantedYaw = if speed > 1.5 then yawOf(state.Velocity) else yawOf(if look.Magnitude > 0.01 then look else Vector3.new(0, 0, -1))
	local turn = angleDelta(state.Yaw, wantedYaw) * (1 - math.exp(-dt * 9))
	state.Yaw += turn
	local yawRate = if dt > 0 then turn / dt else 0
	state.YawRate += (yawRate - state.YawRate) * (1 - math.exp(-dt * 10))

	-- 3) PULO JUNTO COM O DONO (cada pet com um pouquinho de atraso)
	local ownerUp = input.OwnerRising
	if ownerUp and not state.WasOwnerUp and state.JumpY <= 0.01 and state.JumpDelay < 0 then
		state.JumpDelay = 0.05 + 0.07 * (state.Index - 1)
	end
	state.WasOwnerUp = ownerUp
	if state.JumpDelay >= 0 then
		state.JumpDelay -= dt
		if state.JumpDelay < 0 then
			state.JumpVel = (if state.Float then 10 else 17) * math.sqrt(sizeFactor)
			state.Squash = 0.14 -- estica ao sair do chão
		end
	end
	if state.JumpY > 0 or state.JumpVel > 0 then
		state.JumpVel -= GRAVITY * dt
		state.JumpY += state.JumpVel * dt
		if state.JumpY <= 0 then
			state.JumpY = 0
			if state.JumpVel < -4 and not state.Float then
				state.Squash = -0.28 -- amassa ao cair
				landed = true
			end
			state.JumpVel = 0
		end
	end

	-- 4) BRINCADEIRAS QUANDO PARADO
	if moving < 0.1 and state.JumpY <= 0 then
		state.IdleFor += dt
	else
		state.IdleFor = 0
		if state.Action and state.Action ~= "look" then
			state.Action = nil
		end
	end
	if not state.Action and state.IdleFor > 1.2 and state.IdleFor >= state.NextIdle then
		state.Action = pickAction(state, now)
		state.ActionT = 0
		state.IdleFor = 0
		state.NextIdle = 3.5 + hash(state.Seed + now) * 5
	end
	local actionYaw, actionRoll, actionPitch, actionHop = 0, 0, 0, 0
	if state.Action then
		state.ActionT += dt
		local total = ACTION_TIME[state.Action] or 1
		local t = math.clamp(state.ActionT / total, 0, 1)
		if state.Action == "hop" then
			-- dois pulinhos de alegria
			local k = (t * 2) % 1
			actionHop = 4 * k * (1 - k) * 0.55 * sizeFactor
			if state.ActionT + dt >= total * 0.5 and state.ActionT < total * 0.5 then
				state.Squash = -0.18
			end
		elseif state.Action == "look" then
			actionYaw = math.sin(t * TAU) * math.rad(35) * (if hash(state.Seed + 7) > 0.5 then 1 else -1)
		elseif state.Action == "spin" then
			local e = t * t * (3 - 2 * t)
			actionYaw = e * TAU
			actionHop = 4 * t * (1 - t) * 0.35 * sizeFactor
		elseif state.Action == "wiggle" then
			actionRoll = math.sin(t * TAU * 3) * math.rad(12) * (1 - t)
		elseif state.Action == "loop" then
			-- voador dá uma cambalhota
			local e = t * t * (3 - 2 * t)
			actionPitch = -e * TAU
			actionHop = math.sin(t * math.pi) * 0.8 * sizeFactor
		end
		if t >= 1 then
			if state.Action == "hop" or state.Action == "spin" then
				state.Squash = -0.2
				landed = state.Action == "hop"
			end
			state.Action = nil
		end
	end

	-- 5) ANDAR: pulinhos no ritmo da velocidade (termina o pulo antes de parar)
	local hop, stepSquash, roll, pitch = 0, 0, 0, 0
	local breathe = 0
	if state.Float then
		local rate = 2.4 + moving * 1.6
		hop = 2.2 * sizeFactor + math.sin(now * rate + state.Phase) * 0.35 * sizeFactor
		pitch = -math.rad(16) * math.clamp(speed / 22, 0, 1)
		roll = math.sin(now * 1.3 + state.Phase) * math.rad(5) * (1 - moving)
		-- "bater asas": estica rapidinho
		breathe = math.sin(now * (if moving > 0.3 then 11 else 4) + state.Phase) * (0.02 + 0.035 * moving)
	else
		local stepRate = math.clamp(1.7 + speed * 0.13, 1.7, 4.4)
		local frac = state.Step % 1
		if moving > 0.05 or frac > 0.02 then
			local before = state.Step
			state.Step += dt * stepRate
			if math.floor(state.Step) > math.floor(before) then
				-- pisou
				if moving < 0.05 then
					state.Step = math.floor(state.Step) -- parou no chão
				end
				stepSquash = 0
				if speed > 6 then
					landed = true
				end
				state.Squash = math.min(state.Squash, -0.12 - 0.1 * moving)
			end
		end
		local t = state.Step % 1
		local amount = math.max(moving, if t > 0.02 then 0.35 else 0)
		hop = 4 * t * (1 - t) * math.clamp(0.28 + speed * 0.022, 0.28, 0.7) * sizeFactor * amount
		stepSquash = 4 * t * (1 - t) * 0.08 * amount -- estica no ar
		roll = math.sin(state.Step * math.pi) * math.rad(8) * moving -- balança de um lado pro outro
		pitch = -math.rad(11) * math.clamp(speed / 20, 0, 1) -- inclina pra frente correndo
		breathe = math.sin(now * 2.2 + state.Phase) * 0.035 * (1 - moving)
	end
	-- inclina nas curvas
	roll += math.clamp(state.YawRate * (if state.Float then 0.1 else 0.05), -0.35, 0.35)

	-- 6) MOLA DO AMASSA/ESTICA (balança um pouco e volta ao normal)
	state.SquashVel += (-state.Squash * 260 - state.SquashVel * 14) * dt
	state.Squash += state.SquashVel * dt
	state.Squash = math.clamp(state.Squash, -0.4, 0.4)

	local sy = math.clamp(1 + state.Squash + stepSquash + breathe, 0.6, 1.4)
	local sxz = 1 / math.sqrt(sy)

	local y = input.GroundY + hop + state.JumpY + actionHop
	-- gira em volta de um ponto do corpo (perto dos pés andando, no meio voando/dando cambalhota)
	local pivotY = size * (if state.Float or state.Action == "loop" then 0.5 else 0.3)
	local feet = CFrame.new(position.X, y + pivotY, position.Z)
		* CFrame.Angles(0, state.Yaw + actionYaw, 0)
		* CFrame.Angles(pitch + actionPitch, 0, 0)
		* CFrame.Angles(0, 0, roll + actionRoll)
		* CFrame.new(0, -pivotY, 0)
	return {
		CFrame = feet,
		Scale = Vector3.new(sxz, sy, sxz),
		Landed = landed,
		Speed = speed,
	}
end

return PetMotion
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="490">
        <Properties>
          <string name="Name">RetentionUI</string>
          <string name="Source"><![CDATA[--[[
	RetentionUI (ModuleScript em StarterPlayer > StarterPlayerScripts)
	v23: o que faz o jogador ficar e voltar.
	  • PRESENTE DE TEMPO DE JOGO: chip na coluna da esquerda com a contagem ("Gift in 2:31");
	    quando fica pronto vira um botão verde pulsando ("CLAIM: Spotted Egg!"). Clicou = pede ao servidor.
	  • ROLETA DIÁRIA: botão SPIN no menu (bolinha vermelha quando tem giro). A janela mostra uma "esteira"
	    de prêmios que corre e para no prêmio que o SERVIDOR sorteou (Effect "Spin" { Index }).
	    Embaixo, a chance (%) de cada prêmio. 1 giro grátis por dia; nunca custa Robux.
	A tela só pede; quem decide e entrega é o servidor (Retention.luau).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local UI = require(script.Parent:WaitForChild("UIKit"))
local Juice = require(script.Parent:WaitForChild("Juice"))

local RetentionUI = {}

local C = UI.Colors
local create, corner, label, button = UI.create, UI.corner, UI.label, UI.button

local CARD = 118
local GAP = 10
local LAPS = 4 -- quantas voltas a esteira dá antes de parar

function RetentionUI.Init(ctx)
	local player = Players.LocalPlayer
	local stack = ctx.leftStack or ctx.gui
	local W = ctx.stackWidth or 260

	---------------------------------------------------------------------
	-- Presente de tempo de jogo (chip / botão na coluna da esquerda)
	---------------------------------------------------------------------
	local giftButton, giftText = button({
		Name = "GiftChip",
		LayoutOrder = 22,
		Size = UDim2.fromOffset(W, 32),
		BackgroundColor3 = C.Dark,
		ZIndex = 31,
		Parent = stack,
	}, "", function()
		if (tonumber(player:GetAttribute("GiftReadyAt")) or math.huge) <= os.time() then
			ctx.play("Click")
			ctx.RequestEvent:FireServer("GiftClaim")
		end
	end)
	giftText.TextXAlignment = Enum.TextXAlignment.Left
	local giftReady = false
	local pulseT = 0

	local function refreshGift(dt: number)
		local readyAt = tonumber(player:GetAttribute("GiftReadyAt"))
		local name = tostring(player:GetAttribute("GiftName") or "Gift")
		if not readyAt then
			giftButton.Visible = false
			return
		end
		giftButton.Visible = true
		local left = readyAt - os.time()
		if left > 0 then
			if giftReady then
				giftReady = false
				giftButton.BackgroundColor3 = C.Dark
			end
			giftText.Text = ("\u{1F381} Gift in %s: %s"):format(Format.Time(left), name)
		else
			if not giftReady then
				giftReady = true
				giftButton.BackgroundColor3 = C.Green
				UI.popIn(giftButton)
				ctx.play("Coin")
			end
			pulseT += dt
			giftText.Text = ("\u{1F381} CLAIM GIFT: %s!"):format(name)
			giftButton.BackgroundColor3 = C.Green:Lerp(Color3.fromRGB(150, 255, 160), (math.sin(pulseT * 5) + 1) / 2)
		end
	end

	---------------------------------------------------------------------
	-- Roleta diária
	---------------------------------------------------------------------
	local frame, content = ctx.makePanel("Spin", "DAILY SPIN - 1 FREE SPIN A DAY!", C.Gold)
	local menuButton = ctx.menuButton(-3, "\u{1F3B0}", "SPIN", C.Gold, function()
		ctx.openPanel("Spin")
	end)
	local dot = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -8, 0, 8),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = C.Red,
		Visible = false,
		ZIndex = 8,
		Parent = menuButton,
	}, { corner(9), UI.border(C.White, 2) })

	local prizes = Config.DailySpin
	local total = 0
	for _, prize in prizes do
		total += prize.Weight
	end

	-- esteira de prêmios
	local track = create("Frame", {
		Position = UDim2.fromOffset(0, 6),
		Size = UDim2.new(1, 0, 0, CARD + 20),
		BackgroundColor3 = C.Dark,
		ClipsDescendants = true,
		ZIndex = 5,
		Parent = content,
	}, { corner(14) })
	local strip = create("Frame", {
		Position = UDim2.fromOffset(0, 10),
		Size = UDim2.fromOffset((CARD + GAP) * #prizes * (LAPS + 2), CARD),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = track,
	})
	local cards = {}
	for copy = 0, LAPS + 1 do
		for i, prize in prizes do
			local index = copy * #prizes + i
			local card = create("Frame", {
				Position = UDim2.fromOffset((index - 1) * (CARD + GAP), 0),
				Size = UDim2.fromOffset(CARD, CARD),
				BackgroundColor3 = prize.Color or C.Row,
				ZIndex = 6,
				Parent = strip,
			}, { corner(14), UI.border(C.Dark, 3) })
			label({ Size = UDim2.new(1, -10, 0.5, 0), Position = UDim2.fromOffset(5, 6), Text = if prize.Egg then "\u{1F95A}" elseif prize.Boost then "\u{26A1}" else "\u{1F4B0}", StrokeThickness = 0, ZIndex = 7, Parent = card })
			label({ Size = UDim2.new(1, -10, 0.36, 0), Position = UDim2.new(0, 5, 0.58, 0), Text = prize.Name, TextWrapped = true, StrokeThickness = 1.5, ZIndex = 7, Parent = card })
			cards[index] = card
		end
	end
	-- ponteiro no meio
	create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(0, 6, 1, 0),
		BackgroundColor3 = C.Gold,
		BorderSizePixel = 0,
		ZIndex = 9,
		Parent = track,
	}, { corner(3) })

	local spinButton, spinText = button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, CARD + 36),
		Size = UDim2.fromOffset(260, 56),
		BackgroundColor3 = C.Green,
		ZIndex = 6,
		Parent = content,
	}, "SPIN!", function()
		if player:GetAttribute("SpinReady") == true then
			ctx.play("Click")
			ctx.RequestEvent:FireServer("SpinDaily")
		else
			ctx.toast("You already spun today! Come back tomorrow.", "info")
		end
	end)
	local resultLabel = label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, CARD + 98),
		Size = UDim2.new(1, -20, 0, 30),
		Text = "",
		TextColor3 = C.Gold,
		ZIndex = 6,
		Parent = content,
	})
	-- chances de cada prêmio (transparência total: é grátis, mas a criança sabe o que pode sair)
	local odds = create("Frame", {
		Position = UDim2.new(0, 0, 0, CARD + 134),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = content,
	}, {
		create("UIGridLayout", {
			CellSize = UDim2.new(0.5, -6, 0, 26),
			CellPadding = UDim2.fromOffset(6, 4),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i, prize in prizes do
		local row = create("Frame", { LayoutOrder = i, BackgroundColor3 = C.Row, ZIndex = 5, Parent = odds }, { corner(8) })
		create("Frame", { Size = UDim2.new(0, 10, 1, -8), Position = UDim2.fromOffset(6, 4), BackgroundColor3 = prize.Color or C.White, BorderSizePixel = 0, ZIndex = 6, Parent = row }, { corner(4) })
		label({ Size = UDim2.new(1, -60, 1, -6), Position = UDim2.fromOffset(22, 3), Text = prize.Name, TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 1, ZIndex = 6, Parent = row })
		label({ AnchorPoint = Vector2.new(1, 0), Size = UDim2.fromOffset(52, 20), Position = UDim2.new(1, -6, 0, 3), Text = string.format("%.1f%%", prize.Weight / total * 100), TextColor3 = C.Gold, StrokeThickness = 1, ZIndex = 6, Parent = row })
	end

	local spinning = false
	local function trackWidth(): number
		return if track.AbsoluteSize.X > 50 then track.AbsoluteSize.X else 570
	end
	local function resetStrip()
		strip.Position = UDim2.fromOffset(trackWidth() / 2 - CARD / 2, 10)
	end

	local function refreshSpin()
		local ready = player:GetAttribute("SpinReady") == true
		dot.Visible = ready
		if spinning then
			return
		end
		if ready then
			spinText.Text = "SPIN!"
			spinButton.BackgroundColor3 = C.Green
		else
			local secondsLeft = 86400 - (os.time() % 86400)
			spinText.Text = "Next spin in " .. Format.Time(secondsLeft)
			spinButton.BackgroundColor3 = C.Gray
		end
	end

	local function animateTo(index: number)
		spinning = true
		resultLabel.Text = ""
		resetStrip()
		local targetIndex = LAPS * #prizes + index -- a cópia da volta LAPS
		local landX = (targetIndex - 1) * (CARD + GAP)
		local jitter = math.random(-CARD * 0.3, CARD * 0.3)
		local finalX = trackWidth() / 2 - CARD / 2 - landX + jitter
		spinText.Text = "..."
		ctx.play("Click")
		local tween = TweenService:Create(strip, TweenInfo.new(2.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = UDim2.fromOffset(finalX, 10) })
		tween:Play()
		-- "tec tec" enquanto passa pelos cards
		task.spawn(function()
			local lastCard = -1
			local started = os.clock()
			while os.clock() - started < 2.5 do
				local center = trackWidth() / 2
				local passing = math.floor((center - strip.Position.X.Offset) / (CARD + GAP))
				if passing ~= lastCard then
					lastCard = passing
					ctx.play("Click")
				end
				RunService.RenderStepped:Wait()
			end
		end)
		tween.Completed:Wait()
		local prize = prizes[index]
		local card = cards[targetIndex]
		if card then
			UI.pulse(card, 0.2)
		end
		resultLabel.Text = "YOU WON: " .. string.upper(prize.Name) .. "!"
		ctx.play("Rare")
		Juice.Confetti(ctx.gui, if index >= #prizes - 1 then 120 else 50, { prize.Color or C.Gold, C.White })
		if index >= #prizes - 1 then
			ctx.bigText("JACKPOT!", C.Gold)
			Juice.Shake(0.8, 0.6)
		end
		spinning = false
		refreshSpin()
	end

	ctx.panelOpened.Spin = function()
		resetStrip()
		refreshSpin()
	end
	ctx.EffectEvent.OnClientEvent:Connect(function(kind, data)
		if kind == "Spin" and type(data) == "table" and type(data.Index) == "number" then
			if not frame.Visible then
				ctx.openPanel("Spin")
			end
			task.spawn(animateTo, data.Index)
		end
	end)
	player:GetAttributeChangedSignal("SpinReady"):Connect(refreshSpin)

	-- primeira vez que a roleta fica pronta na sessão: avisa
	local toldSpin = false
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		refreshGift(dt)
		if elapsed >= 1 then
			elapsed = 0
			refreshSpin()
			if not toldSpin and player:GetAttribute("SpinReady") == true and player:GetAttribute("Loaded") then
				toldSpin = true
				task.delay(20, function()
					if player:GetAttribute("SpinReady") == true then
						ctx.toast("\u{1F3B0} Your FREE daily spin is ready! Tap SPIN.", "rare")
					end
				end)
			end
		end
	end)
	refreshSpin()
	return frame
end

return RetentionUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="491">
        <Properties>
          <string name="Name">SettingsUI</string>
          <string name="Source"><![CDATA[--[[
	SettingsUI (ModuleScript em StarterPlayer > StarterPlayerScripts)
	Parte 17: tela "SETTINGS" e controle de videogame.
	  • Gráficos leves: desliga brilho, raios de sol, sombras e partículas (celular antigo roda melhor)
	  • Pets dos outros, números de dinheiro, volume dos sons e tremor da câmera
	  • As escolhas ficam salvas no servidor (valem em qualquer aparelho)
	  • Se o jogo ficar lento (menos de 25 FPS por 20 s), sugere ligar os gráficos leves
	  • Controle (Xbox/PlayStation): SELECT navega nos menus, B fecha a janela aberta
	Os outros scripts leem os atributos do jogador local: LowGfx, ShowOtherPets, MoneyPops, CameraShake.
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local HttpService = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent:WaitForChild("UIKit"))

local SettingsUI = {}

local C = UI.Colors
local create, corner, label, button = UI.create, UI.corner, UI.label, UI.button

local settings = { LowGfx = false, OtherPets = true, MoneyPops = true, Sfx = 1, Shake = true, Music = true }

-- v26: MÚSICA DE FUNDO (sons oficiais da Roblox, grátis). Uma lista que vai passando; volume baixo.
local MUSIC_TRACKS = {
	"rbxassetid://15675069601", -- Roblox_UI_Loop_Calm_Music
	"rbxassetid://15930255433", -- Roblox_RetroFluteMusic_01
	"rbxassetid://17422163655", -- Generic - Cloud Blitz
	"rbxassetid://130053244401794", -- TutorialMusic_01
}
local MUSIC_VOLUME = 0.18
local musicSound: Sound? = nil
local musicIndex = 0

local function nextTrack()
	if not musicSound then
		return
	end
	musicIndex = (musicIndex % #MUSIC_TRACKS) + 1
	musicSound.SoundId = MUSIC_TRACKS[musicIndex]
	musicSound:Play()
end

local function applyMusic(on: boolean)
	if on and not musicSound then
		local sound = Instance.new("Sound")
		sound.Name = "Music"
		sound.Volume = MUSIC_VOLUME
		sound.Looped = false
		sound.Parent = SoundService
		sound.Ended:Connect(function()
			if settings.Music then
				task.wait(1.5)
				nextTrack()
			end
		end)
		musicSound = sound
		musicIndex = math.random(0, #MUSIC_TRACKS - 1)
		nextTrack()
	elseif musicSound then
		if on then
			if not musicSound.IsPlaying then
				nextTrack()
			end
		else
			musicSound:Stop()
		end
	end
end

---------------------------------------------------------------------
-- Gráficos leves
---------------------------------------------------------------------
-- (tabela "fraca": peças destruídas somem daqui sozinhas, sem gastar memória)
local original: { [Instance]: { [string]: any } } = setmetatable({}, { __mode = "k" }) :: any
local appliedLow: boolean? = nil
local particleConnection: RBXScriptConnection? = nil

local function remember(instance: Instance, property: string)
	original[instance] = original[instance] or {}
	if original[instance][property] == nil then
		original[instance][property] = (instance :: any)[property]
	end
end

local function setParticles(enabled: boolean, root: Instance)
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("ParticleEmitter") or descendant:IsA("Sparkles") then
			if not enabled then
				remember(descendant, "Enabled")
				descendant.Enabled = false
			elseif original[descendant] and original[descendant].Enabled ~= nil then
				descendant.Enabled = original[descendant].Enabled
			end
		end
	end
end

local function applyGraphics(low: boolean)
	if appliedLow == low then
		return -- só varre o mapa quando a opção muda de verdade
	end
	appliedLow = low
	for _, effect in Lighting:GetChildren() do
		if effect:IsA("BloomEffect") or effect:IsA("SunRaysEffect") or effect:IsA("DepthOfFieldEffect") then
			remember(effect, "Enabled")
			effect.Enabled = if low then false else original[effect].Enabled
		elseif effect:IsA("Atmosphere") then
			remember(effect, "Density")
			effect.Density = if low then original[effect].Density * 0.5 else original[effect].Density
		end
	end
	remember(Lighting, "GlobalShadows")
	Lighting.GlobalShadows = if low then false else original[Lighting].GlobalShadows
	setParticles(not low, workspace)
	if particleConnection then
		particleConnection:Disconnect()
		particleConnection = nil
	end
	if low then
		particleConnection = workspace.DescendantAdded:Connect(function(descendant)
			if descendant:IsA("ParticleEmitter") or descendant:IsA("Sparkles") then
				remember(descendant, "Enabled")
				descendant.Enabled = false
			end
		end)
	end
end

local function applyAll()
	local player = Players.LocalPlayer
	player:SetAttribute("LowGfx", settings.LowGfx)
	player:SetAttribute("ShowOtherPets", settings.OtherPets)
	player:SetAttribute("MoneyPops", settings.MoneyPops)
	player:SetAttribute("CameraShake", settings.Shake)
	applyGraphics(settings.LowGfx)
	-- todos os sons do jogo estão no grupo SFX (inclusive o taco, que vem do servidor)
	local group = SoundService:FindFirstChild("SFX")
	if group and group:IsA("SoundGroup") then
		group.Volume = settings.Sfx
	end
	applyMusic(settings.Music)
end

function SettingsUI.Init(ctx)
	local player = Players.LocalPlayer
	local frame, content = ctx.makePanel("Settings", "SETTINGS", C.Blue)
	create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = content })

	local saveToken = 0
	local function save()
		saveToken += 1
		local token = saveToken
		task.delay(0.6, function()
			if token ~= saveToken then
				return
			end
			ctx.RequestEvent:FireServer("SaveSettings", settings)
			-- confere depois de 2 s: se o servidor não recebeu (pedido descartado), manda de novo
			task.delay(2, function()
				if token ~= saveToken then
					return
				end
				local ok, saved = pcall(function()
					return HttpService:JSONDecode(player:GetAttribute("Settings") or "{}")
				end)
				if ok and type(saved) == "table" then
					for key, value in settings do
						if saved[key] ~= value then
							ctx.RequestEvent:FireServer("SaveSettings", settings)
							break
						end
					end
				end
			end)
		end)
	end

	local refreshers = {}
	local function toggleRow(order: number, title: string, key: string)
		local row = create("Frame", { LayoutOrder = order, Size = UDim2.new(1, -12, 0, 64), BackgroundColor3 = C.Row, ZIndex = 5, Parent = content }, { corner(14) })
		label({ Position = UDim2.fromOffset(14, 8), Size = UDim2.new(0.62, -14, 1, -16), Text = title, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5, Parent = row })
		local btn, text = button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.new(0.32, 0, 0, 48),
			BackgroundColor3 = C.Green,
			ZIndex = 5,
			Parent = row,
		}, "", function()
			ctx.play("Click")
			if key == "Sfx" then
				settings.Sfx = if settings.Sfx == 1 then 0.5 elseif settings.Sfx == 0.5 then 0 else 1
			else
				settings[key] = not settings[key]
			end
			applyAll()
			for _, refresh in refreshers do
				refresh()
			end
			save()
		end)
		table.insert(refreshers, function()
			local value = settings[key]
			if key == "Sfx" then
				text.Text = if value == 1 then "100%" elseif value == 0.5 then "50%" else "OFF"
				btn.BackgroundColor3 = if value == 0 then C.Gray else C.Green
			else
				text.Text = if value then "ON" else "OFF"
				btn.BackgroundColor3 = if value then C.Green else C.Gray
			end
		end)
	end
	toggleRow(1, "Low graphics (faster on old phones)", "LowGfx")
	toggleRow(2, "Other players' pets", "OtherPets")
	toggleRow(3, "Money numbers", "MoneyPops")
	toggleRow(4, "Sound effects", "Sfx")
	toggleRow(5, "Camera shake", "Shake")
	toggleRow(6, "Music", "Music")
	for order, text in { "Saved on every device you play on.", "Language: Roblox uses your account language by itself.", "Controller: press SELECT for the menus and B to close." } do
		label({
			LayoutOrder = 10 + order,
			Size = UDim2.new(1, -12, 0, 28),
			Text = text,
			TextColor3 = Color3.fromRGB(200, 215, 240),
			StrokeThickness = 1,
			ZIndex = 5,
			Parent = content,
		})
	end
	local function refreshAll()
		for _, refresh in refreshers do
			refresh()
		end
	end

	-- configurações salvas (o servidor manda no atributo "Settings")
	local loadedOnce = false
	local function loadSaved()
		-- só a primeira vez: depois disso quem manda é o que o jogador escolhe nesta tela
		if loadedOnce then
			return
		end
		local raw = player:GetAttribute("Settings")
		if typeof(raw) ~= "string" then
			return
		end
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if ok and type(decoded) == "table" then
			loadedOnce = true
			for key, default in settings do
				local value = decoded[key]
				if type(value) == type(default) then
					settings[key] = value
				end
			end
			applyAll()
			refreshAll()
		end
	end
	loadSaved()
	player:GetAttributeChangedSignal("Settings"):Connect(loadSaved)
	applyAll()
	refreshAll()

	-- jogo lento: sugere os gráficos leves (1 vez por sessão)
	task.spawn(function()
		local frames, elapsed, slowFor, suggested = 0, 0, 0, false
		RunService.Heartbeat:Connect(function(dt)
			frames += 1
			elapsed += dt
			if elapsed >= 2 then
				local fps = frames / elapsed
				frames, elapsed = 0, 0
				slowFor = if fps < 25 then slowFor + 2 else 0
				if slowFor >= 20 and not suggested and not settings.LowGfx then
					suggested = true
					ctx.toast("Game running slow? Turn on LOW GRAPHICS in SETTINGS!", "warning")
				end
			end
		end)
	end)

	-- Controle: B fecha a janela aberta; dica "SELECT = menus"
	local hint = label({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -8), -- v21: canto de baixo (o menu subiu)
		Size = UDim2.fromOffset(200, 26),
		Text = "SELECT = menus",
		TextColor3 = C.Gold,
		Visible = UserInputService.GamepadEnabled,
		Parent = ctx.gui,
	})
	UserInputService.GamepadConnected:Connect(function()
		hint.Visible = true
	end)
	UserInputService.GamepadDisconnected:Connect(function()
		hint.Visible = UserInputService.GamepadEnabled
	end)
	ContextActionService:BindAction("CloseWindow", function(_, inputState)
		if inputState ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		local dialog = ctx.gui:FindFirstChild("ConfirmDialog")
		if dialog then
			dialog:Destroy() -- fecha primeiro a caixa "tem certeza?"
			GuiService.SelectedObject = nil
			return Enum.ContextActionResult.Sink
		end
		for _, panel in ctx.panels do
			if panel.Visible then
				panel.Visible = false
				GuiService.SelectedObject = nil
				ctx.play("Click")
				return Enum.ContextActionResult.Sink
			end
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.ButtonB)

	ctx.panelOpened.Settings = refreshAll
	return frame
end

return SettingsUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="492">
        <Properties>
          <string name="Name">SocialUI</string>
          <string name="Source"><![CDATA[--[[
	SocialUI (ModuleScript em StarterPlayer > StarterPlayerScripts)
	Parte 24 (v11): botão "FRIENDS" no menu, com 2 abas:
	  • PLAYERS: quem está no servidor. VISIT (vai até a entrada da base), GIFT (dá um bichinho da mochila;
	    a outra pessoa precisa aceitar) e CLAN+ (convida para o seu clã)
	  • CLAN: criar um clã (nome filtrado pelo Roblox), ver os membros, o bônus e sair
	Também: botão LIKE nos postes das bases (só aparece nas bases dos outros), pedidos de presente/clã
	(sempre com "tem certeza?") e o botão de FOTO ao lado do dinheiro.
]]

local CaptureService = game:GetService("CaptureService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Critters = require(Shared:WaitForChild("Critters"))
local UI = require(script.Parent:WaitForChild("UIKit"))
local Juice = require(script.Parent:WaitForChild("Juice"))

local SocialUI = {}

local C = UI.Colors
local create, corner, label, button = UI.create, UI.corner, UI.label, UI.button

function SocialUI.Init(ctx)
	local player = Players.LocalPlayer
	local frame, content = ctx.makePanel("Social", "FRIENDS & CLAN", C.Pink)
	content.Position = UDim2.fromOffset(16, 116)
	content.Size = UDim2.new(1, -32, 1, -128)
	create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = content })

	local state: any = { Likes = 0, LikedToday = {}, GiftsLeft = Config.GiftsPerDay, Clan = nil }
	local bag: { any } = {} -- mochila (para escolher o presente)
	local tab = "PLAYERS"
	local giftTarget: Player? = nil
	local render: () -> ()

	local tabBar = create("Frame", {
		Position = UDim2.fromOffset(16, 64),
		Size = UDim2.new(1, -32, 0, 44),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = frame,
	}, {
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local tabButtons = {}
	for order, name in { "PLAYERS", "CLAN" } do
		tabButtons[name] = button({ LayoutOrder = order, Size = UDim2.new(0.5, -4, 1, 0), BackgroundColor3 = C.Row, ZIndex = 6, Parent = tabBar }, name, function()
			ctx.play("Click")
			tab = name
			giftTarget = nil
			render()
		end)
	end

	ctx.menuButton(-2, "\u{1F46B}", "FRIENDS", C.Pink, function()
		ctx.openPanel("Social")
	end)

	local function clear()
		for _, child in content:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end

	local function row(order: number, height: number, color: Color3?): Frame
		return create("Frame", { LayoutOrder = order, Size = UDim2.new(1, -12, 0, height), BackgroundColor3 = color or C.Row, ZIndex = 5, Parent = content }, { corner(12) })
	end

	local function small(parent: Instance, order: number, text: string, color: Color3, onClick: () -> ())
		button({ LayoutOrder = order, Size = UDim2.new(0.33, -6, 1, 0), BackgroundColor3 = color, ZIndex = 6, Parent = parent }, text, onClick)
	end

	local function note(order: number, text: string)
		local box = row(order, 44, C.Panel)
		label({ Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -20, 1, -8), Text = text, TextWrapped = true, TextColor3 = Color3.fromRGB(200, 215, 240), ZIndex = 5, Parent = box })
	end

	---------------------------------------------------------------------
	-- PLAYERS
	---------------------------------------------------------------------
	local function renderGiftPicker(target: Player)
		note(0, ("Pick a critter from your backpack to give to %s (%d gifts left today)"):format(target.DisplayName, state.GiftsLeft or 0))
		if #bag == 0 then
			note(1, "Your backpack is empty! Use PICK UP on a critter in your base first.")
		end
		for order, item in bag do
			local def = Critters.ById[item.Id]
			if def then
				local box = row(order, 52)
				local rarity = Config.RarityByName[def.Rarity]
				label({
					Position = UDim2.fromOffset(12, 4),
					Size = UDim2.new(0.66, -12, 1, -8),
					Text = (if item.S then "Shiny " else "") .. (if item.M then item.M .. " " else "") .. def.Name .. "  (" .. def.Rarity .. ")",
					TextColor3 = rarity.Color,
					TextXAlignment = Enum.TextXAlignment.Left,
					ZIndex = 5,
					Parent = box,
				})
				button({
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -8, 0.5, 0),
					Size = UDim2.new(0.3, -8, 0, 40),
					BackgroundColor3 = C.Pink,
					ZIndex = 6,
					Parent = box,
				}, "GIVE", function()
					UI.confirm(ctx.gui, "GIVE THIS CRITTER?", ("Give %s to %s?\nIt leaves your backpack if they accept. You can't undo it."):format(def.Name, target.DisplayName), "GIVE", C.Pink, function()
						ctx.RequestEvent:FireServer("Gift", { To = target.UserId, Key = item.K })
						giftTarget = nil
						render()
					end, ctx.scaleNow)
				end)
			end
		end
		local back = row(100, 48, C.Panel)
		button({ Position = UDim2.fromOffset(8, 4), Size = UDim2.new(1, -16, 1, -8), BackgroundColor3 = C.Gray, ZIndex = 6, Parent = back }, "BACK", function()
			giftTarget = nil
			render()
		end)
	end

	local function renderPlayers()
		if giftTarget and giftTarget.Parent then
			renderGiftPicker(giftTarget)
			return
		end
		note(0, ("Your base has %d \u{2764} likes. Visit bases and tap the \u{2764} post at their gate (1 like per base per day)."):format(state.Likes or 0))
		local order = 1
		local myClan = state.Clan
		for _, other in Players:GetPlayers() do
			if other ~= player then
				order += 1
				local box = row(order, 92)
				local clanName = other:GetAttribute("ClanName")
				label({
					Position = UDim2.fromOffset(12, 4),
					Size = UDim2.new(1, -24, 0, 30),
					Text = other.DisplayName .. (if typeof(clanName) == "string" then "  [" .. clanName .. "]" else "") .. ("   \u{2764} %d"):format(tonumber(other:GetAttribute("Likes")) or 0),
					TextXAlignment = Enum.TextXAlignment.Left,
					ZIndex = 5,
					Parent = box,
				})
				local buttons = create("Frame", {
					Position = UDim2.fromOffset(8, 40),
					Size = UDim2.new(1, -16, 0, 44),
					BackgroundTransparency = 1,
					ZIndex = 6,
					Parent = box,
				}, { create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
				small(buttons, 1, "VISIT", C.Blue, function()
					ctx.play("Click")
					ctx.RequestEvent:FireServer("Visit", other.UserId)
					frame.Visible = false
				end)
				-- regras do país (PolicyService): onde trocar itens pagos é proibido, presentes ficam desligados
				local canGift = player:GetAttribute("PolicyTradingAllowed") == true and other:GetAttribute("PolicyTradingAllowed") == true
				small(buttons, 2, "GIFT", if canGift then C.Pink else C.Gray, function()
					ctx.play("Click")
					if not canGift then
						ctx.toast(if player:GetAttribute("PolicyTradingAllowed") == true then other.DisplayName .. " can't receive gifts." else "Gifts are not available where you live.", "info")
						return
					end
					giftTarget = other
					ctx.RequestEvent:FireServer("InventorySync")
					render()
				end)
				local canInvite = myClan ~= nil and typeof(clanName) ~= "string"
				small(buttons, 3, "CLAN +", if canInvite then C.Teal else C.Gray, function()
					if not myClan then
						ctx.toast("Make a clan first in the CLAN tab!", "info")
						return
					end
					if not canInvite then
						ctx.toast(other.DisplayName .. " is already in a clan.", "info")
						return
					end
					ctx.play("Click")
					ctx.RequestEvent:FireServer("ClanInvite", other.UserId)
				end)
			end
		end
		if order == 1 then
			note(2, "You're the only one here! Press INVITE to call your friends (you get a FREE egg for each new friend who joins).")
		end
	end

	---------------------------------------------------------------------
	-- CLAN
	---------------------------------------------------------------------
	local function renderClan()
		local clan = state.Clan
		if not clan then
			note(0, ("Make a clan with up to %d friends! Each clanmate in your server gives +%d%% cash (max +%d%%)."):format(
				Config.ClanMax,
				math.floor(Config.ClanBonusPerMate * 100),
				math.floor(Config.ClanBonusMax * 100)
			))
			local box = row(1, 60)
			local input = create("TextBox", {
				Position = UDim2.fromOffset(8, 8),
				Size = UDim2.new(0.62, -12, 1, -16),
				BackgroundColor3 = C.White,
				PlaceholderText = "Clan name (3-20 letters)",
				Text = "",
				ClearTextOnFocus = false,
				TextScaled = true,
				Font = Enum.Font.FredokaOne,
				TextColor3 = C.Dark,
				ZIndex = 6,
				Parent = box,
			}, { corner(10) })
			button({
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.new(0.36, -8, 1, -16),
				BackgroundColor3 = C.Green,
				ZIndex = 6,
				Parent = box,
			}, "CREATE", function()
				local name = input.Text
				if #name < 3 then
					ctx.toast("Type a clan name first (3 to 20 letters).", "info")
					return
				end
				ctx.play("Click")
				ctx.RequestEvent:FireServer("ClanCreate", string.sub(name, 1, 20))
			end)
			note(2, "Clan names are checked by Roblox's filter. Be nice!")
			return
		end
		local top = row(0, 72, C.Panel)
		label({ Position = UDim2.fromOffset(12, 4), Size = UDim2.new(1, -24, 0, 34), Text = "[" .. tostring(clan.Name) .. "]", TextColor3 = Color3.fromRGB(140, 230, 255), ZIndex = 5, Parent = top })
		label({
			Position = UDim2.fromOffset(12, 40),
			Size = UDim2.new(1, -24, 0, 26),
			Text = ("%d/%d members  |  bonus now: +%d%% cash"):format(#(clan.Members or {}), Config.ClanMax, math.floor((tonumber(clan.Bonus) or 0) * 100 + 0.5)),
			TextColor3 = Color3.fromRGB(200, 215, 240),
			ZIndex = 5,
			Parent = top,
		})
		for order, member in clan.Members or {} do
			local box = row(order, 40)
			label({
				Position = UDim2.fromOffset(12, 4),
				Size = UDim2.new(1, -24, 1, -8),
				Text = (if member.Id == clan.Owner then "\u{1F451} " else "") .. tostring(member.Name) .. (if member.Online then "  (here)" else ""),
				TextColor3 = if member.Online then Color3.fromRGB(140, 255, 150) else C.White,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 5,
				Parent = box,
			})
		end
		local leave = row(100, 52, C.Panel)
		button({ Position = UDim2.fromOffset(8, 4), Size = UDim2.new(1, -16, 1, -8), BackgroundColor3 = C.Red, ZIndex = 6, Parent = leave }, "LEAVE CLAN", function()
			UI.confirm(ctx.gui, "LEAVE CLAN?", "Leave your clan? You can join another one later.", "LEAVE", C.Red, function()
				ctx.RequestEvent:FireServer("ClanLeave")
			end, ctx.scaleNow)
		end)
	end

	render = function()
		for name, btn in tabButtons do
			btn.BackgroundColor3 = if name == tab then C.Pink else C.Row
		end
		if not frame.Visible then
			return
		end
		clear()
		if tab == "PLAYERS" then
			renderPlayers()
		else
			renderClan()
		end
	end

	ctx.RemotesFolder:WaitForChild("SocialSync").OnClientEvent:Connect(function(payload)
		if type(payload) == "table" then
			state = payload
			render()
		end
	end)
	ctx.InventoryEvent.OnClientEvent:Connect(function(payload)
		if type(payload) == "table" and type(payload.Items) == "table" then
			bag = payload.Items
			if giftTarget then
				render()
			end
		end
	end)
	for _, attribute in { "ClanName" } do
		player:GetAttributeChangedSignal(attribute):Connect(function()
			ctx.RequestEvent:FireServer("SocialSync")
		end)
	end

	-- Pedidos que chegam: presente e convite de clã (sempre perguntam; um de cada vez, em fila)
	local queue: { any } = {}
	local showing = false
	local function showNext()
		if showing or #queue == 0 then
			return
		end
		if ctx.gui:FindFirstChild("ConfirmDialog") then
			task.delay(1, showNext) -- espera a outra janela fechar (não fecha a janela do jogador)
			return
		end
		local request = table.remove(queue, 1)
		showing = true
		ctx.play("Rare")
		local answered = false
		local dialog
		if request.Kind == "GiftOffer" then
			dialog = UI.confirm(ctx.gui, "A GIFT FOR YOU!", ("%s wants to give you %s. Accept?"):format(tostring(request.From), tostring(request.Name)), "ACCEPT", C.Green, function()
				answered = true
				ctx.RequestEvent:FireServer("GiftAnswer", { OfferId = request.OfferId, Accept = true })
			end, ctx.scaleNow)
		else
			dialog = UI.confirm(ctx.gui, "CLAN INVITE", ("%s invited you to the clan [%s]. Join?"):format(tostring(request.From), tostring(request.Name)), "JOIN", C.Teal, function()
				answered = true
				ctx.RequestEvent:FireServer("ClanAnswer", true)
			end, ctx.scaleNow)
		end
		dialog.Destroying:Connect(function()
			task.delay(0.3, function()
				if not answered and request.Kind == "GiftOffer" then
					ctx.RequestEvent:FireServer("GiftAnswer", { OfferId = request.OfferId, Accept = false })
				end
				showing = false
				showNext()
			end)
		end)
	end
	ctx.EffectEvent.OnClientEvent:Connect(function(kind, data)
		if (kind == "GiftOffer" or kind == "ClanInvite") and type(data) == "table" then
			if #queue < 3 then
				data.Kind = kind
				table.insert(queue, data)
			end
			showNext()
		elseif kind == "Liked" then
			ctx.play("Coin")
			Juice.Confetti(ctx.gui, 25, { C.Pink, C.White })
		end
	end)

	-- LIKE: o poste só aparece nas bases dos OUTROS
	local plots = workspace:WaitForChild("Map"):WaitForChild("Plots")
	local function filterLike(plot: Instance)
		local post = plot:FindFirstChild("LikePost")
		local prompt = post and post:FindFirstChild("LikePrompt")
		if prompt and prompt:IsA("ProximityPrompt") then
			local owner = plot:GetAttribute("OwnerUserId")
			prompt.Enabled = typeof(owner) == "number" and owner ~= player.UserId
			prompt.ObjectText = tostring(plot:GetAttribute("OwnerName") or "Base") .. "'s base"
		end
	end
	for _, plot in plots:GetChildren() do
		plot:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
			filterLike(plot)
		end)
		plot.DescendantAdded:Connect(function(descendant)
			if descendant.Name == "LikePrompt" then
				filterLike(plot)
			end
		end)
		filterLike(plot)
	end

	-- FOTO: salvar na galeria ou compartilhar (quem abrir o link entra pelo seu convite)
	local cashPanel = ctx.gui:FindFirstChild("CashPanel")
	button({
		AnchorPoint = Vector2.new(0, 0),
		Position = if cashPanel then UDim2.new(1, 8, 0, 4) else UDim2.new(0.5, 170, 0, 12),
		Size = UDim2.fromOffset(48, 36),
		BackgroundColor3 = C.Panel,
		Parent = cashPanel or ctx.gui,
	}, "\u{1F4F7}", function()
		ctx.play("Click")
		-- regras do país (PolicyService): onde compartilhar conteúdo é proibido, só salva na galeria
		local canShare = player:GetAttribute("PolicyShareAllowed") == true
		local ok = pcall(function()
			CaptureService:CaptureScreenshot(function(contentId)
				ctx.flash(C.White, 0.6)
				local function save()
					pcall(function()
						(CaptureService :: any):PromptSaveCapturesToGallery({ contentId }, function() end)
					end)
				end
				if not canShare then
					save()
					return
				end
				pcall(function()
					(CaptureService :: any):PromptShareCapture(contentId, "inv:" .. player.UserId, function() end, save)
				end)
			end)
		end)
		if not ok then
			ctx.toast("Photos only work in the published game.", "info")
		end
	end)

	ctx.panelOpened.Social = function()
		ctx.RequestEvent:FireServer("SocialSync")
		ctx.RequestEvent:FireServer("InventorySync")
		render()
	end
	Players.PlayerAdded:Connect(function()
		task.delay(2, render)
	end)
	Players.PlayerRemoving:Connect(function(left)
		if left == giftTarget then
			giftTarget = nil
		end
		task.defer(render)
	end)
	return frame
end

return SocialUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="493">
        <Properties>
          <string name="Name">StyleUI</string>
          <string name="Source"><![CDATA[--[[
	StyleUI (ModuleScript em StarterPlayer > StarterPlayerScripts)
	Tela "STYLE": tema da base, decoração (8 vagas), trilha e título.
	O servidor (Customize.luau) manda a situação de cada item (tem / pode comprar / falta conquista)
	e confere tudo de novo quando você aperta um botão.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Format = require(Shared:WaitForChild("Format"))
local UI = require(script.Parent:WaitForChild("UIKit"))

local StyleUI = {}

local C = UI.Colors
local create, corner, label, button = UI.create, UI.corner, UI.label, UI.button

local TABS = {
	{ Id = "theme", Name = "THEMES", Hint = "Change the look of your whole base. Every world you unlock gives a new theme!" },
	{ Id = "decor", Name = "DECOR", Hint = "Pick a spot (1-2 front, 3-6 sides, 7-8 back), then place a decoration you own." },
	{ Id = "trail", Name = "TRAILS", Hint = "A colorful trail behind you. Some are bought, some are earned." },
	{ Id = "title", Name = "TITLES", Hint = "A title above your head. Earn them by playing!" },
}

function StyleUI.Init(ctx)
	local frame, content = ctx.makePanel("Style", "STYLE", C.Pink)
	content.Position = UDim2.fromOffset(16, 116)
	content.Size = UDim2.new(1, -32, 1, -130)
	create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = content })

	local state: any = nil
	local tab = "theme"
	local spot = 1
	local tabButtons = {}
	local render: () -> ()

	local tabRow = create("Frame", {
		Position = UDim2.fromOffset(16, 64),
		Size = UDim2.new(1, -32, 0, 42),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = frame,
	}, {
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for order, info in TABS do
		tabButtons[info.Id] = button({
			LayoutOrder = order,
			Size = UDim2.new(0.25, -6, 1, 0),
			BackgroundColor3 = C.Row,
			ZIndex = 6,
			Parent = tabRow,
		}, info.Name, function()
			ctx.play("Click")
			tab = info.Id
			render()
		end)
	end

	local function clear()
		for _, child in content:GetChildren() do
			if not child:IsA("UIListLayout") then
				child:Destroy()
			end
		end
	end

	local function row(order: number, title: string, subtitle: string, titleColor: Color3?)
		local rowFrame = create("Frame", {
			LayoutOrder = order,
			Size = UDim2.new(1, -12, 0, 70),
			BackgroundColor3 = C.Row,
			ZIndex = 5,
			Parent = content,
		}, { corner(14) })
		label({
			Position = UDim2.fromOffset(74, 6),
			Size = UDim2.new(0.6, -80, 0, 32),
			Text = title,
			TextColor3 = titleColor or C.White,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 5,
			Parent = rowFrame,
		})
		label({
			Position = UDim2.fromOffset(74, 40),
			Size = UDim2.new(0.6, -80, 0, 22),
			Text = subtitle,
			TextColor3 = Color3.fromRGB(200, 200, 220),
			TextXAlignment = Enum.TextXAlignment.Left,
			StrokeThickness = 1,
			ZIndex = 5,
			Parent = rowFrame,
		})
		local swatch = create("Frame", {
			Position = UDim2.fromOffset(10, 9),
			Size = UDim2.fromOffset(52, 52),
			BackgroundColor3 = titleColor or C.Gray,
			ZIndex = 5,
			Parent = rowFrame,
		}, { corner(12), UI.border(C.Dark, 2) })
		return rowFrame, swatch
	end

	local function rowButton(rowFrame: Frame, text: string, color: Color3, onClick: () -> ())
		button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.new(0.34, 0, 0, 50),
			BackgroundColor3 = color,
			ZIndex = 5,
			Parent = rowFrame,
		}, text, function()
			ctx.play("Click")
			onClick()
		end)
	end

	local function status(kind: string, id: string): (string, string)
		local entry = state and state.Status and state.Status[kind] and state.Status[kind][id]
		if type(entry) == "table" then
			return entry[1], entry[2]
		end
		return "locked", "..."
	end

	local function buyButton(rowFrame: Frame, kind: string, item)
		rowButton(rowFrame, Format.Money(item.Price), C.Gold, function()
			UI.confirm(ctx.gui, "BUY?", ("Buy %s for %s?"):format(item.Name, Format.Money(item.Price)), "BUY", C.Gold, function()
				ctx.RequestEvent:FireServer("BuyStyle", { Kind = kind, Id = item.Id })
			end, ctx.scaleNow)
		end)
	end

	local function lockedButton(rowFrame: Frame, text: string)
		rowButton(rowFrame, text, C.Gray, function()
			ctx.toast("Locked: " .. text, "info")
		end)
	end

	local function hint(text: string)
		label({
			LayoutOrder = 0,
			Size = UDim2.new(1, -12, 0, 40),
			Text = text,
			TextWrapped = true,
			TextColor3 = Color3.fromRGB(230, 220, 255),
			StrokeThickness = 1.5,
			ZIndex = 5,
			Parent = content,
		})
	end

	local builders = {}

	builders.theme = function()
		for order, item in Cosmetics.Themes do
			local rowFrame = row(order, item.Name, item.Description, item.Swatch)
			local st, text = status("theme", item.Id)
			if st == "owned" then
				if state.Theme == item.Id then
					rowButton(rowFrame, "IN USE", C.Gray, function() end)
				else
					rowButton(rowFrame, "USE", C.Green, function()
						ctx.RequestEvent:FireServer("SetTheme", item.Id)
					end)
				end
			else
				lockedButton(rowFrame, text)
			end
		end
	end

	builders.decor = function()
		-- escolher a vaga
		local picker = create("Frame", { LayoutOrder = 1, Size = UDim2.new(1, -12, 0, 52), BackgroundTransparency = 1, ZIndex = 5, Parent = content }, {
			create("UIGridLayout", { CellSize = UDim2.new(1 / 9, -5, 1, 0), CellPadding = UDim2.fromOffset(5, 0), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		for n = 1, Cosmetics.DecorSpots do
			local placed = state.Decor[n] or ""
			local item = Cosmetics.ById.decor[placed]
			button({
				LayoutOrder = n,
				BackgroundColor3 = if n == spot then C.Pink else (if item then item.Color else C.Row),
				ZIndex = 5,
				Parent = picker,
			}, tostring(n), function()
				ctx.play("Click")
				spot = n
				render()
			end)
		end
		button({ LayoutOrder = 99, BackgroundColor3 = C.Red, ZIndex = 5, Parent = picker }, "CLEAR", function()
			ctx.play("Click")
			ctx.RequestEvent:FireServer("PlaceDecor", { Spot = spot, Id = "" })
		end)
		local current = Cosmetics.ById.decor[state.Decor[spot] or ""]
		label({
			LayoutOrder = 2,
			Size = UDim2.new(1, -12, 0, 26),
			Text = ("Spot %d: %s"):format(spot, if current then current.Name else "empty"),
			TextColor3 = C.Gold,
			ZIndex = 5,
			Parent = content,
		})
		for order, item in Cosmetics.Decor do
			local st, text = status("decor", item.Id)
			local subtitle = if item.Price then Format.Money(item.Price) else "Free reward"
			local rowFrame = row(10 + order, item.Name, subtitle, item.Color)
			if st == "buy" then
				buyButton(rowFrame, "decor", item)
			elseif st == "owned" then
				if state.Decor[spot] == item.Id then
					rowButton(rowFrame, "REMOVE", C.Red, function()
						ctx.RequestEvent:FireServer("PlaceDecor", { Spot = spot, Id = "" })
					end)
				else
					rowButton(rowFrame, "PLACE ON " .. spot, C.Green, function()
						ctx.RequestEvent:FireServer("PlaceDecor", { Spot = spot, Id = item.Id })
					end)
				end
			else
				lockedButton(rowFrame, text)
			end
		end
	end

	builders.trail = function()
		for order, item in Cosmetics.Trails do
			local st, text = status("trail", item.Id)
			local subtitle = if item.Price then Format.Money(item.Price) elseif item.World or item.Requires then "Reward" else "Free"
			local rowFrame, swatch = row(order, item.Name, subtitle, item.Colors[1])
			local keypoints = {}
			for i, color in item.Colors do
				table.insert(keypoints, ColorSequenceKeypoint.new(if #item.Colors == 1 then 0 else (i - 1) / (#item.Colors - 1), color))
			end
			if #keypoints == 1 then
				table.insert(keypoints, ColorSequenceKeypoint.new(1, item.Colors[1]))
			end
			swatch.BackgroundColor3 = C.White
			create("UIGradient", { Color = ColorSequence.new(keypoints), Parent = swatch })
			if st == "buy" then
				buyButton(rowFrame, "trail", item)
			elseif st == "owned" then
				if state.Trail == item.Id then
					rowButton(rowFrame, "ON (tap: off)", C.Gray, function()
						ctx.RequestEvent:FireServer("SetTrail", "")
					end)
				else
					rowButton(rowFrame, "EQUIP", C.Green, function()
						ctx.RequestEvent:FireServer("SetTrail", item.Id)
					end)
				end
			else
				lockedButton(rowFrame, text)
			end
		end
	end

	builders.title = function()
		for order, item in Cosmetics.Titles do
			local st, text = status("title", item.Id)
			local rowFrame = row(order, item.Name, if st == "owned" then "Unlocked!" else text, item.Color)
			if st == "owned" then
				if state.Title == item.Id then
					rowButton(rowFrame, "WEARING (off)", C.Gray, function()
						ctx.RequestEvent:FireServer("SetTitle", "")
					end)
				else
					rowButton(rowFrame, "WEAR", C.Green, function()
						ctx.RequestEvent:FireServer("SetTitle", item.Id)
					end)
				end
			else
				lockedButton(rowFrame, text)
			end
		end
	end

	render = function()
		for id, btn in tabButtons do
			btn.BackgroundColor3 = if id == tab then C.Pink else C.Row
		end
		clear()
		if not state then
			label({ LayoutOrder = 1, Size = UDim2.new(1, -12, 0, 40), Text = "Loading...", ZIndex = 5, Parent = content })
			return
		end
		for _, info in TABS do
			if info.Id == tab then
				hint(info.Hint)
			end
		end
		builders[tab]()
	end

	ctx.StyleEvent.OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" then
			return
		end
		state = payload
		state.Decor = if type(payload.Decor) == "table" then payload.Decor else {}
		if frame.Visible then
			render()
		end
	end)

	ctx.panelOpened.Style = function()
		ctx.RequestEvent:FireServer("StyleSync")
		render()
	end
end

return StyleUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="494">
        <Properties>
          <string name="Name">UIKit</string>
          <string name="Source"><![CDATA[--[[
	UIKit (ModuleScript em StarterPlayer > StarterPlayerScripts)
	O "kit" de interface do jogo: use em TODOS os menus para tudo ficar com a mesma cara.
	  • Paleta de cores (UIKit.Colors) e fonte
	  • create()  - cria qualquer objeto com propriedades e filhos
	  • label()   - texto com contorno
	  • button()  - botão arredondado que CRESCE quando o dedo/mouse passa e "aperta" ao tocar
	  • iconButton() - botão com ícone grande em cima e texto embaixo (menus)
	  • popIn() / pulse() / shake() - animações prontas (todas com TweenService)
	Exemplo:
		local UI = require(script.Parent.UIKit)
		UI.button({ Size = UDim2.fromOffset(200, 60), BackgroundColor3 = UI.Colors.Green, Parent = frame }, "PLAY", function() end)
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UIKit = {}

UIKit.Font = Enum.Font.FredokaOne

-- Paleta: cores vivas e alegres, fundo escuro azulado para o texto branco aparecer bem
UIKit.Colors = {
	White = Color3.fromRGB(255, 255, 255),
	Dark = Color3.fromRGB(20, 20, 32),
	Panel = Color3.fromRGB(38, 38, 60),
	Row = Color3.fromRGB(55, 55, 82),
	Green = Color3.fromRGB(70, 200, 90),
	Blue = Color3.fromRGB(60, 140, 240),
	Purple = Color3.fromRGB(160, 80, 250),
	Red = Color3.fromRGB(230, 60, 70),
	Gold = Color3.fromRGB(255, 200, 60),
	Orange = Color3.fromRGB(245, 140, 40),
	Pink = Color3.fromRGB(240, 110, 180),
	Teal = Color3.fromRGB(40, 190, 200),
	Gray = Color3.fromRGB(120, 120, 130),
}

UIKit.Radius = 12

local C = UIKit.Colors

function UIKit.create(className: string, props: { [string]: any }, children: { Instance }?): any
	local instance = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

local create = UIKit.create

function UIKit.corner(radius: number?): UICorner
	return create("UICorner", { CornerRadius = UDim.new(0, radius or UIKit.Radius) })
end

function UIKit.border(color: Color3?, thickness: number?): UIStroke
	return create("UIStroke", {
		Color = color or C.Dark,
		Thickness = thickness or 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UIKit.shine(): UIGradient
	return create("UIGradient", {
		Color = ColorSequence.new(C.White, Color3.fromRGB(200, 200, 200)),
		Rotation = 90,
	})
end

function UIKit.textStroke(thickness: number?): UIStroke
	return create("UIStroke", { Color = C.Dark, Thickness = thickness or 2 })
end

function UIKit.label(props: { [string]: any }): TextLabel
	local thickness = props.StrokeThickness
	props.StrokeThickness = nil
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = props.Font or UIKit.Font
	props.TextScaled = if props.TextScaled == nil then true else props.TextScaled
	props.TextColor3 = props.TextColor3 or C.White
	return create("TextLabel", props, { UIKit.textStroke(thickness) })
end

-- Animação de "mola": cresce ao passar o mouse/dedo, aperta ao tocar, volta ao soltar
local HOVER = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local PRESS = TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local RELEASE = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

function UIKit.springy(target: GuiButton)
	local scale = target:FindFirstChild("SpringScale") :: UIScale?
	if not scale then
		scale = create("UIScale", { Name = "SpringScale", Parent = target })
	end
	local s = scale :: UIScale
	local hovering = false
	target.MouseEnter:Connect(function()
		hovering = true
		TweenService:Create(s, HOVER, { Scale = 1.07 }):Play()
	end)
	target.MouseLeave:Connect(function()
		hovering = false
		TweenService:Create(s, HOVER, { Scale = 1 }):Play()
	end)
	target.MouseButton1Down:Connect(function()
		TweenService:Create(s, PRESS, { Scale = 0.92 }):Play()
	end)
	target.MouseButton1Up:Connect(function()
		TweenService:Create(s, RELEASE, { Scale = if hovering then 1.07 else 1 }):Play()
	end)
	target.Activated:Connect(function()
		-- no celular o "mouse" não sai do botão depois do toque: volta ao tamanho normal
		if UserInputService:GetLastInputType() == Enum.UserInputType.Touch then
			hovering = false
		end
		s.Scale = 0.94
		TweenService:Create(s, RELEASE, { Scale = if hovering then 1.07 else 1 }):Play()
	end)
end

function UIKit.button(props: { [string]: any }, text: string, onClick: () -> ()): (TextButton, TextLabel)
	props.Text = ""
	props.AutoButtonColor = true
	local btn = create("TextButton", props, { UIKit.corner(), UIKit.border(C.Dark, 3), UIKit.shine() })
	local txt = UIKit.label({
		Size = UDim2.new(1, -12, 1, -8),
		Position = UDim2.fromOffset(6, 4),
		Text = text,
		ZIndex = props.ZIndex,
		Parent = btn,
	})
	UIKit.springy(btn)
	btn.Activated:Connect(onClick)
	return btn, txt
end

-- Botão de menu: ícone grande em cima, texto embaixo
function UIKit.iconButton(props: { [string]: any }, icon: string, text: string, onClick: () -> ()): (TextButton, TextLabel)
	local btn, txt = UIKit.button(props, "", onClick)
	txt.Size = UDim2.new(1, -8, 0.34, 0)
	txt.Position = UDim2.new(0, 4, 0.62, -2)
	txt.Text = text
	UIKit.label({
		Name = "Icon",
		Size = UDim2.new(1, -8, 0.6, 0),
		Position = UDim2.fromOffset(4, 3),
		Text = icon,
		ZIndex = props.ZIndex,
		StrokeThickness = 0,
		Parent = btn,
	})
	return btn, txt
end

-- Caixa de confirmação ("Tem certeza?") por cima de tudo. scaleWith = função que aplica a escala do celular.
function UIKit.confirm(parent: Instance, title: string, body: string, yesText: string, yesColor: Color3, onYes: () -> (), scaleWith: ((GuiObject) -> ())?)
	local old = parent:FindFirstChild("ConfirmDialog")
	if old then
		old:Destroy()
	end
	local shade = create("TextButton", {
		Name = "ConfirmDialog",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Dark,
		BackgroundTransparency = 0.45,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 40,
		Parent = parent,
	})
	local box = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(460, 250),
		BackgroundColor3 = C.Panel,
		Active = true, -- tocar dentro da caixa não fecha
		ZIndex = 41,
		Parent = shade,
	}, { UIKit.corner(20), UIKit.border(yesColor, 4) })
	if scaleWith then
		scaleWith(box)
	end
	UIKit.label({ Size = UDim2.new(1, -30, 0, 44), Position = UDim2.fromOffset(15, 12), Text = title, TextColor3 = yesColor, ZIndex = 42, Parent = box })
	UIKit.label({
		Size = UDim2.new(1, -40, 0, 96),
		Position = UDim2.fromOffset(20, 60),
		Text = body,
		TextWrapped = true,
		StrokeThickness = 1.5,
		ZIndex = 42,
		Parent = box,
	})
	local function close()
		shade:Destroy()
	end
	UIKit.button({
		Position = UDim2.new(0, 20, 1, -76),
		Size = UDim2.new(0.5, -30, 0, 58),
		BackgroundColor3 = C.Gray,
		ZIndex = 42,
		Parent = box,
	}, "CANCEL", close)
	UIKit.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 1, -76),
		Size = UDim2.new(0.5, -30, 0, 58),
		BackgroundColor3 = yesColor,
		ZIndex = 42,
		Parent = box,
	}, yesText, function()
		close()
		onYes()
	end)
	shade.Activated:Connect(close)
	UIKit.popIn(box)
	-- controle de videogame: começa no CANCELAR (mais seguro)
	if UserInputService:GetLastInputType().Name:find("Gamepad") then
		local cancel = box:FindFirstChildOfClass("TextButton")
		if cancel then
			game:GetService("GuiService").SelectedObject = cancel
		end
	end
	return shade
end

-- Janela aparece "pulando" (use ao abrir menus)
-- (reaproveita o UIScale que já existe: o Roblox só usa UM UIScale por objeto)
function UIKit.popIn(frame: GuiObject)
	local scale = frame:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = create("UIScale", { Name = "PopScale", Parent = frame })
	end
	local s = scale :: UIScale
	local base = s:GetAttribute("Base")
	local target = if typeof(base) == "number" then base else 1
	s.Scale = target * 0.75
	TweenService:Create(s, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = target }):Play()
end

-- Pulinho rápido (ex.: dinheiro aumentou)
function UIKit.pulse(object: GuiObject, amount: number?)
	local scale = object:FindFirstChild("PulseScale") :: UIScale?
	if not scale then
		scale = create("UIScale", { Name = "PulseScale", Parent = object })
	end
	local s = scale :: UIScale
	s.Scale = 1 + (amount or 0.12)
	TweenService:Create(s, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

-- Tremidinha (ex.: erro, sem dinheiro): vai e volta 3 vezes
function UIKit.shake(object: GuiObject)
	local start = object:GetAttribute("ShakeHome")
	if typeof(start) ~= "UDim2" then
		start = object.Position
		object:SetAttribute("ShakeHome", start)
	end
	object.Position = start :: UDim2
	local tween = TweenService:Create(object, TweenInfo.new(0.05, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 3, true), {
		Position = (start :: UDim2) + UDim2.fromOffset(7, 0),
	})
	tween:Play()
end

return UIKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="495">
        <Properties>
          <string name="Name">WorldFX</string>
          <string name="Source"><![CDATA[--[[
	WorldFX (ModuleScript em StarterPlayer > StarterPlayerScripts)
	v21: EFEITOS 3D do mundo, só na tela de cada jogador (o servidor não gasta nada com isso):
	  • pedestal com disco de luz na cor da raridade (pulsando); Épico+ solta brilhinhos;
	    Lendário+ ganha feixes girando e uma luz de verdade
	  • ovos na esteira soltam faíscas na cor da raridade
	  • ovo chocando: onda de choque + clarão no pedestal
	  • poeirinha nos pés de quem corre
	  • "pólen" flutuando de dia e vagalumes de noite, em volta da câmera
	  • coletar dinheiro = chuva de moedas 3D; compra/level up/rebirth = explosão de brilho no personagem
	"Low graphics" (SETTINGS) desliga as partículas e as luzes; os discos continuam (são só uma peça).
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local WorldFX = {}

local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local PAD_RANGE = 120 -- studs: discos e brilhinhos
local LIGHT_RANGE = 70 -- studs: luzes de verdade (Lendário+)
local MAX_LIGHTS = 10
local RUN_RANGE = 80

local player = Players.LocalPlayer
local folder: Folder? = nil

local function getFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "WorldFX"
	f.Parent = workspace
	folder = f
	return f
end

local function lowGfx(): boolean
	return player:GetAttribute("LowGfx") == true
end

local function seq(a: number, b: number): NumberSequence
	return NumberSequence.new(a, b)
end

local function emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	for key, value in props do
		(e :: any)[key] = value
	end
	e.Parent = parent
	return e
end

local function ghostPart(size: Vector3, cf: CFrame, parent: Instance): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Transparency = 1
	p.Size = size
	p.CFrame = cf
	p.Parent = parent
	return p
end

local function rarityOf(model: Instance)
	local name = model:GetAttribute("Rarity")
	local rarity = if typeof(name) == "string" then Config.RarityByName[name] else nil
	return rarity or Config.Rarities[1], Config.RarityIndex[if rarity then rarity.Name else "Common"] or 1
end

---------------------------------------------------------------------
-- 1) PEDESTAIS: disco de luz + brilhinhos + feixes
---------------------------------------------------------------------
type Pad = { Model: Instance, Disc: Part, Beams: { Part }?, Light: PointLight?, Center: Vector3, Phase: number, Index: number, Color: Color3, Tween: Tween }
local pads: { [Instance]: Pad } = {}
local startHatchGlow: (Model) -> () -- definida mais abaixo (seção 3); a varredura dos pedestais chama
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function pedestalTop(model: Model, home: CFrame): number
	local exclude = { model }
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(exclude, other.Character)
		end
	end
	local active = workspace:FindFirstChild("ActiveCritters")
	if active then
		table.insert(exclude, active)
	end
	rayParams.FilterDescendantsInstances = exclude
	local hit = workspace:Raycast(home.Position, Vector3.new(0, -12, 0), rayParams)
	if hit then
		return hit.Position.Y
	end
	local box, size = model:GetBoundingBox()
	return box.Position.Y - size.Y / 2
end

local function makePad(model: Model, home: CFrame)
	local rarity, index = rarityOf(model)
	local top = pedestalTop(model, home)
	local center = Vector3.new(home.Position.X, top + 0.08, home.Position.Z)
	local isEgg = model:GetAttribute("Kind") == "Egg"
	local color = rarity.Color
	local disc = Instance.new("Part")
	disc.Name = "GlowPad"
	disc.Shape = Enum.PartType.Cylinder
	disc.Size = Vector3.new(0.12, if isEgg then 4.6 else 6.2, if isEgg then 4.6 else 6.2)
	disc.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90))
	disc.Material = Enum.Material.Neon
	disc.Color = color
	disc.Transparency = 0.55
	disc.Anchored = true
	disc.CanCollide = false
	disc.CanQuery = false
	disc.CanTouch = false
	disc.CastShadow = false
	disc.Parent = getFolder()
	local tween = TweenService:Create(disc, TweenInfo.new(0.9 + math.random() * 0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.82 })
	tween:Play()
	local pad: Pad = { Model = model, Disc = disc, Beams = nil, Light = nil, Center = center, Phase = math.random() * 6, Index = index, Color = color, Tween = tween }
	if index >= 4 and not lowGfx() then
		emitter(disc, {
			Name = "PadSparkles",
			Texture = SPARK,
			Color = ColorSequence.new(color, Color3.new(1, 1, 1)),
			LightEmission = 1,
			Size = seq(0.4, 0),
			Transparency = seq(0.1, 1),
			Lifetime = NumberRange.new(1.2, 2),
			Speed = NumberRange.new(1.5, 3),
			SpreadAngle = Vector2.new(30, 30),
			EmissionDirection = Enum.NormalId.Right, -- "para cima" do cilindro deitado (eixo X virou Y)
			Rate = if index >= 6 then 9 elseif index >= 5 then 6 else 3,
		})
	end
	if index >= 5 then
		-- dois feixes cruzados girando em volta do bichinho
		local beams = {}
		for i = 1, 2 do
			local beam = Instance.new("Part")
			beam.Name = "Beam"
			beam.Size = Vector3.new(0.22, 5.5, 0.22)
			beam.Material = Enum.Material.Neon
			beam.Color = color
			beam.Transparency = 0.45
			beam.Anchored = true
			beam.CanCollide = false
			beam.CanQuery = false
			beam.CanTouch = false
			beam.CastShadow = false
			beam.CFrame = CFrame.new(center)
			beam.Parent = disc
			beams[i] = beam
		end
		pad.Beams = beams
	end
	pads[model] = pad
end

local function removePad(model: Instance)
	local pad = pads[model]
	if pad then
		pads[model] = nil
		pad.Tween:Cancel()
		pad.Disc:Destroy()
	end
end

local function refreshPads(cameraPosition: Vector3)
	local active = workspace:FindFirstChild("ActiveCritters")
	if not active then
		return
	end
	local low = lowGfx()
	local wanted: { [Instance]: boolean } = {}
	local lightCandidates: { { Pad: Pad, Dist: number } } = {}
	for _, model in active:GetChildren() do
		if not model:IsA("Model") then
			continue
		end
		local state = model:GetAttribute("State")
		local home = model:GetAttribute("Home")
		if (state == "Placed" or state == "Incubating" or state == "Hatching") and typeof(home) == "CFrame" then
			local dist = (home.Position - cameraPosition).Magnitude
			if state == "Hatching" and dist < 150 then
				startHatchGlow(model :: Model)
			end
			if dist < PAD_RANGE then
				wanted[model] = true
				local pad = pads[model]
				if not pad then
					makePad(model, home)
					pad = pads[model]
				elseif (pad.Center - Vector3.new(home.Position.X, pad.Center.Y, home.Position.Z)).Magnitude > 0.5 then
					-- mudou de pedestal (arrastou na base): refaz
					removePad(model)
					makePad(model, home)
					pad = pads[model]
				end
				if pad and pad.Index >= 5 and dist < LIGHT_RANGE and not low then
					table.insert(lightCandidates, { Pad = pad, Dist = dist })
				end
			end
		end
	end
	for model in pads do
		if not wanted[model] then
			removePad(model)
		end
	end
	-- luzes de verdade só nos Lendário+ mais perto (o celular agradece)
	table.sort(lightCandidates, function(a, b)
		return a.Dist < b.Dist
	end)
	local lit: { [Pad]: boolean } = {}
	for i, entry in lightCandidates do
		if i > MAX_LIGHTS then
			break
		end
		lit[entry.Pad] = true
		if not entry.Pad.Light then
			local light = Instance.new("PointLight")
			light.Color = entry.Pad.Color
			light.Range = 11
			light.Brightness = 0.9
			light.Shadows = false
			light.Parent = entry.Pad.Disc
			entry.Pad.Light = light
		end
	end
	for _, pad in pads do
		if pad.Light and not lit[pad] then
			pad.Light:Destroy()
			pad.Light = nil
		end
	end
end

local function stepBeams(now: number)
	for _, pad in pads do
		local beams = pad.Beams
		if beams then
			local spin = now * 0.9 + pad.Phase
			local lift = 2.9 + math.sin(now * 1.4 + pad.Phase) * 0.3
			for i, beam in beams do
				local angle = spin + (i - 1) * math.pi / 2
				beam.CFrame = CFrame.new(pad.Center + Vector3.new(0, lift, 0)) * CFrame.Angles(0, angle, 0) * CFrame.new(3.4, 0, 0) * CFrame.Angles(0, 0, math.rad(12))
			end
		end
	end
end

---------------------------------------------------------------------
-- 2) OVOS NA ESTEIRA: faíscas na cor da raridade
---------------------------------------------------------------------
local sparkled: { [Instance]: boolean } = {}

local function refreshConveyorEggs(cameraPosition: Vector3)
	if lowGfx() then
		return
	end
	local active = workspace:FindFirstChild("ActiveCritters")
	if not active then
		return
	end
	for _, model in active:GetChildren() do
		if model:IsA("Model") and not sparkled[model] and model:GetAttribute("State") == "Conveyor" then
			local root = model:FindFirstChild("Root") :: BasePart?
			if root and (root.Position - cameraPosition).Magnitude < PAD_RANGE then
				sparkled[model] = true
				local rarity, index = rarityOf(model)
				emitter(root, {
					Name = "EggSparkles",
					Texture = SPARK,
					Color = ColorSequence.new(rarity.Color, Color3.new(1, 1, 1)),
					LightEmission = 1,
					Size = seq(0.35, 0),
					Transparency = seq(0.1, 1),
					Lifetime = NumberRange.new(0.6, 1.1),
					Speed = NumberRange.new(1, 2.5),
					SpreadAngle = Vector2.new(180, 180),
					Rate = 2 + index * 1.5,
				})
				model.Destroying:Connect(function()
					sparkled[model] = nil
				end)
			end
		end
	end
end

---------------------------------------------------------------------
-- 3) CHOCANDO / CHOCOU (v22: animação completa)
--   enquanto choca: o ovo ganha uma luz e faíscas subindo, cada vez mais fortes
--   chocou: cascas voam (peças 3D nas cores do ovo), feixe de luz sobe, onda de choque, clarão,
--           e o bichinho "pula" para fora (escala 0.2 → 1.15 → 1)
---------------------------------------------------------------------
type HatchGlow = { Light: PointLight, Emitter: ParticleEmitter, Root: BasePart, Start: number, Colors: { Color3 } }
local hatchGlows: { [Instance]: HatchGlow } = {}
local shellColors: { { Position: Vector3, Colors: { Color3 }, At: number } } = {} -- cores do ovo que acabou de sumir

local function eggColors(model: Model): { Color3 }
	local parts = {}
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part.Transparency < 0.9 then
			table.insert(parts, part)
		end
	end
	table.sort(parts, function(a, b)
		return a.Size.X * a.Size.Y * a.Size.Z > b.Size.X * b.Size.Y * b.Size.Z
	end)
	local colors = {}
	for i = 1, math.min(3, #parts) do
		table.insert(colors, parts[i].Color)
	end
	if #colors == 0 then
		colors[1] = Color3.new(1, 1, 1)
	end
	return colors
end

function startHatchGlow(model: Model)
	local root = model:FindFirstChild("Root") :: BasePart?
	if not root or hatchGlows[model] then
		return
	end
	local rarity = rarityOf(model)
	local colors = eggColors(model)
	local light = Instance.new("PointLight")
	light.Color = rarity.Color
	light.Range = 10
	light.Brightness = 0.6
	light.Shadows = false
	light.Parent = root
	local e = emitter(root, {
		Name = "HatchSparks",
		Texture = SPARK,
		Color = ColorSequence.new(rarity.Color, Color3.new(1, 1, 1)),
		LightEmission = 1,
		Size = seq(0.45, 0),
		Transparency = seq(0, 1),
		Lifetime = NumberRange.new(0.7, 1.2),
		Speed = NumberRange.new(4, 8),
		SpreadAngle = Vector2.new(35, 35),
		Acceleration = Vector3.new(0, 6, 0),
		EmissionDirection = Enum.NormalId.Top,
		Rate = 12,
		Enabled = not lowGfx(),
	})
	hatchGlows[model] = { Light = light, Emitter = e, Root = root, Start = os.clock(), Colors = colors }
	model.Destroying:Connect(function()
		hatchGlows[model] = nil
		table.insert(shellColors, { Position = root.Position, Colors = colors, At = os.clock() })
	end)
end

local function stepHatchGlows(now: number)
	for model, glow in hatchGlows do
		if not model.Parent then
			hatchGlows[model] = nil
			continue
		end
		local t = math.clamp((now - glow.Start) / Config.HatchRevealTime, 0, 1)
		glow.Light.Brightness = 0.6 + t * 3 + math.sin(now * (10 + t * 30)) * 0.4 * t
		glow.Light.Range = 10 + t * 8
		glow.Emitter.Rate = 12 + t * 50
	end
end

local function nearestShellColors(position: Vector3): { Color3 }?
	local now = os.clock()
	local best, bestDist = nil, 6
	for i = #shellColors, 1, -1 do
		local entry = shellColors[i]
		if now - entry.At > 4 then
			table.remove(shellColors, i)
		else
			local d = (entry.Position - position).Magnitude
			if d < bestDist then
				best, bestDist = entry.Colors, d
			end
		end
	end
	return best
end

-- Cascas do ovo voando (peças 3D ancoradas, animadas na mão) e feixe de luz subindo
local function hatchShells(position: Vector3, colors: { Color3 }, rarity)
	local holder = getFolder()
	local pieces = {}
	for i = 1, 12 do
		local piece = Instance.new("Part")
		piece.Name = "Shell"
		piece.Size = Vector3.new(0.5 + math.random() * 0.5, 0.35 + math.random() * 0.35, 0.12)
		piece.Color = colors[1 + (i % #colors)]
		piece.Material = Enum.Material.SmoothPlastic
		piece.Anchored = true
		piece.CanCollide = false
		piece.CanQuery = false
		piece.CanTouch = false
		piece.CastShadow = false
		local angle = (i / 12) * math.pi * 2 + math.random() * 0.4
		local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
		piece.CFrame = CFrame.new(position + dir * 0.6 + Vector3.new(0, 0.8, 0))
		piece.Parent = holder
		pieces[i] = {
			Part = piece,
			Vel = dir * (7 + math.random() * 6) + Vector3.new(0, 12 + math.random() * 9, 0),
			Spin = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 14,
			Rot = CFrame.identity,
		}
	end
	local beam = Instance.new("Part")
	beam.Name = "HatchBeam"
	beam.Shape = Enum.PartType.Cylinder
	beam.Size = Vector3.new(14, 2.6, 2.6)
	beam.CFrame = CFrame.new(position + Vector3.new(0, 6, 0)) * CFrame.Angles(0, 0, math.rad(90))
	beam.Material = Enum.Material.Neon
	beam.Color = rarity.Color
	beam.Transparency = 0.25
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.CastShadow = false
	beam.Parent = holder
	TweenService:Create(beam, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(26, 0.4, 0.4),
		CFrame = CFrame.new(position + Vector3.new(0, 14, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Transparency = 1,
	}):Play()
	task.delay(0.9, function()
		beam:Destroy()
	end)
	local started = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function(dt)
		dt = math.min(dt, 0.05)
		local age = os.clock() - started
		for _, p in pieces do
			p.Vel -= Vector3.new(0, 55 * dt, 0)
			p.Rot = p.Rot * CFrame.Angles(p.Spin.X * dt, p.Spin.Y * dt, p.Spin.Z * dt)
			p.Part.CFrame = CFrame.new(p.Part.Position + p.Vel * dt) * p.Rot
			if age > 0.7 then
				p.Part.Transparency = math.clamp((age - 0.7) / 0.5, 0, 1)
			end
		end
		if age > 1.25 then
			connection:Disconnect()
			for _, p in pieces do
				p.Part:Destroy()
			end
		end
	end)
end

-- O bichinho novo "pula" para fora do ovo (escala 0.2 → 1.15 → 1)
local function popCritter(position: Vector3)
	task.spawn(function()
		local active = workspace:FindFirstChild("ActiveCritters")
		if not active then
			return
		end
		local model: Model? = nil
		for _ = 1, 12 do -- o modelo novo pode chegar um instante depois do aviso
			for _, candidate in active:GetChildren() do
				local root = candidate:FindFirstChild("Root") :: BasePart?
				if root and candidate:GetAttribute("Kind") == "Critter" and candidate:GetAttribute("State") == "Placed" and (root.Position - position).Magnitude < 3 then
					model = candidate :: Model
					break
				end
			end
			if model then
				break
			end
			task.wait(0.08)
		end
		if not model then
			return
		end
		local ok, base = pcall(function()
			return (model :: Model):GetScale()
		end)
		if not ok or typeof(base) ~= "number" then
			return
		end
		local started = os.clock()
		local duration = 0.65
		while model.Parent and os.clock() - started < duration do
			local t = (os.clock() - started) / duration
			-- cresce com "pulo": passa de 1.15 e volta para 1
			local f = if t < 0.45 then 0.2 + (t / 0.45) * 0.95 elseif t < 0.75 then 1.15 - ((t - 0.45) / 0.3) * 0.22 else 0.93 + ((t - 0.75) / 0.25) * 0.07
			pcall(function()
				(model :: Model):ScaleTo(base * f)
			end)
			RunService.RenderStepped:Wait()
		end
		if model.Parent then
			pcall(function()
				(model :: Model):ScaleTo(base)
			end)
		end
	end)
end

local function hatchWave(position: Vector3, rarityName: string)
	local camera = workspace.CurrentCamera
	if not camera or (camera.CFrame.Position - position).Magnitude > 150 then
		return
	end
	local rarity = Config.RarityByName[rarityName] or Config.Rarities[1]
	if not lowGfx() then
		hatchShells(position, nearestShellColors(position) or { rarity.Color, Color3.new(1, 1, 1) }, rarity)
	end
	popCritter(position)
	local ring = Instance.new("Part")
	ring.Name = "HatchWave"
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.3, 1, 1)
	ring.CFrame = CFrame.new(position - Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Material = Enum.Material.Neon
	ring.Color = rarity.Color
	ring.Transparency = 0.15
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Parent = getFolder()
	TweenService:Create(ring, TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.3, 16, 16), Transparency = 1 }):Play()
	if not lowGfx() then
		local light = Instance.new("PointLight")
		light.Color = rarity.Color
		light.Range = 18
		light.Brightness = 4
		light.Parent = ring
		TweenService:Create(light, TweenInfo.new(0.6), { Brightness = 0 }):Play()
	end
	task.delay(0.8, function()
		ring:Destroy()
	end)
end

---------------------------------------------------------------------
-- 4) POEIRA NOS PÉS DE QUEM CORRE
---------------------------------------------------------------------
local dust: { [Model]: { Emitter: ParticleEmitter, Root: BasePart, Humanoid: Humanoid } } = {}

local function ensureDust(character: Model)
	if dust[character] then
		return dust[character]
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return nil
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "RunDust"
	attachment.Position = Vector3.new(0, -2.7, 0)
	attachment.Parent = root
	local e = emitter(attachment, {
		Name = "Dust",
		Texture = SMOKE,
		Color = ColorSequence.new(Color3.fromRGB(230, 220, 195)),
		Size = seq(0.6, 1.6),
		Transparency = seq(0.6, 1),
		Lifetime = NumberRange.new(0.4, 0.7),
		Speed = NumberRange.new(1.5, 3),
		SpreadAngle = Vector2.new(60, 60),
		Rate = 0,
	})
	local entry = { Emitter = e, Root = root, Humanoid = humanoid }
	dust[character] = entry
	character.Destroying:Connect(function()
		dust[character] = nil
	end)
	return entry
end

local function refreshDust(cameraPosition: Vector3)
	local low = lowGfx()
	for _, other in Players:GetPlayers() do
		local character = other.Character
		if not character or not character.Parent then
			continue
		end
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			continue
		end
		local near = (root.Position - cameraPosition).Magnitude < RUN_RANGE
		local entry = dust[character]
		if near and not low then
			entry = entry or ensureDust(character)
			if entry then
				local vel = root.AssemblyLinearVelocity
				local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
				local grounded = entry.Humanoid.FloorMaterial ~= Enum.Material.Air
				entry.Emitter.Rate = if grounded and speed > 12 then 8 + speed * 0.35 else 0
			end
		elseif entry then
			entry.Emitter.Rate = 0
		end
	end
end

---------------------------------------------------------------------
-- 5) PÓLEN DE DIA, VAGALUMES DE NOITE (em volta da câmera)
---------------------------------------------------------------------
local ambient: Part? = nil
local ambientEmitter: ParticleEmitter? = nil
local ambientNight: boolean? = nil

local function stepAmbient(camera: Camera)
	if lowGfx() then
		if ambientEmitter then
			ambientEmitter.Enabled = false
		end
		return
	end
	if not ambient then
		ambient = ghostPart(Vector3.new(60, 18, 60), camera.CFrame, getFolder())
		ambient.Name = "Ambient"
		ambientEmitter = emitter(ambient, {
			Name = "Pollen",
			Texture = SPARK,
			LightEmission = 1,
			Size = seq(0.22, 0.12),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.3), NumberSequenceKeypoint.new(0.8, 0.3), NumberSequenceKeypoint.new(1, 1) }),
			Lifetime = NumberRange.new(5, 8),
			Speed = NumberRange.new(0.4, 1.2),
			SpreadAngle = Vector2.new(180, 180),
			Acceleration = Vector3.new(0.3, 0.15, 0.1),
			Rate = 7,
			Enabled = true,
		})
	end
	local a = ambient :: Part
	local e = ambientEmitter :: ParticleEmitter
	e.Enabled = true
	local look = camera.CFrame.LookVector
	a.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(look.X, 0, look.Z) * 20 + Vector3.new(0, 4, 0))
	local clock = Lighting.ClockTime
	local night = clock >= 18.5 or clock < 5.5
	if night ~= ambientNight then
		ambientNight = night
		e.Color = if night
			then ColorSequence.new(Color3.fromRGB(230, 255, 120), Color3.fromRGB(255, 240, 150))
			else ColorSequence.new(Color3.fromRGB(255, 250, 220), Color3.fromRGB(255, 220, 240))
		e.Rate = if night then 5 else 7
	end
end

---------------------------------------------------------------------
-- 6) EFEITOS NO PERSONAGEM: moedas ao coletar, brilho ao comprar, explosão no level up
---------------------------------------------------------------------
local playerFx: { Attachment: Attachment, Coins: ParticleEmitter, Sparkle: ParticleEmitter, Confetti: ParticleEmitter }? = nil

local function ensurePlayerFx()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	if playerFx and playerFx.Attachment.Parent == root then
		return playerFx
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "PlayerFX"
	attachment.Parent = root
	local coins = emitter(attachment, {
		Name = "Coins",
		Texture = SPARK,
		Color = ColorSequence.new(Color3.fromRGB(255, 215, 60), Color3.fromRGB(255, 240, 150)),
		LightEmission = 0.8,
		Size = seq(0.55, 0.3),
		Transparency = seq(0, 0.6),
		Lifetime = NumberRange.new(0.8, 1.2),
		Speed = NumberRange.new(14, 20),
		SpreadAngle = Vector2.new(35, 35),
		Acceleration = Vector3.new(0, -42, 0),
		Rate = 0,
	})
	local sparkle = emitter(attachment, {
		Name = "Sparkle",
		Texture = SPARK,
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(180, 230, 255)),
		LightEmission = 1,
		Size = seq(0.5, 0),
		Lifetime = NumberRange.new(0.5, 0.9),
		Speed = NumberRange.new(6, 12),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 3,
		Rate = 0,
	})
	local confetti = emitter(attachment, {
		Name = "Confetti",
		Texture = SPARK,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 120)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 220, 60)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 200, 255)),
		}),
		LightEmission = 0.9,
		Size = seq(0.6, 0.2),
		Lifetime = NumberRange.new(1, 1.6),
		Speed = NumberRange.new(16, 26),
		SpreadAngle = Vector2.new(70, 70),
		Acceleration = Vector3.new(0, -30, 0),
		RotSpeed = NumberRange.new(-200, 200),
		Rate = 0,
	})
	playerFx = { Attachment = attachment, Coins = coins, Sparkle = sparkle, Confetti = confetti }
	return playerFx
end

function WorldFX.Init(ctx)
	ctx.EffectEvent.OnClientEvent:Connect(function(kind, data)
		if lowGfx() then
			return
		end
		if kind == "HatchBurst" then
			if type(data) == "table" and typeof(data.Position) == "Vector3" then
				hatchWave(data.Position, tostring(data.Rarity))
			end
		elseif kind == "Collect" then
			local fx = ensurePlayerFx()
			if fx then
				local amount = if typeof(data) == "number" then data else 0
				fx.Coins:Emit(math.clamp(10 + math.floor(math.log10(math.max(amount, 1)) * 5), 10, 45))
			end
		elseif kind == "Purchase" or kind == "Lock" or kind == "Fused" or kind == "Mixed" then
			local fx = ensurePlayerFx()
			if fx then
				fx.Sparkle:Emit(if kind == "Purchase" and data == "Legendary" then 60 else 28)
			end
		elseif kind == "LevelUp" or kind == "Rebirth" or kind == "QuestsAll" or kind == "Prestige" or kind == "WorldFirst" then
			local fx = ensurePlayerFx()
			if fx then
				fx.Confetti:Emit(if kind == "Rebirth" then 110 else 70)
				fx.Sparkle:Emit(30)
			end
		end
	end)

	-- varredura leve (4x por segundo): discos, ovos da esteira, poeira
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.25 then
			return
		end
		elapsed = 0
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local cameraPosition = camera.CFrame.Position
		local ok, err = pcall(function()
			refreshPads(cameraPosition)
			refreshConveyorEggs(cameraPosition)
			refreshDust(cameraPosition)
		end)
		if not ok then
			warn("[WorldFX]", err)
		end
	end)

	-- todo frame: feixes girando e o pólen seguindo a câmera
	RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local now = os.clock()
		stepBeams(now)
		stepHatchGlows(now)
		stepAmbient(camera)
	end)

	-- Low graphics ligado depois: tira brilhinhos e luzes dos discos
	player:GetAttributeChangedSignal("LowGfx"):Connect(function()
		if lowGfx() then
			for _, pad in pads do
				local e = pad.Disc:FindFirstChild("PadSparkles")
				if e then
					e:Destroy()
				end
				if pad.Light then
					pad.Light:Destroy()
					pad.Light = nil
				end
			end
		end
	end)
end

return WorldFX
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="496">
        <Properties>
          <string name="Name">WorldLife</string>
          <string name="Source"><![CDATA[--[[
	WorldLife (v27): deixa os mundos VIVOS. Tudo aqui é só visual/local (não dá prêmio nenhum).

	• Bichinhos de enfeite em cada mundo: borboletas (Meadow), ursinhos de goma pulando (Candy),
	  pinguins deslizando no lago (Frost), bolhas de lava e bolas de fogo (Lava), peixes pulando
	  do mar (Reef) e estrelas cadentes (Galaxy). Só existem no mundo em que você está.
	• Clima de cada mundo: confete de açúcar, neve + aurora boreal, brasas, bolhas, poeira de estrelas.
	• Chegada no mundo: nome grande na tela + flash.
	• Brincadeiras (a parte do corpo): camas elásticas/jatos (Tag Bounce), lava que volta para o
	  começo (Tag LavaReset), gravidade baixa (Tag LowGravity), gêiseres (Tag Geyser),
	  relógio dos baús (Tag FunPrize) e setas do caminho do Ovo Gigante (Tag Chase).
	• Base: bichinhos dormem à noite (Zzz), festa quando chega um Lendário+, "!" quando alguém invade,
	  sirene girando na base roubada (atributo AlarmUntil do Plot) e "SAVED!" quando você recupera.
	Modo gráfico leve (LowGfx): menos bichos, menos partículas.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Format = require(ReplicatedStorage.Shared:WaitForChild("Format"))

local WorldLife = {}

-- centro (X) de cada ilha, igual ao tools/build_project.py (1000 * posição)
local X0 = { candy = 1000, frost = 2000, lava = 3000, reef = 4000, galaxy = 5000 }
WorldLife.X0 = X0

local player = Players.LocalPlayer
local rng = Random.new()

local function lowGfx(): boolean
	return player:GetAttribute("LowGfx") == true
end

local function currentWorld(): string
	local w = player:GetAttribute("World")
	return if typeof(w) == "string" and w ~= "" then w else "meadow"
end

local function rootPart(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function isMine(hit: BasePart): boolean
	local character = player.Character
	return character ~= nil and hit:IsDescendantOf(character)
end

local function newPart(props): BasePart
	local p = Instance.new(props.Class or "Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = props.Size or Vector3.one
	p.Color = props.Color or Color3.new(1, 1, 1)
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Transparency = props.Transparency or 0
	if props.Shape then
		p.Shape = props.Shape
	end
	p.Parent = props.Parent
	return p
end

local function emitter(parent: Instance, props): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	for k, v in props do
		(e :: any)[k] = v
	end
	e.Parent = parent
	return e
end

local function seq(a: number, b: number): NumberSequence
	return NumberSequence.new(a, b)
end

---------------------------------------------------------------------
-- Bichinhos de enfeite (um conjunto por mundo; some quando você sai)
---------------------------------------------------------------------
type Critter = { Parts: { BasePart }, Update: (number) -> () }

local function butterfly(folder: Folder, center: Vector3, color: Color3): Critter
	local body = newPart({ Size = Vector3.new(0.3, 0.3, 1), Color = Color3.fromRGB(40, 30, 30), Parent = folder })
	local wingL = newPart({ Size = Vector3.new(1.2, 0.1, 1), Color = color, Material = Enum.Material.Neon, Parent = folder })
	local wingR = newPart({ Size = Vector3.new(1.2, 0.1, 1), Color = color, Material = Enum.Material.Neon, Parent = folder })
	local radius, speed, phase, height = rng:NextNumber(6, 14), rng:NextNumber(0.4, 0.8), rng:NextNumber(0, 6.28), rng:NextNumber(4, 8)
	return {
		Parts = { body, wingL, wingR },
		Update = function(t)
			local a = phase + t * speed
			local pos = center + Vector3.new(math.cos(a) * radius, height + math.sin(t * 2 + phase) * 1.2, math.sin(a) * radius)
			local cf = CFrame.lookAt(pos, pos + Vector3.new(-math.sin(a), 0, math.cos(a)))
			local flap = math.sin(t * 18 + phase) * 0.9
			body.CFrame = cf
			wingL.CFrame = cf * CFrame.Angles(0, 0, flap) * CFrame.new(-0.6, 0, 0)
			wingR.CFrame = cf * CFrame.Angles(0, 0, -flap) * CFrame.new(0.6, 0, 0)
		end,
	}
end

local function gummy(folder: Folder, center: Vector3, color: Color3): Critter
	local body = newPart({ Size = Vector3.new(2.2, 2.6, 2), Color = color, Material = Enum.Material.Glass, Transparency = 0.15, Shape = Enum.PartType.Ball, Parent = folder })
	local earL = newPart({ Size = Vector3.new(0.9, 0.9, 0.9), Color = color, Material = Enum.Material.Glass, Transparency = 0.15, Shape = Enum.PartType.Ball, Parent = folder })
	local earR = newPart({ Size = Vector3.new(0.9, 0.9, 0.9), Color = color, Material = Enum.Material.Glass, Transparency = 0.15, Shape = Enum.PartType.Ball, Parent = folder })
	local radius, speed, phase = rng:NextNumber(10, 22), rng:NextNumber(0.15, 0.3), rng:NextNumber(0, 6.28)
	return {
		Parts = { body, earL, earR },
		Update = function(t)
			local a = phase + t * speed
			local hop = math.abs(math.sin(t * 4 + phase)) * 2.6
			local pos = center + Vector3.new(math.cos(a) * radius, 1.3 + hop, math.sin(a) * radius)
			local cf = CFrame.lookAt(pos, pos + Vector3.new(-math.sin(a), 0, math.cos(a)))
			body.CFrame = cf
			earL.CFrame = cf * CFrame.new(-0.7, 1.2, 0)
			earR.CFrame = cf * CFrame.new(0.7, 1.2, 0)
		end,
	}
end

local function penguin(folder: Folder, center: Vector3): Critter
	local body = newPart({ Size = Vector3.new(1.8, 2.4, 1.6), Color = Color3.fromRGB(30, 30, 40), Shape = Enum.PartType.Ball, Parent = folder })
	local belly = newPart({ Size = Vector3.new(1.3, 1.8, 0.6), Color = Color3.fromRGB(245, 245, 250), Shape = Enum.PartType.Ball, Parent = folder })
	local beak = newPart({ Size = Vector3.new(0.4, 0.3, 0.6), Color = Color3.fromRGB(255, 160, 40), Parent = folder })
	local radius, speed, phase = rng:NextNumber(8, 16), rng:NextNumber(0.25, 0.45), rng:NextNumber(0, 6.28)
	return {
		Parts = { body, belly, beak },
		Update = function(t)
			local a = phase + t * speed
			local slide = (math.floor((t + phase) / 4) % 2) == 1 -- anda um pouco, desliza um pouco
			local pos = center + Vector3.new(math.cos(a) * radius, if slide then 0.8 else 1.2, math.sin(a) * radius)
			local cf = CFrame.lookAt(pos, pos + Vector3.new(-math.sin(a), 0, math.cos(a)))
			if slide then
				cf *= CFrame.Angles(-1.3, 0, 0)
			else
				cf *= CFrame.Angles(0, 0, math.sin(t * 8 + phase) * 0.18)
			end
			body.CFrame = cf
			belly.CFrame = cf * CFrame.new(0, -0.1, -0.55)
			beak.CFrame = cf * CFrame.new(0, 0.6, -0.95)
		end,
	}
end

local function fish(folder: Folder, x0: number, side: number, color: Color3): Critter
	local body = newPart({ Size = Vector3.new(1, 1, 2), Color = color, Shape = Enum.PartType.Ball, Parent = folder })
	local tail = newPart({ Class = "WedgePart", Size = Vector3.new(0.2, 1, 0.9), Color = color, Parent = folder })
	local x, period, phase = x0 + rng:NextNumber(-140, 140), rng:NextNumber(2.5, 4), rng:NextNumber(0, 4)
	return {
		Parts = { body, tail },
		Update = function(t)
			local k = ((t + phase) % period) / period -- 0..1: um pulo
			local z = side * (96 + k * 14)
			local y = -1 + math.sin(k * math.pi) * 9
			local pos = Vector3.new(x, y, z)
			local dir = Vector3.new(0, math.cos(k * math.pi) * 9, side * 14)
			local cf = CFrame.lookAt(pos, pos + dir)
			body.CFrame = cf
			tail.CFrame = cf * CFrame.new(0, 0, 1.3) * CFrame.Angles(0, math.sin(t * 20) * 0.5, 0)
		end,
	}
end

local function jumpingCritters(worldId: string, folder: Folder, count: number): { Critter }
	local list = {}
	if worldId == "meadow" then
		local colors = { Color3.fromRGB(255, 140, 200), Color3.fromRGB(255, 220, 90), Color3.fromRGB(140, 200, 255), Color3.fromRGB(200, 150, 255) }
		for i = 1, count do
			local center = Vector3.new(rng:NextNumber(-170, 170), 0, rng:NextNumber(-160, 170))
			table.insert(list, butterfly(folder, center, colors[(i % #colors) + 1]))
		end
	elseif worldId == "candy" then
		local colors = { Color3.fromRGB(255, 80, 110), Color3.fromRGB(120, 220, 120), Color3.fromRGB(255, 200, 60), Color3.fromRGB(150, 120, 255) }
		for i = 1, count do
			local center = Vector3.new(X0.candy + rng:NextNumber(-130, 20), 0, rng:NextNumber(25, 75) * (if i % 2 == 0 then 1 else -1))
			table.insert(list, gummy(folder, center, colors[(i % #colors) + 1]))
		end
	elseif worldId == "frost" then
		for i = 1, count do
			local lake = if i % 2 == 0 then Vector3.new(X0.frost - 90, 0, 56) else Vector3.new(X0.frost - 20, 0, -45)
			table.insert(list, penguin(folder, lake))
		end
	elseif worldId == "reef" then
		local colors = { Color3.fromRGB(255, 150, 60), Color3.fromRGB(80, 200, 255), Color3.fromRGB(255, 230, 80), Color3.fromRGB(255, 110, 150) }
		for i = 1, count do
			table.insert(list, fish(folder, X0.reef, if i % 2 == 0 then 1 else -1, colors[(i % #colors) + 1]))
		end
	end
	return list
end

---------------------------------------------------------------------
-- Clima de cada mundo (emissor que segue a câmera)
---------------------------------------------------------------------
local WEATHER = {
	candy = { Color = ColorSequence.new(Color3.fromRGB(255, 170, 220), Color3.fromRGB(170, 230, 255)), Rate = 22, Size = seq(0.35, 0.25), Speed = NumberRange.new(4, 7), Accel = Vector3.new(0, -2, 0), Light = 0.3, Above = true },
	frost = { Color = ColorSequence.new(Color3.new(1, 1, 1)), Rate = 60, Size = seq(0.3, 0.2), Speed = NumberRange.new(5, 9), Accel = Vector3.new(1, -2, 0), Light = 0.2, Above = true },
	lava = { Color = ColorSequence.new(Color3.fromRGB(255, 190, 70), Color3.fromRGB(255, 70, 20)), Rate = 30, Size = seq(0.25, 0), Speed = NumberRange.new(1, 3), Accel = Vector3.new(0, 5, 0), Light = 1, Above = false },
	reef = { Color = ColorSequence.new(Color3.fromRGB(210, 250, 255)), Rate = 14, Size = seq(0.3, 0.7), Speed = NumberRange.new(1, 2), Accel = Vector3.new(0, 3, 0), Light = 0.4, Above = false },
	galaxy = { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 150, 255)), Rate = 18, Size = seq(0.25, 0), Speed = NumberRange.new(0.5, 1.5), Accel = Vector3.zero, Light = 1, Above = true },
}

function WorldLife.Init(ctx)
	local life = Instance.new("Folder")
	life.Name = "WorldLife"
	life.Parent = workspace
	local defaultGravity = workspace.Gravity

	-- clima
	local anchor = newPart({ Size = Vector3.new(90, 1, 90), Transparency = 1, Parent = life })
	local weather: ParticleEmitter? = nil
	local weatherAbove = true
	local aurora: { BasePart } = {}
	local function setWeather(worldId: string)
		if weather then
			weather:Destroy()
			weather = nil
		end
		for _, p in aurora do
			p:Destroy()
		end
		table.clear(aurora)
		local w = WEATHER[worldId]
		if not w then
			return
		end
		weatherAbove = w.Above
		weather = emitter(anchor, {
			Color = w.Color,
			Rate = if lowGfx() then w.Rate * 0.3 else w.Rate,
			Size = w.Size,
			Speed = w.Speed,
			Acceleration = w.Accel,
			LightEmission = w.Light,
			Lifetime = NumberRange.new(4, 6),
			EmissionDirection = if w.Above then Enum.NormalId.Bottom else Enum.NormalId.Top,
			SpreadAngle = Vector2.new(20, 20),
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-90, 90),
			Transparency = seq(0.1, 0.6),
		})
		if worldId == "frost" and not lowGfx() then
			for i = 1, 3 do
				table.insert(aurora, newPart({
					Size = Vector3.new(420, 16, 1),
					Material = Enum.Material.Neon,
					Transparency = 0.65,
					Color = Color3.fromRGB(80, 255, 170),
					Parent = life,
				}))
				aurora[i].CFrame = CFrame.new(X0.frost, 95 + i * 9, -170 - i * 22) * CFrame.Angles(math.rad(-25), 0, math.rad((i - 2) * 4))
			end
		end
	end

	-- bichinhos de enfeite + bolhas/bolas de fogo/estrelas cadentes
	local critters: { Critter } = {}
	local critterFolder: Folder? = nil
	local world = currentWorld()
	local function setCritters(worldId: string)
		if critterFolder then
			critterFolder:Destroy()
		end
		critterFolder = Instance.new("Folder")
		critterFolder.Name = "Critters"
		critterFolder.Parent = life
		local counts = { meadow = 8, candy = 7, frost = 6, reef = 10 }
		local count = counts[worldId] or 0
		if lowGfx() then
			count = math.ceil(count / 3)
		end
		critters = jumpingCritters(worldId, critterFolder :: Folder, count)
	end

	local function burst(pos: Vector3, color: Color3, size: number, rise: number, life_: number)
		local ball = newPart({ Size = Vector3.one * size, Color = color, Material = Enum.Material.Neon, Shape = Enum.PartType.Ball, Parent = critterFolder or life })
		ball.CFrame = CFrame.new(pos)
		TweenService:Create(ball, TweenInfo.new(life_, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = Vector3.one * size * 2.2,
			Transparency = 1,
			CFrame = CFrame.new(pos + Vector3.new(0, rise, 0)),
		}):Play()
		task.delay(life_ + 0.1, function()
			ball:Destroy()
		end)
	end

	local function arc(from: Vector3, to: Vector3, height: number, duration: number, part: BasePart)
		local start = os.clock()
		local conn
		conn = RunService.Heartbeat:Connect(function()
			local k = (os.clock() - start) / duration
			if k >= 1 or not part.Parent then
				conn:Disconnect()
				if part.Parent then
					part:Destroy()
				end
				return
			end
			local p = from:Lerp(to, k) + Vector3.new(0, math.sin(k * math.pi) * height, 0)
			part.CFrame = CFrame.new(p)
		end)
	end

	local spawnTimer = 0
	local function spawnExtras(dt: number)
		spawnTimer -= dt
		if spawnTimer > 0 or lowGfx() then
			return
		end
		if world == "lava" then
			spawnTimer = 0.35
			local x = X0.lava + rng:NextNumber(-150, 150)
			local z = if rng:NextNumber() < 0.5 then 52 + rng:NextNumber(-5, 5) else 58 + rng:NextNumber(-15, 15)
			burst(Vector3.new(x, 0.6, z), Color3.fromRGB(255, 130, 40), rng:NextNumber(0.8, 1.6), 1.5, 0.8)
			if rng:NextNumber() < 0.12 then -- bola de fogo saindo do vulcão
				local ball = newPart({ Size = Vector3.one * 2, Color = Color3.fromRGB(255, 120, 30), Material = Enum.Material.Neon, Shape = Enum.PartType.Ball, Parent = critterFolder or life })
				emitter(ball, { Color = ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 60, 20)), Rate = 30, Lifetime = NumberRange.new(0.4, 0.7), Speed = NumberRange.new(0, 1), Size = seq(1.2, 0), LightEmission = 1 })
				local from = Vector3.new(X0.lava + 105, 22, -62)
				arc(from, from + Vector3.new(rng:NextNumber(-40, 40), -22, rng:NextNumber(10, 40)), 26, 2.2, ball)
			end
		elseif world == "galaxy" then
			spawnTimer = rng:NextNumber(0.8, 1.8)
			local star = newPart({ Size = Vector3.new(0.6, 0.6, 5), Color = Color3.fromRGB(255, 250, 220), Material = Enum.Material.Neon, Parent = critterFolder or life })
			local from = Vector3.new(X0.galaxy + rng:NextNumber(-200, 200), rng:NextNumber(70, 110), rng:NextNumber(-150, 150))
			local to = from + Vector3.new(rng:NextNumber(-120, 120), -40, rng:NextNumber(-120, 120))
			star.CFrame = CFrame.lookAt(from, to)
			TweenService:Create(star, TweenInfo.new(1.2, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + (to - from)), Transparency = 1 }):Play()
			task.delay(1.3, function()
				star:Destroy()
			end)
		elseif world == "reef" then
			spawnTimer = 0.5
			burst(Vector3.new(X0.reef + rng:NextNumber(-150, 150), 0.3, rng:NextNumber(-85, 85)), Color3.fromRGB(200, 250, 255), 0.6, 6, 2.5)
		else
			spawnTimer = 1
		end
	end

	---------------------------------------------------------------------
	-- Brincadeiras: camas elásticas / jatos, lava, gravidade baixa, gêiseres, baús
	---------------------------------------------------------------------
	local lastBounce = 0
	local function setupBounce(pad: Instance)
		if not pad:IsA("BasePart") then
			return
		end
		pad.Touched:Connect(function(hit)
			if not isMine(hit) or os.clock() - lastBounce < 0.35 then
				return
			end
			local root = rootPart()
			if not root then
				return
			end
			lastBounce = os.clock()
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v.X, tonumber(pad:GetAttribute("Power")) or 80, v.Z)
			ctx.play("Swing")
			local base = pad.Transparency
			pad.Transparency = math.min(base + 0.4, 0.8)
			task.delay(0.15, function()
				pad.Transparency = base
			end)
		end)
	end

	local lastLava = 0
	local function setupLava(pool: Instance)
		if not pool:IsA("BasePart") then
			return
		end
		pool.Touched:Connect(function(hit)
			if not isMine(hit) or os.clock() - lastLava < 1 then
				return
			end
			local root = rootPart()
			local spot = pool:GetAttribute("Respawn")
			if not root or typeof(spot) ~= "string" then
				return
			end
			local x, y, z = string.match(spot, "([%-%d%.]+),([%-%d%.]+),([%-%d%.]+)")
			if not x then
				return
			end
			lastLava = os.clock()
			root.AssemblyLinearVelocity = Vector3.zero
			root.CFrame = CFrame.new(tonumber(x) :: number, tonumber(y) :: number, tonumber(z) :: number)
			ctx.flash(Color3.fromRGB(255, 120, 40), 0.35)
			ctx.toast("Oops! Hot lava - back to the start!", "warning")
		end)
	end

	for _, tag in { "Bounce", "LavaReset" } do
		local setup = if tag == "Bounce" then setupBounce else setupLava
		for _, p in CollectionService:GetTagged(tag) do
			setup(p)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(setup)
	end

	local lowZone = false
	local function updateGravity()
		local root = rootPart()
		local inside, factor = false, 1
		if root then
			for _, zone in CollectionService:GetTagged("LowGravity") do
				if zone:IsA("BasePart") then
					local offset = root.Position - zone.Position
					local radius = tonumber(zone:GetAttribute("Radius")) or 30
					if Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius and math.abs(offset.Y) < 120 then
						inside, factor = true, tonumber(zone:GetAttribute("Gravity")) or 0.3
						break
					end
				end
			end
		end
		if inside ~= lowZone then
			lowZone = inside
			workspace.Gravity = if inside then defaultGravity * factor else defaultGravity
			if inside then
				ctx.toast("Moon gravity! Jump super high!", "info")
			end
		end
	end
	player.CharacterAdded:Connect(function()
		lowZone = false
		workspace.Gravity = defaultGravity
	end)

	-- gêiser: jorra fogo de tempos em tempos (só visual)
	local geyserTimer = 0
	local function geysers(dt: number)
		geyserTimer -= dt
		if geyserTimer > 0 or world ~= "lava" then
			return
		end
		geyserTimer = rng:NextNumber(3, 5)
		for _, vent in CollectionService:GetTagged("Geyser") do
			if vent:IsA("BasePart") and rng:NextNumber() < 0.6 then
				local e = vent:FindFirstChild("Eruption") :: ParticleEmitter?
				if not e then
					e = emitter(vent, {
						Name = "Eruption",
						Color = ColorSequence.new(Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 70, 20)),
						Rate = 0,
						Lifetime = NumberRange.new(0.8, 1.4),
						Speed = NumberRange.new(28, 40),
						SpreadAngle = Vector2.new(10, 10),
						Acceleration = Vector3.new(0, -30, 0),
						Size = seq(2.2, 0.2),
						LightEmission = 1,
						EmissionDirection = Enum.NormalId.Top,
					})
				end
				(e :: ParticleEmitter):Emit(if lowGfx() then 12 else 40)
			end
		end
	end

	-- relógio em cima de cada baú (READY! ou quanto falta)
	local prizeLabels: { [BasePart]: TextLabel } = {}
	local function setupPrizeLabel(prize: Instance)
		if not prize:IsA("BasePart") or prizeLabels[prize] then
			return
		end
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(170, 44)
		gui.StudsOffset = Vector3.new(0, 6, 0)
		gui.MaxDistance = 120
		gui.AlwaysOnTop = true
		gui.Adornee = prize
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextStrokeTransparency = 0.2
		label.Parent = gui
		gui.Parent = prize
		prizeLabels[prize] = label
	end
	for _, p in CollectionService:GetTagged("FunPrize") do
		setupPrizeLabel(p)
	end
	CollectionService:GetInstanceAddedSignal("FunPrize"):Connect(setupPrizeLabel)
	local function updatePrizes()
		local now = os.time()
		for prize, label in prizeLabels do
			if not prize.Parent then
				prizeLabels[prize] = nil
				continue
			end
			local readyAt = player:GetAttribute("Fun_" .. tostring(prize:GetAttribute("Key")))
			if typeof(readyAt) == "number" and readyAt > now then
				label.Text = "\u{23F3} " .. Format.Time(readyAt - now)
				label.TextColor3 = Color3.fromRGB(210, 210, 230)
			else
				label.Text = "\u{1F381} TREASURE!"
				label.TextColor3 = Color3.fromRGB(255, 230, 90)
			end
		end
	end

	-- setas do caminho do Ovo Gigante (luz correndo em direção ao ovo)
	local chase: { BasePart } = {}
	local function refreshChase()
		chase = {}
		for _, p in CollectionService:GetTagged("Chase") do
			if p:IsA("BasePart") then
				table.insert(chase, p)
			end
		end
		table.sort(chase, function(a, b)
			return (tonumber(a:GetAttribute("Order")) or 0) < (tonumber(b:GetAttribute("Order")) or 0)
		end)
	end
	refreshChase()
	CollectionService:GetInstanceAddedSignal("Chase"):Connect(refreshChase)
	local chaseStep = 0

	---------------------------------------------------------------------
	-- Base: dormir à noite, festa, susto, sirene, SAVED!
	---------------------------------------------------------------------
	local function critterRoot(model: Instance): BasePart?
		if not model:IsA("Model") then
			return nil
		end
		return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	end

	local function addBillboard(model: Instance, name: string, text: string, color: Color3, seconds: number?)
		local root = critterRoot(model)
		if not root or root:FindFirstChild(name) then
			return
		end
		local gui = Instance.new("BillboardGui")
		gui.Name = name
		gui.Size = UDim2.fromOffset(60, 40)
		gui.StudsOffsetWorldSpace = Vector3.new(1.2, 3.5, 0)
		gui.MaxDistance = 90
		gui.Adornee = root
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.Text = text
		label.TextColor3 = color
		label.TextStrokeTransparency = 0.3
		label.Parent = gui
		gui.Parent = root
		if seconds then
			task.delay(seconds, function()
				gui:Destroy()
			end)
		end
	end

	local function myBaseCritters(): { Instance }
		local list = {}
		for _, model in CollectionService:GetTagged("BaseCritter") do
			if model:GetAttribute("OwnerUserId") == player.UserId then
				table.insert(list, model)
			end
		end
		return list
	end

	local sleeping = false
	local function updateSleep()
		local night = workspace:GetAttribute("Night") == true and not lowGfx()
		local camera = workspace.CurrentCamera
		for _, model in CollectionService:GetTagged("BaseCritter") do
			local root = critterRoot(model)
			if root then
				local zzz = root:FindFirstChild("Zzz")
				local near = camera and (root.Position - camera.CFrame.Position).Magnitude < 90
				if night and near and not zzz then
					addBillboard(model, "Zzz", "z Z z", Color3.fromRGB(190, 210, 255))
				elseif (not night or not near) and zzz then
					zzz:Destroy()
				end
			end
		end
		sleeping = night
	end

	local loadedAt = os.clock()
	CollectionService:GetInstanceAddedSignal("BaseCritter"):Connect(function(model)
		if os.clock() - loadedAt < 15 or model:GetAttribute("OwnerUserId") ~= player.UserId then
			return
		end
		local rarity = model:GetAttribute("Rarity")
		if rarity ~= "Legendary" and rarity ~= "Mythic" and rarity ~= "Secret" then
			return
		end
		task.wait(0.5) -- espera ele chegar no pedestal
		for _, other in myBaseCritters() do
			local root = critterRoot(other)
			if root then
				local e = emitter(root, {
					Color = ColorSequence.new(Color3.fromRGB(255, 120, 200), Color3.fromRGB(120, 220, 255)),
					Rate = 0,
					Lifetime = NumberRange.new(1, 1.6),
					Speed = NumberRange.new(8, 14),
					SpreadAngle = Vector2.new(35, 35),
					Acceleration = Vector3.new(0, -18, 0),
					Size = seq(0.5, 0.3),
					Rotation = NumberRange.new(0, 360),
					RotSpeed = NumberRange.new(-200, 200),
					EmissionDirection = Enum.NormalId.Top,
				})
				e:Emit(if lowGfx() then 6 else 16)
				task.delay(2, function()
					e:Destroy()
				end)
				addBillboard(other, "Party", "\u{1F389}", Color3.new(1, 1, 1), 3)
			end
		end
	end)

	-- sirene girando na base que está sendo roubada (qualquer jogador vê)
	local sirens: { [Instance]: BasePart } = {}
	local function updateSirens(t: number)
		local plotsFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Plots")
		if not plotsFolder then
			return
		end
		local now = os.time()
		for _, plot in plotsFolder:GetChildren() do
			local untilTime = plot:GetAttribute("AlarmUntil")
			local active = typeof(untilTime) == "number" and untilTime > now
			local siren = sirens[plot]
			if active and not siren then
				local sign = plot:FindFirstChild("Sign")
				local base = if sign and sign:IsA("BasePart") then sign.Position + Vector3.new(0, sign.Size.Y / 2 + 2, 0) else nil
				if base then
					siren = newPart({ Size = Vector3.new(2.4, 2.4, 2.4), Color = Color3.fromRGB(255, 40, 40), Material = Enum.Material.Neon, Shape = Enum.PartType.Ball, Parent = life })
					siren.CFrame = CFrame.new(base)
					local light = Instance.new("SpotLight")
					light.Color = Color3.fromRGB(255, 40, 40)
					light.Brightness = 8
					light.Range = 40
					light.Angle = 50
					light.Parent = siren
					sirens[plot] = siren
				end
			elseif not active and siren then
				siren:Destroy()
				sirens[plot] = nil
			end
			if active and sirens[plot] then
				local s = sirens[plot]
				s.CFrame = CFrame.new(s.Position) * CFrame.Angles(0, t * 8, 0) * CFrame.Angles(math.rad(-20), 0, 0)
			end
		end
	end

	-- efeitos que o servidor manda
	ctx.EffectEvent.OnClientEvent:Connect(function(kind, data)
		if kind == "Saved" and typeof(data) == "Vector3" then
			ctx.floatingText(data + Vector3.new(0, 2, 0), "SAVED!", Color3.fromRGB(120, 255, 140))
			ctx.bigText("SAVED!", Color3.fromRGB(120, 255, 140))
			ctx.play("Rare")
			burst(data, Color3.fromRGB(120, 255, 140), 3, 4, 0.8)
		elseif kind == "Alarm" then
			for _, model in myBaseCritters() do
				addBillboard(model, "Scared", "!", Color3.fromRGB(255, 80, 80), 3)
			end
		elseif kind == "FunPrize" and typeof(data) == "Vector3" then
			ctx.bigText("TREASURE!", Color3.fromRGB(255, 220, 90))
			ctx.play("Rare")
			burst(data, Color3.fromRGB(255, 220, 90), 4, 6, 1)
		elseif kind == "SnowHit" and typeof(data) == "Vector3" then
			ctx.floatingText(data, "SPLAT!", Color3.fromRGB(230, 245, 255))
			ctx.play("Bonk")
		elseif kind == "Splat" then
			local screen = ctx.gui
			for _ = 1, 3 do
				local blob = Instance.new("Frame")
				blob.AnchorPoint = Vector2.new(0.5, 0.5)
				blob.Position = UDim2.fromScale(rng:NextNumber(0.3, 0.7), rng:NextNumber(0.3, 0.7))
				blob.Size = UDim2.fromOffset(rng:NextInteger(120, 200), rng:NextInteger(100, 170))
				blob.BackgroundColor3 = Color3.fromRGB(250, 252, 255)
				blob.BackgroundTransparency = 0.1
				blob.ZIndex = 50
				local corner = Instance.new("UICorner")
				corner.CornerRadius = UDim.new(0.5, 0)
				corner.Parent = blob
				blob.Parent = screen
				TweenService:Create(blob, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }):Play()
				task.delay(1.5, function()
					blob:Destroy()
				end)
			end
			ctx.play("Bonk")
		end
	end)

	---------------------------------------------------------------------
	-- Chegada no mundo + troca de clima/bichos
	---------------------------------------------------------------------
	local function enterWorld(worldId: string, announce: boolean)
		world = worldId
		setWeather(worldId)
		setCritters(worldId)
		if announce and worldId ~= "meadow" then
			local info = Config.WorldById and Config.WorldById[worldId]
			local name = if info and info.Name then string.upper(info.Name) else string.upper(worldId)
			local color = if info and typeof(info.Color) == "Color3" then info.Color else Color3.fromRGB(255, 220, 90)
			ctx.flash(color, 0.35)
			ctx.bigText(name, color)
			ctx.play("Swing")
		end
	end
	enterWorld(world, false)
	player:GetAttributeChangedSignal("World"):Connect(function()
		local now = currentWorld()
		if now ~= world then
			enterWorld(now, true)
		end
	end)
	player:GetAttributeChangedSignal("LowGfx"):Connect(function()
		enterWorld(world, false)
	end)

	---------------------------------------------------------------------
	-- Um loop só (por frame: bichos e clima; devagar: o resto)
	---------------------------------------------------------------------
	local slow, slower = 0, 0
	RunService.Heartbeat:Connect(function(dt)
		local t = os.clock()
		local camera = workspace.CurrentCamera
		if camera then
			local offset = if weatherAbove then Vector3.new(0, 25, 0) else Vector3.new(0, -8, 0)
			anchor.CFrame = CFrame.new(camera.CFrame.Position + offset)
		end
		for _, c in critters do
			c.Update(t)
		end
		for i, p in aurora do
			p.Color = Color3.fromHSV((0.35 + 0.15 * math.sin(t * 0.3 + i)) % 1, 0.7, 1)
			p.Transparency = 0.55 + 0.2 * math.sin(t * 0.8 + i * 1.7)
		end
		spawnExtras(dt)
		geysers(dt)
		updateGravity()
		updateSirens(t)
		slow += dt
		if slow >= 0.12 then
			slow = 0
			chaseStep += 1
			local n = #chase
			for i, p in chase do
				local lit = ((chaseStep - i) % math.max(n, 1)) < 3
				p.Transparency = if lit then 0 else 0.65
			end
		end
		slower += dt
		if slower >= 1 then
			slower = 0
			updatePrizes()
			updateSleep()
		end
	end)
	WorldLife.IsSleeping = function()
		return sleeping
	end
end

return WorldLife
]]></string>
