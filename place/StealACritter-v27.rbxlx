	{ Id = "glaciaroo", World = "hybrid", Name = "Glaciaroo", Rarity = "Legendary", Price = 2_220_000, Income = 28_800, Body = "dino", Color = rgb(170, 220, 255), Accent = rgb(255, 120, 30), Material = "Ice", Glow = true, Sparkles = true },
