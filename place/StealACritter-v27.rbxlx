      <Item class="ModuleScript" referent="430">
        <Properties>
          <string name="Name">NPCs</string>
          <string name="Source"><![CDATA[--[[
	NPCs (ModuleScript em ReplicatedStorage > Shared)
	v14: personagens do mapa. Chegue perto e aperte "Talk" para ouvir dicas.
	  • Sneaky: o mascote (guaxinim gordinho com máscara de ladrão, sempre abraçado a um ovo dourado)
	  • os outros ficam nas barracas e nos lugares novos e explicam o que fazer ali
	Para mudar o que falam, edite as Lines (inglês simples: o jogo é traduzido pelo UI.csv só nos textos fixos).
	Position = onde fica (no chão); Look = para onde olha.
	v14: se existir um modelo 3D em ReplicatedStorage > Models3D > <Id>, ele é usado (senão, monta com peças).
	Height = altura em studs (padrão: 5.6 para pessoas, 6.5 para o Sneaky).
]]

local NPCs = {}

NPCs.List = {
	{
		Id = "sneaky",
		Title = "Mascot",
		Name = "Sneaky",
		Kind = "raccoon",
		Height = 6.5,
		Position = Vector3.new(12, 0, 18), -- ao lado do ponto de nascimento
		Look = Vector3.new(0, 0, 14),
		Lines = {
			"Shhh... Sneaky time! Welcome to Steal a Critter!",
			"Buy eggs on the conveyor, then watch them hatch in your base.",
			"Your critters make cash. Tap COLLECT in your base to grab it!",
			"Thieves coming? Step on LOCK BASE, or BONK them with your bat!",
			"Big players can't steal from much smaller ones. It's only fair!",
			"Psst... codes hide in my videos. Try the code SNEAKY!",
			"Hug your eggs. Eggs are life.",
		},
	},
	{
		Id = "penny",
		Title = "Shop",
		Skin = Color3.fromRGB(255, 214, 170),
		Name = "Penny",
		Kind = "person",
		Shirt = Color3.fromRGB(70, 190, 100),
		Hair = Color3.fromRGB(120, 70, 40),
		Position = Vector3.new(-195.5, 0, -46), -- atrás do balcão da SHOP
		Look = Vector3.new(-150, 0, -46),
		Lines = {
			"Hi! I run the SHOP. Buy more slots and speed with game cash!",
			"Everything in the shop shows its price before you buy.",
			"Want to go faster for free? Run on the treadmill in your base!",
		},
	},
	{
		Id = "professor",
		Title = "Mix Lab",
		Skin = Color3.fromRGB(250, 215, 180),
		Name = "Professor Mix",
		Kind = "person",
		Shirt = Color3.fromRGB(240, 240, 250),
		Hair = Color3.fromRGB(230, 230, 230),
		Position = Vector3.new(-49.5, 0, 150), -- atrás do balcão do MIX LAB
		Look = Vector3.new(0, 0, 150),
		Lines = {
			"Welcome to my MIX LAB! Pick two critters from your backpack and press MIX.",
			"If a pair doesn't mix, nothing is lost. Try another one!",
			"Open RECIPES to read the hints for every hybrid.",
		},
	},
	{
		Id = "coach",
		Title = "Minigames",
		Skin = Color3.fromRGB(141, 85, 36),
		Name = "Coach Zip",
		Kind = "person",
		Shirt = Color3.fromRGB(255, 140, 40),
		Hair = Color3.fromRGB(40, 30, 30),
		Position = Vector3.new(12, 0, 104),
		Look = Vector3.new(0, 0, 80),
		Lines = {
			"Every few minutes a MINIGAME starts. Tap JOIN at the top of the screen!",
			"In minigames everyone runs at the same speed. Only skill wins!",
			"Behind me is the GIANT EGG. Tap it with everyone to hatch it!",
			"On weekends, minigame wins give tournament points!",
		},
	},
	{
		Id = "finn",
		Title = "Fishing & Digging",
		Skin = Color3.fromRGB(234, 192, 134),
		Name = "Old Finn",
		Kind = "person",
		Shirt = Color3.fromRGB(60, 110, 200),
		Hair = Color3.fromRGB(200, 200, 200),
		Position = Vector3.new(221, 0, -118),
		Look = Vector3.new(230, 0, -140),
		Lines = {
			"Fishing is easy: tap when the hook is in the GREEN part!",
			"Three good taps and you might catch a treasure chest.",
			"Look for sand patches around the valley too. Dig them for fossils!",
		},
	},
	{
		Id = "luna",
		Title = "Worlds Guide",
		Skin = Color3.fromRGB(198, 134, 66),
		Name = "Luna",
		Kind = "person",
		Shirt = Color3.fromRGB(170, 110, 255),
		Hair = Color3.fromRGB(255, 220, 120),
		Position = Vector3.new(214, 0, 26),
		Look = Vector3.new(250, 0, 0),
		Lines = {
			"These portals lead to new WORLDS with better eggs.",
			"Some worlds need Rebirths. Rebirth keeps your critters!",
			"At minute 30 of every hour, a SECRET ISLAND opens next to the Giant Egg!",
			"Every day, 10 Hunt Eggs are hidden around Meadow. Can you find them all?",
		},
	},
	{
		Id = "captain",
		Title = "Submarine",
		Skin = Color3.fromRGB(255, 219, 172),
		Name = "Captain Coral",
		Kind = "person",
		Shirt = Color3.fromRGB(240, 240, 240),
		Hair = Color3.fromRGB(80, 60, 40),
		World = "reef",
		Position = Vector3.new(4130, 0, 64),
		Look = Vector3.new(4140, 0, 70),
		Lines = {
			"Ahoy! My SUBMARINE takes you to the bottom of the sea.",
			"Down there you'll find treasure chests and the Deep Sea Egg!",
		},
	},
}

NPCs.ById = {}
for _, npc in NPCs.List do
	NPCs.ById[npc.Id] = npc
end

return NPCs
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="431">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[--[[
	Progression (ModuleScript em ReplicatedStorage > Shared)
	Parte 26 + missões diárias + conquistas (v10). Tudo o que o servidor e as telas precisam saber:
	  • NÍVEL da conta (XP de jogar, chocar, roubar...; o mesmo limite diário anti-farm do passe)
	  • ÁRVORE DE HABILIDADES: 1 ponto por nível; Speed, Luck, Defense e Steal (5 níveis cada)
	  • CLASSES: Thief, Guardian ou Creator (trocar é grátis; espera 30 min entre trocas)
	  • PRESTÍGIO: com 10 rebirths, recomeça os rebirths e ganha aura, estrela no nome e +100% de dinheiro para sempre
	  • MISSÕES DIÁRIAS: 3 por dia (iguais para o mesmo jogador no mesmo dia), 1 troca grátis por dia
	  • CONQUISTAS: aparecem no PROFILE; se você criar os Badges no Roblox, coloque os IDs em BadgeIds
	Nada disso é vendido: tudo se ganha jogando.
]]

local Progression = {}

---------------------------------------------------------------------
-- Nível da conta
---------------------------------------------------------------------
-- XP para ir do nível L para o L+1
function Progression.LevelCost(level: number): number
	return 100 + 40 * level
end

-- (nível, XP dentro do nível, XP que falta para o próximo)
function Progression.LevelFromXP(xp: number): (number, number, number)
	local level = 1
	local left = math.max(0, math.floor(xp))
	while level < 999 and left >= Progression.LevelCost(level) do
		left -= Progression.LevelCost(level)
		level += 1
	end
	return level, left, Progression.LevelCost(level)
end

---------------------------------------------------------------------
-- Habilidades (1 ponto por nível a partir do nível 2)
---------------------------------------------------------------------
Progression.SkillOrder = { "Speed", "Luck", "Defense", "Steal" }
Progression.Skills = {
	Speed = { Name = "Speed", Max = 5, Per = 0.02, Desc = "+2% walk speed per level" },
	Luck = { Name = "Luck", Max = 5, Per = 0.05, Desc = "+5% mutation chance per level (Gold, Diamond, Rainbow)" },
	Defense = { Name = "Defense", Max = 5, Per = 3, Desc = "+3 seconds of base lock per level" },
	Steal = { Name = "Steal", Max = 5, Per = 0.02, Desc = "+2% speed while carrying a stolen critter per level" },
}

function Progression.PointsForLevel(level: number): number
	return math.max(0, level - 1)
end

---------------------------------------------------------------------
-- Classes (efeitos pequenos: ninguém fica imbatível)
---------------------------------------------------------------------
Progression.ClassOrder = { "Thief", "Guardian", "Creator" }
Progression.Classes = {
	Thief = { Name = "Thief", Desc = "+5% speed while carrying a stolen critter", Color = Color3.fromRGB(255, 110, 110) },
	Guardian = { Name = "Guardian", Desc = "+10 seconds of base lock", Color = Color3.fromRGB(90, 160, 255) },
	Creator = { Name = "Creator", Desc = "Your eggs hatch 15% faster", Color = Color3.fromRGB(120, 230, 140) },
}
Progression.ClassCooldown = 30 * 60
Progression.ThiefCarry = 0.05
Progression.GuardianLock = 10
Progression.CreatorHatch = 0.85
Progression.MaxCarryMultiplier = 0.95 -- quem carrega nunca fica mais rápido do que 95% do normal

---------------------------------------------------------------------
-- Prestígio
---------------------------------------------------------------------
Progression.PrestigeRebirths = 10 -- o 1º prestígio pede 10 rebirths; cada próximo pede +1 (11, 12...)
Progression.PrestigeBonus = 1.0 -- +100% de dinheiro por prestígio (para sempre)
Progression.PrestigeColors = {
	Color3.fromRGB(255, 210, 70),
	Color3.fromRGB(90, 230, 255),
	Color3.fromRGB(190, 110, 255),
	Color3.fromRGB(255, 110, 190),
	Color3.fromRGB(120, 255, 150),
}

function Progression.PrestigeNeed(prestige: number): number
	return Progression.PrestigeRebirths + math.max(0, prestige)
end

function Progression.PrestigeColor(prestige: number): Color3
	local colors = Progression.PrestigeColors
	return colors[math.clamp(prestige, 1, #colors)]
end

---------------------------------------------------------------------
-- Missões diárias
---------------------------------------------------------------------
-- Kind = o evento que conta; Need = quantas vezes; Weight = chance de ser sorteada
Progression.MissionPool = {
	{ Kind = "Hatch", Need = 5, Weight = 3, Text = "Hatch %d eggs" },
	{ Kind = "Buy", Need = 3, Weight = 3, Text = "Buy %d eggs from the conveyor" },
	{ Kind = "Pet", Need = 3, Weight = 2, Text = "Pet %d of your critters (press T)" },
	{ Kind = "Minute", Need = 15, Weight = 2, Text = "Play for %d minutes" },
	{ Kind = "Feed", Need = 1, Weight = 1, Text = "Feed your critters %d time" },
	{ Kind = "Steal", Need = 2, Weight = 2, Text = "Steal %d critters" },
	{ Kind = "Defend", Need = 1, Weight = 1, Text = "BONK %d thief with your bat" },
	{ Kind = "GiantEgg", Need = 1, Weight = 1, Text = "Help hatch the Giant Egg %d time" },
	{ Kind = "Rain", Need = 2, Weight = 1, Text = "Catch %d free eggs in the Egg Rain" },
	{ Kind = "Minigame", Need = 1, Weight = 2, Text = "Play %d minigame" },
	{ Kind = "Hunt", Need = 3, Weight = 2, Text = "Find %d hidden Hunt Eggs in Meadow" },
	{ Kind = "Fish", Need = 3, Weight = 1, Text = "Catch %d fish at the pond" },
	{ Kind = "Dig", Need = 2, Weight = 1, Text = "Dig %d sand patches" },
}
Progression.MissionCount = 3
Progression.MissionReward = { Minutes = 5 } -- cada missão: 5 minutos da sua renda (mínimo $1,000)
Progression.MissionBonus = { WorldEgg = 1 } -- as 3 do dia: um ovo grátis do seu melhor mundo
Progression.MissionBonusXP = 60

function Progression.MissionText(kind: string, need: number): string
	for _, info in Progression.MissionPool do
		if info.Kind == kind then
			return info.Text:format(need)
		end
	end
	return kind
end

-- As 3 missões do dia (mesmo dia + mesmo jogador = mesmas missões, até em outro servidor)
function Progression.PickMissions(userId: number, day: number, skip: string?): { { Kind: string, Need: number } }
	local random = Random.new((userId % 1000003) * 7919 + day * 104729)
	local pool = {}
	for _, info in Progression.MissionPool do
		if info.Kind ~= skip then
			table.insert(pool, info)
		end
	end
	local chosen = {}
	while #chosen < Progression.MissionCount and #pool > 0 do
		local total = 0
		for _, info in pool do
			total += info.Weight
		end
		local roll = random:NextNumber() * total
		for index, info in pool do
			roll -= info.Weight
			if roll <= 0 or index == #pool then
				table.insert(chosen, { Kind = info.Kind, Need = info.Need })
				table.remove(pool, index)
				break
			end
		end
	end
	return chosen
end

---------------------------------------------------------------------
-- Conquistas (in-game) + Badges do Roblox (opcional)
---------------------------------------------------------------------
-- Stat = campo do resumo que o servidor calcula; At = quanto precisa
Progression.Achievements = {
	{ Id = "Welcome", Name = "Welcome!", Desc = "Join Steal a Critter", Stat = "Joined", At = 1 },
	{ Id = "FirstHatch", Name = "First Hatch", Desc = "Hatch your first egg", Stat = "Hatched", At = 1 },
	{ Id = "Hatcher", Name = "Egg Expert", Desc = "Hatch 100 eggs", Stat = "Hatched", At = 100 },
	{ Id = "FirstSteal", Name = "Sneaky!", Desc = "Steal your first critter", Stat = "Steals", At = 1 },
	{ Id = "MasterThief", Name = "Master Thief", Desc = "Steal 50 critters", Stat = "Steals", At = 50 },
	{ Id = "Guardian", Name = "Base Guardian", Desc = "BONK 10 thieves", Stat = "Defends", At = 10 },
	{ Id = "Legendary", Name = "Legend!", Desc = "Find a Legendary critter", Stat = "Legendary", At = 1 },
	{ Id = "Mythic", Name = "Myth Hunter", Desc = "Find a Mythic critter", Stat = "Mythic", At = 1 },
	{ Id = "Secret", Name = "Secret Keeper", Desc = "Find a Secret critter", Stat = "Secret", At = 1 },
	{ Id = "Shiny", Name = "So Shiny!", Desc = "Hatch a SHINY critter (1 in 1000)", Stat = "Shinies", At = 1 },
	{ Id = "Mixer", Name = "Mad Scientist", Desc = "Make a hybrid at the MIX LAB", Stat = "Mixes", At = 1 },
	{ Id = "Teamwork", Name = "Teamwork", Desc = "Help hatch a Giant Egg", Stat = "GiantEggs", At = 1 },
	{ Id = "Rebirth", Name = "Reborn", Desc = "Do your first Rebirth", Stat = "Rebirths", At = 1 },
	{ Id = "Galaxy", Name = "Space Explorer", Desc = "Unlock Galaxy Station", Stat = "Galaxy", At = 1 },
	{ Id = "Collector", Name = "Collector", Desc = "Find 50 different critters", Stat = "Collected", At = 50 },
	{ Id = "Quests", Name = "Quest Master", Desc = "Finish all 3 daily quests", Stat = "MissionDays", At = 1 },
	{ Id = "Level10", Name = "Level 10", Desc = "Reach level 10", Stat = "Level", At = 10 },
	{ Id = "Prestige", Name = "PRESTIGE", Desc = "Prestige for the first time (10 rebirths)", Stat = "Prestige", At = 1 },
	{ Id = "Champion", Name = "Champion", Desc = "Win 10 minigames", Stat = "MinigameWins", At = 10 },
	{ Id = "Explorer", Name = "Explorer", Desc = "Visit the Secret Island", Stat = "IslandVisits", At = 1 },
	{ Id = "Angler", Name = "Angler", Desc = "Catch 25 fish", Stat = "Fish", At = 25 },
	{ Id = "Paleontologist", Name = "Paleontologist", Desc = "Dig up a Fossil Egg", Stat = "Fossils", At = 1 },
	{ Id = "EggHunt", Name = "Egg Hunt Master", Desc = "Find all 10 Hunt Eggs in one day", Stat = "HuntDays", At = 1 },
}
Progression.AchievementById = {}
for _, achievement in Progression.Achievements do
	Progression.AchievementById[achievement.Id] = achievement
end

-- IDs dos Badges (Creator Dashboard > seu jogo > Engagement > Badges). 0 = só a conquista dentro do jogo.
Progression.BadgeIds = {
	Welcome = 2905435231756459, -- v25: criados no Creator Hub em 29/09/2026 (5 grátis por dia)
	FirstHatch = 2046121741778047,
	Hatcher = 0,
	FirstSteal = 1340781185028401,
	MasterThief = 0,
	Guardian = 3523557668066225,
	Legendary = 953304939592936,
	Mythic = 0,
	Secret = 0,
	Shiny = 0,
	Mixer = 0,
	Teamwork = 0,
	Rebirth = 0,
	Galaxy = 0,
	Collector = 0,
	Quests = 0,
	Level10 = 0,
	Prestige = 0,
	Champion = 0,
	Explorer = 0,
	Angler = 0,
	Paleontologist = 0,
	EggHunt = 0,
}

return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="432">
        <Properties>
          <string name="Name">Seasons</string>
          <string name="Source"><![CDATA[--[[
	Seasons (ModuleScript em ReplicatedStorage > Shared)
	Parte 16: TEMPORADAS de 30 dias com passe de 30 níveis.
	  • Trilha grátis: todo mundo ganha uma recompensa a cada nível
	  • Trilha paga (Season Pass, Dev Product em Config.DevProducts.SeasonPass): mais recompensas
	  • Níveis bônus 31-60: quem NÃO tem o passe ganha as recompensas pagas de graça, uma por nível
	    (tudo que é pago dá para ganhar de graça, só que mais devagar)
	As temporadas mudam sozinhas a cada 30 dias, contando a partir de Seasons.Epoch,
	e os temas (nome, cores, trilha e título exclusivos) vão se repetindo na ordem da lista.
	XP: chocar, roubar, BONK em ladrão, fusão, rebirth, mundo novo, diária e tempo de jogo.
]]

local Seasons = {}

Seasons.Epoch = 1790380800 -- 26/09/2026 00:00 UTC = começo da Temporada 1 (mude para a data do lançamento)
Seasons.Length = 30 * 86400 -- 30 dias
Seasons.Levels = 30
Seasons.BonusLevels = 30
Seasons.BonusCost = 600 -- XP de cada nível bônus

-- XP ganho em cada ação
Seasons.XP = {
	Hatch = 5,
	Steal = 25,
	Defend = 20,
	Fuse = 30,
	Rebirth = 150,
	World = 100,
	Daily = 50,
	Minute = 2, -- a cada minuto jogando
	Mix = 30, -- híbrido no laboratório
	GiantEgg = 40, -- ajudou a chocar o Ovo Gigante do servidor
}
-- Ações que contam no limite diário (para ninguém "farmar" XP com um amigo ou outra conta)
Seasons.ActionXP = { Hatch = true, Steal = true, Defend = true, Fuse = true, Mix = true, GiantEgg = true }
Seasons.DailyActionCap = 600 -- no máximo 600 XP por dia vindos de ações (tempo de jogo, diária, rebirth e mundo não contam)
Seasons.PairCooldown = 300 -- roubar/defender contra a MESMA pessoa só dá XP 1 vez a cada 5 min

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Temas das temporadas (repetem em ordem). TrailColors/TitleColor = visual dos prêmios exclusivos.
Seasons.Themes = {
	{ Id = "sweet", Name = "Sweet Heist", Color = rgb(255, 120, 190), TrailName = "Sugar Rush", TitleName = "Sweet Thief",
		TrailColors = { rgb(255, 120, 190), rgb(255, 255, 255), rgb(120, 220, 255) }, TitleColor = rgb(255, 140, 200) },
	{ Id = "frozen", Name = "Frozen Frenzy", Color = rgb(120, 200, 255), TrailName = "Snowstorm", TitleName = "Ice Bandit",
		TrailColors = { rgb(255, 255, 255), rgb(120, 200, 255), rgb(60, 120, 230) }, TitleColor = rgb(150, 215, 255) },
	{ Id = "blaze", Name = "Lava Rush", Color = rgb(255, 120, 40), TrailName = "Firestorm", TitleName = "Lava Raider",
		TrailColors = { rgb(255, 230, 80), rgb(255, 110, 30), rgb(120, 20, 20) }, TitleColor = rgb(255, 140, 60) },
	{ Id = "deep", Name = "Deep Dive", Color = rgb(60, 210, 210), TrailName = "Tidal Wave", TitleName = "Pirate",
		TrailColors = { rgb(160, 255, 240), rgb(40, 180, 200), rgb(20, 70, 160) }, TitleColor = rgb(90, 230, 220) },
	{ Id = "star", Name = "Star Raiders", Color = rgb(170, 110, 255), TrailName = "Stardust", TitleName = "Space Thief",
		TrailColors = { rgb(255, 235, 140), rgb(190, 120, 255), rgb(40, 20, 100) }, TitleColor = rgb(200, 150, 255) },
	{ Id = "garden", Name = "Garden Party", Color = rgb(110, 210, 90), TrailName = "Petal Storm", TitleName = "Flower Bandit",
		TrailColors = { rgb(255, 170, 210), rgb(255, 240, 120), rgb(110, 210, 90) }, TitleColor = rgb(140, 225, 110) },
}

-- Qual temporada está valendo agora
function Seasons.Current(now: number): (number, any, number, number)
	local index = math.max(0, math.floor((now - Seasons.Epoch) / Seasons.Length))
	local startsAt = Seasons.Epoch + index * Seasons.Length
	local theme = Seasons.Themes[index % #Seasons.Themes + 1]
	return index + 1, theme, startsAt, startsAt + Seasons.Length
end

-- XP para passar do nível (level - 1) para o nível level
function Seasons.Cost(level: number): number
	if level <= Seasons.Levels then
		return 100 + 10 * level -- total dos 30 níveis: 7.650 XP (~25 dias jogando 20 min por dia)
	end
	return Seasons.BonusCost
end

-- Nível atual (0 a 60), XP dentro do nível e XP que falta para o próximo
function Seasons.LevelFromXP(xp: number): (number, number, number)
	local level = 0
	local left = math.max(0, math.floor(xp))
	while level < Seasons.Levels + Seasons.BonusLevels do
		local cost = Seasons.Cost(level + 1)
		if left < cost then
			return level, left, cost
		end
		left -= cost
		level += 1
	end
	return level, 0, 0
end

-- Recompensa de um nível (1 a 30) numa trilha ("Free" ou "Paid").
-- Tipos iguais aos dos códigos: Minutes, WorldEgg, BigEgg, Boost e Cosmetic ("trail:season_sweet").
function Seasons.Reward(theme, level: number, track: string)
	if track == "Free" then
		if level == 30 then
			return { Cosmetic = "title:season_" .. theme.Id, BigEgg = 1 }
		elseif level == 5 then
			return { WorldEgg = 2 }
		elseif level == 10 or level == 20 then
			return { BigEgg = 1 }
		elseif level == 15 then
			return { Boost = 20 }
		elseif level == 25 then
			return { Minutes = 30 }
		elseif level % 2 == 1 then
			return { Minutes = 5 + level // 2 }
		end
		return { WorldEgg = 1 }
	end
	if level == 5 then
		return { Cosmetic = "trail:season_" .. theme.Id }
	elseif level == 30 then
		return { Cosmetic = "decor:seasontrophy", BigEgg = 3 }
	elseif level == 10 or level == 20 then
		return { BigEgg = 2 }
	elseif level == 15 then
		return { Boost = 30 }
	elseif level == 25 then
		return { Minutes = 60 }
	elseif level % 2 == 1 then
		return { Boost = 10 }
	end
	return { WorldEgg = 2 }
end

-- Onde itens aleatórios pagos são proibidos (PolicyService), os OVOS da trilha paga viram dinheiro fixo:
-- Egg = 10 min de renda, Big Egg = 25 min de renda. Sem ovo, a recompensa não muda.
function Seasons.NoRandom(reward: any): any
	if type(reward) ~= "table" or (not reward.WorldEgg and not reward.BigEgg) then
		return reward
	end
	local safe = table.clone(reward)
	safe.Minutes = (safe.Minutes or 0) + (safe.WorldEgg or 0) * 10 + (safe.BigEgg or 0) * 25
	safe.WorldEgg = nil
	safe.BigEgg = nil
	return safe
end

-- Texto curto de uma recompensa (para a tela do passe)
function Seasons.RewardText(theme, reward): string
	local parts = {}
	if reward.Cosmetic then
		local kind = string.split(reward.Cosmetic, ":")[1]
		if kind == "trail" then
			table.insert(parts, "Trail: " .. theme.TrailName)
		elseif kind == "title" then
			table.insert(parts, "Title: " .. theme.TitleName)
		else
			table.insert(parts, "Season Trophy")
		end
	end
	if reward.Minutes then
		table.insert(parts, reward.Minutes .. " min of cash")
	end
	if reward.WorldEgg then
		table.insert(parts, reward.WorldEgg .. "x Egg")
	end
	if reward.BigEgg then
		table.insert(parts, reward.BigEgg .. "x Big Egg")
	end
	if reward.Boost then
		table.insert(parts, "2x Cash " .. reward.Boost .. " min")
	end
	return table.concat(parts, " + ")
end

return Seasons
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="433">
        <Properties>
          <string name="Name">Weekly</string>
          <string name="Source"><![CDATA[--[[
	Weekly (ModuleScript em ReplicatedStorage > Shared) - v26: CRITTER DA SEMANA
	Toda semana (segunda 00:00 UTC até domingo) um critter exclusivo sai do "Weekly Egg" da esteira do Meadow.
	A lista dos critters fica em Critters (Critters.Weekly, campo Week); o rodízio repete a cada #lista semanas.
	Servidor: Weekly.InitServer(Registry) publica os atributos no Workspace ("WeeklyName", "WeeklyId", "WeeklyEnds")
	e avisa todo mundo quando a semana vira. Cliente: lê os atributos para mostrar na tela.
]]

local Critters = require(script.Parent.Critters)

local Weekly = {}

Weekly.Enabled = true
local WEEK = 7 * 86400
local MONDAY_SHIFT = 3 * 86400 -- o "dia 0" do os.time() foi uma quinta; +3 dias = semanas começando na segunda (UTC)

function Weekly.WeekNumber(t: number?): number
	return math.floor(((t or os.time()) + MONDAY_SHIFT) / WEEK)
end

-- os.time() em que a semana atual termina (domingo 23:59:59 UTC)
function Weekly.EndsAt(t: number?): number
	return (Weekly.WeekNumber(t) + 1) * WEEK - MONDAY_SHIFT
end

function Weekly.Slot(t: number?): number
	local list = Critters.Weekly or {}
	if #list == 0 then
		return 0
	end
	return (Weekly.WeekNumber(t) % #list) + 1
end

-- Definição do critter desta semana (nil se desligado ou sem lista)
function Weekly.Current(t: number?)
	if not Weekly.Enabled then
		return nil
	end
	local list = Critters.Weekly or {}
	return list[Weekly.Slot(t)]
end

-- É o critter da semana ATUAL? (o Weekly Egg só choca esse)
function Weekly.IsCurrent(critterId: string?): boolean
	local def = Weekly.Current()
	return def ~= nil and def.Id == critterId
end

function Weekly.TimeLeftText(t: number?): string
	local left = math.max(0, Weekly.EndsAt(t) - (t or os.time()))
	local days = math.floor(left / 86400)
	local hours = math.floor((left % 86400) / 3600)
	local minutes = math.floor((left % 3600) / 60)
	if days > 0 then
		return ("%dd %dh"):format(days, hours)
	elseif hours > 0 then
		return ("%dh %dm"):format(hours, minutes)
	end
	return ("%dm"):format(math.max(1, minutes))
end

function Weekly.InitServer(Registry)
	local lastId = nil
	task.spawn(function()
		while true do
			local ok, err = pcall(function()
				local def = Weekly.Current()
				workspace:SetAttribute("WeeklyId", def and def.Id or nil)
				workspace:SetAttribute("WeeklyName", def and def.Name or nil)
				workspace:SetAttribute("WeeklyRarity", def and def.Rarity or nil)
				workspace:SetAttribute("WeeklyEnds", def and Weekly.EndsAt() or nil)
				if def and lastId ~= nil and lastId ~= def.Id and Registry and Registry.Remotes then
					Registry.Remotes.NotifyAll(("NEW WEEK! Critter of the Week: %s (%s). Find it in the Weekly Egg!"):format(def.Name, string.upper(def.Rarity)), "rare")
				end
				lastId = def and def.Id or nil
			end)
			if not ok then
				warn("[Weekly] loop error:", err)
			end
			task.wait(30)
		end
	end)
end

return Weekly
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="434">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="435">
      <Properties>
        <string name="Name">Game</string>
      </Properties>
      <Item class="ModuleScript" referent="436">
        <Properties>
          <string name="Name">Admin</string>
          <string name="Source"><![CDATA[-- Painel de admin (só aparece para você): dinheiro, ovos na esteira, bichinhos, chocar agora,
-- eventos, resetar códigos/tutorial e "Admin Abuse". (ModuleScript em ServerScriptService > Game)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Registry = require(script.Parent.Registry)

local Admin = {}

local admins: { [Player]: boolean } = {}

local function checkAdmin(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	if Config.Admins[player.UserId] then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end
	-- Jogo de grupo: coloque os UserIds dos admins em Config.Admins
	return false
end

function Admin.SetupPlayer(player: Player)
	local isAdmin = checkAdmin(player)
	admins[player] = isAdmin
	player:SetAttribute("IsAdmin", isAdmin)
end

function Admin.RemovePlayer(player: Player)
	admins[player] = nil
end

local abuseRunning = false

function Admin.Handle(player: Player, command: any)
	if not admins[player] or typeof(command) ~= "string" then
		return
	end
	local Remotes = Registry.Remotes
	local CritterService = Registry.CritterService

	if command == "Cash1M" then
		Registry.Economy.AddCash(player, 1_000_000)
	elseif command == "Cash1B" then
		Registry.Economy.AddCash(player, 1_000_000_000)
	elseif command == "Cash1T" then
		Registry.Economy.AddCash(player, 1_000_000_000_000)
	elseif command == "UnlockWorlds" then
		Registry.Worlds.UnlockAll(player)
	elseif command == "Lucky" then
		Registry.Events.StartLucky()
	elseif command == "Rain" then
		Registry.Events.StartRain()
	elseif command == "SlotUp" then
		-- +1 vaga de graça (para testar o 2º andar rápido)
		Registry.Economy.GrantSlotUpgrade(player)
	elseif command == "Rebirth" then
		-- testar rebirth rápido: dá o dinheiro exato do próximo rebirth
		Registry.Economy.AddCash(player, Config.RebirthCost(Registry.Economy.GetRebirths(player)))
	elseif Config.EggById[command] then
		-- ovo escolhido aparece na esteira
		CritterService.SpawnEggOnConveyor(Config.EggById[command])
	elseif Config.RarityByName[command] then
		-- bichinho da raridade escolhida direto na sua base
		CritterService.GrantCritter(player, CritterService.RandomDef(command).Id, nil)
	elseif Config.MutationByName[command] then
		-- bichinho Épico ou melhor já com a mutação escolhida
		local rarity = ({ "Epic", "Legendary", "Mythic" })[math.random(1, 3)]
		CritterService.GrantCritter(player, CritterService.RandomDef(rarity).Id, command)
	elseif command == "HatchNow" then
		CritterService.HatchAllNow(player)
	elseif command == "ResetCodes" then
		local profile = Registry.Data.Get(player)
		if profile then
			profile.Data.Codes = {}
		end
	elseif command == "ResetTutorial" then
		local profile = Registry.Data.Get(player)
		if profile then
			profile.Data.TutorialDone = false
			player:SetAttribute("TutorialStep", nil)
			Registry.Tutorial.Start(player)
		end
	elseif command == "Give5Same" then
		-- 5 bichinhos iguais na mochila (para testar a fusão)
		Registry.Pets.AdminGive(player, CritterService.RandomDef("Rare").Id, nil, 5)
	elseif command == "Give3D" then
		-- v14: os 6 bichinhos que têm modelo 3D (mais um Gold para ver a "estátua") na mochila
		for _, id in { "coconutcrab", "islandtortoise", "tinyrex", "amberraptor", "glowsquid", "isopodking" } do
			Registry.Pets.AdminGive(player, id, nil, 1)
		end
		Registry.Pets.AdminGive(player, "tinyrex", "Gold", 1)
	elseif command == "Give5Gold" then
		-- 5 Gold iguais (fusão em Rainbow)
		Registry.Pets.AdminGive(player, CritterService.RandomDef("Epic").Id, "Gold", 5)
	elseif command == "PassOn" then
		Registry.Season.GrantPass(player)
	elseif command == "XP500" then
		Registry.Season.AddXP(player, 500, "Admin")
	elseif command == "Boost5" then
		Registry.Codes.AddBoost(player, 5)
	elseif command == "ShieldOff" then
		-- acaba o escudo de novato de TODOS no servidor (para testar roubo sem esperar 10 min)
		for _, other in Players:GetPlayers() do
			Registry.Fairness.EndShield(other)
		end
	elseif command == "ShieldMe" then
		-- você volta a ter 10 min de escudo
		Registry.Fairness.RestartShield(player)
	elseif command == "WeatherRain" or command == "WeatherSnow" or command == "WeatherSun" then
		Registry.Environment.SetWeather(string.sub(command, 8))
	elseif command == "NightNow" then
		Registry.Environment.ForceNight(180)
	elseif command == "ShinyNext" then
		-- o próximo ovo comprado (ou o próximo prêmio do Ovo Gigante) sai SHINY
		CritterService.ShinyNext = true
	elseif command == "GiantEggFill" then
		Registry.GiantEgg.AdminFill(player)
	elseif command == "Invasion" then
		Registry.LiveEvents.StartInvasion()
	elseif command == "Bandit" then
		if not Config.Bandits or not Config.Bandits.Enabled then
			Registry.Remotes.Notify(player, "Bandit is OFF (Config.Bandits.Enabled = false).", "warning")
		elseif not Registry.Bandits.ForceVisit(player) then
			Registry.Remotes.Notify(player, "Bandit already on the way (or no base).", "warning")
		end
	elseif command == "VoteNow" then
		Registry.LiveEvents.StartVote()
	elseif command == "Halloween" or command == "Winter" or command == "Valentine" or command == "Summer" then
		Registry.LiveEvents.ForceHoliday(string.lower(command))
	elseif command == "HolidayOff" then
		Registry.LiveEvents.ForceHoliday(nil)
	elseif command == "CreatorVisit" then
		Registry.LiveEvents.CreatorArrived(nil)
	elseif command == "Goal10K" then
		Registry.LiveEvents.AdminAddLocal(10000) -- só neste servidor (não muda a meta de verdade)
	elseif string.sub(command, 1, 2) == "Mg" and Config.MinigameById[string.sub(command, 3)] then
		-- anuncia esse minigame agora (admin: começa mesmo com pouca gente)
		Registry.Minigames.Announce(string.sub(command, 3), true)
	elseif command == "IslandOpen" then
		Registry.Explore.ForceIsland(300) -- ilha secreta aberta agora por 5 min
	elseif command == "AdminAbuse" then
		if abuseRunning then
			return
		end
		abuseRunning = true
		Remotes.NotifyAll("ADMIN ABUSE! Royal and COSMIC eggs incoming!", "rare")
		Remotes.EffectAll("Lucky")
		task.spawn(function()
			for i = 1, 12 do
				local egg = Config.EggById[if i % 3 == 0 then "cosmic" else "royal"]
				CritterService.SpawnEggOnConveyor(egg, nil, true)
				task.wait(1.5)
			end
			abuseRunning = false
		end)
	else
		return
	end
	Remotes.Notify(player, "Admin: " .. command, "info")
end

function Admin.Init()
	Players.PlayerRemoving:Connect(Admin.RemovePlayer)
end

return Admin
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="437">
        <Properties>
          <string name="Name">Analytics</string>
          <string name="Source"><![CDATA[--[[
	Analytics (ModuleScript em ServerScriptService > Game)
	Manda números para o painel do Creator Hub (Analytics > Funnels / Economy / Custom):
	  • FUNIL do tutorial: onde os jogadores novos desistem
	  • ECONOMIA: de onde vem o dinheiro (coletar, vender, diária...) e para onde vai (ovos, vagas...)
	  • EVENTOS: ovos chocados por raridade, roubos, códigos, rebirths
	O dinheiro é somado e enviado 1x por minuto (o Roblox tem limite de eventos por minuto).
	Se algo falhar aqui, o jogo continua normal (tudo dentro de pcall).
]]

local AnalyticsService = game:GetService("AnalyticsService")

local Analytics = {}

local CURRENCY = "Cash"
local FLUSH_EVERY = 60

-- buffer[player][flow][kind] = soma
local buffer: { [Player]: { Source: { [string]: number }, Sink: { [string]: number } } } = {}
local funnelDone: { [Player]: { [number]: boolean } } = {}

local FUNNEL_STEPS = {
	"Joined",
	"BoughtEgg",
	"EggArrived",
	"Hatched",
	"Collected",
	"Locked",
	"Finished",
}

local function safe(callback: () -> ())
	local ok, err = pcall(callback)
	if not ok then
		warn("[Analytics]", err)
	end
end

local function cashOf(player: Player): number
	local cash = player:GetAttribute("Cash")
	return if typeof(cash) == "number" then cash else 0
end

local function add(player: Player, flow: string, kind: string, amount: number)
	if amount ~= amount or amount <= 0 then
		return
	end
	local entry = buffer[player]
	if not entry then
		entry = { Source = {}, Sink = {} }
		buffer[player] = entry
	end
	local list = entry[flow]
	list[kind] = (list[kind] or 0) + amount
end

local function flush(player: Player)
	local entry = buffer[player]
	if not entry then
		return
	end
	buffer[player] = nil
	local balance = cashOf(player)
	for kind, amount in entry.Source do
		safe(function()
			AnalyticsService:LogEconomyEvent(player, Enum.AnalyticsEconomyFlowType.Source, CURRENCY, math.floor(amount), balance, kind)
		end)
	end
	for kind, amount in entry.Sink do
		safe(function()
			AnalyticsService:LogEconomyEvent(player, Enum.AnalyticsEconomyFlowType.Sink, CURRENCY, math.floor(amount), balance, kind)
		end)
	end
end

-- Dinheiro que ENTRA (kind: "Collect", "Sell", "Daily", "Offline", "Code", "Tutorial", "CashPack"...)
function Analytics.CashSource(player: Player, amount: number, kind: string)
	add(player, "Source", kind, amount)
end

-- Dinheiro que SAI (kind: "Egg", "Speed", "Slot", "Rebirth")
function Analytics.CashSink(player: Player, amount: number, kind: string)
	add(player, "Sink", kind, amount)
end

-- Funil do tutorial (cada passo só conta 1x por jogador)
function Analytics.Funnel(player: Player, stepName: string)
	local step = table.find(FUNNEL_STEPS, stepName)
	if not step then
		return
	end
	local done = funnelDone[player]
	if not done then
		done = {}
		funnelDone[player] = done
	end
	if done[step] then
		return
	end
	done[step] = true
	safe(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, step, stepName)
	end)
end

function Analytics.Event(player: Player, eventName: string, value: number?)
	safe(function()
		AnalyticsService:LogCustomEvent(player, eventName, value or 1)
	end)
end

-- Chamados pelo CritterService
function Analytics.EggBought(player: Player, egg, price: number)
	Analytics.CashSink(player, price, "Egg")
	Analytics.Event(player, "EggBought_" .. egg.Id)
end

function Analytics.Hatched(player: Player, def, _mutation: string?, _egg)
	Analytics.Event(player, "Hatch_" .. def.Rarity)
end

function Analytics.Stole(player: Player, _rec)
	Analytics.Event(player, "Steal")
end

-- Chamado pelo Main quando o jogador sai (depois de guardar o dinheiro do coletor)
function Analytics.RemovePlayer(player: Player)
	flush(player)
	buffer[player] = nil
	funnelDone[player] = nil
end

function Analytics.Init()
	task.spawn(function()
		while true do
			task.wait(FLUSH_EVERY)
			local ok, err = pcall(function()
				for player in buffer do
					if player.Parent then
						flush(player)
					else
						buffer[player] = nil
					end
				end
			end)
			if not ok then
				warn("[Analytics] loop error:", err)
			end
		end
	end)
end

return Analytics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="438">
        <Properties>
          <string name="Name">Bandits</string>
          <string name="Source"><![CDATA[--[[
	Bandits (ModuleScript em ServerScriptService > Game)
	v24: LADRÃO NPC para servidor vazio. Quando tem pouca gente online (Config.Bandits.MaxPlayers),
	um guaxinim "Bandit" (primo do Sneaky) aparece de tempos em tempos, vai até a base de um jogador
	e fica alguns segundos "roubando" o dinheiro do COLETOR (nunca leva bichinhos, nunca mexe no save).
	  • O dono dá BONK nele com o taco (Config.Bandits.Hits pancadas): ganha dinheiro, às vezes um ovo,
	    e conta na missão diária "BONK a thief" (que era impossível em servidor vazio).
	  • Se ninguém derruba: o Bandit foge com uma parte do dinheiro que estava no coletor (Vault).
	  • Base trancada: o Bandit bate no laser e vai embora (ensina a usar a trava).
	Os números ficam em Config.Bandits. O Combat chama Bandits.Hit quando o taco acerta um "Bandit".
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Models3D = require(ReplicatedStorage.Shared.Models3D)
local Critters = require(ReplicatedStorage.Shared.Critters)
local Registry = require(script.Parent.Registry)

local Bandits = {}

type Bandit = {
	Model: Model,
	Root: BasePart,
	Humanoid: Humanoid,
	Target: Player,
	HP: number,
	MaxHP: number,
	Hitters: { [Player]: boolean },
	Title: TextLabel,
	Hearts: TextLabel,
	Status: TextLabel,
	State: string, -- "Walking" | "Stealing" | "Fleeing" | "Down"
	StealUntil: number,
	Id: number,
	Loot: string?, -- v25: id do critter que ele trouxe nas costas (bonk = vira seu)
	PadPosition: Vector3?, -- onde ele fica roubando (volta para lá depois de uma pancada)
}

local bandits: { [Model]: Bandit } = {}
local byTarget: { [Player]: Bandit } = {}
local nextVisit: { [Player]: number } = {}
local folder: Folder? = nil
local banditId = 0

local function settings()
	return Config.Bandits
end

local function now(): number
	return workspace:GetServerTimeNow()
end

local function getData(player: Player)
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

local function random(range: { number }): number
	return range[1] + math.random() * (range[2] - range[1])
end

local function scheduleVisit(player: Player, seconds: number)
	nextVisit[player] = now() + seconds
end

-- Quantos jogadores carregados estão no servidor
local function loadedCount(): number
	local count = 0
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("Loaded") then
			count += 1
		end
	end
	return count
end

---------------------------------------------------------------------
-- Boneco
---------------------------------------------------------------------
local function part(name: string, size: Vector3, color: Color3, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanTouch = false
	p.Massless = true
	if shape then
		p.Shape = shape
	end
	return p
end

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

local function heartsText(hp: number, max: number): string
	return string.rep("\u{2764}", hp) .. string.rep("\u{2661}", math.max(0, max - hp))
end

local function makeLabel(parent: Instance, size: UDim2, position: UDim2, text: string, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(20, 20, 30)
	stroke.Parent = label
	label.Parent = parent
	return label
end

local function buildBandit(position: Vector3, hp: number, target: Player): Bandit
	local model = Instance.new("Model")
	model.Name = "Bandit"
	local root = part("HumanoidRootPart", Vector3.new(3, 3, 3), Color3.new(1, 1, 1))
	root.Transparency = 1
	root.Massless = false
	root.CFrame = CFrame.new(position)
	root.Parent = model
	model.PrimaryPart = root

	-- modelo 3D do Sneaky (ReplicatedStorage > Models3D > sneaky), se existir; senão, um guaxinim de peças
	local mesh = Models3D.Get("sneaky", { Size = 5.6, Fit = "Height", Anchored = false })
	if mesh then
		mesh:PivotTo(root.CFrame * CFrame.new(0, -3.7, 0)) -- pés no chão (HipHeight 2.2 + meia raiz 1.5)
		for _, d in mesh:GetDescendants() do
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanQuery = false
				d.Massless = true
				d.Parent = model
				weld(root, d)
			end
		end
		mesh:Destroy()
	else
		local gray = Color3.fromRGB(120, 120, 130)
		local body = part("Body", Vector3.new(3.6, 3.2, 3.6), gray, Enum.PartType.Ball)
		body.CFrame = root.CFrame * CFrame.new(0, -0.6, 0)
		body.Parent = model
		weld(root, body)
		local head = part("Head", Vector3.new(2.4, 2.4, 2.4), gray, Enum.PartType.Ball)
		head.CFrame = root.CFrame * CFrame.new(0, 1.6, -0.4)
		head.Parent = model
		weld(root, head)
		local mask = part("Mask", Vector3.new(2.5, 0.8, 1.2), Color3.fromRGB(35, 30, 40))
		mask.CFrame = root.CFrame * CFrame.new(0, 1.8, -1.4)
		mask.Parent = model
		weld(root, mask)
		for side = -1, 1, 2 do
			local eye = part("Eye", Vector3.new(0.5, 0.5, 0.5), Color3.new(1, 1, 1), Enum.PartType.Ball)
			eye.CFrame = root.CFrame * CFrame.new(side * 0.55, 1.85, -1.95)
			eye.Parent = model
			weld(root, eye)
			local ear = part("Ear", Vector3.new(0.8, 0.8, 0.4), gray)
			ear.CFrame = root.CFrame * CFrame.new(side * 0.9, 2.8, -0.2)
			ear.Parent = model
			weld(root, ear)
		end
		local tail = part("Tail", Vector3.new(1, 1, 3), Color3.fromRGB(70, 65, 80))
		tail.CFrame = root.CFrame * CFrame.new(0, -0.4, 2.6) * CFrame.Angles(math.rad(35), 0, 0)
		tail.Parent = model
		weld(root, tail)
	end
	-- bandana vermelha: mostra que é o ladrão, não o mascote
	local bandana = part("Bandana", Vector3.new(2.7, 0.5, 2.7), Color3.fromRGB(220, 40, 50), Enum.PartType.Cylinder)
	bandana.CFrame = root.CFrame * CFrame.new(0, 2.5, -0.3) * CFrame.Angles(0, 0, math.rad(90))
	bandana.Parent = model
	weld(root, bandana)

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15 -- sem pernas: fica de pé pela HipHeight
	humanoid.HipHeight = 2.2
	humanoid.WalkSpeed = settings().WalkSpeed
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.BreakJointsOnDeath = false
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	humanoid.Parent = model

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(9, 3.4)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 4.6, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 140
	gui.AlwaysOnTop = true
	local title = makeLabel(gui, UDim2.fromScale(1, 0.36), UDim2.fromScale(0, 0), "BANDIT!", Color3.fromRGB(255, 215, 60))
	local hearts = makeLabel(gui, UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 0.36), heartsText(hp, hp), Color3.fromRGB(255, 90, 120))
	local status = makeLabel(gui, UDim2.fromScale(1, 0.34), UDim2.fromScale(0, 0.66), "BONK me with your bat!", Color3.new(1, 1, 1))
	gui.Parent = root

	model:AddTag("Bandit")
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	banditId += 1
	return {
		Model = model,
		Root = root,
		Humanoid = humanoid,
		Target = target,
		HP = hp,
		MaxHP = hp,
		Hitters = {},
		Title = title,
		Hearts = hearts,
		Status = status,
		State = "Walking",
		StealUntil = 0,
		Id = banditId,
		Loot = nil,
		PadPosition = nil,
	}
end

local function remove(bandit: Bandit)
	bandits[bandit.Model] = nil
	if byTarget[bandit.Target] == bandit then
		byTarget[bandit.Target] = nil
	end
	bandit.Model:Destroy()
end

---------------------------------------------------------------------
-- v25: Bandit com um critter roubado nas costas (de outra base...). BONK = o critter cai e vira seu.
---------------------------------------------------------------------
local function pickLoot(): string?
	local s = settings()
	if math.random() >= (s.CarryChance or 0) then
		return nil
	end
	local pool = {}
	for _, def in Critters.List do
		if (def.World == nil or def.World == "meadow") and (def.Rarity == "Common" or def.Rarity == "Uncommon") and not def.RebirthRequired then
			table.insert(pool, def.Id)
		end
	end
	if #pool == 0 then
		return nil
	end
	return pool[math.random(#pool)]
end

local function attachLoot(bandit: Bandit, critterId: string)
	local def = Critters.ById[critterId]
	if not def then
		return
	end
	bandit.Loot = critterId
	local mesh = Models3D.Get(critterId, { Size = 2.6, Fit = "Height", Anchored = false })
	if mesh then
		-- nas costas, de cabeça para baixo (carregado como saco)
		mesh:PivotTo(bandit.Root.CFrame * CFrame.new(0, 1.2, 2.2) * CFrame.Angles(0, math.pi, math.rad(180)))
		for _, d in mesh:GetDescendants() do
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanQuery = false
				d.Massless = true
				d.Parent = bandit.Model
				weld(bandit.Root, d)
			end
		end
		mesh:Destroy()
	else
		local sack = part("Loot", Vector3.new(2.2, 2.2, 2.2), def.Color or Color3.fromRGB(200, 200, 200), Enum.PartType.Ball)
		sack.CFrame = bandit.Root.CFrame * CFrame.new(0, 1.4, 2.2)
		sack.Parent = bandit.Model
		weld(bandit.Root, sack)
	end
	bandit.Title.Text = "BANDIT + " .. string.upper(def.Name) .. "!"
end

---------------------------------------------------------------------
-- Prêmio / castigo
---------------------------------------------------------------------
local function rewardText(player: Player): string
	local Economy = Registry.Economy
	local s = settings()
	local amount = math.floor(math.max(Economy.GetIncome(player) * 60 * s.RewardMinutes, s.RewardMinCash))
	Economy.AddCash(player, amount, false, "Bandit")
	local text = "+" .. Format.Money(amount)
	if math.random() < s.EggChance and Config.EggById[s.EggId] then
		local ok = Registry.CritterService.GrantEgg(player, s.EggId)
		text ..= " + " .. Config.EggById[s.EggId].Name .. (if ok then "" else " (queued: base full)")
	end
	return text
end

-- Chamado pelo Combat quando um taco acerta um Bandit
function Bandits.Hit(model: Model, player: Player)
	local bandit = bandits[model]
	if not bandit or bandit.HP <= 0 or bandit.State == "Down" then
		return
	end
	bandit.HP -= 1
	bandit.Hitters[player] = true
	bandit.Hearts.Text = heartsText(bandit.HP, bandit.MaxHP)
	Registry.Remotes.EffectAll("Bonk", bandit.Root.Position + Vector3.new(0, 3, 0))
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		local away = bandit.Root.Position - root.Position
		local flat = Vector3.new(away.X, 0, away.Z)
		if flat.Magnitude > 0.1 then
			-- empurrão curto (o ladrão fica perto para a 2ª pancada) e ele "perde" 2 s do roubo
			bandit.Root.AssemblyLinearVelocity = flat.Unit * 12 + Vector3.new(0, 16, 0)
		end
	end
	if bandit.HP > 0 then
		bandit.Status.Text = "Ouch! Again!"
		if bandit.State == "Stealing" then
			bandit.StealUntil += 2
			-- volta para o coletor (fica ao alcance da 2ª pancada)
			local id = bandit.Id
			task.delay(0.8, function()
				if bandits[bandit.Model] and bandit.Id == id and bandit.State == "Stealing" and bandit.PadPosition then
					bandit.Humanoid:MoveTo(bandit.PadPosition)
				end
			end)
		end
		return
	end
	-- derrubado: quem bateu ganha
	bandit.State = "Down"
	local position = bandit.Root.Position
	Registry.Remotes.EffectAll("HatchBurst", { Position = position, Rarity = "Rare" })
	for hitter in bandit.Hitters do
		if hitter.Parent and hitter:GetAttribute("Loaded") then
			local text = rewardText(hitter)
			if bandit.Loot and Critters.ById[bandit.Loot] then
				-- v25: o critter que ele carregava cai e vira do jogador que derrubou (o primeiro que bateu)
				local ok = Registry.CritterService.GrantCritter(hitter, bandit.Loot, nil, os.time())
				if ok then
					text ..= " + " .. Critters.ById[bandit.Loot].Name .. " (dropped!)"
					if Registry.Progress then
						pcall(Registry.Progress.Event, hitter, "Steal") -- conta na missão "Steal X critters"
					end
					bandit.Loot = nil
				end
			end
			Registry.Remotes.Notify(hitter, "You BONKED the Bandit! " .. text, "success")
			Registry.Economy.AddDefense(hitter, nil) -- conquista "Base Guardian" + missão "BONK a thief" + XP
			if Registry.Analytics then
				pcall(Registry.Analytics.Event, hitter, "BanditBonked")
			end
		end
	end
	remove(bandit)
end

local function flee(bandit: Bandit, text: string)
	if bandit.State == "Down" then
		return
	end
	bandit.State = "Fleeing"
	bandit.Status.Text = text
	bandit.Humanoid.WalkSpeed = settings().WalkSpeed * 1.6
	local plot = Registry.Plots.Get(bandit.Target)
	local outside = if plot then (Registry.Plots.PathPoints(plot)) else bandit.Root.Position
	bandit.Humanoid:MoveTo(outside + (outside - bandit.Root.Position).Unit * 60)
	local id = bandit.Id
	task.delay(5, function()
		if bandits[bandit.Model] and bandit.Id == id then
			remove(bandit)
		end
	end)
end

local function stealAndFlee(bandit: Bandit)
	local owner = bandit.Target
	local plot = Registry.Plots.Get(owner)
	local s = settings()
	local taken = 0
	if plot and owner.Parent and owner:GetAttribute("Loaded") then
		local cap = math.max(Registry.Economy.GetIncome(owner) * 60 * s.VaultMaxMinutes, 50)
		taken = math.floor(math.min(plot.Vault * s.VaultShare, cap))
		if taken >= 1 then
			plot.Vault -= taken
			if Registry.Analytics then
				pcall(Registry.Analytics.Event, owner, "BanditStole", taken)
			end
		end
	end
	if taken >= 1 then
		Registry.Remotes.Notify(owner, ("The Bandit ran off with %s from your collector! BONK him next time (or LOCK your base)."):format(Format.Money(taken)), "warning")
		flee(bandit, "Hehe! Got " .. Format.Money(taken) .. "!")
	else
		Registry.Remotes.Notify(owner, "The Bandit found your collector empty and left. Nice!", "info")
		flee(bandit, "Empty?! Boo!")
	end
end

---------------------------------------------------------------------
-- Visita
---------------------------------------------------------------------
local function canVisit(player: Player): boolean
	if not player.Parent or not player:GetAttribute("Loaded") or player:GetAttribute("Leaving") then
		return false
	end
	local data = getData(player)
	if not data or not data.TutorialDone then
		return false
	end
	if (player:GetAttribute("World") or "meadow") ~= "meadow" or player:GetAttribute("InMinigame") then
		return false
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	local plot = Registry.Plots.Get(player)
	if not plot or plot.Owner ~= player then
		return false
	end
	if #Registry.CritterService.GetBaseList(player) < 1 then
		return false -- sem bichinho, sem coletor rendendo: nada para "roubar"
	end
	return true
end

local function startVisit(player: Player)
	local plot = Registry.Plots.Get(player)
	if not plot then
		return
	end
	local s = settings()
	local outside, inside = Registry.Plots.PathPoints(plot)
	local start = outside + (outside - inside).Unit * 30 -- começa lá no caminho, vindo em direção à base
	local bandit = buildBandit(Vector3.new(start.X, 3.5, start.Z), s.Hits, player)
	bandits[bandit.Model] = bandit
	byTarget[player] = bandit
	local loot = pickLoot()
	if loot then
		attachLoot(bandit, loot)
		Registry.Remotes.Notify(player, "A BANDIT with a stolen critter is sneaking to your base! BONK him and the critter is YOURS!", "warning")
	else
		Registry.Remotes.Notify(player, "A BANDIT is sneaking to your base! BONK him with your bat!", "warning")
	end
	Registry.Remotes.Effect(player, "Alarm")
	if Registry.Analytics then
		pcall(Registry.Analytics.Event, player, "BanditVisit")
	end

	local id = bandit.Id
	task.spawn(function()
		local function alive(): boolean
			return bandits[bandit.Model] ~= nil and bandit.Id == id and bandit.State ~= "Down"
		end
		-- 1) anda até a entrada
		bandit.Humanoid:MoveTo(outside)
		bandit.Humanoid.MoveToFinished:Wait()
		if not alive() then
			return
		end
		-- 2) base trancada? bate no laser e foge
		if Registry.Plots.IsLocked(plot) then
			Registry.Remotes.Notify(player, "Your LOCK kept the Bandit out! Well done!", "success")
			flee(bandit, "Ouch! Lasers!")
			return
		end
		-- 3) entra e vai até o coletor
		bandit.Humanoid:MoveTo(inside)
		bandit.Humanoid.MoveToFinished:Wait()
		if not alive() then
			return
		end
		local pad: BasePart = plot.CollectPad
		bandit.PadPosition = pad.Position + Vector3.new(0, 0, 3)
		bandit.Humanoid:MoveTo(bandit.PadPosition)
		bandit.Humanoid.MoveToFinished:Wait()
		if not alive() then
			return
		end
		if Registry.Plots.IsLocked(plot) then
			Registry.Remotes.Notify(player, "Your LOCK kicked the Bandit out! Well done!", "success")
			flee(bandit, "Ouch! Lasers!")
			return
		end
		-- 4) rouba por alguns segundos (dá tempo do dono chegar e dar BONK)
		bandit.State = "Stealing"
		bandit.StealUntil = now() + s.StealSeconds
		while alive() and bandit.State == "Stealing" do
			local left = math.ceil(bandit.StealUntil - now())
			if left <= 0 then
				break
			end
			bandit.Status.Text = ("Stealing your cash... %ds"):format(left)
			if Registry.Plots.IsLocked(plot) then
				Registry.Remotes.Notify(player, "Your LOCK kicked the Bandit out! Well done!", "success")
				flee(bandit, "Ouch! Lasers!")
				return
			end
			task.wait(0.5)
		end
		if alive() and bandit.State == "Stealing" then
			stealAndFlee(bandit)
		end
	end)
end

-- Teste/admin: manda um Bandit agora para a base do jogador (ignora o relógio; respeita só a base)
function Bandits.ForceVisit(player: Player): boolean
	if not folder or byTarget[player] or not Registry.Plots.Get(player) then
		return false
	end
	startVisit(player)
	return true
end

---------------------------------------------------------------------
function Bandits.Init()
	local s = settings()
	if not s or not s.Enabled then
		return
	end
	folder = Instance.new("Folder")
	folder.Name = "Bandits"
	folder.Parent = workspace

	local function watch(player: Player)
		scheduleVisit(player, s.FirstAfter)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		nextVisit[player] = nil
		local bandit = byTarget[player]
		if bandit then
			remove(bandit)
		end
	end)
	CollectionService:GetInstanceRemovedSignal("Bandit"):Connect(function(instance)
		local bandit = bandits[instance :: Model]
		if bandit then
			bandits[instance :: Model] = nil
			if byTarget[bandit.Target] == bandit then
				byTarget[bandit.Target] = nil
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(3)
			local ok, err = pcall(function()
				if loadedCount() > s.MaxPlayers or workspace:GetAttribute("InvasionUntil") ~= nil then
					return -- servidor cheio ou invasão: os ladrões de verdade/monstros já dão trabalho
				end
				local t = now()
				for _, player in Players:GetPlayers() do
					local due = nextVisit[player]
					if due and t >= due and not byTarget[player] then
						if canVisit(player) then
							scheduleVisit(player, random(s.Every))
							startVisit(player)
						else
							scheduleVisit(player, 30) -- tenta de novo daqui a pouco
						end
					end
				end
			end)
			if not ok then
				warn("[Bandits] loop error:", err)
			end
		end
	end)
end

return Bandits
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="439">
        <Properties>
          <string name="Name">Battle</string>
          <string name="Source"><![CDATA[--[[
	Battle (ModuleScript em ServerScriptService > Game)
	Parte 23 (v12): CRITTER BATTLE, a batalha por turnos da ilha dos minigames.
	  • Cada jogador luta com o SEU melhor bichinho (da base ou da mochila). Duelos 1 contra 1;
	    se sobrar alguém, luta contra um Grumblob.
	  • A cada turno (8 s) os dois escolhem ao mesmo tempo: ATTACK, DEFEND (leva só 35% do dano e cura um pouco)
	    ou SPECIAL (1,8x de dano; depois precisa esperar 3 turnos). Quem não escolher, ataca.
	  • A raridade ajuda só um pouco (no máximo ~30%): escolher bem o DEFEND/SPECIAL vence bichinho mais forte.
	O servidor sorteia e calcula tudo; a tela só manda a escolha ("BattleMove").
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Critters = require(ReplicatedStorage.Shared.Critters)
local Registry = require(script.Parent.Registry)

local Battle = {}

local TURN_SECONDS = 8
local MAX_TURNS = 10
local SPECIAL_COOLDOWN = 3
local MUTATION_BONUS = { Gold = 0.05, Diamond = 0.10, Rainbow = 0.15 }

type Fighter = {
	Player: Player?,
	Name: string,
	Critter: string,
	Mutation: string?,
	HP: number,
	Max: number,
	Atk: number,
	SpecialAt: number,
	Choice: string?,
}
type Duel = { A: Fighter, B: Fighter, Turn: number, Deadline: number, Log: string, Done: boolean, Winner: Fighter? }

local duels: { Duel } = {}
local fighterOf: { [Player]: Fighter } = {}
local duelOf: { [Player]: Duel } = {}
local running = false
local random = Random.new()

-- O melhor bichinho do jogador (base + mochila)
local function bestCritter(player: Player): (string, string?)
	local bestId, bestMutation, bestScore = "blobby", nil, -1
	local function consider(id: any, mutation: any)
		local def = type(id) == "string" and Critters.ById[id]
		if not def then
			return
		end
		local score = (Config.RarityIndex[def.Rarity] or 1) * 10 + (if mutation and MUTATION_BONUS[mutation] then MUTATION_BONUS[mutation] * 20 else 0)
		if score > bestScore then
			bestId, bestMutation, bestScore = def.Id, if type(mutation) == "string" then mutation else nil, score
		end
	end
	for _, item in Registry.CritterService.GetBaseList(player) do
		consider(item.Id, item.M)
	end
	local profile = Registry.Data.Get(player)
	if profile and type(profile.Data.Inventory) == "table" then
		for _, item in profile.Data.Inventory do
			consider(item.Id, item.M)
		end
	end
	return bestId, bestMutation
end

local function makeFighter(player: Player?): Fighter
	if not player then
		return { Player = nil, Name = "Grumblob", Critter = "", Mutation = nil, HP = 120, Max = 120, Atk = 20, SpecialAt = 1, Choice = nil }
	end
	local id, mutation = bestCritter(player)
	local def = Critters.ById[id]
	local tier = Config.RarityIndex[def.Rarity] or 1
	local bonus = 1 + (if mutation then MUTATION_BONUS[mutation] or 0 else 0)
	local hp = math.floor((100 + tier * 8) * bonus)
	return {
		Player = player,
		Name = player.DisplayName,
		Critter = id,
		Mutation = mutation,
		HP = hp,
		Max = hp,
		Atk = math.floor((16 + tier * 1.5) * bonus),
		SpecialAt = 1,
		Choice = nil,
	}
end

local function view(fighter: Fighter, turn: number)
	return {
		Name = fighter.Name,
		Critter = fighter.Critter,
		M = fighter.Mutation,
		HP = math.max(0, math.floor(fighter.HP)),
		Max = fighter.Max,
		SpecialIn = math.max(0, fighter.SpecialAt - turn),
	}
end

local function send(duel: Duel)
	for _, pair in { { duel.A, duel.B }, { duel.B, duel.A } } do
		local me, foe = pair[1], pair[2]
		local player = me.Player
		if player and player.Parent then
			Registry.Remotes.BattleEvent:FireClient(player, {
				Me = view(me, duel.Turn),
				Foe = view(foe, duel.Turn),
				Turn = duel.Turn,
				Deadline = duel.Deadline,
				Log = duel.Log,
				Done = duel.Done,
				Won = duel.Done and duel.Winner == me,
				Chosen = me.Choice,
			})
		end
	end
end

local function botChoice(bot: Fighter, turn: number): string
	if bot.SpecialAt <= turn and random:NextNumber() < 0.45 then
		return "Special"
	end
	return if random:NextNumber() < 0.25 then "Defend" else "Attack"
end

local function damageOf(attacker: Fighter, turn: number): number
	local choice = attacker.Choice
	if choice == "Special" and attacker.SpecialAt <= turn then
		attacker.SpecialAt = turn + SPECIAL_COOLDOWN
		return attacker.Atk * 1.8 * random:NextNumber(0.9, 1.1)
	elseif choice == "Defend" then
		return 0
	end
	attacker.Choice = "Attack" -- special ainda carregando: vira ataque normal
	return attacker.Atk * random:NextNumber(0.85, 1.15)
end

local ACTION_TEXT = { Attack = "ATTACK", Defend = "DEFEND", Special = "SPECIAL" }

local function resolve(duel: Duel)
	local a, b = duel.A, duel.B
	a.Choice = a.Choice or (if a.Player then "Attack" else botChoice(a, duel.Turn))
	b.Choice = b.Choice or (if b.Player then "Attack" else botChoice(b, duel.Turn))
	local toB = damageOf(a, duel.Turn)
	local toA = damageOf(b, duel.Turn)
	if b.Choice == "Defend" then
		toB *= 0.35
		b.HP = math.min(b.Max, b.HP + 6)
	end
	if a.Choice == "Defend" then
		toA *= 0.35
		a.HP = math.min(a.Max, a.HP + 6)
	end
	a.HP -= toA
	b.HP -= toB
	duel.Log = ("%s: %s (-%d)  |  %s: %s (-%d)"):format(
		a.Name,
		ACTION_TEXT[a.Choice or "Attack"] or "ATTACK",
		math.floor(toB + 0.5),
		b.Name,
		ACTION_TEXT[b.Choice or "Attack"] or "ATTACK",
		math.floor(toA + 0.5)
	)
	a.Choice, b.Choice = nil, nil
	if a.HP <= 0 or b.HP <= 0 or duel.Turn >= MAX_TURNS then
		duel.Done = true
		-- quem ficou com mais vida (em %) vence; empate: sorteio
		local ra, rb = a.HP / a.Max, b.HP / b.Max
		duel.Winner = if ra > rb then a elseif rb > ra then b elseif random:NextNumber() < 0.5 then a else b
	end
end

local function runDuel(duel: Duel)
	while running and not duel.Done do
		duel.Turn += 1
		duel.Deadline = workspace:GetServerTimeNow() + TURN_SECONDS
		send(duel)
		-- espera os dois escolherem (ou o tempo acabar)
		local started = os.clock()
		while running and not duel.Done and os.clock() - started < TURN_SECONDS do
			local aReady = duel.A.Choice ~= nil or duel.A.Player == nil
			local bReady = duel.B.Choice ~= nil or duel.B.Player == nil
			if aReady and bReady and os.clock() - started > 0.6 then
				break
			end
			task.wait(0.2)
		end
		if not running or duel.Done then
			return -- alguém saiu (Battle.Remove) ou a rodada acabou
		end
		resolve(duel)
		send(duel)
		task.wait(1.6)
	end
end

-- Começa: devolve quando todas as lutas acabarem (ou o tempo do minigame acabar)
function Battle.Run(participants: { Player }, timeLimit: number): ({ Player }, { Player })
	running = true
	table.clear(duels)
	table.clear(fighterOf)
	table.clear(duelOf)
	local list = table.clone(participants)
	for i = #list, 2, -1 do
		local j = random:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	local index = 1
	while index <= #list do
		local playerA = list[index]
		local playerB = list[index + 1]
		local a = makeFighter(playerA)
		local b = makeFighter(playerB) -- nil = Grumblob
		local duel: Duel = { A = a, B = b, Turn = 0, Deadline = 0, Log = "FIGHT!", Done = false, Winner = nil }
		table.insert(duels, duel)
		fighterOf[playerA] = a
		duelOf[playerA] = duel
		if playerB then
			fighterOf[playerB] = b
			duelOf[playerB] = duel
		end
		index += 2
	end
	for _, duel in duels do
		task.spawn(runDuel, duel)
	end
	local started = os.clock()
	while os.clock() - started < timeLimit do
		local allDone = true
		for _, duel in duels do
			if not duel.Done then
				allDone = false
			end
		end
		if allDone then
			break
		end
		task.wait(0.5)
	end
	running = false
	local winners, losers = {}, {}
	for _, duel in duels do
		if not duel.Done then
			-- acabou o tempo: quem tem mais vida (%) vence
			local ra, rb = duel.A.HP / duel.A.Max, duel.B.HP / duel.B.Max
			duel.Winner = if ra >= rb then duel.A else duel.B
			duel.Done = true
		end
		for _, fighter in { duel.A, duel.B } do
			local player = fighter.Player
			if player and player.Parent then
				-- ganhar do Grumblob não conta como vitória (senão dava para treinar sozinho e farmar)
				local vsBot = duel.A.Player == nil or duel.B.Player == nil
				table.insert(if duel.Winner == fighter and not vsBot then winners else losers, player)
			end
		end
		send(duel)
	end
	table.clear(fighterOf)
	table.clear(duelOf)
	return winners, losers
end

-- Escolha do jogador (só vale uma por turno)
function Battle.Move(player: Player, choice: any)
	local fighter = fighterOf[player]
	local duel = duelOf[player]
	if not fighter or not duel or duel.Done or fighter.Choice ~= nil then
		return
	end
	if choice ~= "Attack" and choice ~= "Defend" and choice ~= "Special" then
		return
	end
	if choice == "Special" and fighter.SpecialAt > duel.Turn then
		return
	end
	fighter.Choice = choice
	send(duel)
end

-- Saiu do jogo/minigame no meio: perde a luta
function Battle.Remove(player: Player)
	local fighter = fighterOf[player]
	local duel = duelOf[player]
	if fighter and duel and not duel.Done then
		fighter.HP = 0
		duel.Done = true
		duel.Winner = if duel.A == fighter then duel.B else duel.A
		send(duel)
	end
	fighterOf[player] = nil
	duelOf[player] = nil
end

function Battle.Stop()
	running = false
end

function Battle.Init()
	Players.PlayerRemoving:Connect(Battle.Remove)
end

return Battle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="440">
        <Properties>
          <string name="Name">Codes</string>
          <string name="Source"><![CDATA[--[[
	Codes (ModuleScript em ServerScriptService > Game)
	Códigos promocionais. Ficam SÓ no servidor: nenhum jogador consegue ler esta lista.
	Cada jogador usa cada código uma vez. Maiúsculas e espaços não importam ("hatch it" = HATCHIT).

	Tipos de recompensa (pode juntar vários no mesmo código):
	  Cash = 5000          -> dinheiro fixo
	  Minutes = 10         -> 10 minutos da SUA renda (mínimo $200 por minuto): vale para novato e para veterano
	  WorldEgg = 1         -> ovo(s) normal(is) do mundo mais novo que você destravou (Meadow: Spotted Egg)
	  BigEgg = 1           -> ovo(s) grande(s) desse mundo (Meadow: Crystal Egg)
	  Boost = 15           -> 2x Cash por 15 minutos (soma tempo, até 3 horas)
	  Egg = "crystal"      -> um ovo específico
	  Critter = "blobby"   -> um bichinho específico (use para as criaturas de youtuber); Mutation = "Gold" opcional
	  Starts = os.time()   -> só funciona depois dessa data (opcional)
	  Expires = os.time()  -> para de funcionar nessa data (opcional; o plano de divulgação usa códigos sem fim)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Critters = require(ReplicatedStorage.Shared.Critters)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local Codes = {}

Codes.List = {
	-- os primeiros
	RELEASE = { Cash = 5_000 },
	SNEAKY = { Egg = "spotted" },

	-- Plano de divulgação: 1 código em cada Short
	HATCHIT = { Minutes = 10 },
	STEALIT = { WorldEgg = 1 },
	KEEPIT = { Boost = 15 },
	SECRET = { Minutes = 15 },
	MYTHIC = { WorldEgg = 1 },
	LASER = { Boost = 10 },
	COSMIC = { BigEgg = 1 },
	EGGRAIN = { WorldEgg = 3 },
	RAINBOW = { Minutes = 20 },
	CANDY = { WorldEgg = 1 },
	FROSTY = { Boost = 15 },
	LAVA = { Minutes = 20 },
	REEF = { WorldEgg = 1 },
	GALAXY = { BigEgg = 1 },
	REVENGE = { Boost = 15 },
	REBIRTH = { Minutes = 30 },
	RACCOON = { WorldEgg = 1 },
	BONK = { Boost = 20 },
	THANKYOU1K = { BigEgg = 1, Minutes = 30 },
	SPOOKY = { WorldEgg = 3 },

	-- Criatura de youtuber (exemplo): troque o nome e o Id quando fizer a parceria
	-- CREATORNAME = { Critter = "blobby", Mutation = "Gold" },
}

local lastTry: { [Player]: number } = {}

local function getData(player: Player): any
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

-- Mundo mais novo que o jogador destravou
local function newestWorld(player: Player): string
	local newest = "meadow"
	for _, world in Config.Worlds do
		if Registry.Worlds.IsUnlocked(player, world.Id) then
			newest = world.Id
		end
	end
	return newest
end

local function giftEgg(player: Player, big: boolean): string?
	local pair = Config.GiftEggs[newestWorld(player)] or Config.GiftEggs.meadow
	local eggId = pair[if big then 2 else 1]
	return if Config.EggById[eggId] then eggId else nil
end

-- Normaliza o que o jogador digitou: "hatch it" -> "HATCHIT"
function Codes.Normalize(raw: string): string
	return string.upper((string.gsub(raw, "%s+", "")))
end

-- 2x Cash por alguns minutos (soma com o que já tinha, até o máximo)
function Codes.AddBoost(player: Player, minutes: number)
	local data = getData(player)
	if not data then
		return
	end
	local now = os.time()
	local current = math.max(tonumber(data.BoostUntil) or 0, now)
	data.BoostUntil = math.min(current + minutes * 60, now + Config.BoostMaxMinutes * 60)
	player:SetAttribute("BoostUntil", data.BoostUntil)
	Registry.Economy.Sync(player)
end

function Codes.IsBoosted(player: Player): boolean
	local data = getData(player)
	return data ~= nil and (tonumber(data.BoostUntil) or 0) > os.time()
end

-- Dá a recompensa e devolve o texto do que o jogador ganhou (usado também pelo passe da temporada)
function Codes.Grant(player: Player, reward): { string }
	local Economy = Registry.Economy
	local CritterService = Registry.CritterService
	local parts = {}
	if type(reward.Cash) == "number" and reward.Cash > 0 then
		Economy.AddCash(player, reward.Cash, false, "Code")
		table.insert(parts, Format.Money(reward.Cash))
	end
	if type(reward.Minutes) == "number" and reward.Minutes > 0 then
		local amount = math.floor(math.max(Economy.GetIncome(player) * 60 * reward.Minutes, reward.Minutes * 200))
		Economy.AddCash(player, amount, false, "Code")
		table.insert(parts, Format.Money(amount))
	end
	for _, kind in { "WorldEgg", "BigEgg" } do
		local count = reward[kind]
		if type(count) == "number" and count > 0 then
			local eggId = giftEgg(player, kind == "BigEgg")
			if eggId then
				for _ = 1, math.min(count, 5) do
					CritterService.GrantEgg(player, eggId)
				end
				table.insert(parts, ("%s%s"):format(if count > 1 then count .. "x " else "a FREE ", Config.EggById[eggId].Name))
			end
		end
	end
	if type(reward.Egg) == "string" and Config.EggById[reward.Egg] then
		CritterService.GrantEgg(player, reward.Egg)
		table.insert(parts, "a FREE " .. Config.EggById[reward.Egg].Name)
	end
	if type(reward.Critter) == "string" and Critters.ById[reward.Critter] then
		local mutation = if type(reward.Mutation) == "string" and Config.MutationByName[reward.Mutation] then reward.Mutation else nil
		CritterService.GrantCritter(player, reward.Critter, mutation)
		table.insert(parts, (if mutation then mutation .. " " else "") .. Critters.ById[reward.Critter].Name)
	end
	if type(reward.Boost) == "number" and reward.Boost > 0 then
		Codes.AddBoost(player, reward.Boost)
		table.insert(parts, ("2x Cash for %d min"):format(reward.Boost))
	end
	if type(reward.Cosmetic) == "string" then
		-- "trail:season_sweet", "title:...", "decor:..." -> fica para sempre na tela STYLE
		local data = getData(player)
		if data and type(data.Style) == "table" and type(data.Style.Owned) == "table" then
			data.Style.Owned[reward.Cosmetic] = true
			table.insert(parts, "a new " .. string.split(reward.Cosmetic, ":")[1] .. " (see STYLE)")
		end
	end
	return parts
end

function Codes.Redeem(player: Player, raw: any)
	local data = getData(player)
	local Remotes = Registry.Remotes
	if not data or typeof(raw) ~= "string" or #raw > 30 then
		return
	end
	local t = os.clock()
	if t - (lastTry[player] or 0) < 2 then
		Remotes.Notify(player, "Wait a moment before trying another code.", "warning")
		return
	end
	lastTry[player] = t
	local code = Codes.Normalize(raw)
	local reward = Codes.List[code]
	local now = os.time()
	if not reward or (reward.Expires and now > reward.Expires) or (reward.Starts and now < reward.Starts) then
		Remotes.Notify(player, "Invalid or expired code.", "error")
		return
	end
	if data.Codes[code] then
		Remotes.Notify(player, "You already used this code!", "warning")
		return
	end
	data.Codes[code] = true
	local parts = Codes.Grant(player, reward)
	Remotes.Notify(player, "Code " .. code .. " redeemed: " .. table.concat(parts, " + ") .. "!", "rare")
	Remotes.Effect(player, "Purchase", "Legendary")
	local analytics = Registry.Analytics
	if analytics then
		pcall(analytics.Event, player, "Code_" .. code)
	end
end

function Codes.RemovePlayer(player: Player)
	lastTry[player] = nil
end

return Codes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="441">
        <Properties>
          <string name="Name">Combat</string>
          <string name="Source"><![CDATA[-- Taco "Bonk Bat": empurra os outros jogadores e faz ladrões derrubarem o bichinho.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Registry = require(script.Parent.Registry)

local Combat = {}

local lastSwing: { [Player]: number } = {}

local REST_GRIP = CFrame.new(0, -1.4, 0)
local SWING_GRIP = CFrame.new(0, -1.4, 0) * CFrame.Angles(math.rad(80), 0, 0)

local function makeTool(): Tool
	local tool = Instance.new("Tool")
	tool.Name = "Bonk Bat"
	tool.ToolTip = "Click to BONK thieves!"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.Grip = REST_GRIP

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.45, 3, 0.45)
	handle.Color = Color3.fromRGB(150, 100, 60)
	handle.Material = Enum.Material.Wood
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local barrel = Instance.new("Part")
	barrel.Name = "Barrel"
	barrel.Shape = Enum.PartType.Cylinder
	barrel.Size = Vector3.new(2.2, 0.95, 0.95)
	barrel.Color = Color3.fromRGB(255, 120, 60)
	barrel.Material = Enum.Material.SmoothPlastic
	barrel.CanCollide = false
	barrel.Massless = true
	barrel.CFrame = handle.CFrame * CFrame.new(0, 1.9, 0) * CFrame.Angles(0, 0, math.rad(90))
	barrel.Parent = tool
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = barrel
	weld.Parent = barrel

	local sound = Instance.new("Sound")
	sound.Name = "Swing"
	sound.SoundId = Config.Sounds.Swing.Id
	sound.Volume = Config.Sounds.Swing.Volume
	sound.SoundGroup = game:GetService("SoundService"):FindFirstChild("SFX") :: SoundGroup?
	sound.Parent = handle

	return tool
end

local function inOwnBase(player: Player, position: Vector3): boolean
	local plot = Registry.Plots.Get(player)
	return plot ~= nil and Registry.Plots.IsInside(plot, position)
end

-- Monstros da invasão (LiveEvents) e Bandits (v24): mesmo alcance do taco
local function hitTagged(player: Player, root: BasePart, tag: string, handler: ((Model, Player) -> ())?): boolean
	if not handler then
		return false
	end
	for _, target in CollectionService:GetTagged(tag) do
		local targetRoot = target:IsA("Model") and target.PrimaryPart
		if targetRoot then
			local offset = targetRoot.Position - root.Position
			local flat = Vector3.new(offset.X, 0, offset.Z)
			local direction = if flat.Magnitude > 0.05 then flat.Unit else root.CFrame.LookVector
			if offset.Magnitude <= Config.SlapRange + 2.5 and (root.CFrame.LookVector:Dot(direction) > 0.1 or offset.Magnitude < 4) then
				handler(target :: Model, player)
				return true -- uma pancada acerta um alvo só
			end
		end
	end
	return false
end

local function hitMonsters(player: Player, root: BasePart)
	local liveEvents = Registry.LiveEvents
	if hitTagged(player, root, "Monster", liveEvents and liveEvents.HitMonster) then
		return
	end
	local banditService = Registry.Bandits
	hitTagged(player, root, "Bandit", banditService and banditService.Hit)
end

local function swing(player: Player, tool: Tool)
	local now = os.clock()
	if now - (lastSwing[player] or 0) < Config.SlapCooldown then
		return
	end
	lastSwing[player] = now

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end

	tool.Grip = SWING_GRIP
	task.delay(0.18, function()
		if tool.Parent then
			tool.Grip = REST_GRIP
		end
	end)
	local handle = tool:FindFirstChild("Handle")
	local sound = handle and handle:FindFirstChild("Swing") :: Sound?
	if sound then
		sound:Play()
	end

	for _, other in Players:GetPlayers() do
		if other ~= player then
			local otherCharacter = other.Character
			local otherRoot = otherCharacter and otherCharacter:FindFirstChild("HumanoidRootPart") :: BasePart?
			local otherHumanoid = otherCharacter and otherCharacter:FindFirstChildOfClass("Humanoid")
			if otherRoot and otherHumanoid and otherHumanoid.Health > 0 then
				local offset = otherRoot.Position - root.Position
				local distance = offset.Magnitude
				if distance <= Config.SlapRange then
					local flat = Vector3.new(offset.X, 0, offset.Z)
					local direction = if flat.Magnitude > 0.05 then flat.Unit else root.CFrame.LookVector
					local facing = root.CFrame.LookVector:Dot(direction)
					-- Quem está dentro da PRÓPRIA base fica protegido (anti-trollagem)
					local protected = inOwnBase(other, otherRoot.Position)
					local minigames = Registry.Minigames
					if minigames and not minigames.BonkAllowed(player, other) then
						protected = true -- minigame: só vale pancada que faz parte do jogo
					end
					if (facing > 0.1 or distance < 3.5) and not protected then
						Registry.Remotes.KnockbackEvent:FireClient(other, direction * Config.SlapForce + Vector3.new(0, 40, 0))
						Registry.Remotes.EffectAll("Bonk", otherRoot.Position + Vector3.new(0, 3, 0))
						Registry.CritterService.OnSlapped(other, player)
						if minigames then
							minigames.OnBonk(player, other)
						end
					end
				end
			end
		end
	end
	hitMonsters(player, root)
end

function Combat.GiveTool(player: Player, character: Model)
	if not character:IsDescendantOf(workspace) then
		character.AncestryChanged:Wait()
	end
	if player.Character ~= character then
		return
	end
	local backpack = player:WaitForChild("Backpack", 10)
	if not backpack or not character.Parent then
		return
	end
	if backpack:FindFirstChild("Bonk Bat") or character:FindFirstChild("Bonk Bat") then
		return
	end
	local tool = makeTool()
	tool.Activated:Connect(function()
		swing(player, tool)
	end)
	tool.Parent = backpack
end

function Combat.RemovePlayer(player: Player)
	lastSwing[player] = nil
end

function Combat.Init() end

return Combat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="442">
        <Properties>
          <string name="Name">CritterService</string>
          <string name="Source"><![CDATA[--[[
	CritterService (ModuleScript em ServerScriptService > Game)
	Tudo sobre OVOS e BICHINHOS:
	  • cada mundo tem a sua esteira de ovos (as esteiras dos mundos vazios ficam paradas, para economizar)
	  • comprar -> o ovo vai para a base (de outro mundo ele é teletransportado) -> choca com suspense -> vira bichinho
	  • o resultado do ovo é sorteado NA COMPRA e fica guardado (sair do jogo não troca o resultado)
	  • roubar (ovo chocando ou bichinho) carregando nas costas, vender, devolver
	  • Chuva de Ovos grátis, ovos/bichinhos ganhos por código ou comprados com Robux
	Tudo é decidido aqui no servidor; o jogador só aperta os botões.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Critters = require(ReplicatedStorage.Shared.Critters)
local Builder = require(ReplicatedStorage.Shared.CritterBuilder)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local CritterService = {}
CritterService.ShinyNext = false -- admin: o próximo sorteio sai shiny

local folder: Folder
-- Uma "lane" por mundo: { World, StartX, EndX, Y, Z, List = ovos na esteira, Filled, Active }
local lanes: { [string]: any } = {}
local fillLaneFn: ((any) -> ())? = nil
local rainList = {}
local incubating: { [any]: boolean } = {}
local carrying: { [Player]: any } = {}
local nextUid = 0


local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 190, 60)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 255, 90)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(90, 230, 120)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(80, 170, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 110, 255)),
})

local onBuy, onSteal, onSell, onCatch, onPickUp, onPet

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function track(name: string, ...)
	local analytics = Registry.Analytics
	if analytics and analytics[name] then
		pcall(analytics[name], ...)
	end
end

-- Avisa a mochila (tela "Critters") que a base desse jogador mudou
local function markDirty(player: Player?)
	local pets = Registry.Pets
	if pets and player then
		pets.MarkDirty(player)
	end
end

---------------------------------------------------------------------
-- Números de cada ovo / bichinho
---------------------------------------------------------------------
local function rarityIndex(def): number
	return Config.RarityIndex[def.Rarity] or 1
end

local function isEgg(rec): boolean
	return rec.Kind == "Egg"
end

-- Estágio de crescimento (bebê, adulto, gigante) pela idade do bichinho
local function stageOf(rec)
	return Config.GrowthStage(os.time() - (rec.Born or 0))
end

-- Carinho e comida: só bônus (nunca castigo)
local function careMultiplier(rec): number
	local now = os.clock()
	local multiplier = 1
	if (rec.HappyUntil or 0) > now then
		multiplier += Config.PetHappyBonus
	end
	if (rec.FedUntil or 0) > now then
		multiplier += Config.FeedBonus
	end
	return multiplier
end

local function recIncome(rec): number
	if isEgg(rec) then
		return 0
	end
	local _, stage = stageOf(rec)
	return rec.Def.Income * Config.IncomeMultiplier(rec.Mutation) * stage.Income * (if rec.Shiny then Config.ShinyIncome else 1) * careMultiplier(rec)
end

local function recPrice(rec): number
	if isEgg(rec) then
		return rec.EggDef.Price
	end
	return math.floor(rec.Def.Price * Config.PriceMultiplier(rec.Mutation) * (if rec.Shiny then Config.ShinyIncome else 1))
end

-- Valor médio de venda do que sai de um ovo (sem revelar o resultado)
local eggSellCache: { [string]: number } = {}
local function eggAverageSell(egg): number
	local cached = eggSellCache[egg.Id]
	if cached then
		return cached
	end
	local mutationPrice = 1
	for _, mutation in Config.Mutations do
		mutationPrice += mutation.Chance / 100 * (mutation.Price - 1)
	end
	local total, value = 0, 0
	for _, chance in egg.Odds do
		total += chance
	end
	for rarity, chance in egg.Odds do
		local pool = (Critters.ByWorld[egg.Pool or egg.World] or {})[rarity] or {}
		if #pool > 0 then
			local sum = 0
			for _, def in pool do
				sum += def.Price
			end
			value += chance / total * sum / #pool
		end
	end
	local result = math.floor(value * mutationPrice * Config.CritterSellRefund)
	eggSellCache[egg.Id] = result
	return result
end

local function sellPrice(rec): number
	if isEgg(rec) then
		-- quem comprou o ovo recebe metade do preço de volta; ovo roubado ou grátis vale o
		-- bichinho médio daquele ovo (senão dava para roubar ovo caro e vender)
		local average = eggAverageSell(rec.EggDef)
		if rec.Buyer ~= nil and rec.Buyer == rec.Owner then
			return math.max(math.floor(rec.EggDef.Price * Config.SellRefund), average)
		end
		return math.min(average, math.floor(rec.EggDef.Price * Config.SellRefund))
	end
	return math.floor(recPrice(rec) * Config.CritterSellRefund)
end

local function displayName(rec): string
	if isEgg(rec) then
		return rec.EggDef.Name
	end
	return (if rec.Shiny then "Shiny " else "") .. (if rec.Mutation then rec.Mutation .. " " else "") .. rec.Def.Name
end

local function isSpecial(rec): boolean
	if isEgg(rec) then
		return rec.EggDef.Announce == true
	end
	return rarityIndex(rec.Def) >= Config.AnnounceFromRarity or rec.Mutation == "Diamond" or rec.Mutation == "Rainbow" or rec.Shiny == true
end

-- Clima/noite do servidor (Environment); sem ele (testes) nada especial acontece
local function conditionActive(condition: string?): boolean
	if not condition then
		return true
	end
	local environment = Registry.Environment
	return environment ~= nil and environment.IsActive(condition)
end

local function closeEnough(player: Player, position: Vector3, range: number): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root ~= nil and (root.Position - position).Magnitude <= range
end

---------------------------------------------------------------------
-- Sorteios
---------------------------------------------------------------------
local function isLucky(): boolean
	local luckyUntil = workspace:GetAttribute("LuckyUntil")
	return typeof(luckyUntil) == "number" and luckyUntil > serverNow()
end

function CritterService.RollMutation(boost: number?): string?
	local roll = math.random() * 100
	local accumulated = 0
	for _, mutation in Config.Mutations do
		accumulated += mutation.Chance * (boost or 1)
		if roll < accumulated then
			return mutation.Name
		end
	end
	return nil
end

local function rollEggRarity(egg): string
	local total = 0
	for _, chance in egg.Odds do
		total += chance
	end
	local roll = math.random() * total
	local last = nil
	for _, rarity in Config.Rarities do
		local chance = egg.Odds[rarity.Name]
		if chance and chance > 0 then
			last = rarity.Name
			roll -= chance
			if roll <= 0 then
				return rarity.Name
			end
		end
	end
	return last or Config.Rarities[1].Name
end

-- O que vai sair do ovo (decidido na hora da compra; fica guardado até chocar)
function CritterService.RollResult(egg, player: Player?, boost: number?)
	local rarity = rollEggRarity(egg)
	local rebirths = if player then Registry.Economy.GetPeakRebirths(player) else 0
	local world = Critters.ByWorld[egg.Pool or egg.World or "meadow"] or {}
	local options = {}
	for _, def in world[rarity] or {} do
		if not def.RebirthRequired or def.RebirthRequired <= rebirths then
			table.insert(options, def)
		end
	end
	if egg.Pool == "weekly" then
		-- v26: o Weekly Egg choca SÓ o critter desta semana (a raridade é a dele)
		local weeklyDef = require(ReplicatedStorage.Shared.Weekly).Current()
		if weeklyDef then
			options = { weeklyDef }
		end
	end
	if #options == 0 then
		options = Critters.ByWorld.meadow[Config.Rarities[1].Name]
	end
	local def = options[math.random(1, #options)]
	local mutationBoost = (boost or 1) * (if isLucky() then Config.LuckyMutationMultiplier else 1)
	local progress = Registry.Progress
	if player and progress then
		mutationBoost *= progress.LuckMultiplier(player) -- habilidade Luck
	end
	local shiny = CritterService.ShinyNext or math.random() < Config.ShinyChance
	CritterService.ShinyNext = false
	return { Id = def.Id, Mutation = CritterService.RollMutation(mutationBoost), Shiny = if shiny then true else nil }
end

-- Bichinho de uma raridade do mundo mais alto que o jogador já liberou (Ovo Gigante)
function CritterService.RollFromOdds(player: Player, odds: { [string]: number })
	local total = 0
	for _, weight in odds do
		total += weight
	end
	local roll = math.random() * total
	local rarity = Config.Rarities[1].Name
	for _, info in Config.Rarities do
		local weight = odds[info.Name]
		if weight then
			roll -= weight
			rarity = info.Name
			if roll <= 0 then
				break
			end
		end
	end
	local worlds = Registry.Worlds
	local rebirths = Registry.Economy.GetPeakRebirths(player)
	local worldId = "meadow"
	for _, world in Config.Worlds do
		if worlds and worlds.IsUnlocked(player, world.Id) then
			worldId = world.Id
		end
	end
	-- se o mundo não tem essa raridade, desce uma raridade por vez
	local index = Config.RarityIndex[rarity] or 1
	for tier = index, 1, -1 do
		local options = {}
		for _, def in (Critters.ByWorld[worldId] or {})[Config.Rarities[tier].Name] or {} do
			if not def.RebirthRequired or def.RebirthRequired <= rebirths then
				table.insert(options, def)
			end
		end
		if #options > 0 then
			local shiny = CritterService.ShinyNext or math.random() < Config.ShinyChance
			CritterService.ShinyNext = false
			return options[math.random(1, #options)], shiny
		end
	end
	return CritterService.RandomDef(Config.Rarities[1].Name), false
end

-- Sorteia o próximo ovo da esteira de um mundo (Evento da Sorte: ovos raros 3x mais)
function CritterService.RandomEgg(worldId: string?)
	local world = worldId or "meadow"
	local eggs = Config.EggsOfWorld(world)
	local lucky = isLucky()
	local luckyTier = if world == "meadow" then 3 else 4
	local total = 0
	local weights = {}
	for index, egg in eggs do
		local weight = egg.Weight
		if lucky and egg.Tier >= luckyTier then
			weight *= Config.LuckyEggMultiplier
		end
		if egg.Condition and not conditionActive(egg.Condition) then
			weight = 0 -- ovo de chuva/neve/noite só aparece nesse clima
		end
		if egg.Holiday and workspace:GetAttribute("Holiday") ~= egg.Holiday then
			weight = 0 -- ovo de festa só na época da festa (LiveEvents)
		end
		weights[index] = weight
		total += weight
	end
	local roll = math.random() * total
	for index, egg in eggs do
		roll -= weights[index]
		if roll <= 0 then
			return egg
		end
	end
	return eggs[1] or Config.Eggs[1]
end

-- Bichinho aleatório do Meadow (admin/testes)
function CritterService.RandomDef(rarityName: string)
	local bucket = {}
	for _, def in Critters.ByWorld.meadow[rarityName] or {} do
		if not def.RebirthRequired then
			table.insert(bucket, def)
		end
	end
	if #bucket == 0 then
		bucket = Critters.ByWorld.meadow[Config.Rarities[1].Name]
	end
	return bucket[math.random(1, #bucket)]
end

local function validResult(result: any)
	if type(result) == "table" and type(result.Id) == "string" and Critters.ById[result.Id] then
		local mutation = if type(result.Mutation) == "string" and Config.MutationByName[result.Mutation] then result.Mutation else nil
		return { Id = result.Id, Mutation = mutation, Shiny = if result.Shiny == true then true else nil }
	end
	return nil
end

---------------------------------------------------------------------
-- Placa em cima (mutação, nome, raridade/chance, preço/renda/contagem)
---------------------------------------------------------------------
local function makeInfo(rec)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Adornee = rec.Root
	local hasMutation = not isEgg(rec) and (rec.Mutation ~= nil or rec.Shiny == true)
	gui.Size = UDim2.new(7, 0, if hasMutation then 3.4 else 2.7, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, rec.Top * (rec.Scale or 1) + 2.1, 0)
	rec.Info = gui
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	gui.Parent = rec.Root

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = gui

	local total = if hasMutation then 1.26 else 1
	local function line(name: string, order: number, height: number, color: Color3, text: string): TextLabel
		local label = Instance.new("TextLabel")
		label.Name = name
		label.LayoutOrder = order
		label.Size = UDim2.fromScale(1, height / total)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = color
		label.Text = text
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = Color3.fromRGB(15, 15, 25)
		stroke.Parent = label
		label.Parent = gui
		return label
	end

	if isEgg(rec) then
		local bestName, bestChance = Config.EggBest(rec.EggDef)
		rec.NameLabel = line("NameLine", 1, 0.36, Color3.fromRGB(255, 255, 255), rec.EggDef.Name)
		rec.RarityLabel = line("RarityLine", 2, 0.3, Config.RarityByName[bestName].Color, ("Best: %s %g%%"):format(string.upper(bestName), bestChance))
		if Config.RarityIndex[bestName] >= 6 then
			local gradient = Instance.new("UIGradient")
			gradient.Color = RAINBOW
			gradient.Parent = rec.RarityLabel
		end
	else
		local def = rec.Def
		local rarity = Config.RarityByName[def.Rarity]
		if hasMutation then
			local info = rec.Mutation and Config.MutationByName[rec.Mutation]
			local text = if info then string.upper(rec.Mutation) .. " x" .. info.Income else ""
			if rec.Shiny then
				text = "SHINY" .. (if text ~= "" then " " .. text else " x" .. Config.ShinyIncome)
			end
			local mutationLabel = line("MutationLine", 0, 0.26, if info then info.Color else Color3.fromRGB(255, 250, 200), text)
			if rec.Mutation == "Rainbow" or rec.Shiny then
				local gradient = Instance.new("UIGradient")
				gradient.Color = if rec.Shiny and rec.Mutation ~= "Rainbow"
					then ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 220, 90))
					else RAINBOW
				gradient.Parent = mutationLabel
			end
		end
		rec.NameLabel = line("NameLine", 1, 0.36, Color3.fromRGB(255, 255, 255), def.Name)
		rec.RarityLabel = line("RarityLine", 2, 0.3, rarity.Color, string.upper(def.Rarity))
		if rarityIndex(def) >= 6 then
			local gradient = Instance.new("UIGradient")
			gradient.Color = RAINBOW
			gradient.Parent = rec.RarityLabel
		end
	end
	rec.ValueLabel = line("ValueLine", 3, 0.34, Color3.fromRGB(255, 230, 90), "")
end

local function updateInfo(rec)
	local state = rec.State
	local label = rec.ValueLabel
	if not isEgg(rec) and rec.NameLabel then
		-- nome com o estágio: "Baby Zapkit", "Zapkit", "GIANT Zapkit"
		local _, stage = stageOf(rec)
		rec.NameLabel.Text = (if stage.Name == "Baby" then "Baby " elseif stage.Name == "Giant" then "GIANT " else "") .. rec.Def.Name
	end
	if state == "Conveyor" then
		label.Text = Format.Money(recPrice(rec))
		label.TextColor3 = Color3.fromRGB(255, 230, 90)
	elseif state == "Rain" then
		label.Text = "FREE! Catch it!"
		label.TextColor3 = Color3.fromRGB(120, 255, 255)
	elseif state == "Carried" then
		label.Text = "STOLEN!"
		label.TextColor3 = Color3.fromRGB(255, 90, 90)
	elseif state == "Walking" and isEgg(rec) then
		label.Text = "Going home..."
		label.TextColor3 = Color3.fromRGB(200, 220, 255)
	elseif state == "Incubating" then
		label.Text = "Hatching..." -- a tela de cada jogador mostra a contagem
		label.TextColor3 = Color3.fromRGB(200, 220, 255)
	elseif state == "Hatching" then
		label.Text = "HATCHING!"
		label.TextColor3 = Color3.fromRGB(255, 240, 120)
	else
		local care = ""
		local now = os.clock()
		if (rec.HappyUntil or 0) > now then
			care ..= " \u{2665}" -- carinho
		end
		if (rec.FedUntil or 0) > now then
			care ..= " +food"
		end
		label.Text = Format.Money(recIncome(rec)) .. "/s" .. care
		label.TextColor3 = Color3.fromRGB(120, 255, 120)
	end
end

---------------------------------------------------------------------
-- Prompts (botões "E" / toque no celular)
---------------------------------------------------------------------
local function clearPrompts(rec)
	for _, child in rec.Root:GetChildren() do
		if child:IsA("ProximityPrompt") then
			child:Destroy()
		end
	end
end

-- v20: cada botão do seu bichinho fica numa altura diferente na tela (antes os três apareciam
-- um em cima do outro e parecia bugado). O ladrão só vê o "Steal", então ele fica no meio.
local PROMPT_OFFSET: { [string]: number } = { PickUpPrompt = -76, PetPrompt = 0, SellPrompt = 76 }

local function addPrompt(rec, name: string, action: string, objectText: string, hold: number, key: Enum.KeyCode, gamepadKey: Enum.KeyCode, callback)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = action
	prompt.ObjectText = objectText
	prompt.HoldDuration = hold
	prompt.KeyboardKeyCode = key
	prompt.GamepadKeyCode = gamepadKey
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = 11
	prompt.UIOffset = Vector2.new(0, PROMPT_OFFSET[name] or 0)
	-- o servidor confere o tempo segurando (contra hack que pula o "segurar")
	local holdStart: { [Player]: number } = {}
	prompt.PromptButtonHoldBegan:Connect(function(player)
		holdStart[player] = os.clock()
	end)
	prompt.Triggered:Connect(function(player)
		if hold > 0 then
			local held = os.clock() - (holdStart[player] or -math.huge)
			if held < hold * 0.8 or held > hold + 15 then
				return
			end
		end
		holdStart[player] = nil
		callback(rec, player)
	end)
	prompt.Parent = rec.Root
	return prompt
end

---------------------------------------------------------------------
-- Brilho no chão e coluna de luz nos ovos raros (some quando alguém compra)
---------------------------------------------------------------------
local function addBeacons(rec)
	local color: Color3
	local size: number
	local pillar = isSpecial(rec)
	if isEgg(rec) then
		if rec.EggDef.Tier < 3 then
			return
		end
		color = rec.EggDef.Accent
		size = rec.EggDef.Size * 1.3
	else
		if not pillar and rarityIndex(rec.Def) < 4 then
			return
		end
		color = if rec.Mutation then Config.MutationByName[rec.Mutation].Color else Config.RarityByName[rec.Def.Rarity].Color
		size = (rec.Def.Size or Config.RarityByName[rec.Def.Rarity].Size) * 1.4
	end
	local function part(partSize: Vector3, offset: CFrame, transparency: number)
		local p = Instance.new("Part")
		p.Name = "Beacon"
		p.Shape = Enum.PartType.Cylinder
		p.Size = partSize
		p.Material = Enum.Material.Neon
		p.Color = color
		p.Transparency = transparency
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		p.CastShadow = false
		p.Anchored = false
		p.CFrame = rec.Root.CFrame * offset * CFrame.Angles(0, 0, math.rad(90))
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = rec.Root
		weld.Part1 = p
		weld.Parent = p
		p.Parent = rec.Model
	end
	part(Vector3.new(0.2, size, size), CFrame.new(0, -rec.Ground + 0.15, 0), 0.35)
	if pillar then
		part(Vector3.new(60, 1.4, 1.4), CFrame.new(0, 30 - rec.Ground, 0), 0.55)
	end
end

local function removeBeacons(rec)
	for _, child in rec.Model:GetChildren() do
		if child.Name == "Beacon" then
			child:Destroy()
		end
	end
end

---------------------------------------------------------------------
-- Criar / destruir / colocar no pedestal
---------------------------------------------------------------------
local function baseRecord(model: Model, root: BasePart, ground: number, top: number)
	nextUid += 1
	model:SetAttribute("Uid", nextUid)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	return {
		Uid = nextUid,
		Kind = "Critter",
		Def = nil :: any,
		EggDef = nil :: any,
		Result = nil :: any,
		Mutation = nil :: string?,
		Model = model,
		Root = root,
		Ground = ground,
		Top = top,
		BodyRadius = 1,
		State = "New",
		Owner = nil :: Player?,
		Plot = nil :: any,
		Slot = nil :: number?,
		Thief = nil :: Player?,
		CarryWeld = nil :: WeldConstraint?,
		DiedConn = nil :: RBXScriptConnection?,
		CarryStart = 0,
		CarryFrom = nil :: Vector3?,
		Scaled = false,
		StolenLock = 0, -- os.clock() até quando não pode ir para mochila/fusão (acabou de ser roubado)
		Born = os.time(), -- quando nasceu (o crescimento conta até offline)
		Shiny = false,
		Scale = 1, -- tamanho atual (estágio de crescimento)
		Stage = 0,
		HappyUntil = 0, -- carinho (os.clock)
		FedUntil = 0, -- comida (os.clock)
		Info = nil :: BillboardGui?,
		Waiting = false, -- ovo de clima esperando a chuva/neve/noite
		LastSync = 0,
		HatchLeft = 0,
		HatchAt = 0,
		X = 0,
		Lane = nil :: any,
		Buyer = nil :: Player?,
		Phase = math.random() * 10,
		Expire = 0,
		Dead = false,
	}
end

-- Shiny: brilho dourado e branco exclusivo
local function addShinyEffect(root: BasePart)
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Name = "ShinySparkles"
	sparkles.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 225, 90))
	sparkles.LightEmission = 1
	sparkles.Rate = 14
	sparkles.Lifetime = NumberRange.new(0.8, 1.4)
	sparkles.Speed = NumberRange.new(2, 4)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Parent = root
end

-- Coraçõezinhos enquanto está feliz (carinho)
local function setHearts(rec, on: boolean)
	local hearts = rec.Root:FindFirstChild("Hearts") :: ParticleEmitter?
	if on and not hearts then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "Hearts"
		emitter.Color = ColorSequence.new(Color3.fromRGB(255, 110, 170))
		emitter.LightEmission = 0.6
		emitter.Rate = 2
		emitter.Lifetime = NumberRange.new(1.2, 1.8)
		emitter.Speed = NumberRange.new(1.5, 2.5)
		emitter.SpreadAngle = Vector2.new(25, 25)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0.2) })
		emitter.Parent = rec.Root
	elseif not on and hearts then
		hearts:Destroy()
	end
end

local function createRecord(def, mutation: string?, born: number?, shiny: boolean?)
	local model, root, ground, top = Builder.Build(def)
	if mutation then
		Builder.ApplyMutation(model, mutation)
	end
	model:SetAttribute("Kind", "Critter")
	model:SetAttribute("CritterId", def.Id)
	model:AddTag("BaseCritter") -- v27: o cliente anima (dormir à noite, festa, susto)
	model:SetAttribute("Rarity", def.Rarity)
	model:SetAttribute("Mutation", mutation)
	local rec = baseRecord(model, root, ground, top)
	rec.Kind = "Critter"
	rec.Def = def
	rec.Mutation = mutation
	rec.Born = if typeof(born) == "number" then born else os.time()
	rec.Shiny = shiny == true
	model:SetAttribute("Born", rec.Born)
	model:SetAttribute("Shiny", rec.Shiny)
	if rec.Shiny then
		addShinyEffect(root)
	end
	local rarity = Config.RarityByName[def.Rarity] or Config.Rarities[1]
	rec.BodyRadius = (def.Size or rarity.Size) * 0.5
	-- tamanho do estágio (bebê menor, gigante maior)
	local index, stage = stageOf(rec)
	rec.Stage = index
	rec.Scale = Config.StageScale(stage, def.Size or rarity.Size)
	model:SetAttribute("Stage", stage.Name)
	if rec.Scale ~= 1 then
		pcall(function()
			model:ScaleTo(rec.Scale)
		end)
	end
	makeInfo(rec)
	return rec
end

local function createEggRecord(egg, result)
	local model, root, ground, top = Builder.BuildEgg(egg)
	model:SetAttribute("Kind", "Egg")
	model:SetAttribute("EggId", egg.Id)
	model:SetAttribute("Rarity", Config.EggBest(egg))
	local rec = baseRecord(model, root, ground, top)
	rec.Kind = "Egg"
	rec.EggDef = egg
	rec.Result = result
	rec.HatchLeft = egg.HatchTime
	rec.BodyRadius = egg.Size * 0.4
	makeInfo(rec)
	return rec
end

local function setState(rec, state: string)
	if rec.State == "Incubating" and state ~= "Incubating" then
		rec.HatchLeft = math.max(0, rec.HatchAt - serverNow())
		incubating[rec] = nil
	end
	rec.State = state
	rec.Model:SetAttribute("State", state)
end

local function destroyRecord(rec)
	if rec.Dead then
		return
	end
	incubating[rec] = nil
	rec.Dead = true
	rec.State = "Dead"
	markDirty(rec.Owner)
	local thief = rec.Thief
	if thief then
		if carrying[thief] == rec then
			carrying[thief] = nil
		end
		if thief.Parent then
			thief:SetAttribute("Carrying", nil)
			Registry.Economy.ApplySpeed(thief)
		end
		rec.Thief = nil
	end
	if rec.DiedConn then
		rec.DiedConn:Disconnect()
		rec.DiedConn = nil
	end
	rec.Model:Destroy()
end

local function restoreScale(rec)
	if rec.Scaled then
		pcall(function()
			rec.Model:ScaleTo(rec.Scale or 1)
		end)
		rec.Scaled = false
	end
end

local function placeRecord(rec)
	rec.Root.Anchored = true
	restoreScale(rec)
	removeBeacons(rec)
	local home = Registry.Plots.SlotCFrame(rec.Plot, rec.Slot, rec.Ground * (rec.Scale or 1))
	rec.Root.CFrame = home
	rec.Model:SetAttribute("Home", home)
	clearPrompts(rec)
	if isEgg(rec) then
		rec.HatchAt = serverNow() + rec.HatchLeft
		rec.Model:SetAttribute("HatchAt", rec.HatchAt)
		setState(rec, "Incubating")
		incubating[rec] = true
		addPrompt(rec, "StealPrompt", "Steal Egg", displayName(rec), Config.StealHoldDuration, Enum.KeyCode.E, Enum.KeyCode.ButtonX, onSteal)
	else
		setState(rec, "Placed")
		addPrompt(rec, "StealPrompt", "Steal", displayName(rec), Config.StealHoldDuration, Enum.KeyCode.E, Enum.KeyCode.ButtonX, onSteal)
		addPrompt(rec, "PickUpPrompt", "Pick Up", displayName(rec), 0.4, Enum.KeyCode.R, Enum.KeyCode.ButtonB, onPickUp)
		addPrompt(rec, "PetPrompt", "Pet", displayName(rec), 0.3, Enum.KeyCode.T, Enum.KeyCode.ButtonL1, onPet)
	end
	addPrompt(rec, "SellPrompt", "Sell " .. Format.Money(sellPrice(rec)), displayName(rec), 1, Enum.KeyCode.F, Enum.KeyCode.ButtonY, onSell)
	updateInfo(rec)
end

-- Coloca direto num pedestal (salvo, ganho, pendente)
local function spawnPlaced(player: Player, plot, slot: number, rec)
	rec.Owner = player
	rec.Plot = plot
	rec.Slot = slot
	plot.Slots[slot] = rec
	rec.Model:SetAttribute("OwnerUserId", player.UserId)
	rec.Model:PivotTo(Registry.Plots.SlotCFrame(plot, slot, rec.Ground * (rec.Scale or 1)))
	rec.Model.Parent = folder
	placeRecord(rec)
	markDirty(player)
	return rec
end

-- Cresceu? Troca o tamanho, o nome e a renda (chamado de tempos em tempos)
local function applyStage(rec)
	if isEgg(rec) or rec.Dead then
		return
	end
	local index, stage = stageOf(rec)
	if index == rec.Stage then
		return
	end
	rec.Stage = index
	local rarity = Config.RarityByName[rec.Def.Rarity] or Config.Rarities[1]
	rec.Scale = Config.StageScale(stage, rec.Def.Size or rarity.Size)
	rec.Model:SetAttribute("Stage", stage.Name)
	if not rec.Scaled then -- sendo carregado: o tamanho volta certo quando for colocado
		pcall(function()
			rec.Model:ScaleTo(rec.Scale)
		end)
	end
	if rec.Info then
		rec.Info.StudsOffsetWorldSpace = Vector3.new(0, rec.Top * rec.Scale + 2.1, 0)
	end
	if rec.State == "Placed" and rec.Plot and rec.Slot then
		local home = Registry.Plots.SlotCFrame(rec.Plot, rec.Slot, rec.Ground * rec.Scale)
		rec.Root.CFrame = home
		rec.Model:SetAttribute("Home", home)
	end
	updateInfo(rec)
	if stage.Name == "Giant" and rec.Owner and rec.Owner.Parent then
		Registry.Remotes.Notify(rec.Owner, ("%s grew into a GIANT! It earns full money now."):format(rec.Def.Name), "success")
	end
end

---------------------------------------------------------------------
-- Esteira (ovos)
---------------------------------------------------------------------
function CritterService.SpawnEggOnConveyor(egg, startX: number?, silent: boolean?)
	local lane = lanes[egg.World] or lanes.meadow
	if not lane then
		return nil
	end
	local rec = createEggRecord(egg, nil)
	setState(rec, "Conveyor")
	rec.Lane = lane
	rec.X = startX or lane.StartX
	local position = Vector3.new(rec.X, lane.Y + rec.Ground, lane.Z)
	rec.Model:PivotTo(CFrame.lookAt(position, position + Vector3.xAxis))
	addBeacons(rec)
	updateInfo(rec)
	addPrompt(rec, "BuyPrompt", "Buy " .. Format.Money(egg.Price), egg.Name, 0, Enum.KeyCode.E, Enum.KeyCode.ButtonX, onBuy)
	rec.Model.Parent = folder
	table.insert(lane.List, rec)

	if not silent and isSpecial(rec) then
		Registry.Remotes.NotifyAll(("A %s is on the conveyor! GO GO GO!"):format(string.upper(egg.Name)), "rare")
		Registry.Remotes.EffectAll("RareSpawn", "Legendary")
	end
	return rec
end

---------------------------------------------------------------------
-- Ir até a base
---------------------------------------------------------------------
local function tweenTo(rec, target: Vector3): boolean
	local from = rec.Root.Position
	local distance = (target - from).Magnitude
	if distance < 0.05 then
		return not rec.Dead and rec.State == "Walking"
	end
	local flat = Vector3.new(target.X - from.X, 0, target.Z - from.Z)
	local goal: CFrame
	if flat.Magnitude > 0.05 then
		rec.Root.CFrame = CFrame.lookAt(from, from + flat.Unit)
		goal = CFrame.lookAt(target, target + flat.Unit)
	else
		goal = rec.Root.CFrame.Rotation + target
	end
	local duration = distance / Config.CritterWalkSpeed
	TweenService:Create(rec.Root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = goal }):Play()
	task.wait(duration)
	return not rec.Dead and rec.State == "Walking"
end

local function walkToBase(rec)
	local plot = rec.Plot
	local outside, inside = Registry.Plots.PathPoints(plot)
	local lift = Vector3.new(0, rec.Ground, 0)
	local lane = rec.Lane
	if lane and lane.World ~= "meadow" then
		-- comprado em outro mundo: some num brilho e aparece na frente da sua base
		task.wait(0.4)
		if rec.Dead or rec.State ~= "Walking" then
			return
		end
		rec.Root.CFrame = CFrame.lookAt(outside + lift, inside + lift)
	elseif not tweenTo(rec, outside + lift) then
		return
	end
	if not tweenTo(rec, inside + lift) then
		return
	end
	-- vaga no 2º andar: sobe pela rampa
	for _, point in Registry.Plots.SlotRoute(plot, rec.Slot) do
		if not tweenTo(rec, point + lift) then
			return
		end
	end
	local final = Registry.Plots.SlotCFrame(plot, rec.Slot, rec.Ground)
	if not tweenTo(rec, final.Position) then
		return
	end
	placeRecord(rec)
	if Registry.Tutorial and rec.Owner then
		Registry.Tutorial.Event(rec.Owner, "Placed")
	end
end

local function startWalking(rec, player: Player, plot, slot: number)
	setState(rec, "Walking")
	rec.Owner = player
	rec.Plot = plot
	rec.Slot = slot
	plot.Slots[slot] = rec
	rec.Model:SetAttribute("OwnerUserId", player.UserId)
	clearPrompts(rec)
	removeBeacons(rec)
	updateInfo(rec)
	if not isEgg(rec) then
		Registry.Economy.Discover(player, rec.Def.Id)
	end
	task.spawn(walkToBase, rec)
end

---------------------------------------------------------------------
-- Comprar ovo (esteira)
---------------------------------------------------------------------
onBuy = function(rec, player: Player)
	if rec.State ~= "Conveyor" or rec.Dead then
		return
	end
	local Plots = Registry.Plots
	local Economy = Registry.Economy
	local Remotes = Registry.Remotes
	local plot = Plots.Get(player)
	if not plot or not player:GetAttribute("Loaded") or not closeEnough(player, rec.Root.Position, 18) then
		return
	end
	-- só compra no mundo que já destravou (contra hack de teleporte)
	local world = rec.Lane and rec.Lane.World
	if world and world ~= "meadow" and not Registry.Worlds.IsUnlocked(player, world) then
		return
	end
	local slot = Plots.FreeSlot(plot, Economy.GetSlotCount(player))
	if not slot then
		Remotes.Notify(player, "Your base is full! Sell something or buy more slots in the SHOP.", "error")
		return
	end
	local price = recPrice(rec)
	if not Economy.TrySpend(player, price) then
		Remotes.Notify(player, "Not enough cash! You need " .. Format.Money(price), "error")
		return
	end

	local lane = rec.Lane
	local index = if lane then table.find(lane.List, rec) else nil
	if lane and index then
		table.remove(lane.List, index)
	end
	rec.Result = if isEgg(rec) then CritterService.RollResult(rec.EggDef, player, 1) else rec.Result
	rec.Buyer = player
	local progress = Registry.Progress
	if isEgg(rec) and progress then
		rec.HatchLeft *= progress.HatchMultiplier(player) -- classe Creator: choca mais rápido
	end
	startWalking(rec, player, plot, slot)
	if isEgg(rec) and progress then
		progress.Event(player, "Buy") -- depois de ocupar a vaga (o prêmio da missão pode ser um ovo)
	end

	Remotes.Notify(player, "You bought a " .. displayName(rec) .. "! It's going to your base.", "success")
	Remotes.Effect(player, "Purchase", "Common")
	if isSpecial(rec) then
		Remotes.NotifyAll(("%s bought a %s!"):format(player.DisplayName, string.upper(displayName(rec))), "rare")
	end
	track("EggBought", player, rec.EggDef, price)
	if Registry.Tutorial then
		Registry.Tutorial.Event(player, "Bought")
	end
end

---------------------------------------------------------------------
-- Chocar (com suspense na tela do dono)
---------------------------------------------------------------------
local function hatchEgg(rec)
	if rec.Dead or rec.State ~= "Incubating" then
		return
	end
	local owner: Player = rec.Owner
	local plot = rec.Plot
	local slot = rec.Slot
	setState(rec, "Hatching")
	clearPrompts(rec)
	updateInfo(rec)

	local result = validResult(rec.Result) or CritterService.RollResult(rec.EggDef, owner, 1)
	rec.Result = result
	local def = Critters.ById[result.Id]
	local Economy = Registry.Economy
	Registry.Remotes.Effect(owner, "Hatch", {
		Critter = def.Id,
		Mutation = result.Mutation,
		Egg = rec.EggDef.Id,
		New = not Economy.HasDiscovered(owner, def.Id),
		Shiny = result.Shiny == true,
	})

	task.wait(Config.HatchRevealTime)
	if rec.Dead or (rec.State :: string) ~= "Hatching" or plot.Slots[slot] ~= rec or plot.Owner ~= owner then
		return
	end
	-- troca o ovo pelo bichinho no mesmo pedestal
	rec.Dead = true
	rec.State = "Dead"
	rec.Model:Destroy()
	local critter = spawnPlaced(owner, plot, slot, createRecord(def, result.Mutation, os.time(), result.Shiny))

	Economy.Discover(owner, def.Id)
	Economy.AddHatch(owner)
	Economy.SeasonXP(owner, "Hatch")
	Registry.Remotes.EffectAll("HatchBurst", { Position = critter.Root.Position, Rarity = def.Rarity })
	if isSpecial(critter) then
		local tag = if result.Shiny then "SHINY " .. string.upper(result.Mutation or def.Rarity) else string.upper(result.Mutation or def.Rarity)
		Registry.Remotes.NotifyAll(("%s hatched a %s %s!"):format(owner.DisplayName, tag, def.Name), "rare")
		Registry.Remotes.EffectAll("RareSpawn", if result.Shiny then "Secret" else def.Rarity)
	end
	if result.Shiny and Registry.Progress then
		Registry.Progress.Event(owner, "Shiny")
	end
	-- "Descoberto por": o primeiro do MUNDO a chocar cada Secret fica no álbum para sempre
	local discoveries = Registry.Discoveries
	if def.Rarity == "Secret" and discoveries then
		task.spawn(discoveries.Claim, owner, def.Id)
	end
	track("Hatched", owner, def, result.Mutation, rec.EggDef)
	if Registry.Tutorial then
		Registry.Tutorial.Event(owner, "Hatched")
	end
end

---------------------------------------------------------------------
-- Chuva de Ovos (grátis!)
---------------------------------------------------------------------
function CritterService.SpawnRainEgg(egg, position: Vector3)
	local rec = createEggRecord(egg, nil)
	setState(rec, "Rain")
	local landing = CFrame.new(position + Vector3.new(0, rec.Ground, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0)
	rec.Model:PivotTo(landing + Vector3.new(0, 70, 0))
	rec.Expire = os.clock() + Config.RainLifetime
	updateInfo(rec)
	addPrompt(rec, "CatchPrompt", "Catch (FREE)", displayName(rec), 0.3, Enum.KeyCode.E, Enum.KeyCode.ButtonX, onCatch)
	rec.Model.Parent = folder
	TweenService:Create(rec.Root, TweenInfo.new(2.2, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out), { CFrame = landing }):Play()
	table.insert(rainList, rec)
	return rec
end

onCatch = function(rec, player: Player)
	if rec.State ~= "Rain" or rec.Dead then
		return
	end
	local Plots = Registry.Plots
	local Economy = Registry.Economy
	local plot = Plots.Get(player)
	if not plot or not player:GetAttribute("Loaded") or not closeEnough(player, rec.Root.Position, 18) then
		return
	end
	local slot = Plots.FreeSlot(plot, Economy.GetSlotCount(player))
	if not slot then
		Registry.Remotes.Notify(player, "Your base is full! Make space to catch eggs.", "error")
		return
	end
	local index = table.find(rainList, rec)
	if index then
		table.remove(rainList, index)
	end
	-- ovos da chuva têm o dobro de chance de mutação
	rec.Result = CritterService.RollResult(rec.EggDef, player, 2)
	local progress = Registry.Progress
	if progress then
		rec.HatchLeft *= progress.HatchMultiplier(player)
	end
	startWalking(rec, player, plot, slot)
	if progress then
		progress.Event(player, "Rain")
	end
	Registry.Remotes.Notify(player, "You caught a FREE " .. displayName(rec) .. "!", "success")
	Registry.Remotes.Effect(player, "Purchase", "Common")
	if Registry.Tutorial then
		Registry.Tutorial.Event(player, "Bought")
	end
end

---------------------------------------------------------------------
-- Vender
---------------------------------------------------------------------
onSell = function(rec, player: Player)
	if (rec.State ~= "Placed" and rec.State ~= "Incubating") or rec.Owner ~= player or rec.Dead then
		return
	end
	if not closeEnough(player, rec.Root.Position, 18) then
		return
	end
	local plot = rec.Plot
	if plot.Slots[rec.Slot] == rec then
		plot.Slots[rec.Slot] = nil
	end
	local amount = sellPrice(rec)
	Registry.Economy.AddCash(player, amount, false, "Sell")
	Registry.Remotes.Notify(player, ("Sold %s for %s"):format(displayName(rec), Format.Money(amount)), "info")
	destroyRecord(rec)
	CritterService.PlacePending(player)
end

-- Guardar na mochila (botão "Pick Up" em cima do seu bichinho)
onPickUp = function(rec, player: Player)
	if rec.State ~= "Placed" or rec.Owner ~= player or rec.Dead or isEgg(rec) then
		return
	end
	if not closeEnough(player, rec.Root.Position, 18) then
		return
	end
	Registry.Pets.Store(player, rec.Uid)
end

-- Carinho: +10% por 10 minutos (e coraçõezinhos). Nunca tem castigo se o jogador sumir.
onPet = function(rec, player: Player)
	if rec.State ~= "Placed" or rec.Owner ~= player or rec.Dead or isEgg(rec) then
		return
	end
	if not closeEnough(player, rec.Root.Position, 18) then
		return
	end
	local now = os.clock()
	if rec.HappyUntil > now then
		Registry.Remotes.Notify(player, rec.Def.Name .. " is already happy!", "info")
		return
	end
	rec.HappyUntil = now + Config.CareSeconds
	setHearts(rec, true)
	updateInfo(rec)
	Registry.Remotes.Effect(player, "Pet", rec.Root.Position)
	if Registry.Progress then
		Registry.Progress.Event(player, "Pet")
	end
	Registry.Remotes.Notify(player, ("%s loves you! +%d%% cash for 10 min"):format(rec.Def.Name, math.floor(Config.PetHappyBonus * 100)), "success")
end

-- Comida para todos os bichinhos da base: +15% por 10 minutos (custa 1 minuto da sua renda)
function CritterService.FeedAll(player: Player, shownCost: any)
	local plot = Registry.Plots.Get(player)
	if not plot then
		return
	end
	local now = os.clock()
	local hungry = {}
	for _, rec in plot.Slots do
		if not isEgg(rec) and rec.Owner == player and rec.State == "Placed" and not rec.Dead and rec.FedUntil < now + 60 then
			table.insert(hungry, rec)
		end
	end
	if #hungry == 0 then
		Registry.Remotes.Notify(player, "Your critters are already full!", "info")
		return
	end
	local cost = CritterService.FeedCost(player)
	-- preço claro: se a renda subiu depois da tela mostrar o preço, avisa e não cobra
	if type(shownCost) == "number" and cost > shownCost * 1.05 + 1 then
		Registry.Remotes.Notify(player, "Food price is now " .. Format.Money(cost) .. ". Tap FEED again!", "info")
		if Registry.Pets then
			Registry.Pets.Sync(player)
		end
		return
	end
	if not Registry.Economy.TrySpend(player, cost, "Food") then
		Registry.Remotes.Notify(player, "Not enough cash! Food costs " .. Format.Money(cost), "error")
		return
	end
	for _, rec in hungry do
		rec.FedUntil = now + Config.CareSeconds
		updateInfo(rec)
	end
	Registry.Remotes.Effect(player, "Purchase", "Rare")
	Registry.Remotes.Notify(player, ("Yum! %d critters get +%d%% cash for 10 min"):format(#hungry, math.floor(Config.FeedBonus * 100)), "success")
	if Registry.Progress then
		Registry.Progress.Event(player, "Feed")
	end
end

-- Preço da comida agora (para a tela)
function CritterService.FeedCost(player: Player): number
	return math.floor(math.max(100, Registry.Economy.GetIncome(player) * 60 * Config.FeedCostMinutes))
end

---------------------------------------------------------------------
-- Roubar (carregar nas costas)
---------------------------------------------------------------------
local function returnToOwner(rec, reason: string?)
	local thief = rec.Thief
	if thief then
		if carrying[thief] == rec then
			carrying[thief] = nil
		end
		if thief.Parent then
			thief:SetAttribute("Carrying", nil)
			Registry.Economy.ApplySpeed(thief)
		end
	end
	rec.Thief = nil
	if rec.CarryWeld then
		rec.CarryWeld:Destroy()
		rec.CarryWeld = nil
	end
	if rec.DiedConn then
		rec.DiedConn:Disconnect()
		rec.DiedConn = nil
	end
	if rec.Dead then
		return
	end
	local plot = rec.Plot
	local owner = rec.Owner
	markDirty(owner)
	if owner and plot and plot.Owner == owner and plot.Slots[rec.Slot] == rec then
		placeRecord(rec)
		if reason and owner.Parent then
			Registry.Remotes.Notify(owner, displayName(rec) .. " is back home!", "success")
			-- só conta defesa se o ladrão estava mesmo fugindo (não vale combinar com um amigo)
			if reason == "slapped" and rec.Root then
				Registry.Remotes.Effect(owner, "Saved", rec.Root.Position) -- v27: explosão SAVED!
			end
			if reason == "slapped" and os.clock() - (rec.CarryStart or 0) >= 2 then
				Registry.Economy.AddDefense(owner, thief)
			end
		end
	else
		destroyRecord(rec)
	end
end

local function completeSteal(rec)
	local thief: Player = rec.Thief
	local victim: Player? = rec.Owner
	local Plots = Registry.Plots
	local Economy = Registry.Economy
	local Remotes = Registry.Remotes
	if victim and (victim.Parent == nil or victim:GetAttribute("Leaving")) then
		returnToOwner(rec)
		return
	end
	local newPlot = Plots.Get(thief)
	local slot = newPlot and Plots.FreeSlot(newPlot, Economy.GetSlotCount(thief))
	if not newPlot or not slot then
		Remotes.Notify(thief, "Your base is full! It ran back home.", "error")
		returnToOwner(rec, "full")
		return
	end

	carrying[thief] = nil
	thief:SetAttribute("Carrying", nil)
	if rec.CarryWeld then
		rec.CarryWeld:Destroy()
		rec.CarryWeld = nil
	end
	if rec.DiedConn then
		rec.DiedConn:Disconnect()
		rec.DiedConn = nil
	end
	local oldPlot = rec.Plot
	if oldPlot and oldPlot.Slots[rec.Slot] == rec then
		oldPlot.Slots[rec.Slot] = nil
	end

	rec.Thief = nil
	rec.Owner = thief
	rec.Plot = newPlot
	rec.Slot = slot
	newPlot.Slots[slot] = rec
	rec.Model:SetAttribute("OwnerUserId", thief.UserId)
	rec.StolenLock = os.clock() + Config.StolenLockSeconds
	placeRecord(rec)
	markDirty(thief)
	markDirty(victim)

	Economy.ApplySpeed(thief)
	if not isEgg(rec) then
		Economy.Discover(thief, rec.Def.Id)
	end
	Economy.AddSteal(thief)
	Economy.SeasonXP(thief, "Steal", victim)
	Remotes.Notify(thief, "You stole " .. displayName(rec) .. "! It's yours now!", "success")
	Remotes.Effect(thief, "Stolen", if isEgg(rec) then "Rare" else rec.Def.Rarity)
	if victim and victim.Parent then
		Remotes.Notify(victim, thief.DisplayName .. " stole your " .. displayName(rec) .. "! Get revenge!", "error")
		CritterService.PlacePending(victim)
		Registry.Fairness.OnStolen(victim, thief)
	end
	if isSpecial(rec) then
		Remotes.NotifyAll(("%s stole the %s!"):format(thief.DisplayName, string.upper(displayName(rec))), "rare")
	end
	track("Stole", thief, rec)
end

onSteal = function(rec, thief: Player)
	if (rec.State ~= "Placed" and rec.State ~= "Incubating") or rec.Dead then
		return
	end
	local owner = rec.Owner
	if owner == thief or not owner or owner.Parent == nil or owner:GetAttribute("Leaving") then
		return
	end
	if not thief:GetAttribute("Loaded") then
		return
	end
	local Plots = Registry.Plots
	local Economy = Registry.Economy
	local Remotes = Registry.Remotes
	if Plots.IsLocked(rec.Plot) then
		Remotes.Notify(thief, "This base is locked!", "error")
		return
	end
	local allowed, reason = Registry.Fairness.CanSteal(thief, owner)
	if not allowed then
		Remotes.Notify(thief, reason or "You can't steal from this player.", "warning")
		return
	end
	if carrying[thief] then
		Remotes.Notify(thief, "You're already carrying something!", "error")
		return
	end
	local thiefPlot = Plots.Get(thief)
	if not thiefPlot then
		return
	end
	if not Plots.FreeSlot(thiefPlot, Economy.GetSlotCount(thief)) then
		Remotes.Notify(thief, "Your base is full! Make space before stealing.", "error")
		return
	end
	local character = thief.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	if (root.Position - rec.Root.Position).Magnitude > 18 then
		return
	end
	if not Plots.IsInside(rec.Plot, root.Position) then
		Remotes.Notify(thief, "Go INSIDE the base to steal!", "error")
		return
	end

	setState(rec, "Carried") -- se era um ovo chocando, o tempo que falta fica guardado
	rec.Thief = thief
	rec.CarryStart = os.clock()
	rec.CarryFrom = root.Position
	carrying[thief] = rec
	clearPrompts(rec)
	updateInfo(rec)

	-- Diminui e coloca nas costas
	local scale = 1
	local targetScale = if isEgg(rec) then 0.8 else Config.CarryScale
	if targetScale ~= 1 then
		local ok = pcall(function()
			rec.Model:ScaleTo(targetScale)
		end)
		rec.Scaled = ok
		if ok then
			scale = targetScale
		end
	end
	rec.Root.Anchored = false
	rec.Root.CFrame = root.CFrame * CFrame.new(0, 0.6, 0.9 + rec.BodyRadius * scale) * CFrame.Angles(0, math.pi, 0)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = rec.Root
	weld.Parent = rec.Root
	rec.CarryWeld = weld
	rec.DiedConn = humanoid.Died:Connect(function()
		if rec.Thief == thief then
			returnToOwner(rec, "died")
		end
	end)

	thief:SetAttribute("Carrying", displayName(rec))
	markDirty(owner)
	Economy.ApplySpeed(thief)
	Remotes.Notify(thief, "You grabbed " .. displayName(rec) .. "! RUN to your base!", "warning")
	Remotes.Notify(owner, thief.DisplayName .. " is stealing your " .. displayName(rec) .. "! BONK them!", "error")
	Remotes.Effect(owner, "Alarm")
	if rec.Plot and rec.Plot.Model then
		rec.Plot.Model:SetAttribute("AlarmUntil", os.time() + 8) -- v27: sirene girando na base (todo mundo vê)
	end
	Registry.Fairness.OnGrab(owner, thief)
end

---------------------------------------------------------------------
-- API usada pelos outros módulos
---------------------------------------------------------------------
-- Liga a esteira de um mundo na hora que alguém chega (sem esperar o próximo ovo)
function CritterService.ActivateLane(worldId: string)
	local lane = lanes[worldId]
	if not lane then
		return
	end
	lane.Active = true
	if not lane.Filled and fillLaneFn then
		fillLaneFn(lane)
	end
end

function CritterService.IsCarrying(player: Player): boolean
	return carrying[player] ~= nil
end

function CritterService.OnSlapped(target: Player, attacker: Player?)
	local rec = carrying[target]
	if not rec then
		return
	end
	Registry.Remotes.Notify(target, "BONK! You dropped " .. displayName(rec) .. "!", "error")
	if attacker then
		Registry.Remotes.Notify(attacker, "You made " .. target.DisplayName .. " drop " .. displayName(rec) .. "!", "success")
	end
	returnToOwner(rec, "slapped")
end

function CritterService.GetBaseIncome(player: Player): number
	local plot = Registry.Plots.Get(player)
	if not plot then
		return 0
	end
	local total = 0
	for _, rec in plot.Slots do
		if rec.State == "Placed" and rec.Owner == player then
			total += recIncome(rec)
		end
	end
	return total
end

-- Listas para salvar. Devolvem nil se o jogador não tem base (aí o save mantém a lista antiga).
function CritterService.GetSaveList(player: Player)
	local plot = Registry.Plots.Get(player)
	if not plot then
		return nil
	end
	local list = {}
	for slot, rec in plot.Slots do
		if not isEgg(rec) and rec.Owner == player and not rec.Dead then
			table.insert(list, { Id = rec.Def.Id, Slot = slot, Mutation = rec.Mutation, B = rec.Born, S = if rec.Shiny then true else nil })
		end
	end
	return list
end

function CritterService.GetEggSaveList(player: Player)
	local plot = Registry.Plots.Get(player)
	if not plot then
		return nil
	end
	local list = {}
	for slot, rec in plot.Slots do
		if isEgg(rec) and rec.Owner == player and not rec.Dead then
			local left = if rec.State == "Incubating" then math.max(0, rec.HatchAt - serverNow()) elseif rec.State == "Hatching" then 0 else rec.HatchLeft
			local result = validResult(rec.Result)
			table.insert(list, { Id = rec.EggDef.Id, Slot = slot, Left = math.floor(left), Result = result })
		end
	end
	return list
end

-- Bichinhos na base (para a tela "Critters"): { U = uid, Id, M = mutação, S = vaga }
function CritterService.GetBaseList(player: Player)
	local plot = Registry.Plots.Get(player)
	local list = {}
	if not plot then
		return list
	end
	for slot, rec in plot.Slots do
		if not isEgg(rec) and rec.Owner == player and not rec.Dead and rec.State == "Placed" then
			table.insert(list, {
				U = rec.Uid,
				Id = rec.Def.Id,
				M = rec.Mutation,
				Slot = slot,
				B = rec.Born,
				Sh = if rec.Shiny then true else nil,
				L = if rec.StolenLock > os.clock() then true else nil,
			})
		end
	end
	return list
end

-- Uids dos bichinhos iguais na base (para a fusão)
function CritterService.FindBaseUids(player: Player, critterId: string, mutation: string?): { number }
	local list = {}
	for _, item in CritterService.GetBaseList(player) do
		if item.Id == critterId and item.M == mutation and not item.L and not item.Sh then
			table.insert(list, item.U)
		end
	end
	return list
end

-- Segundos que faltam para um bichinho recém-roubado poder ir para a mochila (0 = já pode)
function CritterService.StolenLockLeft(player: Player, uid: number): number
	local plot = Registry.Plots.Get(player)
	if plot then
		for _, rec in plot.Slots do
			if rec.Uid == uid then
				return math.max(0, rec.StolenLock - os.clock())
			end
		end
	end
	return 0
end

-- Tira um bichinho da base (mochila/fusão). Só funciona se ele estiver parado no pedestal
-- (não dá para guardar enquanto alguém está carregando ele). Quem chama coloca o pendente depois.
-- Devolve (id, mutação, nascimento, shiny) do bichinho que saiu da base
function CritterService.TakeFromBase(player: Player, uid: number): (string?, string?, number?, boolean?)
	local plot = Registry.Plots.Get(player)
	if not plot then
		return nil, nil, nil, nil
	end
	for slot, rec in plot.Slots do
		if rec.Uid == uid then
			if isEgg(rec) or rec.Owner ~= player or rec.Dead or rec.State ~= "Placed" or rec.StolenLock > os.clock() then
				return nil, nil, nil, nil
			end
			local critterId, mutation, born, shiny = rec.Def.Id, rec.Mutation, rec.Born, rec.Shiny
			plot.Slots[slot] = nil
			destroyRecord(rec)
			return critterId, mutation, born, shiny
		end
	end
	return nil, nil, nil, nil
end

function CritterService.HasFreeSlot(player: Player): boolean
	local plot = Registry.Plots.Get(player)
	return plot ~= nil and Registry.Plots.FreeSlot(plot, Registry.Economy.GetSlotCount(player)) ~= nil
end

-- Mochila -> pedestal livre
function CritterService.PlaceFromInventory(player: Player, critterId: string, mutation: string?, born: number?, shiny: boolean?): boolean
	local def = Critters.ById[critterId]
	local plot = Registry.Plots.Get(player)
	if not def or not plot then
		return false
	end
	local slot = Registry.Plots.FreeSlot(plot, Registry.Economy.GetSlotCount(player))
	if not slot then
		return false
	end
	spawnPlaced(player, plot, slot, createRecord(def, mutation, born, shiny))
	return true
end

-- Coloca na base o que estava esperando vaga (ovos ou bichinhos)
function CritterService.PlacePending(player: Player)
	local profile = Registry.Data.Get(player)
	local plot = Registry.Plots.Get(player)
	if not profile or not plot then
		return
	end
	local pending = profile.Data.Pending
	local count = Registry.Economy.GetSlotCount(player)
	while #pending > 0 do
		local slot = Registry.Plots.FreeSlot(plot, count)
		if not slot then
			break
		end
		local entry = table.remove(pending, 1)
		local egg = type(entry) == "table" and entry.Egg and Config.EggById[entry.Egg]
		local def = type(entry) == "table" and entry.Id and Critters.ById[entry.Id]
		if egg then
			local rec = createEggRecord(egg, validResult(entry.Result) or CritterService.RollResult(egg, player, 1))
			rec.HatchLeft = math.clamp(tonumber(entry.Left) or egg.HatchTime, 0, egg.HatchTime)
			spawnPlaced(player, plot, slot, rec)
			Registry.Remotes.Notify(player, "A " .. egg.Name .. " arrived at your base!", "success")
		elseif def then
			local mutation = if type(entry.Mutation) == "string" and Config.MutationByName[entry.Mutation] then entry.Mutation else nil
			spawnPlaced(player, plot, slot, createRecord(def, mutation, tonumber(entry.B) or (os.time() - 86400), entry.S == true))
			Registry.Economy.Discover(player, def.Id)
			Registry.Remotes.Notify(player, def.Name .. " arrived at your base!", "success")
		end
	end
end

-- Dá um bichinho (compra com Robux): vai para o pedestal ou fica esperando vaga
function CritterService.GrantCritter(player: Player, critterId: string, mutation: string?, born: number?, shiny: boolean?): boolean
	-- sem data de nascimento (compra com Robux, códigos): já chega GIGANTE, rendendo o que a loja mostra
	born = born or (os.time() - Config.Growth[#Config.Growth].Age)
	local def = Critters.ById[critterId]
	local profile = Registry.Data.Get(player)
	if not def or not profile then
		return false
	end
	local pets = Registry.Pets
	if not CritterService.HasFreeSlot(player) and pets and pets.Add(player, critterId, mutation, born or os.time(), shiny) then
		-- base cheia: vai para a mochila (dá para colocar na base depois)
		Registry.Remotes.Notify(player, "Your base is full! " .. def.Name .. " went to your BACKPACK.", "warning")
	else
		table.insert(profile.Data.Pending, { Id = critterId, Mutation = mutation, B = born or os.time(), S = if shiny then true else nil })
		CritterService.PlacePending(player)
		if #profile.Data.Pending > 0 then
			Registry.Remotes.Notify(player, "Your base is full! " .. def.Name .. " is waiting: sell something to make space.", "warning")
		end
	end
	Registry.Remotes.Effect(player, "Stolen", def.Rarity)
	return true
end

-- Dá um ovo (códigos, recompensas)
function CritterService.GrantEgg(player: Player, eggId: string): boolean
	local egg = Config.EggById[eggId]
	local profile = Registry.Data.Get(player)
	if not egg or not profile then
		return false
	end
	table.insert(profile.Data.Pending, { Egg = eggId, Result = CritterService.RollResult(egg, player, 1) })
	CritterService.PlacePending(player)
	if #profile.Data.Pending > 0 then
		Registry.Remotes.Notify(player, "Your base is full! Your " .. egg.Name .. " is waiting: sell something to make space.", "warning")
	end
	return true
end

-- Quantos ovos do jogador estão chocando agora (Instant Hatch só é vendido se for > 0)
function CritterService.IncubatingCount(player: Player): number
	local plot = Registry.Plots.Get(player)
	if not plot then
		return 0
	end
	local count = 0
	for _, rec in plot.Slots do
		if isEgg(rec) and rec.State == "Incubating" then
			count += 1
		end
	end
	return count
end

-- Admin/teste e Instant Hatch (v20): choca todos os ovos do jogador agora. Devolve quantos.
function CritterService.HatchAllNow(player: Player): number
	local plot = Registry.Plots.Get(player)
	if not plot then
		return 0
	end
	local count = 0
	for _, rec in plot.Slots do
		if isEgg(rec) and rec.State == "Incubating" then
			rec.HatchAt = serverNow()
			rec.Model:SetAttribute("HatchAt", rec.HatchAt)
			count += 1
		end
	end
	return count
end

function CritterService.LoadForPlayer(player: Player, critters: any, eggs: any)
	local Plots = Registry.Plots
	local plot = Plots.Get(player)
	if not plot then
		return
	end
	local count = Registry.Economy.GetSlotCount(player)
	Plots.RefreshSlots(plot, count)
	local profile = Registry.Data.Get(player)

	local function slotFor(wanted: any): number?
		if type(wanted) == "number" and wanted >= 1 and wanted <= count and plot.Slots[wanted] == nil then
			return wanted
		end
		return Plots.FreeSlot(plot, count)
	end

	if type(critters) == "table" then
		for _, entry in critters do
			local def = if type(entry) == "table" then Critters.ById[entry.Id] else nil
			if def then
				local mutation = if type(entry.Mutation) == "string" and Config.MutationByName[entry.Mutation] then entry.Mutation else nil
				-- save antigo (antes da v9) não tem nascimento: já conta como gigante (renda cheia, como antes)
				local born = tonumber(entry.B) or (os.time() - 86400)
				local shiny = entry.S == true
				local slot = slotFor(entry.Slot)
				if slot then
					spawnPlaced(player, plot, slot, createRecord(def, mutation, born, shiny))
				elseif profile then
					table.insert(profile.Data.Pending, { Id = def.Id, Mutation = mutation, B = born, S = if shiny then true else nil })
				end
			end
		end
	end
	if type(eggs) == "table" then
		-- os ovos continuam chocando enquanto o jogador estava fora do jogo
		local lastOnline = if profile then tonumber(profile.Data.LastOnline) or 0 else 0
		local away = if lastOnline > 0 then math.max(0, os.time() - lastOnline) else 0
		local hatchedAway = {}
		for _, entry in eggs do
			local egg = if type(entry) == "table" then Config.EggById[entry.Id] else nil
			if egg then
				local result = validResult(entry.Result) or CritterService.RollResult(egg, player, 1)
				local savedLeft = math.clamp(tonumber(entry.Left) or egg.HatchTime, 0, egg.HatchTime)
				-- ovo de clima/noite não choca offline (só no clima certo)
				local left = if egg.Condition then savedLeft else math.max(0, savedLeft - away)
				local slot = slotFor(entry.Slot)
				if slot and left <= 0 then
					-- chocou enquanto estava fora: vira bichinho direto (sem tela de suspense para cada um)
					local def = Critters.ById[result.Id]
					local bornAt = if lastOnline > 0 then lastOnline + savedLeft else os.time()
					spawnPlaced(player, plot, slot, createRecord(def, result.Mutation, math.min(bornAt, os.time()), result.Shiny))
					Registry.Economy.Discover(player, def.Id)
					Registry.Economy.AddHatch(player)
					table.insert(hatchedAway, (if result.Shiny then "SHINY " else "") .. (if result.Mutation then result.Mutation .. " " else "") .. def.Name)
					local discoveries = Registry.Discoveries
					if def.Rarity == "Secret" and discoveries then
						task.spawn(discoveries.Claim, player, def.Id)
					end
				elseif slot then
					local rec = createEggRecord(egg, result)
					rec.HatchLeft = left
					spawnPlaced(player, plot, slot, rec)
				elseif profile then
					table.insert(profile.Data.Pending, { Egg = egg.Id, Result = result, Left = left })
				end
			end
		end
		if #hatchedAway > 0 then
			Registry.Remotes.Popup(player, "Your eggs hatched!", "While you were away you got:\n" .. table.concat(hatchedAway, ", "))
		end
	end
	CritterService.PlacePending(player)
end

-- Remove tudo do jogador (quando ele sai do jogo)
function CritterService.ClearOwnerCritters(player: Player)
	local plot = Registry.Plots.Get(player)
	if not plot then
		return
	end
	for _, rec in plot.Slots do
		local thief = rec.Thief
		destroyRecord(rec)
		if thief and thief.Parent then
			Registry.Remotes.Notify(thief, "What you were carrying vanished!", "warning")
		end
	end
	table.clear(plot.Slots)
end

-- Se o jogador estava carregando algo roubado, volta para o dono
function CritterService.DropCarried(player: Player)
	local carried = carrying[player]
	if carried then
		returnToOwner(carried, "left")
	end
end

function CritterService.Init()
	folder = Instance.new("Folder")
	folder.Name = "ActiveCritters"
	folder.Parent = workspace

	-- Uma esteira por mundo (Meadow = Map.Conveyor; os outros = Map.Worlds.<id>.Conveyor)
	local map = workspace:WaitForChild("Map")
	local worldsFolder = map:FindFirstChild("Worlds")
	for _, world in Config.Worlds do
		local belt: BasePart? = nil
		if world.Id == "meadow" then
			belt = map:FindFirstChild("Conveyor") :: BasePart?
		elseif worldsFolder then
			local area = worldsFolder:FindFirstChild(world.Id)
			belt = area and area:FindFirstChild("Conveyor") :: BasePart?
		end
		if belt and #Config.EggsOfWorld(world.Id) > 0 then
			lanes[world.Id] = {
				World = world.Id,
				StartX = belt.Position.X - belt.Size.X / 2 + 6,
				EndX = belt.Position.X + belt.Size.X / 2 - 6,
				Y = belt.Position.Y + belt.Size.Y / 2,
				Z = belt.Position.Z,
				List = {},
				Filled = false,
				Active = world.Id == "meadow",
			}
		end
	end

	local function fillLane(lane)
		if lane.Filled then
			return
		end
		lane.Filled = true
		local spacing = Config.ConveyorSpeed * Config.ConveyorSpawnInterval
		local x = lane.StartX + spacing
		while x < lane.EndX - 10 do
			CritterService.SpawnEggOnConveyor(CritterService.RandomEgg(lane.World), x, true)
			x += spacing
		end
	end

	-- Esteiras andando
	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		for _, lane in lanes do
			if not lane.Active then
				continue -- mundo sem ninguém: a esteira fica parada
			end
			local list = lane.List
			for i = #list, 1, -1 do
				local rec = list[i]
				if rec.Dead or rec.State ~= "Conveyor" then
					table.remove(list, i)
				else
					rec.X += Config.ConveyorSpeed * dt
					if rec.X >= lane.EndX then
						table.remove(list, i)
						destroyRecord(rec)
					else
						local hop = math.abs(math.sin((now + rec.Phase) * 5)) * 0.25
						local position = Vector3.new(rec.X, lane.Y + rec.Ground + hop, lane.Z)
						rec.Root.CFrame = CFrame.lookAt(position, position + Vector3.xAxis) * CFrame.Angles(0, 0, math.sin((now + rec.Phase) * 5) * 0.15)
					end
				end
			end
		end
	end)

	fillLaneFn = fillLane
	-- Enche a esteira do Meadow no começo (as outras enchem quando alguém chega no mundo)
	if lanes.meadow then
		fillLane(lanes.meadow)
	end

	-- Ovos novos (só nas esteiras de mundos com jogadores)
	task.spawn(function()
		while true do
			task.wait(Config.ConveyorSpawnInterval)
			local ok, err = pcall(function()
				local present = {}
				for _, player in Players:GetPlayers() do
					local world = player:GetAttribute("World")
					if typeof(world) == "string" then
						present[world] = true
					end
				end
				for id, lane in lanes do
					lane.Active = id == "meadow" or present[id] == true
					if lane.Active then
						if not lane.Filled then
							fillLane(lane)
						end
						CritterService.SpawnEggOnConveyor(CritterService.RandomEgg(id))
					end
				end
			end)
			if not ok then
				warn("[CritterService] loop error:", err)
			end
		end
	end)

	-- Chocar quando o tempo acaba (ovo de clima/noite: o tempo só corre no clima certo)
	task.spawn(function()
		local last = serverNow()
		while true do
			task.wait(0.25)
			local ok, err = pcall(function()
				local now = serverNow()
				local dt = now - last
				last = now
				for rec in incubating do
					if rec.Dead or rec.State ~= "Incubating" then
						incubating[rec] = nil
					elseif rec.EggDef.Condition and not conditionActive(rec.EggDef.Condition) then
						rec.HatchAt += dt -- esperando o clima: o relógio do ovo para
						if not rec.Waiting then
							rec.Waiting = true
							rec.Model:SetAttribute("WaitFor", rec.EggDef.Condition)
						end
						if now - rec.LastSync > 2 then
							rec.LastSync = now
							rec.Model:SetAttribute("HatchAt", rec.HatchAt)
						end
					else
						if rec.Waiting then
							rec.Waiting = false
							rec.Model:SetAttribute("WaitFor", nil)
							rec.Model:SetAttribute("HatchAt", rec.HatchAt)
						end
						if now >= rec.HatchAt then
							incubating[rec] = nil
							task.spawn(hatchEgg, rec)
						end
					end
				end
			end)
			if not ok then
				warn("[CritterService] loop error:", err)
			end
		end
	end)

	-- Crescimento e fim do carinho (a cada 10 s)
	task.spawn(function()
		while true do
			task.wait(10)
			local ok, err = pcall(function()
				local now = os.clock()
				for _, plot in Registry.Plots.All() do
					for _, rec in plot.Slots do
						if not isEgg(rec) and not rec.Dead then
							applyStage(rec)
							if rec.HappyUntil > 0 and rec.HappyUntil <= now then
								rec.HappyUntil = 0
								setHearts(rec, false)
								updateInfo(rec)
							elseif rec.FedUntil > 0 and rec.FedUntil <= now then
								rec.FedUntil = 0
								updateInfo(rec)
							end
						end
					end
				end
			end)
			if not ok then
				warn("[CritterService] loop error:", err)
			end
		end
	end)

	-- Some com os ovos da chuva que ninguém pegou
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(function()
				local now = os.clock()
				for i = #rainList, 1, -1 do
					local rec = rainList[i]
					if rec.Dead or rec.State ~= "Rain" then
						table.remove(rainList, i)
					elseif now >= rec.Expire then
						table.remove(rainList, i)
						destroyRecord(rec)
					end
				end
			end)
			if not ok then
				warn("[CritterService] loop error:", err)
			end
		end
	end)

	-- Confere quem está carregando algo roubado
	task.spawn(function()
		while true do
			task.wait(0.15)
			for thief, rec in carrying do
				-- cada roubo no seu próprio pcall: se um der erro, ele é descartado e os outros seguem
				local ok, err = pcall(function()
					if rec.Dead then
						carrying[thief] = nil
						return
					end
					local character = thief.Character
					local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
					local humanoid = character and character:FindFirstChildOfClass("Humanoid")
					local weld = rec.CarryWeld
					if not root or not humanoid or humanoid.Health <= 0 or not weld or weld.Part0 ~= root then
						returnToOwner(rec, "dropped")
					else
						local home = Registry.Plots.Get(thief)
						if home and Registry.Plots.IsInside(home, root.Position) then
							-- anti-teleporte: precisa ter levado um tempo mínimo para correr até a base
							local distance = (root.Position - (rec.CarryFrom or root.Position)).Magnitude
							local minimumTime = distance / (humanoid.WalkSpeed * 1.5 + 6)
							if os.clock() - (rec.CarryStart or 0) >= minimumTime then
								completeSteal(rec)
							else
								returnToOwner(rec, "invalid")
							end
						end
					end
				end)
				if not ok then
					warn("[CritterService] carry error:", err)
					pcall(returnToOwner, rec, "dropped") -- tenta devolver o bichinho ao dono
					carrying[thief] = nil
				end
			end
		end
	end)
end

return CritterService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="443">
        <Properties>
          <string name="Name">Customize</string>
          <string name="Source"><![CDATA[--[[
	Customize (ModuleScript em ServerScriptService > Game)
	Parte 15: personalização (só visual, nada dá vantagem).
	  • Tema da base: troca cores/materiais da base inteira e coloca enfeites do tema nas paredes e torres
	  • Decoração: 8 vagas no chão da base; cada vaga recebe um enfeite que você já tem
	  • Trilha: rastro colorido atrás do avatar
	  • Título: texto em cima da cabeça (ganho com conquistas); VIP aparece aqui também
	  • Premium: +Config.PremiumBonus de dinheiro (fica no Economy) e o título "Premium"
	O catálogo (nomes, preços, requisitos) fica em ReplicatedStorage > Shared > Cosmetics.
	Todos veem a base e o avatar de todos, então os enfeites são criados aqui no servidor.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Cosmetics = require(ReplicatedStorage.Shared.Cosmetics)
local Critters = require(ReplicatedStorage.Shared.Critters)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local Customize = {}

-- Vagas de decoração: (lado, frente) dentro da base. + = lado esquerdo/entrada. Ficam longe dos pedestais,
-- do botão de trancar, do coletor e da esteira de treino.
local DECOR_SPOTS = { -- v20: base mais funda (frente = +44, fundo = -44)
	{ 12, 20 }, { -26, 21 }, -- a vaga 1 saiu do canto da direita (lá fica a rampa do 2º andar)
	{ 27, 5 }, { -27, 5 },
	{ 27, -11 }, { -27, -11 },
	{ 27, -25 }, { -27, -25 },
}
-- Enfeites do tema: em cima das paredes (y = 15.3) e das 4 torres (y = 25)
local WALL_PROPS = { { 31, -28 }, { 31, -4 }, { 31, 20 }, { -31, -28 }, { -31, -4 }, { -31, 20 }, { 16, -43 }, { -16, -43 } }
local TOWER_PROPS = { { 31, 43 }, { -31, 43 }, { 31, -43 }, { -31, -43 } }
local WALL_TOP = 15.3
local FLOOR2_WALL_TOP = 21.8 -- com o 2º andar, os enfeites de trás sobem para cima do vidro
local FLOOR2_FRONT = 18 -- o 2º andar cobre a base de lf = -44 até lf = 18
local TOWER_TOP = 25
local FLOOR_TOP = 0.55

local WALL_NAMES = { "WallBack", "WallLeft", "WallRight", "WallFrontA", "WallFrontB" }

local defaults: { [any]: { [BasePart]: { Color: Color3, Material: Enum.Material } } } = {}

local function getData(player: Player): any
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

local function isPremium(player: Player): boolean
	return player.MembershipType == Enum.MembershipType.Premium
end
Customize.IsPremium = isPremium

---------------------------------------------------------------------
-- Peças
---------------------------------------------------------------------
local function newPart(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		(p :: any)[key] = value
	end
	p.Parent = parent
	return p
end

local function ball(parent: Instance, cf: CFrame, d: number, color: Color3, material: Enum.Material?): Part
	return newPart(parent, { Shape = Enum.PartType.Ball, Size = Vector3.one * d, CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic })
end

-- cilindro em pé (o cilindro do Roblox deita no eixo X, então giramos)
local function vcyl(parent: Instance, cf: CFrame, d: number, h: number, color: Color3, material: Enum.Material?): Part
	return newPart(parent, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(h, d, d),
		CFrame = cf * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	})
end

local function block(parent: Instance, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?): Part
	return newPart(parent, { Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic })
end

-- ovo/elipse (esfera esticada)
local function ellipsoid(parent: Instance, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?): Part
	local p = block(parent, cf, size, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function tagMover(model: Model, spin: number?, bob: number?)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic -- chega inteiro na tela (o centro do giro fica certo)
	if spin then
		model:SetAttribute("SpinSpeed", spin)
		model:AddTag("Spin")
	end
	if bob then
		model:SetAttribute("BobHeight", bob)
		model:AddTag("Bob")
	end
end

---------------------------------------------------------------------
-- Enfeites de decoração (cada um cabe num círculo de ~5 studs)
---------------------------------------------------------------------
local DECOR_BUILDERS: { [string]: (Model, CFrame) -> () } = {
	flowers = function(m, cf)
		vcyl(m, cf * CFrame.new(0, 1, 0), 2.4, 2, rgb(190, 110, 70))
		ball(m, cf * CFrame.new(0, 2.4, 0), 2.4, rgb(80, 170, 80), Enum.Material.Grass)
		ball(m, cf * CFrame.new(0.6, 3.4, 0.2), 1.1, rgb(255, 120, 160))
		ball(m, cf * CFrame.new(-0.6, 3.3, -0.3), 1.1, rgb(255, 220, 80))
		ball(m, cf * CFrame.new(0, 3.6, -0.6), 1.1, rgb(190, 120, 255))
	end,
	lamp = function(m, cf)
		vcyl(m, cf * CFrame.new(0, 0.3, 0), 1.8, 0.6, rgb(50, 50, 60), Enum.Material.Metal)
		vcyl(m, cf * CFrame.new(0, 4, 0), 0.5, 7, rgb(50, 50, 60), Enum.Material.Metal)
		ball(m, cf * CFrame.new(0, 7.9, 0), 1.7, rgb(255, 235, 150), Enum.Material.Neon)
		vcyl(m, cf * CFrame.new(0, 8.9, 0), 1.9, 0.4, rgb(50, 50, 60), Enum.Material.Metal)
	end,
	bush = function(m, cf)
		ball(m, cf * CFrame.new(0, 1.6, 0), 3.6, rgb(80, 180, 70), Enum.Material.Grass)
		ball(m, cf * CFrame.new(1.1, 2.4, 0.3), 2.6, rgb(100, 200, 85), Enum.Material.Grass)
		ball(m, cf * CFrame.new(-1, 2.2, -0.5), 2.4, rgb(70, 165, 65), Enum.Material.Grass)
	end,
	balloons = function(m, cf)
		block(m, cf * CFrame.new(0, 0.3, 0), Vector3.new(1.2, 0.6, 1.2), rgb(90, 90, 100))
		local colors = { rgb(255, 80, 90), rgb(80, 160, 255), rgb(255, 220, 70) }
		local offsets = { Vector3.new(0.9, 6.4, 0), Vector3.new(-0.9, 6, 0.4), Vector3.new(0, 7.4, -0.6) }
		for i, offset in offsets do
			local top = cf * CFrame.new(offset)
			local base = cf * CFrame.new(0, 0.6, 0)
			local mid = base.Position:Lerp(top.Position, 0.5)
			local length = (top.Position - base.Position).Magnitude
			newPart(m, { Size = Vector3.new(0.08, length, 0.08), CFrame = CFrame.lookAt(mid, top.Position) * CFrame.Angles(math.rad(90), 0, 0), Color = rgb(240, 240, 240) })
			ellipsoid(m, top * CFrame.new(0, 0.9, 0), Vector3.new(1.8, 2.2, 1.8), colors[i])
		end
		tagMover(m, nil, 0.4)
	end,
	fountain = function(m, cf)
		vcyl(m, cf * CFrame.new(0, 0.5, 0), 4.8, 1, rgb(200, 200, 210), Enum.Material.Marble)
		vcyl(m, cf * CFrame.new(0, 1.02, 0), 4.1, 0.1, rgb(110, 200, 255), Enum.Material.Glass).Transparency = 0.25
		vcyl(m, cf * CFrame.new(0, 2.2, 0), 0.8, 2.4, rgb(200, 200, 210), Enum.Material.Marble)
		vcyl(m, cf * CFrame.new(0, 3.5, 0), 2.2, 0.4, rgb(200, 200, 210), Enum.Material.Marble)
		ball(m, cf * CFrame.new(0, 4.1, 0), 0.9, rgb(150, 225, 255), Enum.Material.Neon)
	end,
	eggstatue = function(m, cf)
		block(m, cf * CFrame.new(0, 0.7, 0), Vector3.new(2.8, 1.4, 2.8), rgb(235, 235, 240), Enum.Material.Marble)
		local egg = Instance.new("Model")
		egg.Name = "Egg"
		ellipsoid(egg, cf * CFrame.new(0, 3.1, 0), Vector3.new(2.4, 3.2, 2.4), rgb(255, 200, 60), Enum.Material.Foil)
		egg.Parent = m
		tagMover(egg, 0.6, 0.25)
	end,
	trophy = function(m, cf)
		block(m, cf * CFrame.new(0, 0.5, 0), Vector3.new(2.4, 1, 2.4), rgb(60, 40, 30), Enum.Material.Wood)
		vcyl(m, cf * CFrame.new(0, 1.8, 0), 0.6, 1.6, rgb(255, 205, 60), Enum.Material.Foil)
		vcyl(m, cf * CFrame.new(0, 3.3, 0), 2.2, 1.8, rgb(255, 205, 60), Enum.Material.Foil)
		ball(m, cf * CFrame.new(1.3, 3.5, 0), 0.8, rgb(255, 205, 60), Enum.Material.Foil)
		ball(m, cf * CFrame.new(-1.3, 3.5, 0), 0.8, rgb(255, 205, 60), Enum.Material.Foil)
		ball(m, cf * CFrame.new(0, 4.7, 0), 0.9, rgb(255, 255, 200), Enum.Material.Neon)
	end,
	lollipop = function(m, cf)
		vcyl(m, cf * CFrame.new(0, 3.5, 0), 0.4, 7, rgb(250, 250, 250))
		newPart(m, { Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 3.8, 3.8), CFrame = cf * CFrame.new(0, 8, 0) * CFrame.Angles(0, math.rad(90), 0), Color = rgb(255, 110, 190) })
		newPart(m, { Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.56, 2.6, 2.6), CFrame = cf * CFrame.new(0, 8, 0) * CFrame.Angles(0, math.rad(90), 0), Color = rgb(255, 255, 255) })
		newPart(m, { Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.62, 1.4, 1.4), CFrame = cf * CFrame.new(0, 8, 0) * CFrame.Angles(0, math.rad(90), 0), Color = rgb(120, 220, 255) })
	end,
	snowman = function(m, cf)
		local white = rgb(245, 250, 255)
		ball(m, cf * CFrame.new(0, 1.5, 0), 3.2, white, Enum.Material.Snow)
		ball(m, cf * CFrame.new(0, 3.6, 0), 2.4, white, Enum.Material.Snow)
		ball(m, cf * CFrame.new(0, 5.2, 0), 1.8, white, Enum.Material.Snow)
		ball(m, cf * CFrame.new(0.35, 5.4, -0.8), 0.3, rgb(20, 20, 20))
		ball(m, cf * CFrame.new(-0.35, 5.4, -0.8), 0.3, rgb(20, 20, 20))
		newPart(m, { Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 0.25, 0.25), CFrame = cf * CFrame.new(0, 5.15, -1.1) * CFrame.Angles(0, math.rad(90), 0), Color = rgb(255, 140, 40) })
		vcyl(m, cf * CFrame.new(0, 6.1, 0), 1.9, 0.2, rgb(25, 25, 30))
		vcyl(m, cf * CFrame.new(0, 6.7, 0), 1.2, 1.1, rgb(25, 25, 30))
	end,
	lavalamp = function(m, cf)
		vcyl(m, cf * CFrame.new(0, 0.6, 0), 2, 1.2, rgb(60, 50, 60), Enum.Material.Metal)
		local glass = vcyl(m, cf * CFrame.new(0, 3.2, 0), 1.6, 4, rgb(255, 150, 60), Enum.Material.Glass)
		glass.Transparency = 0.45
		vcyl(m, cf * CFrame.new(0, 5.4, 0), 1.2, 0.5, rgb(60, 50, 60), Enum.Material.Metal)
		for i, y in { 2, 3.4, 4.3 } do
			local blob = Instance.new("Model")
			blob.Name = "Blob" .. i
			ball(blob, cf * CFrame.new(0, y, 0), 0.7 + i * 0.1, rgb(255, 100, 20), Enum.Material.Neon)
			blob.Parent = m
			tagMover(blob, nil, 0.5)
		end
	end,
	coral = function(m, cf)
		ball(m, cf * CFrame.new(0, 0.6, 0), 2.4, rgb(120, 110, 100), Enum.Material.Slate)
		local branches = { { 0, 0, rgb(255, 120, 120) }, { 35, 60, rgb(255, 170, 90) }, { -30, -70, rgb(255, 110, 200) } }
		for _, info in branches do
			local tilt, turn, color = info[1], info[2], info[3]
			local base = cf * CFrame.new(0, 1, 0) * CFrame.Angles(0, math.rad(turn), math.rad(tilt))
			vcyl(m, base * CFrame.new(0, 2, 0), 0.6, 4, color)
			ball(m, base * CFrame.new(0, 4.1, 0), 1, color)
		end
	end,
	seasontrophy = function(m, cf)
		block(m, cf * CFrame.new(0, 0.6, 0), Vector3.new(2.8, 1.2, 2.8), rgb(70, 50, 120), Enum.Material.Marble)
		vcyl(m, cf * CFrame.new(0, 1.8, 0), 0.7, 1.4, rgb(255, 205, 60), Enum.Material.Foil)
		local cup = Instance.new("Model")
		cup.Name = "Cup"
		vcyl(cup, cf * CFrame.new(0, 3.3, 0), 2, 1.6, rgb(255, 205, 60), Enum.Material.Foil)
		ball(cup, cf * CFrame.new(0, 4.6, 0), 1.2, rgb(255, 120, 220), Enum.Material.Neon)
		cup.Parent = m
		tagMover(cup, 0.7, nil)
	end,
	planet = function(m, cf)
		vcyl(m, cf * CFrame.new(0, 0.4, 0), 2.2, 0.8, rgb(60, 50, 110))
		local orb = Instance.new("Model")
		orb.Name = "Orb"
		ball(orb, cf * CFrame.new(0, 4, 0), 2.6, rgb(170, 110, 255))
		newPart(orb, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.12, 4.4, 4.4),
			CFrame = cf * CFrame.new(0, 4, 0) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(math.rad(25), 0, 0),
			Color = rgb(255, 220, 120),
			Material = Enum.Material.Neon,
		})
		orb.Parent = m
		tagMover(orb, 0.8, 0.5)
	end,
}

---------------------------------------------------------------------
-- Enfeites de cada tema (em cima das paredes e torres)
---------------------------------------------------------------------
local PROP_BUILDERS: { [string]: { Wall: (Model, CFrame) -> (), Tower: (Model, CFrame) -> () } } = {
	garden = {
		Wall = function(m, cf)
			ball(m, cf * CFrame.new(0, 1, 0), 2.6, rgb(80, 170, 70), Enum.Material.Grass)
			ball(m, cf * CFrame.new(0.6, 2.2, 0), 1.2, rgb(255, 120, 160))
			ball(m, cf * CFrame.new(-0.6, 2.1, 0.4), 1.2, rgb(255, 230, 90))
		end,
		Tower = function(m, cf)
			vcyl(m, cf * CFrame.new(0, 1, 0), 0.8, 2, rgb(125, 85, 55), Enum.Material.Wood)
			ball(m, cf * CFrame.new(0, 3, 0), 3.4, rgb(90, 180, 75), Enum.Material.Grass)
		end,
	},
	candy = {
		Wall = function(m, cf)
			local colors = { rgb(255, 90, 150), rgb(120, 220, 255), rgb(255, 230, 90), rgb(150, 230, 120) }
			ellipsoid(m, cf * CFrame.new(0, 0.9, 0), Vector3.new(2.8, 2.2, 2.8), colors[math.random(1, #colors)])
		end,
		Tower = function(m, cf)
			vcyl(m, cf * CFrame.new(0, 2, 0), 0.35, 4, rgb(250, 250, 250))
			newPart(m, { Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 3, 3), CFrame = cf * CFrame.new(0, 4.5, 0), Color = rgb(255, 100, 180) })
			newPart(m, { Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.46, 1.6, 1.6), CFrame = cf * CFrame.new(0, 4.5, 0), Color = rgb(255, 255, 255) })
		end,
	},
	frost = {
		Wall = function(m, cf)
			for i, angle in { -18, 0, 20 } do
				local crystal = block(m, cf * CFrame.new((i - 2) * 0.7, 1.5, 0) * CFrame.Angles(0, 0, math.rad(angle)), Vector3.new(0.8, 3 + i * 0.5, 0.8), rgb(170, 225, 255), Enum.Material.Glass)
				crystal.Transparency = 0.2
			end
		end,
		Tower = function(m, cf)
			ellipsoid(m, cf * CFrame.new(0, 0.2, 0), Vector3.new(5, 2, 5), rgb(250, 252, 255), Enum.Material.Snow)
		end,
	},
	lava = {
		Wall = function(m, cf)
			ball(m, cf * CFrame.new(0, 0.9, 0), 2.6, rgb(60, 45, 45), Enum.Material.Basalt)
			ball(m, cf * CFrame.new(0.4, 1.8, 0), 1.4, rgb(255, 110, 30), Enum.Material.Neon)
		end,
		Tower = function(m, cf)
			local flame = Instance.new("Model")
			flame.Name = "Flame"
			ball(flame, cf * CFrame.new(0, 1, 0), 2, rgb(255, 110, 30), Enum.Material.Neon)
			ball(flame, cf * CFrame.new(0, 2.2, 0), 1.3, rgb(255, 210, 60), Enum.Material.Neon)
			flame.Parent = m
			tagMover(flame, nil, 0.4)
		end,
	},
	reef = {
		Wall = function(m, cf)
			local colors = { rgb(255, 120, 120), rgb(255, 170, 90), rgb(255, 110, 200) }
			local color = colors[math.random(1, #colors)]
			vcyl(m, cf * CFrame.new(0, 1.5, 0) * CFrame.Angles(0, 0, math.rad(15)), 0.8, 3, color)
			vcyl(m, cf * CFrame.new(0.5, 1.2, 0) * CFrame.Angles(0, 0, math.rad(-25)), 0.7, 2.4, color)
			ball(m, cf * CFrame.new(-0.4, 3, 0), 1.1, color)
		end,
		Tower = function(m, cf)
			ellipsoid(m, cf * CFrame.new(0, 0.7, 0), Vector3.new(3.2, 1.4, 2.6), rgb(255, 190, 200))
			ball(m, cf * CFrame.new(0, 1.5, 0), 1, rgb(255, 255, 250), Enum.Material.Glass)
		end,
	},
	galaxy = {
		Wall = function(m, cf)
			local star = Instance.new("Model")
			star.Name = "Star"
			ball(star, cf * CFrame.new(0, 1.6, 0), 1.4, rgb(255, 235, 140), Enum.Material.Neon)
			star.Parent = m
			tagMover(star, nil, 0.5)
		end,
		Tower = function(m, cf)
			local planet = Instance.new("Model")
			planet.Name = "Planet"
			ball(planet, cf * CFrame.new(0, 3.5, 0), 3, rgb(120, 80, 220))
			newPart(planet, {
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.12, 5, 5),
				CFrame = cf * CFrame.new(0, 3.5, 0) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(math.rad(20), 0, 0),
				Color = rgb(255, 200, 120),
				Material = Enum.Material.Neon,
			})
			planet.Parent = m
			tagMover(planet, 0.5, 0.6)
		end,
	},
}

---------------------------------------------------------------------
-- Tema da base
---------------------------------------------------------------------
local function localCFrame(plot, lx: number, y: number, lf: number): CFrame
	local origin: CFrame = plot.Origin.CFrame
	local position = (origin * CFrame.new(lx, 0, -lf)).Position
	local center = origin.Position
	local world = Vector3.new(position.X, y, position.Z)
	local look = Vector3.new(center.X, y, center.Z)
	if (look - world).Magnitude < 0.1 then
		return CFrame.new(world)
	end
	return CFrame.lookAt(world, look)
end

local function themeParts(plot): { [string]: { BasePart } }
	local model: Model = plot.Model
	local groups = { Floor = {}, Stripe = {}, Band = {}, Top = {}, Trim = {}, Tower = {}, Cap = {}, Flag = {}, Gate = {}, Rug = {}, Sign = {} }
	local function add(group: string, instance: Instance?)
		if instance and instance:IsA("BasePart") then
			table.insert(groups[group], instance)
		end
	end
	add("Floor", model:FindFirstChild("Floor"))
	for i = 0, 4 do
		add("Stripe", model:FindFirstChild("Stripe" .. i))
		local tower = model:FindFirstChild("Tower" .. i)
		if tower then
			add("Tower", tower:FindFirstChild("Body"))
			add("Cap", tower:FindFirstChild("Cap"))
			add("Flag", tower:FindFirstChild("Flag"))
		end
	end
	for _, name in WALL_NAMES do
		add("Band", model:FindFirstChild(name))
		add("Top", model:FindFirstChild(name .. "Top"))
		add("Trim", model:FindFirstChild(name .. "Trim"))
	end
	for _, name in { "GateA", "GateB", "GateTop" } do
		add("Gate", model:FindFirstChild(name))
	end
	add("Rug", model:FindFirstChild("Rug"))
	add("Sign", model:FindFirstChild("Sign"))
	-- 2º andar (v19): fica guardado fora da base até o dono ter 19 vagas, por isso vem de plot.Floor2
	local floor2 = plot.Floor2 or model:FindFirstChild("Floor2")
	if floor2 then
		add("Floor", floor2:FindFirstChild("Deck"))
		for i = 0, 3 do
			add("Stripe", floor2:FindFirstChild("Stripe" .. i))
		end
		for _, name in { "GlassLeftTrim", "GlassRightTrim", "GlassBackTrim", "RailTrim", "RampRailTrim" } do
			add("Trim", floor2:FindFirstChild(name))
		end
		add("Top", floor2:FindFirstChild("Rail"))
		add("Top", floor2:FindFirstChild("RampRail"))
		add("Band", floor2:FindFirstChild("Ramp"))
		add("Sign", floor2:FindFirstChild("Sign2"))
	end
	return groups
end

local function clearFolder(plot, name: string): Folder
	local model: Model = plot.Model
	local old = model:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = model
	return folder
end

function Customize.ApplyTheme(plot, themeId: string)
	local theme = Cosmetics.ById.theme[themeId]
	local saved = defaults[plot]
	if not saved then
		return
	end
	-- volta tudo ao normal e depois pinta com o tema
	for part, look in saved do
		part.Color = look.Color
		part.Material = look.Material
	end
	local props = clearFolder(plot, "ThemeProps")
	plot.Model:SetAttribute("Theme", themeId)
	if not theme or themeId == "classic" then
		return
	end
	local groups = themeParts(plot)
	local function paint(group: string, spec)
		if not spec then
			return
		end
		local color = if typeof(spec) == "Color3" then spec else spec[1]
		local material = if typeof(spec) == "table" and spec[2] then (Enum.Material :: any)[spec[2]] else nil
		for _, part in groups[group] do
			part.Color = color
			if material then
				part.Material = material
			end
		end
	end
	paint("Floor", theme.Floor)
	paint("Stripe", theme.Stripe)
	paint("Band", theme.Band)
	paint("Top", theme.Top)
	paint("Trim", theme.Trim)
	paint("Tower", theme.Tower)
	paint("Cap", theme.Cap)
	paint("Flag", theme.Trim)
	paint("Gate", theme.Gate)
	paint("Rug", theme.Rug)
	if theme.Band then
		paint("Sign", (theme.Band :: any)[1]:Lerp(Color3.new(0, 0, 0), 0.35)) -- placa com o nome: um tom mais escuro
	end

	local builders = PROP_BUILDERS[theme.Props or ""]
	if builders then
		local floor2 = plot.Model:GetAttribute("Floor2") == true
		for i, spot in WALL_PROPS do
			local m = Instance.new("Model")
			m.Name = "Wall" .. i
			local y = if floor2 and spot[2] <= FLOOR2_FRONT then FLOOR2_WALL_TOP else WALL_TOP
			builders.Wall(m, localCFrame(plot, spot[1], y, spot[2]))
			m.Parent = props
		end
		for i, spot in TOWER_PROPS do
			local m = Instance.new("Model")
			m.Name = "Tower" .. i
			builders.Tower(m, localCFrame(plot, spot[1], TOWER_TOP, spot[2]))
			m.Parent = props
		end
	end
end

---------------------------------------------------------------------
-- Decoração
---------------------------------------------------------------------
local function buildDecor(plot, spot: number, decorId: string?)
	local folder = plot.Model:FindFirstChild("Decor")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Decor"
		folder.Parent = plot.Model
	end
	local old = folder:FindFirstChild("Spot" .. spot)
	if old then
		old:Destroy()
	end
	local builder = decorId and DECOR_BUILDERS[decorId]
	local position = DECOR_SPOTS[spot]
	if not builder or not position then
		return
	end
	local model = Instance.new("Model")
	model.Name = "Spot" .. spot
	model:SetAttribute("DecorId", decorId)
	builder(model, localCFrame(plot, position[1], FLOOR_TOP, position[2]))
	model.Parent = folder
end

-- Volta a base ao normal (jogador saiu)
function Customize.ResetPlot(plot)
	Customize.ApplyTheme(plot, "classic")
	clearFolder(plot, "Decor")
	plot.Model:SetAttribute("Theme", nil)
end

---------------------------------------------------------------------
-- Trilha e título
---------------------------------------------------------------------
local function applyTrail(player: Player)
	local data = getData(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not data or not root then
		return
	end
	for _, name in { "StyleTrail", "TrailTop", "TrailBottom" } do
		local old = root:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local trail = Cosmetics.ById.trail[data.Style.Trail]
	if not trail then
		return
	end
	local top = Instance.new("Attachment")
	top.Name = "TrailTop"
	top.Position = Vector3.new(0, 0.9, 0)
	top.Parent = root
	local bottom = Instance.new("Attachment")
	bottom.Name = "TrailBottom"
	bottom.Position = Vector3.new(0, -1.3, 0)
	bottom.Parent = root
	local keypoints = {}
	for i, color in trail.Colors do
		table.insert(keypoints, ColorSequenceKeypoint.new(if #trail.Colors == 1 then 0 else (i - 1) / (#trail.Colors - 1), color))
	end
	if #keypoints == 1 then
		table.insert(keypoints, ColorSequenceKeypoint.new(1, trail.Colors[1]))
	end
	local effect = Instance.new("Trail")
	effect.Name = "StyleTrail"
	effect.Attachment0 = top
	effect.Attachment1 = bottom
	effect.Color = ColorSequence.new(keypoints)
	effect.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) })
	effect.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.3) })
	effect.Lifetime = 0.55
	effect.MinLength = 0.1
	effect.LightEmission = 0.5
	effect.FaceCamera = true
	effect.Parent = root
end

-- Plaquinha em cima da cabeça: título escolhido (VIP sem título escolhido mostra "VIP")
function Customize.RefreshTag(player: Player)
	local data = getData(player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head") :: BasePart?
	if not data or not head then
		return
	end
	for _, name in { "NameTag", "VipTag" } do
		local old = head:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local titleId = data.Style.Title
	if titleId == "" and Registry.Economy.HasPass(player, "VIP") then
		titleId = "vip"
	end
	local title = Cosmetics.ById.title[titleId]
	local prestige = tonumber(data.Prestige) or 0
	local clanName = player:GetAttribute("ClanName") -- já filtrado pelo Roblox (Social)
	if typeof(clanName) == "string" then
		local clanGui = Instance.new("BillboardGui")
		clanGui.Name = "VipTag"
		clanGui.Size = UDim2.fromOffset(180, 22)
		clanGui.StudsOffset = Vector3.new(0, if title or prestige > 0 then 4.2 else 2.6, 0)
		clanGui.LightInfluence = 0
		clanGui.MaxDistance = 60
		local clanLabel = Instance.new("TextLabel")
		clanLabel.Size = UDim2.fromScale(1, 1)
		clanLabel.BackgroundTransparency = 1
		clanLabel.Font = Enum.Font.FredokaOne
		clanLabel.TextScaled = true
		clanLabel.Text = "[" .. clanName .. "]"
		clanLabel.TextColor3 = Color3.fromRGB(140, 230, 255)
		local clanStroke = Instance.new("UIStroke")
		clanStroke.Thickness = 2
		clanStroke.Color = Color3.fromRGB(25, 20, 35)
		clanStroke.Parent = clanLabel
		clanLabel.Parent = clanGui
		clanGui.Parent = head
	end
	if not title and prestige <= 0 then
		return
	end
	local stars = if prestige > 0 then ("\u{2B50}%d "):format(prestige) else "" -- estrela do prestígio
	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.fromOffset(200, 30)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 70
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = stars .. (if title then title.Name else "PRESTIGE")
	label.TextColor3 = if title then title.Color else Color3.fromRGB(255, 215, 80)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.fromRGB(25, 20, 35)
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = head
end

---------------------------------------------------------------------
-- Conquistas e situação de cada item
---------------------------------------------------------------------
local function stats(player: Player)
	local data = getData(player)
	local worldSet = {}
	local worlds = 0
	for _, world in Config.Worlds do
		if Registry.Worlds.IsUnlocked(player, world.Id) then
			worldSet[world.Id] = true
			worlds += 1
		end
	end
	local secret = 0
	for _, def in Critters.List do
		if def.Rarity == "Secret" and data.Index[def.Id] then
			secret = 1
			break
		end
	end
	return {
		Rebirths = math.max(data.Rebirths, tonumber(data.PeakRebirths) or 0), -- o prestígio não tira nada
		Steals = data.Steals,
		Hatched = data.Hatched,
		Defends = data.Defends,
		Index = data.Collected,
		Secret = secret,
		Worlds = worlds,
		VIP = if Registry.Economy.HasPass(player, "VIP") then 1 else 0,
		Premium = if isPremium(player) then 1 else 0,
		WorldSet = worldSet,
		Owned = data.Style.Owned,
	}
end

local KINDS = {
	theme = Cosmetics.Themes,
	decor = Cosmetics.Decor,
	trail = Cosmetics.Trails,
	title = Cosmetics.Titles,
}

function Customize.Status(player: Player, kind: string, id: string): string
	local item = Cosmetics.ById[kind] and Cosmetics.ById[kind][id]
	if not item or not getData(player) then
		return "locked"
	end
	return (Cosmetics.Status(kind, item, stats(player)))
end

-- Manda tudo para a tela "Style"
function Customize.Sync(player: Player)
	local data = getData(player)
	if not data or not player.Parent then
		return
	end
	local s = stats(player)
	local status = {}
	for kind, list in KINDS do
		status[kind] = {}
		for _, item in list do
			local state, text = Cosmetics.Status(kind, item, s)
			status[kind][item.Id] = { state, text }
		end
	end
	local decor = {}
	for spot = 1, Cosmetics.DecorSpots do
		decor[spot] = data.Style.Decor[tostring(spot)] or ""
	end
	Registry.Remotes.StyleEvent:FireClient(player, {
		Theme = data.Style.Theme,
		Decor = decor,
		Trail = data.Style.Trail,
		Title = data.Style.Title,
		Status = status,
	})
end

-- Tira o que o jogador não tem mais (ex.: o Premium acabou)
local function validate(player: Player)
	local data = getData(player)
	local style = data.Style
	local s = stats(player)
	local function ok(kind: string, id: string): boolean
		local item = Cosmetics.ById[kind][id]
		return item ~= nil and (Cosmetics.Status(kind, item, s)) == "owned"
	end
	if not ok("theme", style.Theme) then
		style.Theme = "classic"
	end
	if style.Trail ~= "" and not ok("trail", style.Trail) then
		style.Trail = ""
	end
	if style.Title ~= "" and not ok("title", style.Title) then
		style.Title = ""
	end
	for spot, id in style.Decor do
		if not ok("decor", id) then
			style.Decor[spot] = nil
		end
	end
end

function Customize.SetupPlayer(player: Player)
	local data = getData(player)
	local plot = Registry.Plots.Get(player)
	if not data then
		return
	end
	local style = if type(data.Style) == "table" then data.Style else {}
	style.Theme = if type(style.Theme) == "string" then style.Theme else "classic"
	style.Trail = if type(style.Trail) == "string" then style.Trail else ""
	style.Title = if type(style.Title) == "string" then style.Title else ""
	style.Owned = if type(style.Owned) == "table" then style.Owned else {}
	local decor = {}
	if type(style.Decor) == "table" then
		for spot, id in style.Decor do
			local n = tonumber(spot)
			if n and n >= 1 and n <= Cosmetics.DecorSpots and type(id) == "string" then
				decor[tostring(n)] = id
			end
		end
	end
	style.Decor = decor
	data.Style = style
	validate(player)
	if plot then
		Customize.ApplyTheme(plot, style.Theme)
		clearFolder(plot, "Decor")
		for spot, id in style.Decor do
			buildDecor(plot, tonumber(spot) :: number, id)
		end
	end
	player:SetAttribute("Premium", isPremium(player))
	Customize.LoadSettings(player)
end

---------------------------------------------------------------------
-- Configurações da tela (Parte 17): ficam salvas e valem em qualquer aparelho
---------------------------------------------------------------------
local SETTING_DEFAULTS = { LowGfx = false, OtherPets = true, MoneyPops = true, Sfx = 1, Shake = true, Music = true } -- v26: música

local function publishSettings(player: Player)
	local data = getData(player)
	if data then
		player:SetAttribute("Settings", HttpService:JSONEncode(data.Settings))
	end
end

function Customize.SaveSettings(player: Player, incoming: any)
	local data = getData(player)
	if not data or type(incoming) ~= "table" then
		return
	end
	local clean = {}
	for key, default in SETTING_DEFAULTS do
		local value = incoming[key]
		if type(default) == "boolean" then
			clean[key] = if type(value) == "boolean" then value else default
		else
			local number = tonumber(value)
			clean[key] = if number == 0 or number == 0.5 or number == 1 then number else default
		end
	end
	data.Settings = clean
	publishSettings(player)
end

function Customize.LoadSettings(player: Player)
	local data = getData(player)
	local saved = if type(data.Settings) == "table" then data.Settings else {}
	Customize.SaveSettings(player, saved)
end

function Customize.OnCharacter(player: Player)
	applyTrail(player)
	Customize.RefreshTag(player)
end

---------------------------------------------------------------------
-- Ações da tela "Style"
---------------------------------------------------------------------
function Customize.Handle(player: Player, action: string, argument: any)
	local data = getData(player)
	local Remotes = Registry.Remotes
	if not data then
		return
	end
	local style = data.Style
	if action == "StyleSync" then
		Customize.Sync(player)
		return
	elseif action == "SetTheme" and typeof(argument) == "string" then
		if Customize.Status(player, "theme", argument) ~= "owned" then
			Remotes.Notify(player, "This theme is locked. Unlock its world first!", "warning")
			return
		end
		style.Theme = argument
		local plot = Registry.Plots.Get(player)
		if plot then
			Customize.ApplyTheme(plot, argument)
		end
		Remotes.Notify(player, Cosmetics.ById.theme[argument].Name .. " theme applied to your base!", "success")
		Remotes.Effect(player, "Purchase", "Rare")
	elseif action == "BuyStyle" and type(argument) == "table" then
		local kind, id = argument.Kind, argument.Id
		if (kind ~= "decor" and kind ~= "trail") or type(id) ~= "string" then
			return
		end
		local item = Cosmetics.ById[kind][id]
		if not item or Customize.Status(player, kind, id) ~= "buy" then
			return
		end
		if not Registry.Economy.TrySpend(player, item.Price, "Style") then
			Remotes.Notify(player, "Not enough cash! You need " .. Format.Money(item.Price), "error")
			return
		end
		style.Owned[kind .. ":" .. id] = true
		if kind == "trail" then
			style.Trail = id
			applyTrail(player)
			Remotes.Notify(player, item.Name .. " trail bought and equipped!", "success")
		else
			Remotes.Notify(player, item.Name .. " bought! Pick a spot in your base for it.", "success")
		end
		Remotes.Effect(player, "Purchase", "Rare")
	elseif action == "PlaceDecor" and type(argument) == "table" then
		local spot = tonumber(argument.Spot)
		local id = argument.Id
		if not spot or spot % 1 ~= 0 or spot < 1 or spot > Cosmetics.DecorSpots or type(id) ~= "string" then
			return
		end
		if id ~= "" and Customize.Status(player, "decor", id) ~= "owned" then
			return
		end
		style.Decor[tostring(spot)] = if id == "" then nil else id
		local plot = Registry.Plots.Get(player)
		if plot then
			buildDecor(plot, spot, if id == "" then nil else id)
		end
	elseif action == "SetTrail" and typeof(argument) == "string" then
		if argument ~= "" and Customize.Status(player, "trail", argument) ~= "owned" then
			return
		end
		style.Trail = argument
		applyTrail(player)
	elseif action == "SetTitle" and typeof(argument) == "string" then
		if argument ~= "" and Customize.Status(player, "title", argument) ~= "owned" then
			return
		end
		style.Title = argument
		Customize.RefreshTag(player)
	else
		return
	end
	Customize.Sync(player)
end

-- (para os testes automáticos)
Customize.DecorBuilders = DECOR_BUILDERS
Customize.PropBuilders = PROP_BUILDERS
Customize.DecorSpots = DECOR_SPOTS

-- O 2º andar apareceu/sumiu: refaz os enfeites do tema no lugar certo
function Customize.RefreshProps(plot)
	Customize.ApplyTheme(plot, plot.Model:GetAttribute("Theme") or "classic")
end

-- Guarda as cores originais da base (para o tema "Classic" e para quando o dono sai)
function Customize.CaptureDefaults(plot)
	local saved = {}
	for _, list in themeParts(plot) do
		for _, part in list do
			saved[part] = { Color = part.Color, Material = part.Material }
		end
	end
	defaults[plot] = saved
end

function Customize.Init()
	for _, plot in Registry.Plots.All() do
		Customize.CaptureDefaults(plot)
	end
	-- Premium pode começar/acabar com o jogador dentro do jogo
	Players.PlayerMembershipChanged:Connect(function(player)
		if not getData(player) or not player:GetAttribute("Loaded") then
			return
		end
		player:SetAttribute("Premium", isPremium(player))
		validate(player)
		Registry.Economy.Sync(player)
		Customize.OnCharacter(player)
		Customize.Sync(player)
		if isPremium(player) and Config.PremiumBonus > 0 then
			Registry.Remotes.Notify(player, ("Thanks for being Premium! +%d%% cash."):format(math.floor(Config.PremiumBonus * 100)), "rare")
		end
	end)
end

return Customize
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="444">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[--[[
	Data (ModuleScript em ServerScriptService > Game)
	Salva e carrega o progresso de cada jogador com segurança:
	  • UpdateAsync com "trava de sessão": dois servidores nunca mexem nos dados do mesmo jogador
	  • várias tentativas quando o Roblox falha
	  • salva ao sair, a cada 60 s (Main) e quando o servidor fecha
	  • guarda os recibos de compra para nunca entregar (nem cobrar) duas vezes
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Registry = require(script.Parent.Registry)

local Data = {}

type Profile = {
	Data: any,
	CanSave: boolean,
	IsNew: boolean,
	Saving: boolean,
	Final: boolean,
}

local SESSION_TIMEOUT = 150 -- segundos: trava mais velha que isso = servidor antigo caiu
local MAX_RECEIPTS = 100

local profiles: { [Player]: Profile } = {}
local activeSaves = 0

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Data] DataStore indisponível:", result)
	end
end

local function defaultData()
	return {
		Cash = Config.StartCash,
		Rebirths = 0,
		SpeedLevel = 0,
		Critters = {}, -- { {Id, Slot, Mutation}, ... }
		Eggs = {}, -- ovos chocando { {Id, Slot, Left, Result = {Id, Mutation}}, ... }
		Pending = {}, -- esperando vaga: { {Id, Mutation} } ou { {Egg, Result} }
		Index = {},
		Collected = 0, -- quantos bichinhos diferentes já descobriu (leaderboard)
		Hatched = 0,
		Defends = 0, -- ladrões que você derrubou com o taco
		SlotUpgrades = 0, -- vagas compradas com dinheiro do jogo
		TrainedSpeed = 0, -- velocidade ganha na esteira de treino
		Codes = {}, -- códigos já usados
		Worlds = {}, -- mundos destravados { candy = true, ... } (o Meadow é sempre livre)
		PlayTime = 0, -- segundos jogados no total (escudo de novato)
		Inventory = {}, -- mochila: { {K = "k1", Id, M = mutação}, ... } (v7)
		Equipped = {}, -- chaves dos pets equipados (v7)
		NextKey = 0, -- contador das chaves da mochila (cada bichinho guardado tem uma chave única)
		Style = {}, -- personalização da base e do avatar (v7): Theme, Decor, Trail, Title, Owned
		BoostUntil = 0, -- 2x Cash dos códigos acaba nesse os.time()
		PaidShieldUntil = 0, -- v20: escudo comprado (Base Shield) acaba nesse os.time()
		StarterPack = false, -- v20: já comprou o Starter Pack (só 1 vez)
		Season = {}, -- temporada atual: Id, XP, níveis entregues (v8)
		SeasonPasses = {}, -- temporadas em que comprou o passe: { ["1"] = true } (v8)
		Settings = {}, -- configurações da tela (gráfico leve, sons...) (v8)
		Recipes = {}, -- receitas de híbridos descobertas (v9)
		Progress = {}, -- nível da conta, habilidades e classe (v10)
		Missions = {}, -- missões do dia (v10)
		Records = {}, -- recordes pessoais (v10)
		Achievements = {}, -- conquistas: { Id = os.time() } (v10)
		BadgesSent = {}, -- Badges do Roblox já entregues (v10)
		Prestige = 0, -- prestígios feitos (v10)
		PeakRebirths = 0, -- maior número de rebirths (o prestígio não tira as vagas) (v10)
		Likes = 0, -- curtidas que a sua base recebeu (v11)
		LikedToday = {}, -- bases que você curtiu hoje (v11)
		GiftsToday = {}, -- presentes dados hoje (v11)
		Clan = "", -- Id do seu clã (v11)
		InviteRewards = {}, -- prêmios de convite de hoje (v11)
		MerchantBuys = {}, -- compras no mercador nesta hora (v11)
		GlobalClaimed = {}, -- metas da comunidade já recebidas (v11)
		CreatorGift = false, -- já ganhou o Crowny (v11)
		Hunt = {}, -- caça aos ovos do dia (v13)
		Fishing = {}, -- pesca do dia (v13)
		Chests = {}, -- baús abertos hoje (v13)
		Digging = {}, -- fósseis achados hoje (v13)
		DailyDay = 0,
		Streak = 0,
		SpinDay = 0, -- v23: dia (os.time()/86400) do último giro grátis da roleta
		FunPrizes = {}, -- v27: baú de cada brincadeira dos mundos -> quando volta (os.time)
		LastOnline = 0,
		TotalEarned = 0,
		Steals = 0,
		TutorialDone = false,
		Receipts = {},
		Version = 5,
	}
end

local function reconcile(data: any)
	for key, value in defaultData() do
		if data[key] == nil then
			data[key] = value
		end
	end
	return data
end

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, item in value do
		copy[key] = deepCopy(item)
	end
	return copy
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function lockedByOther(value: any): boolean
	if type(value) ~= "table" or type(value.Session) ~= "table" then
		return false
	end
	local session = value.Session
	return session.JobId ~= game.JobId and os.time() - (tonumber(session.Time) or 0) < SESSION_TIMEOUT
end

function Data.Load(player: Player): Profile
	local loaded = false
	local result: any = nil
	local isNew = false

	if store then
		local attempts = 6
		for attempt = 1, attempts do
			if not player.Parent then
				break -- saiu enquanto carregava
			end
			local locked = false
			local ok, err = pcall(function()
				(store :: DataStore):UpdateAsync(keyFor(player), function(old)
					-- Outro servidor ainda está com esse jogador: espera (na última tentativa assume)
					if lockedByOther(old) and attempt < attempts then
						locked = true
						return nil
					end
					locked = false
					isNew = type(old) ~= "table"
					if type(old) == "table" and old.PlayTime == nil and (tonumber(old.TotalEarned) or 0) > 0 then
						old.PlayTime = 3600 -- quem já jogava antes da v6 não é mais novato
					end
					if type(old) == "table" and old.TutorialDone == nil then
						-- save antigo (antes do tutorial existir): quem já jogou não refaz o tutorial
						old.TutorialDone = (tonumber(old.TotalEarned) or 0) > 0 or (tonumber(old.Rebirths) or 0) > 0
					end
					local data = reconcile(if type(old) == "table" then old else defaultData())
					data.Session = { JobId = game.JobId, Time = os.time() }
					result = data
					return data, { player.UserId }
				end)
			end)
			if ok and not locked then
				loaded = true
				break
			end
			if not ok then
				warn(("[Data] Falha ao carregar %s (tentativa %d): %s"):format(player.Name, attempt, tostring(err)))
				if RunService:IsStudio() then
					break -- no Studio sem acesso à API não adianta insistir
				end
			end
			task.wait(if locked then 3 else 2)
		end
	end

	local profile: Profile = {
		Data = if loaded and result then result else defaultData(),
		CanSave = loaded,
		IsNew = if loaded then isNew else true,
		Saving = false,
		Final = false,
	}
	profiles[player] = profile

	if not loaded then
		warn("[Data] O progresso de " .. player.Name .. " NÃO será salvo nesta sessão.")
		if RunService:IsStudio() then
			task.delay(4, function()
				local Remotes = Registry.Remotes
				if Remotes and player.Parent then
					Remotes.Notify(player, "Studio: saving is OFF. Publish and enable 'Studio Access to API Services' to test saving.", "warning")
				end
			end)
		end
	end
	return profile
end

function Data.Get(player: Player): Profile?
	return profiles[player]
end

-- Quantos saves estão em andamento (o servidor espera eles terminarem antes de fechar)
function Data.ActiveSaves(): number
	return activeSaves
end

-- isFinal = true quando o jogador está saindo (libera a trava e não salva mais nada dele)
function Data.Save(player: Player, isFinal: boolean?): boolean
	local profile = profiles[player]
	if not profile or not profile.CanSave or not store then
		return false
	end
	activeSaves += 1
	local waited = 0
	local limit = if isFinal then 30 else 15
	while profile.Saving and waited < limit do
		waited += task.wait(0.1)
	end
	-- nunca dois saves do mesmo jogador ao mesmo tempo: se o outro ainda não acabou, este desiste
	-- (o save da saída espera mais e segue; o número SaveSeq impede o save velho de apagar o novo)
	if profile.Final or not profile.CanSave or (profile.Saving and not isFinal) then
		activeSaves -= 1
		return false
	end
	profile.Saving = true
	if isFinal then
		profile.Final = true
	end

	-- Só atualiza a lista de bichinhos e ovos depois que eles já foram colocados na base
	local critterService = Registry.CritterService
	if critterService and player:GetAttribute("Loaded") then
		local list = critterService.GetSaveList(player)
		if list then
			profile.Data.Critters = list
		end
		local eggs = critterService.GetEggSaveList(player)
		if eggs then
			profile.Data.Eggs = eggs
		end
	end
	-- só marca "online agora" depois de carregar (senão o dinheiro offline e os ovos se perdem)
	if player:GetAttribute("Loaded") then
		profile.Data.LastOnline = os.time()
	end
	-- "foto" dos dados agora; mudanças durante a espera entram no próximo save
	profile.Data.SaveSeq = (tonumber(profile.Data.SaveSeq) or 0) + 1
	local snapshot = deepCopy(profile.Data)

	local success = false
	local lostLock = false
	for attempt = 1, if isFinal then 5 else 3 do
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(keyFor(player), function(old)
				if lockedByOther(old) then
					lostLock = true
					return nil
				end
				lostLock = false
				if type(old) == "table" and (tonumber(old.SaveSeq) or 0) > snapshot.SaveSeq then
					return nil -- já tem um save mais novo guardado: não volta no tempo
				end
				snapshot.Session = if isFinal then nil else { JobId = game.JobId, Time = os.time() }
				return snapshot, { player.UserId }
			end)
		end)
		if ok then
			success = not lostLock
			break
		end
		warn(("[Data] Falha ao salvar %s (tentativa %d): %s"):format(player.Name, attempt, tostring(err)))
		task.wait(1)
	end

	if lostLock then
		-- Outro servidor assumiu os dados: este servidor para de salvar para não estragar nada
		warn("[Data] " .. player.Name .. " foi carregado em outro servidor; este servidor não salva mais.")
		profile.CanSave = false
		if player.Parent and not isFinal then
			player:Kick("Your progress was loaded in another server. Please rejoin!")
		end
	end

	profile.Saving = false
	activeSaves -= 1
	return success
end

function Data.HasReceipt(profile: Profile, purchaseId: string): boolean
	return table.find(profile.Data.Receipts, purchaseId) ~= nil
end

function Data.AddReceipt(profile: Profile, purchaseId: string)
	local receipts = profile.Data.Receipts
	table.insert(receipts, purchaseId)
	while #receipts > MAX_RECEIPTS do
		table.remove(receipts, 1)
	end
end

function Data.Remove(player: Player)
	profiles[player] = nil
end

return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="445">
        <Properties>
          <string name="Name">Discoveries</string>
          <string name="Source"><![CDATA[--[[
	Discoveries (ModuleScript em ServerScriptService > Game)
	Parte 21: "DESCOBERTO POR" — o primeiro jogador do MUNDO INTEIRO a chocar cada bichinho Secret
	fica com o nome no Índice para sempre.
	  • Tudo numa chave só do DataStore "Discoveries_v1" (poucos Secrets = leitura barata)
	  • UpdateAsync: se dois servidores tentarem ao mesmo tempo, só o primeiro ganha (o outro vê que já tem dono)
	  • As telas leem o atributo "Discoveries" do ReplicatedStorage (texto JSON), atualizado a cada 5 min
	No Studio sem "API Services" ligado o DataStore falha: aí vale só para o servidor atual (sem erro).
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Critters = require(ReplicatedStorage.Shared.Critters)
local Registry = require(script.Parent.Registry)

local Discoveries = {}

local KEY = "SecretFirsts"
type Entry = { N: string, U: number, T: number }
local cache: { [string]: Entry } = {}
local claiming: { [string]: boolean } = {}
local store: DataStore? = nil

local function publish()
	local ok, json = pcall(function()
		return HttpService:JSONEncode(cache)
	end)
	if ok then
		ReplicatedStorage:SetAttribute("Discoveries", json)
	end
end

local function merge(saved: any)
	if type(saved) ~= "table" then
		return
	end
	for id, entry in saved do
		if type(id) == "string" and Critters.ById[id] and type(entry) == "table" and type(entry.N) == "string" then
			cache[id] = { N = string.sub(entry.N, 1, 40), U = tonumber(entry.U) or 0, T = tonumber(entry.T) or 0 }
		end
	end
end

local function refresh()
	if not store then
		return
	end
	local ok, saved = pcall(function()
		return (store :: DataStore):GetAsync(KEY)
	end)
	if ok then
		merge(saved)
		publish()
	end
end

-- Quem descobriu primeiro (ou nil)
function Discoveries.Get(critterId: string): Entry?
	return cache[critterId]
end

-- Chamado quando alguém choca um Secret
function Discoveries.Claim(player: Player, critterId: string)
	if cache[critterId] or claiming[critterId] then
		return
	end
	local def = Critters.ById[critterId]
	if not def then
		return
	end
	claiming[critterId] = true
	local mine: Entry = { N = player.DisplayName, U = player.UserId, T = os.time() }
	local won = false
	if store then
		local ok = pcall(function()
			(store :: DataStore):UpdateAsync(KEY, function(saved)
				saved = if type(saved) == "table" then saved else {}
				if saved[critterId] then
					merge(saved) -- outro servidor chegou antes
					won = false
					return nil -- não muda nada
				end
				saved[critterId] = mine
				won = true
				return saved
			end)
		end)
		if not ok then
			won = false
		end
	else
		won = true
	end
	if won then
		cache[critterId] = mine
	end
	claiming[critterId] = nil
	publish()
	if won and player.Parent then
		Registry.Remotes.NotifyAll(("WORLD FIRST! %s is the first player EVER to discover %s!"):format(player.DisplayName, def.Name), "rare")
		Registry.Remotes.Effect(player, "WorldFirst", def.Name)
	end
end

function Discoveries.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("Discoveries_v1")
	end)
	store = if ok then result else nil
	publish()
	task.spawn(function()
		while true do
			local ok, err = pcall(function()
				refresh()
			end)
			if not ok then
				warn("[Discoveries] loop error:", err)
			end
			task.wait(5 * 60)
		end
	end)
end

return Discoveries
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="446">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--[[
	Economy (ModuleScript em ServerScriptService > Game)
	Dinheiro, renda por segundo, loja de velocidade, vagas, esteira de treino, rebirth,
	bônus (índice, amigos, grupo, VIP), recompensa diária, dinheiro offline, códigos,
	game passes e pedidos que vêm da tela do jogador.
	Todo dinheiro muda SÓ aqui no servidor.
]]

local GroupService = game:GetService("GroupService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Critters = require(ReplicatedStorage.Shared.Critters)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local Economy = {}

local passes: { [Player]: { [string]: boolean } } = {}
local friendBonus: { [Player]: number } = {}
local groupMember: { [Player]: boolean } = {}
local indexCount: { [Player]: number } = {}
local friendCache: { [string]: boolean } = {}
local lastRequest: { [Player]: number } = {}
local trainTime: { [Player]: number } = {}
local lastGroupCheck: { [Player]: number } = {}
local GROUP_RECHECK_COOLDOWN = 6 -- segundos entre uma conferência do grupo e outra (botão JOIN)
local ALLOWED_BEFORE_LOAD: { [string]: boolean } = { GetIndex = true }

local function track(name: string, ...)
	local analytics = Registry.Analytics
	if analytics and analytics[name] then
		pcall(analytics[name], ...)
	end
end

local function getData(player: Player): any
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

function Economy.HasPass(player: Player, name: string): boolean
	local owned = passes[player]
	return owned ~= nil and owned[name] == true
end

function Economy.GetRebirths(player: Player): number
	local data = getData(player)
	return if data then data.Rebirths else 0
end

-- Rebirths que contam para vagas e esteira: o prestígio zera os rebirths mas não tira vagas
function Economy.GetPeakRebirths(player: Player): number
	local data = getData(player)
	if not data then
		return 0
	end
	return math.max(data.Rebirths, tonumber(data.PeakRebirths) or 0)
end

function Economy.GetSlotCount(player: Player): number
	local data = getData(player)
	local bought = if data then data.SlotUpgrades else 0
	return Config.SlotCount(Economy.GetPeakRebirths(player), bought, Economy.HasPass(player, "MoreSlots"))
end

function Economy.GetMultiplier(player: Player): number
	local data = getData(player)
	if not data then
		return 1
	end
	local multiplier = 1 + data.Rebirths * Config.RebirthIncomeBonus
	local progress = Registry.Progress
	if progress then
		multiplier *= progress.PrestigeMultiplier(player) -- prestígio: +100% cada, para sempre
	end
	local social = Registry.Social
	if social then
		multiplier *= 1 + social.ClanBonus(player) -- colegas de clã no servidor (máx. +10%)
	end
	multiplier *= 1 + (indexCount[player] or 0) * Config.IndexBonusPerCritter
	multiplier *= 1 + (friendBonus[player] or 0) + (if groupMember[player] then Config.GroupBonus else 0)
	if Economy.HasPass(player, "VIP") then
		multiplier *= 1 + Config.VipIncomeBonus
	end
	if Economy.HasPass(player, "DoubleCash") then
		multiplier *= 2
	end
	local fairness = Registry.Fairness
	if fairness then
		multiplier *= fairness.IncomeMultiplier(player)
	end
	-- pets equipados (+até 30%), Roblox Premium (+10%) e 2x Cash dos códigos
	local pets = Registry.Pets
	if pets then
		multiplier *= 1 + pets.Bonus(player)
	end
	if Config.PremiumBonus > 0 and player.MembershipType == Enum.MembershipType.Premium then
		multiplier *= 1 + Config.PremiumBonus
	end
	if (tonumber(data.BoostUntil) or 0) > os.time() then
		multiplier *= 2
	end
	return multiplier
end

function Economy.GetIncome(player: Player): number
	return Registry.CritterService.GetBaseIncome(player) * Economy.GetMultiplier(player)
end

-- "Força" do jogador: renda da base + o que está guardado na mochila.
-- A regra "sem covardia" e o bônus de azarão usam isto (guardar tudo na mochila não engana ninguém).
function Economy.GetPower(player: Player): number
	local pets = Registry.Pets
	local bag = if pets then pets.BagIncome(player) else 0
	return (Registry.CritterService.GetBaseIncome(player) + bag) * Economy.GetMultiplier(player)
end

function Economy.Sync(player: Player)
	local data = getData(player)
	if not data then
		return
	end
	player:SetAttribute("Cash", data.Cash)
	player:SetAttribute("Rebirths", data.Rebirths)
	player:SetAttribute("SpeedLevel", data.SpeedLevel)
	player:SetAttribute("Slots", Economy.GetSlotCount(player))
	player:SetAttribute("Multiplier", Economy.GetMultiplier(player))
	player:SetAttribute("IndexCount", indexCount[player] or 0)
	player:SetAttribute("FriendBonus", friendBonus[player] or 0)
	player:SetAttribute("GroupBonus", groupMember[player] == true)
	player:SetAttribute("Steals", data.Steals)
	player:SetAttribute("SlotUpgrades", data.SlotUpgrades)
	player:SetAttribute("TrainedSpeed", data.TrainedSpeed)
	player:SetAttribute("TrainCap", Config.TreadmillCap(Economy.GetPeakRebirths(player)))
	player:SetAttribute("PeakRebirths", Economy.GetPeakRebirths(player))
	player:SetAttribute("Prestige", tonumber(data.Prestige) or 0)
	player:SetAttribute("Hatched", data.Hatched)
	player:SetAttribute("Defends", data.Defends)
	player:SetAttribute("BoostUntil", data.BoostUntil)
	player:SetAttribute("StarterPack", data.StarterPack == true)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		local cash = stats:FindFirstChild("Cash") :: StringValue?
		local steals = stats:FindFirstChild("Steals") :: IntValue?
		local rebirths = stats:FindFirstChild("Rebirths") :: IntValue?
		if cash then
			cash.Value = Format.Money(data.Cash)
		end
		if steals then
			steals.Value = data.Steals
		end
		if rebirths then
			rebirths.Value = data.Rebirths
		end
	end
end

-- earned = true quando é dinheiro "ganho" (conta para o leaderboard Top Earners)
-- kind = de onde veio (vai para o Analytics: "Collect", "Sell", "Daily"...)
function Economy.AddCash(player: Player, amount: number, earned: boolean?, kind: string?)
	local data = getData(player)
	if not data or amount ~= amount or amount <= 0 or amount == math.huge then
		return
	end
	data.Cash += amount
	if earned then
		data.TotalEarned += amount
	end
	Economy.Sync(player)
	if kind then
		track("CashSource", player, amount, kind)
	end
end

function Economy.TrySpend(player: Player, amount: number, kind: string?): boolean
	local data = getData(player)
	if not data or amount ~= amount or amount < 0 or data.Cash < amount then
		return false
	end
	data.Cash -= amount
	Economy.Sync(player)
	if kind then
		track("CashSink", player, amount, kind)
	end
	return true
end

function Economy.AddHatch(player: Player)
	local data = getData(player)
	if data then
		data.Hatched += 1
		player:SetAttribute("Hatched", data.Hatched)
	end
end

-- Você derrubou um ladrão com o taco e seu bichinho voltou
function Economy.AddDefense(player: Player, thief: Player?)
	local data = getData(player)
	if data then
		data.Defends += 1
		Economy.SeasonXP(player, "Defend", thief)
	end
end

-- XP da temporada (o Season pode não existir nos testes)
function Economy.SeasonXP(player: Player, reason: string, other: Player?)
	local progress = Registry.Progress
	if progress then
		progress.Event(player, reason) -- missões diárias e recordes
	end
	if reason == "Hatch" and Registry.LiveEvents then
		Registry.LiveEvents.AddHatch(1) -- meta da comunidade
	end
	local season = Registry.Season
	if season then
		local Seasons = require(ReplicatedStorage.Shared.Seasons)
		season.AddXP(player, Seasons.XP[reason] or 0, reason, other)
	end
end

function Economy.AddSteal(player: Player)
	local data = getData(player)
	if not data then
		return
	end
	data.Steals += 1
	Economy.Sync(player)
end

function Economy.ApplySpeed(player: Player)
	local data = getData(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not data or not humanoid then
		return
	end
	local minigameSpeed = player:GetAttribute("MgSpeed")
	if player:GetAttribute("InMinigame") and typeof(minigameSpeed) == "number" then
		humanoid.WalkSpeed = minigameSpeed -- minigame: todo mundo igual (nada comprado ajuda)
		return
	end
	local trained = math.min(data.TrainedSpeed, Config.TreadmillCap(Economy.GetPeakRebirths(player)))
	local speed = Config.BaseWalkSpeed + data.SpeedLevel * Config.SpeedPerLevel + trained
	local progress = Registry.Progress
	if Economy.HasPass(player, "SpeedCoil") then
		speed += Config.SpeedCoilBonus
	end
	local fairness = Registry.Fairness
	if fairness then
		speed += fairness.SpeedBonus(player) -- vingança
	end
	if progress then
		speed *= progress.SpeedMultiplier(player) -- habilidade Speed
	end
	local mounts = Registry.Mounts
	if mounts and not Registry.CritterService.IsCarrying(player) then
		speed *= mounts.SpeedMultiplier(player) -- skate, kart ou montaria
	end
	if Registry.CritterService.IsCarrying(player) then
		-- habilidade Steal e classe Thief deixam carregar um pouco mais rápido (no máximo 95%)
		speed *= if progress then progress.CarryMultiplier(player, Config.CarrySpeedMultiplier) else Config.CarrySpeedMultiplier
	end
	humanoid.WalkSpeed = speed
end

-- Plaquinha em cima da cabeça (título e VIP): quem desenha é o Customize
function Economy.ApplyVipTag(player: Player)
	local customize = Registry.Customize
	if customize then
		customize.RefreshTag(player)
	end
end

function Economy.HasDiscovered(player: Player, critterId: string): boolean
	local data = getData(player)
	return data ~= nil and data.Index[critterId] == true
end

-- Índice (coleção): +2% de dinheiro por bichinho descoberto
function Economy.Discover(player: Player, critterId: string)
	local data = getData(player)
	if not data or data.Index[critterId] then
		return
	end
	data.Index[critterId] = true
	indexCount[player] = (indexCount[player] or 0) + 1
	data.Collected = indexCount[player]
	Economy.Sync(player)
	Registry.Remotes.IndexEvent:FireClient(player, data.Index)
	local def = Critters.ById[critterId]
	if def then
		Registry.Remotes.Notify(player, ("NEW! %s added to your Index (+%d%% cash)"):format(def.Name, math.floor(Config.IndexBonusPerCritter * 100)), "rare")
	end
end

---------------------------------------------------------------------
-- Amigos e grupo
---------------------------------------------------------------------
local function areFriends(a: Player, b: Player): boolean
	local low, high = math.min(a.UserId, b.UserId), math.max(a.UserId, b.UserId)
	local key = low .. ":" .. high
	if friendCache[key] == nil then
		local ok, result = pcall(function()
			return a:IsFriendsWithAsync(b.UserId)
		end)
		friendCache[key] = ok and result == true
	end
	return friendCache[key]
end

local function recalcFriends()
	local list = Players:GetPlayers()
	for _, player in list do
		local count = 0
		for _, other in list do
			if other ~= player and areFriends(player, other) then
				count += 1
			end
		end
		if player.Parent then
			friendBonus[player] = math.min(count * Config.FriendBonus, Config.MaxFriendBonus)
		end
		if getData(player) then
			Economy.Sync(player)
		end
	end
end

---------------------------------------------------------------------
-- Game passes
---------------------------------------------------------------------
local function onPassOwned(player: Player, name: string)
	passes[player] = passes[player] or {}
	passes[player][name] = true
	player:SetAttribute("Pass_" .. name, true)
	Economy.Sync(player)
	Economy.ApplySpeed(player)
	Economy.ApplyVipTag(player)
	if name == "MoreSlots" then
		local plot = Registry.Plots.Get(player)
		if plot then
			Registry.Plots.RefreshSlots(plot, Economy.GetSlotCount(player))
			Registry.CritterService.PlacePending(player)
		end
	end
end

---------------------------------------------------------------------
-- Entrada do jogador
---------------------------------------------------------------------
---------------------------------------------------------------------
-- Grupo "Critter Club Studios": quem está no grupo ganha +10% de dinheiro (Config.GroupBonus)
---------------------------------------------------------------------
-- Está no grupo? true/false (nil = o Roblox não respondeu agora)
-- GetGroupsAsync pergunta na hora (o IsInGroup guarda a resposta antiga), então quem entra
-- no grupo pelo botão JOIN da loja ganha o bônus sem precisar sair do jogo.
Economy.FetchInGroup = function(player: Player): boolean?
	if Config.GroupId <= 0 then
		return false
	end
	local ok, groups = pcall(function()
		return GroupService:GetGroupsAsync(player.UserId)
	end)
	if ok and type(groups) == "table" then
		for _, info in groups do
			if type(info) == "table" and info.Id == Config.GroupId then
				return true
			end
		end
		return false
	end
	local ok2, inGroup = pcall(function()
		return player:IsInGroupAsync(Config.GroupId)
	end)
	if ok2 then
		return inGroup == true
	end
	return nil
end

function Economy.IsGroupMember(player: Player): boolean
	return groupMember[player] == true
end

-- O jogador tocou em JOIN na loja: confere de novo (no máximo 1 vez a cada 6 segundos).
-- Devolve true se mudou alguma coisa.
function Economy.RecheckGroup(player: Player): boolean
	if Config.GroupId <= 0 or not getData(player) then
		return false
	end
	local now = os.clock()
	if lastGroupCheck[player] and now - lastGroupCheck[player] < GROUP_RECHECK_COOLDOWN then
		return false
	end
	lastGroupCheck[player] = now
	local inGroup = Economy.FetchInGroup(player)
	if inGroup == nil or not player.Parent then
		return false
	end
	local changed = (groupMember[player] == true) ~= inGroup
	groupMember[player] = inGroup
	if changed then
		Economy.Sync(player)
		if inGroup then
			Registry.Remotes.Notify(player, ("Welcome to the group! +%d%% cash is ON!"):format(math.floor(Config.GroupBonus * 100)), "success")
		end
	end
	return changed
end

function Economy.SetupPlayer(player: Player, profile)
	local data = profile.Data

	local count = 0
	for id in data.Index do
		if Critters.ById[id] then
			count += 1
		end
	end
	indexCount[player] = count
	data.Collected = count

	local owned = {}
	passes[player] = owned
	for name, id in Config.GamePasses do
		if id and id > 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
			end)
			if ok and owns then
				owned[name] = true
				player:SetAttribute("Pass_" .. name, true)
			end
		end
	end

	local inGroupResult = Economy.FetchInGroup(player) == true
	if not player.Parent then
		Economy.RemovePlayer(player)
		return
	end
	groupMember[player] = inGroupResult

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Parent = stats
	local steals = Instance.new("IntValue")
	steals.Name = "Steals"
	steals.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player

	Economy.Sync(player)
	Registry.Remotes.IndexEvent:FireClient(player, data.Index)

	task.spawn(function()
		recalcFriends()
		for _, other in Players:GetPlayers() do
			if other ~= player and areFriends(player, other) then
				Registry.Remotes.Notify(other, ("Your friend %s joined! +%d%% cash"):format(player.DisplayName, math.floor(Config.FriendBonus * 100)), "success")
			end
		end
	end)
end

-- Depois que os bichinhos salvos já estão na base
function Economy.AfterLoad(player: Player, profile)
	local data = profile.Data
	local Remotes = Registry.Remotes

	if not profile.IsNew and data.LastOnline > 0 then
		local elapsed = math.clamp(os.time() - data.LastOnline, 0, Config.OfflineMaxSeconds)
		local amount = math.floor(Economy.GetIncome(player) * elapsed * Config.OfflineRate)
		if amount > 0 then
			Economy.AddCash(player, amount, true, "Offline")
			Remotes.Popup(player, "Welcome back!", "Your critters made " .. Format.Money(amount) .. " while you were away!")
		end
	end

	local today = math.floor(os.time() / 86400)
	if data.DailyDay ~= today then
		if data.DailyDay == today - 1 then
			data.Streak = (data.Streak % #Config.DailyRewards) + 1
		else
			data.Streak = 1
		end
		data.DailyDay = today
		local reward = math.max(
			Config.DailyRewards[data.Streak] * (1 + Economy.GetPeakRebirths(player)),
			math.floor(Economy.GetIncome(player) * 60 * (Config.DailyIncomeMinutes[data.Streak] or 0))
		)
		if Economy.HasPass(player, "VIP") then
			reward *= 2
		end
		Economy.AddCash(player, reward, false, "Daily")
		-- Jogador novo vê o tutorial primeiro; o popup da recompensa só aparece para quem já jogou
		if not profile.IsNew then
			Remotes.Popup(player, "Daily Reward - Day " .. data.Streak .. "!", "+" .. Format.Money(reward) .. "\nCome back tomorrow for an even BIGGER reward!")
		end
	end
end

function Economy.RemovePlayer(player: Player)
	passes[player] = nil
	friendBonus[player] = nil
	groupMember[player] = nil
	lastGroupCheck[player] = nil
	indexCount[player] = nil
	lastRequest[player] = nil
	trainTime[player] = nil
	task.spawn(recalcFriends)
end

---------------------------------------------------------------------
-- Loja
---------------------------------------------------------------------
function Economy.BuySpeed(player: Player)
	local data = getData(player)
	if not data then
		return
	end
	if data.SpeedLevel >= Config.MaxSpeedLevel then
		Registry.Remotes.Notify(player, "Your speed is already MAX!", "info")
		return
	end
	local cost = Config.SpeedCost(data.SpeedLevel)
	if not Economy.TrySpend(player, cost, "Speed") then
		Registry.Remotes.Notify(player, "Not enough cash! You need " .. Format.Money(cost), "error")
		return
	end
	data.SpeedLevel += 1
	Economy.Sync(player)
	Economy.ApplySpeed(player)
	Registry.Remotes.Notify(player, "Speed upgraded!", "success")
	Registry.Remotes.Effect(player, "Purchase", "Common")
end

-- Rebirth: zera o dinheiro, mantém os bichinhos, dá bônus para sempre e libera critters novos
function Economy.Rebirth(player: Player)
	local data = getData(player)
	if not data then
		return
	end
	local cost = Config.RebirthCost(data.Rebirths)
	if data.Cash < cost then
		Registry.Remotes.Notify(player, "You need " .. Format.Money(cost) .. " to rebirth!", "error")
		return
	end

	track("CashSink", player, data.Cash, "Rebirth")
	data.Cash = 0
	data.Rebirths += 1
	local firstTime = data.Rebirths > (tonumber(data.PeakRebirths) or 0) -- depois do prestígio, refazer não conta de novo
	data.PeakRebirths = math.max(tonumber(data.PeakRebirths) or 0, data.Rebirths)
	track("Event", player, "Rebirth", data.Rebirths)
	local plot = Registry.Plots.Get(player)
	if plot then
		plot.Vault = 0
		Registry.Plots.RefreshSlots(plot, Economy.GetSlotCount(player))
	end
	Economy.Sync(player)
	Registry.CritterService.PlacePending(player)

	local unlocked = {}
	for _, def in Critters.List do
		if def.RebirthRequired == data.Rebirths then
			table.insert(unlocked, def.Name)
		end
	end
	Economy.ApplySpeed(player)
	local body = ("Rebirth bonus: x%g cash forever. Base slots: %d. Treadmill max: +%d speed."):format(
		1 + data.Rebirths * Config.RebirthIncomeBonus,
		Economy.GetSlotCount(player),
		Config.TreadmillCap(Economy.GetPeakRebirths(player))
	)
	if #unlocked > 0 then
		body ..= "\nUNLOCKED: " .. table.concat(unlocked, ", ") .. "!"
	end
	Registry.Remotes.Effect(player, "Rebirth")
	Registry.Remotes.Popup(player, "REBIRTH " .. data.Rebirths .. "!", body)
	if firstTime then
		Registry.Remotes.NotifyAll(("%s just REBIRTHED! (Rebirth %d)"):format(player.DisplayName, data.Rebirths), "rare")
		Economy.SeasonXP(player, "Rebirth")
	end
	task.spawn(Registry.Data.Save, player)
end

-- Comprar +1 vaga com dinheiro do jogo
function Economy.BuySlot(player: Player)
	local data = getData(player)
	if not data then
		return
	end
	local Remotes = Registry.Remotes
	local cost = Config.SlotUpgradeCosts[data.SlotUpgrades + 1]
	if not cost then
		Remotes.Notify(player, "You bought all slot upgrades! Rebirth for even more slots.", "info")
		return
	end
	if Economy.GetSlotCount(player) >= Config.MaxSlots then
		Remotes.Notify(player, "Your base already has the MAX slots!", "info")
		return
	end
	if not Economy.TrySpend(player, cost, "Slot") then
		Remotes.Notify(player, "Not enough cash! You need " .. Format.Money(cost), "error")
		return
	end
	Economy.GrantSlotUpgrade(player)
end

-- +1 vaga (comprada, ou de graça pelo painel de admin para testar o 2º andar)
function Economy.GrantSlotUpgrade(player: Player): boolean
	local data = getData(player)
	if not data or data.SlotUpgrades >= #Config.SlotUpgradeCosts then
		return false
	end
	data.SlotUpgrades += 1
	local plot = Registry.Plots.Get(player)
	if plot then
		Registry.Plots.RefreshSlots(plot, Economy.GetSlotCount(player))
	end
	Economy.Sync(player)
	Registry.CritterService.PlacePending(player)
	Registry.Remotes.Notify(player, ("+1 SLOT! Your base now has %d slots."):format(Economy.GetSlotCount(player)), "success")
	Registry.Remotes.Effect(player, "Purchase", "Rare")
	return true
end

-- Esteira de treino: chamado pelo Plots enquanto o jogador corre na esteira da própria base
function Economy.Train(player: Player, dt: number)
	local data = getData(player)
	if not data then
		return
	end
	local cap = Config.TreadmillCap(Economy.GetPeakRebirths(player))
	if data.TrainedSpeed >= cap then
		player:SetAttribute("TrainProgress", 1)
		return
	end
	local total = (trainTime[player] or 0) + dt
	if total >= Config.TreadmillSeconds then
		total -= Config.TreadmillSeconds
		data.TrainedSpeed += 1
		Economy.Sync(player)
		Economy.ApplySpeed(player)
		Registry.Remotes.Effect(player, "Train", data.TrainedSpeed)
		if data.TrainedSpeed >= cap then
			Registry.Remotes.Notify(player, ("Treadmill MAX (+%d speed)! Rebirth to train more."):format(cap), "rare")
		end
	end
	trainTime[player] = total
	player:SetAttribute("TrainProgress", total / Config.TreadmillSeconds)
end

function Economy.Init()
	-- Renda a cada segundo vai para o coletor da base
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(function()
				for _, player in Players:GetPlayers() do
					local plot = Registry.Plots.Get(player)
					if plot and getData(player) then
						local income = Economy.GetIncome(player)
						plot.Vault += income
						player:SetAttribute("Income", income)
						player:SetAttribute("Power", Economy.GetPower(player))
						player:SetAttribute("FreeSlots", Registry.Plots.FreeSlotCount(plot, Economy.GetSlotCount(player)))
					end
				end
			end)
			if not ok then
				warn("[Economy] loop error:", err)
			end
		end
	end)

	Registry.Remotes.RequestEvent.OnServerEvent:Connect(function(player: Player, action: any, argument: any)
		if typeof(action) ~= "string" then
			return
		end
		local t = os.clock()
		if t - (lastRequest[player] or 0) < 0.15 then
			return
		end
		lastRequest[player] = t
		-- nada de compras/códigos antes da base e dos dados terminarem de carregar
		if not player:GetAttribute("Loaded") and not ALLOWED_BEFORE_LOAD[action] then
			return
		end

		if action == "BuySpeed" then
			Economy.BuySpeed(player)
		elseif action == "Rebirth" then
			Economy.Rebirth(player)
		elseif action == "BuySlot" then
			Economy.BuySlot(player)
		elseif action == "UnlockWorld" and typeof(argument) == "string" then
			Registry.Worlds.Unlock(player, argument)
		elseif action == "TravelWorld" and typeof(argument) == "string" then
			Registry.Worlds.Travel(player, argument)
		elseif action == "CheckGroup" then
			Economy.RecheckGroup(player)
		elseif action == "PromptProduct" then
			Registry.Products.Prompt(player, argument)
		elseif action == "RedeemCode" then
			Registry.Codes.Redeem(player, argument)
		elseif action == "PetStore" then
			Registry.Pets.Store(player, argument)
		elseif action == "PetPlace" then
			Registry.Pets.Place(player, argument)
		elseif action == "PetEquip" then
			Registry.Pets.Equip(player, argument)
		elseif action == "PetUnequip" then
			Registry.Pets.Unequip(player, argument)
		elseif action == "PetEquipBest" then
			Registry.Pets.EquipBest(player)
		elseif action == "PetFuse" then
			Registry.Pets.Fuse(player, argument)
		elseif action == "PetSell" then
			Registry.Pets.Sell(player, argument)
		elseif action == "Mix" then
			Registry.Pets.Mix(player, argument)
		elseif action == "FeedAll" then
			Registry.CritterService.FeedAll(player, argument)
		elseif action == "Ride" then
			Registry.Mounts.Ride(player, argument)
		elseif action == "GiftClaim" then
			Registry.Retention.ClaimGift(player)
		elseif action == "SpinDaily" then
			Registry.Retention.Spin(player)
		elseif action == "FishCatch" then
			Registry.Explore.FishCatch(player, argument)
		elseif action == "MinigameJoin" then
			Registry.Minigames.Join(player)
		elseif action == "BattleMove" then
			Registry.Battle.Move(player, argument)
		elseif action == "Like" then
			Registry.Social.Like(player, argument)
		elseif action == "Visit" then
			Registry.Social.Visit(player, argument)
		elseif action == "Gift" then
			Registry.Social.GiftOffer(player, argument)
		elseif action == "GiftAnswer" then
			Registry.Social.GiftAnswer(player, argument)
		elseif action == "ClanCreate" then
			task.spawn(Registry.Social.ClanCreate, player, argument) -- o filtro de texto demora um pouco
		elseif action == "ClanInvite" then
			Registry.Social.ClanInvite(player, argument)
		elseif action == "ClanAnswer" then
			task.spawn(Registry.Social.ClanAnswer, player, argument)
		elseif action == "ClanLeave" then
			task.spawn(Registry.Social.ClanLeave, player)
		elseif action == "SocialSync" then
			Registry.Social.Sync(player)
		elseif action == "MerchantBuy" then
			Registry.LiveEvents.MerchantBuy(player, argument)
		elseif action == "Vote" then
			Registry.LiveEvents.Vote(player, argument)
		elseif action == "SkillUp" then
			Registry.Progress.SkillUp(player, argument)
		elseif action == "SkillReset" then
			Registry.Progress.SkillReset(player)
		elseif action == "SetClass" then
			Registry.Progress.SetClass(player, argument)
		elseif action == "Prestige" then
			Registry.Progress.Prestige(player)
		elseif action == "QuestSwap" then
			Registry.Progress.Swap(player, argument)
		elseif action == "ProgressSync" then
			Registry.Progress.Sync(player)
		elseif action == "SaveSettings" then
			Registry.Customize.SaveSettings(player, argument)
		elseif action == "SeasonSync" then
			Registry.Season.Sync(player)
		elseif action == "InventorySync" then
			Registry.Pets.Sync(player)
		elseif action == "StyleSync" or action == "SetTheme" or action == "BuyStyle" or action == "PlaceDecor" or action == "SetTrail" or action == "SetTitle" then
			Registry.Customize.Handle(player, action, argument)
		elseif action == "GetIndex" then
			local data = getData(player)
			if data then
				Registry.Remotes.IndexEvent:FireClient(player, data.Index)
			end
		elseif action == "SkipTutorial" then
			Registry.Tutorial.Finish(player, true)
		elseif action == "Admin" then
			Registry.Admin.Handle(player, argument)
		end
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
		if not purchased then
			return
		end
		for name, id in Config.GamePasses do
			if id and id > 0 and id == passId then
				-- confere com o Roblox antes de liberar (se o Roblox estiver fora do ar, confia no evento do servidor)
				task.spawn(function()
					local owns = true
					for attempt = 1, 2 do
						local ok, result = pcall(function()
							return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
						end)
						owns = not ok or result == true
						if owns then
							break
						end
						task.wait(2)
					end
					if owns and player.Parent then
						onPassOwned(player, name)
						local info = Config.GamePassInfo[name]
						Registry.Remotes.Notify(player, "Thank you! " .. (if info then info.Name else name) .. " unlocked!", "rare")
					end
				end)
			end
		end
	end)
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="447">
        <Properties>
          <string name="Name">Environment</string>
          <string name="Source"><![CDATA[--[[
	Environment (ModuleScript em ServerScriptService > Game)
	Parte 21: DIA E NOITE + CLIMA do servidor.
	  • Dia e noite: um dia inteiro dura Config.DayLength (20 min). O relógio sai do horário do servidor,
	    então todo mundo vê a mesma hora. A tela de cada jogador muda o Lighting.ClockTime.
	  • Clima: Sun, Rain ou Snow, trocando a cada 4-6 minutos (Config.WeatherChances).
	  • Ovos de clima (Storm/Snowflake/Moon) só aparecem na esteira e só chocam no clima certo.
	O estado fica em atributos do Workspace: "Weather" e "Night" (as telas leem daí).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Registry = require(script.Parent.Registry)

local Environment = {}

local weather = "Sun"
local forcedNightUntil = 0

-- Hora do dia (0-24) num instante; o dia claro ocupa Config.DayFraction do ciclo
function Environment.ClockAt(serverTime: number): number
	local phase = (serverTime % Config.DayLength) / Config.DayLength
	local day = Config.DayFraction
	if phase < day then
		return 6.5 + phase / day * 11 -- 6:30 até 17:30
	end
	return (17.5 + (phase - day) / (1 - day) * 13) % 24 -- 17:30 até 6:30 do outro dia
end

function Environment.IsNight(): boolean
	if os.clock() < forcedNightUntil then
		return true
	end
	local clock = Environment.ClockAt(workspace:GetServerTimeNow())
	return clock >= 18.5 or clock < 5.5
end

function Environment.Weather(): string
	return weather
end

-- "Rain", "Snow" ou "Night" está valendo agora?
function Environment.IsActive(condition: string): boolean
	if condition == "Night" then
		return Environment.IsNight()
	end
	if condition == "Weekly" then -- v26: o Weekly Egg fica na esteira a semana inteira
		return require(game:GetService("ReplicatedStorage").Shared.Weekly).Current() ~= nil
	end
	return weather == condition
end

local MESSAGES = {
	Rain = "It's RAINING! Storm Eggs are on the conveyor!",
	Snow = "It's SNOWING! Snowflake Eggs are on the conveyor!",
	Sun = "The sun is back!",
}

function Environment.SetWeather(newWeather: string)
	if not Config.WeatherChances[newWeather] or newWeather == weather then
		return
	end
	weather = newWeather
	workspace:SetAttribute("Weather", weather)
	local remotes = Registry.Remotes
	if remotes then
		remotes.NotifyAll(MESSAGES[weather] or weather, if weather == "Sun" then "info" else "rare")
	end
end

-- Admin/teste: noite agora por 3 minutos
function Environment.ForceNight(seconds: number)
	forcedNightUntil = os.clock() + seconds
	workspace:SetAttribute("ForcedNight", workspace:GetServerTimeNow() + seconds)
end

local function rollWeather(): string
	local total = 0
	for _, chance in Config.WeatherChances do
		total += chance
	end
	local roll = math.random() * total
	for _, name in { "Sun", "Rain", "Snow" } do
		roll -= Config.WeatherChances[name] or 0
		if roll <= 0 then
			return name
		end
	end
	return "Sun"
end

function Environment.Init()
	workspace:SetAttribute("Weather", weather)
	workspace:SetAttribute("DayLength", Config.DayLength)
	workspace:SetAttribute("DayFraction", Config.DayFraction)
	-- troca de clima
	task.spawn(function()
		while true do
			task.wait(math.random(Config.WeatherMinutes[1] * 60, Config.WeatherMinutes[2] * 60))
			local ok, err = pcall(function()
				Environment.SetWeather(rollWeather())
			end)
			if not ok then
				warn("[Environment] loop error:", err)
			end
		end
	end)
	-- avisa quando começa a noite
	task.spawn(function()
		local wasNight = Environment.IsNight()
		while true do
			task.wait(2)
			local ok, err = pcall(function()
				local night = Environment.IsNight()
				workspace:SetAttribute("Night", night)
				if night ~= wasNight then
					wasNight = night
					local remotes = Registry.Remotes
					if remotes and night then
						remotes.NotifyAll("Night has fallen... Moon Eggs are on the conveyor!", "rare")
					end
				end
			end)
			if not ok then
				warn("[Environment] loop error:", err)
			end
		end
	end)
end

return Environment
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="448">
        <Properties>
          <string name="Name">Events</string>
          <string name="Source"><![CDATA[--[[
	Events (ModuleScript em ServerScriptService > Game)
	Eventos com hora marcada (a tela mostra a contagem regressiva):
	  • CHUVA DE OVOS: a cada 15 min caem ovos GRÁTIS do céu nos caminhos (2x chance de mutação)
	  • EVENTO DA SORTE: no meio do caminho entre duas chuvas, ovos raros e mutações ficam mais comuns
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Registry = require(script.Parent.Registry)

local Events = {}

local raining = false

local function now(): number
	return workspace:GetServerTimeNow()
end

-- Um ponto aleatório nos caminhos ao lado da esteira (fora das bases)
local function randomDropPoint(): Vector3
	local side = if math.random() < 0.5 then -1 else 1
	local x = math.random(-160, 160)
	local z = side * (8 + math.random() * 14)
	return Vector3.new(x, 0.2, z)
end

function Events.StartLucky(duration: number?, byName: string?)
	-- v20: se já está na sorte, o tempo SOMA (Lucky Potion comprada no meio do evento não perde nada)
	local current = tonumber(workspace:GetAttribute("LuckyUntil")) or 0
	local start = math.max(current, now())
	workspace:SetAttribute("LuckyUntil", start + (duration or Config.LuckyEventDuration))
	if byName then
		Registry.Remotes.NotifyAll(("%s used a LUCKY POTION! Rare eggs x%d and 2x mutations for EVERYONE!"):format(byName, Config.LuckyEggMultiplier), "rare")
	else
		Registry.Remotes.NotifyAll(("LUCKY EVENT! Rare eggs x%d and 2x mutations!"):format(Config.LuckyEggMultiplier), "rare")
	end
	Registry.Remotes.EffectAll("Lucky")
end

function Events.StartRain()
	if raining then
		return
	end
	raining = true
	workspace:SetAttribute("RainUntil", now() + Config.RainDuration)
	Registry.Remotes.NotifyAll("EGG RAIN! Free eggs are falling from the sky. CATCH THEM!", "rare")
	Registry.Remotes.EffectAll("Rain")
	task.spawn(function()
		local CritterService = Registry.CritterService
		local interval = Config.RainDuration / Config.RainCount
		-- ovos da chuva: sorteio próprio (Config.RainEggWeights), nunca Cosmic
		local total = 0
		for _, weight in Config.RainEggWeights do
			total += weight
		end
		for _ = 1, Config.RainCount do
			local roll = math.random() * total
			local chosen = Config.Eggs[1]
			for _, egg in Config.Eggs do
				local weight = Config.RainEggWeights[egg.Id] or 0
				if weight > 0 then
					roll -= weight
					if roll <= 0 then
						chosen = egg
						break
					end
				end
			end
			CritterService.SpawnRainEgg(chosen, randomDropPoint())
			task.wait(interval)
		end
		raining = false
	end)
end

function Events.Init()
	local start = now()
	workspace:SetAttribute("NextRain", start + Config.EventEvery)
	workspace:SetAttribute("NextLucky", start + Config.EventEvery / 2)

	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(function()
				local t = now()
				local nextRain = workspace:GetAttribute("NextRain") :: number
				if t >= nextRain then
					workspace:SetAttribute("NextRain", nextRain + Config.EventEvery)
					Events.StartRain()
				end
				local nextLucky = workspace:GetAttribute("NextLucky") :: number
				if t >= nextLucky then
					workspace:SetAttribute("NextLucky", nextLucky + Config.EventEvery)
					Events.StartLucky()
				end
			end)
			if not ok then
				warn("[Events] loop error:", err)
			end
		end
	end)
end

return Events
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="449">
        <Properties>
          <string name="Name">Explore</string>
          <string name="Source"><![CDATA[--[[
	Explore (ModuleScript em ServerScriptService > Game)
	Parte 22 (v13): EXPLORAÇÃO.
	  • ILHA SECRETA: abre no minuto 30 de cada hora (UTC, igual em todo servidor) por 5 minutos.
	    O portal brilha na praça do Ovo Gigante. Lá: baús grátis (1 vez por dia cada) e o santuário do Island Egg.
	  • CAÇA AOS OVOS: 10 ovos escondidos no Meadow por dia (os mesmos lugares para todo mundo no mesmo dia).
	    Cada um dá 1 min de renda; os 10 dão um ovo grande grátis.
	  • PESCA no laguinho (leste): toque na hora certa (3 vezes). Peixes = dinheiro; às vezes um tesouro.
	  • ESCAVAÇÃO: buracos de areia pelo mapa. Às vezes sai um FOSSIL EGG (grátis!).
	  • SUBMARINO no Coral Reef: desce até uma sala no fundo do mar com baús e o Deep Sea Egg.
	Tudo conferido aqui (distância, tempo, limite por dia); a tela só mostra.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local Explore = {}

local SETTINGS = Config.Explore

local function now(): number
	return workspace:GetServerTimeNow()
end

local function today(): number
	return math.floor(os.time() / 86400)
end

local function getData(player: Player): any
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function near(player: Player, position: Vector3, range: number): boolean
	local root = rootOf(player)
	return root ~= nil and (root.Position - position).Magnitude <= range
end

local function grant(player: Player, reward): string
	local codes = Registry.Codes
	if not codes then
		return ""
	end
	local ok, parts = pcall(codes.Grant, player, reward)
	return if ok and type(parts) == "table" then table.concat(parts, " + ") else ""
end

local function event(player: Player, kind: string)
	if Registry.Progress then
		Registry.Progress.Event(player, kind)
	end
end

local function canExplore(player: Player): boolean
	if not player:GetAttribute("Loaded") then
		return false
	end
	if player:GetAttribute("InMinigame") then
		Registry.Remotes.Notify(player, "Finish your minigame first!", "info")
		return false
	end
	if Registry.CritterService.IsCarrying(player) then
		Registry.Remotes.Notify(player, "Put down what you're carrying first!", "warning")
		return false
	end
	return true
end

local function sendTo(player: Player, cframe: CFrame)
	task.spawn(function()
		pcall(function()
			player:RequestStreamAroundAsync(cframe.Position, 4)
		end)
		local character = player.Character
		if character and character.Parent then
			character:PivotTo(cframe + Vector3.new(0, 3, 0))
		end
	end)
end

local function sendHome(player: Player)
	local plot = Registry.Plots.Get(player)
	if plot then
		player:SetAttribute("World", "meadow")
		sendTo(player, Registry.Plots.SpawnCFrame(plot))
	end
end

local function makePrompt(parent: Instance, action: string, object: string, hold: number, onTrigger: (Player) -> ())
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = hold
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Triggered:Connect(onTrigger)
	prompt.Parent = parent
	return prompt
end

local function pick(options: { any }): any
	local total = 0
	for _, option in options do
		total += option.Weight
	end
	local roll = math.random() * total
	for _, option in options do
		roll -= option.Weight
		if roll <= 0 then
			return option
		end
	end
	return options[1]
end

-- (definida lá embaixo, na parte da ilha)
local islandOpenNow: () -> boolean

---------------------------------------------------------------------
-- Baús (ilha e submarino): cada um 1 vez por dia por jogador
---------------------------------------------------------------------
-- Contra teleporte: a ilha tem que estar aberta; o submarino exige o Coral Reef liberado
local function placeAllowed(player: Player, key: string): boolean
	if string.sub(key, 1, 6) == "island" then
		return islandOpenNow()
	end
	return Registry.Worlds.IsUnlocked(player, "reef")
end

function Explore.OpenChest(player: Player, key: string, part: BasePart)
	local data = getData(player)
	if not data or not near(player, part.Position, 16) or not placeAllowed(player, key) then
		return
	end
	if type(data.Chests) ~= "table" or data.Chests.Day ~= today() then
		data.Chests = { Day = today(), Opened = {} }
	end
	if data.Chests.Opened[key] then
		Registry.Remotes.Notify(player, "You already opened this chest today. It refills tomorrow!", "info")
		return
	end
	data.Chests.Opened[key] = true
	local reward = pick(SETTINGS.ChestRewards)
	local text = grant(player, { Minutes = reward.Minutes, WorldEgg = reward.WorldEgg })
	Registry.Remotes.Notify(player, "TREASURE! +" .. text, "rare")
	Registry.Remotes.Effect(player, "Chest", part.Position)
end

-- Ovos especiais comprados com dinheiro do jogo (santuário da ilha / loja do submarino)
function Explore.BuyEgg(player: Player, eggId: string, part: BasePart)
	local egg = Config.EggById[eggId]
	if not egg or not near(player, part.Position, 16) or not placeAllowed(player, if eggId == "islandegg" then "island" else "sub") then
		return
	end
	if not Registry.CritterService.HasFreeSlot(player) then
		Registry.Remotes.Notify(player, "Your base is full! Make space first.", "warning")
		return
	end
	if not Registry.Economy.TrySpend(player, egg.Price, "Explore") then
		Registry.Remotes.Notify(player, "Not enough cash! You need " .. Format.Money(egg.Price), "error")
		return
	end
	Registry.CritterService.GrantEgg(player, eggId)
	Registry.Remotes.Notify(player, "You got a " .. egg.Name .. "! It flew to your base.", "rare")
	Registry.Remotes.Effect(player, "Purchase", "Rare")
end

---------------------------------------------------------------------
-- ILHA SECRETA
---------------------------------------------------------------------
local islandVisit: { [Player]: number } = {}
local portalTouch: { [Player]: number } = {}

local forcedUntil = 0

-- Admin/teste: abre a ilha agora por alguns minutos
function Explore.ForceIsland(seconds: number)
	forcedUntil = os.time() + seconds
end

local function islandOpen(time: number): boolean
	if time < forcedUntil then
		return true
	end
	local minute = math.floor((time % 3600) / 60)
	return minute >= SETTINGS.IslandMinute and minute < SETTINGS.IslandMinute + SETTINGS.IslandMinutes
end

islandOpenNow = function(): boolean
	return islandOpen(os.time())
end

local function islandFolder(): Instance?
	local map = workspace:FindFirstChild("Map")
	return map and map:FindFirstChild("SecretIsland")
end

local function onIsland(player: Player): boolean
	local root = rootOf(player)
	return root ~= nil and math.abs(root.Position.Z - 1000) < 200 and math.abs(root.Position.X) < 250
end

local function setPortal(open: boolean)
	local map = workspace:FindFirstChild("Map")
	local portal = map and map:FindFirstChild("SecretPortal")
	local disc = portal and portal:FindFirstChild("Disc") :: BasePart?
	if disc then
		disc.Transparency = if open then 0.25 else 1
		disc.CanTouch = open
	end
end

local function refreshIsland()
	local time = os.time()
	local open = islandOpen(time)
	local offset = now() - time
	local hour = math.floor(time / 3600)
	local opensAt = hour * 3600 + SETTINGS.IslandMinute * 60
	if time >= opensAt + SETTINGS.IslandMinutes * 60 then
		opensAt += 3600
	end
	local closesAt = if time < forcedUntil then forcedUntil else opensAt + SETTINGS.IslandMinutes * 60
	-- arredondado: o valor só muda quando a ilha muda (não reenviamos o atributo a cada segundo)
	workspace:SetAttribute("IslandUntil", if open then math.floor(closesAt + offset + 0.5) else nil)
	workspace:SetAttribute("IslandNext", if open then nil else math.floor(opensAt + offset + 0.5))
	if open ~= (workspace:GetAttribute("IslandOpen") == true) then
		workspace:SetAttribute("IslandOpen", open)
		setPortal(open)
		if open then
			Registry.Remotes.NotifyAll("The SECRET ISLAND is open for 5 minutes! Find the glowing portal next to the Giant Egg.", "rare")
			Registry.Remotes.EffectAll("IslandOpen")
		else
			for _, player in Players:GetPlayers() do
				if onIsland(player) then
					Registry.Remotes.Notify(player, "The Secret Island is sinking into the sea... back home you go!", "info")
					sendHome(player)
				end
			end
		end
	end
end

local function enterIsland(player: Player)
	if not islandOpen(os.time()) or os.clock() - (portalTouch[player] or 0) < 3 then
		return
	end
	portalTouch[player] = os.clock() -- o Touched dispara várias vezes: 1 tentativa a cada 3 s
	if not canExplore(player) then
		return
	end
	local island = islandFolder()
	local spawnPart = island and island:FindFirstChild("Spawn") :: BasePart?
	if not spawnPart then
		return
	end
	sendTo(player, spawnPart.CFrame)
	local hour = math.floor(os.time() / 3600)
	if islandVisit[player] ~= hour then
		islandVisit[player] = hour
		event(player, "Island")
		Registry.Remotes.Notify(player, "Welcome to the SECRET ISLAND! Open the chests and visit the shrine.", "rare")
	end
end

---------------------------------------------------------------------
-- CAÇA AOS OVOS
---------------------------------------------------------------------
-- lugares possíveis (x, z) no Meadow; o jogo acha o chão sozinho
local HUNT_SPOTS = {
	{ -280, -100 }, { -280, 100 }, { -230, -40 }, { -230, 40 }, { -170, -110 }, { -170, 110 }, { -130, -150 }, { -130, 150 },
	{ -60, -125 }, { -60, 125 }, { 0, -120 }, { 60, -120 }, { 60, 125 }, { 130, -150 }, { 130, 150 }, { 170, -110 },
	{ 170, 110 }, { 200, -60 }, { 200, 60 }, { 280, -100 }, { 280, 100 }, { 250, -62 }, { 250, 62 }, { 0, 60 },
	{ 80, 60 }, { -80, 60 }, { -80, -60 }, { 0, -60 }, { 80, -60 }, { -70, 175 }, { 100, 175 }, { -200, -170 },
}
local huntDay = -1
local huntEggs: { BasePart } = {}
local HUNT_COLORS = { Color3.fromRGB(255, 120, 170), Color3.fromRGB(120, 220, 255), Color3.fromRGB(255, 220, 80), Color3.fromRGB(150, 255, 130), Color3.fromRGB(200, 140, 255) }

local function huntState(player: Player): any
	local data = getData(player)
	if not data then
		return nil
	end
	if type(data.Hunt) ~= "table" or data.Hunt.Day ~= today() then
		data.Hunt = { Day = today(), Found = {} }
	end
	return data.Hunt
end

local function publishHunt(player: Player)
	local hunt = huntState(player)
	if not hunt then
		return
	end
	local found = {}
	for key in hunt.Found do
		table.insert(found, key)
	end
	player:SetAttribute("HuntFound", table.concat(found, ","))
	player:SetAttribute("HuntDay", hunt.Day)
end

function Explore.Hunt(player: Player, index: number)
	local egg = huntEggs[index]
	local hunt = huntState(player)
	if not egg or not hunt or not player:GetAttribute("Loaded") or not near(player, egg.Position, 14) then
		return
	end
	local key = tostring(index)
	if hunt.Found[key] then
		return
	end
	hunt.Found[key] = true
	local count = 0
	for _ in hunt.Found do
		count += 1
	end
	local text = grant(player, SETTINGS.HuntReward)
	event(player, "Hunt")
	Registry.Remotes.Effect(player, "HuntFound", { Position = egg.Position, Count = count })
	if count >= #huntEggs then
		local bonus = grant(player, SETTINGS.HuntBonus)
		event(player, "HuntDone")
		Registry.Remotes.Notify(player, ("ALL %d HUNT EGGS FOUND! Bonus: %s. New eggs tomorrow!"):format(#huntEggs, bonus), "rare")
	else
		Registry.Remotes.Notify(player, ("Hunt Egg %d/%d found! +%s"):format(count, #huntEggs, text), "success")
	end
	publishHunt(player)
end

local function buildHunt()
	local day = today()
	if day == huntDay then
		return
	end
	huntDay = day
	for _, egg in huntEggs do
		egg:Destroy()
	end
	huntEggs = {}
	local folder = workspace:FindFirstChild("HuntEggs") or Instance.new("Folder")
	folder.Name = "HuntEggs"
	folder.Parent = workspace
	local map = workspace:FindFirstChild("Map")
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = { folder }
	for _, name in { "Decor", "Plots", "Boundaries" } do
		local child = map and map:FindFirstChild(name)
		if child then
			table.insert(ignore, child)
		end
	end
	for _, name in { "ActiveCritters", "ClientPets", "Monsters" } do
		local child = workspace:FindFirstChild(name)
		if child then
			table.insert(ignore, child)
		end
	end
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(ignore, player.Character)
		end
	end
	params.FilterDescendantsInstances = ignore
	-- sorteio do dia (o mesmo em todos os servidores)
	local random = Random.new(day * 7777 + 1)
	local spots = table.clone(HUNT_SPOTS)
	for i = #spots, 2, -1 do
		local j = random:NextInteger(1, i)
		spots[i], spots[j] = spots[j], spots[i]
	end
	for index = 1, math.min(SETTINGS.HuntEggs, #spots) do
		local spot = spots[index]
		local hit = workspace:Raycast(Vector3.new(spot[1], 120, spot[2]), Vector3.new(0, -160, 0), params)
		local y = if hit then hit.Position.Y else 0
		local egg = Instance.new("Part")
		egg.Name = "HuntEgg" .. index
		egg.Shape = Enum.PartType.Ball
		egg.Size = Vector3.new(2, 2, 2)
		egg.Anchored = true
		egg.CanCollide = false
		egg.Material = Enum.Material.SmoothPlastic
		egg.Color = HUNT_COLORS[random:NextInteger(1, #HUNT_COLORS)]
		egg.CFrame = CFrame.new(spot[1], y + 1.5, spot[2])
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Scale = Vector3.new(1, 1.3, 1)
		mesh.Parent = egg
		local sparkle = Instance.new("Sparkles")
		sparkle.SparkleColor = Color3.fromRGB(255, 255, 200)
		sparkle.Parent = egg
		egg:SetAttribute("HuntIndex", index)
		egg:AddTag("Bob")
		egg:SetAttribute("BobHeight", 0.5)
		local prompt = makePrompt(egg, "Collect", "Hunt Egg", 0, function(player)
			Explore.Hunt(player, index)
		end)
		prompt.Name = "HuntPrompt"
		egg.Parent = folder
		huntEggs[index] = egg
	end
	workspace:SetAttribute("HuntCount", #huntEggs)
	for _, player in Players:GetPlayers() do
		publishHunt(player)
	end
end

---------------------------------------------------------------------
-- PESCA
---------------------------------------------------------------------
type Cast = { Id: number, At: number }
local casts: { [Player]: Cast } = {}
local lastCast: { [Player]: number } = {}
local nextCastId = 0

function Explore.FishStart(player: Player, spot: BasePart)
	local data = getData(player)
	if not data or not near(player, spot.Position, 16) or not canExplore(player) then
		return
	end
	if os.clock() - (lastCast[player] or 0) < SETTINGS.FishCooldown then
		return
	end
	if type(data.Fishing) ~= "table" or data.Fishing.Day ~= today() then
		data.Fishing = { Day = today(), Count = 0 }
	end
	if data.Fishing.Count >= SETTINGS.FishPerDay then
		Registry.Remotes.Notify(player, "The fish are sleeping! Come back tomorrow for more fishing.", "info")
		return
	end
	lastCast[player] = os.clock()
	nextCastId += 1
	casts[player] = { Id = nextCastId, At = os.clock() }
	Registry.Remotes.Effect(player, "FishStart", { Token = nextCastId })
end

-- A tela manda quantos toques certos (0 a 3); o servidor confere o tempo e sorteia o peixe
function Explore.FishCatch(player: Player, answer: any)
	local cast = casts[player]
	casts[player] = nil
	local data = getData(player)
	if not cast or not data or type(answer) ~= "table" or answer.Token ~= cast.Id then
		return
	end
	local elapsed = os.clock() - cast.At
	if elapsed < 1 or elapsed > 25 then
		Registry.Remotes.Notify(player, "The fish got away! Try again.", "info")
		return -- rápido demais (trapaça) ou demorou demais
	end
	local rawScore = tonumber(answer.Score) or 0
	if rawScore ~= rawScore then
		rawScore = 0 -- NaN (número inválido mandado por trapaça)
	end
	local score = math.clamp(math.floor(rawScore), 0, 3)
	if score == 0 then
		Registry.Remotes.Notify(player, "It got away! Try again.", "info")
		return
	end
	data.Fishing.Count += 1
	event(player, "Fish")
	local roll = math.random()
	local text
	if score == 3 and roll < 0.1 then
		text = "a TREASURE CHEST! +" .. grant(player, { WorldEgg = 1 })
	elseif score >= 2 and roll < 0.35 then
		text = "a BIG fish! +" .. grant(player, { Minutes = 1 })
	else
		text = "a fish! +" .. grant(player, { Minutes = 0.3 })
	end
	Registry.Remotes.Notify(player, "You caught " .. text, "success")
	Registry.Remotes.Effect(player, "FishCaught", score)
end

---------------------------------------------------------------------
-- ESCAVAÇÃO
---------------------------------------------------------------------
local DIGS_PER_DAY = 30

function Explore.Dig(player: Player, spot: BasePart)
	local data = getData(player)
	if not data or not near(player, spot.Position, 14) or not canExplore(player) then
		return
	end
	if type(data.Digging) ~= "table" or data.Digging.Day ~= today() then
		data.Digging = { Day = today(), Fossils = 0, Count = 0, Spots = {} }
	end
	local digging = data.Digging
	digging.Spots = if type(digging.Spots) == "table" then digging.Spots else {}
	digging.Count = tonumber(digging.Count) or 0
	-- o tempo de cada buraco fica SALVO (sair e entrar de novo não zera)
	local left = (tonumber(digging.Spots[spot.Name]) or -math.huge) + SETTINGS.DigCooldown - os.time()
	if left > 0 then
		Registry.Remotes.Notify(player, "You already dug here. Try another sand patch, or come back in " .. Format.Time(left) .. ".", "info")
		return
	end
	if digging.Count >= DIGS_PER_DAY then
		Registry.Remotes.Notify(player, "You're tired of digging today! Come back tomorrow.", "info")
		return
	end
	digging.Spots[spot.Name] = os.time()
	digging.Count += 1
	event(player, "Dig")
	Registry.Remotes.Effect(player, "Dig", spot.Position)
	local fossilsLeft = SETTINGS.FossilsPerDay - (tonumber(digging.Fossils) or 0)
	local roll = math.random()
	if roll < SETTINGS.FossilChance and fossilsLeft > 0 then
		digging.Fossils = (tonumber(digging.Fossils) or 0) + 1
		Registry.CritterService.GrantEgg(player, "fossilegg")
		event(player, "Fossil")
		Registry.Remotes.Notify(player, "WOW! You dug up a FOSSIL EGG! It went to your base.", "rare")
	elseif roll < 0.6 then
		Registry.Remotes.Notify(player, "You dug up some coins! +" .. grant(player, { Minutes = 0.5 }), "success")
	else
		Registry.Remotes.Notify(player, "Just dirt... try another sand patch!", "info")
	end
end

---------------------------------------------------------------------
-- SUBMARINO (Coral Reef)
---------------------------------------------------------------------
local function subRoom(): Instance?
	local map = workspace:FindFirstChild("Map")
	return map and map:FindFirstChild("Submarine")
end

local function dive(player: Player, dock: BasePart)
	if not near(player, dock.Position, 16) or not canExplore(player) then
		return
	end
	local room = subRoom()
	local spawnPart = room and room:FindFirstChild("Spawn") :: BasePart?
	if spawnPart then
		sendTo(player, spawnPart.CFrame)
		Registry.Remotes.Notify(player, "Welcome aboard! Open the chests and look for the Deep Sea Egg.", "rare")
	end
end

local function surface(player: Player)
	local target = Registry.Worlds.SpawnCFrame("reef")
	if target then
		sendTo(player, target)
	else
		sendHome(player)
	end
end

---------------------------------------------------------------------
function Explore.SetupPlayer(player: Player)
	publishHunt(player)
end

function Explore.RemovePlayer(player: Player)
	casts[player] = nil
	lastCast[player] = nil
	islandVisit[player] = nil
	portalTouch[player] = nil
end

function Explore.Init()
	Players.PlayerRemoving:Connect(Explore.RemovePlayer)
	task.spawn(function()
		local map = workspace:WaitForChild("Map")
		-- ilha secreta: portal, volta, santuário e baús
		local portal = map:WaitForChild("SecretPortal", 20)
		local disc = portal and portal:FindFirstChild("Disc")
		if disc and disc:IsA("BasePart") then
			disc.Touched:Connect(function(hit)
				local player = Players:GetPlayerFromCharacter(hit.Parent)
				if player then
					enterIsland(player)
				end
			end)
		end
		local island = map:FindFirstChild("SecretIsland")
		if island then
			local back = island:FindFirstChild("ReturnPortal")
			if back and back:IsA("BasePart") then
				makePrompt(back, "Go home", "Return portal", 0, sendHome)
			end
			local shrine = island:FindFirstChild("Shrine")
			if shrine and shrine:IsA("BasePart") then
				makePrompt(shrine, "Buy Island Egg", Format.Money(Config.EggById.islandegg.Price), 1, function(player)
					Explore.BuyEgg(player, "islandegg", shrine)
				end)
			end
			for _, child in island:GetChildren() do
				if child:IsA("BasePart") and string.match(child.Name, "^Chest%d+$") then
					makePrompt(child, "Open", "Treasure chest", 0.6, function(player)
						Explore.OpenChest(player, "island:" .. child.Name, child)
					end)
				end
			end
		end
		-- pesca
		local pond = map:FindFirstChild("FishingPond")
		local fishSpot = pond and pond:FindFirstChild("Spot")
		if fishSpot and fishSpot:IsA("BasePart") then
			makePrompt(fishSpot, "Fish", "Fishing pond", 0, function(player)
				Explore.FishStart(player, fishSpot)
			end)
		end
		-- escavação
		local digs = map:FindFirstChild("DigSpots")
		if digs then
			for _, spot in digs:GetChildren() do
				if spot:IsA("BasePart") then
					makePrompt(spot, "Dig", "Sand patch", 1.5, function(player)
						Explore.Dig(player, spot)
					end)
				end
			end
		end
		-- submarino
		local worlds = map:FindFirstChild("Worlds")
		local reef = worlds and worlds:FindFirstChild("reef")
		local dock = reef and reef:FindFirstChild("SubDock", true)
		if dock and dock:IsA("BasePart") then
			makePrompt(dock, "Dive", "Submarine", 0.5, function(player)
				dive(player, dock)
			end)
		end
		local room = map:FindFirstChild("Submarine")
		if room then
			local hatch = room:FindFirstChild("Hatch")
			if hatch and hatch:IsA("BasePart") then
				makePrompt(hatch, "Surface", "Hatch", 0, surface)
			end
			local shop = room:FindFirstChild("Shop")
			if shop and shop:IsA("BasePart") then
				makePrompt(shop, "Buy Deep Sea Egg", Format.Money(Config.EggById.deepegg.Price), 1, function(player)
					Explore.BuyEgg(player, "deepegg", shop)
				end)
			end
			for _, child in room:GetChildren() do
				if child:IsA("BasePart") and string.match(child.Name, "^Chest%d+$") then
					makePrompt(child, "Open", "Treasure chest", 0.6, function(player)
						Explore.OpenChest(player, "sub:" .. child.Name, child)
					end)
				end
			end
		end
		buildHunt()
		setPortal(false)
		refreshIsland()
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(function()
				refreshIsland()
				if today() ~= huntDay and huntDay ~= -1 then
					buildHunt() -- virou o dia: ovos novos
				end
			end)
			if not ok then
				warn("[Explore] loop error:", err)
			end
		end
	end)
end

return Explore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="450">
        <Properties>
          <string name="Name">Fairness</string>
          <string name="Source"><![CDATA[--[[
	Fairness (ModuleScript em ServerScriptService > Game)
	Deixa o jogo justo para quem está começando (jogador novo que é roubado logo de cara desiste):
	  • ESCUDO DE NOVATO: ninguém rouba a base de quem tem menos de 10 min de jogo (tempo total, salvo)
	  • VINGANÇA: quem é roubado ganha +velocidade por 30 s e vê o ladrão brilhando através das paredes
	  • AZARÃO: quem ganha bem menos que o melhor jogador do servidor ganha +25% de dinheiro
	  • SEM COVARDIA: quem ganha 20x mais não pode roubar de quem é muito mais fraco
	Os números ficam em Config (NewbieShieldSeconds, RevengeSeconds, UnderdogBonus, BullyIncomeRatio...).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local Fairness = {}

local underdog: { [Player]: boolean } = {}
local shieldAnnounced: { [Player]: boolean } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function getData(player: Player): any
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

-- Segundos de escudo que ainda faltam
function Fairness.ShieldLeft(player: Player): number
	local plot = Registry.Plots.Get(player)
	local untilTime = plot and plot.Model:GetAttribute("ShieldUntil")
	if typeof(untilTime) ~= "number" then
		return 0
	end
	return math.max(0, untilTime - now())
end

function Fairness.SetupPlayer(player: Player)
	local data = getData(player)
	local plot = Registry.Plots.Get(player)
	if not data or not plot then
		return
	end
	local left = Config.NewbieShieldSeconds - (tonumber(data.PlayTime) or 0)
	-- v20: escudo comprado (Base Shield) continua valendo se o jogador sair e voltar
	left = math.max(left, (tonumber(data.PaidShieldUntil) or 0) - os.time())
	if left > 0 then
		plot.Model:SetAttribute("ShieldUntil", now() + left)
		shieldAnnounced[player] = false
	else
		plot.Model:SetAttribute("ShieldUntil", nil)
		shieldAnnounced[player] = true
	end
end

-- v20: Base Shield comprado: soma ao escudo que já tem, até o máximo (Config.PaidShieldMaxSeconds)
function Fairness.AddPaidShield(player: Player, seconds: number): boolean
	local data = getData(player)
	local plot = Registry.Plots.Get(player)
	if not data or not plot then
		return false
	end
	local paidLeft = math.max(0, (tonumber(data.PaidShieldUntil) or 0) - os.time())
	local total = math.min(paidLeft + seconds, Config.PaidShieldMaxSeconds)
	data.PaidShieldUntil = os.time() + total
	local current = Fairness.ShieldLeft(player)
	plot.Model:SetAttribute("ShieldUntil", now() + math.max(current, total))
	shieldAnnounced[player] = true
	Registry.Remotes.Notify(player, ("BASE SHIELD ON: nobody can steal from you for %s!"):format(Format.Time(math.max(current, total))), "success")
	return true
end

function Fairness.HasPaidShield(player: Player): boolean
	local data = getData(player)
	return data ~= nil and (tonumber(data.PaidShieldUntil) or 0) > os.time()
end

-- Pode roubar? (o servidor sempre confere; a tela só esconde o botão)
function Fairness.CanSteal(thief: Player, owner: Player): (boolean, string?)
	-- vingança: quem foi roubado sempre pode roubar de volta de quem o roubou
	local revengeUntil = thief:GetAttribute("RevengeUntil")
	if thief:GetAttribute("RevengeTarget") == owner.UserId and typeof(revengeUntil) == "number" and revengeUntil > now() then
		return true, nil
	end
	if owner:GetAttribute("InMinigame") then
		return false, owner.DisplayName .. " is playing a minigame. Their base is safe until they come back!"
	end
	local left = Fairness.ShieldLeft(owner)
	if left > 0 then
		return false, ("%s is new! Their base has a New Player Shield (%s)."):format(owner.DisplayName, Format.Time(left))
	end
	-- "Power" = renda da base + mochila (guardar tudo na mochila não engana a regra)
	local thiefIncome = tonumber(thief:GetAttribute("Power")) or 0
	local ownerIncome = tonumber(owner:GetAttribute("Power")) or 0
	if thiefIncome > 0 and ownerIncome * Config.BullyIncomeRatio < thiefIncome then
		return false, owner.DisplayName .. " is much weaker than you. Steal from someone your size!"
	end
	return true, nil
end

-- Vingança: +velocidade por alguns segundos e o ladrão fica brilhando na tela da vítima
local function startRevenge(victim: Player, thief: Player)
	if not victim.Parent then
		return
	end
	local untilTime = now() + Config.RevengeSeconds
	victim:SetAttribute("RevengeUntil", untilTime)
	victim:SetAttribute("RevengeTarget", thief.UserId)
	Registry.Economy.ApplySpeed(victim)
	task.delay(Config.RevengeSeconds + 0.1, function()
		if victim.Parent and (victim:GetAttribute("RevengeUntil") or 0) <= now() then
			victim:SetAttribute("RevengeTarget", nil)
			Registry.Economy.ApplySpeed(victim)
		end
	end)
end

function Fairness.OnGrab(victim: Player, thief: Player)
	startRevenge(victim, thief)
	-- novato que começa a roubar perde o escudo (senão a vítima não consegue se vingar)
	-- (o Base Shield comprado não some: v20)
	if Fairness.ShieldLeft(thief) > 0 and not Fairness.HasPaidShield(thief) then
		local plot = Registry.Plots.Get(thief)
		if plot then
			plot.Model:SetAttribute("ShieldUntil", nil)
		end
		shieldAnnounced[thief] = true
		local data = getData(thief)
		if data then
			data.PlayTime = math.max(tonumber(data.PlayTime) or 0, Config.NewbieShieldSeconds)
		end
		Registry.Remotes.Notify(thief, "You started stealing, so your New Player Shield is gone!", "warning")
	end
end

function Fairness.OnStolen(victim: Player, thief: Player)
	startRevenge(victim, thief)
	Registry.Remotes.Notify(victim, ("REVENGE! +%d speed for %ds. Go steal it back from %s!"):format(Config.RevengeSpeedBonus, Config.RevengeSeconds, thief.DisplayName), "warning")
end

function Fairness.SpeedBonus(player: Player): number
	local untilTime = player:GetAttribute("RevengeUntil")
	if typeof(untilTime) == "number" and untilTime > now() then
		return Config.RevengeSpeedBonus
	end
	return 0
end

function Fairness.IncomeMultiplier(player: Player): number
	return if underdog[player] then 1 + Config.UnderdogBonus else 1
end

-- Admin (testes no Studio): acaba o escudo de alguém ou dá o escudo de novo
function Fairness.EndShield(player: Player)
	local data = getData(player)
	if data then
		data.PlayTime = math.max(tonumber(data.PlayTime) or 0, Config.NewbieShieldSeconds)
		data.PaidShieldUntil = 0
	end
	local plot = Registry.Plots.Get(player)
	if plot then
		plot.Model:SetAttribute("ShieldUntil", nil)
	end
	shieldAnnounced[player] = true
end

function Fairness.RestartShield(player: Player)
	local data = getData(player)
	if data then
		data.PlayTime = 0
	end
	Fairness.SetupPlayer(player)
end

function Fairness.RemovePlayer(player: Player)
	underdog[player] = nil
	shieldAnnounced[player] = nil
end

function Fairness.Init()
	Players.PlayerRemoving:Connect(Fairness.RemovePlayer)

	-- Tempo de jogo (para o escudo) e fim do escudo
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(function()
				for _, player in Players:GetPlayers() do
					local data = getData(player)
					if data and player:GetAttribute("Loaded") then
						data.PlayTime = (tonumber(data.PlayTime) or 0) + 1
						if not shieldAnnounced[player] and Fairness.ShieldLeft(player) <= 0 then
							shieldAnnounced[player] = true
							local plot = Registry.Plots.Get(player)
							if plot then
								plot.Model:SetAttribute("ShieldUntil", nil)
							end
							Registry.Remotes.Notify(player, "Your New Player Shield is gone. LOCK your base when thieves come!", "warning")
						end
					end
				end
			end)
			if not ok then
				warn("[Fairness] loop error:", err)
			end
		end
	end)

	-- Azarão: compara a renda de cada um com a do melhor jogador do servidor (a cada 5 s)
	task.spawn(function()
		while true do
			task.wait(5)
			local ok, err = pcall(function()
				local incomes = {}
				local top = 0
				for _, player in Players:GetPlayers() do
					if getData(player) and player:GetAttribute("Loaded") then
						local current = Registry.Economy.GetPower(player) / Fairness.IncomeMultiplier(player)
						incomes[player] = current
						top = math.max(top, current)
					end
				end
				for player, income in incomes do
					local was = underdog[player] == true
					local isUnder
					if top <= 0 then
						isUnder = false
					elseif was then
						isUnder = income < top * Config.UnderdogExit -- sai só um pouco depois (não fica piscando)
					else
						isUnder = income < top * Config.UnderdogEnter
					end
					if isUnder ~= was then
						underdog[player] = isUnder
						player:SetAttribute("Underdog", isUnder)
						if isUnder then
							Registry.Remotes.Notify(player, ("Underdog bonus: +%d%% cash while you catch up!"):format(math.floor(Config.UnderdogBonus * 100)), "success")
						end
						Registry.Economy.Sync(player)
					end
				end
			end)
			if not ok then
				warn("[Fairness] loop error:", err)
			end
		end
	end)
end

return Fairness
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="451">
        <Properties>
          <string name="Name">GiantEgg</string>
          <string name="Source"><![CDATA[--[[
	GiantEgg (ModuleScript em ServerScriptService > Game)
	Parte 21: OVO GIGANTE DO SERVIDOR na praça atrás das bases.
	  • Todo mundo ajuda tocando no ovo ("Help hatch!"). A meta cresce com o número de jogadores.
	  • Quando enche, ele choca e TODO MUNDO que ajudou pelo menos 5 vezes ganha um bichinho
	    (as chances aparecem na placa do ovo, sem segredo). O bichinho é do mundo mais alto que você liberou.
	  • Depois espera 5 minutos e aparece outro.
	Contra trapaça: o servidor confere a distância e aceita no máximo ~5 toques por segundo por jogador.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local GiantEgg = {}

local SETTINGS = Config.GiantEgg
local TAP_GAP = 0.18
local RANGE = 22

local stand: BasePart? = nil
local eggPart: BasePart? = nil
local barFill: Frame? = nil
local statusLabel: TextLabel? = nil
local taps: { [number]: number } = {}
local lastTap: { [Player]: number } = {}
local total = 0
local goal = SETTINGS.BaseGoal
local state = "waiting" -- "open" (dá para tocar) ou "waiting" (esperando o próximo)
local nextAt = 0

local function oddsText(): string
	local parts = {}
	for _, info in Config.Rarities do
		local chance = SETTINGS.Odds[info.Name]
		if chance then
			table.insert(parts, ("%s %s%%"):format(info.Name, tostring(chance)))
		end
	end
	return table.concat(parts, " · ")
end

local function currentGoal(): number
	local count = #Players:GetPlayers()
	return math.clamp(SETTINGS.BaseGoal + SETTINGS.GoalPerPlayer * math.max(count - 1, 0), SETTINGS.BaseGoal, SETTINGS.MaxGoal)
end

local function updateBoard()
	if barFill then
		barFill.Size = UDim2.fromScale(if state == "open" then math.clamp(total / goal, 0, 1) else 0, 1)
	end
	if statusLabel then
		if state == "open" then
			statusLabel.Text = ("%d / %d taps"):format(total, goal)
		else
			statusLabel.Text = "Next Giant Egg in " .. Format.Time(math.max(0, nextAt - os.clock()))
		end
	end
	if stand then
		stand:SetAttribute("GiantState", state)
		stand:SetAttribute("GiantTotal", total)
		stand:SetAttribute("GiantGoal", goal)
	end
end

local function buildBoard(anchor: BasePart)
	-- tamanho em STUDS: fica pequeno de longe (não cobre a tela do celular)
	local gui = Instance.new("BillboardGui")
	gui.Name = "GiantEggBoard"
	gui.Size = UDim2.fromScale(18, 8.5)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 15, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 120
	gui.LightInfluence = 0
	gui.Adornee = anchor
	local function text(y: number, height: number, value: string, color: Color3): TextLabel
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Position = UDim2.fromScale(0, y)
		label.Size = UDim2.fromScale(1, height)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = color
		label.Text = value
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = Color3.fromRGB(30, 20, 60)
		stroke.Parent = label
		label.Parent = gui
		return label
	end
	text(0, 0.23, "GIANT EGG", Color3.fromRGB(255, 230, 90))
	text(0.23, 0.15, "Tap to help! Everyone who helps 5+ times wins a critter", Color3.new(1, 1, 1))
	local bar = Instance.new("Frame")
	bar.Position = UDim2.fromScale(0.06, 0.41)
	bar.Size = UDim2.fromScale(0.88, 0.16)
	bar.BackgroundColor3 = Color3.fromRGB(40, 30, 70)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = bar
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = Color3.fromRGB(255, 200, 60)
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0.5, 0)
	fillCorner.Parent = fill
	fill.Parent = bar
	bar.Parent = gui
	barFill = fill
	statusLabel = text(0.6, 0.17, "", Color3.new(1, 1, 1))
	text(0.79, 0.19, "Odds: " .. oddsText(), Color3.fromRGB(200, 215, 240))
	gui.Parent = anchor
end

local function spawnEgg()
	if not stand then
		return
	end
	taps = {}
	total = 0
	goal = currentGoal()
	state = "open"
	local egg = Instance.new("Part")
	egg.Name = "GiantEgg"
	egg.Shape = Enum.PartType.Ball
	egg.Size = Vector3.new(10, 10, 10)
	egg.Anchored = true
	egg.CanCollide = true
	egg.Material = Enum.Material.SmoothPlastic
	egg.Color = Color3.fromRGB(255, 240, 200)
	egg.CFrame = CFrame.new(stand.Position + Vector3.new(0, stand.Size.Y / 2 + 6, 0))
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 1.3, 1)
	mesh.Parent = egg
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkles.Rate = 6
	sparkles.Lifetime = NumberRange.new(1, 1.6)
	sparkles.Speed = NumberRange.new(1, 3)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Color = ColorSequence.new(Color3.fromRGB(255, 220, 90))
	sparkles.Parent = egg
	egg:AddTag("Bob")
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "GiantPrompt"
	prompt.ActionText = "Help hatch!"
	prompt.ObjectText = "Giant Egg"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Triggered:Connect(function(player)
		GiantEgg.Tap(player)
	end)
	prompt.Parent = egg
	egg.Parent = stand.Parent
	eggPart = egg
	Registry.Remotes.NotifyAll("A GIANT EGG appeared behind the bases! Tap it together to hatch it!", "rare")
	updateBoard()
end

local function hatch()
	state = "waiting"
	nextAt = os.clock() + SETTINGS.Cooldown
	local egg = eggPart
	eggPart = nil
	local position = if egg then egg.Position elseif stand then stand.Position else Vector3.zero
	if egg then
		egg:Destroy()
	end
	Registry.Remotes.EffectAll("HatchBurst", { Position = position, Rarity = "Mythic" })
	local winners = 0
	for _, player in Players:GetPlayers() do
		local count = taps[player.UserId] or 0
		if count >= SETTINGS.MinTaps and player:GetAttribute("Loaded") then
			local def, shiny = Registry.CritterService.RollFromOdds(player, SETTINGS.Odds)
			if def and Registry.CritterService.GrantCritter(player, def.Id, nil, os.time(), shiny) then
				winners += 1
				Registry.Economy.Discover(player, def.Id)
				Registry.Economy.SeasonXP(player, "GiantEgg")
				Registry.Remotes.Notify(player, ("The Giant Egg hatched! You got %s%s (%s)!"):format(if shiny then "SHINY " else "", def.Name, def.Rarity), "rare")
				if def.Rarity == "Secret" and Registry.Discoveries then
					task.spawn(Registry.Discoveries.Claim, player, def.Id)
				end
			end
		elseif count > 0 then
			Registry.Remotes.Notify(player, ("The Giant Egg hatched! Help %d+ times next time to win a critter."):format(SETTINGS.MinTaps), "info")
		end
	end
	Registry.Remotes.NotifyAll(("The GIANT EGG hatched! %d helper(s) got a critter!"):format(winners), "rare")
	taps = {}
	total = 0
	updateBoard()
end

function GiantEgg.Tap(player: Player)
	if state ~= "open" or not eggPart or not player:GetAttribute("Loaded") then
		return
	end
	local now = os.clock()
	if now - (lastTap[player] or 0) < TAP_GAP then
		return
	end
	lastTap[player] = now
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or (root.Position - eggPart.Position).Magnitude > RANGE then
		return
	end
	taps[player.UserId] = (taps[player.UserId] or 0) + 1
	total += 1
	if taps[player.UserId] == SETTINGS.MinTaps then
		Registry.Remotes.Notify(player, "You're a helper! You'll get a critter when the Giant Egg hatches.", "success")
	end
	Registry.Remotes.Effect(player, "GiantTap", taps[player.UserId])
	if total >= goal then
		hatch()
	else
		updateBoard()
	end
end

-- Votação "Giant Egg Now": aparece um agora (se já tiver um, avisa)
function GiantEgg.SpawnNow()
	if state == "open" then
		Registry.Remotes.NotifyAll("A Giant Egg is already waiting behind the bases. Go tap it!", "info")
		return
	end
	spawnEgg()
end

-- Admin: enche o ovo (você ganha como ajudante)
function GiantEgg.AdminFill(player: Player)
	if state ~= "open" then
		nextAt = 0
		spawnEgg()
	end
	taps[player.UserId] = math.max(taps[player.UserId] or 0, SETTINGS.MinTaps)
	total = goal
	hatch()
end

function GiantEgg.Init()
	local map = workspace:WaitForChild("Map")
	local plaza = map:WaitForChild("LivingPlaza", 10)
	local found = plaza and plaza:FindFirstChild("GiantEggStand")
	if not found or not found:IsA("BasePart") then
		warn("[GiantEgg] Map.LivingPlaza.GiantEggStand not found: Giant Egg is off")
		return
	end
	stand = found
	buildBoard(found)
	Players.PlayerRemoving:Connect(function(player)
		lastTap[player] = nil
	end)
	nextAt = os.clock() + 20 -- o primeiro aparece logo
	updateBoard()
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(function()
				if state == "waiting" and os.clock() >= nextAt then
					spawnEgg()
				elseif state == "waiting" then
					updateBoard()
				end
			end)
			if not ok then
				warn("[GiantEgg] loop error:", err)
			end
		end
	end)
end

return GiantEgg
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="452">
        <Properties>
          <string name="Name">Leaderboards</string>
          <string name="Source"><![CDATA[--[[
	Leaderboards (ModuleScript em ServerScriptService > Game)
	Três placares GLOBAIS (todos os servidores) nas placas do lobby:
	  • TOP EARNERS: quem mais ganhou dinheiro na vida
	  • TOP THIEVES: quem mais roubou
	  • TOP COLLECTORS: quem descobriu mais bichinhos diferentes no Índice
	Atualiza a cada 60 s. Só funciona com o jogo publicado (no Studio aparece um aviso).
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserService = game:GetService("UserService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local Leaderboards = {}

local MAX_VALUE = 2 ^ 52
local LOG_SCALE = 1e12

local boards = {
	{ Key = "TotalEarned", Store = "TopEarners_v2", Board = "EarnersBoard", Title = "TOP EARNERS", Money = true, Log = true, Color = Color3.fromRGB(120, 255, 120) },
	{ Key = "Steals", Store = "TopThieves_v1", Board = "ThievesBoard", Title = "TOP THIEVES", Money = false, Color = Color3.fromRGB(255, 120, 120) },
	{ Key = "Collected", Store = "TopCollectors_v1", Board = "CollectorsBoard", Title = "TOP COLLECTORS", Money = false, Color = Color3.fromRGB(120, 200, 255) },
	{ Key = "Likes", Store = "TopLikes_v1", Board = "LikesBoard", Title = "MOST LIKED BASES", Money = false, Color = Color3.fromRGB(255, 130, 190) },
}

local nameCache: { [number]: string } = {}

local function makeText(parent: Instance, text: string, size: UDim2, position: UDim2, color: Color3, alignment: Enum.TextXAlignment?): TextLabel
	local label = Instance.new("TextLabel")
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextXAlignment = alignment or Enum.TextXAlignment.Center
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(20, 20, 35)
	stroke.Parent = label
	label.Parent = parent
	return label
end

local function buildBoard(info)
	local part = workspace:WaitForChild("Map"):FindFirstChild("Leaderboards")
	part = part and part:FindFirstChild(info.Board)
	if not part then
		return
	end
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Front
	surface.LightInfluence = 0
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 30
	surface.Parent = part
	makeText(surface, info.Title, UDim2.new(1, -20, 0.12, 0), UDim2.new(0, 10, 0.02, 0), info.Color)
	info.Rows = {}
	for i = 1, Config.LeaderboardSize do
		local y = 0.16 + (i - 1) * 0.082
		local rankColor = if i == 1 then Color3.fromRGB(255, 215, 60) elseif i == 2 then Color3.fromRGB(220, 220, 230) elseif i == 3 then Color3.fromRGB(230, 150, 90) else Color3.fromRGB(255, 255, 255)
		local nameLabel = makeText(surface, "", UDim2.new(0.62, 0, 0.07, 0), UDim2.new(0.04, 0, y, 0), rankColor, Enum.TextXAlignment.Left)
		local valueLabel = makeText(surface, "", UDim2.new(0.3, 0, 0.07, 0), UDim2.new(0.66, 0, y, 0), info.Color, Enum.TextXAlignment.Right)
		info.Rows[i] = { Name = nameLabel, Value = valueLabel }
	end
	info.Status = info.Rows[1].Name
	info.Rows[1].Name.Text = "Loading..."
end

local function namesFor(userIds: { number })
	local missing = {}
	for _, id in userIds do
		if not nameCache[id] then
			table.insert(missing, id)
		end
	end
	if #missing > 0 then
		local ok, infos = pcall(function()
			return UserService:GetUserInfosByUserIdsAsync(missing)
		end)
		if ok and type(infos) == "table" then
			for _, entry in infos do
				nameCache[entry.Id] = entry.DisplayName
			end
		end
	end
end

local function refresh(info)
	if not info.Rows then
		return
	end
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(info.Store)
	end)
	if not ok then
		info.Rows[1].Name.Text = "Publish the game to see leaderboards"
		return
	end
	-- 1) envia os números de quem está no servidor
	for _, player in Players:GetPlayers() do
		local profile = Registry.Data.Get(player)
		if profile and profile.CanSave and player:GetAttribute("Loaded") then
			local raw = math.max(0, tonumber(profile.Data[info.Key]) or 0)
			-- números gigantes: guarda o log (mantém a ordem certa e cabe no OrderedDataStore)
			local value = if info.Log then math.floor(math.log10(raw + 1) * LOG_SCALE) else math.clamp(math.floor(raw), 0, MAX_VALUE)
			if value > 0 then
				pcall(function()
					store:SetAsync("u_" .. player.UserId, value)
				end)
			end
		end
	end
	-- 2) busca o top 10
	local success, pages = pcall(function()
		return store:GetSortedAsync(false, Config.LeaderboardSize)
	end)
	if not success or not pages then
		info.Rows[1].Name.Text = "Publish the game to see leaderboards"
		return
	end
	local page = pages:GetCurrentPage()
	local ids = {}
	for _, entry in page do
		local id = tonumber(string.sub(entry.key, 3))
		if id then
			table.insert(ids, id)
		end
	end
	namesFor(ids)
	for i = 1, Config.LeaderboardSize do
		local row = info.Rows[i]
		local entry = page[i]
		if entry then
			local id = tonumber(string.sub(entry.key, 3)) or 0
			row.Name.Text = ("#%d  %s"):format(i, nameCache[id] or "Player")
			local shown = if info.Log then 10 ^ (entry.value / LOG_SCALE) - 1 else entry.value
			row.Value.Text = if info.Money then Format.Money(shown) else Format.Short(shown)
		else
			row.Name.Text = if i == 1 then "Be the first!" else ""
			row.Value.Text = ""
		end
	end
end

function Leaderboards.Init()
	for _, info in boards do
		buildBoard(info)
	end
	task.spawn(function()
		task.wait(10)
		while true do
			local ok, err = pcall(function()
				for _, info in boards do
					refresh(info)
				end
			end)
			if not ok then
				warn("[Leaderboards] loop error:", err)
			end
			task.wait(Config.LeaderboardRefresh)
		end
	end)
end

return Leaderboards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="453">
        <Properties>
          <string name="Name">LiveEvents</string>
          <string name="Source"><![CDATA[--[[
	LiveEvents (ModuleScript em ServerScriptService > Game)
	Parte 25 (v11): eventos ao vivo. Nada é punição: quem participa só ganha.
	  • INVASÃO DE MONSTROS a cada 45 min: Grumblobs aparecem no Meadow; BONK neles com o taco
	    (3 pancadas). Quem ajudou a derrubar ganha 2 min da sua renda. Se ninguém derrubar, eles vão embora.
	  • MERCADOR VIAJANTE: chega no começo de cada hora (UTC) e fica 15 min. As ofertas são as mesmas
	    em todos os servidores naquela hora (sorteio pela hora). Cada oferta: 1 compra por jogador por hora.
	  • VOTAÇÃO a cada 20 min: 3 opções, 1 voto por jogador, resultado ao vivo; a vencedora acontece na hora.
	  • META DA COMUNIDADE: todos os servidores somam os ovos chocados (MemoryStore a cada 60 s).
	    Cada meta batida dá um presente para TODO MUNDO (quem entrar depois também ganha).
	  • FESTAS DO CALENDÁRIO (Config.Holidays): ovos de festa na esteira na época certa.
	  • RECORDE DE JOGADORES no servidor (4 ou mais): chuva de ovos!
	  • CRIADOR NO SERVIDOR: aviso para todos e o bichinho exclusivo Crowny de presente (1 vez por jogador).
	O estado fica em atributos do Workspace para as telas lerem.
]]

local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local MemoryStoreService = game:GetService("MemoryStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Critters = require(ReplicatedStorage.Shared.Critters)
local Format = require(ReplicatedStorage.Shared.Format)
local Models3D = require(ReplicatedStorage.Shared.Models3D)
local Registry = require(script.Parent.Registry)

local LiveEvents = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function getData(player: Player): any
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

local function grant(player: Player, reward): string
	local codes = Registry.Codes
	if not codes then
		return ""
	end
	local ok, parts = pcall(codes.Grant, player, reward)
	return if ok and type(parts) == "table" then table.concat(parts, " + ") else ""
end

---------------------------------------------------------------------
-- FESTAS
---------------------------------------------------------------------
local forcedHoliday: string? = nil

local function refreshHoliday()
	local holiday = if forcedHoliday then Config.HolidayById[forcedHoliday] else Config.HolidayAt(os.time())
	local id = if holiday then holiday.Id else nil
	if workspace:GetAttribute("Holiday") ~= id then
		workspace:SetAttribute("Holiday", id)
		if holiday then
			local eggName = "holiday eggs"
			for _, egg in Config.Eggs do
				if egg.Holiday == holiday.Id then
					eggName = egg.Name .. "s"
				end
			end
			Registry.Remotes.NotifyAll(("%s EVENT! %s are on the conveyor!"):format(string.upper(holiday.Name), eggName), "rare")
		end
	end
end

-- Admin: liga uma festa agora (nil = volta ao calendário)
function LiveEvents.ForceHoliday(id: string?)
	forcedHoliday = if id and Config.HolidayById[id] then id else nil
	refreshHoliday()
end

---------------------------------------------------------------------
-- INVASÃO DE MONSTROS
---------------------------------------------------------------------
type Monster = { Model: Model, Root: BasePart, Humanoid: Humanoid, HP: number, MaxHP: number, Hitters: { [Player]: boolean }, Hearts: TextLabel, NextMove: number }
local monsters: { [Model]: Monster } = {}
local invasionFolder: Folder? = nil
local invading = false
local invasionId = 0

local function part(name: string, size: Vector3, color: Color3, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanTouch = false
	p.Massless = true
	if shape then
		p.Shape = shape
	end
	return p
end

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

local function heartsText(hp: number, max: number): string
	return string.rep("\u{2764}", hp) .. string.rep("\u{2661}", math.max(0, max - hp))
end

local function buildMonster(position: Vector3, hp: number): Monster
	local model = Instance.new("Model")
	model.Name = "Grumblob"
	local root = part("HumanoidRootPart", Vector3.new(3, 3, 3), Color3.new(1, 1, 1))
	root.Transparency = 1
	root.Massless = false
	root.CFrame = CFrame.new(position)
	root.Parent = model
	model.PrimaryPart = root
	local purple = Color3.fromRGB(120 + math.random(0, 60), 60, 170 + math.random(0, 60))
	-- modelo 3D (ReplicatedStorage > Models3D > grumblob), se existir; senão, monta com peças
	local mesh = Models3D.Get("grumblob", { Size = 5.4, Fit = "Height", Anchored = false })
	if mesh then
		mesh:PivotTo(root.CFrame * CFrame.new(0, -3.7, 0)) -- pés no chão (HipHeight 2.2 + meia raiz 1.5)
		for _, d in mesh:GetDescendants() do
			if d:IsA("BasePart") then
				d.Parent = model
				weld(root, d)
			end
		end
		mesh:Destroy()
	end
	local body = part("Body", Vector3.new(4.6, 4, 4.6), purple, Enum.PartType.Ball)
	body.CFrame = root.CFrame
	body.Parent = model
	weld(root, body)
	if mesh then
		body.Transparency = 1 -- fica só como "corpo" invisível
	end
	for side = -1, 1, 2 do
		if mesh then
			break
		end
		local horn = part("Horn", Vector3.new(0.6, 1.6, 0.6), Color3.fromRGB(255, 230, 150))
		horn.CFrame = root.CFrame * CFrame.new(side * 1.2, 2.2, 0) * CFrame.Angles(0, 0, -side * 0.35)
		horn.Parent = model
		weld(root, horn)
		local eye = part("Eye", Vector3.new(1.1, 1.1, 1.1), Color3.new(1, 1, 1), Enum.PartType.Ball)
		eye.CFrame = root.CFrame * CFrame.new(side * 0.8, 0.6, -2)
		eye.Parent = model
		weld(root, eye)
		local pupil = part("Pupil", Vector3.new(0.5, 0.5, 0.5), Color3.fromRGB(30, 20, 40), Enum.PartType.Ball)
		pupil.CFrame = root.CFrame * CFrame.new(side * 0.8, 0.55, -2.45)
		pupil.Parent = model
		weld(root, pupil)
	end
	if not mesh then
		local mouth = part("Mouth", Vector3.new(1.8, 0.3, 0.3), Color3.fromRGB(40, 20, 50))
		mouth.CFrame = root.CFrame * CFrame.new(0, -0.6, -2.2)
		mouth.Parent = model
		weld(root, mouth)
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15 -- sem pernas: fica de pé pela HipHeight
	humanoid.HipHeight = 2.2
	humanoid.WalkSpeed = 9
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.BreakJointsOnDeath = false
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	humanoid.Parent = model
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(6, 1.6)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 4.2, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 90
	local hearts = Instance.new("TextLabel")
	hearts.Size = UDim2.fromScale(1, 1)
	hearts.BackgroundTransparency = 1
	hearts.Font = Enum.Font.FredokaOne
	hearts.TextScaled = true
	hearts.TextColor3 = Color3.fromRGB(255, 90, 120)
	hearts.Text = heartsText(hp, hp)
	hearts.Parent = gui
	gui.Parent = root
	model:AddTag("Monster")
	model.Parent = invasionFolder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	return { Model = model, Root = root, Humanoid = humanoid, HP = hp, MaxHP = hp, Hitters = {}, Hearts = hearts, NextMove = 0 }
end

-- Um lugar para o monstro andar: o tapete dos ovos e os caminhos
local function wanderPoint(): Vector3
	return Vector3.new(math.random(-160, 160), 2, math.random(-22, 22))
end

local function endInvasion(defeated: boolean)
	if not invading then
		return
	end
	invading = false
	workspace:SetAttribute("InvasionUntil", nil)
	for model in monsters do
		model:Destroy()
	end
	table.clear(monsters)
	if defeated then
		Registry.Remotes.NotifyAll("ALL MONSTERS DEFEATED! Great teamwork!", "rare")
		Registry.Remotes.EffectAll("InvasionWon")
	else
		Registry.Remotes.NotifyAll("The Grumblobs ran away... Get them next time!", "info")
	end
end

function LiveEvents.StartInvasion()
	if invading then
		return
	end
	invading = true
	invasionId += 1
	local myId = invasionId
	local settings = Config.Invasion
	local count = math.min(settings.Max, settings.Base + #Players:GetPlayers())
	local hp = settings.Hits + math.floor(#Players:GetPlayers() / 4)
	workspace:SetAttribute("InvasionUntil", now() + settings.Duration)
	Registry.Remotes.NotifyAll("MONSTER INVASION! Grumblobs are in Meadow Valley. BONK them with your bat!", "rare")
	Registry.Remotes.EffectAll("Invasion")
	for _ = 1, count do
		local monster = buildMonster(wanderPoint() + Vector3.new(0, 3, 0), hp)
		monsters[monster.Model] = monster
	end
	task.delay(settings.Duration, function()
		if invasionId == myId then -- uma invasão nova não é encerrada pelo relógio da antiga
			endInvasion(next(monsters) == nil)
		end
	end)
end

-- Chamado pelo Combat quando um taco acerta um monstro
function LiveEvents.HitMonster(model: Model, player: Player)
	local monster = monsters[model]
	if not monster or monster.HP <= 0 then
		return
	end
	monster.HP -= 1
	monster.Hitters[player] = true
	monster.Hearts.Text = heartsText(monster.HP, monster.MaxHP)
	Registry.Remotes.EffectAll("Bonk", monster.Root.Position + Vector3.new(0, 3, 0))
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		local away = monster.Root.Position - root.Position
		local flat = Vector3.new(away.X, 0, away.Z)
		if flat.Magnitude > 0.1 then
			monster.Root.AssemblyLinearVelocity = flat.Unit * 45 + Vector3.new(0, 25, 0)
		end
	end
	if monster.HP > 0 then
		return
	end
	-- derrubado: todo mundo que bateu nele ganha
	local position = monster.Root.Position
	monsters[model] = nil
	model:Destroy()
	Registry.Remotes.EffectAll("HatchBurst", { Position = position, Rarity = "Epic" })
	for hitter in monster.Hitters do
		if hitter.Parent and hitter:GetAttribute("Loaded") then
			local text = grant(hitter, { Minutes = Config.Invasion.RewardMinutes })
			Registry.Remotes.Notify(hitter, "You defeated a Grumblob! +" .. text, "success")
			if Registry.Progress then
				Registry.Progress.Event(hitter, "Monster")
			end
		end
	end
	if next(monsters) == nil then
		endInvasion(true)
	end
end

---------------------------------------------------------------------
-- MERCADOR VIAJANTE
---------------------------------------------------------------------
local stockHour = -1
local stock: { any } = {}

local function merchantHere(time: number): boolean
	return time % 3600 < Config.Merchant.StayMinutes * 60
end

-- Ofertas da hora (mesmas em todo servidor)
function LiveEvents.StockFor(hour: number): { any }
	local random = Random.new(hour * 7919 + 17)
	local offers = {}
	-- 1) um ovo do Meadow e 2) um ovo de outro mundo, com desconto
	local meadow, others = {}, {}
	for _, egg in Config.Eggs do
		if not egg.Condition and not egg.Holiday and not egg.Where and egg.Weight > 0 then
			if egg.World == "meadow" and egg.Tier >= 2 then
				table.insert(meadow, egg)
			elseif egg.World ~= "meadow" then
				table.insert(others, egg)
			end
		end
	end
	for _, list in { meadow, others } do
		if #list > 0 then
			local egg = list[random:NextInteger(1, #list)]
			table.insert(offers, { Kind = "Egg", Id = egg.Id, Price = math.floor(egg.Price * Config.Merchant.Discount) })
		end
	end
	-- 3) um bichinho Gold (Raro ou Épico do Meadow)
	local pool = {}
	for _, def in Critters.List do
		if def.World == "meadow" and not def.RebirthRequired and (def.Rarity == "Rare" or def.Rarity == "Epic") then
			table.insert(pool, def)
		end
	end
	if #pool > 0 then
		local def = pool[random:NextInteger(1, #pool)]
		table.insert(offers, { Kind = "Critter", Id = def.Id, Mutation = "Gold", Price = math.floor(def.Price * Config.PriceMultiplier("Gold") * 1.2) })
	end
	-- 4) 2x Cash por 10 min (custa 5 min da sua renda)
	table.insert(offers, { Kind = "Boost", Minutes = 10, IncomeMinutes = 5 })
	return offers
end

local function refreshMerchant()
	local time = os.time()
	local hour = math.floor(time / 3600)
	local here = merchantHere(time)
	if hour ~= stockHour then
		stockHour = hour
		stock = LiveEvents.StockFor(hour)
		workspace:SetAttribute("MerchantStock", HttpService:JSONEncode(stock))
	end
	local serverOffset = now() - time -- relógio do jogo (GetServerTimeNow) x os.time
	workspace:SetAttribute("MerchantHour", hour)
	workspace:SetAttribute("MerchantLeaves", if here then math.floor(hour * 3600 + Config.Merchant.StayMinutes * 60 + serverOffset + 0.5) else nil)
	workspace:SetAttribute("MerchantArrives", if here then nil else math.floor((hour + 1) * 3600 + serverOffset + 0.5))
	if here ~= workspace:GetAttribute("MerchantHere") then
		workspace:SetAttribute("MerchantHere", here)
		if here then
			Registry.Remotes.NotifyAll("The TRAVELING MERCHANT is here for 15 minutes! Find the stall next to the Hatchery.", "rare")
		end
	end
end

local function nearMerchant(player: Player): boolean
	local map = workspace:FindFirstChild("Map")
	local stall = map and map:FindFirstChild("MerchantStall")
	local counter = stall and stall:FindFirstChild("Counter") :: BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return counter ~= nil and root ~= nil and (counter.CFrame.Position - root.Position).Magnitude <= 40
end

function LiveEvents.MerchantBuy(player: Player, index: any)
	local data = getData(player)
	if not data or typeof(index) ~= "number" then
		return
	end
	local offer = stock[math.floor(index)]
	if not offer then
		return
	end
	if not merchantHere(os.time()) then
		Registry.Remotes.Notify(player, "The merchant is away. Come back when the stall is open!", "info")
		return
	end
	if not nearMerchant(player) then
		Registry.Remotes.Notify(player, "Go to the merchant's stall next to the Hatchery to buy!", "info")
		return
	end
	if type(data.MerchantBuys) ~= "table" or data.MerchantBuys.Hour ~= stockHour then
		data.MerchantBuys = { Hour = stockHour, Bought = {} }
	end
	local key = tostring(math.floor(index))
	if data.MerchantBuys.Bought[key] then
		Registry.Remotes.Notify(player, "You already bought this! New offers next hour.", "info")
		return
	end
	local Economy = Registry.Economy
	local price = offer.Price
	if offer.Kind == "Boost" then
		price = math.floor(math.max(1000, Economy.GetIncome(player) * 60 * offer.IncomeMinutes))
	end
	if (offer.Kind == "Egg" or offer.Kind == "Critter") and not Registry.CritterService.HasFreeSlot(player) and not Registry.Pets.HasSpace(player, 1) then
		Registry.Remotes.Notify(player, "Your base and backpack are full! Make space first.", "warning")
		return
	end
	if not Economy.TrySpend(player, price, "Merchant") then
		Registry.Remotes.Notify(player, "Not enough cash! You need " .. Format.Money(price), "error")
		return
	end
	data.MerchantBuys.Bought[key] = true
	if offer.Kind == "Egg" then
		Registry.CritterService.GrantEgg(player, offer.Id)
	elseif offer.Kind == "Critter" then
		Registry.CritterService.GrantCritter(player, offer.Id, offer.Mutation)
	elseif offer.Kind == "Boost" then
		Registry.Codes.AddBoost(player, offer.Minutes)
	end
	Registry.Remotes.Notify(player, "Thanks for shopping with the Traveling Merchant!", "success")
	Registry.Remotes.Effect(player, "Purchase", "Rare")
	LiveEvents.SyncMerchant(player)
end

function LiveEvents.SyncMerchant(player: Player)
	local data = getData(player)
	if not data then
		return
	end
	local bought = {}
	if type(data.MerchantBuys) == "table" and data.MerchantBuys.Hour == stockHour then
		for key in data.MerchantBuys.Bought do
			table.insert(bought, tonumber(key))
		end
	end
	player:SetAttribute("MerchantBought", table.concat(bought, ","))
	player:SetAttribute("MerchantBoostPrice", math.floor(math.max(1000, Registry.Economy.GetIncome(player) * 60 * 5)))
end

---------------------------------------------------------------------
-- VOTAÇÃO
---------------------------------------------------------------------
local voteOptions: { string } = {}
local votes: { [Player]: number } = {}
local voting = false

local function publishVotes()
	local counts = {}
	for i = 1, #voteOptions do
		counts[i] = 0
	end
	for player, choice in votes do
		if player.Parent and counts[choice] then
			counts[choice] += 1
		end
	end
	workspace:SetAttribute("VoteCounts", table.concat(counts, ","))
	return counts
end

local function runWinner(option: string)
	if option == "Rain" then
		Registry.Events.StartRain()
	elseif option == "Lucky" then
		Registry.Events.StartLucky()
	elseif option == "GiantEgg" and Registry.GiantEgg then
		Registry.GiantEgg.SpawnNow()
	elseif option == "Night" and Registry.Environment then
		Registry.Environment.ForceNight(180)
		Registry.Remotes.NotifyAll("Night falls early... Moon Eggs are on the conveyor!", "rare")
	end
end

function LiveEvents.StartVote()
	if voting then
		return
	end
	voting = true
	table.clear(votes)
	local pool = table.clone(Config.Vote.Options)
	voteOptions = {}
	while #voteOptions < 3 and #pool > 0 do
		table.insert(voteOptions, table.remove(pool, math.random(1, #pool)) :: string)
	end
	workspace:SetAttribute("VoteOptions", table.concat(voteOptions, ","))
	workspace:SetAttribute("VoteUntil", now() + Config.Vote.Duration)
	publishVotes()
	Registry.Remotes.NotifyAll("VOTE for the next event! Tap your choice at the top of the screen.", "info")
	task.delay(Config.Vote.Duration, function()
		voting = false
		local counts = publishVotes()
		local best, bestCount = {}, -1
		for i, count in counts do
			if count > bestCount then
				best, bestCount = { i }, count
			elseif count == bestCount then
				table.insert(best, i)
			end
		end
		local winner = voteOptions[best[math.random(1, #best)]]
		workspace:SetAttribute("VoteUntil", nil)
		workspace:SetAttribute("VoteOptions", nil)
		table.clear(votes)
		if winner then
			Registry.Remotes.NotifyAll(("Vote result: %s! (%d votes)"):format(Config.VoteNames[winner] or winner, math.max(bestCount, 0)), "rare")
			runWinner(winner)
		end
	end)
end

function LiveEvents.Vote(player: Player, choice: any)
	if not voting or typeof(choice) ~= "number" or not voteOptions[math.floor(choice)] then
		return
	end
	if votes[player] then
		Registry.Remotes.Notify(player, "You already voted! 1 vote per player.", "info")
		return
	end
	votes[player] = math.floor(choice)
	publishVotes()
	Registry.Remotes.Notify(player, "Vote counted: " .. (Config.VoteNames[voteOptions[math.floor(choice)]] or ""), "success")
end

---------------------------------------------------------------------
-- META DA COMUNIDADE (todos os servidores)
---------------------------------------------------------------------
local pendingHatches = 0
local globalCount = 0
local goalMap: any? = nil
local goalBackup: DataStore? = nil
local MEMORY_TTL = 40 * 24 * 3600 -- a MemoryStore guarda até 45 dias; o DataStore guarda para sempre

function LiveEvents.AddHatch(amount: number?)
	pendingHatches += amount or 1
end

local function tiersReached(count: number): number
	local reached = 0
	for index, goal in Config.GlobalGoals do
		if count >= goal.Goal then
			reached = index
		end
	end
	return reached
end

local function giveGoalRewards(player: Player)
	local data = getData(player)
	if not data or not player:GetAttribute("Loaded") then
		return
	end
	if type(data.GlobalClaimed) ~= "table" then
		data.GlobalClaimed = {}
	end
	for index = 1, tiersReached(globalCount) do
		local key = tostring(index)
		if not data.GlobalClaimed[key] then
			data.GlobalClaimed[key] = true
			local goal = Config.GlobalGoals[index]
			if goal.Critter then
				Registry.CritterService.GrantCritter(player, goal.Critter, nil)
			end
			if goal.BigEgg then
				grant(player, { BigEgg = goal.BigEgg })
			end
			Registry.Remotes.Notify(player, "COMMUNITY GOAL reward: " .. goal.Name, "rare")
		end
	end
end

-- Admin/teste: soma SÓ neste servidor (não mexe na meta de verdade dos outros servidores)
function LiveEvents.AdminAddLocal(amount: number)
	globalCount += amount
	workspace:SetAttribute("GlobalCount", globalCount)
	workspace:SetAttribute("GlobalTier", tiersReached(globalCount))
	for _, player in Players:GetPlayers() do
		giveGoalRewards(player)
	end
end

local function syncGlobal()
	local delta = pendingHatches
	pendingHatches = 0
	local newCount: number? = nil
	if goalMap then
		local ok, result = pcall(function()
			return (goalMap :: any):UpdateAsync("hatches", function(old)
				return (tonumber(old) or 0) + delta
			end, MEMORY_TTL)
		end)
		if ok and type(result) == "number" then
			newCount = result
		else
			pendingHatches += delta -- não perde: tenta de novo no próximo minuto
		end
	end
	if not newCount then
		newCount = globalCount + (if goalMap then 0 else delta)
	end
	local before = tiersReached(globalCount)
	globalCount = math.max(globalCount, newCount :: number)
	workspace:SetAttribute("GlobalCount", globalCount + pendingHatches) -- mostra também o que ainda não subiu
	local after = tiersReached(globalCount)
	workspace:SetAttribute("GlobalTier", after)
	if after > before then
		for index = before + 1, after do
			Registry.Remotes.NotifyAll("COMMUNITY GOAL REACHED: " .. Config.GlobalGoals[index].Name, "rare")
		end
		Registry.Remotes.EffectAll("GoalReached")
	end
	for _, player in Players:GetPlayers() do
		giveGoalRewards(player) -- não dá duas vezes (GlobalClaimed)
	end
end

local function loadGlobal()
	-- começa pelo que está salvo para sempre; a MemoryStore pode ter "esquecido" (45 dias)
	if goalBackup then
		local ok, saved = pcall(function()
			return (goalBackup :: DataStore):GetAsync("hatches")
		end)
		if ok and type(saved) == "number" then
			globalCount = saved
		end
	end
	if goalMap then
		pcall(function()
			(goalMap :: any):UpdateAsync("hatches", function(old)
				return math.max(tonumber(old) or 0, globalCount)
			end, MEMORY_TTL)
		end)
	end
	workspace:SetAttribute("GlobalCount", globalCount)
	workspace:SetAttribute("GlobalTier", tiersReached(globalCount))
	for _, player in Players:GetPlayers() do
		giveGoalRewards(player) -- quem já estava aqui também recebe metas antigas
	end
end

local function backupGlobal()
	if not goalBackup or RunService:IsStudio() or math.random() > 0.3 then
		return -- poucos servidores salvam por vez (limite do DataStore por chave)
	end
	local value = globalCount
	pcall(function()
		(goalBackup :: DataStore):UpdateAsync("hatches", function(old)
			return math.max(tonumber(old) or 0, value)
		end)
	end)
end

---------------------------------------------------------------------
-- RECORDE DE JOGADORES E VISITA DO CRIADOR
---------------------------------------------------------------------
local serverRecord = 0
local lastRecordRain = -math.huge
local creatorHere = false

local function isCreator(player: Player): boolean
	if Config.CreatorUserIds and Config.CreatorUserIds[player.UserId] then
		return true
	end
	return game.CreatorType == Enum.CreatorType.User and game.CreatorId ~= 0 and player.UserId == game.CreatorId
end

local function giveCreatorGift(player: Player)
	local data = getData(player)
	if not data or data.CreatorGift or not player:GetAttribute("Loaded") then
		return
	end
	data.CreatorGift = true
	Registry.CritterService.GrantCritter(player, "crowny", nil)
	Registry.Remotes.Notify(player, "The creator is here! You got the exclusive critter CROWNY!", "rare")
end

function LiveEvents.CreatorArrived(player: Player?)
	creatorHere = true
	workspace:SetAttribute("CreatorHere", true)
	Registry.Remotes.NotifyAll(("\u{1F451} The CREATOR of Steal a Critter%s is in this server! Everyone gets a gift!"):format(if player then " (" .. player.DisplayName .. ")" else ""), "rare")
	Registry.Remotes.EffectAll("GoalReached")
	for _, other in Players:GetPlayers() do
		giveCreatorGift(other)
	end
end

local function checkRecord()
	local count = #Players:GetPlayers()
	if count > serverRecord then
		serverRecord = count
		if count >= Config.RecordRainMin and os.clock() - lastRecordRain > 600 then
			lastRecordRain = os.clock()
			Registry.Remotes.NotifyAll(("SERVER RECORD: %d players! Here comes an EGG RAIN!"):format(count), "rare")
			Registry.Events.StartRain()
		end
	end
end

---------------------------------------------------------------------
function LiveEvents.SetupPlayer(player: Player)
	giveGoalRewards(player)
	if creatorHere then
		giveCreatorGift(player)
	end
	if isCreator(player) then
		LiveEvents.CreatorArrived(player)
	end
	LiveEvents.SyncMerchant(player)
	checkRecord()
end

function LiveEvents.RemovePlayer(player: Player)
	votes[player] = nil
	if isCreator(player) then
		local still = false
		for _, other in Players:GetPlayers() do
			if other ~= player and isCreator(other) then
				still = true
			end
		end
		creatorHere = still
		workspace:SetAttribute("CreatorHere", if still then true else nil)
	end
end

function LiveEvents.Init()
	local folder = Instance.new("Folder")
	folder.Name = "Monsters"
	folder.Parent = workspace
	invasionFolder = folder
	local ok, map = pcall(function()
		return MemoryStoreService:GetSortedMap("GlobalGoal_v1")
	end)
	goalMap = if ok then map else nil
	local ok2, store = pcall(function()
		return DataStoreService:GetDataStore("GlobalGoal_v1")
	end)
	goalBackup = if ok2 then store else nil
	Players.PlayerRemoving:Connect(LiveEvents.RemovePlayer)

	local start = now()
	if Config.Invasion.Enabled ~= false then -- v25: sem relógio = sem invasão automática
		workspace:SetAttribute("NextInvasion", start + Config.Invasion.FirstAfter)
	end
	workspace:SetAttribute("NextVote", start + Config.Vote.FirstAfter)
	refreshHoliday()
	refreshMerchant()
	task.spawn(loadGlobal)

	-- relógio dos eventos (1 vez por segundo)
	task.spawn(function()
		local ticks = 0
		while true do
			task.wait(1)
			local ok, err = pcall(function()
				ticks += 1
				local t = now()
				local nextInvasion = workspace:GetAttribute("NextInvasion")
				if typeof(nextInvasion) == "number" and t >= nextInvasion then
					workspace:SetAttribute("NextInvasion", nextInvasion + Config.Invasion.Every)
					LiveEvents.StartInvasion()
				end
				local nextVote = workspace:GetAttribute("NextVote")
				if typeof(nextVote) == "number" and t >= nextVote then
					workspace:SetAttribute("NextVote", nextVote + Config.Vote.Every)
					LiveEvents.StartVote()
				end
				refreshMerchant()
				if ticks % 60 == 0 then
					refreshHoliday()
					task.spawn(syncGlobal)
					for _, player in Players:GetPlayers() do
						LiveEvents.SyncMerchant(player)
					end
				end
				if ticks % 600 == 0 then
					task.spawn(backupGlobal)
				end
			end)
			if not ok then
				warn("[LiveEvents] loop error:", err)
			end
		end
	end)

	-- monstros andando por aí
	task.spawn(function()
		while true do
			task.wait(0.5)
			local ok, err = pcall(function()
				local clock = os.clock()
				for model, monster in monsters do
					if not model.Parent then
						monsters[model] = nil
					elseif clock >= monster.NextMove then
						monster.NextMove = clock + 2 + math.random() * 2
						monster.Humanoid:MoveTo(wanderPoint())
					end
				end
			end)
			if not ok then
				warn("[LiveEvents] loop error:", err)
			end
		end
	end)
	CollectionService:GetInstanceRemovedSignal("Monster"):Connect(function(instance)
		monsters[instance :: Model] = nil
	end)
end

return LiveEvents
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="454">
        <Properties>
          <string name="Name">Minigames</string>
          <string name="Source"><![CDATA[--[[
	Minigames (ModuleScript em ServerScriptService > Game)
	Parte 23 (v12): HUB DE MINIGAMES na ilha ao norte do Meadow.
	  • A cada ~4 minutos: "OBBY RACE starting in 30s!" com botão JOIN (fila automática)
	  • Rodadas de 1 a 2 minutos e meio. Entrada GRÁTIS, sem aposta: só ganha quem joga.
	  • Jogos: Obby Race, King of the Hill, Critter Battle (Battle.luau), Cops & Robbers, Hide & Seek
	  • Todo mundo corre na MESMA velocidade (nada comprado ajuda) e a base de quem está jogando fica protegida
	  • Fim de semana (sábado e domingo, UTC): TORNEIO. Pontos no placar da ilha; 20 pontos = título "Weekend Champ"
	Estado para as telas: atributos do Workspace (MgState, MgGame, MgStarts, MgEnds, MgQueue, MgInfo)
	e do jogador (MgQueued, InMinigame, MgRole, MgSpeed).
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Registry = require(script.Parent.Registry)

local Minigames = {}

local SETTINGS = Config.Minigames

type PlayerState = { Score: number, Role: string, Alive: boolean, Progress: number, LastCheckpoint: BasePart?, Finished: boolean, LastX: number, LastAt: number }
type Round = {
	Id: string,
	Info: any,
	Players: { [Player]: PlayerState },
	Ended: boolean,
	GoAt: number,
	EndsAt: number,
	Finishers: { Player },
	StartCount: number,
	Coins: number,
	Goal: number,
	LastFree: number,
	CoinParts: { BasePart },
}

local respawnAt: { [BasePart]: CFrame } = {} -- chão embaixo de cada checkpoint da corrida
local state = "idle"
local queue: { [Player]: boolean } = {}
local round: Round? = nil
local nextAnnounce = 0
local announced: any = nil
local startsAt = 0

local function now(): number
	return workspace:GetServerTimeNow()
end

local function island(): Instance?
	local map = workspace:FindFirstChild("Map")
	return map and map:FindFirstChild("Minigames")
end

local function piece(gameName: string, name: string): BasePart?
	local root = island()
	local folder = root and root:FindFirstChild(gameName)
	local found = folder and folder:FindFirstChild(name)
	return if found and found:IsA("BasePart") then found else nil
end

local function getData(player: Player): any
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function publish()
	workspace:SetAttribute("MgState", state)
	workspace:SetAttribute("MgGame", if announced then announced.Id elseif round then round.Id else nil)
	local count = 0
	for _ in queue do
		count += 1
	end
	workspace:SetAttribute("MgQueue", count)
end

-- Leva o personagem (carrega o chão antes, por causa do StreamingEnabled)
local function sendTo(player: Player, cframe: CFrame)
	task.spawn(function()
		pcall(function()
			player:RequestStreamAroundAsync(cframe.Position, 3)
		end)
		local character = player.Character
		if character and character.Parent then
			character:PivotTo(cframe + Vector3.new(0, 3, 0))
		end
	end)
end

local function setSpeed(player: Player, speed: number)
	player:SetAttribute("MgSpeed", speed)
	Registry.Economy.ApplySpeed(player)
end

-- Esconde nome, título e pets (esconde-esconde) ou mostra de novo
local function setHidden(player: Player, hidden: boolean)
	player:SetAttribute("HidePets", if hidden then true else nil)
	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = if hidden then Enum.HumanoidDisplayDistanceType.None else Enum.HumanoidDisplayDistanceType.Viewer
	end
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BillboardGui") and (descendant.Name == "NameTag" or descendant.Name == "VipTag") then
			descendant.Enabled = not hidden
		elseif descendant:IsA("Trail") or (descendant:IsA("ParticleEmitter") and descendant.Name == "PrestigeAura") then
			descendant.Enabled = not hidden -- rastro e aura do prestígio entregariam o esconderijo
		end
	end
end

local function setHighlight(player: Player, color: Color3?)
	local character = player.Character
	if not character then
		return
	end
	local old = character:FindFirstChild("MgTeam")
	if old then
		old:Destroy()
	end
	if color then
		local highlight = Instance.new("Highlight")
		highlight.Name = "MgTeam"
		highlight.FillTransparency = 0.75
		highlight.OutlineColor = color
		highlight.FillColor = color
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.Parent = character
	end
end

local function roundNotify(text: string, kind: string?)
	if not round then
		return
	end
	for player in round.Players do
		if player.Parent then
			Registry.Remotes.Notify(player, text, kind)
		end
	end
end

local function info(value: any)
	if value == nil then
		workspace:SetAttribute("MgInfo", nil)
		return
	end
	local ok, json = pcall(function()
		return HttpService:JSONEncode(value)
	end)
	workspace:SetAttribute("MgInfo", if ok then json else nil)
end

---------------------------------------------------------------------
-- Torneio de fim de semana
---------------------------------------------------------------------
local tournamentStore: OrderedDataStore? = nil
local tournamentWeek = -1
local boardText: TextLabel? = nil

local function isWeekend(): boolean
	local day = os.date("!*t", os.time()).wday
	return day == 1 or day == 7 -- domingo ou sábado (UTC)
end

local function weekId(): number
	return math.floor((os.time() - 4 * 86400) / 604800) -- semanas começando na segunda (UTC)
end

local function addTournament(player: Player, points: number)
	if points <= 0 or not isWeekend() then
		return
	end
	local data = getData(player)
	if not data then
		return
	end
	if type(data.Tournament) ~= "table" or data.Tournament.Week ~= weekId() then
		data.Tournament = { Week = weekId(), Points = 0 }
	end
	data.Tournament.Points += points
	Registry.Remotes.Notify(player, ("+%d tournament points! (%d this weekend)"):format(points, data.Tournament.Points), "info")
	local total = math.floor(data.Tournament.Points)
	local store = tournamentStore
	if store and tournamentWeek == weekId() then
		task.spawn(function()
			pcall(function()
				(store :: OrderedDataStore):SetAsync("u_" .. player.UserId, total)
			end)
		end)
	end
	if data.Tournament.Points >= SETTINGS.ChampPoints and type(data.Style) == "table" and type(data.Style.Owned) == "table" and not data.Style.Owned["title:champ"] then
		local codes = Registry.Codes
		if codes then
			codes.Grant(player, { Cosmetic = "title:champ" })
			Registry.Remotes.Notify(player, "WEEKEND CHAMP! You unlocked the title \"Weekend Champ\" (see STYLE).", "rare")
		end
	end
end

local function refreshTournamentBoard()
	if not boardText then
		return
	end
	if not isWeekend() then
		boardText.Text = "WEEKEND TOURNAMENT\n\nStarts on Saturday!\nWin minigames on the weekend\nfor points. 20 points =\n\"Weekend Champ\" title."
		return
	end
	local week = weekId()
	if week ~= tournamentWeek then
		tournamentWeek = week
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore("Tournament_" .. week)
		end)
		tournamentStore = if ok then store else nil
	end
	local store = tournamentStore
	if not store then
		boardText.Text = "WEEKEND TOURNAMENT\n\n(only in the published game)"
		return
	end
	for _, player in Players:GetPlayers() do
		local data = getData(player)
		if data and type(data.Tournament) == "table" and data.Tournament.Week == week and data.Tournament.Points > 0 then
			pcall(function()
				store:SetAsync("u_" .. player.UserId, math.floor(data.Tournament.Points))
			end)
		end
	end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, 10)
	end)
	if not ok or not pages then
		return
	end
	local lines = { "WEEKEND TOURNAMENT" }
	for i, entry in pages:GetCurrentPage() do
		local id = tonumber(string.sub(entry.key, 3)) or 0
		local okName, name = pcall(function()
			return Players:GetNameFromUserIdAsync(id)
		end)
		table.insert(lines, ("#%d %s - %d"):format(i, if okName then name else "Player", entry.value))
	end
	if #lines == 1 then
		table.insert(lines, "\nBe the first! Win a minigame.")
	end
	boardText.Text = table.concat(lines, "\n")
end

---------------------------------------------------------------------
-- Prêmios
---------------------------------------------------------------------
local function grant(player: Player, minutes: number): string
	local codes = Registry.Codes
	if not codes or minutes <= 0 then
		return ""
	end
	local ok, parts = pcall(codes.Grant, player, { Minutes = minutes })
	return if ok and type(parts) == "table" then table.concat(parts, " + ") else ""
end

local function progressEvent(player: Player, kind: string)
	if Registry.Progress then
		Registry.Progress.Event(player, kind)
	end
end

---------------------------------------------------------------------
-- Entrar / sair
---------------------------------------------------------------------
function Minigames.Join(player: Player)
	if state ~= "announce" then
		return
	end
	if queue[player] then
		queue[player] = nil
		player:SetAttribute("MgQueued", nil)
		publish()
		return
	end
	local here = player:GetAttribute("World")
	if here ~= nil and here ~= "meadow" then
		Registry.Remotes.Notify(player, "Go back to Meadow Valley to join minigames (HOME button)!", "info")
		return
	end
	if Registry.CritterService.IsCarrying(player) then
		Registry.Remotes.Notify(player, "Put down what you're carrying first!", "warning")
		return
	end
	queue[player] = true
	player:SetAttribute("MgQueued", true)
	publish()
	Registry.Remotes.Notify(player, "You joined! Get ready...", "success")
end

-- Tira o jogador do minigame (fim da rodada, saiu, morreu)
local function release(player: Player, goHome: boolean)
	player:SetAttribute("InMinigame", nil)
	player:SetAttribute("MgRole", nil)
	player:SetAttribute("MgSpeed", nil)
	player:SetAttribute("MgProgress", nil)
	setHidden(player, false)
	setHighlight(player, nil)
	if player.Parent then
		Registry.Economy.ApplySpeed(player)
		local customize = Registry.Customize
		if customize then
			customize.RefreshTag(player)
		end
		if goHome then
			local plot = Registry.Plots.Get(player)
			if plot then
				sendTo(player, Registry.Plots.SpawnCFrame(plot))
			end
		end
	end
	local battle = Registry.Battle
	if battle then
		battle.Remove(player)
	end
end

---------------------------------------------------------------------
-- Fim da rodada
---------------------------------------------------------------------
local function finish(ranking: { Player }, winners: { [Player]: boolean }, title: string)
	local r = round
	if not r or r.Ended then
		return
	end
	r.Ended = true
	state = "results"
	publish()
	local lines = {}
	for place, player in ranking do
		if place <= 3 then
			table.insert(lines, ("%d. %s"):format(place, player.DisplayName))
		end
	end
	-- sozinho (ou só contra o Grumblob) é treino: ganha só a participação
	local competitive = r.StartCount >= 2
	local tournament = r.StartCount >= 3
	for player in r.Players do
		if player.Parent and player:GetAttribute("Loaded") then
			local place = table.find(ranking, player)
			local text
			if not competitive then
				text = grant(player, SETTINGS.Participation)
			elseif winners[player] then
				text = grant(player, SETTINGS.TeamWin)
				if tournament then
					addTournament(player, SETTINGS.TournamentWinPoints)
				end
				progressEvent(player, "MinigameWin")
			elseif place and place <= 3 and next(winners) == nil then
				text = grant(player, SETTINGS.Rewards[place])
				if tournament then
					addTournament(player, SETTINGS.TournamentPoints[place])
				end
				if place == 1 then
					progressEvent(player, "MinigameWin")
				end
			else
				text = grant(player, SETTINGS.Participation)
			end
			progressEvent(player, "Minigame")
			Registry.Remotes.Popup(
				player,
				title,
				(if #lines > 0 then table.concat(lines, "\n") .. "\n\n" else "")
					.. "You got: "
					.. text
					.. (if competitive then "" else "\n(Practice round: play with 2+ players to win prizes!)")
			)
		end
	end
	task.delay(SETTINGS.Results, function()
		for player in r.Players do
			if player.Parent then
				release(player, true)
			end
		end
		table.clear(r.Players)
		for _, coin in r.CoinParts do
			coin:Destroy()
		end
		if round == r then
			round = nil
		end
		state = "idle"
		nextAnnounce = now() + SETTINGS.Gap
		info(nil)
		workspace:SetAttribute("MgEnds", nil)
		publish()
	end)
end

local function alivePlayers(r: Round): { Player }
	local list = {}
	for player in r.Players do
		if player.Parent then
			table.insert(list, player)
		end
	end
	return list
end

local function spread(center: CFrame, index: number, total: number, radius: number): CFrame
	local angle = (index / math.max(total, 1)) * math.pi * 2
	local position = center.Position + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
	return CFrame.lookAt(position, Vector3.new(center.Position.X, position.Y, center.Position.Z))
end

local function countdown(r: Round, seconds: number, speedAfter: number?)
	r.GoAt = now() + seconds
	workspace:SetAttribute("MgCountdown", r.GoAt)
	for player in r.Players do
		setSpeed(player, 0)
	end
	task.delay(seconds, function()
		if round == r and not r.Ended then
			for player in r.Players do
				if player.Parent and player:GetAttribute("MgRole") ~= "Seeker" then
					setSpeed(player, speedAfter or SETTINGS.Speed)
				end
			end
		end
	end)
end

---------------------------------------------------------------------
-- OBBY RACE
---------------------------------------------------------------------
local function startRace(r: Round)
	local start = piece("Race", "Start")
	if not start then
		finish({}, {}, "RACE")
		return
	end
	local list = alivePlayers(r)
	for index, player in list do
		local column = (index - 1) % 4
		local row = math.floor((index - 1) / 4)
		sendTo(player, CFrame.new(start.Position + Vector3.new(-4 + row * 3, 1, -7.5 + column * 5)) * CFrame.Angles(0, -math.pi / 2, 0))
		r.Players[player].LastCheckpoint = start
		r.Players[player].LastX = start.Position.X
	end
	countdown(r, 4)
	task.spawn(function()
		while round == r and not r.Ended do
			task.wait(0.3)
			for player, ps in r.Players do
				local root = rootOf(player)
				if root and not ps.Finished and root.Position.Y < 5 then
					local checkpoint = ps.LastCheckpoint or start
					root.AssemblyLinearVelocity = Vector3.zero
					local spot = respawnAt[checkpoint] or CFrame.new(checkpoint.Position.X, checkpoint.Position.Y + checkpoint.Size.Y / 2 + 3, checkpoint.Position.Z)
					player.Character:PivotTo(spot * CFrame.Angles(0, -math.pi / 2, 0))
				end
			end
			local total, done = 0, 0
			for player, ps in r.Players do
				if player.Parent then
					total += 1
					if ps.Finished then
						done += 1
					end
				end
			end
			if total == 0 or done >= total or now() >= r.EndsAt then
				finish(table.clone(r.Finishers), {}, "OBBY RACE RESULTS") -- prêmios só para quem chegou
			end
		end
	end)
end

local function onRaceTouch(player: Player, part: BasePart)
	local r = round
	local ps = r and r.Id == "Race" and not r.Ended and r.Players[player]
	if not r or not ps or ps.Finished or now() < r.GoAt then
		return
	end
	local number = tonumber(string.match(part.Name, "^CP(%d+)$"))
	-- contra teleporte: tem que levar pelo menos o tempo de correr até ali (com folga)
	local startAt = if ps.Progress == 0 then r.GoAt else ps.LastAt
	local tooFast = now() - startAt < math.abs(part.Position.X - ps.LastX) / (SETTINGS.Speed * 1.35)
	if tooFast then
		return
	end
	if number and number == ps.Progress + 1 then
		ps.LastX = part.Position.X
		ps.LastAt = now()
		ps.Progress = number
		ps.LastCheckpoint = part
		player:SetAttribute("MgProgress", number)
		Registry.Remotes.Notify(player, ("Checkpoint %d/4!"):format(number), "info")
	elseif part.Name == "Finish" and ps.Progress >= 4 then
		ps.Finished = true
		table.insert(r.Finishers, player)
		local place = #r.Finishers
		setSpeed(player, 0)
		roundNotify(("%s finished #%d!"):format(player.DisplayName, place), if place <= 3 then "rare" else "info")
	end
end

---------------------------------------------------------------------
-- KING OF THE HILL
---------------------------------------------------------------------
local function scoreRanking(r: Round): { Player }
	local list = {}
	for player, ps in r.Players do
		if player.Parent and ps.Score > 0 then
			table.insert(list, player)
		end
	end
	table.sort(list, function(a, b)
		return r.Players[a].Score > r.Players[b].Score
	end)
	return list
end

local function startKing(r: Round)
	local center = piece("King", "Center")
	local zone = piece("King", "Zone")
	if not center or not zone then
		finish({}, {}, "KING OF THE HILL")
		return
	end
	local list = alivePlayers(r)
	for index, player in list do
		sendTo(player, spread(CFrame.new(center.Position), index, #list, 38))
	end
	countdown(r, 4)
	task.spawn(function()
		local ticks = 0
		while round == r and not r.Ended do
			task.wait(0.25)
			ticks += 1
			if now() >= r.GoAt then
				for player, ps in r.Players do
					local root = rootOf(player)
					if root then
						local offset = root.Position - zone.Position
						if Vector3.new(offset.X, 0, offset.Z).Magnitude <= 7.5 and offset.Y > -1 and offset.Y < 9 then
							ps.Score += 0.25
						end
					end
				end
			end
			if ticks % 4 == 0 then
				local top = {}
				for _, player in scoreRanking(r) do
					if #top < 5 then
						table.insert(top, { N = player.DisplayName, S = math.floor(r.Players[player].Score) })
					end
				end
				info({ Top = top })
			end
			if #alivePlayers(r) == 0 or now() >= r.EndsAt then
				finish(scoreRanking(r), {}, "KING OF THE HILL RESULTS")
			end
		end
	end)
end

---------------------------------------------------------------------
-- COPS & ROBBERS
---------------------------------------------------------------------
local function randomPoint(area: BasePart): Vector3
	local size = area.Size
	return area.Position + Vector3.new((math.random() - 0.5) * (size.X - 12), 2.5, (math.random() - 0.5) * (size.Z - 12))
end

local function spawnCoin(r: Round, area: BasePart)
	local coin = Instance.new("Part")
	coin.Name = "MgCoin"
	coin.Shape = Enum.PartType.Cylinder
	coin.Size = Vector3.new(0.5, 3, 3)
	coin.Color = Color3.fromRGB(255, 205, 60)
	coin.Material = Enum.Material.Neon
	coin.Anchored = true
	coin.CanCollide = false
	coin.CFrame = CFrame.new(randomPoint(area)) * CFrame.Angles(0, 0, math.pi / 2)
	coin:AddTag("Spin")
	coin.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		local ps = player and r.Players[player]
		if not ps or r.Ended or round ~= r or ps.Role ~= "Robber" or not ps.Alive or not coin.Parent then
			return
		end
		coin:Destroy()
		ps.Score += 1
		r.Coins += 1
		info({ Coins = r.Coins, Goal = r.Goal })
		if r.Coins >= r.Goal then
			return
		end
		task.delay(2, function()
			if round == r and not r.Ended then
				spawnCoin(r, area)
			end
		end)
	end)
	coin.Parent = island()
	table.insert(r.CoinParts, coin)
end

local function teamRanking(r: Round, role: string): { Player }
	local list = {}
	for player, ps in r.Players do
		if player.Parent and ps.Role == role then
			table.insert(list, player)
		end
	end
	table.sort(list, function(a, b)
		return r.Players[a].Score > r.Players[b].Score
	end)
	return list
end

local function endTeams(r: Round, winningRole: string, title: string)
	local winners = {}
	local ranking = teamRanking(r, winningRole)
	for _, player in ranking do
		winners[player] = true
	end
	finish(ranking, winners, title)
end

local function startCops(r: Round)
	local area = piece("Playground", "Area")
	local copSpawn = piece("Playground", "CopSpawn")
	local robberSpawn = piece("Playground", "RobberSpawn")
	if not area or not copSpawn or not robberSpawn then
		finish({}, {}, "COPS & ROBBERS")
		return
	end
	local list = alivePlayers(r)
	for i = #list, 2, -1 do
		local j = math.random(1, i)
		list[i], list[j] = list[j], list[i]
	end
	local cops = math.max(1, math.floor(#list / 3))
	local robbers = #list - cops
	for index, player in list do
		local ps = r.Players[player]
		ps.Role = if index <= cops then "Cop" else "Robber"
		player:SetAttribute("MgRole", ps.Role)
		setHighlight(player, if ps.Role == "Cop" then Color3.fromRGB(70, 140, 255) else Color3.fromRGB(255, 150, 60))
		local spawnPart = if ps.Role == "Cop" then copSpawn else robberSpawn
		sendTo(player, CFrame.new(spawnPart.Position + Vector3.new(math.random(-8, 8), 1, math.random(-8, 8))))
	end
	r.Goal = 10 + 2 * robbers
	info({ Coins = 0, Goal = r.Goal })
	countdown(r, 4)
	for _ = 1, 12 do
		spawnCoin(r, area)
	end
	task.spawn(function()
		while round == r and not r.Ended do
			task.wait(0.5)
			local free = 0
			local robbersLeft = 0
			for player, ps in r.Players do
				if player.Parent and ps.Role == "Robber" then
					robbersLeft += 1
					if ps.Alive then
						free += 1
					end
				end
			end
			if r.Coins >= r.Goal then
				endTeams(r, "Robber", "ROBBERS WIN! (all the coins)")
			elseif robbersLeft == 0 or free == 0 then
				endTeams(r, "Cop", "COPS WIN! (everyone in jail)")
			elseif #teamRanking(r, "Cop") == 0 then
				endTeams(r, "Robber", "ROBBERS WIN!")
			elseif now() >= r.EndsAt then
				endTeams(r, "Robber", "ROBBERS WIN! (time's up)")
			end
		end
	end)
end

local function onJailButton(player: Player)
	local r = round
	local ps = r and r.Id == "Cops" and not r.Ended and r.Players[player]
	if not r or not ps or ps.Role ~= "Robber" or not ps.Alive or os.clock() - r.LastFree < 8 then
		return
	end
	local robberSpawn = piece("Playground", "RobberSpawn")
	local freed = 0
	for other, otherState in r.Players do
		if otherState.Role == "Robber" and not otherState.Alive and other.Parent and robberSpawn then
			otherState.Alive = true
			freed += 1
			sendTo(other, CFrame.new(robberSpawn.Position + Vector3.new(math.random(-6, 6), 1, math.random(-6, 6))))
		end
	end
	if freed > 0 then
		r.LastFree = os.clock()
		roundNotify(("%s opened the jail! %d robbers are free!"):format(player.DisplayName, freed), "rare")
	end
end

---------------------------------------------------------------------
-- HIDE & SEEK
---------------------------------------------------------------------
local SEEKER_WAIT = 15

local function startHide(r: Round)
	local area = piece("Playground", "Area")
	local seekerSpot = piece("Playground", "SeekerSpot")
	if not area or not seekerSpot then
		finish({}, {}, "HIDE & SEEK")
		return
	end
	local list = alivePlayers(r)
	local seeker = list[math.random(1, #list)]
	for _, player in list do
		local ps = r.Players[player]
		ps.Role = if player == seeker then "Seeker" else "Hider"
		player:SetAttribute("MgRole", ps.Role)
		if ps.Role == "Seeker" then
			sendTo(player, CFrame.new(seekerSpot.Position))
			setHighlight(player, Color3.fromRGB(255, 70, 70))
		else
			setHidden(player, true)
			sendTo(player, CFrame.new(randomPoint(area)))
		end
	end
	countdown(r, 3)
	setSpeed(seeker, 0)
	workspace:SetAttribute("MgSeekerAt", now() + SEEKER_WAIT)
	info({ Hiders = #list - 1, Found = 0 })
	task.delay(SEEKER_WAIT, function()
		if round == r and not r.Ended and seeker.Parent then
			sendTo(seeker, CFrame.new(area.Position + Vector3.new(0, 1, 0)))
			setSpeed(seeker, SETTINGS.Speed + 3)
			roundNotify("READY OR NOT, HERE I COME! The seeker is out!", "warning")
		end
	end)
	task.spawn(function()
		while round == r and not r.Ended do
			task.wait(0.5)
			local hiders, hidden = 0, 0
			local seekerHere = false
			for player, ps in r.Players do
				if player.Parent then
					if ps.Role == "Hider" then
						hiders += 1
						if ps.Alive then
							hidden += 1
						end
					elseif ps.Role == "Seeker" then
						seekerHere = true
					end
				end
			end
			info({ Hiders = hiders, Found = hiders - hidden })
			if hiders > 0 and hidden == 0 then
				endTeams(r, "Seeker", "THE SEEKER FOUND EVERYONE!")
			elseif not seekerHere or hiders == 0 or now() >= r.EndsAt then
				local winners = {}
				local ranking = {}
				for player, ps in r.Players do
					if player.Parent and ps.Role == "Hider" and ps.Alive then
						winners[player] = true
						table.insert(ranking, player)
					end
				end
				finish(ranking, winners, "HIDERS WIN!")
			end
		end
	end)
end

---------------------------------------------------------------------
-- CRITTER BATTLE
---------------------------------------------------------------------
local function startBattle(r: Round)
	local spot = piece("Battle", "Spot")
	local list = alivePlayers(r)
	if spot then
		for index, player in list do
			sendTo(player, spread(CFrame.new(spot.Position), index, #list, 12))
		end
	end
	for player in r.Players do
		setSpeed(player, 0)
	end
	task.spawn(function()
		local winners, _ = Registry.Battle.Run(list, r.Info.Duration - 5) -- vitória contra o Grumblob não conta
		if round ~= r or r.Ended then
			return
		end
		local set = {}
		for _, player in winners do
			set[player] = true
		end
		finish(winners, set, "CRITTER BATTLE RESULTS")
	end)
end

---------------------------------------------------------------------
-- Pancadas (o Combat pergunta antes de empurrar)
---------------------------------------------------------------------
local function roleOf(player: Player): string?
	local r = round
	local ps = r and r.Players[player]
	return ps and ps.Role
end

function Minigames.BonkAllowed(attacker: Player, victim: Player): boolean
	local a = attacker:GetAttribute("InMinigame")
	local v = victim:GetAttribute("InMinigame")
	if a == nil and v == nil then
		return true -- mundo normal
	end
	local r = round
	if a ~= v or not r or r.Ended then
		return false
	end
	if r.Id == "King" then
		return true
	elseif r.Id == "Cops" then
		local ra, rv = roleOf(attacker), roleOf(victim)
		local psv = r.Players[victim]
		return (ra == "Cop" and rv == "Robber" and psv ~= nil and psv.Alive) or (ra == "Robber" and rv == "Cop")
	elseif r.Id == "Hide" then
		local psv = r.Players[victim]
		return roleOf(attacker) == "Seeker" and roleOf(victim) == "Hider" and psv ~= nil and psv.Alive and now() >= r.GoAt
	end
	return false
end

function Minigames.OnBonk(attacker: Player, victim: Player)
	local r = round
	if not r or r.Ended then
		return
	end
	local psa, psv = r.Players[attacker], r.Players[victim]
	if not psa or not psv then
		return
	end
	if r.Id == "Cops" and psa.Role == "Cop" and psv.Role == "Robber" and psv.Alive then
		psv.Alive = false
		psa.Score += 1
		local jail = piece("Playground", "JailSpot")
		if jail then
			task.delay(0.2, function()
				sendTo(victim, CFrame.new(jail.Position))
			end)
		end
		roundNotify(("%s was caught by %s!"):format(victim.DisplayName, attacker.DisplayName), "warning")
	elseif r.Id == "Hide" and psa.Role == "Seeker" and psv.Role == "Hider" and psv.Alive then
		psv.Alive = false
		psa.Score += 1
		setHidden(victim, false)
		local stands = piece("Playground", "StandsSpot")
		if stands then
			task.delay(0.2, function()
				sendTo(victim, CFrame.new(stands.Position))
			end)
		end
		roundNotify(("Found %s!"):format(victim.DisplayName), "warning")
	end
end

---------------------------------------------------------------------
-- Ciclo: anuncia -> joga -> resultado -> espera
---------------------------------------------------------------------
local STARTERS = { Race = startRace, King = startKing, Cops = startCops, Hide = startHide, Battle = startBattle }

local function loadedCount(): number
	local count = 0
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("Loaded") then
			count += 1
		end
	end
	return count
end

local forced = false

function Minigames.Announce(gameId: string?, force: boolean?)
	if state ~= "idle" then
		return
	end
	forced = force == true -- admin: começa mesmo com pouca gente (para testar)
	local online = loadedCount()
	local pick = if gameId then Config.MinigameById[gameId] else nil
	if not pick then
		local total = 0
		for _, info2 in SETTINGS.Games do
			if info2.Min <= online then
				total += info2.Weight
			end
		end
		local roll = math.random() * total
		for _, info2 in SETTINGS.Games do
			if info2.Min <= online then
				roll -= info2.Weight
				if roll <= 0 then
					pick = info2
					break
				end
			end
		end
	end
	if not pick then
		nextAnnounce = now() + 60
		return
	end
	announced = pick
	state = "announce"
	startsAt = now() + SETTINGS.Announce
	workspace:SetAttribute("MgStarts", startsAt)
	table.clear(queue)
	publish()
	Registry.Remotes.NotifyAll(("%s starting in %ds! Tap JOIN at the top of the screen."):format(string.upper(pick.Name), SETTINGS.Announce), "rare")
	Registry.Remotes.EffectAll("MinigameAnnounce", pick.Id)
end

local function start()
	local pick = announced
	announced = nil
	local players = {}
	for player in queue do
		local here = player:GetAttribute("World")
		if player.Parent and player:GetAttribute("Loaded") and not Registry.CritterService.IsCarrying(player) and (here == nil or here == "meadow") then
			table.insert(players, player)
		end
		player:SetAttribute("MgQueued", nil)
	end
	table.clear(queue)
	if not pick or #players == 0 or (#players < pick.Min and not forced) then
		state = "idle"
		nextAnnounce = now() + 45
		publish()
		if pick then
			Registry.Remotes.NotifyAll(("Not enough players joined %s (needs %d). Next minigame soon!"):format(pick.Name, pick.Min), "info")
		end
		return
	end
	local r: Round = {
		Id = pick.Id,
		Info = pick,
		Players = {},
		Ended = false,
		GoAt = now(),
		EndsAt = now() + pick.Duration,
		Finishers = {},
		StartCount = #players,
		Coins = 0,
		Goal = 0,
		LastFree = 0,
		CoinParts = {},
	}
	for _, player in players do
		r.Players[player] = { Score = 0, Role = "Player", Alive = true, Progress = 0, LastCheckpoint = nil, Finished = false, LastX = 0, LastAt = 0 }
		player:SetAttribute("InMinigame", pick.Id)
		player:SetAttribute("MgRole", "Player")
	end
	round = r
	state = "play"
	workspace:SetAttribute("MgEnds", r.EndsAt)
	publish()
	for player in r.Players do
		Registry.Remotes.Notify(player, pick.Desc, "info")
	end
	STARTERS[pick.Id](r)
end

-- Personagem novo (resetou/morreu): sai do minigame
function Minigames.OnCharacter(player: Player)
	local r = round
	if r and r.Players[player] then
		r.Players[player] = nil
		release(player, false)
	end
end

function Minigames.RemovePlayer(player: Player)
	queue[player] = nil
	local r = round
	if r then
		r.Players[player] = nil
	end
	local battle = Registry.Battle
	if battle then
		battle.Remove(player)
	end
	publish()
end

function Minigames.Init()
	Players.PlayerRemoving:Connect(Minigames.RemovePlayer)
	nextAnnounce = now() + SETTINGS.FirstAfter
	publish()
	task.spawn(function()
		local root = workspace:WaitForChild("Map"):WaitForChild("Minigames", 30)
		if not root then
			warn("[Minigames] Map.Minigames not found: minigames are off")
			return
		end
		-- corrida: checkpoints e chegada
		local race = root:FindFirstChild("Race")
		if race then
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = { race }
			for _, child in race:GetChildren() do
				if child:IsA("BasePart") and (string.match(child.Name, "^CP%d+$") or child.Name == "Start") then
					local hit = workspace:Raycast(Vector3.new(child.Position.X, 60, child.Position.Z), Vector3.new(0, -80, 0), params)
					if hit then
						respawnAt[child] = CFrame.new(hit.Position + Vector3.new(0, 3.5, 0))
					end
				end
			end
			for _, child in race:GetChildren() do
				if child:IsA("BasePart") and (string.match(child.Name, "^CP%d+$") or child.Name == "Finish") then
					child.Touched:Connect(function(hit)
						local player = Players:GetPlayerFromCharacter(hit.Parent)
						if player then
							onRaceTouch(player, child)
						end
					end)
				end
			end
		end
		local button = piece("Playground", "JailButton")
		if button then
			button.Touched:Connect(function(hit)
				local player = Players:GetPlayerFromCharacter(hit.Parent)
				if player then
					onJailButton(player)
				end
			end)
		end
		-- placar do torneio
		local board = root:FindFirstChild("TournamentBoard") :: BasePart?
		if board then
			local surface = Instance.new("SurfaceGui")
			surface.Face = Enum.NormalId.Back
			surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			surface.PixelsPerStud = 25
			surface.LightInfluence = 0
			local text = Instance.new("TextLabel")
			text.Size = UDim2.new(1, -30, 1, -30)
			text.Position = UDim2.fromOffset(15, 15)
			text.BackgroundTransparency = 1
			text.Font = Enum.Font.FredokaOne
			text.TextScaled = true
			text.TextColor3 = Color3.fromRGB(255, 225, 120)
			text.Text = ""
			text.Parent = surface
			surface.Parent = board
			boardText = text
		end
		while true do
			local ok, err = pcall(function()
				refreshTournamentBoard()
			end)
			if not ok then
				warn("[Minigames] loop error:", err)
			end
			task.wait(60)
		end
	end)
	-- relógio do ciclo (+ vigia: quem saiu da ilha no meio da rodada sai do minigame)
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(function()
				local r = round
				if r and not r.Ended and now() > r.GoAt + 3 then
					for player in r.Players do
						local rootPart = rootOf(player)
						if rootPart and math.abs(rootPart.Position.Z - (-1000)) > 200 then
							r.Players[player] = nil
							release(player, false)
						end
					end
				end
				local t = now()
				if state == "idle" and t >= nextAnnounce then
					Minigames.Announce(nil)
				elseif state == "announce" and t >= startsAt then
					start()
				end
			end)
			if not ok then
				warn("[Minigames] loop error:", err)
			end
		end
	end)
end

return Minigames
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="455">
        <Properties>
          <string name="Name">Mounts</string>
          <string name="Source"><![CDATA[--[[
	Mounts (ModuleScript em ServerScriptService > Game)
	Parte 22 (v13): MONTARIAS. Todas grátis, destravam pelo nível da conta (Config.Mounts):
	  • Skateboard (nível 1, +15% velocidade)  • Go-Kart (nível 5, +25%)  • Critter Ride (nível 12, +30%: você anda
	    em cima do seu melhor pet equipado)
	Regras: desce sozinho ao carregar um bichinho roubado ou entrar num minigame (não dá vantagem no roubo).
	O modelo é só visual (preso no personagem, sem colisão); a velocidade é do servidor (Economy.ApplySpeed).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Critters = require(ReplicatedStorage.Shared.Critters)
local Builder = require(ReplicatedStorage.Shared.CritterBuilder)
local Models3D = require(ReplicatedStorage.Shared.Models3D)
local Registry = require(script.Parent.Registry)

local Mounts = {}

local LIFT = { skate = 0.5, cart = 1.4, critter = 2.6 } -- quanto o personagem sobe (HipHeight)

local function part(name: string, size: Vector3, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	if shape then
		p.Shape = shape
	end
	return p
end

-- Monta o modelo com o centro em (0,0,0), frente para -Z
local function buildModel(id: string, player: Player): Model?
	-- modelo 3D (ReplicatedStorage > Models3D > skate / cart), se existir
	if id == "skate" or id == "cart" then
		local mesh, height = Models3D.Get(id, { Size = if id == "skate" then 4.4 else 5.4, Fit = "Max", Anchored = false })
		if mesh then
			-- pés em cima do skate (topo) ou sentado no meio do kart
			local topY = if id == "skate" then height - 0.1 else height * 0.55
			mesh:PivotTo(CFrame.new(0, -topY + 0.125, 0))
			mesh.WorldPivot = CFrame.identity
			mesh.Name = "Mount"
			return mesh
		end
	end
	local model = Instance.new("Model")
	model.Name = "Mount"
	if id == "skate" then
		local deck = part("Deck", Vector3.new(1.8, 0.25, 4.2), Color3.fromRGB(255, 120, 60), Enum.Material.WoodPlanks)
		deck.CFrame = CFrame.new()
		deck.Parent = model
		for _, x in { -0.65, 0.65 } do
			for _, z in { -1.5, 1.5 } do
				local wheel = part("Wheel", Vector3.new(0.4, 0.55, 0.55), Color3.fromRGB(40, 40, 50), nil, Enum.PartType.Cylinder)
				wheel.CFrame = CFrame.new(x, -0.3, z)
				wheel.Parent = model
			end
		end
		model.PrimaryPart = deck
	elseif id == "cart" then
		local body = part("Body", Vector3.new(3.4, 1.2, 5.2), Color3.fromRGB(230, 50, 60))
		body.CFrame = CFrame.new(0, 0, 0)
		body.Parent = model
		local seat = part("Seat", Vector3.new(2.2, 0.5, 2), Color3.fromRGB(30, 30, 40))
		seat.CFrame = CFrame.new(0, 0.8, 0.6)
		seat.Parent = model
		local nose = part("Nose", Vector3.new(3, 0.8, 1), Color3.fromRGB(255, 220, 60))
		nose.CFrame = CFrame.new(0, 0.1, -2.8)
		nose.Parent = model
		for _, x in { -1.9, 1.9 } do
			for _, z in { -1.8, 1.8 } do
				local wheel = part("Wheel", Vector3.new(0.7, 1.3, 1.3), Color3.fromRGB(30, 30, 35), nil, Enum.PartType.Cylinder)
				wheel.CFrame = CFrame.new(x, -0.4, z)
				wheel.Parent = model
			end
		end
		model.PrimaryPart = body
	elseif id == "critter" then
		-- o melhor pet equipado (ou o bichinho mais raro da base)
		local attribute = player:GetAttribute("Pets")
		local first = if typeof(attribute) == "string" then string.split(attribute, ",")[1] else nil
		local critterId, mutation = nil, nil
		if first and first ~= "" then
			critterId, mutation = string.match(first, "^([^:]+):?(.*)$")
		end
		local def = critterId and Critters.ById[critterId] or Critters.ById.fluffo
		local critter = Builder.Build(def)
		if mutation and mutation ~= "" then
			Builder.ApplyMutation(critter, mutation)
		end
		local aura = critter:FindFirstChild("Aura")
		if aura then
			aura:Destroy()
		end
		local _, size = critter:GetBoundingBox()
		pcall(function()
			critter:ScaleTo(math.clamp(3.2 / math.max(size.Y, 0.1), 0.3, 2.5))
		end)
		for _, descendant in critter:GetDescendants() do
			if descendant:IsA("BasePart") then
				descendant.CanCollide = false
				descendant.CanQuery = false
				descendant.CanTouch = false
				descendant.Massless = true
				descendant.Anchored = false
			end
		end
		critter:PivotTo(CFrame.new())
		return critter
	else
		model:Destroy()
		return nil
	end
	return model
end

local function insideAnyBase(player: Player): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return false
	end
	for _, plot in Registry.Plots.All() do
		if Registry.Plots.IsInside(plot, root.Position) then
			return true
		end
	end
	return false
end

function Mounts.Dismount(player: Player)
	local current = player:GetAttribute("Mounted")
	player:SetAttribute("Mounted", nil)
	local character = player.Character
	if character then
		local old = character:FindFirstChild("Mount")
		if old then
			old:Destroy()
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local baseHip = character:GetAttribute("BaseHip")
		if humanoid and typeof(baseHip) == "number" then
			humanoid.HipHeight = baseHip
		end
	end
	if current then
		Registry.Economy.ApplySpeed(player)
	end
end

function Mounts.Ride(player: Player, id: any)
	if id == "off" or id == nil then
		Mounts.Dismount(player)
		return
	end
	local mount = typeof(id) == "string" and Config.MountById[id]
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not mount or not root or not humanoid or not player:GetAttribute("Loaded") then
		return
	end
	local level = if Registry.Progress then Registry.Progress.Level(player) else 1
	if level < mount.Level then
		Registry.Remotes.Notify(player, ("%s unlocks at level %d (you are level %d)."):format(mount.Name, mount.Level, level), "info")
		return
	end
	if player:GetAttribute("InMinigame") or Registry.CritterService.IsCarrying(player) or insideAnyBase(player) then
		Registry.Remotes.Notify(player, "You can't ride right now! (not inside bases, minigames or while carrying)", "info")
		return
	end
	Mounts.Dismount(player)
	local model = buildModel(mount.Id, player)
	if not model then
		return
	end
	if typeof(character:GetAttribute("BaseHip")) ~= "number" then
		character:SetAttribute("BaseHip", humanoid.HipHeight)
	end
	local baseHip = character:GetAttribute("BaseHip") :: number
	humanoid.HipHeight = baseHip + (LIFT[mount.Id] or 0)
	-- embaixo dos pés: a raiz fica HipHeight + metade dela acima do chão
	local below = humanoid.HipHeight + root.Size.Y / 2 - (LIFT[mount.Id] or 0) * 0.55
	model:PivotTo(root.CFrame * CFrame.new(0, -below, 0))
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = descendant
			weld.Parent = descendant
		end
	end
	model.Name = "Mount"
	model.Parent = character
	player:SetAttribute("Mounted", mount.Id)
	Registry.Economy.ApplySpeed(player)
end

-- Velocidade extra (Economy.ApplySpeed pergunta)
function Mounts.SpeedMultiplier(player: Player): number
	local id = player:GetAttribute("Mounted")
	local mount = typeof(id) == "string" and Config.MountById[id]
	return if mount then mount.Speed else 1
end

function Mounts.Init()
	local function watch(player: Player)
		-- personagem novo começa a pé (limpa ANTES de o novo nascer, senão a velocidade da montaria sobrava)
		player.CharacterRemoving:Connect(function()
			player:SetAttribute("Mounted", nil)
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	-- desce sozinho: carregando bichinho roubado, em minigame ou dentro de uma base
	-- (dentro da base os pés precisam tocar no COLLECT e no LOCK BASE)
	task.spawn(function()
		while true do
			task.wait(0.4)
			local ok, err = pcall(function()
				for _, player in Players:GetPlayers() do
					if player:GetAttribute("Mounted") then
						if player:GetAttribute("InMinigame") or Registry.CritterService.IsCarrying(player) then
							Mounts.Dismount(player)
						elseif insideAnyBase(player) then
							Mounts.Dismount(player)
							Registry.Remotes.Notify(player, "No riding inside bases! You hopped off.", "info")
						end
					end
				end
			end)
			if not ok then
				warn("[Mounts] loop error:", err)
			end
		end
	end)
end

return Mounts
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="456">
        <Properties>
          <string name="Name">NPCService</string>
          <string name="Source"><![CDATA[--[[
	NPCService (ModuleScript em ServerScriptService > Game)
	v14: coloca o mascote SNEAKY e os ajudantes no mapa (lista em ReplicatedStorage > Shared > NPCs).
	  • Se existir modelo 3D em ReplicatedStorage > Models3D > <Id>, usa ele (feito no Higgsfield).
	  • Senão, monta um boneco com peças (nunca fica vazio).
	  • Cada um tem nome em cima e o botão "Talk" (ProximityPrompt). A conversa é só na tela
	    de quem apertou (NpcUI) e não dá prêmio nenhum: por isso não precisa de RemoteEvent.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NPCs = require(ReplicatedStorage.Shared.NPCs)
local Models3D = require(ReplicatedStorage.Shared.Models3D)

local NPCService = {}

local rgb = Color3.fromRGB
local V = Vector3.new

local DEFAULT_HEIGHT = { raccoon = 6.5, person = 5.6 }
local SKIN = rgb(255, 205, 160)
local DARK = rgb(30, 25, 35)

local function part(name: string, size: Vector3, cframe: CFrame, color: Color3, shape: Enum.PartType?, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	if shape == Enum.PartType.Ball then
		local d = math.min(size.X, size.Y, size.Z)
		size = V(d, d, d)
	end
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	if shape then
		p.Shape = shape
	end
	return p
end

-- peça esticada em forma de ovo/elipse
local function blob(name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = part(name, size, cframe, color, nil, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

---------------------------------------------------------------------
-- Bonecos de peças (usados quando não tem modelo 3D). Pés em y = 0, frente para -Z.
---------------------------------------------------------------------
local function buildPerson(npc: any, model: Model)
	local shirt: Color3 = npc.Shirt or rgb(80, 160, 255)
	local hair: Color3 = npc.Hair or rgb(90, 60, 40)
	local skin: Color3 = npc.Skin or SKIN
	local pants: Color3 = npc.Pants or rgb(55, 65, 95)
	for _, x in { -0.5, 0.5 } do
		part("Leg", V(0.9, 2, 0.95), CFrame.new(x, 1, 0), pants).Parent = model
		blob("Shoe", V(1, 0.5, 1.3), CFrame.new(x, 0.25, -0.15), DARK).Parent = model
		local arm = part("Arm", V(0.75, 1.9, 0.8), CFrame.new(x * 3, 3.05, 0) * CFrame.Angles(0, 0, math.rad(-8 * x * 2)), shirt)
		arm.Parent = model
		part("Hand", V(0.7, 0.7, 0.7), CFrame.new(x * 3.2, 1.95, 0), skin, Enum.PartType.Ball).Parent = model
	end
	part("Torso", V(2.2, 2.1, 1.15), CFrame.new(0, 3.05, 0), shirt).Parent = model
	part("Head", V(1.95, 1.95, 1.95), CFrame.new(0, 5.1, 0), skin, Enum.PartType.Ball).Parent = model
	part("Hair", V(2.05, 2.05, 2.05), CFrame.new(0, 5.35, 0.12), hair, Enum.PartType.Ball).Parent = model
	for _, x in { -0.38, 0.38 } do
		part("Eye", V(0.3, 0.3, 0.3), CFrame.new(x, 5.12, -0.9), DARK, Enum.PartType.Ball).Parent = model
	end
	blob("Smile", V(0.55, 0.14, 0.12), CFrame.new(0, 4.7, -0.93), rgb(170, 60, 70)).Parent = model
	blob("Blush", V(0.3, 0.16, 0.08), CFrame.new(-0.62, 4.85, -0.8), rgb(255, 150, 160)).Parent = model
	blob("Blush", V(0.3, 0.16, 0.08), CFrame.new(0.62, 4.85, -0.8), rgb(255, 150, 160)).Parent = model
end

local function buildRaccoon(_npc: any, model: Model)
	local gray, light, dark = rgb(150, 150, 160), rgb(235, 235, 240), rgb(45, 45, 55)
	blob("Body", V(3.1, 3.2, 2.9), CFrame.new(0, 2.05, 0), gray).Parent = model
	blob("Belly", V(2.2, 2.3, 1), CFrame.new(0, 1.95, -1.05), light).Parent = model
	for _, x in { -0.75, 0.75 } do
		blob("Foot", V(0.9, 0.55, 1.2), CFrame.new(x, 0.28, -0.4), dark).Parent = model
	end
	part("Head", V(2.7, 2.7, 2.7), CFrame.new(0, 4.35, -0.1), gray, Enum.PartType.Ball).Parent = model
	blob("Muzzle", V(1.3, 0.9, 0.9), CFrame.new(0, 4.0, -1.25), light).Parent = model
	part("Nose", V(0.35, 0.35, 0.35), CFrame.new(0, 4.15, -1.7), DARK, Enum.PartType.Ball).Parent = model
	blob("Mask", V(2.5, 0.75, 0.6), CFrame.new(0, 4.6, -1.05), dark).Parent = model
	for _, x in { -0.5, 0.5 } do
		part("Eye", V(0.55, 0.55, 0.55), CFrame.new(x, 4.62, -1.3), rgb(255, 255, 255), Enum.PartType.Ball).Parent = model
		part("Pupil", V(0.3, 0.3, 0.3), CFrame.new(x, 4.62, -1.55), DARK, Enum.PartType.Ball).Parent = model
		local ear = part("Ear", V(0.7, 0.9, 0.35), CFrame.new(x * 2, 5.7, -0.1) * CFrame.Angles(0, 0, math.rad(-18 * x * 2)), gray)
		ear.Parent = model
		blob("EarTip", V(0.45, 0.55, 0.1), CFrame.new(x * 2, 5.7, -0.3), dark).Parent = model
	end
	-- rabo listrado (para trás, subindo)
	for i = 1, 5 do
		local t = (i - 1) / 4
		local d = 1.2 - t * 0.25
		part("Tail", V(d, d, d), CFrame.new(0.3 * t, 1.4 + t * 2.2, 1.6 + t * 0.9), if i % 2 == 0 then dark else gray, Enum.PartType.Ball).Parent = model
	end
	-- o ovo dourado que ele sempre abraça
	local egg = blob("GoldenEgg", V(1.35, 1.7, 1.35), CFrame.new(0, 2.2, -1.65), rgb(255, 205, 60), Enum.Material.Foil)
	egg.Reflectance = 0.15
	egg.Parent = model
	for _, x in { -0.8, 0.8 } do
		part("Paw", V(0.65, 0.65, 0.65), CFrame.new(x, 2.3, -1.75), gray, Enum.PartType.Ball).Parent = model
	end
	local shine = Instance.new("PointLight")
	shine.Color = rgb(255, 215, 90)
	shine.Range = 8
	shine.Brightness = 0.8
	shine.Shadows = false
	shine.Parent = egg
end

---------------------------------------------------------------------
local function groundY(position: Vector3, ignore: { Instance }): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(V(position.X, position.Y + 150, position.Z), V(0, -300, 0), params)
	return if hit then hit.Position.Y else position.Y
end

local function nameTag(npc: any, height: number, parent: BasePart)
	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.fromOffset(220, 60)
	gui.StudsOffsetWorldSpace = V(0, height / 2 + 1.4, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 70
	local name = Instance.new("TextLabel")
	name.Size = UDim2.new(1, 0, 0.6, 0)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.TextColor3 = rgb(255, 255, 255)
	name.TextStrokeTransparency = 0.2
	name.Text = npc.Name
	name.Parent = gui
	local title = Instance.new("TextLabel")
	title.Position = UDim2.fromScale(0, 0.6)
	title.Size = UDim2.new(1, 0, 0.4, 0)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = rgb(255, 215, 80)
	title.TextStrokeTransparency = 0.3
	title.Text = npc.Title or ""
	title.Parent = gui
	gui.Parent = parent
end

function NPCService.Build(npc: any, folder: Instance, ignore: { Instance }): Model
	local height: number = npc.Height or DEFAULT_HEIGHT[npc.Kind] or 5.6
	local model = Instance.new("Model")
	model.Name = npc.Name
	model:SetAttribute("NpcId", npc.Id)

	local mesh, meshHeight = Models3D.Get(npc.Id, { Size = height, Fit = "Height" })
	if mesh then
		for _, d in mesh:GetDescendants() do
			if d:IsA("BasePart") then
				d.Parent = model
				d.CastShadow = true
			end
		end
		mesh:Destroy()
		height = meshHeight
		model:SetAttribute("Is3D", true)
	elseif npc.Kind == "raccoon" then
		buildRaccoon(npc, model)
		model.WorldPivot = CFrame.identity
		model:ScaleTo(height / 6.2)
	else
		buildPerson(npc, model)
		model.WorldPivot = CFrame.identity
		model:ScaleTo(height / 6.1)
	end

	-- base invisível: colisão (ninguém atravessa) + onde fica o botão Talk
	local base = part("Base", V(2.6, height, 2.6), CFrame.new(0, height / 2, 0), rgb(255, 255, 255))
	base.Transparency = 1
	base.CanCollide = true
	base.CanQuery = true
	base.CastShadow = false
	base.Parent = model
	-- pivô do modelo = pés (com PrimaryPart o Roblox usa o pivô dela, então ele fica meia altura abaixo do centro)
	base.PivotOffset = CFrame.new(0, -height / 2, 0)
	model.PrimaryPart = base

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "TalkPrompt"
	prompt.ActionText = "Talk"
	prompt.ObjectText = npc.Name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 11
	prompt.RequiresLineOfSight = false
	-- tecla própria (F / Y no controle): assim o "Talk" nunca esconde o botão da barraquinha (E)
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt:SetAttribute("NpcId", npc.Id)
	prompt.Parent = base
	nameTag(npc, height, base)

	-- lugar no mapa: no chão, olhando para Look
	local position: Vector3 = npc.Position
	local y = groundY(position, ignore)
	local look: Vector3 = npc.Look or (position + V(0, 0, -1))
	local flatLook = V(look.X, y, look.Z)
	local at = V(position.X, y, position.Z)
	local cframe = if (flatLook - at).Magnitude > 0.1 then CFrame.lookAt(at, flatLook) else CFrame.new(at)
	model:PivotTo(cframe)
	model:SetAttribute("Height", height)
	pcall(function()
		model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	end)
	model:AddTag("NPC")
	model.Parent = folder
	return model
end

function NPCService.Init()
	local folder = workspace:FindFirstChild("NPCs") or Instance.new("Folder")
	folder.Name = "NPCs"
	folder.Parent = workspace
	local ignore: { Instance } = { folder }
	local map = workspace:FindFirstChild("Map")
	for _, name in { "Decor", "Plots", "Boundaries" } do
		local child = map and map:FindFirstChild(name)
		if child then
			table.insert(ignore, child)
		end
	end
	for _, name in { "ActiveCritters", "ClientPets", "Monsters", "HuntEggs" } do
		local child = workspace:FindFirstChild(name)
		if child then
			table.insert(ignore, child)
		end
	end
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(ignore, player.Character)
		end
	end
	for _, npc in NPCs.List do
		local ok, err = pcall(NPCService.Build, npc, folder, ignore)
		if not ok then
			warn("[NPCs] could not build", npc.Id, err)
		end
	end
	-- ajuda a conferir a importação: aparece no Output quando o servidor liga
	local loaded = Models3D.Loaded()
	if #loaded > 0 then
		print(("[Models3D] %d 3D models found: %s"):format(#loaded, table.concat(loaded, ", ")))
	else
		print("[Models3D] no 3D models imported yet (using part models). See the Guide: Version 14.")
	end
end

return NPCService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="457">
        <Properties>
          <string name="Name">Pets</string>
          <string name="Source"><![CDATA[--[[
	Pets (ModuleScript em ServerScriptService > Game)
	Parte 14: MOCHILA, PETS e FUSÃO.
	  • Mochila: até Config.InventoryMax bichinhos guardados. Guardado não rende dinheiro, mas ninguém rouba.
	  • Pets: até Config.PetEquipMax bichinhos da mochila seguem você e dão +% de dinheiro (máx. Config.PetBonusCap).
	  • Fusão: 5 iguais (mesmo bichinho e mesma mutação) viram 1 Gold; 5 Gold iguais viram 1 Rainbow.
	Sem duplicação: cada bichinho da mochila tem uma chave única ("k12"), e toda troca
	(base <-> mochila, fusão, venda) acontece de uma vez só, sem pausa no meio.
	A base continua no CritterService; aqui ficam só a mochila e os pets.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Critters = require(ReplicatedStorage.Shared.Critters)
local Format = require(ReplicatedStorage.Shared.Format)
local Hybrids = require(ReplicatedStorage.Shared.Hybrids)
local Registry = require(script.Parent.Registry)

local Pets = {}

-- B = quando nasceu (crescimento), S = shiny
type Entry = { K: string, Id: string, M: string?, B: number?, S: boolean? }

local dirty: { [Player]: boolean } = {}

local function getData(player: Player): any
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

local function validMutation(value: any): string?
	if type(value) == "string" and Config.MutationByName[value] then
		return value
	end
	return nil
end

local function entryName(entry: Entry): string
	local def = Critters.ById[entry.Id]
	return (if entry.S then "Shiny " else "") .. (if entry.M then entry.M .. " " else "") .. (if def then def.Name else entry.Id)
end

local function entryBonus(entry: Entry): number
	local def = Critters.ById[entry.Id]
	return if def then Config.PetBonusOf(def.Rarity, entry.M) else 0
end

local function entryIncome(entry: Entry): number
	local def = Critters.ById[entry.Id]
	return if def then def.Income * Config.IncomeMultiplier(entry.M) else 0
end

local function findIndex(data, key: any): number?
	if type(key) ~= "string" then
		return nil
	end
	for index, entry in data.Inventory do
		if entry.K == key then
			return index
		end
	end
	return nil
end

local function isEquipped(data, key: string): boolean
	return table.find(data.Equipped, key) ~= nil
end

local function unequipKey(data, key: string)
	local index = table.find(data.Equipped, key)
	if index then
		table.remove(data.Equipped, index)
	end
end

local function newKey(data): string
	data.NextKey = (tonumber(data.NextKey) or 0) + 1
	return "k" .. data.NextKey
end

---------------------------------------------------------------------
-- Estado visível (atributos) e sincronização com a tela
---------------------------------------------------------------------
function Pets.Bonus(player: Player): number
	local data = getData(player)
	if not data then
		return 0
	end
	local total = 0
	for _, key in data.Equipped do
		local index = findIndex(data, key)
		if index then
			total += entryBonus(data.Inventory[index])
		end
	end
	return math.min(total, Config.PetBonusCap)
end

-- "Pets" = "blobby:,zapkit:Gold" -> a tela de TODOS os jogadores desenha os pets seguindo
local function publish(player: Player)
	local data = getData(player)
	if not data then
		return
	end
	local parts = {}
	for _, key in data.Equipped do
		local index = findIndex(data, key)
		if index then
			local entry = data.Inventory[index]
			table.insert(parts, entry.Id .. ":" .. (entry.M or ""))
		end
	end
	player:SetAttribute("Pets", table.concat(parts, ","))
	player:SetAttribute("PetBonus", Pets.Bonus(player))
	Registry.Economy.Sync(player)
end

function Pets.MarkDirty(player: Player?)
	if player then
		dirty[player] = true
	end
end

-- Manda a mochila + os bichinhos da base para a tela do jogador
-- Receitas de híbridos que o jogador já descobriu (lista de Ids)
local function recipeList(data): { string }
	local list = {}
	if type(data.Recipes) == "table" then
		for id, known in data.Recipes do
			if known == true and type(id) == "string" and Critters.ById[id] then
				table.insert(list, id)
			end
		end
	end
	return list
end

function Pets.Sync(player: Player)
	local data = getData(player)
	if not data or not player.Parent then
		return
	end
	dirty[player] = nil
	local items = {}
	for _, entry in data.Inventory do
		table.insert(items, { K = entry.K, Id = entry.Id, M = entry.M, B = entry.B, S = entry.S })
	end
	Registry.Remotes.InventoryEvent:FireClient(player, {
		Items = items,
		Equipped = table.clone(data.Equipped),
		Base = Registry.CritterService.GetBaseList(player),
		Max = Config.InventoryMax,
		EquipMax = Config.PetEquipMax,
		Recipes = recipeList(data),
		FeedCost = Registry.CritterService.FeedCost(player),
	})
end

-- Arruma a mochila salva (Ids que não existem mais, pets repetidos...) quando o jogador entra
function Pets.SetupPlayer(player: Player)
	local data = getData(player)
	if not data then
		return
	end
	if type(data.Inventory) ~= "table" then
		data.Inventory = {}
	end
	if type(data.Equipped) ~= "table" then
		data.Equipped = {}
	end
	if type(data.Recipes) ~= "table" then
		data.Recipes = {}
	end
	local clean = {}
	local seen = {}
	for _, entry in data.Inventory do
		if type(entry) == "table" and type(entry.Id) == "string" and Critters.ById[entry.Id] then
			local key = if type(entry.K) == "string" and not seen[entry.K] then entry.K else newKey(data)
			seen[key] = true
			-- save antigo sem nascimento = já é gigante
			table.insert(clean, { K = key, Id = entry.Id, M = validMutation(entry.M), B = tonumber(entry.B) or (os.time() - 86400), S = if entry.S == true then true else nil })
		end
	end
	data.Inventory = clean
	local equipped = {}
	for _, key in data.Equipped do
		if #equipped < Config.PetEquipMax and findIndex(data, key) and not table.find(equipped, key) then
			table.insert(equipped, key)
		end
	end
	data.Equipped = equipped
	publish(player)
	dirty[player] = true
end

-- Renda que a mochila teria na base (a regra "sem covardia" conta a mochila também)
function Pets.BagIncome(player: Player): number
	local data = getData(player)
	local total = 0
	if data then
		for _, entry in data.Inventory do
			total += entryIncome(entry)
		end
	end
	return total
end

-- Ninguém guarda bichinho na mochila com ladrão dentro da base (senão o roubo nunca dá certo)
local function intruderBlocks(player: Player): boolean
	local plot = Registry.Plots.Get(player)
	if plot and Registry.Plots.HasIntruder(plot) then
		Registry.Remotes.Notify(player, "A thief is inside your base! BONK them before picking critters up.", "warning")
		return true
	end
	return false
end

function Pets.Count(player: Player): number
	local data = getData(player)
	return if data then #data.Inventory else 0
end

function Pets.HasSpace(player: Player, amount: number?): boolean
	local data = getData(player)
	return data ~= nil and #data.Inventory + (amount or 1) <= Config.InventoryMax
end

-- Coloca um bichinho na mochila (devolve a chave, ou nil se estiver cheia)
function Pets.Add(player: Player, critterId: string, mutation: string?, born: number?, shiny: boolean?): string?
	local data = getData(player)
	if not data or not Critters.ById[critterId] or #data.Inventory >= Config.InventoryMax then
		return nil
	end
	local key = newKey(data)
	table.insert(data.Inventory, { K = key, Id = critterId, M = validMutation(mutation), B = born or os.time(), S = if shiny then true else nil })
	Registry.Economy.Discover(player, critterId)
	dirty[player] = true
	return key
end

-- Tira da mochila (tira dos pets também). Devolve a entrada removida.
local function removeEntry(player: Player, data, index: number): Entry
	local entry = table.remove(data.Inventory, index) :: Entry
	if isEquipped(data, entry.K) then
		unequipKey(data, entry.K)
		publish(player)
	end
	dirty[player] = true
	return entry
end

-- Presentes (Social): procurar, tirar e ver se cabe
function Pets.Find(player: Player, key: any): Entry?
	local data = getData(player)
	local index = data and findIndex(data, key)
	return if index then data.Inventory[index] else nil
end

function Pets.Take(player: Player, key: any): Entry?
	local data = getData(player)
	local index = data and findIndex(data, key)
	if not index then
		return nil
	end
	return removeEntry(player, data, index)
end

function Pets.HasRoom(player: Player): boolean
	return Pets.HasSpace(player, 1)
end

---------------------------------------------------------------------
-- Ações (vêm da tela do jogador; tudo é conferido aqui)
---------------------------------------------------------------------
-- Base -> mochila
function Pets.Store(player: Player, uid: any)
	local data = getData(player)
	local Remotes = Registry.Remotes
	if not data or typeof(uid) ~= "number" then
		return
	end
	if #data.Inventory >= Config.InventoryMax then
		Remotes.Notify(player, ("Your backpack is full (%d)! Sell or fuse something first."):format(Config.InventoryMax), "error")
		return
	end
	if intruderBlocks(player) then
		return
	end
	local locked = Registry.CritterService.StolenLockLeft(player, uid)
	if locked > 0 then
		Remotes.Notify(player, ("You just stole this one! It can go to your backpack in %ds."):format(math.ceil(locked)), "warning")
		return
	end
	local critterId, mutation, born, shiny = Registry.CritterService.TakeFromBase(player, uid)
	if not critterId then
		return
	end
	Pets.Add(player, critterId, mutation, born, shiny)
	Registry.CritterService.PlacePending(player)
	Remotes.Notify(player, entryName({ K = "", Id = critterId, M = mutation }) .. " went to your backpack. (Backpack critters don't make cash.)", "info")
	Remotes.Effect(player, "Purchase", "Common")
end

-- Mochila -> base
function Pets.Place(player: Player, key: any)
	local data = getData(player)
	local Remotes = Registry.Remotes
	local index = data and findIndex(data, key)
	if not data or not index then
		return
	end
	local CritterService = Registry.CritterService
	if not CritterService.HasFreeSlot(player) then
		Remotes.Notify(player, "Your base is full! Pick something up or buy more slots.", "error")
		return
	end
	local entry = removeEntry(player, data, index)
	if not CritterService.PlaceFromInventory(player, entry.Id, entry.M, entry.B, entry.S) then
		-- não coube (não deveria acontecer): volta para a mochila
		table.insert(data.Inventory, entry)
		return
	end
	Remotes.Notify(player, entryName(entry) .. " is back on your base making cash!", "success")
	Remotes.Effect(player, "Purchase", "Common")
end

function Pets.Equip(player: Player, key: any)
	local data = getData(player)
	if not data or not findIndex(data, key) or isEquipped(data, key) then
		return
	end
	if #data.Equipped >= Config.PetEquipMax then
		Registry.Remotes.Notify(player, ("You can equip %d pets. Unequip one first!"):format(Config.PetEquipMax), "warning")
		return
	end
	table.insert(data.Equipped, key)
	publish(player)
	dirty[player] = true
end

function Pets.Unequip(player: Player, key: any)
	local data = getData(player)
	if not data or type(key) ~= "string" or not isEquipped(data, key) then
		return
	end
	unequipKey(data, key)
	publish(player)
	dirty[player] = true
end

-- Equipa os melhores (maior bônus; empate = maior renda)
function Pets.EquipBest(player: Player)
	local data = getData(player)
	if not data then
		return
	end
	local list = table.clone(data.Inventory)
	table.sort(list, function(a, b)
		local ba, bb = entryBonus(a), entryBonus(b)
		if ba ~= bb then
			return ba > bb
		end
		return entryIncome(a) > entryIncome(b)
	end)
	local equipped = {}
	for i = 1, math.min(Config.PetEquipMax, #list) do
		table.insert(equipped, list[i].K)
	end
	data.Equipped = equipped
	publish(player)
	dirty[player] = true
	if #equipped == 0 then
		Registry.Remotes.Notify(player, "Your backpack is empty! Pick up a critter from your base first.", "warning")
	else
		Registry.Remotes.Notify(player, ("Equipped your best %d pets: +%d%% cash!"):format(#equipped, math.floor(Pets.Bonus(player) * 100 + 0.5)), "success")
	end
end

-- Quantos iguais existem (mochila + base) para fundir
function Pets.CountSame(player: Player, critterId: string, mutation: string?): number
	local data = getData(player)
	if not data then
		return 0
	end
	local count = 0
	for _, entry in data.Inventory do
		if entry.Id == critterId and entry.M == mutation and not entry.S then
			count += 1
		end
	end
	return count + #Registry.CritterService.FindBaseUids(player, critterId, mutation)
end

-- Fusão: 5 iguais -> 1 com a mutação seguinte. Usa primeiro os da mochila (os não equipados antes).
function Pets.Fuse(player: Player, request: any)
	local data = getData(player)
	local Remotes = Registry.Remotes
	if not data or type(request) ~= "table" or type(request.Id) ~= "string" then
		return
	end
	local def = Critters.ById[request.Id]
	local mutation = validMutation(request.M)
	if not def or (request.M ~= nil and request.M ~= "" and not mutation) then
		return
	end
	local result = Config.FuseResult(mutation)
	if not result then
		Remotes.Notify(player, "This critter can't be fused any further!", "warning")
		return
	end
	local need = Config.FuseCount
	if Pets.CountSame(player, def.Id, mutation) < need then
		Remotes.Notify(player, ("You need %d of the same critter to fuse!"):format(need), "error")
		return
	end

	-- escolhe quem vai ser usado (tudo decidido antes de mexer em qualquer coisa)
	local fromBag: { string } = {}
	local wasEquipped = false
	for pass = 1, 2 do
		for _, entry in data.Inventory do
			if #fromBag >= need then
				break
			end
			if entry.Id == def.Id and entry.M == mutation and not entry.S then
				local equipped = isEquipped(data, entry.K)
				if (pass == 1 and not equipped) or (pass == 2 and equipped) then
					table.insert(fromBag, entry.K)
					wasEquipped = wasEquipped or equipped
				end
			end
		end
	end
	local fromBase: { number } = {}
	if #fromBag < need and intruderBlocks(player) then
		return
	end
	if #fromBag < need then
		for _, uid in Registry.CritterService.FindBaseUids(player, def.Id, mutation) do
			if #fromBag + #fromBase >= need then
				break
			end
			table.insert(fromBase, uid)
		end
	end
	if #fromBag + #fromBase < need then
		return
	end

	-- usa (sem pausa entre conferir e usar: ninguém consegue duplicar no meio)
	local oldest = os.time() -- o resultado herda a idade do mais velho (fusão não volta a ser bebê)
	for _, uid in fromBase do
		local takenId, takenMutation, born = Registry.CritterService.TakeFromBase(player, uid)
		if takenId ~= def.Id or takenMutation ~= mutation then
			warn("[Pets] fusão: bichinho da base mudou no meio", player.Name, uid)
		end
		oldest = math.min(oldest, born or oldest)
	end
	for _, key in fromBag do
		local index = findIndex(data, key)
		if index then
			local removed = removeEntry(player, data, index)
			oldest = math.min(oldest, removed.B or oldest)
		end
	end
	local newKeyValue = Pets.Add(player, def.Id, result, oldest)
	if newKeyValue then
		if wasEquipped and #data.Equipped < Config.PetEquipMax then
			table.insert(data.Equipped, newKeyValue)
		end
	elseif not Registry.CritterService.PlaceFromInventory(player, def.Id, result, oldest) then
		-- mochila cheia e base cheia (não deveria acontecer: acabamos de liberar 5 lugares)
		table.insert(data.Pending, { Id = def.Id, Mutation = result, B = oldest })
	end
	publish(player)
	Registry.CritterService.PlacePending(player)
	Remotes.Effect(player, "Fused", { Critter = def.Id, Mutation = result })
	Registry.Economy.SeasonXP(player, "Fuse")
	Remotes.Notify(player, ("FUSED! 5 %s became 1 %s %s (x%d cash)!"):format(entryName({ K = "", Id = def.Id, M = mutation }), string.upper(result), def.Name, Config.IncomeMultiplier(result)), "rare")
	if result == "Rainbow" then
		Remotes.NotifyAll(("%s fused a RAINBOW %s!"):format(player.DisplayName, def.Name), "rare")
	end
	local analytics = Registry.Analytics
	if analytics then
		pcall(analytics.Event, player, "Fuse_" .. result)
	end
end

-- Vender da mochila
function Pets.Sell(player: Player, key: any)
	local data = getData(player)
	local index = data and findIndex(data, key)
	if not data or not index then
		return
	end
	local entry = removeEntry(player, data, index)
	local def = Critters.ById[entry.Id]
	local amount = math.floor(def.Price * Config.PriceMultiplier(entry.M) * (if entry.S then Config.ShinyIncome else 1) * Config.CritterSellRefund)
	if amount > 0 then
		Registry.Economy.AddCash(player, amount, false, "Sell")
	end
	Registry.Remotes.Notify(player, ("Sold %s for %s"):format(entryName(entry), Format.Money(amount)), "info")
end

-- LABORATÓRIO DE MISTURA: 2 espécies diferentes da mochila -> 1 híbrido (se a dupla for uma receita)
-- Precisa estar perto do laboratório (Map.Booths.Lab). Dupla sem receita: nada é gasto.
local LAB_RANGE = 40
local function nearLab(player: Player): boolean
	local map = workspace:FindFirstChild("Map")
	local booths = map and map:FindFirstChild("Booths")
	local lab = booths and booths:FindFirstChild("Lab")
	local counter = lab and lab:FindFirstChild("Counter") :: BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not counter or not root then
		return false
	end
	return (counter.CFrame.Position - root.Position).Magnitude <= LAB_RANGE
end

function Pets.Mix(player: Player, request: any)
	local data = getData(player)
	local Remotes = Registry.Remotes
	if not data or type(request) ~= "table" or type(request.A) ~= "string" or type(request.B) ~= "string" or request.A == request.B then
		return
	end
	if not nearLab(player) then
		Remotes.Notify(player, "Go to the MIX LAB behind the bases to mix critters!", "warning")
		return
	end
	local indexA, indexB = findIndex(data, request.A), findIndex(data, request.B)
	if not indexA or not indexB then
		return
	end
	local a, b = data.Inventory[indexA], data.Inventory[indexB]
	if a.S or b.S then
		Remotes.Notify(player, "Shiny critters are too special to mix!", "warning")
		return
	end
	local recipe = Hybrids.Find(a.Id, b.Id)
	if not recipe then
		Remotes.Notify(player, "Nothing happened... these two don't mix. Try another pair!", "info")
		Remotes.Effect(player, "MixFail")
		return
	end
	local hybrid = Critters.ById[recipe.Result]
	if not hybrid then
		return
	end
	-- mesma mutação nos dois pais = o híbrido herda
	local mutation = if a.M and a.M == b.M then a.M else nil
	local oldest = math.min(a.B or os.time(), b.B or os.time())
	local wasEquipped = isEquipped(data, a.K) or isEquipped(data, b.K)
	local isNew = not Registry.Economy.HasDiscovered(player, hybrid.Id)
	-- tira os dois (o índice maior primeiro, para o outro não mudar de lugar)
	local first, second = math.max(indexA, indexB), math.min(indexA, indexB)
	removeEntry(player, data, first)
	removeEntry(player, data, second)
	local key = Pets.Add(player, hybrid.Id, mutation, oldest)
	if key and wasEquipped and #data.Equipped < Config.PetEquipMax then
		table.insert(data.Equipped, key)
	end
	if type(data.Recipes) ~= "table" then
		data.Recipes = {}
	end
	data.Recipes[hybrid.Id] = true
	publish(player)
	Remotes.Effect(player, "Mixed", { Critter = hybrid.Id, Mutation = mutation, New = isNew })
	Remotes.Notify(player, ("MIXED! %s + %s = %s!"):format(entryName(a), entryName(b), hybrid.Name), "rare")
	if isNew then
		Remotes.NotifyAll(("%s discovered the %s recipe!"):format(player.DisplayName, hybrid.Name), "rare")
	end
	Registry.Economy.SeasonXP(player, "Mix")
end

-- Admin/teste: vários iguais de uma vez (para testar a fusão)
function Pets.AdminGive(player: Player, critterId: string, mutation: string?, amount: number)
	for _ = 1, amount do
		if not Pets.Add(player, critterId, mutation) then
			break
		end
	end
	Pets.Sync(player)
end

function Pets.RemovePlayer(player: Player)
	dirty[player] = nil
end

function Pets.Init()
	Players.PlayerRemoving:Connect(Pets.RemovePlayer)
	-- manda as mudanças para a tela no máximo 2x por segundo
	task.spawn(function()
		while true do
			task.wait(0.5)
			local ok, err = pcall(function()
				for player in dirty do
					if player.Parent and player:GetAttribute("Loaded") then
						Pets.Sync(player)
					else
						dirty[player] = nil
					end
				end
			end)
			if not ok then
				warn("[Pets] loop error:", err)
			end
		end
	end)
end

return Pets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="458">
        <Properties>
          <string name="Name">Plots</string>
          <string name="Source"><![CDATA[--[[
	Plots (ModuleScript em ServerScriptService > Game)
	As 8 bases: dono, trava de laser (com recarga), coletor de dinheiro, 24 pedestais,
	esteira de treino (corra nela = mais velocidade de graça) e alarme de invasão.
	v19/v20: 2º ANDAR com rampa e mais 18 pedestais (vagas 25-42). Ele fica guardado e só aparece
	na base quando o dono passa de 24 vagas (Config.FloorSlots).
]]

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local Plots = {}

local HALF_X = 32
local HALF_Z = 44 -- v20: a base ficou 16 studs mais funda (88)

local plots = {}
local byPlayer: { [Player]: any } = {}
local lastAlarm: { [string]: number } = {}

local LOCK_READY_COLOR = Color3.fromRGB(255, 70, 70)
local LOCK_BUSY_COLOR = Color3.fromRGB(120, 120, 120)
local SLOT_OPEN_COLOR = Color3.fromRGB(245, 245, 245)
local SLOT_LOCKED_COLOR = Color3.fromRGB(90, 90, 95)

local function now(): number
	return workspace:GetServerTimeNow()
end

local function makeLabel(parent: Instance, text: string, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(20, 20, 30)
	stroke.Parent = label
	label.Parent = parent
	return label
end

local function makeBillboard(adornee: BasePart, offsetY: number, width: number, height: number, text: string, color: Color3): (BillboardGui, TextLabel)
	local gui = Instance.new("BillboardGui")
	gui.Adornee = adornee
	gui.Size = UDim2.new(width, 0, height, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	gui.MaxDistance = 120
	gui.LightInfluence = 0
	gui.Parent = adornee
	return gui, makeLabel(gui, text, color)
end

local function playerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	if model then
		return Players:GetPlayerFromCharacter(model)
	end
	return nil
end

local function setBarrier(plot, locked: boolean)
	plot.Barrier.CanCollide = locked
	plot.Barrier.Transparency = if locked then 0.3 else 1
end

local function publishLockState(plot)
	plot.Model:SetAttribute("LockedUntil", plot.LockedUntil)
	plot.Model:SetAttribute("CooldownUntil", plot.CooldownUntil)
end

function Plots.IsInside(plot, position: Vector3): boolean
	local p = plot.Origin.CFrame:PointToObjectSpace(position)
	return math.abs(p.X) <= HALF_X and math.abs(p.Z) <= HALF_Z and p.Y < 40
end

-- Tem alguém que não é o dono dentro da base?
function Plots.HasIntruder(plot): boolean
	for _, other in Players:GetPlayers() do
		if other ~= plot.Owner then
			local character = other.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root and Plots.IsInside(plot, root.Position) then
				return true
			end
		end
	end
	return false
end

function Plots.IsLocked(plot): boolean
	return plot.LockedUntil > now()
end

function Plots.Get(player: Player)
	return byPlayer[player]
end

function Plots.All()
	return plots
end

function Plots.FreeSlot(plot, count: number): number?
	for slot = 1, math.min(count, #plot.SlotParts) do
		if plot.Slots[slot] == nil then
			return slot
		end
	end
	return nil
end

function Plots.FreeSlotCount(plot, count: number): number
	local free = 0
	for slot = 1, math.min(count, #plot.SlotParts) do
		if plot.Slots[slot] == nil then
			free += 1
		end
	end
	return free
end

-- Altura do topo de uma peça (funciona com pedestal redondo, que é um cilindro deitado girado)
local function topOf(part: BasePart): number
	local cf, size = part.CFrame, part.Size
	return part.Position.Y
		+ math.abs(cf.RightVector.Y) * size.X / 2
		+ math.abs(cf.UpVector.Y) * size.Y / 2
		+ math.abs(cf.LookVector.Y) * size.Z / 2
end

-- Posição do bichinho em cima do pedestal, olhando para a frente da base
function Plots.SlotCFrame(plot, slot: number, groundOffset: number): CFrame
	local pedestal: BasePart = plot.SlotParts[slot]
	local top = Vector3.new(pedestal.Position.X, topOf(pedestal) + groundOffset, pedestal.Position.Z)
	return CFrame.lookAt(top, top + plot.Origin.CFrame.LookVector)
end

-- Pontos do caminho até a base (fora da entrada / logo depois da entrada)
function Plots.PathPoints(plot): (Vector3, Vector3)
	local origin: CFrame = plot.Origin.CFrame
	local outside = (origin * CFrame.new(0, 0, -(HALF_Z + 8))).Position
	local inside = (origin * CFrame.new(0, 0, -(HALF_Z - 6))).Position
	return Vector3.new(outside.X, 0, outside.Z), Vector3.new(inside.X, plot.FloorTop, inside.Z)
end

-- O 2º andar está aparecendo nesta base?
function Plots.HasFloor2(plot): boolean
	return plot.Floor2 ~= nil and plot.Floor2.Parent == plot.Model
end

-- Mostra/guarda o 2º andar. Devolve true se mudou.
local function setFloor2(plot, visible: boolean): boolean
	local floor2 = plot.Floor2
	if not floor2 or Plots.HasFloor2(plot) == visible then
		return false
	end
	floor2.Parent = if visible then plot.Model else nil
	plot.Model:SetAttribute("Floor2", visible)
	local customize = Registry.Customize
	if customize and customize.RefreshProps then
		customize.RefreshProps(plot) -- enfeites do tema sobem para cima do vidro do 2º andar
	end
	return true
end

-- Pontos por onde um bichinho passa para chegar à vaga (a rampa, se a vaga for lá em cima)
function Plots.SlotRoute(plot, slot: number): { Vector3 }
	if slot > Config.FloorSlots and plot.RampBottom and plot.RampTop then
		return { plot.RampBottom.CFrame.Position, plot.RampTop.CFrame.Position }
	end
	return {}
end

function Plots.RefreshSlots(plot, count: number)
	for slot, pedestal in plot.SlotParts do
		local open = slot <= count
		pedestal.Color = if open then SLOT_OPEN_COLOR else SLOT_LOCKED_COLOR
		pedestal.Transparency = if open then 0 else 0.35
		plot.SlotLabels[slot].Enabled = not open
	end
	local owner = plot.Owner
	local grew = setFloor2(plot, count > Config.FloorSlots) and count > Config.FloorSlots
	-- só comemora quando o andar aparece com o dono jogando (não quando ele entra no jogo)
	if grew and owner and plot.RefreshedFor == owner then
		Registry.Remotes.Notify(owner, "Your base grew! 2ND FLOOR unlocked!", "rare")
		Registry.Remotes.Effect(owner, "Purchase", "Legendary")
	end
	plot.RefreshedFor = owner
end

local function updateSign(plot)
	if plot.Owner then
		plot.SignLabel.Text = plot.Owner.DisplayName .. "'s Base"
	else
		plot.SignLabel.Text = "Empty Base"
	end
end

local function ejectIntruders(plot)
	local origin: CFrame = plot.Origin.CFrame
	for _, other in Players:GetPlayers() do
		if other ~= plot.Owner then
			local character = other.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if character and root and Plots.IsInside(plot, root.Position) then
				Registry.CritterService.DropCarried(other)
				local spot = (origin * CFrame.new(math.random(-6, 6), 0, -(HALF_Z + 10))).Position + Vector3.new(0, 4, 0)
				character:PivotTo(CFrame.lookAt(spot, spot + origin.LookVector))
			end
		end
	end
end

local function lockNow(plot, player: Player)
	local economy = Registry.Economy
	local duration = if economy and economy.HasPass(player, "LongLock") then Config.LockDurationPass else Config.LockDuration
	local progress = Registry.Progress
	if progress then
		duration += progress.LockBonus(player) -- habilidade Defense e classe Guardian
	end
	plot.LockedUntil = now() + duration
	plot.CooldownUntil = 0
	publishLockState(plot)
	setBarrier(plot, true)
	ejectIntruders(plot)
	Registry.Remotes.Notify(player, ("Base locked for %d seconds!"):format(duration), "success")
	Registry.Remotes.Effect(player, "Lock")
	if Registry.Tutorial then
		Registry.Tutorial.Event(player, "Locked")
	end
end

local function tryLock(plot, player: Player)
	if plot.Owner ~= player or Plots.IsLocked(plot) then
		return
	end
	local t = now()
	if plot.CooldownUntil > t then
		if t - (plot.LastCooldownWarn or 0) > 2 then
			plot.LastCooldownWarn = t
			Registry.Remotes.Notify(player, ("Lock recharging: %ds (or use INSTANT LOCK)"):format(math.ceil(plot.CooldownUntil - t)), "warning")
		end
		return
	end
	lockNow(plot, player)
end

-- Usado pelo Dev Product "Instant Lock": tranca na hora, mesmo recarregando
function Plots.ForceLock(player: Player): boolean
	local plot = byPlayer[player]
	if not plot then
		return false
	end
	lockNow(plot, player)
	return true
end

local function tryCollect(plot, player: Player)
	if plot.Owner ~= player then
		return
	end
	local t = os.clock()
	if t - (plot.LastCollect or 0) < 0.4 then
		return
	end
	plot.LastCollect = t
	local amount = math.floor(plot.Vault)
	if amount < 1 then
		return
	end
	plot.Vault -= amount
	Registry.Economy.AddCash(player, amount, true, "Collect")
	Registry.Remotes.Effect(player, "Collect", amount)
	if Registry.Tutorial then
		Registry.Tutorial.Event(player, "Collected")
	end
end

function Plots.Init()
	local map = workspace:WaitForChild("Map")
	local folder = map:WaitForChild("Plots")

	local index = 1
	while true do
		local model = folder:FindFirstChild("Plot" .. index)
		if not model then
			break
		end
		local plot = {
			Index = index,
			Model = model,
			Origin = model:WaitForChild("Origin") :: BasePart,
			Barrier = model:WaitForChild("Barrier") :: BasePart,
			LockButton = model:WaitForChild("LockButton") :: BasePart,
			CollectPad = model:WaitForChild("CollectPad") :: BasePart,
			SpawnPoint = model:WaitForChild("SpawnPoint") :: BasePart,
			Sign = model:WaitForChild("Sign") :: BasePart,
			Belt = nil :: BasePart?,
			SlotParts = {},
			SlotLabels = {},
			Slots = {},
			Owner = nil :: Player?,
			LockedUntil = 0,
			CooldownUntil = 0,
			LastCooldownWarn = 0,
			Vault = 0,
			LastCollect = 0,
			FloorTop = 0.5,
		}
		local floor = model:FindFirstChild("Floor") :: BasePart?
		if floor then
			plot.FloorTop = floor.Position.Y + floor.Size.Y / 2
		end

		local slotsFolder = model:WaitForChild("Slots")
		local floor2 = model:FindFirstChild("Floor2") :: Model?
		local floor2Slots = floor2 and floor2:FindFirstChild("Slots")
		if floor2 then
			plot.Floor2 = floor2
			plot.RampBottom = floor2:FindFirstChild("RampBottom") :: BasePart?
			plot.RampTop = floor2:FindFirstChild("RampTop") :: BasePart?
			local sign2 = floor2:FindFirstChild("Sign2") :: BasePart?
			if sign2 then
				local gui = Instance.new("SurfaceGui")
				gui.Face = Enum.NormalId.Front
				gui.LightInfluence = 0
				gui.PixelsPerStud = 40
				gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
				gui.Parent = sign2
				makeLabel(gui, "2ND FLOOR", Color3.fromRGB(255, 255, 255))
			end
		end
		for slot = 1, Config.MaxSlots do
			local pedestal = (slotsFolder:FindFirstChild("Slot" .. slot) or (floor2Slots and floor2Slots:FindFirstChild("Slot" .. slot))) :: BasePart?
			if pedestal then
				plot.SlotParts[slot] = pedestal
				local gui = makeBillboard(pedestal, 2.5, 5, 1.4, "REBIRTH or +SLOTS", Color3.fromRGB(255, 220, 120))
				gui.MaxDistance = 45
				plot.SlotLabels[slot] = gui
			end
		end

		-- Placa do dono (virada para a esteira)
		local surface = Instance.new("SurfaceGui")
		surface.Face = Enum.NormalId.Front
		surface.LightInfluence = 0
		surface.PixelsPerStud = 40
		surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		surface.Parent = plot.Sign
		plot.SignLabel = makeLabel(surface, "Empty Base", Color3.fromRGB(255, 255, 255))

		-- Barreira laser: todo mundo bate nela, menos o dono
		local barrierGroup = "Barrier" .. index
		local ownerGroup = "Owner" .. index
		PhysicsService:RegisterCollisionGroup(barrierGroup)
		PhysicsService:RegisterCollisionGroup(ownerGroup)
		PhysicsService:CollisionGroupSetCollidable(barrierGroup, ownerGroup, false)
		plot.Barrier.CollisionGroup = barrierGroup
		setBarrier(plot, false)
		publishLockState(plot)

		-- v24: a plaquinha do botão ficava a 3 studs (dentro do boneco de quem está em cima): agora fica
		-- mais alta, maior e sempre por cima de tudo, então dá para ver os segundos parado no botão.
		local lockGui, lockLabel = makeBillboard(plot.LockButton, 7.5, 11, 3, "LOCK BASE", Color3.fromRGB(255, 255, 255))
		lockGui.AlwaysOnTop = true
		lockGui.MaxDistance = 160
		plot.LockLabel = lockLabel
		-- v23: placa GRANDE em cima do portão com os segundos da trava (todo mundo vê, de longe)
		local gateGui, gateLabel = makeBillboard(plot.Barrier, 12, 16, 3.2, "", Color3.fromRGB(255, 90, 90))
		gateGui.MaxDistance = 220
		gateGui.AlwaysOnTop = false
		gateGui.Enabled = false
		plot.GateGui = gateGui
		plot.GateLabel = gateLabel
		local _, collectLabel = makeBillboard(plot.CollectPad, 3.5, 8, 2.4, "COLLECT", Color3.fromRGB(120, 255, 120))
		plot.CollectLabel = collectLabel

		plot.LockButton.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if player then
				tryLock(plot, player)
			end
		end)
		-- Esteira de treino: empurra para trás; quem corre em cima ganha velocidade
		local treadmill = model:FindFirstChild("Treadmill")
		local belt = treadmill and treadmill:FindFirstChild("Belt") :: BasePart?
		if belt then
			plot.Belt = belt
			belt.AssemblyLinearVelocity = -plot.Origin.CFrame.RightVector * Config.TreadmillPush
			local gui = makeBillboard(belt, 4.5, 10, 2.6, "TREADMILL\nRUN = +SPEED", Color3.fromRGB(120, 220, 255))
			gui.MaxDistance = 60
		end

		plot.CollectPad.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if player then
				tryCollect(plot, player)
			end
		end)

		Plots.RefreshSlots(plot, Config.StartSlots) -- guarda o 2º andar até alguém ter 19 vagas
		updateSign(plot)
		table.insert(plots, plot)
		index += 1
	end

	-- Atualiza trava, recarga, coletor, esteira de treino e alarme de invasão
	task.spawn(function()
		while true do
			local dt = task.wait(0.25)
			local ok, err = pcall(function()
				local t = now()
				for _, plot in plots do
					-- Esteira de treino (só o dono treina na própria base)
					local trainer = plot.Owner
					if trainer and plot.Belt then
						local character = trainer.Character
						local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
						local humanoid = character and character:FindFirstChildOfClass("Humanoid")
						local onBelt = false
						if root and humanoid and humanoid.Health > 0 then
							local belt = plot.Belt :: BasePart
							local p = belt.CFrame:PointToObjectSpace(root.Position)
							onBelt = math.abs(p.X) <= belt.Size.X / 2 + 0.5 and math.abs(p.Z) <= belt.Size.Z / 2 + 0.5 and p.Y > 0 and p.Y < 6
						end
						if onBelt then
							Registry.Economy.Train(trainer, math.min(dt, 0.5))
						end
						if trainer:GetAttribute("Training") ~= onBelt then
							trainer:SetAttribute("Training", onBelt)
						end
					end

					if plot.LockedUntil > 0 and t >= plot.LockedUntil then
						plot.LockedUntil = 0
						plot.CooldownUntil = t + Config.LockCooldown
						publishLockState(plot)
						setBarrier(plot, false)
						if plot.Owner then
							Registry.Remotes.Notify(plot.Owner, "Your base is UNLOCKED!", "warning")
						end
					end
					if plot.LockedUntil > t then
						local left = math.ceil(plot.LockedUntil - t)
						plot.LockLabel.Text = "\u{1F512} LOCKED " .. left .. "s"
						plot.LockLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
						plot.LockButton.Color = LOCK_BUSY_COLOR
						if plot.GateGui then
							plot.GateGui.Enabled = true
							plot.GateLabel.Text = "\u{1F512} LOCKED " .. left .. "s"
						end
					elseif plot.CooldownUntil > t then
						plot.LockLabel.Text = if plot.Owner then "READY IN " .. math.ceil(plot.CooldownUntil - t) .. "s" else ""
						plot.LockLabel.TextColor3 = Color3.fromRGB(200, 200, 210)
						plot.LockButton.Color = LOCK_BUSY_COLOR
						if plot.GateGui then
							plot.GateGui.Enabled = false
						end
					else
						plot.LockLabel.Text = if plot.Owner then "LOCK BASE" else ""
						plot.LockLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
						plot.LockButton.Color = LOCK_READY_COLOR
						if plot.GateGui then
							plot.GateGui.Enabled = false
						end
					end
					if plot.Owner then
						plot.CollectLabel.Text = "COLLECT\n" .. Format.Money(plot.Vault)
					else
						plot.CollectLabel.Text = ""
					end

					-- Alarme: alguém entrou na sua base
					local owner = plot.Owner
					if owner then
						for _, other in Players:GetPlayers() do
							if other ~= owner then
								local character = other.Character
								local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
								if root and Plots.IsInside(plot, root.Position) then
									local key = plot.Index .. ":" .. other.UserId
									if os.clock() - (lastAlarm[key] or 0) > Config.IntruderAlarmCooldown then
										lastAlarm[key] = os.clock()
										Registry.Remotes.Notify(owner, "INTRUDER! " .. other.DisplayName .. " entered your base!", "error")
										Registry.Remotes.Effect(owner, "Alarm")
									end
								end
							end
						end
					end
				end
			end)
			if not ok then
				warn("[Plots] loop error:", err)
			end
		end
	end)
end

function Plots.Assign(player: Player)
	if byPlayer[player] then
		return byPlayer[player]
	end
	for _, plot in plots do
		if plot.Owner == nil then
			plot.Owner = player
			plot.Vault = 0
			plot.LockedUntil = 0
			plot.CooldownUntil = 0
			plot.Slots = {}
			setBarrier(plot, false)
			publishLockState(plot)
			plot.Model:SetAttribute("ShieldUntil", nil)
			plot.Model:SetAttribute("OwnerUserId", player.UserId)
			plot.Model:SetAttribute("OwnerName", player.DisplayName)
			byPlayer[player] = plot
			updateSign(plot)
			return plot
		end
	end
	return nil
end

function Plots.Release(player: Player)
	local plot = byPlayer[player]
	if not plot then
		return
	end
	byPlayer[player] = nil
	plot.Owner = nil
	plot.Vault = 0
	plot.LockedUntil = 0
	plot.CooldownUntil = 0
	plot.Slots = {}
	setBarrier(plot, false)
	publishLockState(plot)
	plot.Model:SetAttribute("OwnerUserId", nil)
	plot.Model:SetAttribute("OwnerName", nil)
	plot.Model:SetAttribute("ShieldUntil", nil)
	Plots.RefreshSlots(plot, Config.StartSlots)
	updateSign(plot)
	if Registry.Customize then
		Registry.Customize.ResetPlot(plot) -- tema e decoração voltam ao normal para o próximo dono
	end
	for key in lastAlarm do
		if string.sub(key, 1, #tostring(plot.Index) + 1) == plot.Index .. ":" then
			lastAlarm[key] = nil
		end
	end
end

function Plots.SpawnCFrame(plot): CFrame
	local base = plot.SpawnPoint.Position + Vector3.new(0, 4, 0)
	return CFrame.lookAt(base, base + plot.Origin.CFrame.LookVector)
end

function Plots.SetupCharacter(player: Player, character: Model)
	local plot = byPlayer[player]
	if not plot then
		return
	end
	local group = "Owner" .. plot.Index
	local function apply(descendant: Instance)
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = group
		end
	end
	for _, descendant in character:GetDescendants() do
		apply(descendant)
	end
	character.DescendantAdded:Connect(apply)

	task.spawn(function()
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if not root then
			return
		end
		task.wait(0.15)
		if character.Parent and byPlayer[player] == plot then
			character:PivotTo(Plots.SpawnCFrame(plot))
		end
	end)
end

return Plots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="459">
        <Properties>
          <string name="Name">Policy</string>
          <string name="Source"><![CDATA[--[[
	Policy (ModuleScript em ServerScriptService > Game)
	v17: respeita as regras de cada país do Roblox (PolicyService), exigidas no questionário de maturidade.
	  • ArePaidRandomItemsRestricted = true  -> não vende Cash Packs (Robux -> dinheiro -> ovos aleatórios)
	                                          e troca os OVOS do Season Pass pago por dinheiro fixo
	  • IsPaidItemTradingAllowed = false     -> presentes (dar bichinhos) ficam desligados
	  • IsContentSharingAllowed = false      -> o botão de foto não abre "compartilhar" (só salva na galeria)
	O resultado vira atributo do jogador (a tela esconde os botões):
	  PolicyRandomRestricted, PolicyTradingAllowed, PolicyShareAllowed, PolicyReady
	Se o Roblox não responder, o jogo fica no modo MAIS SEGURO (tudo restrito) e tenta de novo.
]]

local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Seasons = require(ReplicatedStorage.Shared.Seasons)

local Policy = {}

export type Info = { RandomRestricted: boolean, TradingAllowed: boolean, ShareAllowed: boolean, Ready: boolean }

local SAFE: Info = { RandomRestricted = true, TradingAllowed = false, ShareAllowed = false, Ready = false }
local STUDIO: Info = { RandomRestricted = false, TradingAllowed = true, ShareAllowed = true, Ready = true }

local cache: { [Player]: Info } = {}

-- permite trocar o PolicyService nos testes
Policy.Fetch = function(player: Player): any
	return PolicyService:GetPolicyInfoForPlayerAsync(player)
end

local function apply(player: Player, info: Info)
	cache[player] = info
	if player.Parent then
		player:SetAttribute("PolicyRandomRestricted", info.RandomRestricted)
		player:SetAttribute("PolicyTradingAllowed", info.TradingAllowed)
		player:SetAttribute("PolicyShareAllowed", info.ShareAllowed)
		player:SetAttribute("PolicyReady", info.Ready)
	end
end

-- Converte a resposta do Roblox (campos que faltarem = modo seguro)
function Policy.FromResult(result: any): Info
	if type(result) ~= "table" then
		return table.clone(SAFE)
	end
	return {
		RandomRestricted = result.ArePaidRandomItemsRestricted ~= false,
		TradingAllowed = result.IsPaidItemTradingAllowed == true,
		ShareAllowed = result.IsContentSharingAllowed == true,
		Ready = true,
	}
end

function Policy.Load(player: Player)
	apply(player, table.clone(SAFE))
	if RunService:IsStudio() then
		-- no Studio o PolicyService não responde de verdade: libera tudo para testar
		apply(player, table.clone(STUDIO))
		return
	end
	for attempt = 1, 4 do
		local ok, result = pcall(Policy.Fetch, player)
		if not player.Parent then
			return
		end
		if ok and type(result) == "table" then
			apply(player, Policy.FromResult(result))
			return
		end
		task.wait(2 * attempt)
	end
	warn("[Policy] no answer for", player.Name, "- keeping the safe mode")
end

function Policy.Get(player: Player): Info
	return cache[player] or SAFE
end

-- Pode vender coisas que viram itens aleatórios (Cash Packs)?
function Policy.CanBuyRandom(player: Player): boolean
	return not Policy.Get(player).RandomRestricted
end

-- Pode dar/receber bichinhos (que podem ter sido comprados com Robux)?
function Policy.CanTrade(player: Player): boolean
	return Policy.Get(player).TradingAllowed
end

-- Recompensa PAGA (Season Pass): onde itens aleatórios pagos são proibidos, os ovos viram dinheiro fixo
function Policy.SafePaidReward(player: Player, reward: any): any
	if Policy.CanBuyRandom(player) then
		return reward
	end
	return Seasons.NoRandom(reward)
end

-- Para testes
function Policy.Set(player: Player, info: Info)
	apply(player, info)
end

function Policy.Init()
	Players.PlayerAdded:Connect(function(player)
		task.spawn(Policy.Load, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(Policy.Load, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		cache[player] = nil
	end)
end

return Policy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="460">
        <Properties>
          <string name="Name">Products</string>
          <string name="Source"><![CDATA[--[[
	Products (ModuleScript em ServerScriptService > Game)
	Dev Products (compras que podem repetir), processados do jeito certo:
	  • o Roblox chama ProcessReceipt; a gente entrega, SALVA, e só então confirma a compra
	  • cada recibo é guardado para nunca entregar duas vezes
	Produtos: Instant Lock, Cash Pack S/M/L/XL, critters escolhidos (sem nada aleatório) e, na v20,
	Starter Pack, 2x Cash Boost, Lucky Potion, Base Shield e Instant Hatch.
	v20: a tela pede ao SERVIDOR para abrir a compra ("PromptProduct"): o servidor confere antes
	(tem ovo chocando? já tem o Starter Pack? o país permite?) e só então mostra a janela do Roblox.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Critters = require(ReplicatedStorage.Shared.Critters)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local Products = {}

local handlers: { [number]: (Player) -> boolean } = {}

-- Quanto dinheiro cada pacote dá (o maior entre o mínimo e X minutos da renda atual)
function Products.CashPackAmount(player: Player, packName: string): number
	local pack = Config.CashPacks[packName]
	if not pack then
		return 0
	end
	local income = Registry.Economy.GetIncome(player)
	return math.floor(math.max(pack.Minimum, income * 60 * pack.Minutes))
end

local function register()
	local ids = Config.DevProducts
	if ids.InstantLock and ids.InstantLock > 0 then
		handlers[ids.InstantLock] = function(player)
			return Registry.Plots.ForceLock(player)
		end
	end
	if ids.SeasonPass and ids.SeasonPass > 0 then
		handlers[ids.SeasonPass] = function(player)
			return Registry.Season.GrantPass(player)
		end
	end
	for packName in Config.CashPacks do
		local id = ids[packName]
		if id and id > 0 then
			handlers[id] = function(player)
				local amount = Products.CashPackAmount(player, packName)
				Registry.Economy.AddCash(player, amount, false, "CashPack")
				Registry.Remotes.Notify(player, "+" .. Format.Money(amount) .. "! Thank you!", "rare")
				Registry.Remotes.Effect(player, "Collect", amount)
				return true
			end
		end
	end
	for critterId, id in Config.CritterProducts do
		if id and id > 0 and Critters.ById[critterId] then
			handlers[id] = function(player)
				return Registry.CritterService.GrantCritter(player, critterId, nil)
			end
		end
	end
	-- v20
	if ids.StarterPack and ids.StarterPack > 0 then
		handlers[ids.StarterPack] = Products.GrantStarterPack
	end
	if ids.Boost30 and ids.Boost30 > 0 then
		handlers[ids.Boost30] = function(player)
			Registry.Codes.AddBoost(player, Config.PaidBoostMinutes)
			Registry.Remotes.Notify(player, ("2x CASH for %d minutes! Thank you!"):format(Config.PaidBoostMinutes), "rare")
			Registry.Remotes.Effect(player, "Purchase", "Epic")
			return true
		end
	end
	if ids.LuckyPotion and ids.LuckyPotion > 0 then
		handlers[ids.LuckyPotion] = function(player)
			Registry.Events.StartLucky(Config.LuckyPotionSeconds, player.DisplayName)
			Registry.Remotes.Effect(player, "Purchase", "Legendary")
			return true
		end
	end
	if ids.BaseShield and ids.BaseShield > 0 then
		handlers[ids.BaseShield] = function(player)
			return Registry.Fairness.AddPaidShield(player, Config.PaidShieldSeconds)
		end
	end
	if ids.InstantHatch and ids.InstantHatch > 0 then
		handlers[ids.InstantHatch] = function(player)
			local count = Registry.CritterService.HatchAllNow(player)
			Registry.Remotes.Notify(player, if count > 0 then ("%d egg(s) hatching NOW!"):format(count) else "No eggs were hatching, so nothing to speed up.", "rare")
			Registry.Remotes.Effect(player, "Purchase", "Epic")
			return true
		end
	end
end

-- Starter Pack (1 vez): dinheiro + Royal Egg + 2x Cash. Comprado de novo por engano, entrega de novo
-- (o jogador pagou), mas a loja esconde o botão e o servidor não abre a compra pela 2ª vez.
function Products.GrantStarterPack(player: Player): boolean
	local profile = Registry.Data.Get(player)
	if not profile then
		return false
	end
	local pack = Config.StarterPack
	profile.Data.StarterPack = true
	player:SetAttribute("StarterPack", true)
	Registry.Economy.AddCash(player, pack.Cash, false, "StarterPack")
	Registry.CritterService.GrantEgg(player, pack.Egg)
	Registry.Codes.AddBoost(player, pack.BoostMinutes)
	Registry.Remotes.Popup(player, "STARTER PACK!", ("+%s cash, a %s and 2x Cash for %d min. Thank you!"):format(Format.Money(pack.Cash), (Config.EggById[pack.Egg] or { Name = "Royal Egg" }).Name, pack.BoostMinutes))
	Registry.Remotes.Effect(player, "Purchase", "Legendary")
	return true
end

-- Pode comprar? (o servidor decide; a tela só esconde botões). Devolve false + motivo.
function Products.CanBuy(player: Player, key: string): (boolean, string?)
	local profile = Registry.Data.Get(player)
	if not profile or not player:GetAttribute("Loaded") then
		return false, "Still loading, try again in a second!"
	end
	local policy = Registry.Policy
	if key == "StarterPack" then
		if profile.Data.StarterPack then
			return false, "You already have the Starter Pack!"
		end
		if policy and not policy.CanBuyRandom(player) then
			return false, "Not available where you live." -- tem um ovo aleatório dentro
		end
	elseif Config.CashPacks[key] then
		if policy and not policy.CanBuyRandom(player) then
			return false, "Not available where you live."
		end
	elseif key == "InstantHatch" then
		if Registry.CritterService.IncubatingCount(player) <= 0 then
			return false, "No eggs hatching right now! Buy an egg first."
		end
	elseif key == "BaseShield" then
		local left = Registry.Fairness.ShieldLeft(player)
		if left >= Config.PaidShieldMaxSeconds then
			return false, "Your shield is already at the max!"
		end
	elseif key == "LuckyPotion" or key == "Boost30" or key == "InstantLock" or key == "SeasonPass" then
		-- sempre pode
	elseif Config.CritterProducts[key] then
		-- sempre pode (vai para a fila se a base estiver cheia)
	else
		return false, "Unknown product."
	end
	return true
end

-- A tela pede e o servidor abre a janela de compra do Roblox (só se puder)
function Products.Prompt(player: Player, key: any)
	if typeof(key) ~= "string" then
		return
	end
	local id = Config.DevProducts[key] or Config.CritterProducts[key] or 0
	if id <= 0 then
		Registry.Remotes.Notify(player, "This item is not for sale yet.", "info")
		return
	end
	local ok, reason = Products.CanBuy(player, key)
	if not ok then
		Registry.Remotes.Notify(player, reason or "Not available.", "warning")
		return
	end
	pcall(function()
		MarketplaceService:PromptProductPurchase(player, id)
	end)
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- espera o jogador terminar de carregar (até 30 s)
	local started = os.clock()
	while player.Parent and not player:GetAttribute("Loaded") and os.clock() - started < 30 do
		task.wait(0.5)
	end
	local profile = Registry.Data.Get(player)
	if not profile or not player.Parent or not player:GetAttribute("Loaded") or player:GetAttribute("Leaving") or profile.Final then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- se os dados desta sessão não podem ser salvos, entrega na próxima vez que ele entrar
	if not profile.CanSave and not RunService:IsStudio() then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if Registry.Data.HasReceipt(profile, receipt.PurchaseId) then
		-- já entregue antes, mas o save pode ter falhado: só confirma depois de um save que deu certo
		if profile.CanSave and not Registry.Data.Save(player) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local handler = handlers[receipt.ProductId]
	if not handler then
		warn("[Products] Produto sem configuração:", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, granted = pcall(handler, player)
	if not ok or not granted then
		warn("[Products] Falha ao entregar produto", receipt.ProductId, granted)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Registry.Data.AddReceipt(profile, receipt.PurchaseId)
	if profile.CanSave then
		-- só confirma a compra depois de salvar (se o save falhar, o Roblox tenta de novo depois)
		if not Registry.Data.Save(player) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Para os testes automáticos
function Products.Handlers()
	return handlers
end

function Products.Init()
	register()
	pcall(function()
		MarketplaceService.ProcessReceipt = processReceipt
	end)
end

return Products
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="461">
        <Properties>
          <string name="Name">Progress</string>
          <string name="Source"><![CDATA[--[[
	Progress (ModuleScript em ServerScriptService > Game)
	Parte 26 + missões diárias + conquistas (v10). O servidor decide tudo:
	  • nível da conta (o XP vem junto com o XP da temporada, com o mesmo limite diário anti-farm)
	  • árvore de habilidades (1 ponto por nível) e reset grátis 1 vez por dia
	  • classes Thief / Guardian / Creator (troca grátis, espera 30 min)
	  • prestígio com 10 rebirths: aura, estrela no nome e +100% de dinheiro para sempre
	  • 3 missões por dia + 1 troca grátis; prêmio em dinheiro e um ovo grátis por completar as 3
	  • conquistas (e Badges do Roblox, se os IDs estiverem em Progression.BadgeIds)
	  • recordes pessoais para a tela PROFILE
	A tela recebe tudo pelo RemoteEvent "ProgressSync".
]]

local BadgeService = game:GetService("BadgeService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Critters = require(ReplicatedStorage.Shared.Critters)
local Format = require(ReplicatedStorage.Shared.Format)
local Progression = require(ReplicatedStorage.Shared.Progression)
local Registry = require(script.Parent.Registry)

local Progress = {}

local dirty: { [Player]: boolean } = {}
local needsCheck: { [Player]: boolean } = {}
local badgeTried: { [Player]: { [string]: boolean } } = {}

local function today(): number
	return math.floor(os.time() / 86400)
end

local function getData(player: Player): any
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

-- Arruma os campos novos (saves antigos não têm nada disso)
local function ensure(data: any)
	if type(data.Progress) ~= "table" then
		data.Progress = {}
	end
	local progress = data.Progress
	progress.XP = math.max(0, tonumber(progress.XP) or 0)
	if type(progress.Skills) ~= "table" then
		progress.Skills = {}
	end
	progress.ResetDay = tonumber(progress.ResetDay) or 0
	progress.Class = if type(progress.Class) == "string" and Progression.Classes[progress.Class] then progress.Class else ""
	progress.ClassAt = tonumber(progress.ClassAt) or 0
	if type(data.Records) ~= "table" then
		data.Records = {}
	end
	if type(data.Achievements) ~= "table" then
		data.Achievements = {}
	end
	if type(data.BadgesSent) ~= "table" then
		data.BadgesSent = {}
	end
	if type(data.Missions) ~= "table" then
		data.Missions = {}
	end
	data.Prestige = math.max(0, math.floor(tonumber(data.Prestige) or 0))
	data.PeakRebirths = math.max(tonumber(data.PeakRebirths) or 0, tonumber(data.Rebirths) or 0)
end

local function markDirty(player: Player)
	dirty[player] = true
	needsCheck[player] = true
end

---------------------------------------------------------------------
-- Nível e habilidades
---------------------------------------------------------------------
function Progress.Level(player: Player): number
	local data = getData(player)
	if not data or type(data.Progress) ~= "table" then
		return 1
	end
	return (Progression.LevelFromXP(tonumber(data.Progress.XP) or 0))
end

local function rank(player: Player, name: string): number
	local data = getData(player)
	local skills = data and type(data.Progress) == "table" and data.Progress.Skills
	local info = Progression.Skills[name]
	if type(skills) ~= "table" or not info then
		return 0
	end
	return math.clamp(math.floor(tonumber(skills[name]) or 0), 0, info.Max)
end

local function classOf(player: Player): string
	local data = getData(player)
	return if data and type(data.Progress) == "table" and type(data.Progress.Class) == "string" then data.Progress.Class else ""
end

local function spentPoints(data: any): number
	local spent = 0
	for _, name in Progression.SkillOrder do
		spent += math.clamp(math.floor(tonumber(data.Progress.Skills[name]) or 0), 0, Progression.Skills[name].Max)
	end
	return spent
end

-- Efeitos (quem chama: Economy, Plots e CritterService)
function Progress.SpeedMultiplier(player: Player): number
	return 1 + rank(player, "Speed") * Progression.Skills.Speed.Per
end

function Progress.CarryMultiplier(player: Player, base: number): number
	local bonus = rank(player, "Steal") * Progression.Skills.Steal.Per
	if classOf(player) == "Thief" then
		bonus += Progression.ThiefCarry
	end
	return math.min(Progression.MaxCarryMultiplier, base + bonus)
end

function Progress.LockBonus(player: Player): number
	local bonus = rank(player, "Defense") * Progression.Skills.Defense.Per
	if classOf(player) == "Guardian" then
		bonus += Progression.GuardianLock
	end
	return bonus
end

function Progress.LuckMultiplier(player: Player): number
	return 1 + rank(player, "Luck") * Progression.Skills.Luck.Per
end

function Progress.HatchMultiplier(player: Player): number
	return if classOf(player) == "Creator" then Progression.CreatorHatch else 1
end

function Progress.PrestigeMultiplier(player: Player): number
	local data = getData(player)
	local prestige = if data then tonumber(data.Prestige) or 0 else 0
	return 1 + prestige * Progression.PrestigeBonus
end

-- Rebirths que contam para vagas e esteira (o prestígio não tira as vagas que você já tinha)
function Progress.PeakRebirths(player: Player): number
	local data = getData(player)
	if not data then
		return 0
	end
	return math.max(tonumber(data.Rebirths) or 0, tonumber(data.PeakRebirths) or 0)
end

---------------------------------------------------------------------
-- Prêmios
---------------------------------------------------------------------
local function grant(player: Player, reward): string
	local codes = Registry.Codes
	if not codes then
		return ""
	end
	local ok, parts = pcall(codes.Grant, player, reward)
	return if ok and type(parts) == "table" then table.concat(parts, " + ") else ""
end

---------------------------------------------------------------------
-- Missões diárias
---------------------------------------------------------------------
local function ensureMissions(player: Player, data: any)
	local day = today()
	local missions = data.Missions
	if missions.Day == day and type(missions.List) == "table" then
		return missions
	end
	local list = {}
	for _, pick in Progression.PickMissions(player.UserId, day) do
		table.insert(list, { Kind = pick.Kind, Need = pick.Need, Have = 0, Done = false })
	end
	data.Missions = { Day = day, List = list, Swapped = false, Bonus = false }
	return data.Missions
end

local function completeMission(player: Player, data: any, missions: any, mission: any)
	mission.Done = true
	mission.Have = mission.Need
	local text = grant(player, Progression.MissionReward)
	Registry.Remotes.Notify(player, ("QUEST COMPLETE: %s! +%s"):format(Progression.MissionText(mission.Kind, mission.Need), text), "success")
	Registry.Remotes.Effect(player, "Quest")
	for _, other in missions.List do
		if not other.Done then
			return
		end
	end
	if not missions.Bonus then
		missions.Bonus = true
		data.Records.MissionDays = (tonumber(data.Records.MissionDays) or 0) + 1
		local bonus = grant(player, Progression.MissionBonus)
		local season = Registry.Season
		if season then
			season.AddXP(player, Progression.MissionBonusXP, "Quests")
		end
		Registry.Remotes.Notify(player, "ALL 3 QUESTS DONE! Bonus: " .. bonus .. ". New quests tomorrow!", "rare")
		Registry.Remotes.Effect(player, "QuestsAll")
	end
end

-- Troca 1 missão (1 vez por dia, grátis)
function Progress.Swap(player: Player, index: any)
	local data = getData(player)
	if not data or typeof(index) ~= "number" then
		return
	end
	ensure(data)
	local missions = ensureMissions(player, data)
	local mission = missions.List[math.floor(index)]
	if not mission or mission.Done then
		return
	end
	if missions.Swapped then
		Registry.Remotes.Notify(player, "You already swapped a quest today. New quests tomorrow!", "info")
		return
	end
	local used = {}
	for _, other in missions.List do
		used[other.Kind] = true
	end
	local options = {}
	for _, info in Progression.MissionPool do
		if not used[info.Kind] then
			table.insert(options, info)
		end
	end
	if #options == 0 then
		return
	end
	local pick = options[math.random(1, #options)]
	missions.List[math.floor(index)] = { Kind = pick.Kind, Need = pick.Need, Have = 0, Done = false }
	missions.Swapped = true
	Registry.Remotes.Notify(player, "New quest: " .. Progression.MissionText(pick.Kind, pick.Need), "info")
	markDirty(player)
end

---------------------------------------------------------------------
-- Eventos (chocou, roubou, fez carinho...) -> missões e recordes
---------------------------------------------------------------------
local RECORD_OF = {
	Shiny = "Shinies", GiantEgg = "GiantEggs", Mix = "Mixes", Monster = "Monsters", Minigame = "Minigames", MinigameWin = "MinigameWins",
	Island = "IslandVisits", Fish = "Fish", Fossil = "Fossils", HuntDone = "HuntDays", Hunt = "HuntEggs", Dig = "Digs",
}

function Progress.Event(player: Player, kind: string, amount: number?)
	local data = getData(player)
	if not data or not player:GetAttribute("Loaded") then
		return
	end
	ensure(data)
	local count = math.max(1, math.floor(amount or 1))
	local record = RECORD_OF[kind]
	if record then
		data.Records[record] = (tonumber(data.Records[record]) or 0) + count
	end
	local missions = ensureMissions(player, data)
	for _, mission in missions.List do
		if mission.Kind == kind and not mission.Done then
			mission.Have = math.min(mission.Need, (tonumber(mission.Have) or 0) + count)
			if mission.Have >= mission.Need then
				completeMission(player, data, missions, mission)
			end
		end
	end
	markDirty(player)
end

---------------------------------------------------------------------
-- XP da conta (o Season chama depois de aplicar o limite diário)
---------------------------------------------------------------------
function Progress.AddXP(player: Player, amount: number)
	local data = getData(player)
	if not data or amount <= 0 then
		return
	end
	ensure(data)
	local before = Progression.LevelFromXP(data.Progress.XP)
	data.Progress.XP += math.floor(amount)
	local after = Progression.LevelFromXP(data.Progress.XP)
	if after > before then
		player:SetAttribute("Level", after)
		Registry.Remotes.Notify(player, ("LEVEL UP! You are level %d. You got a skill point: open QUESTS > SKILLS"):format(after), "rare")
		Registry.Remotes.Effect(player, "LevelUp", after)
	end
	markDirty(player)
end

---------------------------------------------------------------------
-- Habilidades e classes (pedidos da tela)
---------------------------------------------------------------------
function Progress.SkillUp(player: Player, name: any)
	local data = getData(player)
	local info = typeof(name) == "string" and Progression.Skills[name]
	if not data or not info then
		return
	end
	ensure(data)
	local points = Progression.PointsForLevel(Progress.Level(player)) - spentPoints(data)
	local current = rank(player, name)
	if current >= info.Max then
		Registry.Remotes.Notify(player, info.Name .. " is already MAX!", "info")
		return
	end
	if points <= 0 then
		Registry.Remotes.Notify(player, "No skill points left. Level up to get more!", "info")
		return
	end
	data.Progress.Skills[name] = current + 1
	Registry.Economy.ApplySpeed(player)
	Registry.Remotes.Effect(player, "SkillUp", name)
	markDirty(player)
end

function Progress.SkillReset(player: Player)
	local data = getData(player)
	if not data then
		return
	end
	ensure(data)
	if data.Progress.ResetDay == today() then
		Registry.Remotes.Notify(player, "You already used your free reset today. Come back tomorrow!", "info")
		return
	end
	if spentPoints(data) == 0 then
		return
	end
	data.Progress.Skills = {}
	data.Progress.ResetDay = today()
	Registry.Economy.ApplySpeed(player)
	Registry.Remotes.Notify(player, "Skills reset! Spend your points again.", "success")
	markDirty(player)
end

function Progress.SetClass(player: Player, name: any)
	local data = getData(player)
	if not data or typeof(name) ~= "string" or not Progression.Classes[name] then
		return
	end
	ensure(data)
	if data.Progress.Class == name then
		return
	end
	local wait = data.Progress.ClassAt + Progression.ClassCooldown - os.time()
	if data.Progress.Class ~= "" and wait > 0 then
		Registry.Remotes.Notify(player, "You can change class again in " .. Format.Time(wait), "info")
		return
	end
	data.Progress.Class = name
	data.Progress.ClassAt = os.time()
	player:SetAttribute("Class", name)
	Registry.Economy.ApplySpeed(player)
	Registry.Remotes.Notify(player, ("You are now a %s! %s"):format(name, Progression.Classes[name].Desc), "success")
	Registry.Remotes.Effect(player, "SkillUp", name)
	markDirty(player)
end

---------------------------------------------------------------------
-- Prestígio (10 rebirths)
---------------------------------------------------------------------
function Progress.ApplyAura(player: Player)
	local data = getData(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not data or not root then
		return
	end
	local old = root:FindFirstChild("PrestigeAura")
	if old then
		old:Destroy()
	end
	local prestige = tonumber(data.Prestige) or 0
	if prestige <= 0 then
		return
	end
	local aura = Instance.new("ParticleEmitter")
	aura.Name = "PrestigeAura"
	aura.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	aura.Color = ColorSequence.new(Progression.PrestigeColor(prestige))
	aura.LightEmission = 0.7
	aura.Size = NumberSequence.new(0.5, 0)
	aura.Transparency = NumberSequence.new(0.2, 1)
	aura.Lifetime = NumberRange.new(1, 1.6)
	aura.Speed = NumberRange.new(1, 2.5)
	aura.SpreadAngle = Vector2.new(180, 180)
	aura.Rate = 6 + math.min(prestige, 5) * 2
	aura.Parent = root
end

function Progress.Prestige(player: Player)
	local data = getData(player)
	if not data then
		return
	end
	ensure(data)
	local needed = Progression.PrestigeNeed(data.Prestige)
	if data.Rebirths < needed then
		Registry.Remotes.Notify(player, ("You need %d rebirths to Prestige."):format(needed), "info")
		return
	end
	if Registry.CritterService.IsCarrying(player) then
		Registry.Remotes.Notify(player, "Put down what you are carrying first!", "warning")
		return
	end
	data.PeakRebirths = math.max(data.PeakRebirths, data.Rebirths)
	data.Rebirths = 0
	data.Cash = 0
	data.Prestige += 1
	local plot = Registry.Plots.Get(player)
	if plot then
		plot.Vault = 0
		Registry.Plots.RefreshSlots(plot, Registry.Economy.GetSlotCount(player))
	end
	player:SetAttribute("Prestige", data.Prestige)
	Registry.Economy.Sync(player)
	Registry.Economy.ApplySpeed(player)
	Progress.ApplyAura(player)
	local customize = Registry.Customize
	if customize then
		customize.RefreshTag(player)
	end
	Registry.Remotes.NotifyAll(("%s reached PRESTIGE %d!"):format(player.DisplayName, data.Prestige), "rare")
	Registry.Remotes.Effect(player, "Prestige", data.Prestige)
	Registry.Remotes.Popup(
		player,
		"PRESTIGE " .. data.Prestige .. "!",
		("Your cash is now x%g forever, you have a new aura and a star next to your name. You kept your critters, worlds, slots and pets!"):format(
			Progress.PrestigeMultiplier(player)
		)
	)
	markDirty(player)
	task.spawn(Registry.Data.Save, player)
end

---------------------------------------------------------------------
-- Conquistas e Badges
---------------------------------------------------------------------
-- 1 tentativa por sessão para cada Badge (sem ficar repetindo se o Roblox recusar)
local function awardBadge(player: Player, data: any, id: string)
	local badgeId = Progression.BadgeIds[id]
	if type(badgeId) ~= "number" or badgeId <= 0 or data.BadgesSent[id] then
		return
	end
	local tried = badgeTried[player] or {}
	badgeTried[player] = tried
	if tried[id] then
		return
	end
	tried[id] = true
	task.spawn(function()
		local okHas, has = pcall(function()
			return BadgeService:UserHasBadgeAsync(player.UserId, badgeId)
		end)
		if okHas and has then
			data.BadgesSent[id] = true
			return
		end
		local ok, awarded = pcall(function()
			return BadgeService:AwardBadge(player.UserId, badgeId)
		end)
		if ok and awarded then
			data.BadgesSent[id] = true
		end
	end)
end

local function summary(player: Player, data: any)
	local best = { Legendary = 0, Mythic = 0, Secret = 0 }
	for id in data.Index do
		local def = Critters.ById[id]
		if def and best[def.Rarity] then
			best[def.Rarity] = 1
		end
	end
	local worlds = Registry.Worlds
	return {
		Joined = 1,
		Hatched = tonumber(data.Hatched) or 0,
		Steals = tonumber(data.Steals) or 0,
		Defends = tonumber(data.Defends) or 0,
		Collected = tonumber(data.Collected) or 0,
		Rebirths = math.max(tonumber(data.Rebirths) or 0, tonumber(data.PeakRebirths) or 0),
		Prestige = tonumber(data.Prestige) or 0,
		Level = (Progression.LevelFromXP(data.Progress.XP)),
		Shinies = tonumber(data.Records.Shinies) or 0,
		GiantEggs = tonumber(data.Records.GiantEggs) or 0,
		Mixes = tonumber(data.Records.Mixes) or 0,
		MissionDays = tonumber(data.Records.MissionDays) or 0,
		MinigameWins = tonumber(data.Records.MinigameWins) or 0,
		IslandVisits = tonumber(data.Records.IslandVisits) or 0,
		Fish = tonumber(data.Records.Fish) or 0,
		Fossils = tonumber(data.Records.Fossils) or 0,
		HuntDays = tonumber(data.Records.HuntDays) or 0,
		Galaxy = if worlds and worlds.IsUnlocked(player, "galaxy") then 1 else 0,
		Legendary = best.Legendary,
		Mythic = best.Mythic,
		Secret = best.Secret,
	}
end

function Progress.CheckAchievements(player: Player, quiet: boolean?)
	local data = getData(player)
	if not data then
		return
	end
	ensure(data)
	local stats = summary(player, data)
	local quietCount = 0
	for _, achievement in Progression.Achievements do
		if not data.Achievements[achievement.Id] and (stats[achievement.Stat] or 0) >= achievement.At then
			data.Achievements[achievement.Id] = os.time()
			if quiet then
				quietCount += if achievement.Id == "Welcome" then 0 else 1
			elseif achievement.Id ~= "Welcome" then
				Registry.Remotes.Notify(player, ("ACHIEVEMENT: %s! (%s)"):format(achievement.Name, achievement.Desc), "rare")
				Registry.Remotes.Effect(player, "Achievement", achievement.Name)
			end
			dirty[player] = true
		end
		if data.Achievements[achievement.Id] then
			awardBadge(player, data, achievement.Id)
		end
	end
	if quietCount > 0 then
		Registry.Remotes.Notify(player, ("You already earned %d achievements! See them in QUESTS > PROFILE."):format(quietCount), "rare")
	end
end

---------------------------------------------------------------------
-- Tela
---------------------------------------------------------------------
function Progress.Sync(player: Player)
	local data = getData(player)
	if not data or not player.Parent then
		return
	end
	ensure(data)
	dirty[player] = nil
	local missions = ensureMissions(player, data)
	local level, into, need = Progression.LevelFromXP(data.Progress.XP)
	local skills = {}
	for _, name in Progression.SkillOrder do
		skills[name] = rank(player, name)
	end
	local list = {}
	for _, mission in missions.List do
		table.insert(list, { Kind = mission.Kind, Need = mission.Need, Have = mission.Have, Done = mission.Done })
	end
	local achievements = {}
	for id in data.Achievements do
		table.insert(achievements, id)
	end
	local records = {}
	for key, value in data.Records do
		records[key] = tonumber(value) or 0
	end
	records.Hatched = tonumber(data.Hatched) or 0
	records.Steals = tonumber(data.Steals) or 0
	records.Defends = tonumber(data.Defends) or 0
	records.Collected = tonumber(data.Collected) or 0
	records.PlayTime = tonumber(data.PlayTime) or 0
	records.TotalEarned = tonumber(data.TotalEarned) or 0
	records.PeakRebirths = math.max(tonumber(data.Rebirths) or 0, tonumber(data.PeakRebirths) or 0)
	local classWait = data.Progress.ClassAt + Progression.ClassCooldown - os.time()
	Registry.Remotes.ProgressEvent:FireClient(player, {
		Level = level,
		XPInto = into,
		XPNeed = need,
		Points = Progression.PointsForLevel(level) - spentPoints(data),
		Skills = skills,
		ResetReady = data.Progress.ResetDay ~= today(),
		Class = data.Progress.Class,
		ClassWait = if data.Progress.Class ~= "" then math.max(0, classWait) else 0,
		Prestige = data.Prestige,
		PrestigeNeed = Progression.PrestigeNeed(data.Prestige),
		Rebirths = data.Rebirths,
		Missions = list,
		Swapped = missions.Swapped == true,
		Bonus = missions.Bonus == true,
		DayEndsIn = (today() + 1) * 86400 - os.time(),
		Records = records,
		Achievements = achievements,
	})
end

function Progress.SetupPlayer(player: Player)
	local data = getData(player)
	if not data then
		return
	end
	ensure(data)
	ensureMissions(player, data)
	player:SetAttribute("Level", Progress.Level(player))
	player:SetAttribute("Prestige", data.Prestige)
	player:SetAttribute("PeakRebirths", data.PeakRebirths)
	player:SetAttribute("Class", data.Progress.Class)
	Progress.CheckAchievements(player, true) -- quem já jogava ganha tudo de uma vez, sem chuva de avisos
	Progress.Sync(player)
end

function Progress.OnCharacter(player: Player)
	Progress.ApplyAura(player)
end

function Progress.RemovePlayer(player: Player)
	dirty[player] = nil
	needsCheck[player] = nil
	badgeTried[player] = nil
end

function Progress.Init()
	Players.PlayerRemoving:Connect(Progress.RemovePlayer)
	-- conquistas e tela: no máximo 1 vez por segundo por jogador
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(function()
				for player in needsCheck do
					needsCheck[player] = nil
					if player.Parent then
						Progress.CheckAchievements(player)
					end
				end
				for player in dirty do
					if player.Parent then
						Progress.Sync(player)
					else
						dirty[player] = nil
					end
				end
			end)
			if not ok then
				warn("[Progress] loop error:", err)
			end
		end
	end)
	-- a cada minuto: missão "jogar X minutos" e recordes
	task.spawn(function()
		while true do
			task.wait(60)
			local ok, err = pcall(function()
				for _, player in Players:GetPlayers() do
					local data = getData(player)
					if data and player:GetAttribute("Loaded") then
						ensure(data)
						local income = Registry.Economy.GetIncome(player)
						data.Records.BestIncome = math.max(tonumber(data.Records.BestIncome) or 0, income)
						data.Records.BestCash = math.max(tonumber(data.Records.BestCash) or 0, tonumber(data.Cash) or 0)
						Progress.Event(player, "Minute")
					end
				end
			end)
			if not ok then
				warn("[Progress] loop error:", err)
			end
		end
	end)
end

return Progress
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="462">
        <Properties>
          <string name="Name">Registry</string>
          <string name="Source"><![CDATA[-- Tabela compartilhada para os módulos do servidor se encontrarem (evita require circular).
local Registry: any = {}
return Registry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="463">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Canais de comunicação entre servidor e jogadores.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local function makeEvent(name: string): RemoteEvent
	local event = Instance.new("RemoteEvent")
	event.Name = name
	event.Parent = folder
	return event
end

Remotes.NotifyEvent = makeEvent("Notify") -- servidor -> jogador: (texto, tipo)
Remotes.PopupEvent = makeEvent("Popup") -- servidor -> jogador: (título, texto)
Remotes.KnockbackEvent = makeEvent("Knockback") -- servidor -> jogador: (velocidade)
Remotes.EffectEvent = makeEvent("Effect") -- servidor -> jogador(es): (tipo, dados)
Remotes.IndexEvent = makeEvent("IndexSync") -- servidor -> jogador: (tabela do índice)
Remotes.RequestEvent = makeEvent("Request") -- jogador -> servidor: (ação, argumento)
Remotes.InventoryEvent = makeEvent("InventorySync") -- servidor -> jogador: mochila, pets e bichinhos da base
Remotes.StyleEvent = makeEvent("StyleSync") -- servidor -> jogador: temas, decoração, trilhas e títulos
Remotes.SeasonEvent = makeEvent("SeasonSync") -- servidor -> jogador: passe da temporada e placar
Remotes.ProgressEvent = makeEvent("ProgressSync") -- servidor -> jogador: nível, habilidades, missões, conquistas (v10)
Remotes.SocialEvent = makeEvent("SocialSync") -- servidor -> jogador: likes, presentes e clã (v11)
Remotes.BattleEvent = makeEvent("BattleSync") -- servidor -> jogador: a luta do Critter Battle (v12)

folder.Parent = ReplicatedStorage

function Remotes.Notify(player: Player, text: string, kind: string?)
	Remotes.NotifyEvent:FireClient(player, text, kind or "info")
end

function Remotes.NotifyAll(text: string, kind: string?)
	Remotes.NotifyEvent:FireAllClients(text, kind or "info")
end

function Remotes.Popup(player: Player, title: string, body: string)
	Remotes.PopupEvent:FireClient(player, title, body)
end

function Remotes.Effect(player: Player, kind: string, data: any?)
	Remotes.EffectEvent:FireClient(player, kind, data)
end

function Remotes.EffectAll(kind: string, data: any?)
	Remotes.EffectEvent:FireAllClients(kind, data)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="464">
        <Properties>
          <string name="Name">Retention</string>
          <string name="Source"><![CDATA[--[[
	Retention (ModuleScript em ServerScriptService > Game)
	v23: duas coisas para o jogador ficar mais tempo e voltar amanhã.
	  • PRESENTES DE TEMPO DE JOGO: a cada X minutos na sessão (Config.PlaytimeGifts) aparece um presente
	    na coluna da esquerda; o jogador clica e recebe (dinheiro, ovo ou 2x Cash). Zera quando sai.
	  • ROLETA DIÁRIA: 1 giro grátis por dia (Config.DailySpin). O servidor sorteia, entrega e manda o
	    resultado; a tela só faz a animação. Nunca custa Robux (por isso pode ser aleatória).
	Tudo é decidido aqui; a tela só pede ("GiftClaim" e "SpinDaily").
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local Retention = {}

type Session = { Seconds: number, Tier: number, ReadyAt: number } -- ReadyAt = os.time() em que o presente atual fica pronto
local sessions: { [Player]: Session } = {}

local function getData(player: Player)
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

local function today(): number
	return math.floor(os.time() / 86400)
end

-- Quantos segundos de sessão o presente "tier" exige
local function tierSeconds(tier: number): number
	local gifts = Config.PlaytimeGifts
	if tier <= #gifts then
		return gifts[tier].Minutes * 60
	end
	return gifts[#gifts].Minutes * 60 + (tier - #gifts) * Config.PlaytimeGiftRepeat * 60
end

local function giftFor(tier: number)
	local gifts = Config.PlaytimeGifts
	if tier <= #gifts then
		return gifts[tier]
	end
	return { Cash = 6 } -- depois do último: dinheiro a cada PlaytimeGiftRepeat min
end

local function publish(player: Player, session: Session)
	player:SetAttribute("GiftTier", session.Tier)
	player:SetAttribute("GiftReadyAt", session.ReadyAt) -- os.time(); a tela mostra a contagem
	local gift = giftFor(session.Tier)
	local text = if gift.Egg then (Config.EggById[gift.Egg] or { Name = "Egg" }).Name
		elseif gift.Boost and gift.Cash then ("2x Cash %dm + cash"):format(gift.Boost)
		elseif gift.Boost then ("2x Cash %d min"):format(gift.Boost)
		else "Cash"
	player:SetAttribute("GiftName", text)
end

local function startSession(player: Player)
	local session = { Seconds = 0, Tier = 1, ReadyAt = os.time() + tierSeconds(1) }
	sessions[player] = session
	publish(player, session)
end

-- Entrega um prêmio genérico ({ Cash = minutos, Egg = id, Boost = minutos }) e devolve o texto
local function grant(player: Player, reward, minCash: number, source: string): string
	local parts = {}
	local Economy = Registry.Economy
	if type(reward.Cash) == "number" then
		local amount = math.floor(math.max(Economy.GetIncome(player) * 60 * reward.Cash, minCash))
		Economy.AddCash(player, amount, false, source)
		table.insert(parts, "+" .. Format.Money(amount))
	end
	if type(reward.Boost) == "number" then
		Registry.Codes.AddBoost(player, reward.Boost)
		table.insert(parts, ("2x Cash %d min"):format(reward.Boost))
	end
	if type(reward.Egg) == "string" and Config.EggById[reward.Egg] then
		local ok = Registry.CritterService.GrantEgg(player, reward.Egg)
		table.insert(parts, Config.EggById[reward.Egg].Name .. (if ok then "" else " (queued: base full)"))
	end
	return table.concat(parts, " + ")
end
Retention.Grant = grant -- v27: o WorldFun usa o mesmo jeito de dar prêmio

---------------------------------------------------------------------
-- Presentes de tempo de jogo
---------------------------------------------------------------------
function Retention.ClaimGift(player: Player)
	local session = sessions[player]
	if not session or not player:GetAttribute("Loaded") then
		return
	end
	if os.time() < session.ReadyAt then
		Registry.Remotes.Notify(player, ("Gift in %s!"):format(Format.Time(session.ReadyAt - os.time())), "info")
		return
	end
	local gift = giftFor(session.Tier)
	local text = grant(player, gift, Config.PlaytimeGiftMinCash, "PlaytimeGift")
	Registry.Remotes.Notify(player, ("Playtime gift #%d: %s!"):format(session.Tier, text), "rare")
	Registry.Remotes.Effect(player, "Purchase", "Epic")
	if Registry.Analytics then
		pcall(Registry.Analytics.Event, player, "PlaytimeGift", session.Tier)
	end
	session.Tier += 1
	session.ReadyAt = os.time() + (tierSeconds(session.Tier) - tierSeconds(session.Tier - 1))
	publish(player, session)
end

---------------------------------------------------------------------
-- Roleta diária
---------------------------------------------------------------------
function Retention.SpinReady(player: Player): boolean
	local data = getData(player)
	return data ~= nil and (tonumber(data.SpinDay) or 0) ~= today()
end

function Retention.SyncSpin(player: Player)
	player:SetAttribute("SpinReady", Retention.SpinReady(player))
end

function Retention.Spin(player: Player)
	local data = getData(player)
	if not data or not player:GetAttribute("Loaded") then
		return
	end
	if not Retention.SpinReady(player) then
		Registry.Remotes.Notify(player, "You already spun today! Come back tomorrow.", "info")
		return
	end
	data.SpinDay = today()
	Retention.SyncSpin(player)
	-- sorteio pelos pesos (a tela mostra as % de cada prêmio)
	local total = 0
	for _, prize in Config.DailySpin do
		total += prize.Weight
	end
	local roll = math.random() * total
	local index = #Config.DailySpin
	for i, prize in Config.DailySpin do
		roll -= prize.Weight
		if roll <= 0 then
			index = i
			break
		end
	end
	local prize = Config.DailySpin[index]
	-- a tela gira primeiro (2,6 s) e só depois o prêmio "chega"
	Registry.Remotes.Effect(player, "Spin", { Index = index })
	task.delay(2.7, function()
		if not player.Parent then
			return
		end
		local text = grant(player, prize, Config.DailySpinMinCash, "DailySpin")
		Registry.Remotes.Notify(player, ("Daily spin: %s!"):format(text), "rare")
		if index >= #Config.DailySpin - 1 then
			Registry.Remotes.NotifyAll(("%s hit %s on the Daily Spin!"):format(player.DisplayName, string.upper(prize.Name)), "rare")
		end
	end)
	if Registry.Analytics then
		pcall(Registry.Analytics.Event, player, "DailySpin", index)
	end
end

function Retention.Init()
	local function watch(player: Player)
		startSession(player)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)
	-- quando os dados carregam, avisa se a roleta está pronta
	Players.PlayerAdded:Connect(function(player)
		player:GetAttributeChangedSignal("Loaded"):Connect(function()
			if player:GetAttribute("Loaded") then
				Retention.SyncSpin(player)
			end
		end)
	end)
	-- conta o tempo só de quem está carregado (o relógio do presente é por os.time(), então
	-- o servidor não precisa de loop por frame; aqui só reforça o atributo a cada 30 s)
	-- v24: MARCOS para o Analytics (Creator Hub > Analytics > Custom): minutos de sessão e bichinhos na base.
	--   Cada marco conta 1x por sessão; assim dá para ver em que minuto a criança para de jogar.
	local SESSION_MARKS = { 2, 5, 10, 20, 30, 60 }
	local CRITTER_MARKS = { 3, 5, 10, 25, 42 }
	local marksSent: { [Player]: { [string]: boolean } } = {}
	Players.PlayerRemoving:Connect(function(player)
		marksSent[player] = nil
	end)
	local function mark(player: Player, name: string, value: number?)
		local sent = marksSent[player]
		if not sent then
			sent = {}
			marksSent[player] = sent
		end
		if sent[name] then
			return
		end
		sent[name] = true
		local analytics = Registry.Analytics
		if analytics then
			pcall(analytics.Event, player, name, value)
		end
	end
	task.spawn(function()
		local started: { [Player]: number } = {}
		while true do
			task.wait(30)
			for player, session in sessions do
				if player.Parent then
					publish(player, session)
					if player:GetAttribute("Loaded") then
						Retention.SyncSpin(player)
						started[player] = started[player] or os.time()
						local minutes = (os.time() - started[player]) / 60
						for _, m in SESSION_MARKS do
							if minutes >= m then
								mark(player, ("Session%dMin"):format(m), m)
							end
						end
						local critterService = Registry.CritterService
						if critterService then
							local ok, list = pcall(critterService.GetBaseList, player)
							local count = if ok and type(list) == "table" then #list else 0
							for _, c in CRITTER_MARKS do
								if count >= c then
									mark(player, ("Critters%d"):format(c), c)
								end
							end
						end
					end
				else
					started[player] = nil
				end
			end
		end
	end)
end

return Retention
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="465">
        <Properties>
          <string name="Name">Scenery</string>
          <string name="Source"><![CDATA[--[[
	Scenery (ModuleScript em ServerScriptService > Game)
	Deixa o mapa bonito quando o jogo começa:
	  • TERRENO de verdade: morros de grama e lago com cachoeira no Meadow, morros de doce no Candy,
	    montanhas de neve no Frost, vulcão gigante no Lava, mar no Reef e asteroides no Galaxy
	  • PARTÍCULAS nas peças com a Tag "FX" (fumaça, fogo, neve, bolhas, brasas, névoa, fonte, brilho)
	  • TEXTO nas placas com a Tag "Sign"
	  • nuvens e cores do terreno
	Obs.: o terreno só aparece quando você aperta Play (ele é criado por este script).
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Scenery = {}

local Terrain = workspace.Terrain
local M = Enum.Material

---------------------------------------------------------------------
-- Placas com texto
---------------------------------------------------------------------
local FACES = {
	Front = Enum.NormalId.Front,
	Back = Enum.NormalId.Back,
	Left = Enum.NormalId.Left,
	Right = Enum.NormalId.Right,
	Top = Enum.NormalId.Top,
}

local function setupSign(part: Instance)
	if not part:IsA("BasePart") or part:FindFirstChild("SignGui") then
		return
	end
	local text = tostring(part:GetAttribute("Text") or "")
	local hex = part:GetAttribute("TextColor")
	local color = if typeof(hex) == "string" then Color3.fromHex(hex) else Color3.new(1, 1, 1)
	local faces = tostring(part:GetAttribute("Faces") or "Back")
	for _, faceName in string.split(faces, ",") do
		local face = FACES[faceName]
		if face then
			local gui = Instance.new("SurfaceGui")
			gui.Name = "SignGui"
			gui.Face = face
			gui.LightInfluence = 0
			gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			gui.PixelsPerStud = 30
			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Size = UDim2.new(1, -16, 1, -10)
			label.Position = UDim2.fromOffset(8, 5)
			label.Font = Enum.Font.FredokaOne
			label.TextScaled = true
			label.TextColor3 = color
			label.Text = text
			local stroke = Instance.new("UIStroke")
			stroke.Thickness = 3
			stroke.Color = Color3.fromRGB(20, 20, 35)
			stroke.Parent = label
			label.Parent = gui
			gui.Parent = part
		end
	end
end

---------------------------------------------------------------------
-- Partículas
---------------------------------------------------------------------
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"

local function seq(a: number, b: number): NumberSequence
	return NumberSequence.new(a, b)
end

local function emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	for key, value in props do
		(e :: any)[key] = value
	end
	e.Parent = parent
	return e
end

local function setupFx(part: Instance)
	if not part:IsA("BasePart") or part:FindFirstChild("SceneryFx") then
		return
	end
	local marker = Instance.new("Folder")
	marker.Name = "SceneryFx"
	marker.Parent = part
	local effect = part:GetAttribute("Effect")
	local big = part:GetAttribute("Big") == true
	local hex = part:GetAttribute("Color")
	local tint = if typeof(hex) == "string" then Color3.fromHex(hex) else Color3.fromRGB(255, 240, 180)
	local area = part.Size.X * part.Size.Z

	if effect == "Smoke" then
		emitter(part, {
			Texture = SMOKE,
			Color = ColorSequence.new(Color3.fromRGB(120, 120, 125), Color3.fromRGB(70, 70, 75)),
			Size = if big then seq(10, 30) else seq(3, 10),
			Transparency = seq(0.35, 1),
			Lifetime = NumberRange.new(4, 7),
			Rate = if big then 10 else 5,
			Speed = if big then NumberRange.new(10, 14) else NumberRange.new(4, 7),
			SpreadAngle = Vector2.new(12, 12),
			RotSpeed = NumberRange.new(-20, 20),
			EmissionDirection = Enum.NormalId.Top,
		})
	elseif effect == "Fire" then
		local fire = Instance.new("Fire")
		fire.Size = math.clamp(math.min(part.Size.X, part.Size.Z), 3, 25)
		fire.Heat = 14
		fire.Color = Color3.fromRGB(255, 120, 30)
		fire.SecondaryColor = Color3.fromRGB(255, 220, 80)
		fire.Parent = part
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 140, 50)
		light.Range = math.clamp(fire.Size * 2, 10, 50)
		light.Brightness = 2
		light.Parent = part
	elseif effect == "Snow" then
		emitter(part, {
			Texture = SPARK,
			Color = ColorSequence.new(Color3.new(1, 1, 1)),
			LightEmission = 0.3,
			Size = seq(0.5, 0.35),
			Transparency = seq(0.1, 0.4),
			Lifetime = NumberRange.new(10, 13),
			Rate = math.clamp(area / 400, 20, 120),
			Speed = NumberRange.new(5, 8),
			SpreadAngle = Vector2.new(15, 15),
			EmissionDirection = Enum.NormalId.Bottom,
		})
	elseif effect == "Bubbles" then
		emitter(part, {
			Texture = SPARK,
			Color = ColorSequence.new(Color3.fromRGB(200, 240, 255)),
			LightEmission = 0.4,
			Size = seq(0.4, 0.9),
			Transparency = seq(0.3, 0.9),
			Lifetime = NumberRange.new(4, 6),
			Rate = math.clamp(area / 1500, 10, 40),
			Speed = NumberRange.new(2, 4),
			EmissionDirection = Enum.NormalId.Top,
		})
	elseif effect == "Embers" then
		emitter(part, {
			Texture = SPARK,
			Color = ColorSequence.new(Color3.fromRGB(255, 180, 60), Color3.fromRGB(255, 80, 20)),
			LightEmission = 1,
			Size = seq(0.45, 0),
			Lifetime = NumberRange.new(1.5, 3),
			Rate = math.clamp(area / 60, 10, 40),
			Speed = NumberRange.new(3, 7),
			SpreadAngle = Vector2.new(20, 20),
			EmissionDirection = Enum.NormalId.Top,
		})
	elseif effect == "Mist" then
		emitter(part, {
			Texture = SMOKE,
			Color = ColorSequence.new(Color3.new(1, 1, 1)),
			Size = seq(6, 14),
			Transparency = seq(0.55, 1),
			Lifetime = NumberRange.new(2.5, 4),
			Rate = 8,
			Speed = NumberRange.new(1, 3),
			EmissionDirection = Enum.NormalId.Top,
		})
	elseif effect == "Fountain" then
		emitter(part, {
			Texture = SPARK,
			Color = ColorSequence.new(Color3.fromRGB(150, 215, 255)),
			LightEmission = 0.3,
			Size = seq(0.7, 0.4),
			Transparency = seq(0.1, 0.6),
			Lifetime = NumberRange.new(1.2, 1.6),
			Rate = 60,
			Speed = NumberRange.new(18, 22),
			SpreadAngle = Vector2.new(10, 10),
			Acceleration = Vector3.new(0, -45, 0),
			EmissionDirection = Enum.NormalId.Top,
		})
	elseif effect == "Sparkles" then
		emitter(part, {
			Texture = SPARK,
			Color = ColorSequence.new(tint),
			LightEmission = 1,
			Size = seq(0.5, 0),
			Lifetime = NumberRange.new(1.5, 2.5),
			Rate = math.clamp(area / 20, 6, 25),
			Speed = NumberRange.new(0.5, 2),
			SpreadAngle = Vector2.new(180, 180),
		})
	end
end

---------------------------------------------------------------------
-- Terreno
---------------------------------------------------------------------
local function block(center: Vector3, size: Vector3, material: Enum.Material)
	Terrain:FillBlock(CFrame.new(center), size, material)
end

local function ballAt(center: Vector3, radius: number, material: Enum.Material)
	Terrain:FillBall(center, radius, material)
end

-- Morros em volta de um retângulo (x0..x1, z0..z1): ficam do lado de fora, sem invadir a área de jogo
local function hillRing(x0: number, x1: number, z0: number, z1: number, rng: Random, materials: { Enum.Material }, rMin: number, rMax: number, step: number, skip: ((number, number) -> boolean)?)
	local tops = {}
	local function hill(cx: number, cz: number, r: number)
		if skip and skip(cx, cz) then
			return
		end
		local cy = -r * 0.4
		ballAt(Vector3.new(cx, cy, cz), r, materials[rng:NextInteger(1, #materials)])
		table.insert(tops, Vector3.new(cx, cy + r, cz))
	end
	local x = x0
	while x <= x1 do
		local r = rng:NextNumber(rMin, rMax)
		hill(x, z0 - r, r)
		r = rng:NextNumber(rMin, rMax)
		hill(x, z1 + r, r)
		x += step
	end
	local z = z0
	while z <= z1 do
		local r = rng:NextNumber(rMin, rMax)
		hill(x0 - r, z, r)
		r = rng:NextNumber(rMin, rMax)
		hill(x1 + r, z, r)
		z += step
	end
	return tops
end

local function makeTree(position: Vector3, scale: number, parent: Instance)
	local tree = Instance.new("Model")
	tree.Name = "HillTree"
	local function add(shape: Enum.PartType, size: Vector3, offset: Vector3, color: Color3, material: Enum.Material)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Shape = shape
		p.Size = size
		p.CFrame = CFrame.new(position + offset)
		p.Color = color
		p.Material = material
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = tree
	end
	add(Enum.PartType.Block, Vector3.new(2, 10, 2) * scale, Vector3.new(0, 4 * scale, 0), Color3.fromRGB(125, 85, 55), M.Wood)
	add(Enum.PartType.Ball, Vector3.one * 11 * scale, Vector3.new(0, 11 * scale, 0), Color3.fromRGB(80, 175, 75), M.Grass)
	add(Enum.PartType.Ball, Vector3.one * 7 * scale, Vector3.new(1, 15 * scale, 0), Color3.fromRGB(105, 195, 85), M.Grass)
	tree.Parent = parent
end

local function buildMeadow(rng: Random, decor: Instance)
	-- chão de grama em volta do mapa (fora da área de jogo, um pouco mais baixo)
	block(Vector3.new(0, -4.5, -360), Vector3.new(1400, 8, 300), M.Grass)
	block(Vector3.new(0, -4.5, 360), Vector3.new(1400, 8, 300), M.Grass)
	block(Vector3.new(-500, -4.5, 0), Vector3.new(400, 8, 420), M.Grass)
	block(Vector3.new(500, -4.5, 0), Vector3.new(400, 8, 420), M.Grass)
	-- penhasco com cachoeira e lago (atrás das bases de cima, à esquerda)
	block(Vector3.new(-200, 20, -296), Vector3.new(80, 52, 48), M.Rock)
	ballAt(Vector3.new(-250, 10, -300), 30, M.Rock)
	ballAt(Vector3.new(-150, 8, -300), 28, M.Rock)
	block(Vector3.new(-200, -3.5, -246), Vector3.new(80, 7, 40), M.Water)
	-- morros de grama em volta de tudo
	local tops = hillRing(-300, 300, -210, 210, rng, { M.Grass, M.Grass, M.LeafyGrass }, 45, 80, 70, function(x, z)
		return z < -210 and ((x > -280 and x < -120) or (x > 190 and x < 290))
	end)
	for i, top in tops do
		if i % 2 == 0 then
			makeTree(top, rng:NextNumber(1, 1.5), decor)
		end
	end
end

local function buildWorldTerrain(worldId: string, X0: number, rng: Random)
	-- v27: o chão de terreno ficava 0,5 acima do piso e escondia a esteira, os caminhos e os rios dos mundos.
	-- Agora o topo fica em -2,5 (embaixo do chão da ilha, que vai de -2 a 0).
	local minX, maxX = X0 - 160, X0 + 160
	if worldId == "candy" then
		block(Vector3.new(X0, -6.5, 0), Vector3.new(820, 8, 680), M.Salt)
		hillRing(minX, maxX, -90, 90, rng, { M.Salt, M.Limestone, M.Mud }, 28, 55, 55)
	elseif worldId == "frost" then
		block(Vector3.new(X0, -6.5, 0), Vector3.new(820, 8, 680), M.Snow)
		-- montanhas nevadas atrás (norte), com topo de gelo
		for _, spec in { { -120, 85 }, { 10, 100 }, { 135, 80 } } do
			local cx, r = X0 + spec[1], spec[2]
			local center = Vector3.new(cx, -r * 0.25, -90 - r)
			ballAt(center, r, M.Snow)
			ballAt(center + Vector3.new(0, r * 0.62, 0), r * 0.42, M.Glacier)
		end
		hillRing(minX, maxX, -90, 90, rng, { M.Snow, M.Snow, M.Ice }, 22, 42, 60, function(_, z)
			return z < -90
		end)
	elseif worldId == "lava" then
		block(Vector3.new(X0, -6.5, 0), Vector3.new(820, 8, 680), M.Basalt)
		-- vulcão gigante (norte)
		local vz = -190
		for level = 0, 8 do
			local radius = 95 - level * 8.75
			Terrain:FillCylinder(CFrame.new(X0, 4 + level * 8, vz), 8, radius, if level >= 7 then M.CrackedLava else M.Basalt)
		end
		Terrain:FillCylinder(CFrame.new(X0, 71, vz), 6, 13, M.Air)
		hillRing(minX, maxX, -90, 90, rng, { M.Basalt, M.CrackedLava, M.Basalt }, 20, 38, 60, function(_, z)
			return z < -90
		end)
	elseif worldId == "reef" then
		-- mar em volta da ilha
		block(Vector3.new(X0, -16, 0), Vector3.new(900, 8, 700), M.Sand)
		block(Vector3.new(X0, -7, 0), Vector3.new(900, 10, 700), M.Water)
		for i = 1, 8 do
			local angle = i / 8 * math.pi * 2
			ballAt(Vector3.new(X0 + math.cos(angle) * 300, -12, math.sin(angle) * 220), rng:NextNumber(25, 40), M.Sand)
		end
	elseif worldId == "galaxy" then
		-- asteroides flutuando no espaço
		for _ = 1, 16 do
			local side = if rng:NextNumber() < 0.5 then -1 else 1
			local center = Vector3.new(X0 + rng:NextNumber(-260, 260), rng:NextNumber(-30, 60), side * rng:NextNumber(120, 220))
			ballAt(center, rng:NextNumber(8, 22), M.Asphalt)
		end
	end
end

local function buildTerrain()
	pcall(function()
		(Terrain :: any).Decoration = true
	end)
	Terrain.WaterColor = Color3.fromRGB(45, 175, 210)
	Terrain.WaterTransparency = 0.45
	Terrain.WaterReflectance = 0.6
	Terrain.WaterWaveSize = 0.12
	Terrain.WaterWaveSpeed = 8
	Terrain:SetMaterialColor(M.Grass, Color3.fromRGB(110, 196, 80))
	Terrain:SetMaterialColor(M.LeafyGrass, Color3.fromRGB(95, 175, 70))
	Terrain:SetMaterialColor(M.Salt, Color3.fromRGB(255, 180, 215))
	Terrain:SetMaterialColor(M.Limestone, Color3.fromRGB(170, 240, 210))
	Terrain:SetMaterialColor(M.Mud, Color3.fromRGB(115, 68, 40))
	Terrain:SetMaterialColor(M.Asphalt, Color3.fromRGB(80, 65, 110))
	Terrain:SetMaterialColor(M.Sand, Color3.fromRGB(240, 222, 170))

	local clouds = Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.6
	clouds.Color = Color3.new(1, 1, 1)
	clouds.Parent = Terrain

	local decor = Instance.new("Folder")
	decor.Name = "SceneryDecor"
	decor.Parent = workspace:WaitForChild("Map")
	local rng = Random.new(2026)
	buildMeadow(rng, decor)
	for index, world in Config.Worlds do
		if world.Id ~= "meadow" then
			buildWorldTerrain(world.Id, 1000 * (index - 1), rng)
			task.wait() -- não trava o servidor enquanto cria o terreno
		end
	end
end

---------------------------------------------------------------------
-- v23: ENFEITES 3D (modelos do Higgsfield): a peça invisível com Tag "Prop3D" vira o modelo
--   Atributos: Model (id em Models3DJobs), Size (lado maior, studs), Turn (graus), Collide,
--   SpinSpeed / BobHeight (a tela anima). Sem o modelo importado: não aparece nada (e avisa no Output).
---------------------------------------------------------------------
local Models3D = require(ReplicatedStorage.Shared.Models3D)
local propsFolder: Folder? = nil
local missingProps: { [string]: boolean } = {}

local function setupProp(marker: Instance)
	if not marker:IsA("BasePart") or marker:GetAttribute("PropDone") then
		return
	end
	marker:SetAttribute("PropDone", true)
	local id = marker:GetAttribute("Model")
	if typeof(id) ~= "string" then
		return
	end
	local size = tonumber(marker:GetAttribute("Size")) or 10
	local model = Models3D.Get(id, { Size = size, Fit = "Max", Anchored = true })
	if not model then
		if not missingProps[id] then
			missingProps[id] = true
			print(("[Scenery] enfeite 3D '%s' ainda não importado (File > Import 3D, jogue em ReplicatedStorage > Models3D)"):format(id))
		end
		return
	end
	local turn = tonumber(marker:GetAttribute("Turn")) or 0
	local collide = marker:GetAttribute("Collide") ~= false
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = collide
			d.CanQuery = collide
			d.CanTouch = false
		end
	end
	model.Name = "Prop_" .. id
	model:PivotTo(marker.CFrame * CFrame.Angles(0, math.rad(turn), 0))
	local spin = tonumber(marker:GetAttribute("SpinSpeed"))
	local bob = tonumber(marker:GetAttribute("BobHeight"))
	if spin or bob then
		model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		if spin then
			model:SetAttribute("SpinSpeed", spin)
			model:AddTag("Spin")
		end
		if bob then
			model:SetAttribute("BobHeight", bob)
			model:AddTag("Bob")
		end
	end
	if not propsFolder or not propsFolder.Parent then
		propsFolder = Instance.new("Folder")
		propsFolder.Name = "Props3D"
		propsFolder.Parent = workspace:WaitForChild("Map")
	end
	model.Parent = propsFolder
end

function Scenery.Init()
	for _, part in CollectionService:GetTagged("Prop3D") do
		task.spawn(setupProp, part)
	end
	CollectionService:GetInstanceAddedSignal("Prop3D"):Connect(setupProp)
	for _, part in CollectionService:GetTagged("Sign") do
		setupSign(part)
	end
	CollectionService:GetInstanceAddedSignal("Sign"):Connect(setupSign)
	for _, part in CollectionService:GetTagged("FX") do
		setupFx(part)
	end
	CollectionService:GetInstanceAddedSignal("FX"):Connect(setupFx)
	task.spawn(function()
		local ok, err = pcall(buildTerrain)
		if not ok then
			warn("[Scenery] terreno:", err)
		end
	end)
end

return Scenery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="466">
        <Properties>
          <string name="Name">Season</string>
          <string name="Source"><![CDATA[--[[
	Season (ModuleScript em ServerScriptService > Game)
	Parte 16: passe da temporada no servidor.
	  • XP por ação (Seasons.XP) e por minuto jogado
	  • ao subir de nível, a recompensa é entregue NA HORA (não tem "resgatar" e nada se perde)
	  • Season Pass = Dev Product (Config.DevProducts.SeasonPass): vale só para a temporada em que foi comprado
	    e entrega na hora todas as recompensas pagas dos níveis que o jogador já passou
	  • quem não tem o passe ganha as recompensas pagas nos níveis bônus 31-60
	  • placar da temporada (OrderedDataStore "SeasonXP_<número>"), atualizado a cada 60 s
	Os números e prêmios ficam em ReplicatedStorage > Shared > Seasons.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Seasons = require(ReplicatedStorage.Shared.Seasons)
local Registry = require(script.Parent.Registry)

local Season = {}

local topList: { { Name: string, XP: number } } = {}
local pairLast: { [Player]: { [string]: number } } = {}
local lastSaved: { [Player]: number } = {}
local nameCache: { [number]: string } = {}

local function getData(player: Player): any
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

local function current()
	return Seasons.Current(os.time())
end

local function freshSeason(id: number)
	return { Id = id, XP = 0, Granted = 0, PaidGranted = 0, BonusGranted = 0, DailyDay = 0 }
end

function Season.HasPass(player: Player): boolean
	local data = getData(player)
	local id = current()
	return data ~= nil and type(data.SeasonPasses) == "table" and data.SeasonPasses[tostring(id)] == true
end

local function publish(player: Player)
	local data = getData(player)
	if not data then
		return
	end
	local level = Seasons.LevelFromXP(data.Season.XP)
	player:SetAttribute("SeasonId", data.Season.Id)
	player:SetAttribute("SeasonXP", data.Season.XP)
	player:SetAttribute("SeasonLevel", level)
	player:SetAttribute("SeasonPass", Season.HasPass(player))
end

-- Garante que os dados são da temporada atual (a temporada virou: começa do zero)
local function ensureSeason(player: Player): any
	local data = getData(player)
	if not data then
		return nil
	end
	local id = current()
	if type(data.Season) ~= "table" or data.Season.Id ~= id then
		data.Season = freshSeason(id)
	end
	for _, key in { "XP", "Granted", "PaidGranted", "BonusGranted" } do
		data.Season[key] = math.max(0, math.floor(tonumber(data.Season[key]) or 0))
	end
	if type(data.SeasonPasses) ~= "table" then
		data.SeasonPasses = {}
	end
	return data
end

-- Entrega com segurança: se algo der erro, o nível NÃO é marcado como entregue (tenta de novo depois)
local function give(player: Player, reward, label: string): boolean
	local ok, parts = pcall(Registry.Codes.Grant, player, reward)
	if not ok then
		warn("[Season] falha ao entregar", label, parts)
		return false
	end
	Registry.Remotes.Notify(player, label .. ": " .. table.concat(parts, " + "), "rare")
	return true
end

-- Entrega tudo o que o jogador já conquistou e ainda não recebeu
local function grantUpTo(player: Player)
	local data = ensureSeason(player)
	if not data then
		return
	end
	local season = data.Season
	local _, theme = current()
	local level = Seasons.LevelFromXP(season.XP)
	local main = math.min(level, Seasons.Levels)
	local gave = false
	while season.Granted < main do
		if not give(player, Seasons.Reward(theme, season.Granted + 1, "Free"), "Season level " .. (season.Granted + 1)) then
			return
		end
		season.Granted += 1
		gave = true
	end
	local bonus = math.max(0, level - Seasons.Levels)
	if Season.HasPass(player) then
		while season.PaidGranted < main do
			-- comprado com Robux: onde itens aleatórios pagos são proibidos, ovo vira dinheiro fixo (Policy)
			local reward = Registry.Policy.SafePaidReward(player, Seasons.Reward(theme, season.PaidGranted + 1, "Paid"))
			if not give(player, reward, "Pass reward " .. (season.PaidGranted + 1)) then
				return
			end
			season.PaidGranted += 1
			gave = true
		end
		-- com o passe, cada nível bônus dá 10 minutos de dinheiro
		while season.BonusGranted < bonus do
			if not give(player, { Minutes = 10 }, "Bonus level " .. (Seasons.Levels + season.BonusGranted + 1)) then
				return
			end
			season.BonusGranted += 1
			gave = true
		end
	else
		-- sem o passe: cada nível bônus libera uma recompensa paga (na ordem), de graça
		while season.BonusGranted < bonus and season.PaidGranted < Seasons.Levels do
			if not give(player, Seasons.Reward(theme, season.PaidGranted + 1, "Paid"), "FREE pass reward " .. (season.PaidGranted + 1)) then
				return
			end
			season.BonusGranted += 1
			season.PaidGranted += 1
			gave = true
		end
	end
	if gave then
		Registry.Remotes.Effect(player, "SeasonLevel", level)
	end
end

-- other = o outro jogador da ação (roubo/defesa): a mesma dupla só dá XP de 5 em 5 minutos
function Season.AddXP(player: Player, amount: number, reason: string?, other: Player?)
	local data = ensureSeason(player)
	if not data or not player:GetAttribute("Loaded") or amount <= 0 then
		return
	end
	if other and reason then
		local list = pairLast[player] or {}
		pairLast[player] = list
		local key = reason .. ":" .. other.UserId
		if os.clock() - (list[key] or -math.huge) < Seasons.PairCooldown then
			return
		end
		list[key] = os.clock()
	end
	if reason and Seasons.ActionXP[reason] then
		local today = math.floor(os.time() / 86400)
		if data.Season.ActionDay ~= today then
			data.Season.ActionDay = today
			data.Season.ActionXP = 0
		end
		local room = Seasons.DailyActionCap - (tonumber(data.Season.ActionXP) or 0)
		if room <= 0 then
			return
		end
		amount = math.min(amount, room)
		data.Season.ActionXP = (tonumber(data.Season.ActionXP) or 0) + amount
	end
	local progress = Registry.Progress
	if progress then
		progress.AddXP(player, amount) -- nível da conta (mesmo XP, mesmo limite diário)
	end
	local before = Seasons.LevelFromXP(data.Season.XP)
	data.Season.XP += math.floor(amount)
	local after = Seasons.LevelFromXP(data.Season.XP)
	if after > before then
		grantUpTo(player)
	end
	publish(player)
end

-- Dev Product "Season Pass" (Products chama isto; true = entregue)
function Season.GrantPass(player: Player): boolean
	local data = ensureSeason(player)
	if not data then
		return false
	end
	local id = current()
	local alreadyHad = data.SeasonPasses[tostring(id)] == true
	local before = data.Season.PaidGranted
	data.SeasonPasses[tostring(id)] = true
	-- o que ele já ganhou de graça nos níveis bônus não é entregue de novo
	grantUpTo(player)
	if alreadyHad or data.Season.PaidGranted == before and before >= Seasons.Levels then
		-- não tinha mais nada para entregar: nunca deixa a compra sem recompensa
		give(player, { Minutes = 60 }, "Thank you")
	end
	publish(player)
	Registry.Remotes.Notify(player, "SEASON PASS unlocked! Thank you!", "rare")
	Registry.Remotes.Effect(player, "SeasonLevel", Seasons.LevelFromXP(data.Season.XP))
	return true
end

function Season.Sync(player: Player)
	local data = ensureSeason(player)
	if not data then
		return
	end
	local id, theme, startsAt, endsAt = current()
	Registry.Remotes.SeasonEvent:FireClient(player, {
		Id = id,
		Theme = theme.Id,
		StartsAt = startsAt,
		EndsAt = endsAt,
		XP = data.Season.XP,
		Granted = data.Season.Granted,
		PaidGranted = data.Season.PaidGranted,
		BonusGranted = data.Season.BonusGranted,
		Pass = Season.HasPass(player),
		Top = topList,
	})
end

function Season.SetupPlayer(player: Player)
	local data = ensureSeason(player)
	if not data then
		return
	end
	-- XP da visita diária (1 vez por dia)
	local today = math.floor(os.time() / 86400)
	if data.Season.DailyDay ~= today then
		data.Season.DailyDay = today
		data.Season.XP += Seasons.XP.Daily
	end
	grantUpTo(player)
	publish(player)
end

function Season.RemovePlayer(player: Player)
	lastSaved[player] = nil
	pairLast[player] = nil
end

local function nameOf(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = if ok and type(name) == "string" then name else "Player"
	return nameCache[userId]
end

-- Placar: grava o XP de quem está online e lê o top 10 (1 vez por minuto, dentro do limite do Roblox)
local function refreshBoard()
	local id = current()
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore("SeasonXP_" .. id)
	end)
	if not ok or not store then
		return
	end
	for _, player in Players:GetPlayers() do
		local data = getData(player)
		if data and data.Season and data.Season.Id == id and player:GetAttribute("Loaded") and lastSaved[player] ~= data.Season.XP and data.Season.XP > 0 then
			local xp = data.Season.XP
			local saved = pcall(function()
				store:SetAsync(tostring(player.UserId), xp)
			end)
			if saved then
				lastSaved[player] = xp
			end
		end
	end
	local okPage, pages = pcall(function()
		return store:GetSortedAsync(false, 10)
	end)
	if okPage and pages then
		local list = {}
		for _, entry in pages:GetCurrentPage() do
			local userId = tonumber(entry.key)
			if userId then
				table.insert(list, { Name = nameOf(userId), XP = entry.value })
			end
		end
		topList = list
	end
end

function Season.Init()
	Players.PlayerRemoving:Connect(Season.RemovePlayer)
	task.spawn(function()
		local lastId = current()
		while true do
			task.wait(60)
			local id = current()
			local changed = id ~= lastId
			lastId = id
			-- cada jogador no seu próprio pcall: um erro não trava os outros nem repete o aviso
			for _, player in Players:GetPlayers() do
				local ok, err = pcall(function()
					if player:GetAttribute("Loaded") then
						if changed then
							Registry.Remotes.Notify(player, "A NEW SEASON STARTED! New rewards in the PASS menu!", "rare")
						end
						Season.AddXP(player, Seasons.XP.Minute, "Minute")
						publish(player)
					end
				end)
				if not ok then
					warn("[Season] loop error:", err)
				end
			end
			task.spawn(refreshBoard)
		end
	end)
	task.defer(refreshBoard)
end

return Season
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="467">
        <Properties>
          <string name="Name">Social</string>
          <string name="Source"><![CDATA[--[[
	Social (ModuleScript em ServerScriptService > Game)
	Parte 24 (v11): jogar junto.
	  • LIKE: 1 curtida por base por dia (placa MOST LIKED no mapa)
	  • VISIT: vai até a entrada da base de outro jogador (nunca para dentro dela)
	  • PRESENTE: dá um bichinho da mochila para outro jogador; quem recebe precisa ACEITAR
	  • CLÃ: até 10 amigos; nome filtrado pelo Roblox (TextService); +2% de dinheiro por colega no servidor (máx. +10%)
	  • CONVITE: amigo NOVO que entra pelo seu convite = ovo grátis para você (até 5 por dia)
	O servidor confere tudo; a tela só pede (ações no Economy: Like, Visit, Gift, GiftAnswer, Clan*).
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local UserService = game:GetService("UserService")

local Config = require(ReplicatedStorage.Shared.Config)
local Critters = require(ReplicatedStorage.Shared.Critters)
local Registry = require(script.Parent.Registry)

local Social = {}

type Offer = { From: Player, Key: string, Id: string, Expires: number, OfferId: number }
type ClanInvite = { From: Player, ClanId: string, Name: string, Expires: number }

local giftOffers: { [Player]: Offer } = {}
local clanInvites: { [Player]: ClanInvite } = {}
local lastVisit: { [Player]: number } = {}
local busy: { [Player]: boolean } = {} -- pedido de clã em andamento (DataStore demora)
local clanCache: { [string]: any } = {}
local nameCache: { [number]: string } = {} -- nomes dos membros de clã fora do servidor (só na memória)
local nextOfferId = 0
local lastAsk: { [Player]: { [number]: number } } = {} -- anti-spam: quem pediu para quem (presente/clã)

-- 1 pedido (presente ou convite de clã) para a mesma pessoa a cada 30 s
local function canAsk(player: Player, target: Player): boolean
	local list = lastAsk[player] or {}
	lastAsk[player] = list
	if os.clock() - (list[target.UserId] or -math.huge) < 30 then
		Registry.Remotes.Notify(player, "Wait a little before asking " .. target.DisplayName .. " again.", "info")
		return false
	end
	list[target.UserId] = os.clock()
	return true
end

local clanStore: DataStore? = nil
local inviteStore: DataStore? = nil

local function today(): number
	return math.floor(os.time() / 86400)
end

local function getData(player: Player): any
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

local function ensure(data: any)
	data.Likes = math.max(0, math.floor(tonumber(data.Likes) or 0))
	if type(data.LikedToday) ~= "table" or data.LikedToday.Day ~= today() then
		data.LikedToday = { Day = today(), Owners = {} }
	end
	if type(data.GiftsToday) ~= "table" or data.GiftsToday.Day ~= today() then
		data.GiftsToday = { Day = today(), Count = 0 }
	end
	if type(data.Clan) ~= "string" then
		data.Clan = ""
	end
	if type(data.InviteRewards) ~= "table" or data.InviteRewards.Day ~= today() then
		data.InviteRewards = { Day = today(), Count = 0 }
	end
end

local function playerById(userId: number): Player?
	local found = Players:GetPlayerByUserId(userId)
	if found and found:GetAttribute("Loaded") then
		return found
	end
	return nil
end

---------------------------------------------------------------------
-- Tela
---------------------------------------------------------------------
function Social.Sync(player: Player)
	local data = getData(player)
	if not data or not player.Parent then
		return
	end
	ensure(data)
	local clan = if data.Clan ~= "" then clanCache[data.Clan] else nil
	local members = {}
	if clan then
		for id in clan.Members or {} do
			local userId = tonumber(id) or 0
			local online = Players:GetPlayerByUserId(userId)
			table.insert(members, { Id = userId, Name = if online then online.DisplayName else (nameCache[userId] or "Player"), Online = online ~= nil })
		end
		table.sort(members, function(a, b)
			return a.Name < b.Name
		end)
	end
	local liked = {}
	for id in data.LikedToday.Owners do
		table.insert(liked, tonumber(id))
	end
	Registry.Remotes.SocialEvent:FireClient(player, {
		Likes = data.Likes,
		LikedToday = liked,
		GiftsLeft = math.max(0, Config.GiftsPerDay - data.GiftsToday.Count),
		Clan = if clan
			then { Id = data.Clan, Name = clan.Name, Owner = clan.Owner, Members = members, Bonus = Social.ClanBonus(player) }
			else nil,
	})
end

-- Nomes dos membros (não salvamos nomes: perguntamos ao Roblox e guardamos só na memória)
local function fetchNames(clan: any)
	if type(clan) ~= "table" or type(clan.Members) ~= "table" then
		return
	end
	local missing = {}
	for id in clan.Members do
		local userId = tonumber(id)
		if userId and not nameCache[userId] and not Players:GetPlayerByUserId(userId) then
			table.insert(missing, userId)
		end
	end
	if #missing == 0 then
		return
	end
	pcall(function()
		for _, info in UserService:GetUserInfosByUserIdsAsync(missing) do
			nameCache[info.Id] = info.DisplayName
		end
	end)
end

local function syncAll()
	for _, other in Players:GetPlayers() do
		if other:GetAttribute("Loaded") then
			Social.Sync(other)
		end
	end
end

---------------------------------------------------------------------
-- LIKE (1 por base por dia)
---------------------------------------------------------------------
function Social.Like(player: Player, ownerId: any)
	local data = getData(player)
	if not data or typeof(ownerId) ~= "number" or ownerId == player.UserId then
		return
	end
	local owner = playerById(ownerId)
	local ownerData = owner and getData(owner)
	if not owner or not ownerData then
		return
	end
	ensure(data)
	ensure(ownerData)
	local key = tostring(ownerId)
	if data.LikedToday.Owners[key] then
		Registry.Remotes.Notify(player, "You already liked this base today. Come back tomorrow!", "info")
		return
	end
	data.LikedToday.Owners[key] = true
	ownerData.Likes += 1
	owner:SetAttribute("Likes", ownerData.Likes)
	Registry.Remotes.Notify(player, ("You liked %s's base! \u{2764}"):format(owner.DisplayName), "success")
	Registry.Remotes.Notify(owner, ("%s liked your base! \u{2764} (%d likes)"):format(player.DisplayName, ownerData.Likes), "rare")
	Registry.Remotes.Effect(owner, "Liked")
	Registry.Remotes.Effect(player, "Liked")
	Social.Sync(player)
end

---------------------------------------------------------------------
-- VISIT (até a entrada da base do outro)
---------------------------------------------------------------------
function Social.Visit(player: Player, ownerId: any)
	if typeof(ownerId) ~= "number" or ownerId == player.UserId then
		return
	end
	local owner = playerById(ownerId)
	local plot = owner and Registry.Plots.Get(owner)
	local character = player.Character
	if not plot or not character or not character:FindFirstChild("HumanoidRootPart") then
		return
	end
	if Registry.CritterService.IsCarrying(player) then
		Registry.Remotes.Notify(player, "You can't visit while carrying something!", "warning")
		return
	end
	if player:GetAttribute("InMinigame") then
		Registry.Remotes.Notify(player, "Finish your minigame first!", "info")
		return
	end
	local here = player:GetAttribute("World")
	if here ~= nil and here ~= "meadow" then
		Registry.Remotes.Notify(player, "Go back to Meadow Valley first (HOME button)!", "info")
		return
	end
	if os.clock() - (lastVisit[player] or 0) < 8 then
		Registry.Remotes.Notify(player, "Wait a moment before visiting again.", "info")
		return
	end
	lastVisit[player] = os.clock()
	-- na frente da entrada (do lado de fora), olhando para a base
	local origin = plot.Origin.CFrame
	local halfZ = plot.Origin.Size.Z / 2
	local spot = (origin * CFrame.new(math.random(-4, 4), 0, -(halfZ + 8))).Position + Vector3.new(0, 4, 0)
	character:PivotTo(CFrame.lookAt(spot, Vector3.new(origin.Position.X, spot.Y, origin.Position.Z)))
	Registry.Remotes.Notify(player, ("Welcome to %s's base! Like it with the \u{2764} button on their sign."):format(owner.DisplayName), "info")
end

---------------------------------------------------------------------
-- PRESENTES (quem recebe precisa aceitar)
---------------------------------------------------------------------
function Social.GiftOffer(player: Player, request: any)
	local data = getData(player)
	if not data or type(request) ~= "table" or typeof(request.To) ~= "number" or typeof(request.Key) ~= "string" then
		return
	end
	ensure(data)
	local target = playerById(request.To)
	if not target or target == player then
		return
	end
	-- regras do país (PolicyService): onde trocar itens pagos é proibido, presentes ficam desligados
	if not Registry.Policy.CanTrade(player) then
		Registry.Remotes.Notify(player, "Gifts are not available where you live.", "info")
		return
	end
	if not Registry.Policy.CanTrade(target) then
		Registry.Remotes.Notify(player, target.DisplayName .. " can't receive gifts.", "info")
		return
	end
	if data.GiftsToday.Count >= Config.GiftsPerDay then
		Registry.Remotes.Notify(player, ("You can give %d gifts per day. Come back tomorrow!"):format(Config.GiftsPerDay), "info")
		return
	end
	local entry = Registry.Pets.Find(player, request.Key)
	if not entry then
		return
	end
	if (giftOffers[target] and giftOffers[target].Expires > os.clock()) or (clanInvites[target] and clanInvites[target].Expires > os.clock()) then
		Registry.Remotes.Notify(player, target.DisplayName .. " is answering another request. Try again in a moment!", "info")
		return
	end
	if not canAsk(player, target) then
		return
	end
	local def = Critters.ById[entry.Id]
	nextOfferId += 1
	giftOffers[target] = { From = player, Key = request.Key, Id = entry.Id, Expires = os.clock() + 30, OfferId = nextOfferId }
	Registry.Remotes.Effect(target, "GiftOffer", {
		OfferId = nextOfferId,
		From = player.DisplayName,
		Name = (if entry.S then "Shiny " else "") .. (if entry.M then entry.M .. " " else "") .. def.Name,
		Critter = entry.Id,
	})
	Registry.Remotes.Notify(player, ("Gift sent to %s. Waiting for them to accept..."):format(target.DisplayName), "info")
end

function Social.GiftAnswer(target: Player, answer: any)
	local offer = giftOffers[target]
	-- a resposta tem que ser para ESTA oferta (uma janela velha não recusa um presente novo)
	if not offer or type(answer) ~= "table" or answer.OfferId ~= offer.OfferId then
		return
	end
	giftOffers[target] = nil
	local accept = answer.Accept
	local sender = offer.From
	if accept ~= true then
		if sender.Parent then
			Registry.Remotes.Notify(sender, target.DisplayName .. " said no thanks to your gift. You kept it!", "info")
		end
		return
	end
	if not Registry.Policy.CanTrade(sender) or not Registry.Policy.CanTrade(target) then
		return
	end
	local senderData = getData(sender)
	if offer.Expires < os.clock() or not sender.Parent or not senderData then
		Registry.Remotes.Notify(target, "That gift expired.", "info")
		return
	end
	ensure(senderData)
	if senderData.GiftsToday.Count >= Config.GiftsPerDay then
		return
	end
	-- confere de novo (o bichinho pode ter sido vendido/usado nesses segundos) e troca de dono na mesma hora
	local entry = Registry.Pets.Find(sender, offer.Key)
	if not entry or entry.Id ~= offer.Id then
		Registry.Remotes.Notify(target, "That gift is not available anymore.", "info")
		return
	end
	if not Registry.Pets.HasRoom(target) then
		Registry.Remotes.Notify(target, "Your backpack is full! Make space and ask for the gift again.", "warning")
		Registry.Remotes.Notify(sender, target.DisplayName .. "'s backpack is full. You kept your critter.", "info")
		return
	end
	local taken = Registry.Pets.Take(sender, offer.Key)
	if not taken then
		return
	end
	Registry.Pets.Add(target, taken.Id, taken.M, taken.B, taken.S)
	senderData.GiftsToday.Count += 1
	local def = Critters.ById[taken.Id]
	Registry.Remotes.Notify(target, ("%s gave you %s! It's in your backpack."):format(sender.DisplayName, def.Name), "rare")
	Registry.Remotes.Notify(sender, ("You gave %s to %s. So kind!"):format(def.Name, target.DisplayName), "success")
	Registry.Remotes.Effect(target, "Stolen", def.Rarity)
	Registry.Analytics.Event(sender, "GiftGiven")
	Social.Sync(sender)
end

---------------------------------------------------------------------
-- CLÃS (DataStore "Clans_v1": um registro por clã)
---------------------------------------------------------------------
local function applyClan(player: Player, clanId: string, clan: any?)
	local data = getData(player)
	if not data then
		return
	end
	data.Clan = if clan then clanId else ""
	player:SetAttribute("ClanId", if clan then clanId else nil)
	player:SetAttribute("ClanName", if clan then clan.Name else nil)
	if clan then
		clanCache[clanId] = clan
	end
	local customize = Registry.Customize
	if customize then
		customize.RefreshTag(player)
	end
end

-- Bônus: +2% por colega de clã no mesmo servidor (máx. +10%)
function Social.ClanBonus(player: Player): number
	local clanId = player:GetAttribute("ClanId")
	if typeof(clanId) ~= "string" then
		return 0
	end
	local mates = 0
	for _, other in Players:GetPlayers() do
		if other ~= player and other:GetAttribute("ClanId") == clanId then
			mates += 1
		end
	end
	return math.min(Config.ClanBonusMax, mates * Config.ClanBonusPerMate)
end

local function refreshClanmates(clanId: string?)
	for _, other in Players:GetPlayers() do
		if other:GetAttribute("Loaded") and (clanId == nil or other:GetAttribute("ClanId") == clanId) then
			Registry.Economy.Sync(other)
			Social.Sync(other)
		end
	end
end

local function filterName(player: Player, raw: string): string?
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(raw, player.UserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if not ok or type(result) ~= "string" or string.find(result, "#", 1, true) then
		return nil
	end
	return result
end

-- Criar/sair de clã: um pouco de espera entre as ações e no máximo 3 clãs novos por dia
-- (evita encher o DataStore de clãs vazios)
local CLAN_ACTION_COOLDOWN = 20
local CLAN_CREATES_PER_DAY = 3

local function clanActionReady(player: Player, data: any): boolean
	local wait = (tonumber(data.ClanActionAt) or 0) + CLAN_ACTION_COOLDOWN - os.time()
	if wait > 0 then
		Registry.Remotes.Notify(player, ("Wait %d seconds and try again."):format(math.ceil(wait)), "info")
		return false
	end
	return true
end

function Social.ClanCreate(player: Player, rawName: any)
	if typeof(rawName) ~= "string" or #rawName > 40 then
		return
	end
	local data = getData(player)
	if not data or busy[player] then
		return
	end
	ensure(data)
	if data.Clan ~= "" then
		Registry.Remotes.Notify(player, "Leave your clan first to make a new one.", "info")
		return
	end
	if not clanActionReady(player, data) then
		return
	end
	local today = math.floor(os.time() / 86400)
	if data.ClanCreateDay ~= today then
		data.ClanCreateDay = today
		data.ClanCreates = 0
	end
	if (tonumber(data.ClanCreates) or 0) >= CLAN_CREATES_PER_DAY then
		Registry.Remotes.Notify(player, ("You can make up to %d clans per day. Try again tomorrow!"):format(CLAN_CREATES_PER_DAY), "info")
		return
	end
	local name = string.gsub(string.gsub(rawName, "[^%w ]", ""), "^%s*(.-)%s*$", "%1")
	if #name < 3 or #name > 20 then
		Registry.Remotes.Notify(player, "Clan names need 3 to 20 letters or numbers.", "warning")
		return
	end
	busy[player] = true
	local clean = filterName(player, name)
	if not clean then
		busy[player] = nil
		Registry.Remotes.Notify(player, "That name isn't allowed. Try another one!", "warning")
		return
	end
	local clanId = HttpService:GenerateGUID(false)
	local clan = {
		Name = clean,
		Owner = player.UserId,
		Members = { [tostring(player.UserId)] = true },
		Created = os.time(),
	}
	local ok = true
	if clanStore then
		ok = pcall(function()
			(clanStore :: DataStore):SetAsync(clanId, clan)
		end)
	end
	busy[player] = nil
	if not ok then
		Registry.Remotes.Notify(player, "Couldn't create the clan right now. Try again soon!", "error")
		return
	end
	clanCache[clanId] = clan
	data.ClanActionAt = os.time()
	data.ClanCreates = (tonumber(data.ClanCreates) or 0) + 1
	if player.Parent then
		applyClan(player, clanId, clan)
		Registry.Remotes.Notify(player, ("Clan \"%s\" created! Invite friends in the FRIENDS menu."):format(clean), "rare")
		refreshClanmates(clanId)
	end
end

function Social.ClanInvite(player: Player, targetId: any)
	local data = getData(player)
	if not data or typeof(targetId) ~= "number" then
		return
	end
	ensure(data)
	local clan = clanCache[data.Clan]
	local target = playerById(targetId)
	local targetData = target and getData(target)
	if not clan or not target or not targetData or target == player then
		return
	end
	ensure(targetData)
	if targetData.Clan ~= "" then
		Registry.Remotes.Notify(player, target.DisplayName .. " is already in a clan.", "info")
		return
	end
	if (clanInvites[target] and clanInvites[target].Expires > os.clock()) or (giftOffers[target] and giftOffers[target].Expires > os.clock()) then
		Registry.Remotes.Notify(player, target.DisplayName .. " is answering another request. Try again in a moment!", "info")
		return
	end
	if not canAsk(player, target) then
		return
	end
	clanInvites[target] = { From = player, ClanId = data.Clan, Name = clan.Name, Expires = os.clock() + 30 }
	Registry.Remotes.Effect(target, "ClanInvite", { From = player.DisplayName, Name = clan.Name })
	Registry.Remotes.Notify(player, "Clan invite sent to " .. target.DisplayName .. "!", "info")
end

function Social.ClanAnswer(target: Player, accept: any)
	local invite = clanInvites[target]
	clanInvites[target] = nil
	local data = getData(target)
	if not invite or not data or busy[target] then
		return
	end
	ensure(data)
	if accept ~= true or invite.Expires < os.clock() or data.Clan ~= "" then
		return
	end
	busy[target] = true
	local joined = nil
	local full = false
	if clanStore then
		pcall(function()
			(clanStore :: DataStore):UpdateAsync(invite.ClanId, function(clan)
				if type(clan) ~= "table" or type(clan.Members) ~= "table" or clan.Closed then
					return nil
				end
				local count = 0
				for _ in clan.Members do
					count += 1
				end
				if count >= Config.ClanMax then
					full = true
					return nil
				end
				clan.Members[tostring(target.UserId)] = true
				clan.Names = nil -- nomes não ficam salvos (só os UserIds)
				joined = clan
				return clan
			end)
		end)
	else
		-- sem DataStore (Studio sem API): só neste servidor
		local clan = clanCache[invite.ClanId]
		if clan and not clan.Closed then
			local count = 0
			for _ in clan.Members do
				count += 1
			end
			if count < Config.ClanMax then
				clan.Members[tostring(target.UserId)] = true
				joined = clan
			else
				full = true
			end
		end
	end
	busy[target] = nil
	if full then
		Registry.Remotes.Notify(target, ("That clan is full (%d players)."):format(Config.ClanMax), "info")
		return
	end
	if joined and not target.Parent then
		-- saiu enquanto entrava: desfaz (senão vira "membro fantasma" ocupando vaga)
		if clanStore then
			pcall(function()
				(clanStore :: DataStore):UpdateAsync(invite.ClanId, function(clan)
					if type(clan) == "table" and type(clan.Members) == "table" then
						clan.Members[tostring(target.UserId)] = nil
						return clan
					end
					return nil
				end)
			end)
		end
		return
	end
	if not joined then
		return
	end
	applyClan(target, invite.ClanId, joined)
	Registry.Remotes.Notify(target, ("You joined the clan \"%s\"!"):format(joined.Name), "rare")
	refreshClanmates(invite.ClanId)
end

function Social.ClanLeave(player: Player)
	local data = getData(player)
	if not data or busy[player] then
		return
	end
	ensure(data)
	local clanId = data.Clan
	if clanId == "" then
		return
	end
	if not clanActionReady(player, data) then
		return
	end
	busy[player] = true
	local key = tostring(player.UserId)
	local empty = false
	local function remove(clan)
		if type(clan) ~= "table" or type(clan.Members) ~= "table" then
			return nil
		end
		clan.Members[key] = nil
		clan.Names = nil
		if clan.Owner == player.UserId then
			clan.Owner = nil
			for id in clan.Members do
				clan.Owner = tonumber(id) -- o dono passa para outro membro
				break
			end
		end
		empty = next(clan.Members) == nil
		if empty then
			clan.Closed = true -- ninguém entra mais (o registro vai ser apagado logo em seguida)
		end
		return clan
	end
	if clanStore then
		local ok = pcall(function()
			(clanStore :: DataStore):UpdateAsync(clanId, remove)
		end)
		if not ok then
			busy[player] = nil
			Registry.Remotes.Notify(player, "Couldn't leave the clan right now. Try again soon!", "error")
			return -- só sai de verdade quando o registro do clã mudou
		end
		if empty then
			-- último membro saiu: apaga o registro do clã (não sobra lixo no DataStore)
			pcall(function()
				(clanStore :: DataStore):RemoveAsync(clanId)
			end)
			clanCache[clanId] = nil
		end
	elseif clanCache[clanId] then
		remove(clanCache[clanId])
		if empty then
			clanCache[clanId] = nil
		end
	end
	data.ClanActionAt = os.time()
	busy[player] = nil
	applyClan(player, clanId, nil)
	Registry.Remotes.Notify(player, "You left your clan.", "info")
	refreshClanmates(clanId)
	Social.Sync(player)
end

local function loadClan(player: Player)
	local data = getData(player)
	if not data or data.Clan == "" then
		return
	end
	local clanId = data.Clan
	local clan = clanCache[clanId]
	if clanStore then
		local ok, stored = pcall(function()
			return (clanStore :: DataStore):GetAsync(clanId)
		end)
		if ok then
			clan = stored
		elseif not clan then
			return -- DataStore fora do ar: tenta na próxima vez
		end
	end
	if not player.Parent then
		return
	end
	if type(clan) == "table" and type(clan.Members) == "table" and clan.Members[tostring(player.UserId)] then
		fetchNames(clan)
		applyClan(player, clanId, clan)
		refreshClanmates(clanId)
	else
		applyClan(player, clanId, nil) -- o clã acabou ou você saiu por outro servidor
	end
end

---------------------------------------------------------------------
-- CONVITES (LaunchData = "inv:<UserId de quem convidou>")
---------------------------------------------------------------------
-- devolve quantos NÃO couberam hoje (ficam guardados para outro dia)
local function rewardInviter(inviter: Player, count: number): number
	local data = getData(inviter)
	if not data then
		return count
	end
	ensure(data)
	local room = Config.InviteRewardsPerDay - data.InviteRewards.Count
	local give = math.clamp(count, 0, room)
	if give <= 0 then
		return count
	end
	data.InviteRewards.Count += give
	local codes = Registry.Codes
	if codes then
		local parts = codes.Grant(inviter, { WorldEgg = give })
		Registry.Remotes.Notify(inviter, ("A friend joined from your invite! You got %s."):format(table.concat(parts, " + ")), "rare")
	end
	return count - give
end

local function checkInvite(player: Player, profile)
	local ok, joinData = pcall(function()
		return player:GetJoinData()
	end)
	local launch = ok and type(joinData) == "table" and joinData.LaunchData
	local inviterId = if type(launch) == "string" then tonumber(string.match(launch, "^inv:(%d+)$")) else nil
	if not inviterId or inviterId == player.UserId or not profile.IsNew then
		return -- só conta amigo NOVO (quem já jogava não dá prêmio)
	end
	-- contra contas falsas: tem que ser amigo de verdade de quem convidou e jogar 10 minutos
	local okFriends, friends = pcall(function()
		return player:IsFriendsWithAsync(inviterId)
	end)
	if not okFriends or not friends then
		return
	end
	task.wait(600)
	if not player.Parent then
		return
	end
	local codes = Registry.Codes
	if codes then
		codes.Grant(player, { Minutes = 5 })
		Registry.Remotes.Notify(player, "Thanks for playing 10 minutes with your friend's invite! You both get a gift!", "rare")
	end
	local inviter = playerById(inviterId)
	if inviter and rewardInviter(inviter, 1) == 0 then
		return
	elseif inviteStore then
		pcall(function()
			(inviteStore :: DataStore):UpdateAsync("u_" .. inviterId, function(old)
				return math.min((tonumber(old) or 0) + 1, 50)
			end)
		end)
	end
end

local function claimInviteRewards(player: Player)
	if not inviteStore then
		return
	end
	local data = getData(player)
	if not data then
		return
	end
	ensure(data)
	local room = Config.InviteRewardsPerDay - data.InviteRewards.Count
	if room <= 0 then
		return
	end
	local take = 0
	pcall(function()
		(inviteStore :: DataStore):UpdateAsync("u_" .. player.UserId, function(old)
			local count = tonumber(old) or 0
			take = math.min(count, room)
			if take <= 0 then
				return nil
			end
			return count - take -- o que não coube hoje fica para outro dia
		end)
	end)
	if take > 0 and player.Parent then
		rewardInviter(player, take)
	end
end

---------------------------------------------------------------------
function Social.SetupPlayer(player: Player, profile)
	local data = getData(player)
	if not data then
		return
	end
	ensure(data)
	player:SetAttribute("Likes", data.Likes)
	task.spawn(function()
		loadClan(player)
		claimInviteRewards(player)
		Social.Sync(player)
	end)
	task.spawn(checkInvite, player, profile) -- espera 10 min jogando antes de dar o prêmio
end

function Social.RemovePlayer(player: Player)
	lastAsk[player] = nil
	giftOffers[player] = nil
	clanInvites[player] = nil
	lastVisit[player] = nil
	busy[player] = nil
	local clanId = player:GetAttribute("ClanId")
	for target, offer in giftOffers do
		if offer.From == player then
			giftOffers[target] = nil
		end
	end
	if typeof(clanId) == "string" then
		task.defer(refreshClanmates, clanId) -- o bônus dos colegas cai
	end
end

function Social.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("Clans_v1")
	end)
	clanStore = if ok then result else nil
	local ok2, result2 = pcall(function()
		return DataStoreService:GetDataStore("InviteRewards_v1")
	end)
	inviteStore = if ok2 then result2 else nil
	if RunService:IsStudio() and clanStore then
		-- Studio sem "API Services": os clãs ficam só neste servidor (para dar para testar)
		task.spawn(function()
			local works = pcall(function()
				return (clanStore :: DataStore):GetAsync("test")
			end)
			if not works then
				clanStore = nil
				inviteStore = nil
			end
		end)
	end
	Players.PlayerRemoving:Connect(Social.RemovePlayer)
	-- botão LIKE no poste de cada base (a tela só mostra para quem NÃO é o dono)
	task.spawn(function()
		local plots = workspace:WaitForChild("Map"):WaitForChild("Plots")
		for _, plot in plots:GetChildren() do
			local post = plot:FindFirstChild("LikePost")
			if post and post:IsA("BasePart") then
				local prompt = Instance.new("ProximityPrompt")
				prompt.Name = "LikePrompt"
				prompt.ActionText = "Like \u{2764}"
				prompt.ObjectText = "This base"
				prompt.HoldDuration = 0
				prompt.MaxActivationDistance = 12
				prompt.RequiresLineOfSight = false
				prompt.KeyboardKeyCode = Enum.KeyCode.F
				prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
				prompt.Triggered:Connect(function(player)
					local ownerId = plot:GetAttribute("OwnerUserId")
					if typeof(ownerId) == "number" then
						Social.Like(player, ownerId)
					end
				end)
				prompt.Parent = post
			end
		end
	end)
	-- a lista de jogadores da tela muda quando alguém entra/sai
	Players.PlayerAdded:Connect(function()
		task.delay(3, syncAll)
	end)
	Players.PlayerRemoving:Connect(function()
		task.defer(syncAll)
	end)
end

return Social
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="468">
        <Properties>
          <string name="Name">Tutorial</string>
          <string name="Source"><![CDATA[--[[
	Tutorial (ModuleScript em ServerScriptService > Game)
	Guia o jogador novo no primeiro minuto. O servidor diz em qual passo ele está
	(atributo "TutorialStep") e a tela mostra o texto e a seta.
	  1 = comprar um ovo na esteira   2 = seguir o ovo até a base   3 = esperar o ovo chocar
	  4 = coletar no pad verde        5 = trancar a base            6 = explicar roubo e taco (fim)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local Tutorial = {}

-- qual evento completa cada passo
local STEP_OF = {
	Bought = 1,
	Placed = 2,
	Hatched = 3,
	Collected = 4,
	Locked = 5,
}
local LAST_STEP = 6

local ORDER = { "Bought", "Placed", "Hatched", "Collected", "Locked" }
local FUNNEL = {
	Bought = "BoughtEgg",
	Placed = "EggArrived",
	Hatched = "Hatched",
	Collected = "Collected",
	Locked = "Locked",
}

local function funnel(player: Player, name: string)
	local analytics = Registry.Analytics
	if analytics then
		analytics.Funnel(player, name)
	end
end

local function setStep(player: Player, step: number?)
	player:SetAttribute("TutorialStep", step)
end

function Tutorial.Finish(player: Player, skipped: boolean?)
	local profile = Registry.Data.Get(player)
	if not profile or profile.Data.TutorialDone or player:GetAttribute("TutorialStep") == nil then
		return
	end
	profile.Data.TutorialDone = true
	local stepAtEnd = tonumber(player:GetAttribute("TutorialStep")) or 0
	if skipped and stepAtEnd >= LAST_STEP then
		skipped = false -- apertou SKIP no último passo: já fez tudo, ganha o prêmio
	end
	setStep(player, nil)
	if skipped then
		local analytics = Registry.Analytics
		if analytics then
			analytics.Event(player, "TutorialSkipped", stepAtEnd)
		end
		return
	end
	funnel(player, "Finished")
	Registry.Economy.AddCash(player, Config.TutorialReward, false, "Tutorial")
	local starter = Config.EggById[Config.StarterEgg]
	if starter then
		Registry.CritterService.GrantEgg(player, starter.Id)
	end
	Registry.Remotes.Notify(player, ("Tutorial complete! +%s and a FREE %s!"):format(Format.Money(Config.TutorialReward), if starter then starter.Name else "egg"), "rare")
end

function Tutorial.Start(player: Player)
	local profile = Registry.Data.Get(player)
	if not profile or profile.Data.TutorialDone then
		return
	end
	funnel(player, "Joined")
	setStep(player, 1)
end

function Tutorial.Event(player: Player, eventName: string)
	local step = player:GetAttribute("TutorialStep")
	local done = STEP_OF[eventName]
	if typeof(step) ~= "number" or not done then
		return
	end
	-- Os passos do ovo (comprar -> chegar -> chocar) podem acontecer rápido e "pular" passos.
	-- Coletar e trancar só contam no passo certo.
	local valid = done == step or (done > step and done <= STEP_OF.Hatched)
	if not valid then
		return
	end
	-- registra também os passos que foram "pulados" (o funil fica certinho)
	for i = step, done do
		funnel(player, FUNNEL[ORDER[i]])
	end
	local nextStep = done + 1
	-- se a base já está trancada ou recarregando, pula o passo de trancar
	if nextStep == STEP_OF.Locked then
		local plot = Registry.Plots.Get(player)
		local cooldownUntil = if plot then plot.Model:GetAttribute("CooldownUntil") or 0 else 0
		if plot and (Registry.Plots.IsLocked(plot) or cooldownUntil > workspace:GetServerTimeNow()) then
			nextStep = LAST_STEP
			funnel(player, FUNNEL.Locked)
		end
	end
	setStep(player, nextStep)
	if nextStep == LAST_STEP then
		task.delay(10, function()
			if player.Parent and player:GetAttribute("TutorialStep") == LAST_STEP then
				Tutorial.Finish(player)
			end
		end)
	end
end

function Tutorial.Init() end

return Tutorial
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="469">
        <Properties>
          <string name="Name">WorldFun</string>
          <string name="Source"><![CDATA[--!strict
--[[
	WorldFun (v27): a brincadeira de cada mundo, lado do SERVIDOR.

	• Baús de prêmio (Tag "FunPrize", atributos World e Key) no fim de cada brincadeira:
	  Candy (camas elásticas), Frost (escorregador de gelo), Lava (pular nas pedras),
	  Reef (jatos de bolha) e Galaxy (gravidade baixa). Quem encosta ganha alguns minutos
	  da própria renda e às vezes um ovo daquele mundo. Cada baú volta depois de
	  Config.WorldFun.PrizeCooldown (salvo no perfil: sair e entrar não reseta).
	• Montes de neve (Tag "SnowPile", com ProximityPrompt): joga uma bola de neve para frente.
	  Acertou alguém = "SPLAT" na tela da pessoa. Sem dano e sem empurrão.

	As partes só visuais (camas elásticas, lava que volta para o começo, gravidade baixa)
	ficam no cliente (StarterPlayerScripts > WorldLife): não dão nada, então não precisam do servidor.
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local WorldFun = {}

local lastNotice: { [Player]: number } = {}
local lastThrow: { [Player]: number } = {}

local function settings()
	return Config.WorldFun
end

local function getData(player: Player)
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

local function playerFromPart(hit: BasePart): Player?
	local node: Instance? = hit
	for _ = 1, 3 do
		if not node then
			return nil
		end
		local found = Players:GetPlayerFromCharacter(node)
		if found then
			return found
		end
		node = node.Parent
	end
	return nil
end

-- o ovo mais barato daquele mundo (sem ovos de clima/semana/exploração)
local function cheapestEgg(worldId: string): string?
	local best, bestPrice = nil, math.huge
	for _, egg in Config.EggsOfWorld(worldId) do
		if not egg.Condition and (egg.Weight or 0) > 0 and egg.Price < bestPrice then
			best, bestPrice = egg.Id, egg.Price
		end
	end
	return best
end

local function publish(player: Player)
	local data = getData(player)
	local prizes = data and data.FunPrizes
	if type(prizes) ~= "table" then
		return
	end
	for key, readyAt in prizes do
		if type(key) == "string" and type(readyAt) == "number" then
			player:SetAttribute("Fun_" .. key, readyAt)
		end
	end
end

function WorldFun.Claim(player: Player, prize: BasePart)
	local key = prize:GetAttribute("Key")
	local worldId = prize:GetAttribute("World")
	if typeof(key) ~= "string" or typeof(worldId) ~= "string" or not player:GetAttribute("Loaded") then
		return
	end
	local here = player:GetAttribute("World")
	if (typeof(here) == "string" and here or "meadow") ~= worldId then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or (root.Position - prize.Position).Magnitude > 16 then
		return
	end
	local data = getData(player)
	if not data then
		return
	end
	if type(data.FunPrizes) ~= "table" then
		data.FunPrizes = {}
	end
	local now = os.time()
	local readyAt = tonumber(data.FunPrizes[key]) or 0
	if now < readyAt then
		if os.clock() - (lastNotice[player] or 0) > 4 then
			lastNotice[player] = os.clock()
			Registry.Remotes.Notify(player, ("This treasure is back in %s!"):format(Format.Time(readyAt - now)), "info")
		end
		return
	end
	local cfg = settings()
	data.FunPrizes[key] = now + cfg.PrizeCooldown
	player:SetAttribute("Fun_" .. key, now + cfg.PrizeCooldown)
	local reward: { [string]: any } = { Cash = cfg.PrizeCashMinutes }
	if math.random() < cfg.PrizeEggChance then
		reward.Egg = cheapestEgg(worldId)
	end
	local text = Registry.Retention.Grant(player, reward, cfg.PrizeMinCash, "FunPrize")
	Registry.Remotes.Notify(player, "TREASURE! " .. text, "success")
	Registry.Remotes.Effect(player, "FunPrize", prize.Position)
	local analytics = Registry.Analytics
	if analytics then
		pcall(analytics.Event, player, "FunPrize_" .. key, 1)
	end
end

function WorldFun.Throw(player: Player)
	local cfg = settings()
	local now = os.clock()
	if now - (lastThrow[player] or 0) < cfg.SnowballCooldown then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not character or not root then
		return
	end
	lastThrow[player] = now
	local look = root.CFrame.LookVector
	local ball = Instance.new("Part")
	ball.Name = "Snowball"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(1.4, 1.4, 1.4)
	ball.Material = Enum.Material.Snow
	ball.Color = Color3.fromRGB(250, 252, 255)
	ball.CanCollide = false
	ball.CanQuery = false
	ball.CanTouch = true
	ball.Massless = true
	ball.CFrame = CFrame.new(root.Position + look * 3 + Vector3.new(0, 2.5, 0))
	ball.Parent = workspace
	pcall(function()
		ball:SetNetworkOwner(nil)
	end)
	ball.AssemblyLinearVelocity = look * cfg.SnowballSpeed + Vector3.new(0, 26, 0)
	local done = false
	ball.Touched:Connect(function(hit)
		if done or hit:IsDescendantOf(character) or hit.Name == "Snowball" then
			return
		end
		local victim = playerFromPart(hit)
		if victim then
			done = true
			Registry.Remotes.Effect(victim, "Splat")
			Registry.Remotes.Effect(player, "SnowHit", ball.Position)
			ball:Destroy()
		elseif hit.CanCollide then
			done = true
			ball:Destroy()
		end
	end)
	Debris:AddItem(ball, 3)
end

function WorldFun.Init()
	local function setupPrize(prize: Instance)
		if not prize:IsA("BasePart") or prize:GetAttribute("FunReady") then
			return
		end
		prize:SetAttribute("FunReady", true)
		prize.Touched:Connect(function(hit)
			local player = playerFromPart(hit)
			if player then
				WorldFun.Claim(player, prize)
			end
		end)
	end
	local function setupPile(pile: Instance)
		local prompt = pile:FindFirstChildWhichIsA("ProximityPrompt")
		if not prompt or pile:GetAttribute("FunReady") then
			return
		end
		pile:SetAttribute("FunReady", true)
		prompt.Triggered:Connect(function(player)
			WorldFun.Throw(player)
		end)
	end
	for _, prize in CollectionService:GetTagged("FunPrize") do
		setupPrize(prize)
	end
	CollectionService:GetInstanceAddedSignal("FunPrize"):Connect(setupPrize)
	for _, pile in CollectionService:GetTagged("SnowPile") do
		setupPile(pile)
	end
	CollectionService:GetInstanceAddedSignal("SnowPile"):Connect(setupPile)

	-- os relógios dos baús aparecem para o jogador assim que o perfil carrega
	local function watch(player: Player)
		if player:GetAttribute("Loaded") then
			publish(player)
		end
		player:GetAttributeChangedSignal("Loaded"):Connect(function()
			if player:GetAttribute("Loaded") then
				publish(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastNotice[player] = nil
		lastThrow[player] = nil
	end)
end

return WorldFun
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="470">
        <Properties>
          <string name="Name">Worlds</string>
          <string name="Source"><![CDATA[--[[
	Worlds (ModuleScript em ServerScriptService > Game)
	Os 6 mundos do jogo:
	  • destravar: ter os Rebirths pedidos + pagar o Cash (uma vez; fica para sempre)
	  • viajar: portais no fim do Meadow, botão WORLDS na tela e portal "HOME" em cada mundo
	  • o jogo guarda em qual mundo cada jogador está (atributo "World") para ligar só as esteiras usadas
	Os mundos ficam em Config.Worlds; o mapa de cada um fica em Workspace > Map > Worlds.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local Worlds = {}

local spawns: { [string]: BasePart } = {}
local lookAt: { [string]: Vector3 } = {}
local lastTravel: { [Player]: number } = {}
local lastPortalHint: { [Player]: number } = {}
local traveling: { [Player]: boolean } = {}

local function getData(player: Player): any
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

local function playerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	return if model then Players:GetPlayerFromCharacter(model) else nil
end

-- Texto do que precisa para destravar ("Rebirth 1 + $100M")
function Worlds.RequirementText(world): string
	local parts = {}
	if world.Rebirths > 0 then
		table.insert(parts, "Rebirth " .. world.Rebirths)
	end
	if world.Cash > 0 then
		table.insert(parts, Format.Money(world.Cash))
	end
	return if #parts > 0 then table.concat(parts, " + ") else "FREE"
end

function Worlds.IsUnlocked(player: Player, worldId: string): boolean
	if worldId == "meadow" then
		return true
	end
	local data = getData(player)
	return data ~= nil and type(data.Worlds) == "table" and data.Worlds[worldId] == true
end

-- A tela lê "WorldsUnlocked" = "meadow,candy,..."
function Worlds.Sync(player: Player)
	local list = {}
	for _, world in Config.Worlds do
		if Worlds.IsUnlocked(player, world.Id) then
			table.insert(list, world.Id)
		end
	end
	player:SetAttribute("WorldsUnlocked", table.concat(list, ","))
end

function Worlds.SpawnCFrame(worldId: string): CFrame?
	local pad = spawns[worldId]
	if not pad then
		return nil
	end
	local base = pad.Position + Vector3.new(0, 4, 0)
	-- olhando para a esteira do mundo (que fica no meio da ilha)
	local look = lookAt[worldId]
	local target = if look then Vector3.new(look.X, base.Y, look.Z) else base - Vector3.zAxis
	return CFrame.lookAt(base, target)
end

function Worlds.Travel(player: Player, worldId: string)
	local Remotes = Registry.Remotes
	local world = Config.WorldById[worldId]
	if not world or not player:GetAttribute("Loaded") then
		return
	end
	if player:GetAttribute("InMinigame") then
		Remotes.Notify(player, "Finish your minigame first!", "info")
		return
	end
	if not Worlds.IsUnlocked(player, worldId) then
		Remotes.Notify(player, ("%s is locked: %s"):format(world.Name, Worlds.RequirementText(world)), "warning")
		Remotes.Effect(player, "OpenWorlds", worldId)
		return
	end
	local t = os.clock()
	if traveling[player] or t - (lastTravel[player] or 0) < Config.WorldTravelCooldown then
		return
	end
	if Registry.CritterService.IsCarrying(player) then
		Remotes.Notify(player, "You can't travel while carrying something! Run to your base first.", "error")
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not root or not humanoid or humanoid.Health <= 0 then
		return
	end

	local target: CFrame? = nil
	if worldId == "meadow" then
		local plot = Registry.Plots.Get(player)
		target = if plot then Registry.Plots.SpawnCFrame(plot) else nil
	else
		target = Worlds.SpawnCFrame(worldId)
	end
	if not target then
		return
	end
	lastTravel[player] = t

	-- carrega o chão do destino antes (StreamingEnabled), senão o jogador cai
	traveling[player] = true
	pcall(function()
		player:RequestStreamAroundAsync(target.Position, 5)
	end)
	if not player.Parent then
		return -- saiu durante a viagem (não guarda nada dele)
	end
	traveling[player] = nil
	lastTravel[player] = os.clock()
	if not player.Parent or player.Character ~= character or humanoid.Health <= 0 then
		return
	end
	if Registry.CritterService.IsCarrying(player) then
		return
	end
	character:PivotTo(target)
	player:SetAttribute("World", worldId)
	Registry.CritterService.ActivateLane(worldId)
	Remotes.Effect(player, "Travel", worldId)
	if worldId ~= "meadow" then
		Remotes.Notify(player, "Welcome to " .. world.Name .. "! Eggs you buy here fly to your base.", "info")
	end
end

function Worlds.Unlock(player: Player, worldId: string)
	local Remotes = Registry.Remotes
	local Economy = Registry.Economy
	local world = Config.WorldById[worldId]
	local data = getData(player)
	if not world or worldId == "meadow" or not data or not player:GetAttribute("Loaded") then
		return
	end
	if Worlds.IsUnlocked(player, worldId) then
		Worlds.Travel(player, worldId)
		return
	end
	-- os mundos abrem em ordem
	local previous = Config.Worlds[(Config.WorldIndex[worldId] or 2) - 1]
	if previous and not Worlds.IsUnlocked(player, previous.Id) then
		Remotes.Notify(player, "Unlock " .. previous.Name .. " first!", "warning")
		return
	end
	if Economy.GetPeakRebirths(player) < world.Rebirths then -- o prestígio não tranca mundos
		Remotes.Notify(player, ("You need Rebirth %d to unlock %s!"):format(world.Rebirths, world.Name), "error")
		return
	end
	if not Economy.TrySpend(player, world.Cash, "World") then
		Remotes.Notify(player, ("You need %s to unlock %s!"):format(Format.Money(world.Cash), world.Name), "error")
		return
	end
	if type(data.Worlds) ~= "table" then
		data.Worlds = {}
	end
	data.Worlds[worldId] = true
	Worlds.Sync(player)
	Economy.SeasonXP(player, "World")
	Remotes.Effect(player, "WorldUnlocked", worldId)
	Remotes.NotifyAll(("%s unlocked %s!"):format(player.DisplayName, string.upper(world.Name)), "rare")
	local analytics = Registry.Analytics
	if analytics then
		analytics.Event(player, "WorldUnlocked_" .. worldId)
	end
	task.spawn(Registry.Data.Save, player)
	lastTravel[player] = nil
	task.delay(1.2, Worlds.Travel, player, worldId)
end

-- Admin/teste: destrava todos
function Worlds.UnlockAll(player: Player)
	local data = getData(player)
	if not data then
		return
	end
	data.Worlds = type(data.Worlds) == "table" and data.Worlds or {}
	for _, world in Config.Worlds do
		if world.Id ~= "meadow" then
			data.Worlds[world.Id] = true
		end
	end
	Worlds.Sync(player)
end

-- Renasceu: sempre volta para a base (Meadow)
function Worlds.OnCharacter(player: Player)
	player:SetAttribute("World", "meadow")
end

function Worlds.SetupPlayer(player: Player)
	player:SetAttribute("World", "meadow")
	Worlds.Sync(player)
end

function Worlds.RemovePlayer(player: Player)
	lastTravel[player] = nil
	lastPortalHint[player] = nil
	traveling[player] = nil
end

local function makeSignText(part: BasePart, face: Enum.NormalId, title: string, subtitle: string, color: Color3)
	local surface = Instance.new("SurfaceGui")
	surface.Face = face
	surface.LightInfluence = 0
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 25
	local function line(text: string, y: number, height: number, textColor: Color3)
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, -20, height, 0)
		label.Position = UDim2.new(0, 10, y, 0)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = textColor
		label.Text = text
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 3
		stroke.Color = Color3.fromRGB(20, 20, 35)
		stroke.Parent = label
		label.Parent = surface
	end
	line(title, 0.04, if subtitle ~= "" then 0.56 else 0.9, color)
	if subtitle ~= "" then
		line(subtitle, 0.62, 0.34, Color3.fromRGB(255, 230, 120))
	end
	surface.Parent = part
end

local function connectPortal(disc: BasePart, worldId: string)
	disc.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if not player then
			return
		end
		local t = os.clock()
		if Registry.CritterService.IsCarrying(player) then
			if t - (lastPortalHint[player] or 0) > 3 then
				lastPortalHint[player] = t
				Registry.Remotes.Notify(player, "You can't travel while carrying something! Run to your base first.", "error")
			end
		elseif Worlds.IsUnlocked(player, worldId) then
			Worlds.Travel(player, worldId)
		else
			if t - (lastPortalHint[player] or 0) > 3 then
				lastPortalHint[player] = t
				local world = Config.WorldById[worldId]
				Registry.Remotes.Notify(player, ("%s: %s to unlock"):format(world.Name, Worlds.RequirementText(world)), "warning")
				Registry.Remotes.Effect(player, "OpenWorlds", worldId)
			end
		end
	end)
end

function Worlds.Init()
	local map = workspace:WaitForChild("Map")

	-- Portais no Meadow (um para cada mundo)
	local portals = map:FindFirstChild("WorldPortals")
	if portals then
		for _, world in Config.Worlds do
			local portal = portals:FindFirstChild(world.Id)
			if portal then
				local disc = portal:FindFirstChild("Disc") :: BasePart?
				local sign = portal:FindFirstChild("Sign") :: BasePart?
				if disc then
					connectPortal(disc, world.Id)
				end
				if sign then
					makeSignText(sign, Enum.NormalId.Left, string.upper(world.Name), Worlds.RequirementText(world), world.Color)
				end
			end
		end
	end

	-- Cada mundo: ponto de chegada, portal de volta e placa com o nome
	local worldsFolder = map:FindFirstChild("Worlds")
	if worldsFolder then
		for _, world in Config.Worlds do
			local area = worldsFolder:FindFirstChild(world.Id)
			if area then
				local spawn = area:FindFirstChild("Spawn") :: BasePart?
				if spawn then
					spawns[world.Id] = spawn
				end
				local belt = area:FindFirstChild("Conveyor") :: BasePart?
				if belt then
					lookAt[world.Id] = belt.Position
				end
				local home = area:FindFirstChild("HomePortal")
				local disc = home and home:FindFirstChild("Disc") :: BasePart?
				if disc then
					connectPortal(disc, "meadow")
				end
				local homeSign = home and home:FindFirstChild("Sign") :: BasePart?
				if homeSign then
					makeSignText(homeSign, Enum.NormalId.Front, "BACK TO BASE", "", Color3.fromRGB(120, 255, 120))
				end
				local title = area:FindFirstChild("TitleSign") :: BasePart?
				if title then
					for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
						makeSignText(title, face, string.upper(world.Name), "", world.Color)
					end
				end
			end
		end
	end

	Players.PlayerRemoving:Connect(Worlds.RemovePlayer)
end

return Worlds
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="471">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	STEAL A CRITTER - script principal do servidor.
	(Script chamado "Main" em ServerScriptService)
	Liga todos os módulos da pasta "Game" e cuida da entrada/saída dos jogadores.
	Pra ajustar o jogo, mexa em ReplicatedStorage > Shared > Config (e Critters).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local GameFolder = script.Parent:WaitForChild("Game")
local Registry = require(GameFolder.Registry)

Registry.Remotes = require(GameFolder.Remotes)
Registry.Policy = require(GameFolder.Policy)
Registry.Data = require(GameFolder.Data)
Registry.Plots = require(GameFolder.Plots)
Registry.CritterService = require(GameFolder.CritterService)
Registry.Economy = require(GameFolder.Economy)
Registry.Combat = require(GameFolder.Combat)
Registry.Admin = require(GameFolder.Admin)
Registry.Events = require(GameFolder.Events)
Registry.Leaderboards = require(GameFolder.Leaderboards)
Registry.Products = require(GameFolder.Products)
Registry.Tutorial = require(GameFolder.Tutorial)
Registry.Analytics = require(GameFolder.Analytics)
Registry.Worlds = require(GameFolder.Worlds)
Registry.Scenery = require(GameFolder.Scenery)
Registry.Fairness = require(GameFolder.Fairness)
Registry.Codes = require(GameFolder.Codes)
Registry.Pets = require(GameFolder.Pets)
Registry.Customize = require(GameFolder.Customize)
Registry.Season = require(GameFolder.Season)
Registry.Environment = require(GameFolder.Environment)
Registry.Discoveries = require(GameFolder.Discoveries)
Registry.GiantEgg = require(GameFolder.GiantEgg)
Registry.Progress = require(GameFolder.Progress)
Registry.Social = require(GameFolder.Social)
Registry.LiveEvents = require(GameFolder.LiveEvents)
Registry.Battle = require(GameFolder.Battle)
Registry.Minigames = require(GameFolder.Minigames)
Registry.Explore = require(GameFolder.Explore)
Registry.Mounts = require(GameFolder.Mounts)
Registry.Retention = require(GameFolder.Retention) -- v23: presentes de tempo de jogo + roleta diária
Registry.WorldFun = require(GameFolder.WorldFun) -- v27: brincadeiras dos mundos (baús e bolas de neve)
Registry.NPCService = require(GameFolder.NPCService)
Registry.Bandits = require(GameFolder.Bandits) -- v24: ladrão NPC quando o servidor está vazio

-- v15: modelos 3D importados que ficaram soltos no Workspace vão para ReplicatedStorage > Models3D
do
	local moved = require(game:GetService("ReplicatedStorage").Shared.Models3D).CollectFromWorkspace()
	if moved > 0 then
		print(("[Models3D] moved %d imported 3D models from Workspace to ReplicatedStorage.Models3D"):format(moved))
	end
end
-- v21: a janela do chat do Roblox fica no canto de BAIXO, à esquerda (o canto de cima é dos avisos do jogo).
-- A configuração já vem salva no lugar (tools/build_project.py); aqui só garante, caso o Roblox recrie.
task.spawn(function()
	pcall(function()
		local window = game:GetService("TextChatService"):WaitForChild("ChatWindowConfiguration", 10)
		if window then
			window.HorizontalAlignment = Enum.HorizontalAlignment.Left
			window.VerticalAlignment = Enum.VerticalAlignment.Bottom
		end
	end)
end)
Registry.Policy.Init() -- regras do país (PolicyService) antes de tudo
Registry.Scenery.Init()
Registry.Plots.Init()
Registry.CritterService.Init()
Registry.Economy.Init()
Registry.Combat.Init()
Registry.Admin.Init()
Registry.Events.Init()
Registry.Leaderboards.Init()
Registry.Products.Init()
Registry.Tutorial.Init()
Registry.Analytics.Init()
Registry.Worlds.Init()
Registry.Fairness.Init()
Registry.Pets.Init()
Registry.Customize.Init()
Registry.Season.Init()
Registry.Environment.Init()
Registry.Discoveries.Init()
task.spawn(Registry.GiantEgg.Init) -- espera o mapa sem travar o resto
Registry.Progress.Init()
Registry.Social.Init()
Registry.LiveEvents.Init()
Registry.Battle.Init()
Registry.Minigames.Init()
Registry.Explore.Init()
Registry.Mounts.Init()
Registry.Retention.Init()
Registry.WorldFun.Init()
task.spawn(Registry.NPCService.Init) -- mascote + ajudantes (3D se estiverem importados)
Registry.Bandits.Init()
Registry.Weekly = require(game:GetService("ReplicatedStorage").Shared.Weekly) -- v26: critter da semana
Registry.Weekly.InitServer(Registry)

-- Placa gigante com o nome do jogo em cima da esteira
do
	local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
	local titleSign = workspace:WaitForChild("Map"):FindFirstChild("TitleSign")
	if titleSign then
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
			local surface = Instance.new("SurfaceGui")
			surface.Face = face
			surface.LightInfluence = 0
			surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			surface.PixelsPerStud = 20
			local title = Instance.new("TextLabel")
			title.Size = UDim2.new(1, -40, 1, -30)
			title.Position = UDim2.fromOffset(20, 15)
			title.BackgroundTransparency = 1
			title.Font = Enum.Font.FredokaOne
			title.TextScaled = true
			title.TextColor3 = Color3.fromRGB(255, 255, 255)
			title.Text = string.upper(Config.GameName)
			local stroke = Instance.new("UIStroke")
			stroke.Thickness = 6
			stroke.Color = Color3.fromRGB(30, 20, 60)
			stroke.Parent = title
			local gradient = Instance.new("UIGradient")
			gradient.Color = ColorSequence.new(Color3.fromRGB(255, 230, 90), Color3.fromRGB(255, 120, 60))
			gradient.Rotation = 90
			gradient.Parent = title
			title.Parent = surface
			surface.Parent = titleSign
		end
	end
end

local function onCharacter(player: Player, character: Model)
	Registry.Minigames.OnCharacter(player) -- renasceu no meio de um minigame: sai dele
	Registry.Worlds.OnCharacter(player)
	Registry.Plots.SetupCharacter(player, character)
	task.spawn(function()
		local humanoid = character:WaitForChild("Humanoid", 10)
		if humanoid then
			Registry.Economy.ApplySpeed(player)
		end
		character:WaitForChild("Head", 10)
		Registry.Customize.OnCharacter(player) -- trilha e título em cima da cabeça
		character:WaitForChild("HumanoidRootPart", 10)
		Registry.Progress.OnCharacter(player) -- aura do prestígio
	end)
	task.spawn(Registry.Combat.GiveTool, player, character)
end

local function onPlayerAdded(player: Player)
	local plot = Registry.Plots.Assign(player)
	if not plot then
		player:Kick("This server is full. Please join another server!")
		return
	end
	Registry.Admin.SetupPlayer(player)

	local profile = Registry.Data.Load(player)
	if not player.Parent then
		-- saiu enquanto carregava: libera a trava dos dados
		if profile.CanSave then
			Registry.Data.Save(player, true)
		end
		Registry.Plots.Release(player)
		Registry.Data.Remove(player)
		return
	end
	if not profile.CanSave and not RunService:IsStudio() then
		player:Kick("Couldn't load your save (Roblox servers are busy). Your progress is safe - please rejoin!")
		return
	end

	Registry.Economy.SetupPlayer(player, profile)
	if not player.Parent or player:GetAttribute("Leaving") then
		return
	end
	Registry.Worlds.SetupPlayer(player)
	Registry.Fairness.SetupPlayer(player)
	Registry.CritterService.LoadForPlayer(player, profile.Data.Critters, profile.Data.Eggs)
	Registry.Pets.SetupPlayer(player)
	Registry.Customize.SetupPlayer(player)
	Registry.Economy.AfterLoad(player, profile)
	Registry.Season.SetupPlayer(player) -- depois do dinheiro offline/diária (um 2x do passe não dobra o offline)
	Registry.Progress.SetupPlayer(player) -- nível, missões do dia e conquistas (v10)
	Registry.Social.SetupPlayer(player, profile) -- likes, clã e convites (v11)
	player:SetAttribute("Loaded", true)
	Registry.LiveEvents.SetupPlayer(player) -- presentes da comunidade/criador e mercador (v11): precisa do Loaded
	Registry.Explore.SetupPlayer(player) -- caça aos ovos do dia (v13)
	Registry.Tutorial.Start(player)

	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		onCharacter(player, player.Character)
	end
end

-- Dinheiro que ficou no coletor vai para o bolso antes de salvar
local function bankVault(player: Player)
	local plot = Registry.Plots.Get(player)
	if plot and plot.Vault >= 1 and player:GetAttribute("Loaded") then
		Registry.Economy.AddCash(player, math.floor(plot.Vault), true, "Collect")
		plot.Vault = 0
	end
end

local function onPlayerRemoving(player: Player)
	player:SetAttribute("Leaving", true)
	Registry.CritterService.DropCarried(player)
	bankVault(player)
	Registry.Analytics.RemovePlayer(player)
	Registry.Data.Save(player, true)
	Registry.CritterService.ClearOwnerCritters(player)
	Registry.Plots.Release(player)
	Registry.Economy.RemovePlayer(player)
	Registry.Combat.RemovePlayer(player)
	Registry.Codes.RemovePlayer(player)
	Registry.Data.Remove(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- Salva todo mundo de tempos em tempos
task.spawn(function()
	while true do
		task.wait(60)
		local ok, err = pcall(function()
			for _, player in Players:GetPlayers() do
				task.spawn(Registry.Data.Save, player)
			end
		end)
		if not ok then
			warn("[Main] loop error:", err)
		end
	end
end)

-- Salva quando o servidor fecha
game:BindToClose(function()
	local pending = 0
	for _, player in Players:GetPlayers() do
		player:SetAttribute("Leaving", true)
		Registry.CritterService.DropCarried(player)
	end
	for _, player in Players:GetPlayers() do
		pending += 1
		task.spawn(function()
			bankVault(player)
			Registry.Data.Save(player, true)
			pending -= 1
		end)
	end
	local started = os.clock()
	while (pending > 0 or Registry.Data.ActiveSaves() > 0) and os.clock() - started < 25 do
		task.wait(0.1)
	end
	if RunService:IsStudio() then
		task.wait(0.5)
	end
end)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="SoundService" referent="472">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
    <Item class="SoundGroup" referent="473">
      <Properties>
        <string name="Name">SFX</string>
        <float name="Volume">1</float>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="474">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="475">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="ModuleScript" referent="476">
        <Properties>
          <string name="Name">Atmos</string>
          <string name="Source"><![CDATA[--[[
	Atmos (ModuleScript em StarterPlayer > StarterPlayerScripts)
	Parte 21: DIA/NOITE e CLIMA na tela do jogador (só no Meadow, onde ficam as bases).
	  • O relógio vem do servidor (atributos do Workspace), então todo mundo vê a mesma hora
	  • Chuva e neve: partículas só em volta da câmera (leve no celular; menos partículas com "Low graphics")
	  • Plaquinha ao lado do dinheiro: clima + hora (os ovos de clima só chocam no clima certo)
	O servidor manda: Workspace "Weather" (Sun/Rain/Snow), "DayLength", "DayFraction", "ForcedNight".
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local UI = require(script.Parent:WaitForChild("UIKit"))
local Juice = require(script.Parent:WaitForChild("Juice"))

local Atmos = {}

local C = UI.Colors
local NIGHT_AMBIENT = Color3.fromRGB(105, 110, 150) -- noite clarinha (criança precisa enxergar!)
local ICONS = { Sun = "\u{2600}\u{FE0F}", Rain = "\u{1F327}\u{FE0F}", Snow = "\u{2744}\u{FE0F}", Night = "\u{1F319}" }

-- Mesma conta do servidor (Environment.ClockAt)
local function clockAt(serverTime: number): number
	local length = tonumber(workspace:GetAttribute("DayLength")) or Config.DayLength
	local day = tonumber(workspace:GetAttribute("DayFraction")) or Config.DayFraction
	local forced = workspace:GetAttribute("ForcedNight")
	if typeof(forced) == "number" and serverTime < forced then
		return 0
	end
	local phase = (serverTime % length) / length
	if phase < day then
		return 6.5 + phase / day * 11
	end
	return (17.5 + (phase - day) / (1 - day) * 13) % 24
end

local function isNightClock(clock: number): boolean
	return clock >= 18.5 or clock < 5.5
end

local function makeEmitter(kind: string, parent: BasePart): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = kind
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.EmissionDirection = Enum.NormalId.Bottom
	emitter.Enabled = false
	emitter.LockedToPart = false
	if kind == "Rain" then
		emitter.Color = ColorSequence.new(Color3.fromRGB(170, 200, 255))
		emitter.Size = NumberSequence.new(0.18)
		emitter.Squash = NumberSequence.new(2.5) -- gotas compridas
		emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
		emitter.Transparency = NumberSequence.new(0.35)
		emitter.LightEmission = 0.2
		emitter.Speed = NumberRange.new(70, 85)
		emitter.Lifetime = NumberRange.new(0.8, 1)
		emitter.Rate = 450
		emitter.SpreadAngle = Vector2.new(4, 4)
	else
		emitter.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
		emitter.Size = NumberSequence.new(0.35, 0.5)
		emitter.Transparency = NumberSequence.new(0.1)
		emitter.LightEmission = 0.3
		emitter.Speed = NumberRange.new(6, 10)
		emitter.Lifetime = NumberRange.new(5, 7)
		emitter.Rate = 160
		emitter.SpreadAngle = Vector2.new(25, 25)
		emitter.RotSpeed = NumberRange.new(-60, 60)
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.Acceleration = Vector3.new(1.5, 0, 0.5) -- ventinho
	end
	emitter.Parent = parent
	return emitter
end

function Atmos.Init(ctx)
	local player = Players.LocalPlayer

	-- nuvem invisível em cima da câmera (as gotas nascem dela)
	local cloud = Instance.new("Part")
	cloud.Name = "WeatherCloud"
	cloud.Anchored = true
	cloud.CanCollide = false
	cloud.CanQuery = false
	cloud.CanTouch = false
	cloud.CastShadow = false
	cloud.Transparency = 1
	cloud.Size = Vector3.new(110, 1, 110)
	cloud.Parent = workspace
	local rain = makeEmitter("Rain", cloud)
	local snow = makeEmitter("Snow", cloud)

	-- plaquinha do clima (v21: primeiro item da coluna da esquerda)
	local chip = UI.create("Frame", {
		Name = "WeatherChip",
		LayoutOrder = 5,
		Size = UDim2.fromOffset(100, 28),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.1,
		ZIndex = 30,
		Parent = ctx.leftStack or ctx.gui,
	}, { UI.corner(10), UI.border(C.Blue, 2) })
	local chipText = UI.label({ Size = UDim2.new(1, -10, 1, -6), Position = UDim2.fromOffset(5, 3), Text = "", ZIndex = 31, Parent = chip })
	local chipButton = UI.create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 32, Parent = chip })
	chipButton.Activated:Connect(function()
		ctx.play("Click")
		ctx.toast("Weather changes every few minutes. Storm Eggs hatch in RAIN, Snowflake Eggs in SNOW, Moon Eggs at NIGHT!", "info")
	end)

	-- efeitos das criaturas vivas
	ctx.EffectEvent.OnClientEvent:Connect(function(kind, data)
		if kind == "Pet" and typeof(data) == "Vector3" then
			ctx.play("Coin")
			ctx.floatingText(data + Vector3.new(0, 3, 0), "\u{2665} +10%", Color3.fromRGB(255, 120, 170))
		elseif kind == "GiantTap" then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				ctx.floatingText(root.Position + Vector3.new(0, 3, 0), "+1", C.Gold)
			end
			ctx.play("Click")
		elseif kind == "WorldFirst" then
			ctx.play("Shiny")
			ctx.flash(C.Gold, 0.8)
			ctx.bigText("WORLD FIRST!", C.Gold)
			Juice.Confetti(ctx.gui, 140, { C.Gold, C.White, C.Pink })
			Juice.Shake(0.8, 0.6)
		end
	end)

	local originalAmbient = Lighting.OutdoorAmbient
	local lastWeather = ""
	local lastLow: boolean? = nil
	local nextUpdate = 0
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now < nextUpdate then
			return
		end
		nextUpdate = now + 0.1
		local here = player:GetAttribute("World")
		local inMeadow = here == nil or here == "meadow"
		local serverTime = workspace:GetServerTimeNow()
		local clock = clockAt(serverTime)
		local night = isNightClock(clock)
		local weather = tostring(workspace:GetAttribute("Weather") or "Sun")

		if inMeadow then
			Lighting.ClockTime = clock
			-- de noite o céu fica escuro, mas o chão continua visível
			local dark = if night then 1 elseif clock > 17.5 then clock - 17.5 elseif clock < 6.5 then 6.5 - clock else 0
			Lighting.OutdoorAmbient = originalAmbient:Lerp(NIGHT_AMBIENT, math.clamp(dark, 0, 1))
		elseif Lighting.OutdoorAmbient ~= originalAmbient then
			Lighting.OutdoorAmbient = originalAmbient
		end

		-- partículas só no Meadow
		local low = player:GetAttribute("LowGfx") == true
		local camera = workspace.CurrentCamera
		if camera then
			local position = camera.CFrame.Position
			cloud.CFrame = CFrame.new(position.X, position.Y + 38, position.Z)
		end
		local key = weather .. tostring(inMeadow)
		if key ~= lastWeather or low ~= lastLow then
			lastWeather = key
			lastLow = low
			rain.Enabled = inMeadow and weather == "Rain"
			snow.Enabled = inMeadow and weather == "Snow"
			rain.Rate = if low then 140 else 450
			snow.Rate = if low then 50 else 160
		end

		-- plaquinha: ícone + hora
		local hours = math.floor(clock)
		local minutes = math.floor((clock - hours) * 60 / 10) * 10
		local icon = if weather ~= "Sun" then ICONS[weather] elseif night then ICONS.Night else ICONS.Sun
		chipText.Text = ("%s %02d:%02d"):format(icon or "", hours, minutes)
	end)
end

return Atmos
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="477">
        <Properties>
          <string name="Name">ClientMain</string>
          <string name="Source"><![CDATA[--[[
	ClientMain (LocalScript em StarterPlayer > StarterPlayerScripts)
	Tudo o que aparece na tela do jogador: dinheiro, loja, índice, rebirth, códigos, convite,
	eventos, tutorial, ovo chocando (com suspense), esteira de treino, avisos, sons e efeitos.
	A tela só PEDE coisas ao servidor; quem decide é sempre o servidor.
	Textos em inglês; o Roblox traduz sozinho para quem joga em português.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ProximityPromptService = game:GetService("ProximityPromptService")
local SocialService = game:GetService("SocialService")
local SoundService = game:GetService("SoundService")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local IS_STUDIO = RunService:IsStudio()

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Critters = require(Shared:WaitForChild("Critters"))
local Format = require(Shared:WaitForChild("Format"))
local Builder = require(Shared:WaitForChild("CritterBuilder"))

local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local NotifyEvent = RemotesFolder:WaitForChild("Notify") :: RemoteEvent
local PopupEvent = RemotesFolder:WaitForChild("Popup") :: RemoteEvent
local KnockbackEvent = RemotesFolder:WaitForChild("Knockback") :: RemoteEvent
local EffectEvent = RemotesFolder:WaitForChild("Effect") :: RemoteEvent
local IndexEvent = RemotesFolder:WaitForChild("IndexSync") :: RemoteEvent
local RequestEvent = RemotesFolder:WaitForChild("Request") :: RemoteEvent

---------------------------------------------------------------------
-- Estilo: tudo vem do kit de UI (UIKit) e dos efeitos (Juice), ao lado deste script
---------------------------------------------------------------------
local UI = require(script.Parent:WaitForChild("UIKit"))
local Juice = require(script.Parent:WaitForChild("Juice"))
local FONT = UI.Font
local COLORS = UI.Colors
local WHITE, DARK, PANEL, ROW = COLORS.White, COLORS.Dark, COLORS.Panel, COLORS.Row
local GREEN, BLUE, PURPLE, RED = COLORS.Green, COLORS.Blue, COLORS.Purple, COLORS.Red
local GOLD, ORANGE, GRAY = COLORS.Gold, COLORS.Orange, COLORS.Gray

local KIND_COLORS = {
	success = Color3.fromRGB(50, 175, 80),
	error = Color3.fromRGB(215, 55, 60),
	warning = Color3.fromRGB(235, 140, 30),
	rare = Color3.fromRGB(150, 70, 240),
	info = Color3.fromRGB(55, 120, 220),
}

local create, corner, border, shine, label, button = UI.create, UI.corner, UI.border, UI.shine, UI.label, UI.button

---------------------------------------------------------------------
-- Escala para celular / PC
---------------------------------------------------------------------
local scales: { UIScale } = {}
local function autoScale(guiObject: GuiObject, multiplier: number?)
	local scale = Instance.new("UIScale")
	scale:SetAttribute("Mul", multiplier or 1) -- v22: a coluna da esquerda é um pouco menor que o resto
	scale.Parent = guiObject
	table.insert(scales, scale)
end

local function updateScales()
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	local value = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.55, 1.25)
	for _, scale in scales do
		local final = value * (tonumber(scale:GetAttribute("Mul")) or 1)
		scale.Scale = final
		scale:SetAttribute("Base", final) -- UIKit.popIn anima a partir deste tamanho
	end
end

---------------------------------------------------------------------
-- Sons (troque os IDs em Config.Sounds)
---------------------------------------------------------------------
local sounds: { [string]: Sound } = {}
for name, info in Config.Sounds do
	sounds[name] = create("Sound", {
		Name = name,
		SoundId = info.Id,
		Volume = info.Volume,
		PlaybackSpeed = info.Speed,
		SoundGroup = SoundService:FindFirstChild("SFX") :: SoundGroup?, -- volume controlado em SETTINGS
		Parent = SoundService,
	})
end

local function play(name: string)
	local sound = sounds[name]
	if sound then
		SoundService:PlayLocalSound(sound)
	end
end

---------------------------------------------------------------------
-- Tela principal
---------------------------------------------------------------------
-- v21: a tela ignora a barra do Roblox (IgnoreGuiInset): o dinheiro fica coladinho no topo, no meio
-- da barra (que é transparente ali); o resto da tela desce a altura da barra (TOP_INSET) para não
-- ficar embaixo dos botões do Roblox (menu/chat, à esquerda).
local gui = create("ScreenGui", {
	Name = "HUD",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = playerGui,
})
-- a barra nova do Roblox tem ~58 px (o GetGuiInset às vezes ainda diz 36): usa o maior
local TOP_INSET = math.max(58, game:GetService("GuiService"):GetGuiInset().Y)

-- (o chat do Roblox fica no canto de BAIXO, à esquerda: configurado no lugar e no servidor, v21)

-- Dinheiro (topo, bem pequeno: só o valor e a renda)
local cashPanel = create("Frame", {
	Name = "CashPanel",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 3),
	Size = UDim2.fromOffset(236, 52),
	BackgroundColor3 = PANEL,
	BackgroundTransparency = 0.1,
	Parent = gui,
}, { corner(16), border(GOLD, 2.5) })
autoScale(cashPanel)

local cashLabel = label({
	Size = UDim2.new(1, -16, 0.58, 0),
	Position = UDim2.new(0, 8, 0, 2),
	Text = "$0",
	TextColor3 = Color3.fromRGB(120, 255, 120),
	StrokeThickness = 2.5,
	Parent = cashPanel,
})
local incomeLabel = label({
	Size = UDim2.new(1, -16, 0.34, 0),
	Position = UDim2.new(0, 8, 0.6, 0),
	Text = "+$0/s",
	TextColor3 = Color3.fromRGB(255, 230, 120),
	Parent = cashPanel,
})

---------------------------------------------------------------------
-- v21: COLUNA DA ESQUERDA. Todos os avisos, faixas e contagens ficam empilhados no canto de cima,
-- à esquerda (nada grande no meio da tela). Cada item entra aqui com um LayoutOrder:
--   0 shout (avisos grandes)  5 clima  10 comunidade  15 contagem de eventos  20 RIDE  25 objetivo
--   30 evento acontecendo  35 carregando  40 votação  45 invasão  50 ilha  55 vingança
--   60 minigame  70 toasts
-- A coluna inteira tem UM UIScale (os itens NÃO devem ter o seu, senão encolhem duas vezes).
---------------------------------------------------------------------
local STACK_W = 260 -- largura padrão dos itens da coluna (v22: menor)
-- (a janela do chat do Roblox foi para o canto de BAIXO, à esquerda — TextChatService, v21 —
-- então o canto de cima é todo da coluna)
local STACK_Y = TOP_INSET + 4
local leftStack = create("Frame", {
	Name = "LeftStack",
	Position = UDim2.new(0, 8, 0, STACK_Y),
	Size = UDim2.fromOffset(STACK_W + 10, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundTransparency = 1,
	ZIndex = 30, -- por cima das janelas (ex.: batalha)
	Parent = gui,
}, {
	create("UIListLayout", {
		Padding = UDim.new(0, 5),
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}),
})
autoScale(leftStack, 0.9) -- v22: a coluna toda fica 10% menor que o resto da tela

-- Contagem dos eventos (chip pequeno)
local eventStrip = create("Frame", {
	Name = "EventStrip",
	LayoutOrder = 15,
	Size = UDim2.fromOffset(STACK_W, 24),
	BackgroundColor3 = DARK,
	BackgroundTransparency = 0.35,
	ZIndex = 30,
	Parent = leftStack,
}, { corner(9) })
local eventText = label({ Size = UDim2.new(1, -12, 1, -4), Position = UDim2.fromOffset(6, 2), Text = "", TextColor3 = Color3.fromRGB(200, 230, 255), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 31, Parent = eventStrip })

-- Faixas (evento acontecendo / carregando bichinho): pequenas, na coluna da esquerda
local function banner(order: number, color: Color3): (Frame, TextLabel)
	local frame = create("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(STACK_W, 30),
		BackgroundColor3 = color,
		Visible = false,
		ZIndex = 30,
		Parent = leftStack,
	}, { corner(10), border(DARK, 2), shine() })
	local text = label({ Size = UDim2.new(1, -12, 1, -6), Position = UDim2.fromOffset(6, 3), Text = "", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 31, Parent = frame })
	return frame, text
end

local eventBanner, eventBannerText = banner(30, Color3.fromRGB(40, 170, 90))
local carryBanner, carryText = banner(35, ORANGE)
-- v23: trava da base com contagem (segundos trancada / recarga), com barrinha que esvazia
local lockBar = create("Frame", {
	Name = "LockBar",
	LayoutOrder = 28,
	Size = UDim2.fromOffset(STACK_W, 30),
	BackgroundColor3 = Color3.fromRGB(215, 60, 70),
	Visible = false,
	ZIndex = 30,
	Parent = leftStack,
}, { corner(10), border(DARK, 2) })
local lockFill = create("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = WHITE,
	BackgroundTransparency = 0.75,
	BorderSizePixel = 0,
	ZIndex = 30,
	Parent = lockBar,
}, { corner(10) })
local lockText = label({ Size = UDim2.new(1, -12, 1, -6), Position = UDim2.fromOffset(6, 3), Text = "", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 31, Parent = lockBar })

-- Avisos (toasts): cards pequenos no fim da coluna
local toastHolder = create("Frame", {
	Name = "ToastHolder",
	LayoutOrder = 70,
	Size = UDim2.fromOffset(STACK_W, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundTransparency = 1,
	ZIndex = 30,
	Parent = leftStack,
}, {
	create("UIListLayout", {
		Padding = UDim.new(0, 5),
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}),
})

local MAX_TOASTS = 3
local toastCount = 0
local function toast(text: string, kind: string?)
	toastCount += 1
	local color = KIND_COLORS[kind or "info"] or KIND_COLORS.info
	local frame = create("Frame", {
		LayoutOrder = toastCount,
		Size = UDim2.fromOffset(STACK_W, 30),
		BackgroundColor3 = color,
		ZIndex = 30,
		Parent = toastHolder,
	}, { corner(9), border(DARK, 2) })
	local textLabel = label({ Size = UDim2.new(1, -12, 1, -8), Position = UDim2.fromOffset(6, 4), Text = text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 31, Parent = frame })
	UI.popIn(frame)

	local frames = {}
	for _, child in toastHolder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(frames, child)
		end
	end
	if #frames > MAX_TOASTS then
		table.sort(frames, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for i = 1, #frames - MAX_TOASTS do
			frames[i]:Destroy()
		end
	end

	task.delay(3.5, function()
		if not frame.Parent then
			return
		end
		local info = TweenInfo.new(0.4)
		TweenService:Create(frame, info, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(textLabel, info, { TextTransparency = 1 }):Play()
		task.wait(0.45)
		frame:Destroy()
	end)
end

---------------------------------------------------------------------
-- Janelas (loja, índice, rebirth, admin)
---------------------------------------------------------------------
local panels: { [string]: Frame } = {}
local panelOpened: { [string]: () -> () } = {}

local function openPanel(name: string)
	play("Click")
	for panelName, frame in panels do
		if panelName == name then
			frame.Visible = not frame.Visible
			if frame.Visible then
				UI.popIn(frame)
				if panelOpened[panelName] then
					panelOpened[panelName]()
				end
				-- controle de videogame: já seleciona o primeiro botão da janela
				if UserInputService:GetLastInputType().Name:find("Gamepad") then
					task.defer(function()
						for _, descendant in frame:GetDescendants() do
							if descendant:IsA("GuiButton") and descendant.Visible then
								game:GetService("GuiService").SelectedObject = descendant
								break
							end
						end
					end)
				end
			end
		else
			frame.Visible = false
		end
	end
end

local function makePanel(name: string, title: string, color: Color3): (Frame, ScrollingFrame)
	local frame = create("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromOffset(640, 460),
		BackgroundColor3 = PANEL,
		Visible = false,
		ZIndex = 5,
		Parent = gui,
	}, { corner(20), border(color, 4) })
	autoScale(frame)
	local header = create("Frame", {
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = color,
		ZIndex = 5,
		Parent = frame,
	}, { corner(18), shine() })
	label({ Size = UDim2.new(1, -120, 1, -12), Position = UDim2.fromOffset(20, 6), Text = title, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5, Parent = header })
	button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 7),
		Size = UDim2.fromOffset(46, 44),
		BackgroundColor3 = RED,
		ZIndex = 6,
		Parent = header,
	}, "X", function()
		frame.Visible = false
		play("Click")
	end)
	local content = create("ScrollingFrame", {
		Position = UDim2.fromOffset(16, 70),
		Size = UDim2.new(1, -32, 1, -84),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 10,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 5,
		Parent = frame,
	})
	panels[name] = frame
	return frame, content
end

-- Botões do lado direito (longe do joystick do celular), em grade de 2 colunas
-- v20: botões ~20% menores e mais encostados na borda, para cobrir menos o jogo
-- v22: colados no CANTO de cima, à direita, em 2 colunas INTERCALADAS (a coluna de dentro fica meio
-- degrau abaixo, tipo favo de mel) e um pouco menores. A lista de jogadores do Roblox fica escondida
-- para não cobrir os botões (dá para ligar de novo em StarterGui:SetCoreGuiEnabled).
local MENU_CELL = Vector2.new(76, 50)
local MENU_GAP = 5
local menu = create("Frame", {
	Name = "Menu",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -4, 0, TOP_INSET + 4),
	Size = UDim2.fromOffset(MENU_CELL.X * 2 + MENU_GAP, 400),
	BackgroundTransparency = 1,
	Parent = gui,
})
autoScale(menu)
pcall(function()
	game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
end)

-- Arruma os botões visíveis em zigue-zague (menuColumns = 2 no PC, 3 no celular deitado)
local menuColumns = 2
local function layoutMenu()
	local buttons = {}
	for _, child in menu:GetChildren() do
		if child:IsA("GuiButton") and child.Visible then
			table.insert(buttons, child)
		end
	end
	table.sort(buttons, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	local stepX = MENU_CELL.X + MENU_GAP
	local stepY = MENU_CELL.Y + MENU_GAP
	local rows = 0
	for i, btn in buttons do
		local col = (i - 1) % menuColumns
		local row = math.floor((i - 1) / menuColumns)
		rows = math.max(rows, row + 1)
		btn.AnchorPoint = Vector2.new(1, 0)
		btn.Position = UDim2.new(1, -col * stepX, 0, row * stepY + (if col % 2 == 1 then stepY / 2 else 0))
	end
	menu.Size = UDim2.fromOffset(stepX * menuColumns - MENU_GAP, rows * stepY + stepY / 2)
end

-- Botões com ícone grande (emoji) em cima e o nome embaixo
local function menuButton(order: number, icon: string, text: string, color: Color3, onClick: () -> ()): TextButton
	local btn = UI.iconButton({
		LayoutOrder = order,
		Size = UDim2.fromOffset(MENU_CELL.X, MENU_CELL.Y),
		BackgroundColor3 = color,
		Parent = menu,
	}, icon, text, onClick)
	btn:GetPropertyChangedSignal("Visible"):Connect(layoutMenu)
	layoutMenu()
	return btn
end

