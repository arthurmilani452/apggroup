Lang.Text = TEXT

function Lang.Set(lang: string)
	Lang.Current = if TEXT[lang] then lang else "pt"
end

function Lang.T(key: string, args: { [string]: any }?): string
	local text = TEXT[Lang.Current][key] or TEXT.pt[key] or key
	if args then
		text = string.gsub(text, "{(%w+)}", function(name)
			local value = args[name]
			return if value == nil then "{" .. name .. "}" else tostring(value)
		end)
	end
	return text
end

-- Nome de um pet pela chave ("pata:s" -> "Pata Brilhante"; "ovinho:ouro" -> "Ovinho de Ouro")
function Lang.Pet(C: any, key: string): string
	local at = string.find(key, ":", 1, true)
	local id = if at then string.sub(key, 1, at - 1) else key
	local mut = if at then string.sub(key, at + 1) else ""
	if C.SpecialPets[id] then
		return Lang.T("pet." .. id .. "." .. mut)
	end
	local mutation = C.MutationById[mut]
	return Lang.T("pet.name", { bird = Lang.T("bird." .. id), mut = Lang.T("mut." .. (if mutation then mutation.Key else "normal")) })
end

-- Nome de um ovo pela chave ("pata:s" -> "Ovo de Pata Brilhante")
function Lang.Egg(C: any, key: string): string
	local at = string.find(key, ":", 1, true)
	local id = if at then string.sub(key, 1, at - 1) else key
	local mutation = C.MutationById[if at then string.sub(key, at + 1) else ""]
	if not mutation then
		return Lang.T("egg." .. id)
	end
	return Lang.T("egg.name", { egg = Lang.T("egg." .. id), mut = Lang.T("mut." .. mutation.Key) })
end

-- Título e descrição de um botão do tycoon (button = item de Config.Buttons; C = Config; short = Format.Short)
function Lang.Button(C: any, button: any, short: (number) -> string): (string, string)
	local T = Lang.T
	local kind = button.Kind
	local biz = button.Biz and C.Businesses[button.Biz]
	local bizName = if biz then T("biz." .. biz.Id) else ""
	if kind == "unlock" then
		return bizName, T("btn.unlock.d")
	elseif kind == "manager" then
		return T("mgr." .. biz.Id), T("btn.manager.d", { biz = bizName })
	elseif kind == "cash" then
		if button.OfflineHours then
			return T("up." .. button.Id), T("btn.offline.d", { n = button.Cash, h = button.OfflineHours })
		end
		return T("up." .. button.Id), T("btn.cash.d", { biz = bizName, n = button.Cash })
	elseif kind == "speed" then
		return T("up." .. button.Id), T("btn.speed.d", { biz = bizName, n = button.Speed })
	elseif kind == "bird" then
		return T("bird." .. C.Lines[button.Line].Id), T("btn.bird.d", { n = button.Cash })
	end
	if button.Basket then
		return T("btn.basket"), T("btn.basket.d", { n = button.Basket })
	elseif button.Hatch then
		return T("btn.incubator"), T(if kind == "incubator1" then "btn.incubator.d" else "btn.incubator.d2")
	elseif button.Tree then
		return T("btn.tree"), T("btn.tree.d")
	elseif button.Tractor then
		return T("btn.tractor"), T("btn.tractor.d")
	elseif button.SpeedAll then
		return T("btn." .. kind), T("btn.speedall.d", { n = button.SpeedAll })
	elseif button.Cash then
		return T("btn." .. kind), T("btn.allcash.d", { n = button.Cash })
	end
	return kind, ""
end

return Lang
