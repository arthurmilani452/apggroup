	"fabrica_unlock", "fabrica_lavadora", "fabrica_esteira", "fabrica_carimbo", "fabrica_gerente", "ave_codorna", "G_sign", "entrega_expressa", "granja_ninhos", "banca_ouro", "G_tractor",
