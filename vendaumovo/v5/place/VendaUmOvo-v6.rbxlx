    <Item class="Folder" referent="R6974">
      <Properties>
        <string name="Name">Game</string>
      </Properties><Item class="ModuleScript" referent="RNEW900001"><Properties><string name="Name">Bonus</string><ProtectedString name="Source"><![CDATA[--[[
	Bonus (v6): prêmios por tempo jogado nesta visita e emblemas (badges) do Roblox.
	Prêmio por tempo: Config.PlayRewards em escada (5, 10, 20, 35 e 60 min). O relógio é do servidor:
	o atributo PlayStart guarda a hora em que o jogador entrou (workspace:GetServerTimeNow) e PlayClaimed
	quantos degraus já pegou. A tela só mostra a contagem; quem confere o tempo é o servidor.
	Emblemas: Config.Badges (Id = 0 fica desligado). Dar emblema nunca trava o jogo (pcall).
	Título em cima da cabeça: Config.Titles, pelo número de renascimentos (criado no servidor: todos veem).
	Baú do grupo: Config.GroupChest, de graça para quem está no grupo, uma vez a cada Every segundos (salvo).
]]

local BadgeService = game:GetService("BadgeService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Sim = require(ReplicatedStorage.Shared.Sim)
local Registry = require(script.Parent.Registry)

local Bonus = {}

local given: { [Player]: { [string]: boolean } } = {}

function Bonus.Badge(player: Player, key: string)
	local id = tonumber((Config.Badges or {})[key]) or 0
	if id <= 0 or not player.Parent then
		return
	end
	local mine = given[player]
	if not mine then
		mine = {}
		given[player] = mine
	end
	if mine[key] then
		return
	end
	mine[key] = true
	task.spawn(function()
		local ok, has = pcall(BadgeService.UserHasBadgeAsync, BadgeService, player.UserId, id)
		if ok and not has then
			local awarded, err = pcall(BadgeService.AwardBadge, BadgeService, player.UserId, id)
			if not awarded then
				mine[key] = nil -- tenta de novo na próxima vez
				warn("[Bonus] emblema falhou:", key, err)
			end
		end
	end)
end

-- Título em cima da cabeça. Fica acima da etiqueta do VIP quando ela existe.
function Bonus.RefreshTitle(player: Player)
	local data = Registry.Game.Data(player)
	local character = player.Character
	local head = character and (character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart"))
	if not data or not head then
		return
	end
	local title = nil
	for _, def in Config.Titles do
		if (tonumber(data.Rebirths) or 0) >= def.Rebirths then
			title = def
		end
	end
	local richest = player:GetAttribute("Richest") == true
	local gui = head:FindFirstChild("TitleTag") :: BillboardGui?
	if not title and not richest then
		if gui then
			gui:Destroy()
		end
		return
	end
	if not gui then
		local newGui = Instance.new("BillboardGui")
		newGui.Name = "TitleTag"
		newGui.Size = UDim2.fromScale(5, 0.85)
		newGui.MaxDistance = 90
		newGui.LightInfluence = 0
		newGui.Adornee = head
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextStrokeColor3 = Color3.fromRGB(70, 38, 15)
		label.TextStrokeTransparency = 0
		label.Parent = newGui
		newGui.Parent = head
		gui = newGui
	end
	local tag = gui :: BillboardGui
	tag.StudsOffsetWorldSpace = Vector3.new(0, if player:GetAttribute("VIP") then 4.15 else 3.2, 0)
	local seal = Config.Seals[tonumber(data.Seal) or 0]
	local label = tag:FindFirstChild("Text") :: TextLabel
	local text = if title then ("%s · %d"):format(title.Text, data.Rebirths) else "Mais rico do servidor"
	label.Text = if richest then "💰 " .. text else text
	label.TextColor3 = if richest then Color3.fromRGB(255, 215, 60) elseif seal then seal.Color else Color3.fromRGB(255, 250, 230)
end

local function claimGroupChest(player: Player)
	local data = Registry.Game.Data(player)
	if not data or not Registry.Game.Ctx(player).Group then
		return
	end
	local now = os.time()
	local last = tonumber(data.GroupChestAt) or 0
	if now - last < Config.GroupChest.Every then
		Registry.Remotes.NotifyPlayer(player, "n.groupChestWait", nil, "error")
		return
	end
	data.GroupChestAt = now
	local reward = Registry.Game.Reward(player, Config.GroupChest.Seconds, Config.GroupChest.Min, false)
	Registry.Remotes.Fx:FireClient(player, "reward", nil, reward, "group")
end

-- Pega TODAS as caixas de tempo que já abriram (quem volta depois de 30 min pega 5 de uma vez)
local function claimPlay(player: Player)
	local data = Registry.Game.Data(player)
	local start = player:GetAttribute("PlayStart")
	if not data or type(start) ~= "number" then
		return
	end
	local played = workspace:GetServerTimeNow() - start
	local claimed = tonumber(player:GetAttribute("PlayClaimed")) or 0
	local coins, spins, turbo = 0, 0, 0
	while true do
		local step = Config.PlayRewards[claimed + 1]
		if not step or played < step.Minutes * 60 - 1 then
			break
		end
		claimed += 1
		coins += Registry.Game.Reward(player, step.Seconds, step.Min, false)
		spins += step.Spins or 0
		turbo += step.Turbo or 0
	end
	if claimed == (tonumber(player:GetAttribute("PlayClaimed")) or 0) then
		Registry.Remotes.NotifyPlayer(player, "n.playNotYet", nil, "error")
		return
	end
	player:SetAttribute("PlayClaimed", claimed)
	if spins > 0 then
		Sim.AddSpins(Config, data, spins)
		Registry.Remotes.NotifyPlayer(player, "n.playSpins", { n = spins }, "success")
	end
	if turbo > 0 then
		local now = os.time()
		data.Boosts.Turbo = math.max(now, tonumber(data.Boosts.Turbo) or 0) + turbo
		Registry.Remotes.NotifyPlayer(player, "n.playTurbo", { n = math.floor(turbo / 60) }, "success")
	end
	Registry.Game.Push(player)
	Registry.Remotes.Fx:FireClient(player, "reward", nil, coins, "play")
end

function Bonus.Init()
	local function joined(player: Player)
		player:SetAttribute("PlayStart", workspace:GetServerTimeNow())
		player:SetAttribute("PlayClaimed", 0)
		Bonus.Badge(player, "Bemvindo")
		-- título: a cada personagem novo (espera o save carregar) e quando o VIP muda de lugar
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Head", 10)
			for _ = 1, 30 do
				if Registry.Game.Data(player) then
					break
				end
				task.wait(1)
			end
			Bonus.RefreshTitle(player)
		end)
		player:GetAttributeChangedSignal("VIP"):Connect(function()
			Bonus.RefreshTitle(player)
		end)
		if player.Character then
			task.spawn(Bonus.RefreshTitle, player)
		end
	end
	for _, player in Players:GetPlayers() do
		joined(player)
	end
	Players.PlayerAdded:Connect(joined)
	Players.PlayerRemoving:Connect(function(player)
		given[player] = nil
	end)
	-- v6: o jogador com a maior renda por segundo do servidor ganha o 💰 no título (com 2+ jogadores)
	task.spawn(function()
		while true do
			task.wait(15)
			local best, bestIncome = nil, 0
			local players = Players:GetPlayers()
			if #players >= 2 then
				for _, player in players do
					local data = Registry.Game.Data(player)
					if data then
						local ok, income = pcall(Sim.Income, Config, data, Registry.Game.Ctx(player))
						if ok and income > bestIncome then
							best, bestIncome = player, income
						end
					end
				end
			end
			for _, player in players do
				local richest = player == best
				if (player:GetAttribute("Richest") == true) ~= richest then
					player:SetAttribute("Richest", richest)
					Bonus.RefreshTitle(player)
				end
			end
		end
	end)
	Registry.Remotes.On("ClaimPlay", claimPlay, 1)
	Registry.Remotes.On("ClaimGroupChest", claimGroupChest, 2)
end

return Bonus
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RNEW900002"><Properties><string name="Name">Instalar3D</string><ProtectedString name="Source"><![CDATA[--[[
	Instalar3D (v6): coloca no jogo os modelos 3D do Higgsfield, sozinho. Só roda no Studio.

	Como usar:
	  1. Arquivo > Importar 3D e escolha os .glb da pasta higgsfield/modelos (dá para escolher vários).
	     O importador deixa cada um no Workspace com o nome do arquivo (Celeiro_1, Moinho...).
	  2. Na barra de comando do Studio (Exibir > Barra de Comando), cole e aperte Enter:
	         require(game.ServerScriptService.Game.Instalar3D)()
	  3. Pronto. Para cada modelo com nome conhecido, ele:
	       • ancora as peças e ajusta o tamanho para caber no lugar do modelo antigo;
	       • gira 90° se ele estiver "de lado" em relação ao antigo;
	       • cria a peça Root (base, centro) que o jogo usa para posicionar;
	       • guarda o modelo antigo em ServerStorage > Assets_Antigos (para voltar, é só arrastar de volta);
	       • põe o novo em ReplicatedStorage > Assets com o mesmo nome.
	  Dá para desfazer tudo com Ctrl+Z.

	A Roleta fica de fora: a parte que gira tem nome próprio no modelo antigo. Para trocar mesmo assim:
	         require(game.ServerScriptService.Game.Instalar3D)({ Roleta = true })
]]

local ChangeHistoryService = game:GetService("ChangeHistoryService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

-- tamanho do lugar de cada modelo (largura x altura x profundidade, em studs), medido nos modelos antigos
local SIZES: { [string]: Vector3 } = {
	Celeiro_1 = Vector3.new(36.2, 13.6, 31.1),
	Celeiro_2 = Vector3.new(35.7, 12.4, 27.8),
	Celeiro_3 = Vector3.new(39, 13, 31.5),
	Celeiro_4 = Vector3.new(46, 26.6, 14.4),
	Celeiro_5 = Vector3.new(36.1, 23.1, 33.3),
	Chocadeira = Vector3.new(6, 6.5, 6.1),
	Esteira = Vector3.new(3.4, 2.5, 4),
	Garagem = Vector3.new(12.8, 9, 15.6),
	Lampiao = Vector3.new(1.9, 9, 3.8),
	Maquina_Carimbo = Vector3.new(9.1, 9.5, 6),
	Maquina_Embaladora = Vector3.new(10, 9, 8),
	Maquina_Lavadora = Vector3.new(9.2, 9, 7),
	Maquina_Pintora = Vector3.new(9.1, 9.5, 7.1),
	Moinho = Vector3.new(24.6, 32.6, 15.5),
	Ovo_Dourado = Vector3.new(1.2, 1.5, 1.1),
	Pet_Ovinho = Vector3.new(2.3, 2.5, 2),
	Pinheiro = Vector3.new(8.4, 15, 8.4),
	Placa_Neon = Vector3.new(4.9, 10, 1.8),
	Plataforma_Foguete = Vector3.new(18, 20, 18),
	Portal = Vector3.new(23.2, 13.7, 2.9),
	Roleta = Vector3.new(9, 13, 4.6),
}

local function findImported(name: string): Instance?
	for _, place in { workspace, ServerStorage, ReplicatedStorage } do
		local folder = place:FindFirstChild("Higgsfield")
		local found = (folder and folder:FindFirstChild(name)) or place:FindFirstChild(name)
		if found and (found:IsA("Model") or found:IsA("BasePart")) and not found:IsDescendantOf(ReplicatedStorage:FindFirstChild("Assets") or game) then
			return found
		end
	end
	return nil
end

local function install(name: string, imported: Instance, target: Vector3, assets: Instance, backup: Instance): string
	local model: Model
	if imported:IsA("Model") then
		model = imported
	else
		model = Instance.new("Model")
		model.Name = name
		model.Parent = imported.Parent
		imported.Parent = model
	end
	-- um Root antigo (de outra tentativa) atrapalharia a medida
	local oldRoot = model:FindFirstChild("Root")
	if oldRoot then
		oldRoot:Destroy()
	end
	model.PrimaryPart = nil
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanTouch = false
			part.CanQuery = false
		end
	end
	local _, size = model:GetBoundingBox()
	-- de lado? (largo onde o antigo é fundo e vice-versa): gira 90°
	if (size.X > size.Z * 1.25 and target.Z > target.X * 1.25) or (size.Z > size.X * 1.25 and target.X > target.Z * 1.25) then
		model:PivotTo(model:GetPivot() * CFrame.Angles(0, math.rad(90), 0))
		_, size = model:GetBoundingBox()
	end
	-- maior tamanho que ainda cabe no lugar do antigo
	local factor = math.min(target.X / size.X, target.Y / size.Y, target.Z / size.Z)
	if factor > 0 and factor ~= math.huge then
		model:ScaleTo(model:GetScale() * factor)
	end
	-- Root no centro da base, olhando para -Z
	local box, finalSize = model:GetBoundingBox()
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.CastShadow = false
	root.CFrame = CFrame.new(box.Position - Vector3.new(0, finalSize.Y / 2, 0))
	root.Parent = model
	model.PrimaryPart = root
	model.Name = name
	-- o antigo vai para o backup
	local old = assets:FindFirstChild(name)
	if old then
		local previous = backup:FindFirstChild(name)
		if previous then
			previous:Destroy()
		end
		old.Parent = backup
	end
	model:PivotTo(CFrame.new(0, 0, 0))
	model.Parent = assets
	return ("%s: ok (%.1f x %.1f x %.1f)"):format(name, finalSize.X, finalSize.Y, finalSize.Z)
end

return function(options: { [string]: boolean }?)
	if RunService:IsRunning() then
		warn("[Instalar3D] use no Studio com o jogo PARADO (barra de comando), não durante o Play")
		return
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then
		warn("[Instalar3D] não achei ReplicatedStorage > Assets")
		return
	end
	local backup = ServerStorage:FindFirstChild("Assets_Antigos")
	if not backup then
		backup = Instance.new("Folder")
		backup.Name = "Assets_Antigos"
		backup.Parent = ServerStorage
	end
	local okRec, recording = pcall(ChangeHistoryService.TryBeginRecording, ChangeHistoryService, "Instalar modelos 3D")
	if not okRec then
		recording = nil
	end
	local done, missing = {}, {}
	for name, target in SIZES do
		if name == "Roleta" and not (options and options.Roleta) then
			continue
		end
		local imported = findImported(name)
		if imported then
			local ok, result = pcall(install, name, imported, target, assets, backup :: Instance)
			table.insert(done, if ok then result else (name .. ": ERRO " .. tostring(result)))
		else
			table.insert(missing, name)
		end
	end
	if recording then
		pcall(ChangeHistoryService.FinishRecording, ChangeHistoryService, recording, Enum.FinishRecordingOperation.Commit)
	end
	table.sort(done)
	table.sort(missing)
	print(("[Instalar3D] instalados %d:"):format(#done))
	for _, line in done do
		print("   " .. line)
	end
	if #missing > 0 then
		print("[Instalar3D] não achei no Workspace (importe e rode de novo): " .. table.concat(missing, ", "))
	end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RNEW900003"><Properties><string name="Name">Guard</string><ProtectedString name="Source"><![CDATA[--[[
	Guard (v6): anti-teleporte para os prêmios "por chegar perto".
	O personagem é controlado pelo celular/PC do jogador, então um hack consegue teletransportar o boneco.
	A cada 0,2 s o servidor compara onde cada um estava e onde está: um salto maior do que dá para andar
	(com folga para lag, pulo e queda) deixa o jogador "suspeito" por alguns segundos, e nesse tempo os
	prêmios por proximidade (caça aos ovos, obby, ovo surpresa, ovo gigante) não pagam.
	Quando o PRÓPRIO servidor move o jogador (nascer, botão de teleporte), ele chama Guard.Grace antes.
	Sentado (trator, VehicleSeat) não conta: o veículo é mais rápido que andar.
	O obby também exige passar pela largada e levar um tempo mínimo até o baú.
]]

local Players = game:GetService("Players")

local Guard = {}

local SUSPECT_SECONDS = 8
local OBBY_MIN_SECONDS = 8 -- ninguém faz o obby inteiro mais rápido que isso
local OBBY_WINDOW = 600 -- passou pela largada há no máximo 10 min

type Track = { Pos: Vector3?, At: number, Suspect: number, Grace: number, ObbyStart: number }

local tracks: { [Player]: Track } = {}

local function track(player: Player): Track
	local t = tracks[player]
	if not t then
		t = { Pos = nil, At = 0, Suspect = 0, Grace = os.clock() + 5, ObbyStart = 0 }
		tracks[player] = t
	end
	return t
end

-- O servidor vai mover o jogador: não conta como salto suspeito
function Guard.Grace(player: Player, seconds: number?)
	local t = track(player)
	t.Grace = math.max(t.Grace, os.clock() + (seconds or 2))
	t.Pos = nil
end

-- Pode receber prêmio por proximidade agora?
function Guard.Ok(player: Player): boolean
	local t = tracks[player]
	return t ~= nil and os.clock() >= t.Suspect
end

-- Obby: chamado quando o jogador está na largada
function Guard.ObbyStarted(player: Player)
	track(player).ObbyStart = os.clock()
end

-- Obby: chegou no baú de um jeito possível? (passou pela largada, levou um tempo mínimo e não teleportou)
function Guard.ObbyOk(player: Player): boolean
	local t = tracks[player]
	if not t or not Guard.Ok(player) then
		return false
	end
	local since = os.clock() - t.ObbyStart
	return t.ObbyStart > 0 and since >= OBBY_MIN_SECONDS and since <= OBBY_WINDOW
end

function Guard.Init()
	task.spawn(function()
		while true do
			local dt = task.wait(0.2)
			local now = os.clock()
			for _, player in Players:GetPlayers() do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local t = track(player)
				if not root or not humanoid or humanoid.Health <= 0 then
					t.Pos = nil
					continue
				end
				local pos = root.Position
				local flat = Vector3.new(pos.X, 0, pos.Z)
				if humanoid.SeatPart or now < t.Grace then
					t.Pos = flat
					t.At = now
					continue
				end
				if t.Pos then
					local elapsed = math.max(now - t.At, dt, 0.05)
					local maxStep = (humanoid.WalkSpeed * 1.6 + 20) * elapsed + 10
					if (flat - t.Pos).Magnitude > maxStep then
						t.Suspect = now + SUSPECT_SECONDS
					end
				end
				t.Pos = flat
				t.At = now
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		tracks[player] = nil
	end)
end

return Guard
]]></ProtectedString></Properties></Item>
      <Item class="ModuleScript" referent="R6975">
        <Properties>
          <string name="Name">Registry</string>
          <ProtectedString name="Source"><![CDATA[-- Tabela compartilhada para os módulos do servidor se encontrarem (evita require circular).
local Registry: any = {}
return Registry
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="R6976">
        <Properties>
          <string name="Name">Remotes</string>
          <ProtectedString name="Source"><![CDATA[-- Remotes: canais entre servidor e jogadores (todos criados aqui).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Remotes = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local function event(name: string): RemoteEvent
	local e = Instance.new("RemoteEvent")
	e.Name = name
	e.Parent = folder
	return e
end

Remotes.Request = event("Request") -- jogador -> servidor: (ação: string, a, b)
Remotes.State = event("State") -- servidor -> jogador: estado completo (quando algo importante muda)
Remotes.Tick = event("Tick") -- servidor -> jogador: só os números que mudam o tempo todo
Remotes.Notify = event("Notify") -- servidor -> jogador(es): (chave do texto, args, tipo)
Remotes.Fx = event("Fx") -- servidor -> jogador(es): efeitos (tipo, posição, valor, extra)

folder.Parent = ReplicatedStorage

function Remotes.NotifyPlayer(player: Player, key: string, args: { [string]: any }?, kind: string?)
	Remotes.Notify:FireClient(player, key, args or {}, kind or "info")
end

function Remotes.NotifyAll(key: string, args: { [string]: any }?, kind: string?)
	Remotes.Notify:FireAllClients(key, args or {}, kind or "info")
end

-- Pedidos do jogador: cada ação tem o próprio limite de tempo.
-- O normal é Config.RequestCooldown (0,25 s). Uma ação pode pedir outro intervalo em Remotes.On:
-- o "Click" da banca passa 0 (sem espera aqui) porque o Farm já conta os cliques por segundo.
local handlers: { [string]: (Player, any, any) -> () } = {}
local intervals: { [string]: number } = {}
local lastRequest: { [Player]: { [string]: number } } = {}

function Remotes.On(action: string, handler: (Player, any, any) -> (), interval: number?)
	handlers[action] = handler
	intervals[action] = if type(interval) == "number" then math.max(0, interval) else nil
end

Remotes.Request.OnServerEvent:Connect(function(player: Player, action: any, a: any, b: any)
	if type(action) ~= "string" then
		return
	end
	local handler = handlers[action]
	if not handler then
		return
	end
	local times = lastRequest[player]
	if not times then
		times = {}
		lastRequest[player] = times
	end
	local now = os.clock()
	local last = times[action]
	if last and now - last < (intervals[action] or Config.RequestCooldown) then
		return
	end
	times[action] = now
	local ok, err = pcall(handler, player, a, b)
	if not ok then
		warn("[Remotes] " .. action .. " falhou:", err)
	end
end)

function Remotes.RemovePlayer(player: Player)
	lastRequest[player] = nil
end

return Remotes
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="R6977">
        <Properties>
          <string name="Name">Data</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Data: salva e carrega o progresso (base segura):
	  • UpdateAsync com trava de sessão (dois servidores nunca mexem nos dados do mesmo jogador)
	  • várias tentativas quando o Roblox falha
	  • salva ao sair, a cada 60 s e quando o servidor fecha
	  • se o carregamento falhar, NÃO salva por cima (o progresso antigo fica seguro)
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Sim = require(ReplicatedStorage.Shared.Sim)

local Data = {}

export type Profile = {
	Data: any,
	CanSave: boolean,
	Saving: boolean,
	Final: boolean,
}

local SESSION_TIMEOUT = 150

local profiles: { [Player]: Profile } = {}
local finalSaving: { [number]: boolean } = {}
local activeSaves = 0

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Data] DataStore indisponível:", result)
	end
end

local function defaultData()
	return Sim.NewData(Config)
end

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

-- Tabelas que ganham chaves novas quando o jogo cresce (estatística nova...)
local NESTED = { Stats = true, Streak = true, Daily = true }

-- Completa o que faltar (versões antigas do save), sem mexer em listas que já existem
local function reconcile(data: any)
	for key, value in defaultData() do
		if data[key] == nil then
			data[key] = value
		elseif NESTED[key] and type(data[key]) == "table" then
			for subKey, subValue in value do
				if data[key][subKey] == nil then
					data[key][subKey] = subValue
				end
			end
		elseif type(value) == "table" and type(data[key]) ~= "table" then
			data[key] = value
		end
	end
	return data
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function lockedByOther(value: any): boolean
	if type(value) ~= "table" or type(value.Session) ~= "table" then
		return false
	end
	local session = value.Session
	return session.JobId ~= game.JobId and os.time() - (tonumber(session.Time) or 0) < SESSION_TIMEOUT
end

function Data.Load(player: Player): Profile
	-- quem saiu e voltou no MESMO servidor espera o save da saída terminar
	local waited = 0
	while finalSaving[player.UserId] and waited < 40 and player.Parent do
		waited += task.wait(0.25)
	end
	local loaded, result = false, nil
	if store then
		-- v6: espera o outro servidor soltar o progresso (até ~40 s) e NUNCA toma a trava de uma sessão viva.
		-- Antes, na 6ª tentativa (~15 s) a trava era tomada à força: se o servidor antigo ainda estava salvando
		-- a saída, o save dele era recusado e o jogador perdia o que fez desde o último save automático.
		-- Sessão morta (servidor caiu) libera sozinha depois de SESSION_TIMEOUT.
		local attempts = 14
		for attempt = 1, attempts do
			if not player.Parent then
				break
			end
			local locked = false
			local ok, err = pcall(function()
				(store :: DataStore):UpdateAsync(keyFor(player), function(old)
					if lockedByOther(old) then
						locked = true
						return nil
					end
					locked = false
					local data = reconcile(if type(old) == "table" then old else defaultData())
					data.Session = { JobId = game.JobId, Time = os.time() }
					result = data
					return data, { player.UserId }
				end)
			end)
			if ok and not locked then
				loaded = true
				break
			end
			if not ok then
				warn(("[Data] Falha ao carregar %s (tentativa %d): %s"):format(player.Name, attempt, tostring(err)))
				if RunService:IsStudio() then
					break
				end
			end
			task.wait(if locked then 3 else 2)
		end
	end
	local profile: Profile = {
		Data = if loaded and result then result else defaultData(),
		CanSave = loaded,
		Saving = false,
		Final = false,
	}
	profiles[player] = profile
	if not loaded then
		warn("[Data] O progresso de " .. player.Name .. " NÃO será salvo nesta sessão.")
	end
	return profile
end

function Data.Get(player: Player): Profile?
	return profiles[player]
end

function Data.ActiveSaves(): number
	return activeSaves
end

function Data.Save(player: Player, isFinal: boolean?): boolean
	local profile = profiles[player]
	if not profile or not profile.CanSave or not store then
		return false
	end
	activeSaves += 1
	if isFinal then
		finalSaving[player.UserId] = true
	end
	local waited = 0
	local limit = if isFinal then 30 else 15
	while profile.Saving and waited < limit do
		waited += task.wait(0.1)
	end
	if profile.Final or not profile.CanSave or (profile.Saving and not isFinal) then
		if isFinal and not profile.Saving then
			finalSaving[player.UserId] = nil
		end
		activeSaves -= 1
		return false
	end
	profile.Saving = true
	if isFinal then
		profile.Final = true
	end
	profile.Data.SaveSeq = (tonumber(profile.Data.SaveSeq) or 0) + 1
	profile.Data.LastSeen = os.time() -- a renda offline conta a partir daqui
	local snapshot = deepCopy(profile.Data)

	local success, lostLock, stale = false, false, false
	for attempt = 1, if isFinal then 5 else 3 do
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(keyFor(player), function(old)
				if lockedByOther(old) then
					lostLock = true
					return nil
				end
				lostLock = false
				if type(old) == "table" and (tonumber(old.SaveSeq) or 0) > snapshot.SaveSeq then
					stale = true -- já existe um save mais novo: nada foi escrito (não conta como "salvou")
					return nil
				end
				stale = false
				snapshot.Session = if isFinal then nil else { JobId = game.JobId, Time = os.time() }
				return snapshot, { player.UserId }
			end)
		end)
		if ok then
			success = not lostLock and not stale
			break
		end
		warn(("[Data] Falha ao salvar %s (tentativa %d): %s"):format(player.Name, attempt, tostring(err)))
		task.wait(1)
	end
	if lostLock then
		profile.CanSave = false
		if player.Parent and not isFinal then
			player:Kick("Seu progresso abriu em outro servidor. Entra de novo.")
		end
	end
	profile.Saving = false
	if isFinal then
		finalSaving[player.UserId] = nil
	end
	activeSaves -= 1
	return success
end

function Data.Remove(player: Player)
	profiles[player] = nil
end

return Data
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="R6978">
        <Properties>
          <string name="Name">Game</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Game: acesso aos dados do jogador, o "contexto" das contas (passes, evento, amigos) e o estado
	que vai para a tela. Todo lugar que muda os dados de alguém chama Game.Push(player) no final.
	Só o SERVIDOR mexe em moedas: o cliente nunca manda valores, só pede ações.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Sim = require(ReplicatedStorage.Shared.Sim)
local Registry = require(script.Parent.Registry)

local Game = {}

local dirtyFull: { [Player]: boolean } = {}
local dirtyTick: { [Player]: boolean } = {}
local dirtySoon: { [Player]: boolean } = {} -- estado completo "sem pressa" (vai junto no próximo segundo)
local owned: { [Player]: { [string]: boolean } } = {} -- game passes desta sessão
local friends: { [Player]: number } = {} -- bônus de amigos (0..1)
local inGroup: { [Player]: boolean } = {}
local policy: { [Player]: any } = {} -- regras do Roblox para o jogador (PolicyService; quem preenche é o Store)

Game.EventSpeed = 1 -- Chuva de Milho muda isto (todos os negócios mais rápidos)
Game.HuntTotal = 0

function Game.Data(player: Player): any?
	if player:GetAttribute("Loaded") ~= true then
		return nil
	end
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

function Game.Owned(player: Player): { [string]: boolean }
	local t = owned[player]
	if not t then
		t = {}
		owned[player] = t
	end
	return t
end

function Game.Ctx(player: Player): any
	return {
		Now = os.time(),
		Owned = owned[player],
		EventSpeed = Game.EventSpeed,
		-- clima do servidor (id): entra no pagamento dos negócios (Sim.Payout) e no relógio dos ovos raros.
		-- O contexto neutro (Sim.BaseCtx) não leva este campo: prêmios e renda offline ignoram o clima.
		Weather = if Registry.Weather then Registry.Weather.Current else nil,
		Friends = friends[player] or 0,
		Group = inGroup[player] == true,
		Premium = player.MembershipType == Enum.MembershipType.Premium, -- v6: +10% (Config.PremiumBonus)
		NoRandom = policy[player] ~= nil and policy[player].NoRandom == true, -- sem prêmio sorteado ligado a compra
	}
end

-- Regras do Roblox para este jogador (o Store consulta o PolicyService ao entrar). info = { NoRandom = boolean }
function Game.SetPolicy(player: Player, info: any)
	policy[player] = info
	Game.Push(player)
end

function Game.HasPass(player: Player, key: string): boolean
	local data = Game.Data(player)
	return data ~= nil and Sim.HasPass(data, Game.Ctx(player), key)
end

function Game.SetupPlayer(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local coins = Instance.new("StringValue")
	coins.Name = "Moedas"
	coins.Value = "0"
	coins.Parent = stats
	local stars = Instance.new("NumberValue")
	stars.Name = "Estrelas"
	stars.Parent = stats
	stats.Parent = player
end

-- Prêmio em "segundos de renda" entregue na hora (missão, evento, encomenda...). Devolve o valor.
function Game.Reward(player: Player, seconds: number, minimum: number?, earned: boolean?): number
	local data = Game.Data(player)
	if not data then
		return 0
	end
	local amount = Sim.Reward(Config, data, Game.Ctx(player), seconds, minimum)
	Sim.AddCoins(data, amount, earned == true)
	Game.Push(player)
	return amount
end

function Game.ApplySpeed(player: Player)
	local data = Game.Data(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if data and humanoid then
		humanoid.WalkSpeed = Sim.WalkSpeed(Config, data, Game.Ctx(player))
	end
end

-- Amigos e grupo (chamadas de internet: sempre com pcall, fora do caminho principal)
function Game.RefreshSocial(player: Player)
	local count = 0
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local ok, isFriend = pcall(function()
				return player:IsFriendsWith(other.UserId)
			end)
			if ok and isFriend then
				count += 1
			end
		end
	end
	if not player.Parent then
		return
	end
	local bonus = math.min(Config.FriendBonusMax, count * Config.FriendBonus)
	if friends[player] ~= bonus then
		friends[player] = bonus
		Game.Push(player)
	end
	if Config.GroupId > 0 and inGroup[player] == nil then
		local ok, member = pcall(function()
			return player:IsInGroup(Config.GroupId)
		end)
		inGroup[player] = ok and member == true
		Game.Push(player)
	end
end

function Game.Push(player: Player)
	dirtyFull[player] = true
end

function Game.PushTick(player: Player)
	dirtyTick[player] = true
end

-- Estado completo sem pressa: para o que muda a cada clique/ciclo mas só aparece em painel (missões,
-- contadores). Junta tudo e manda no máximo uma vez por segundo, em vez de um estado inteiro por clique.
function Game.PushSoon(player: Player)
	dirtySoon[player] = true
end

-- Moedas no chão de cada negócio: sempre uma lista cheia (1..8), 0 onde não tem nada
local function groundList(plot: any): { number }
	local list = {}
	for index in Config.Businesses do
		list[index] = (plot and plot.Run.Ground[index]) or 0
	end
	return list
end

-- Ovos raros esperando nos ninhos (cópia: a lista do run muda enquanto o estado viaja)
local function rareList(plot: any): { any }
	local list = {}
	if plot then
		for i, egg in plot.Run.Rare do
			list[i] = { Line = egg.Line, Slot = egg.Slot, Mut = egg.Mut }
		end
	end
	return list
end

-- Saco de dinheiro no chão do terreno: { Until = hora do servidor em que some, Golden, Spot } ou false
-- (false, não nil: campo nil não viaja, e a tela precisa saber quando o saco saiu)
local function bagInfo(plot: any): any
	local bag = plot and plot.Run.Bag
	if not bag then
		return false
	end
	return { Until = bag.Until or 0, Golden = bag.Golden == true, Spot = bag.Spot }
end

-- Poderes (versão 5): lista na ordem do Config de { Id, Unlocked, ReadyAt, Until }. ReadyAt / Until na
-- hora do servidor (a mesma base dos Boosts: o cliente compara com workspace:GetServerTimeNow());
-- 0 = pronto agora / sem efeito ligado.
local function powerList(data: any, ctx: any, now: number, serverNow: number): { any }
	local list = {}
	for index, def in Config.Powers or {} do
		local info = Sim.PowerInfo(Config, data, ctx, def.Id)
		list[index] = {
			Id = def.Id,
			Unlocked = info.Unlocked,
			ReadyAt = if info.ReadyAt > now then serverNow + (info.ReadyAt - now) else 0,
			Until = if info.Until > now then serverNow + (info.Until - now) else 0,
		}
	end
	return list
end

-- Só o que muda o tempo todo (vai em Remotes.Tick a cada produção)
local function tickSnapshot(player: Player, data: any): any
	local plot = Registry.Plots.Of(player)
	local ctx = Game.Ctx(player)
	local auto, all = Sim.Income(Config, data, ctx)
	return {
		Coins = data.Coins,
		RunEarned = data.RunEarned,
		Auto = auto,
		All = all,
		BasketCount = Sim.BasketCount(data),
		Apples = if plot then plot.Run.Apples else 0,
		GiftLeft = math.max(0, Config.GiftInterval - data.GiftSeconds),
		Mutant = Sim.BestMutantInBasket(Config, data),
		Ground = groundList(plot),
		Tips = if plot then plot.Run.Tips or 0 else 0,
		Rare = rareList(plot),
		Bag = bagInfo(plot),
		-- chaves secretas e Baú Secreto: chaves na mão, quantas abrem o baú, se há uma chave escondida no
		-- terreno agora (true/false, nunca nil: campo nil não viaja) e baús abertos na vida
		Keys = Sim.KeyCount(Config, data),
		KeyNeed = if Config.Keys then Config.Keys.Need else 0,
		Key = plot ~= nil and plot.Run.Key ~= nil,
		Chests = data.Stats.Chests or 0,
	}
end

local function snapshot(player: Player, data: any): any
	local now = os.time()
	local serverNow = workspace:GetServerTimeNow()
	local ctx = Game.Ctx(player)
	local plot = Registry.Plots.Of(player)
	local state = tickSnapshot(player, data)
	local cash, parts = Sim.CashMult(Config, data, ctx)
	local speed = Sim.SpeedMult(Config, data, ctx)
	-- negócios: o que o jogador tem de cada um e quanto rende (Payout = um ciclo com gerente)
	local biz = {}
	for index in Config.Businesses do
		local info = Sim.BizInfo(Config, data, index)
		biz[index] = {
			Unlocked = info.Unlocked,
			Manager = info.Manager,
			Cash = info.Cash,
			Speed = info.Speed,
			Payout = Sim.Payout(Config, data, ctx, index, info, cash),
			Cycle = Sim.CycleTime(Config, data, ctx, index, info, speed),
			Income = Sim.BizIncome(Config, data, ctx, index, info, cash, speed),
			Weather = Sim.WeatherMult(Config, ctx, index), -- o que o clima multiplica aqui agora (1 = nada); Payout e Income já vêm com ele
			Ground = state.Ground[index],
		}
	end
	state.Biz = biz
	state.BizCount = Sim.BizCount(Config, data)
	state.Birds = Sim.BirdCount(Config, data)
	state.Worked = data.Stats.Worked or 0
	state.Bags = data.Stats.Bags or 0 -- sacos de dinheiro pegos na vida
	-- clima do servidor: { Id, Until = hora do servidor em que acaba, Next = id do próximo }
	state.Weather = if Registry.Weather then Registry.Weather.Info() else { Id = "limpo", Until = 0, Next = "limpo" }
	state.Powers = powerList(data, ctx, now, serverNow)
	state.KeysFound = data.Stats.Keys or 0 -- chaves achadas na vida (a dica "procure a chave" some depois de algumas)
	local boosts = {}
	for key, ends in data.Boosts do
		if ends > now then
			boosts[key] = serverNow + (ends - now)
		end
	end
	local passes = {}
	for _, pass in Config.GamePasses do
		passes[pass.Key] = Sim.HasPass(data, ctx, pass.Key)
	end
	local talents = {}
	for _, talent in Config.Talents do
		talents[talent.Id] = Sim.TalentLevel(Config, data, ctx, talent.Id)
	end
	local canStreak, streakDay = Sim.StreakState(data, now)
	local nextSeal = Sim.NextSeal(Config, data)
	local nextButton = Sim.NextButton(Config, data)
	state.Owned = data.Owned
	state.Basket = data.Basket
	state.BasketCap = Sim.BasketCap(Config, data, ctx)
	state.Stars = data.Stars
	state.StarsTotal = data.StarsTotal
	-- v6: Baú do Grupo (os.time em que libera de novo) e se o jogador está no grupo
	state.InGroup = inGroup[player] == true
	state.GroupChestAt = (tonumber(data.GroupChestAt) or 0) + Config.GroupChest.Every
	state.StarsGain = Sim.StarsFor(Config, data)
	-- v6: conquistas já prontas para a tela (degrau, meta, prêmio, valor)
	local achievements = {}
	for _, def in Config.Achievements do
		local done, goal, stars, value = Sim.AchievementInfo(data, def)
		table.insert(achievements, { Id = def.Id, Done = done, Max = #def.Goals, Goal = goal or 0, Stars = stars, Value = value })
	end
	state.Achievements = achievements
	state.FavoriteAsked = data.FavoriteAsked == true
	state.LikeAsked = data.LikeAsked == true
	-- v6: quanto cada caixa de tempo daria agora (a aba Presentes mostra o número certo)
	local playCoins = {}
	for i, step in Config.PlayRewards do
		playCoins[i] = Sim.Reward(Config, data, ctx, step.Seconds, step.Min)
	end
	state.PlayCoins = playCoins
	state.CanRebirth = Sim.CanRebirth(Config, data)
	state.Rebirths = data.Rebirths
	state.Seal = data.Seal
	state.CanEvolve = Sim.CanEvolve(Config, data)
	state.NextSealStars = if nextSeal then nextSeal.Stars else 0
	state.Talents = talents
	state.TalentsBought = data.Talents
	state.Album = data.Album
	state.Cash = cash
	state.CashParts = parts
	state.Speed = speed
	state.Hand = Sim.HandMult(Config, data, ctx)
	state.Luck = Sim.MutationChanceMult(Config, data, ctx)
	state.Passes = passes
	state.Boosts = boosts
	-- loja: compras únicas já feitas, quanto cada produto de moedas daria AGORA (a loja mostra o número
	-- exato antes da compra) e se o giro diário do VIP vira presente fixo para este jogador
	local productCoins = {}
	for _, product in Config.Products do
		if product.Kind ~= "boost" and (product.Seconds or 0) > 0 then
			productCoins[product.Key] = Sim.Reward(Config, data, ctx, product.Seconds, product.Min)
		end
	end
	state.Bought = data.Bought or {}
	state.ProductCoins = productCoins
	state.NoRandom = ctx.NoRandom == true
	state.Daily = data.Daily.List
	state.MissionReward = Sim.Reward(Config, data, ctx, Config.MissionSeconds, Config.MissionMin)
	state.GiftReward = Sim.Reward(Config, data, ctx, Config.GiftSeconds, Config.GiftMin)
	state.StreakCan = canStreak
	state.StreakDay = streakDay
	state.Hunt = Sim.HuntCount(data)
	state.HuntFound = data.Hunt
	state.HuntTotal = Game.HuntTotal
	state.Likes = data.Likes
	state.TotalEarned = data.TotalEarned
	state.OfflinePending = data.OfflinePending
	state.OfflineSeconds = data.OfflineSeconds
	state.Next = if nextButton then nextButton.Id else nil
	state.Plot = if plot then plot.Index else 0
	state.Friends = friends[player] or 0
	state.EventSpeed = Game.EventSpeed
	state.Settings = data.Settings
	state.Buttons = data.Stats.Buttons
	-- pets e chocadeiras
	local hatch = {}
	for slot, item in data.Hatch do
		hatch[slot] = { Key = item.Key, ReadyAt = serverNow + (item.Ready - now), Ready = now >= item.Ready }
	end
	state.Pets = data.Pets
	state.Equip = data.Equip
	state.PetSlots = Sim.PetSlots(Config, data, ctx)
	state.NextPetSlotAt = Sim.NextPetSlotAt(Config, data)
	state.Hatch = hatch
	state.HatchSlots = Sim.HatchSlots(Config, data)
	state.HatchFree = Sim.FreeHatchSlot(Config, data) ~= nil
	state.Hatched = data.Stats.Hatched or 0
	-- roleta, obby e Ovo Gigante
	local spins, spinWait = Sim.SpinState(Config, data, now)
	state.Spins = spins
	state.SpinFreeAt = serverNow + spinWait
	state.ObbyAt = serverNow + math.max(0, (tonumber(data.ObbyAt) or 0) - now)
	state.GiantPity = data.GiantPity or 0
	-- os pets equipados aparecem para todo mundo (o cliente de cada um desenha)
	local equipped = {}
	for i, key in data.Equip do
		if i <= state.PetSlots then
			table.insert(equipped, key .. "=" .. Sim.PetLevel(Config, data, key))
		end
	end
	local petText = table.concat(equipped, ",")
	if player:GetAttribute("Pets") ~= petText then
		player:SetAttribute("Pets", petText)
	end
	return state
end

function Game.Init()
	task.spawn(function()
		local rounds = 0
		while true do
			task.wait(0.2)
			rounds += 1
			if rounds % 5 == 0 then
				for player in dirtySoon do
					dirtySoon[player] = nil
					dirtyFull[player] = true
				end
			end
			for player in dirtyFull do
				dirtyFull[player] = nil
				dirtyTick[player] = nil
				local data = Game.Data(player)
				if data and player.Parent then
					local ok, err = pcall(function()
						local stats = player:FindFirstChild("leaderstats")
						if stats then
							local coins = stats:FindFirstChild("Moedas") :: StringValue
							local stars = stats:FindFirstChild("Estrelas") :: NumberValue
							coins.Value = Format.Short(data.Coins)
							stars.Value = math.floor(data.StarsTotal)
						end
						Registry.Remotes.State:FireClient(player, snapshot(player, data))
					end)
					if not ok then
						warn("[Game] push falhou:", err)
					end
				end
			end
			for player in dirtyTick do
				dirtyTick[player] = nil
				local data = Game.Data(player)
				if data and player.Parent then
					local ok, err = pcall(function()
						local stats = player:FindFirstChild("leaderstats")
						local coins = stats and stats:FindFirstChild("Moedas") :: StringValue
						if coins then
							coins.Value = Format.Short(data.Coins)
						end
						Registry.Remotes.Tick:FireClient(player, tickSnapshot(player, data))
					end)
					if not ok then
						warn("[Game] tick falhou:", err)
					end
				end
			end
		end
	end)
	-- amigos: confere quando alguém entra/sai e de tempos em tempos
	task.spawn(function()
		while true do
			for _, player in Players:GetPlayers() do
				if Game.Data(player) then
					Game.RefreshSocial(player)
				end
			end
			task.wait(45)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		dirtyFull[player] = nil
		dirtyTick[player] = nil
		dirtySoon[player] = nil
		owned[player] = nil
		friends[player] = nil
		inGroup[player] = nil
		policy[player] = nil
	end)
end

return Game
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="R6979">
        <Properties>
          <string name="Name">Weather</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Weather: o CLIMA do servidor (versão 5). Um clima de cada vez, o mesmo para todo mundo; troca sozinho.
	Todo clima só ajuda: faz alguns negócios pagarem mais por ciclo (Config.Weather; regras em Sim.Weather*).

	  • começa "limpo"; depois de Config.Weather.First segundos entra no rodízio (sorteio pelos pesos, nunca
	    o mesmo duas vezes seguidas). O PRÓXIMO clima já fica sorteado: a tela mostra a previsão.
	  • a cada troca: atributos em workspace (Weather = id, WeatherUntil = hora do servidor em que acaba,
	    WeatherNext = id do próximo), Fx "weather" para todos (id, segundos) e estado novo para todos.
	    Quem entra no meio lê os atributos.
	  • Game.Ctx(player).Weather = Weather.Current: é por aí que o clima entra nas contas (Sim.Payout).

	O cliente só DESENHA (céu, chuva, selo nos prédios, chip no topo): quem paga a mais é o servidor.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Sim = require(ReplicatedStorage.Shared.Sim)
local Registry = require(script.Parent.Registry)

local Weather = {}

local START = "limpo" -- clima de quando o servidor liga (se não existir no Config, vale o 1º da lista)

Weather.Current = START :: string -- id do clima de agora
Weather.Next = START :: string -- id do próximo (previsão)
Weather.Until = 0 -- workspace:GetServerTimeNow() em que o clima de agora acaba
-- Rodízio ligado? Com false o clima de agora fica até alguém chamar Weather.Force (os testes automáticos
-- desligam para as contas de moedas não mudarem no meio; no Studio: VUODebug "weather", "stop" / "auto").
Weather.Auto = true

local function defOf(id: any): any?
	return type(id) == "string" and Config.WeatherById[id] or nil
end

-- Publica o clima de agora: atributos (para quem entra depois) + efeito + estado de todo mundo.
local function publish(seconds: number, announce: boolean)
	workspace:SetAttribute("Weather", Weather.Current)
	workspace:SetAttribute("WeatherUntil", Weather.Until)
	workspace:SetAttribute("WeatherNext", Weather.Next)
	if not announce then
		return
	end
	Registry.Remotes.Fx:FireAllClients("weather", nil, Weather.Current, seconds)
	for _, player in Players:GetPlayers() do
		Registry.Game.Push(player)
	end
	-- (o clima muda o PAGAMENTO, não o ritmo: os atributos Rate<i> dos terrenos continuam valendo)
end

-- Entra o clima "def" por "seconds" segundos e já sorteia o seguinte.
local function start(def: any, seconds: number, announce: boolean)
	Weather.Current = def.Id
	Weather.Until = workspace:GetServerTimeNow() + seconds
	Weather.Next = Sim.NextWeather(Config, def.Id, math.random).Id
	publish(seconds, announce)
end

-- Troca para o próximo da previsão (chamado pelo relógio quando o clima de agora acaba).
function Weather.Advance()
	local def = defOf(Weather.Next) or Sim.NextWeather(Config, Weather.Current, math.random)
	start(def, Sim.WeatherSeconds(def, math.random), true)
end

-- Põe um clima AGORA (ferramenta de teste: VUODebug "weather"). Dura o tempo normal dele e depois o
-- rodízio segue (se estiver ligado). false = id que não existe.
function Weather.Force(id: any): boolean
	local def = defOf(id)
	if not def then
		return false
	end
	start(def, Sim.WeatherSeconds(def, math.random), true)
	return true
end

-- O que vai no estado de cada jogador: { Id, Until, Next }
function Weather.Info(): any
	return { Id = Weather.Current, Until = Weather.Until, Next = Weather.Next }
end

function Weather.Init()
	if not Config.Weather or not Config.WeatherById then
		return
	end
	local first = defOf(START) or Config.Weather.List[1]
	start(first, Config.Weather.First, false)
	task.spawn(function()
		while true do
			task.wait(1)
			if Weather.Auto and workspace:GetServerTimeNow() >= Weather.Until then
				local ok, err = pcall(Weather.Advance)
				if not ok then
					warn("[Weather] troca de clima:", err)
					-- não fica tentando a cada segundo: espera um pouco com o clima que está
					Weather.Until = workspace:GetServerTimeNow() + 30
				end
			end
		end
	end)
end

return Weather
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="R6980">
        <Properties>
          <string name="Name">Plots</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Plots: as granjas (terrenos) do mapa. Dá uma para cada jogador, devolve quando ele sai e DESENHA
	o que ele já comprou: prédios dos negócios, gerentes, enfeites das melhorias, cercados das aves,
	esteiras, ovos raros nos ninhos e os botões do chão. E o que ele AINDA NÃO comprou: um "lote
	trancado" (canteiro de obras com placa) no lugar de cada negócio fechado, para o terreno já mostrar
	o futuro desde o primeiro segundo. De tempos em tempos, o saco de dinheiro que caiu (Plots.SyncBag).
	Versão 5: a chave secreta escondida num canto (Plots.SyncKey) e o Baú Secreto (Plots.SyncChest).

	Cada granja (workspace.Plots.PlotN) vem do build só com o chão, a placa do nome e a peça
	"PlotOrigin" (centro do terreno, na altura do piso). Todo o resto nasce aqui (até a banca, que
	aparece com o botão "banca_unlock") a partir de ReplicatedStorage > Assets, nas posições do módulo
	Layout (coordenadas locais do terreno).

	Plots.Sync(plot) é a peça central: compara o que DEVERIA existir (pelos dados do dono) com o que
	existe e cria/apaga a diferença. Pode chamar quantas vezes quiser.

	O cliente desenha o resto (fregueses, vans, moedas no chão, barras de trabalho) a partir dos
	NOMES em plot.Visuals e dos ATRIBUTOS em plot.Model. Os dois são contrato com o cliente
	(design/V4_SPEC.md, seções 3.1 e 3.2): não mude um sem mudar o outro.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AssetLib = require(ReplicatedStorage.Shared.AssetLib)
local Config = require(ReplicatedStorage.Shared.Config)
local Lang = require(ReplicatedStorage.Shared.Lang)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Sim = require(ReplicatedStorage.Shared.Sim)
local Registry = require(script.Parent.Registry)

local Plots = {}

export type Plot = {
	Index: number,
	Model: Model,
	Origin: CFrame,
	Owner: Player?,
	Visuals: Folder,
	Run: any, -- estado da sessão (Sim.NewRun)
	Available: { any }, -- botões que estão no chão agora
	Hold: { [string]: number },
	Work: { [number]: { Token: number, EndsAt: number, Len: number } }, -- ciclos manuais em andamento
	LastBuy: number,
	LikedBy: { [number]: boolean },
}

local plots: { Plot } = {}
local byPlayer: { [Player]: Plot } = {}

-- cor de cada tipo de botão do chão (o de abrir negócio é o "botão verde" das dicas)
local PAD_COLORS = {
	unlock = Color3.fromRGB(60, 205, 90),
	manager = Color3.fromRGB(175, 110, 255),
	cash = Color3.fromRGB(255, 205, 50),
	speed = Color3.fromRGB(255, 140, 40),
	bird = Color3.fromRGB(255, 110, 190),
	global = Color3.fromRGB(60, 200, 190),
}
local WORK_COLOR = Color3.fromRGB(70, 160, 255) -- o "tapete azul"
local SELL_COLOR = Color3.fromRGB(80, 220, 110)

function Plots.All(): { Plot }
	return plots
end

function Plots.Of(player: Player): Plot?
	return byPlayer[player]
end

-- Ponto do Layout ({x, z, yaw?}) -> CFrame no mundo (y = altura acima do piso)
function Plots.CF(plot: Plot, x: number, z: number, yaw: number?, y: number?): CFrame
	return plot.Origin * CFrame.new(x, y or 0, z) * CFrame.Angles(0, math.rad(yaw or 0), 0)
end

function Plots.Local(plot: Plot, position: Vector3): Vector3
	return plot.Origin:PointToObjectSpace(position)
end

function Plots.RootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Onde fica o botão de cada compra (ponto {x, z} do Layout)
function Plots.ButtonPoint(button: any): { number }
	local kind = button.Kind
	if kind == "unlock" then
		return Layout.Biz[button.Biz].U
	elseif kind == "manager" then
		return Layout.Biz[button.Biz].M
	elseif kind == "cash" then
		return Layout.Biz[button.Biz].C[button.Step]
	elseif kind == "speed" then
		return Layout.Biz[button.Biz].S[button.Step]
	elseif kind == "bird" then
		return Layout.Lines[button.Line].Pad
	end
	return Layout.Global[button.Spot].Button
end

function Plots.SpawnCFrame(plot: Plot): CFrame
	local s = Layout.Spawn
	return Plots.CF(plot, s[1], s[2], 180, 4)
end

-- só escreve o atributo quando o valor mudou (cada escrita vai pela rede para todo mundo)
local function setAttr(inst: Instance, key: string, value: any)
	if inst:GetAttribute(key) ~= value then
		inst:SetAttribute(key, value)
	end
end

local function ownerId(plot: Plot): number
	return if plot.Owner then plot.Owner.UserId else 0
end

-- ---------------------------------------------------------------------------
-- Construtores
-- ---------------------------------------------------------------------------
local function group(name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	return m
end

-- Coloca um asset no ponto {x, z, yaw?, escala?}. collide nil = como o asset veio.
local function place(plot: Plot, parent: Instance, asset: string, point: { number }, scale: number?, collide: boolean?, y: number?): Model?
	local model = AssetLib.Get(asset, scale or point[4])
	if not model then
		return nil
	end
	if collide ~= nil then
		AssetLib.SetCollide(model, collide)
	end
	model:PivotTo(Plots.CF(plot, point[1], point[2], point[3], y))
	model.Parent = parent
	return model
end

-- Disco deitado no chão (botões e tapetes). O cilindro do Roblox tem o eixo em X: por isso o giro.
local function disc(plot: Plot, name: string, point: { number }, diameter: number, height: number, color: Color3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(height, diameter, diameter)
	part.CFrame = Plots.CF(plot, point[1], point[2], 0, height / 2 + 0.02) * CFrame.Angles(0, 0, math.rad(90))
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

local function padKind(button: any): string
	local kind = button.Kind
	if kind == "unlock" or kind == "manager" or kind == "cash" or kind == "speed" or kind == "bird" then
		return kind
	end
	return "global"
end

local function makePad(plot: Plot, button: any): Instance
	local kind = padKind(button)
	local pad = disc(plot, "B_" .. button.Id, Plots.ButtonPoint(button), 5.4, 0.5, PAD_COLORS[kind])
	pad:SetAttribute("ButtonId", button.Id)
	pad:SetAttribute("Cost", button.Cost)
	pad:SetAttribute("OwnerId", ownerId(plot))
	pad:SetAttribute("PadKind", kind)
	CollectionService:AddTag(pad, "VUOButton")
	return pad
end

-- Tapete azul de trabalho: fica no lugar do botão que abriu o negócio, enquanto não tem gerente
local function makeWorkPad(plot: Plot, index: number): Instance
	local pad = disc(plot, "W_" .. Config.Businesses[index].Id, Layout.Biz[index].U, 2 * Config.WorkRadius, 0.3, WORK_COLOR)
	pad.Transparency = 0.35
	pad:SetAttribute("Biz", index)
	pad:SetAttribute("OwnerId", ownerId(plot))
	CollectionService:AddTag(pad, "VUOWork")
	return pad
end

local function mutantFx(model: Model, mutation: any)
	local root = model.PrimaryPart
	if not root then
		return
	end
	local light = Instance.new("PointLight")
	light.Color = mutation.Color
	local strength = mutation.Index or 1 -- 1 brilhante, 2 gigante, 3 mítico
	light.Range = 4 + 2 * strength
	light.Brightness = 0.35 * strength * strength
	light.Parent = root
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(mutation.Color)
	sparkle.Size = NumberSequence.new(0.55, 0)
	sparkle.Lifetime = NumberRange.new(0.6, 1.1)
	sparkle.Rate = 2 + 4 * strength
	sparkle.Speed = NumberRange.new(1.5, 3)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.LightEmission = 1
	sparkle.Parent = root
end

-- Ovo solto (ninho/chocadeira/eventos). mutId "" ou nil = normal.
function Plots.MakeEgg(lineIndex: number, mutId: string?): Model?
	local line = Config.Lines[lineIndex]
	if not line then
		return nil
	end
	local mutation = mutId and Config.MutationById[mutId]
	local model = AssetLib.Get(line.EggAsset, if mutation then mutation.Scale else 1)
	if not model then
		return nil
	end
	AssetLib.SetCollide(model, false)
	if mutation then
		mutantFx(model, mutation)
	end
	model:SetAttribute("Mut", mutId or "")
	return model
end

-- Texto num "Letreiro" do asset. key = chave do Lang: o cliente troca o texto pelo idioma do jogador.
local function signText(model: Model?, text: string, key: string?)
	local face = model and AssetLib.Find(model, "Letreiro")
	if not face then
		return
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Gui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.AutoLocalize = false
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeColor3 = Color3.fromRGB(70, 38, 15)
	label.TextStrokeTransparency = 0
	label.Text = text
	label.Parent = gui
	gui.Parent = face
	if key then
		face:SetAttribute("TextKey", key)
		CollectionService:AddTag(face, "VUOText")
	end
end

-- ---------------------------------------------------------------------------
-- Negócios: prédio (Biz_<id>), gerente (Mgr_<id>) e enfeites das melhorias (P_<idDoBotão>)
-- ---------------------------------------------------------------------------
-- A banca: o modelo, o tapete verde de vender ovos raros (atrás do balcão) e a área de clique.
local function buildStand(plot: Plot, m: Model)
	local s = Layout.Stand
	local stand = place(plot, m, "Banca", s)
	if stand then
		signText(stand, Lang.T("stand.sign"), "stand.sign")
		m.PrimaryPart = stand.PrimaryPart
	end
	local sellPad = disc(plot, "SellPad", Layout.Sell, 11, 0.3, SELL_COLOR)
	sellPad.Transparency = 0.5
	sellPad.Parent = m
	-- Caixa invisível em volta da banca: é nela que o clique do mouse/dedo pega (as peças da banca têm
	-- formas demais para clicar bem). O ClickDetector avisa o servidor, que confere distância e ritmo.
	local area = Instance.new("Part")
	area.Name = "ClickArea"
	area.Size = Vector3.new(12, 10, 8)
	area.CFrame = Plots.CF(plot, s[1], s[2], s[3], 5)
	area.Transparency = 1
	area.Anchored = true
	area.CanCollide = false
	area.CanTouch = false
	area.CanQuery = true
	area.CastShadow = false
	local detector = Instance.new("ClickDetector")
	detector.MaxActivationDistance = Config.ClickRadius + 8
	detector.Parent = area
	detector.MouseClick:Connect(function(player: Player)
		local ok, err = pcall(function()
			if Registry.Farm then
				Registry.Farm.Click(player, plot)
			end
		end)
		if not ok then
			warn("[Plots] clique na banca:", err)
		end
	end)
	area.Parent = m
end

-- prédio de cada negócio (a granja são os cercados; a fábrica são a esteira e as máquinas: sem prédio)
local BIZ_ASSET = { entrega = "Garagem", deposito = "Celeiro_1", omeleteria = "Omeleteria", lab = "Laboratorio", foguete = "Plataforma_Foguete" }
local BIZ_SIGN = { omeleteria = "diner.sign", lab = "lab.sign" }

local function buildBiz(plot: Plot, index: number): Instance
	local biz = Config.Businesses[index]
	local m = group("Biz_" .. biz.Id)
	m:SetAttribute("Biz", index)
	CollectionService:AddTag(m, "VUOBiz")
	if biz.Id == "banca" then
		buildStand(plot, m)
		return m
	end
	local asset = BIZ_ASSET[biz.Id]
	if asset then
		-- os prédios têm parede de verdade (os modelos novos vêm sem colisão)
		local model = place(plot, m, asset, Layout.Biz[index].Model, nil, true)
		if model then
			m.PrimaryPart = model.PrimaryPart
			local key = BIZ_SIGN[biz.Id]
			if key then
				signText(model, Lang.T(key), key)
			end
			if biz.Id == "lab" then
				CollectionService:AddTag(model, "VUOSpin") -- o cliente gira a peça "Gira"
			end
		end
	end
	return m
end

-- O gerente parado no posto dele. Na granja o Model fica vazio: o cliente anima um Fazendeiro andando.
local function buildManager(plot: Plot, index: number): Instance
	local biz = Config.Businesses[index]
	local npc = Layout.Biz[index].Npc
	local model: Model? = nil
	if biz.Id ~= "granja" then
		model = AssetLib.Get("Gerente")
		if model then
			AssetLib.SetCollide(model, false)
			model:PivotTo(Plots.CF(plot, npc[1], npc[2], npc[3]))
		end
	end
	local m = model or group("Mgr_" .. biz.Id)
	m:SetAttribute("Biz", index)
	CollectionService:AddTag(m, "VUOManager")
	return m
end

-- Enfeites que não estão no Layout.Props. banca_ouro: dois pedestais com ovo dourado ao lado da banca.
local EXTRA_PROPS: { [string]: (Plot, Model) -> () } = {}

EXTRA_PROPS.banca_ouro = function(plot, m)
	local s = Layout.Stand
	for _, dx in { -11, 11 } do
		local base = Instance.new("Part")
		base.Name = "Pedestal"
		base.Shape = Enum.PartType.Cylinder
		base.Size = Vector3.new(1.6, 3.2, 3.2)
		base.Anchored = true
		base.Material = Enum.Material.Slate
		base.Color = Color3.fromRGB(216, 207, 192)
		base.CFrame = Plots.CF(plot, s[1] + dx, s[2] - 0.5, 0, 0.8) * CFrame.Angles(0, 0, math.rad(90))
		base.Parent = m
		place(plot, m, "Ovo_Dourado", { s[1] + dx, s[2] - 0.5, 0 }, 2.4, false, 1.6)
	end
end

-- estes enfeites são construções: têm colisão (o resto é enfeite leve e fica como o asset veio)
local function propCollides(asset: string): boolean?
	if string.sub(asset, 1, 8) == "Maquina_" or string.sub(asset, 1, 8) == "Celeiro_" or asset == "Galinheiro" then
		return true
	end
	return nil
end

local function hasProps(id: string): boolean
	return Layout.Props[id] ~= nil or EXTRA_PROPS[id] ~= nil
end

local function buildProps(plot: Plot, id: string): Instance
	local m = group("P_" .. id)
	m:SetAttribute("ButtonId", id)
	for _, item in Layout.Props[id] or {} do
		local model = place(plot, m, item.A, item.P, nil, propCollides(item.A), item.Y)
		if model then
			if item.Tag then
				CollectionService:AddTag(model, item.Tag)
			end
			if item.Sign then
				signText(model, Lang.T(item.Sign), item.Sign)
			end
		end
	end
	local extra = EXTRA_PROPS[id]
	if extra then
		extra(plot, m)
	end
	return m
end

-- ---------------------------------------------------------------------------
-- LOTES TRANCADOS (Lot_<id>): canteiro de obras no lugar de cada negócio que ainda não abriu.
-- Posições em Layout.Lots[i] (conferidas no build: longe dos botões e fora das rotas). Feito de peças
-- simples (14 por lote: 8 lotes num terreno novo = 112 peças), nada de asset, para pesar pouco.
-- O jogador ATRAVESSA tudo (fita, postes, caixote e também a placa de madeira): nada ali pode prender
-- ninguém. Os 8 lotes nascem de uma vez ao renascer, com o jogador parado em qualquer lugar do terreno:
-- uma placa com colisão nasceria atravessada no boneco (tranco de física) e ainda puxaria a câmera para
-- perto toda vez que ficasse entre ela e o jogador.
-- O cliente escreve nome, frase e preço numa plaquinha em cima da placa (tag VUOLot).
-- ---------------------------------------------------------------------------
local LOT_COLORS = {
	Dirt = Color3.fromRGB(128, 88, 56), -- terra revolvida
	Mound = Color3.fromRGB(112, 76, 48),
	Post = Color3.fromRGB(36, 36, 42), -- postes pretos + fita amarela = "obra"
	Tape = Color3.fromRGB(255, 208, 40),
	Wood = Color3.fromRGB(184, 128, 76),
	WoodDark = Color3.fromRGB(126, 84, 48),
	Barrel = Color3.fromRGB(255, 122, 40),
}

local function lotPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?, shadow: boolean?): Part
	local part = Instance.new("Part")
	part.Name = name
	if shape then
		part.Shape = shape
	end
	part.Size = size
	part.CFrame = cf
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = shadow == true -- só a placa faz sombra (o resto é miúdo: sombra só custaria)
	part.Material = material
	part.Color = color
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function buildLot(plot: Plot, index: number): Instance
	local biz = Config.Businesses[index]
	local lot = Layout.Lots[index]
	local m = group("Lot_" .. biz.Id)
	m:SetAttribute("Biz", index)
	m:SetAttribute("OwnerId", ownerId(plot))
	CollectionService:AddTag(m, "VUOLot")
	local w, d = lot.Size[1], lot.Size[2]
	local base = Plots.CF(plot, lot.Center[1], lot.Center[2], lot.Center[3])
	local plastic = Enum.Material.SmoothPlastic
	-- chão de terra (um pouco acima do piso e da palha dos cercados, para não piscar)
	lotPart(m, "Chao", Vector3.new(w, 0.16, d), base * CFrame.new(0, 0.11, 0), LOT_COLORS.Dirt, Enum.Material.Ground)
	-- cerquinha: 4 postes e 4 fitas
	for _, corner in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
		lotPart(m, "Poste", Vector3.new(0.6, 2.8, 0.6), base * CFrame.new(corner[1] * w / 2, 1.4, corner[2] * d / 2), LOT_COLORS.Post, plastic)
	end
	for _, side in { -1, 1 } do
		lotPart(m, "Fita", Vector3.new(w, 0.5, 0.16), base * CFrame.new(0, 2.25, side * d / 2), LOT_COLORS.Tape, plastic)
		lotPart(m, "Fita", Vector3.new(0.16, 0.5, d), base * CFrame.new(side * w / 2, 2.25, 0), LOT_COLORS.Tape, plastic)
	end
	-- montinho de terra (bola quase toda enterrada: só aparece a calota), caixote e barril de obra
	lotPart(m, "Monte", Vector3.new(5, 5, 5), Plots.CF(plot, lot.Mound[1], lot.Mound[2], 0, -0.9), LOT_COLORS.Mound, Enum.Material.Ground, Enum.PartType.Ball)
	lotPart(m, "Caixote", Vector3.new(2.2, 2.2, 2.2), Plots.CF(plot, lot.Crate[1], lot.Crate[2], lot.Crate[3], 1.29), LOT_COLORS.Wood, Enum.Material.WoodPlanks)
	-- (o cilindro do Roblox tem o eixo em X: o giro põe o barril de pé)
	lotPart(m, "Barril", Vector3.new(2.6, 1.8, 1.8), Plots.CF(plot, lot.Barrel[1], lot.Barrel[2], 0, 1.49) * CFrame.Angles(0, 0, math.rad(90)), LOT_COLORS.Barrel, plastic, Enum.PartType.Cylinder)
	-- placa de madeira grande, de frente para quem chega (frente = -Z, como os modelos)
	local sign = Plots.CF(plot, lot.Sign[1], lot.Sign[2], lot.Sign[3])
	lotPart(m, "PlacaPoste", Vector3.new(0.7, 4.2, 0.7), sign * CFrame.new(0, 2.1, 0.5), LOT_COLORS.WoodDark, Enum.Material.Wood, nil, true)
	local board = lotPart(m, "Placa", Vector3.new(7.5, 3.4, 0.5), sign * CFrame.new(0, 5.6, 0), LOT_COLORS.Wood, Enum.Material.WoodPlanks, nil, true)
	m.PrimaryPart = board
	-- cadeado pintado na placa (não depende de idioma; o resto do texto é do cliente)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Gui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40 -- (o cadeado ocupa a tábua toda: com menos que isto ficava borrado de perto)
	gui.LightInfluence = 0
	gui.AutoLocalize = false
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = "🔒"
	label.Parent = gui
	gui.Parent = board
	return m
end

-- ---------------------------------------------------------------------------
-- Granja: cercados das aves, placa da próxima ave e esteiras (as esteiras só com a Fábrica aberta)
-- ---------------------------------------------------------------------------
local function buildPen(plot: Plot, index: number): Instance
	local layout = Layout.Lines[index]
	local line = Config.Lines[index]
	local m = group("Pen" .. index)
	m:SetAttribute("Line", index)
	for _, point in layout.Fence do
		place(plot, m, "Cerca", point)
	end
	for slot = 1, Config.BirdsPerPen do
		local nest = place(plot, m, "Ninho", layout.Nests[slot], nil, false)
		if nest then
			nest:SetAttribute("Slot", slot)
		end
		local bird = place(plot, m, line.Asset, layout.Birds[slot], nil, false)
		if bird then
			bird.Name = "Ave"
			bird:SetAttribute("Line", index)
			bird:SetAttribute("Slot", slot)
			bird:SetAttribute("Phase", index * 1.7 + slot * 0.9)
			CollectionService:AddTag(bird, "VUOHen")
		end
	end
	return m
end

-- placa pequena no cercado da ave que já dá para comprar (o cliente escreve o nome e o preço)
local function buildPreview(plot: Plot, index: number): Instance
	local sign = AssetLib.Get("Placa", 0.5)
	if not sign then
		return group("Pen" .. index .. "_preview")
	end
	local point = Layout.Lines[index].Preview
	sign:PivotTo(Plots.CF(plot, point[1], point[2], point[3]))
	sign:SetAttribute("Line", index)
	CollectionService:AddTag(sign, "VUOPreview")
	return sign
end

local function buildBelt(plot: Plot, index: number): Instance
	local layout = Layout.Lines[index]
	local m = group("Belt" .. index)
	m:SetAttribute("Line", index)
	for _, point in layout.Belt do
		place(plot, m, "Esteira", point)
	end
	place(plot, m, "Esteira_Ponta", layout.BeltCap)
	return m
end

local function buildTrunk(plot: Plot, row: number): Instance
	local m = group("Trunk" .. row)
	for _, point in Layout.Trunk[row + 1].Tiles do
		place(plot, m, "Esteira", point)
	end
	return m
end

local function buildTrunkEnds(plot: Plot, maxRow: number): Instance
	local m = group("TrunkEnds" .. maxRow)
	place(plot, m, "Esteira_Ponta", Layout.Trunk[maxRow + 1].Cap)
	place(plot, m, "Esteira_Ponta", Layout.TrunkFront)
	return m
end

-- trecho da frente do tronco (passa pelas máquinas da Fábrica)
local function buildTrunkFront(plot: Plot): Instance
	local m = group("TrunkFront")
	for _, point in Layout.TrunkFrontTiles do
		place(plot, m, "Esteira", point)
	end
	return m
end

-- ---------------------------------------------------------------------------
-- Botões gerais
-- ---------------------------------------------------------------------------
local GLOBAL_BUILDERS: { [string]: (Plot) -> Instance } = {}

GLOBAL_BUILDERS.G_sign = function(plot)
	local m = group("G_sign")
	signText(place(plot, m, "Placa", Layout.Global.sign.Model), Lang.T("title"), "title")
	return m
end

GLOBAL_BUILDERS.G_tree = function(plot)
	local m = group("G_tree")
	local tree = place(plot, m, "Arvore", Layout.Global.tree.Model)
	if tree then
		tree.Name = "Tree"
		tree:SetAttribute("OwnerId", ownerId(plot))
		CollectionService:AddTag(tree, "VUOTree")
	end
	return m
end

GLOBAL_BUILDERS.G_fence = function(plot)
	local m = group("G_fence")
	for _, point in Layout.Perimeter do
		place(plot, m, "Cerca", point)
	end
	return m
end

GLOBAL_BUILDERS.G_windmill = function(plot)
	local m = group("G_windmill")
	local mill = place(plot, m, "Moinho", Layout.Global.windmill.Model)
	if mill then
		CollectionService:AddTag(mill, "VUOWindmill")
	end
	return m
end

-- Chocadeiras (o ovo em cima e o relógio são desenhados pelo SyncHatch / cliente)
for slot = 1, 3 do
	local id = "G_incubator" .. slot
	GLOBAL_BUILDERS[id] = function(plot)
		local m = group(id)
		local model = place(plot, m, "Chocadeira", Layout.Global["inc" .. slot].Model, nil, true)
		if model then
			model.Name = "Chocadeira"
			model:SetAttribute("Slot", slot)
			CollectionService:AddTag(model, "VUOIncubator")
		end
		return m
	end
end

local function basketLevel(data: any): number
	local level = 0
	for _, def in Config.GlobalButtons do
		if def.Basket and data.Owned["G_" .. def.Kind] then
			level += 1
		end
	end
	return level
end

-- ---------------------------------------------------------------------------
-- Sync: o que deveria existir agora (nome -> função que constrói)
-- ---------------------------------------------------------------------------
local function desired(plot: Plot, data: any): ({ [string]: () -> Instance }, { any })
	local want: { [string]: () -> Instance } = {}
	-- negócios: prédio, e gerente OU tapete de trabalho (a banca não tem tapete: é no clique)
	for index, biz in Config.Businesses do
		local info = Sim.BizInfo(Config, data, index)
		if info.Unlocked then
			want["Biz_" .. biz.Id] = function()
				return buildBiz(plot, index)
			end
			if info.Manager then
				want["Mgr_" .. biz.Id] = function()
					return buildManager(plot, index)
				end
			elseif index >= 2 then
				want["W_" .. biz.Id] = function()
					return makeWorkPad(plot, index)
				end
			end
		elseif Layout.Lots and Layout.Lots[index] then
			-- negócio fechado: o lote trancado fica no lugar dele (some quando o prédio nasce)
			want["Lot_" .. biz.Id] = function()
				return buildLot(plot, index)
			end
		end
	end
	-- enfeites das melhorias compradas
	for id in data.Owned do
		if hasProps(id) then
			want["P_" .. id] = function()
				return buildProps(plot, id)
			end
		end
	end
	-- aves: cercado; esteira do cercado quando a Fábrica está aberta; placa da próxima ave
	local factory = data.Owned.fabrica_unlock == true
	local maxRow = -1
	for index, line in Config.Lines do
		if Sim.HasBird(Config, data, index) then
			want["Pen" .. index] = function()
				return buildPen(plot, index)
			end
			if factory then
				want["Belt" .. index] = function()
					return buildBelt(plot, index)
				end
				maxRow = math.max(maxRow, Layout.Lines[index].Row)
			end
		elseif index > 1 and Sim.ButtonState(Config, data, "ave_" .. line.Id) == "available" then
			want["Pen" .. index .. "_preview"] = function()
				return buildPreview(plot, index)
			end
		end
	end
	-- tronco da esteira: vai até a fileira mais ao fundo que tem ave
	for row = 0, maxRow do
		want["Trunk" .. row] = function()
			return buildTrunk(plot, row)
		end
	end
	if maxRow >= 0 then
		want["TrunkEnds" .. maxRow] = function()
			return buildTrunkEnds(plot, maxRow)
		end
		want.TrunkFront = function()
			return buildTrunkFront(plot)
		end
	end
	for name, builder in GLOBAL_BUILDERS do
		if data.Owned[name] then
			want[name] = function()
				return builder(plot)
			end
		end
	end
	local level = basketLevel(data)
	if level > 0 then
		want["G_basket" .. level] = function()
			local m = group("G_basket" .. level)
			local p = Layout.Global.basket.Model
			place(plot, m, "Cesta", p, p[4] * (0.7 + 0.3 * level), false)
			return m
		end
	end
	local available = Sim.AvailableButtons(Config, data)
	for _, button in available do
		want["B_" .. button.Id] = function()
			return makePad(plot, button)
		end
	end
	return want, available
end

function Plots.Sync(plot: Plot)
	local owner = plot.Owner
	local data = owner and Registry.Game.Data(owner)
	local want, available = {}, {}
	if data then
		want, available = desired(plot, data)
	end
	for _, child in plot.Visuals:GetChildren() do
		-- ovos raros dos ninhos, ovos das chocadeiras, o saco de dinheiro, a chave secreta e o Baú Secreto
		-- têm o próprio Sync (mudam sem compra nenhuma)
		if string.sub(child.Name, 1, 5) == "Rare_" or string.sub(child.Name, 1, 8) == "HatchEgg" or child.Name == "Bag" or child.Name == "Key" or child.Name == "Chest" then
			continue
		end
		if want[child.Name] then
			want[child.Name] = nil
		else
			child:Destroy()
		end
	end
	for name, builder in want do
		local ok, result = pcall(builder)
		if ok and result then
			result.Name = name
			result.Parent = plot.Visuals
		elseif not ok then
			warn("[Plots] não deu para montar " .. name .. ":", result)
		end
	end
	plot.Available = available
	Plots.SyncRare(plot)
	Plots.SyncBag(plot)
	Plots.SyncKey(plot)
	Plots.SyncChest(plot) -- (aparece quando o dono abre a Granja; some ao renascer, junto com a chave)
	Plots.SyncRates(plot)
	Plots.SyncHatch(plot)
	Plots.RefreshVip(plot) -- o brilho VIP acompanha a banca (some ao renascer, volta quando ela reabre)
	if Registry.Tractor then
		Registry.Tractor.Ensure(plot)
	end
end

-- Ovos raros esperando nos ninhos (plot.Run.Rare): um Model "Rare_<ave>_<ninho>" para cada um
function Plots.SyncRare(plot: Plot)
	local owner = plot.Owner
	local data = owner and Registry.Game.Data(owner)
	local want: { [string]: any } = {}
	if data then
		for _, egg in plot.Run.Rare do
			want[("Rare_%d_%d"):format(egg.Line, egg.Slot)] = egg
		end
	end
	for _, child in plot.Visuals:GetChildren() do
		if string.sub(child.Name, 1, 5) == "Rare_" then
			local egg = want[child.Name]
			if egg and child:GetAttribute("Mut") == egg.Mut then
				want[child.Name] = nil
			else
				child:Destroy()
			end
		end
	end
	for name, egg in want do
		local layout = Layout.Lines[egg.Line]
		local nest = layout and layout.Nests[egg.Slot]
		local model = nest and Plots.MakeEgg(egg.Line, egg.Mut)
		if model then
			model.Name = name
			model:SetAttribute("Line", egg.Line)
			model:SetAttribute("Slot", egg.Slot)
			model:SetAttribute("OwnerId", ownerId(plot))
			CollectionService:AddTag(model, "VUORare")
			model:PivotTo(Plots.CF(plot, nest[1], nest[2], egg.Slot * 40, 0.5))
			model.Parent = plot.Visuals
		end
	end
end

-- Saco de dinheiro (plot.Run.Bag): o Model "Bag" no lugar sorteado (Layout.BagSpots). Atributos para o
-- cliente: Golden (dourado?), Until (hora do servidor em que some), OwnerId, BagId. Sem colisão: quem
-- confere se o dono encostou é o Farm, pela posição. Pode chamar quantas vezes quiser.
function Plots.SyncBag(plot: Plot)
	local owner = plot.Owner
	local data = owner and Registry.Game.Data(owner)
	local bag = if data then plot.Run.Bag else nil
	local old = plot.Visuals:FindFirstChild("Bag")
	if old and (not bag or old:GetAttribute("BagId") ~= bag.Id) then
		old:Destroy()
		old = nil
	end
	if not bag or old then
		return
	end
	-- a hora em que ele some, no relógio que o cliente também tem (carimbada uma vez, quando o saco aparece;
	-- antes de montar o modelo: o Tick leva a mesma hora para a tela mesmo se o asset faltar)
	bag.Until = bag.Until or (workspace:GetServerTimeNow() + bag.Left)
	local B = Config.MoneyBag
	local spot = Layout.BagSpots and Layout.BagSpots[bag.Spot]
	local model = spot and AssetLib.Get("Saco_Dinheiro", if bag.Golden then B.GoldenScale else B.Scale)
	if not model then
		return
	end
	AssetLib.SetCollide(model, false)
	model.Name = "Bag"
	model:SetAttribute("BagId", bag.Id)
	model:SetAttribute("Golden", bag.Golden == true)
	model:SetAttribute("Until", bag.Until)
	model:SetAttribute("OwnerId", ownerId(plot))
	CollectionService:AddTag(model, "VUOBag")
	model:PivotTo(Plots.CF(plot, spot[1], spot[2], (bag.Id * 47) % 360, 0.1))
	model.Parent = plot.Visuals
end

-- ---------------------------------------------------------------------------
-- CHAVE SECRETA e BAÚ SECRETO (versão 5; regras em Sim.KeyTick / Sim.TakeKey / Sim.OpenChest, relógio e
-- coleta no Farm). Como o saco: cada um tem o próprio Sync, e pode chamar quantas vezes quiser.
-- ---------------------------------------------------------------------------
local KEY_SIZE = 1.35 -- tamanho da chave (1 = 2,6 studs de altura); grande o bastante para achar no celular
local KEY_HEIGHT = 2.1 -- altura do meio da chave acima do piso (ela flutua; o cliente gira e faz brilhar)

local function keyPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, shape: Enum.PartType?): Part
	local part = Instance.new("Part")
	part.Name = name
	if shape then
		part.Shape = shape
	end
	part.Size = size
	part.CFrame = cf
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false -- (sombra no chão entregaria o esconderijo de longe)
	part.Material = Enum.Material.Metal
	part.Reflectance = 0.15
	part.Color = color
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- A chave: 5 peças simples (nada de asset). De pé, com a argola em cima e os dois dentes embaixo.
-- PrimaryPart = a haste, no meio do modelo: girar o Model em Y gira a chave em torno dela mesma.
local function buildKey(center: CFrame): Model
	local k = KEY_SIZE
	local gold: Color3 = Config.Keys.Color
	local dark = Color3.new(gold.R * 0.55, gold.G * 0.5, gold.B * 0.35)
	local m = group("Key")
	local shaft = keyPart(m, "Haste", Vector3.new(0.3, 1.5, 0.3) * k, center * CFrame.new(0, -0.15 * k, 0), gold)
	-- argola: disco deitado de frente (o cilindro do Roblox tem o eixo em X: o giro vira o eixo para Z) com um
	-- miolo escuro um pouco mais grosso, que faz as vezes do furo
	local faceZ = CFrame.Angles(0, math.rad(90), 0)
	keyPart(m, "Argola", Vector3.new(0.3, 1.25, 1.25) * k, center * CFrame.new(0, 0.85 * k, 0) * faceZ, gold, Enum.PartType.Cylinder)
	keyPart(m, "Furo", Vector3.new(0.34, 0.6, 0.6) * k, center * CFrame.new(0, 0.85 * k, 0) * faceZ, dark, Enum.PartType.Cylinder)
	keyPart(m, "Dente", Vector3.new(0.55, 0.26, 0.3) * k, center * CFrame.new(0.42 * k, -0.77 * k, 0), gold)
	keyPart(m, "Dente", Vector3.new(0.4, 0.26, 0.3) * k, center * CFrame.new(0.35 * k, -0.32 * k, 0), gold)
	m.PrimaryPart = shaft
	return m
end

-- Chave escondida (plot.Run.Key): o Model "Key" no lugar sorteado (Layout.KeySpots). Atributos para o
-- cliente: KeyId (muda a cada chave), OwnerId, Born (hora do servidor em que nasceu: depois de
-- Config.Keys.Hint segundos o cliente faz a chave brilhar forte). Sem colisão e sem consulta: quem confere
-- se o dono chegou perto é o Farm, pela posição.
function Plots.SyncKey(plot: Plot)
	local owner = plot.Owner
	local data = owner and Registry.Game.Data(owner)
	local key = if data then plot.Run.Key else nil
	local old = plot.Visuals:FindFirstChild("Key")
	if old and (not key or old:GetAttribute("KeyId") ~= key.Id) then
		old:Destroy()
		old = nil
	end
	if not key or old then
		return
	end
	-- carimbada uma vez, quando a chave aparece (o cliente conta o tempo da dica a partir daqui)
	key.Born = key.Born or workspace:GetServerTimeNow()
	local spot = Layout.KeySpots and Layout.KeySpots[key.Spot]
	if not spot or not Config.Keys then
		return
	end
	local model = buildKey(Plots.CF(plot, spot[1], spot[2], (key.Id * 67) % 360, KEY_HEIGHT))
	model:SetAttribute("KeyId", key.Id)
	model:SetAttribute("OwnerId", ownerId(plot))
	model:SetAttribute("Born", key.Born)
	CollectionService:AddTag(model, "VUOKey")
	model.Parent = plot.Visuals
end

-- Baú Secreto: o Model "Chest" (asset "Bau") no lugar fixo do terreno (Layout.KeyChest), enquanto o dono
-- tiver as chaves liberadas (Sim.KeysOpen). Atributos para o cliente: OwnerId, Keys (chaves na mão do
-- dono) e Need (quantas abrem). Sem colisão: fica ao lado do portão e nasce com o jogador em qualquer lugar
-- (parede que surge do nada dá tranco no boneco); quem abre é o Farm, pela posição do dono.
function Plots.SyncChest(plot: Plot)
	local owner = plot.Owner
	local data = owner and Registry.Game.Data(owner)
	local point = Layout.KeyChest
	local want = data ~= nil and point ~= nil and Config.Keys ~= nil and Sim.KeysOpen(Config, data)
	local chest = plot.Visuals:FindFirstChild("Chest")
	if not want then
		if chest then
			chest:Destroy()
		end
		return
	end
	if not chest then
		local model = AssetLib.Get("Bau", point[4])
		if not model then
			return
		end
		AssetLib.SetCollide(model, false)
		model.Name = "Chest"
		model:PivotTo(Plots.CF(plot, point[1], point[2], point[3]))
		CollectionService:AddTag(model, "VUOChest")
		model.Parent = plot.Visuals
		chest = model
	end
	setAttr(chest, "OwnerId", ownerId(plot))
	setAttr(chest, "Keys", Sim.KeyCount(Config, data))
	setAttr(chest, "Need", Config.Keys.Need)
end

-- Chocadeiras: o ovo em cima de cada uma e os atributos que o cliente usa para o relógio
-- (atributo "Hatch<vaga>" = "chave|hora do servidor em que nasce", ou "" se vazia)
function Plots.SyncHatch(plot: Plot)
	local owner = plot.Owner
	local data = owner and Registry.Game.Data(owner)
	local now = os.time()
	local serverNow = workspace:GetServerTimeNow()
	for slot = 1, 3 do
		local hatch = data and data.Hatch[tostring(slot)]
		local owned = data ~= nil and data.Owned["G_incubator" .. slot] == true
		local value = ""
		if hatch and owned then
			value = ("%s|%d"):format(hatch.Key, math.floor(serverNow + (hatch.Ready - now)))
		end
		local name = "HatchEgg" .. slot
		local old = plot.Visuals:FindFirstChild(name)
		if old and (value == "" or old:GetAttribute("Key") ~= (hatch and hatch.Key)) then
			old:Destroy()
			old = nil
		end
		if value ~= "" and not old and hatch then
			local lineId, mut = Sim.ParseKey(hatch.Key)
			local line = Config.LineById[lineId]
			local egg = line and Plots.MakeEgg(line.Index, mut)
			if egg then
				local point = Layout.Global["inc" .. slot].Model
				egg.Name = name
				egg:SetAttribute("Key", hatch.Key)
				egg:PivotTo(Plots.CF(plot, point[1], point[2], 0, 3.0))
				egg.Parent = plot.Visuals
			end
		end
		setAttr(plot.Model, "Hatch" .. slot, value)
	end
end

-- ---------------------------------------------------------------------------
-- Atributos em plot.Model (seção 3.2 da especificação): o cliente desenha a partir deles
-- ---------------------------------------------------------------------------
-- Ciclo manual: endsAt = workspace:GetServerTimeNow() em que termina (0 = nenhum), len = duração.
-- Guarda também a senha do ciclo (plot.Run.Work[i]) para o SyncRates saber se ele ainda vale.
function Plots.SetWork(plot: Plot, index: number, endsAt: number, len: number)
	local token = plot.Run.Work[index]
	if endsAt > 0 and token ~= nil then
		plot.Work[index] = { Token = token, EndsAt = endsAt, Len = len }
	else
		plot.Work[index] = nil
		endsAt, len = 0, 0
	end
	setAttr(plot.Model, "Work" .. index, endsAt)
	setAttr(plot.Model, "WorkLen" .. index, len)
end

-- Moedas no chão do negócio (0 = nada)
function Plots.SetGround(plot: Plot, index: number, amount: number?)
	setAttr(plot.Model, "Ground" .. index, amount or 0)
end

-- Gorjetas no chão da banca
function Plots.SetTips(plot: Plot, n: number?)
	setAttr(plot.Model, "Tips", n or 0)
end

function Plots.SyncRates(plot: Plot)
	local owner = plot.Owner
	local data = owner and Registry.Game.Data(owner)
	local ctx = owner and Registry.Game.Ctx(owner)
	local model = plot.Model
	local run = plot.Run
	local speed = if data then Sim.SpeedMult(Config, data, ctx) else 1
	for index in Config.Businesses do
		local state, rate = 0, 0
		if data then
			local info = Sim.BizInfo(Config, data, index)
			if info.Unlocked then
				state = if info.Manager then 2 else 1
				rate = 1 / Sim.CycleTime(Config, data, ctx, index, info, speed)
			end
		end
		setAttr(model, "Biz" .. index, state)
		setAttr(model, "Rate" .. index, rate)
		-- ciclo manual: só vale enquanto a senha dele for a que está no run (renascer zera o run)
		local work = plot.Work[index]
		if work and (not data or run.Work[index] ~= work.Token) then
			plot.Work[index] = nil
			work = nil
		end
		setAttr(model, "Work" .. index, if work then work.EndsAt else 0)
		setAttr(model, "WorkLen" .. index, if work then work.Len else 0)
		setAttr(model, "Ground" .. index, if data then run.Ground[index] or 0 else 0)
	end
	local birds, vans, machines, barn = 0, 0, 0, 0
	if data then
		birds = Sim.BirdCount(Config, data)
		if data.Owned.entrega_unlock then
			vans = 1 + (if data.Owned.entrega_van2 then 1 else 0) + (if data.Owned.entrega_van3 then 1 else 0)
		end
		-- as melhorias de dinheiro da Fábrica são as 4 máquinas; as do Depósito são as etapas do celeiro
		machines = Sim.BizInfo(Config, data, Config.BizById.fabrica.Index).CashStep
		local deposit = Sim.BizInfo(Config, data, Config.BizById.deposito.Index)
		if deposit.Unlocked then
			barn = 1 + deposit.CashStep
		end
	end
	setAttr(model, "Tips", if data then run.Tips or 0 else 0)
	setAttr(model, "Birds", birds)
	setAttr(model, "Vans", vans)
	setAttr(model, "Machines", machines)
	setAttr(model, "BarnStage", barn)
	setAttr(model, "Apples", if data then run.Apples else 0)
end

-- O dono tem o passe VIP? (aparece para todo mundo: placa do nome e brilho na banca)
local function ownerVip(plot: Plot): boolean
	local owner = plot.Owner
	return owner ~= nil and Registry.Game.HasPass(owner, "VIP")
end

-- Brilho dourado do VIP em cima da banca (Model "VIPFx" direto no terreno, fora de plot.Visuals: o Sync
-- não mexe nele). Existe enquanto o dono for VIP e a banca estiver aberta. Feito no servidor: todos veem.
function Plots.RefreshVip(plot: Plot)
	local owner = plot.Owner
	local data = owner and Registry.Game.Data(owner)
	local want = data ~= nil and data.Owned.banca_unlock == true and ownerVip(plot)
	setAttr(plot.Model, "VIP", ownerVip(plot))
	local old = plot.Model:FindFirstChild("VIPFx")
	if not want then
		if old then
			old:Destroy()
		end
		return
	end
	if old then
		return
	end
	local color = Config.VIP.Color
	local s = Layout.Stand
	local m = group("VIPFx")
	local part = Instance.new("Part")
	part.Name = "Glow"
	part.Size = Vector3.new(9, 0.4, 5)
	part.CFrame = Plots.CF(plot, s[1], s[2], s[3], 9)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 16
	light.Brightness = 0.9
	light.Parent = part
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(color)
	sparkle.Size = NumberSequence.new(0.7, 0)
	sparkle.Lifetime = NumberRange.new(1, 1.8)
	sparkle.Rate = 8
	sparkle.Speed = NumberRange.new(1, 2.5)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.LightEmission = 1
	sparkle.Parent = part
	-- coroa flutuando em cima da banca
	local gui = Instance.new("BillboardGui")
	gui.Name = "Crown"
	gui.Size = UDim2.fromScale(5, 2.2)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.Adornee = part
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeColor3 = Color3.fromRGB(70, 38, 15)
	label.TextStrokeTransparency = 0
	label.Text = "👑 VIP"
	label.Parent = gui
	gui.Parent = part
	part.Parent = m
	m.Parent = plot.Model
end

function Plots.RefreshSign(plot: Plot)
	local plate = plot.Model:FindFirstChild("NamePlate")
	local sign = plate and plate:FindFirstChild("Sign")
	local gui = sign and sign:FindFirstChildWhichIsA("SurfaceGui")
	local label = gui and gui:FindFirstChildWhichIsA("TextLabel")
	local owner = plot.Owner
	local data = owner and Registry.Game.Data(owner)
	if label then
		if owner then
			-- dono VIP: coroa na frente do nome (é o que os outros jogadores veem ao passar)
			label.Text = ("%s%s\n❤ %d"):format(if ownerVip(plot) then "👑 " else "", owner.DisplayName, if data then data.Likes else 0)
		else
			label.Text = "🥚"
		end
	end
	plot.Model:SetAttribute("OwnerId", if owner then owner.UserId else 0)
	plot.Model:SetAttribute("Seal", if data then data.Seal else 0)
	Plots.RefreshVip(plot)
end

-- ---------------------------------------------------------------------------
function Plots.Assign(player: Player): Plot?
	if byPlayer[player] then
		return byPlayer[player]
	end
	for _, plot in plots do
		if not plot.Owner then
			plot.Owner = player
			byPlayer[player] = plot
			plot.Run = Sim.NewRun()
			plot.Hold = {}
			plot.Work = {}
			plot.LastBuy = 0
			plot.LikedBy = {}
			Plots.RefreshSign(plot)
			Plots.Sync(plot)
			return plot
		end
	end
	return nil
end

function Plots.Release(player: Player)
	local plot = byPlayer[player]
	if not plot then
		return
	end
	byPlayer[player] = nil
	plot.Owner = nil
	-- run novo: os ciclos manuais que ainda estavam esperando (task.delay no Farm) deixam de valer
	plot.Run = Sim.NewRun()
	plot.Available = {}
	plot.Hold = {}
	plot.Work = {}
	for _, child in plot.Visuals:GetChildren() do
		child:Destroy()
	end
	Plots.RefreshSign(plot)
	Plots.SyncRates(plot)
	Plots.SyncHatch(plot)
	if Registry.Tractor then
		Registry.Tractor.Ensure(plot)
	end
end

-- Renascer/Selo: o Sim já zerou o run (moedas no chão, ovos raros, senhas de trabalho); redesenha tudo
function Plots.Reset(plot: Plot)
	plot.Hold = {}
	plot.Work = {}
	Plots.RefreshSign(plot)
	Plots.Sync(plot)
end

function Plots.Init()
	local root = workspace:WaitForChild("Plots")
	local models = root:GetChildren()
	table.sort(models, function(a, b)
		return (a:GetAttribute("Index") or 0) < (b:GetAttribute("Index") or 0)
	end)
	for _, model in models do
		local origin = model:IsA("Model") and model:FindFirstChild("PlotOrigin")
		if not origin or not origin:IsA("BasePart") then
			continue
		end
		local visuals = Instance.new("Folder")
		visuals.Name = "Visuals"
		visuals.Parent = model
		local plot: Plot = {
			Index = model:GetAttribute("Index") or (#plots + 1),
			Model = model :: Model,
			Origin = origin.CFrame,
			Owner = nil,
			Visuals = visuals,
			Run = Sim.NewRun(),
			Available = {},
			Hold = {},
			Work = {},
			LastBuy = 0,
			LikedBy = {},
		}
		-- curtir a granja (só aparece para quem NÃO é o dono; o cliente esconde do dono)
		local plate = model:FindFirstChild("NamePlate")
		local sign = plate and plate:FindFirstChild("Sign")
		if sign then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "Like"
			prompt.ActionText = "👍"
			prompt.ObjectText = "❤"
			prompt.HoldDuration = 0.3
			prompt.MaxActivationDistance = 12
			prompt.RequiresLineOfSight = false
			prompt:SetAttribute("PlotIndex", plot.Index)
			prompt.Parent = sign
			CollectionService:AddTag(prompt, "VUOLike")
			prompt.Triggered:Connect(function(player)
				Registry.Shop.Like(player, plot)
			end)
		end
		table.insert(plots, plot)
		Plots.RefreshSign(plot)
		-- os atributos existem desde o começo (zerados), para o cliente não precisar tratar "nil"
		Plots.SyncRates(plot)
		Plots.SyncHatch(plot)
	end
end

return Plots
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="R6981">
        <Properties>
          <string name="Name">Farm</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Farm: o coração do tycoon.
	  • Produção (a cada Config.TickSeconds): os negócios COM gerente rodam sozinhos (Sim.Tick); caem
	    gorjetas na banca e aparecem ovos raros nos ninhos.
	  • Posição do jogador (a cada Config.PollSeconds): pisou num botão = compra; ficou no tapete azul =
	    trabalha (um ciclo do negócio sem gerente); chegou perto das moedas do chão / gorjetas / ovo raro
	    = pega; atrás do balcão = vende os ovos raros; chocadeira; macieira.
	  • Clique na banca: pelo pedido "Click" (botão VENDER da tela) ou pelo ClickDetector do prédio.
	  • Saco de dinheiro: cai de tempos em tempos num canto do terreno (Sim.BagTick); o dono pega encostando.
	  • Chave secreta (versão 5): nasce escondida num canto (Sim.KeyTick); o dono pega chegando perto e, com
	    as chaves na mão, abre o Baú Secreto chegando ao baú. Nada disso tem pedido do cliente.
	  • Poderes (versão 5): pedido "Power" (botões da tela); o servidor confere tudo (Sim.UsePower).
	Nada depende de Touched, e o cliente nunca manda valores: só a AÇÃO. O servidor olha onde o
	personagem está e faz a conta.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Sim = require(ReplicatedStorage.Shared.Sim)
local Registry = require(script.Parent.Registry)

local Farm = {}

local lastMsg: { [Player]: { [string]: number } } = {}
local clicks: { [Player]: { number } } = {} -- horas (os.clock) dos últimos cliques aceitos de cada jogador

local function throttle(player: Player, key: string, seconds: number): boolean
	local t = lastMsg[player]
	if not t then
		t = {}
		lastMsg[player] = t
	end
	local now = os.clock()
	local last = t[key]
	if last and now - last < seconds then
		return false
	end
	t[key] = now
	return true
end

local function fx(player: Player, kind: string, position: Vector3?, value: any, extra: any)
	Registry.Remotes.Fx:FireClient(player, kind, position, value, extra)
end

-- (definidas mais abaixo, na parte do trabalho na mão)
local startWork: (Player, any, number) -> ()
local finishWork: (Player, any, any, number, number) -> ()

local function flat(ax: number, az: number, bx: number, bz: number): number
	local dx, dz = ax - bx, az - bz
	return math.sqrt(dx * dx + dz * dz)
end

-- ponto {x, z} do Layout -> posição no mundo, y acima do piso
local function at(plot: any, point: { number }, y: number): Vector3
	return Registry.Plots.CF(plot, point[1], point[2], 0, y).Position
end

-- Onde o personagem está, em coordenadas do terreno (nil = sem personagem ou fora da altura da granja)
local function localPosition(player: Player, plot: any): Vector3?
	local root = Registry.Plots.RootOf(player)
	if not root then
		return nil
	end
	local p = Registry.Plots.Local(plot, root.CFrame.Position)
	if math.abs(p.Y) > 14 then
		return nil
	end
	return p
end

-- Depois de qualquer compra/renascer: redesenha a granja, ajusta a velocidade e manda o estado
function Farm.Changed(player: Player, plot: any)
	Registry.Plots.Sync(plot)
	Registry.Game.ApplySpeed(player)
	Registry.Game.Push(player)
end

function Farm.TryBuy(player: Player, plot: any, button: any): boolean
	local data = Registry.Game.Data(player)
	if not data then
		return false
	end
	local ok, reason = Sim.Buy(Config, data, button.Id)
	if not ok then
		if reason == "coins" and throttle(player, "coins", 2.5) then
			fx(player, "nomoney", nil, button.Cost - data.Coins, button.Id)
		end
		return false
	end
	plot.LastBuy = os.clock()
	Registry.Events.GiantAdd(Config.Giant.BuyPoints)
	local position = at(plot, Registry.Plots.ButtonPoint(button), 2)
	Farm.Changed(player, plot)
	Registry.Remotes.Fx:FireAllClients("buy", position, button.Id, player.UserId)
	if button.Kind == "unlock" then
		fx(player, "newbiz", position, button.Biz)
		local bizId = Config.Businesses[button.Biz].Id
		if button.Biz == 2 then
			Registry.Bonus.Badge(player, "Granja")
		elseif bizId == "fabrica" then
			Registry.Bonus.Badge(player, "Fabrica")
		elseif bizId == "foguete" then
			Registry.Bonus.Badge(player, "Foguete")
		end
		-- os primeiros negócios todo mundo abre em minutos: só avisa o servidor a partir do 4º
		if button.Biz >= 4 then
			Registry.Remotes.NotifyAll("n.unlocked", { player = player.DisplayName, biz = Config.Businesses[button.Biz].Id }, "event")
		end
	elseif button.Kind == "manager" then
		fx(player, "manager", position, button.Biz)
		Registry.Bonus.Badge(player, "Gerente")
		-- contratou no meio de um ciclo feito na mão: o ciclo termina agora e paga (o tapete some com o
		-- gerente; não fica um trabalho "fantasma" correndo). A espera antiga perde a senha e não paga de novo.
		local token = plot.Run.Work[button.Biz]
		if token then
			finishWork(player, plot, plot.Run, button.Biz, token)
		end
	elseif button.Kind == "bird" then
		fx(player, "newline", position, button.Line)
		if button.Line >= 5 then
			Registry.Remotes.NotifyAll("n.newbird", { player = player.DisplayName, line = Config.Lines[button.Line].Id }, "event")
		end
	end
	return true
end

-- ---------------------------------------------------------------------------
-- Clique na banca
-- ---------------------------------------------------------------------------
-- Janela deslizante de 1 segundo: no máximo Config.ClickMaxPerSecond cliques em qualquer 1 s.
-- (Um intervalo fixo entre cliques comeria cliques honestos que chegam juntos por atraso da rede.)
local function clickAllowed(player: Player): boolean
	local list = clicks[player]
	if not list then
		list = {}
		clicks[player] = list
	end
	local now = os.clock()
	while list[1] and now - list[1] >= 1 do
		table.remove(list, 1)
	end
	if #list >= Config.ClickMaxPerSecond then
		return false
	end
	table.insert(list, now)
	return true
end

-- Um clique na banca. clickedPlot = terreno do ClickDetector (nil quando vem do botão da tela).
-- Vale para o dono, com a banca aberta, perto dela e dentro do limite de cliques por segundo.
function Farm.Click(player: Player, clickedPlot: any?): boolean
	local plot = Registry.Plots.Of(player)
	local data = Registry.Game.Data(player)
	if not plot or not data or (clickedPlot ~= nil and clickedPlot ~= plot) then
		return false
	end
	if not clickAllowed(player) then
		return false
	end
	local p = localPosition(player, plot)
	local stand = Layout.Stand
	if not p or flat(p.X, p.Z, stand[1], stand[2]) > Config.ClickRadius then
		return false
	end
	local amount = Sim.Click(Config, data, plot.Run, Registry.Game.Ctx(player))
	if amount <= 0 then
		return false
	end
	Registry.Plots.SetGround(plot, 1, plot.Run.Ground[1])
	fx(player, "click", at(plot, Layout.Biz[1].Cash, 1), amount)
	Registry.Events.GiantAdd(Config.Giant.WorkPoints)
	Registry.Game.PushTick(player)
	Registry.Game.PushSoon(player) -- missões e contadores: estado completo, mas sem pressa
	return true
end

-- ---------------------------------------------------------------------------
-- Trabalho na mão (tapete azul dos negócios sem gerente)
-- ---------------------------------------------------------------------------
local function onWorkPad(p: Vector3, index: number): boolean
	local pad = Layout.Biz[index].U
	return flat(p.X, p.Z, pad[1], pad[2]) <= Config.WorkRadius
end

-- O ciclo terminou (chamado pelo task.delay). run/token são os do começo: se o jogador saiu, o terreno
-- mudou de dono ou ele renasceu no meio, a senha não vale mais e nada é pago.
function finishWork(player: Player, plot: any, run: any, index: number, token: number)
	if plot.Owner ~= player or plot.Run ~= run or run.Work[index] ~= token then
		return
	end
	local data = Registry.Game.Data(player)
	if not data then
		return
	end
	local amount = Sim.FinishWork(Config, data, run, Registry.Game.Ctx(player), index, token)
	Registry.Plots.SetWork(plot, index, 0, 0)
	if amount > 0 then
		Registry.Plots.SetGround(plot, index, run.Ground[index])
		fx(player, "workDone", at(plot, Layout.Biz[index].Cash, 1), amount, index)
		Registry.Events.GiantAdd(Config.Giant.WorkPoints)
		Registry.Game.PushTick(player)
		Registry.Game.PushSoon(player)
	end
	-- continua trabalhando sozinho enquanto estiver em cima do tapete
	local p = localPosition(player, plot)
	if p and onWorkPad(p, index) then
		startWork(player, plot, index)
	end
end

function startWork(player: Player, plot: any, index: number)
	local data = Registry.Game.Data(player)
	if not data then
		return
	end
	local run = plot.Run
	local seconds, token = Sim.StartWork(Config, data, run, Registry.Game.Ctx(player), index)
	if not seconds or not token then
		return
	end
	Registry.Plots.SetWork(plot, index, workspace:GetServerTimeNow() + seconds, seconds)
	fx(player, "work", at(plot, Layout.Biz[index].U, 1), index, seconds)
	task.delay(seconds, function()
		local ok, err = pcall(finishWork, player, plot, run, index, token)
		if not ok then
			warn("[Farm] trabalho:", err)
		end
	end)
end

-- ---------------------------------------------------------------------------
-- Saco de dinheiro (regras em Sim.BagTick / Sim.DropBag / Sim.TakeBag; desenho em Plots.SyncBag)
-- ---------------------------------------------------------------------------
-- Onde o saco pode cair AGORA: os lugares do Layout a uma distância boa do dono (nem em cima dele, nem do
-- outro lado do terreno: com o terreno vazio do começo seria uma viagem). Sem personagem, longe do terreno
-- ou sem nenhum lugar nessa faixa: vale qualquer um (devolve só a quantidade).
local function bagSpots(player: Player, plot: any): any
	local spots = Layout.BagSpots or {}
	local p = localPosition(player, plot)
	if not p then
		return #spots
	end
	local near = Config.MoneyBag.Near
	local list = {}
	for index, spot in spots do
		local d = flat(p.X, p.Z, spot[1], spot[2])
		if d >= near[1] and d <= near[2] then
			table.insert(list, index)
		end
	end
	return if #list > 0 then list else #spots
end

-- Um saco acabou de cair (já está em plot.Run.Bag): desenha e avisa o dono (facho de luz, aviso e seta
-- são do cliente; os visitantes veem o saco pelo Model que o servidor criou).
local function bagDropped(owner: Player, plot: any, bag: any)
	Registry.Plots.SyncBag(plot)
	local spot = Layout.BagSpots[bag.Spot]
	fx(owner, "bagDrop", at(plot, spot, 2), bag.Golden == true, Config.MoneyBag.Life)
	Registry.Game.PushTick(owner)
end

-- Faz cair um saco agora (ferramenta de teste do Studio: VUODebug "bag"). golden nil = sorteia.
-- false se não deu (banca fechada, já tem um saco no chão ou o Layout não tem lugares).
function Farm.DropBag(player: Player, plot: any, golden: boolean?): boolean
	local data = Registry.Game.Data(player)
	if not data or not Config.MoneyBag then
		return false
	end
	local bag = Sim.DropBag(Config, data, plot.Run, math.random, bagSpots(player, plot), golden)
	if not bag then
		return false
	end
	bagDropped(player, plot, bag)
	return true
end

-- Um passo do relógio do saco (junto com a produção). Caiu = desenha e avisa o dono; passou do tempo sem
-- ninguém pegar = some, com um "puf" que todos veem (extra = dono, para só a tela DELE dar o aviso).
local function tickBag(owner: Player, plot: any, data: any, dt: number)
	local run = plot.Run
	local kind, bag = Sim.BagTick(Config, data, run, dt, math.random, if run.Bag then 0 else bagSpots(owner, plot))
	if kind == "drop" then
		bagDropped(owner, plot, bag)
	elseif kind == "gone" then
		Registry.Plots.SyncBag(plot)
		local spot = Layout.BagSpots and Layout.BagSpots[bag.Spot]
		if spot then
			Registry.Remotes.Fx:FireAllClients("bagGone", at(plot, spot, 2), bag.Golden == true, owner.UserId)
		end
	end
end

-- ---------------------------------------------------------------------------
-- Chave secreta e Baú Secreto (regras em Sim.KeyTick / Sim.TakeKey / Sim.OpenChest; desenho em
-- Plots.SyncKey / Plots.SyncChest). Mesma arquitetura do saco de dinheiro.
-- ---------------------------------------------------------------------------
-- Onde a chave pode nascer AGORA: qualquer lugar do Layout que não esteja colado no dono (uma chave que
-- nasce aos pés dele seria pega na hora, sem procurar nada). Sem personagem no terreno, ou se todos os
-- lugares estiverem perto (não acontece: são espalhados), vale qualquer um (devolve só a quantidade).
local function keySpots(player: Player, plot: any): any
	local spots = Layout.KeySpots or {}
	local p = localPosition(player, plot)
	if not p then
		return #spots
	end
	local far = 3 * Config.Keys.Radius
	local list = {}
	for index, spot in spots do
		if flat(p.X, p.Z, spot[1], spot[2]) >= far then
			table.insert(list, index)
		end
	end
	return if #list > 0 then list else #spots
end

-- Uma chave acabou de nascer (já está em plot.Run.Key): desenha e avisa SÓ o dono, sem dizer onde
-- (o efeito "keyDrop" vai sem posição de propósito: a graça é procurar).
local function keyDropped(owner: Player, plot: any)
	Registry.Plots.SyncKey(plot)
	fx(owner, "keyDrop")
	Registry.Game.PushTick(owner)
end

-- Faz nascer uma chave agora (ferramenta de teste do Studio: VUODebug "key"). false se não deu (ainda
-- não abriu a Granja, já tem uma chave escondida, já está com todas as chaves na mão ou o Layout não tem lugares).
function Farm.DropKey(player: Player, plot: any): boolean
	local data = Registry.Game.Data(player)
	if not data or not Config.Keys then
		return false
	end
	local key = Sim.DropKey(Config, data, plot.Run, math.random, keySpots(player, plot))
	if not key then
		return false
	end
	keyDropped(player, plot)
	return true
end

-- Um passo do relógio da chave (junto com a produção).
local function tickKey(owner: Player, plot: any, data: any, dt: number)
	local run = plot.Run
	-- (com chave no chão ou as mãos cheias o relógio está parado: nem precisa montar a lista de lugares)
	local waiting = run.Key == nil and Sim.KeyCount(Config, data) < Config.Keys.Need
	local kind = Sim.KeyTick(Config, data, run, dt, math.random, if waiting then keySpots(owner, plot) else 0)
	if kind == "drop" then
		keyDropped(owner, plot)
	elseif kind == "gone" then
		Registry.Plots.SyncKey(plot)
		Registry.Game.PushTick(owner)
	end
end

-- ---------------------------------------------------------------------------
-- Poderes (regras em Sim.UsePower). O cliente só manda QUAL poder; se está liberado e pronto quem diz é
-- o servidor, com a hora do servidor.
-- ---------------------------------------------------------------------------
local POWER_ERRORS = { locked = "n.powerLocked", nonest = "n.powerNoNest" }

-- Usa o poder "id" do jogador. Devolve (true) ou (false, motivo). quiet = não avisa o erro na tela.
function Farm.UsePower(player: Player, id: any, quiet: boolean?): (boolean, string?)
	-- nunca confia no que veio do cliente: precisa ser o id (texto) de um poder que existe
	if type(id) ~= "string" or not Config.PowerById or not Config.PowerById[id] then
		return false, "unknown"
	end
	local data = Registry.Game.Data(player)
	local plot = Registry.Plots.Of(player)
	if not data or not plot then
		return false, "unknown"
	end
	local ctx = Registry.Game.Ctx(player)
	local out, reason = Sim.UsePower(Config, data, plot.Run, ctx, id, math.random)
	if not out then
		if not quiet then
			if reason == "wait" then
				local info = Sim.PowerInfo(Config, data, ctx, id)
				Registry.Remotes.NotifyPlayer(player, "n.powerWait", { s = math.max(1, math.ceil(info.ReadyAt - ctx.Now)) }, "error")
			elseif reason and POWER_ERRORS[reason] then
				Registry.Remotes.NotifyPlayer(player, POWER_ERRORS[reason], nil, "error")
			end
		end
		return false, reason
	end
	-- o efeito de cada poder no mundo (o ovo raro aparece no ninho como qualquer outro)
	if out.Rare then
		Farm.RareSpawned(player, plot, { out.Rare })
	end
	if out.Seconds then
		-- os negócios aceleraram: o ritmo (atributos Rate<i>) muda já, e de novo quando o efeito acabar
		Registry.Plots.SyncRates(plot)
		local run = plot.Run
		task.delay(out.Seconds + 0.6, function()
			if player.Parent and plot.Owner == player and plot.Run == run then
				pcall(Registry.Plots.SyncRates, plot)
				Registry.Game.Push(player)
			end
		end)
	end
	-- todos veem (na banca do dono). extra = { quem usou, moedas pagas (0 = este poder não paga), segundos do
	-- efeito (0 = sem duração), ave e ninho do ovo raro (0 = não é o poder do ovo) }: sempre números, sem
	-- buracos (lista com nil no meio não atravessa o RemoteEvent inteira)
	local stand = Layout.Stand
	Registry.Remotes.Fx:FireAllClients("power", at(plot, stand, 4), id, {
		player.UserId,
		out.Coins or 0,
		out.Seconds or 0,
		if out.Rare then out.Rare.Line else 0,
		if out.Rare then out.Rare.Slot else 0,
	})
	Registry.Game.Push(player)
	return true, nil
end

-- ---------------------------------------------------------------------------
-- Posição do jogador
-- ---------------------------------------------------------------------------
-- v6: moedinhas voando só para quem está perto (antes iam para o servidor todo a cada moeda pega)
local FX_RADIUS = 180
local function fxMoneyNear(position: Vector3, amount: number, ownerId: number)
	for _, other in Players:GetPlayers() do
		local root = Registry.Plots.RootOf(other)
		if other.UserId == ownerId or (root and (root.Position - position).Magnitude <= FX_RADIUS) then
			Registry.Remotes.Fx:FireClient(other, "money", position, amount, ownerId)
		end
	end
end

local function pollPlayer(player: Player, plot: any, dt: number)
	local data = Registry.Game.Data(player)
	if not data then
		return
	end
	local p = localPosition(player, plot)
	if not p then
		return
	end
	local ctx = Registry.Game.Ctx(player)
	local run = plot.Run

	-- botões
	local now = os.clock()
	local standing: { [string]: boolean } = {}
	for _, button in plot.Available do
		local point = Registry.Plots.ButtonPoint(button)
		if flat(p.X, p.Z, point[1], point[2]) <= Config.ButtonRadius then
			standing[button.Id] = true
			local held = (plot.Hold[button.Id] or 0) + dt
			plot.Hold[button.Id] = held
			if held >= Config.ButtonHold and now - plot.LastBuy >= Config.BuyCooldown then
				if Farm.TryBuy(player, plot, button) then
					return -- a lista de botões mudou; continua na próxima volta
				end
			end
		end
	end
	for id in plot.Hold do
		if not standing[id] then
			plot.Hold[id] = nil
		end
	end

	-- trabalhar: em cima do tapete azul de um negócio aberto e sem gerente
	for index = 2, #Config.Businesses do
		if onWorkPad(p, index) and Sim.CanWork(Config, data, run, index) then
			startWork(player, plot, index)
		end
	end

	-- moedas do chão (de cada negócio) e gorjetas (junto das moedas da banca)
	local radius = Sim.CollectRadius(Config, data, ctx)
	local changed = false
	for index in Config.Businesses do
		local cash = Layout.Biz[index].Cash
		if flat(p.X, p.Z, cash[1], cash[2]) <= radius then
			local amount = Sim.CollectGround(Config, data, run, index)
			if amount > 0 then
				Registry.Plots.SetGround(plot, index, 0)
			end
			if index == 1 and (run.Tips or 0) > 0 then
				local tips, n = Sim.CollectTips(Config, data, run, ctx)
				if n > 0 then
					Registry.Plots.SetTips(plot, 0)
					fx(player, "tips", at(plot, cash, 1), tips, n)
					amount += tips
				end
			end
			if amount > 0 then
				fxMoneyNear(at(plot, cash, 3), amount, player.UserId)
				changed = true
			end
		end
	end

	-- saco de dinheiro: encostou, levou. Só o dono (este laço só olha cada jogador no terreno DELE) e com
	-- raio fixo (o Ímã não puxa o saco: a brincadeira é correr até o facho de luz antes que ele suma).
	local bag = run.Bag
	if bag and Config.MoneyBag then
		local spot = Layout.BagSpots and Layout.BagSpots[bag.Spot]
		if spot and flat(p.X, p.Z, spot[1], spot[2]) <= Config.MoneyBag.Radius then
			local amount, taken = Sim.TakeBag(Config, data, run, ctx)
			if taken then
				Registry.Plots.SyncBag(plot)
				Registry.Remotes.Fx:FireAllClients("bagTake", at(plot, spot, 3), amount, { player.UserId, taken.Golden == true })
				changed = true
			end
		end
	end

	-- chave secreta: o dono chegou perto do esconderijo, pegou (raio fixo, como o saco: o Ímã não puxa)
	local key = run.Key
	if key and Config.Keys then
		local spot = Layout.KeySpots and Layout.KeySpots[key.Spot]
		if spot and flat(p.X, p.Z, spot[1], spot[2]) <= Config.Keys.Radius then
			local count, taken = Sim.TakeKey(Config, data, run)
			if taken then
				Registry.Plots.SyncKey(plot)
				Registry.Plots.SyncChest(plot) -- (o baú mostra quantas chaves o dono tem)
				fx(player, "keyTake", at(plot, spot, 3), count, Config.Keys.Need)
				changed = true
			end
		end
	end

	-- Baú Secreto: o dono chegou ao baú com todas as chaves, abriu (gasta as chaves, paga moedas e giros)
	local chest = Layout.KeyChest
	if chest and Config.Keys and Sim.CanOpenChest(Config, data) and flat(p.X, p.Z, chest[1], chest[2]) <= Config.Keys.ChestRadius then
		local out = Sim.OpenChest(Config, data, ctx, math.random)
		if out then
			Registry.Plots.SyncChest(plot)
			Registry.Remotes.Fx:FireAllClients("chestOpen", at(plot, chest, 3), out.Coins, { player.UserId, out.Golden == true, out.Spins })
			changed = true
		end
	end

	-- ovos raros nos ninhos (de trás para frente: PickRare tira o item da lista)
	local full = false
	local picked = false
	for i = #run.Rare, 1, -1 do
		local egg = run.Rare[i]
		local nest = Layout.Lines[egg.Line].Nests[egg.Slot]
		if flat(p.X, p.Z, nest[1], nest[2]) <= radius then
			local key = Sim.PickRare(Config, data, run, ctx, i)
			if key then
				picked = true
				fx(player, "pickRare", at(plot, nest, 2), key)
			else
				full = true
			end
		end
	end
	if picked then
		Registry.Plots.SyncRare(plot)
		changed = true
	end
	if full and throttle(player, "full", 4) then
		Registry.Remotes.NotifyPlayer(player, "n.basketFull", nil, "error")
	end

	-- vender os ovos raros (tapete verde atrás do balcão)
	local sell = Layout.Sell
	if flat(p.X, p.Z, sell[1], sell[2]) <= Config.SellRadius and Sim.BasketCount(data) > 0 and throttle(player, "sell", 0.6) then
		local value, count, fresh = Sim.Sell(Config, data, ctx)
		if count > 0 then
			local position = at(plot, sell, 4)
			fxMoneyNear(position, value, player.UserId)
			fx(player, "sold", position, value, count)
			for _, key in fresh do
				fx(player, "album", position, key)
			end
			Registry.Events.GiantAdd(math.min(Config.Giant.SellMax, count * Config.Giant.SellPoints))
			changed = true
		end
	end

	-- chocadeiras: primeiro pega o pet que já nasceu; senão põe o melhor ovo raro da cesta para chocar
	local slots = Sim.HatchSlots(Config, data)
	if slots > 0 then
		local near = false
		for slot = 1, slots do
			local point = Layout.Incubators[slot]
			if flat(p.X, p.Z, point[1], point[2]) <= Config.IncubatorRadius then
				near = true
				break
			end
		end
		if near and throttle(player, "hatch", 0.5) then
			local today = os.time()
			local slot, key, fresh, level = Sim.ClaimHatch(Config, data, ctx, today)
			if slot and key then
				fx(player, "hatched", at(plot, Layout.Incubators[tonumber(slot) :: number], 5), key, { fresh, level })
				Registry.Events.GiantAdd(Config.Giant.HatchPoints)
				local _, mut = Sim.ParseKey(key)
				local mutation = Config.MutationById[mut]
				if mutation and mutation.Index >= 2 then
					Registry.Remotes.NotifyAll("n.petAll", { player = player.DisplayName, pet = key }, "event")
				end
				Registry.Plots.SyncHatch(plot)
				changed = true
			else
				local startSlot, startKey, seconds = Sim.StartHatch(Config, data, today)
				if startSlot and startKey then
					fx(player, "hatchStart", at(plot, Layout.Incubators[tonumber(startSlot) :: number], 5), startKey, seconds)
					Registry.Plots.SyncHatch(plot)
					changed = true
				end
			end
		end
	end

	-- macieira
	if data.Owned.G_tree and run.Apples > 0 then
		local tree = Layout.Global.tree.Model
		if flat(p.X, p.Z, tree[1], tree[2]) <= 9 then
			local total, apples, golden = Sim.PickApples(Config, data, run, ctx)
			if total > 0 then
				fx(player, "apples", at(plot, tree, 6), total, { apples, golden })
				Registry.Plots.SyncRates(plot)
				changed = true
			end
		end
	end

	if changed then
		Registry.Game.Push(player)
	end
end

-- ---------------------------------------------------------------------------
-- Passes de conveniência (loja em Robux). Tudo acontece AQUI, no laço do servidor, pela posição do
-- personagem: o cliente não manda nada, então não há o que falsificar.
-- ---------------------------------------------------------------------------
-- Dentro do próprio terreno? (Layout.Size = { largura, z da frente, z do fundo })
local function onPlot(p: Vector3): boolean
	local size = Layout.Size
	if not size then
		return true
	end
	return math.abs(p.X) <= size[1] / 2 and p.Z >= size[2] and p.Z <= size[3]
end

local function passPerks(player: Player, plot: any, dt: number)
	local data = Registry.Game.Data(player)
	if not data then
		return
	end
	local ctx = Registry.Game.Ctx(player)
	local run = plot.Run
	local p = localPosition(player, plot)

	-- SuperClique: perto da banca o servidor vende sozinho (Config.SuperClick.PerSecond por segundo).
	-- Cada venda passa pelo Farm.Click de sempre: mesma distância e o MESMO limite de cliques por segundo
	-- de quem clica na mão (clique automático + dedo nunca passam do teto).
	local stand = Layout.Stand
	if p and flat(p.X, p.Z, stand[1], stand[2]) <= Config.ClickRadius then
		for _ = 1, Sim.AutoClicks(Config, data, run, ctx, dt) do
			Farm.Click(player, nil)
		end
	else
		run.AutoAcc = 0
	end

	-- Coletor Automático (passe Ima): de tempos em tempos recolhe o terreno inteiro, de onde ele estiver
	-- na granja: moedas do chão, gorjetas e ovos raros dos ninhos (enquanto couber na cesta).
	if p and onPlot(p) and Sim.HasPass(data, ctx, "Ima") and throttle(player, "autoCollect", Config.AutoCollectEvery) then
		local got = Sim.AutoCollect(Config, data, run, ctx)
		if got then
			for index in got.Ground do
				Registry.Plots.SetGround(plot, index, 0)
			end
			local root = Registry.Plots.RootOf(player)
			local where = if root then root.CFrame.Position else at(plot, Layout.Biz[1].Cash, 3)
			if got.Tips > 0 then
				Registry.Plots.SetTips(plot, 0)
				fx(player, "tips", where, got.TipCoins, got.Tips)
			end
			if got.Coins > 0 then
				fxMoneyNear(where, got.Coins, player.UserId)
			end
			if #got.Eggs > 0 then
				for _, egg in got.Eggs do
					fx(player, "pickRare", at(plot, Layout.Lines[egg.Line].Nests[egg.Slot], 2), egg.Key)
				end
				Registry.Plots.SyncRare(plot)
			end
			Registry.Game.Push(player)
		end
	end
end

-- Junta tudo que está no chão (moedas e gorjetas) sem o jogador andar: antes de sair do jogo, de
-- renascer e de conquistar selo, para o que ele já ganhou não se perder. Devolve o total.
function Farm.Sweep(player: Player): number
	local data = Registry.Game.Data(player)
	local plot = Registry.Plots.Of(player)
	if not data or not plot then
		return 0
	end
	local total = Sim.CollectAllGround(Config, data, plot.Run, Registry.Game.Ctx(player))
	if total > 0 then
		for index in Config.Businesses do
			Registry.Plots.SetGround(plot, index, 0)
		end
		Registry.Plots.SetTips(plot, 0)
	end
	return total
end

-- ---------------------------------------------------------------------------
-- Produção
-- ---------------------------------------------------------------------------
-- Ovos raros acabaram de aparecer nos ninhos (já estão em plot.Run.Rare): desenha e avisa o dono.
function Farm.RareSpawned(owner: Player, plot: any, eggs: { any })
	Registry.Plots.SyncRare(plot)
	for _, egg in eggs do
		fx(owner, "rare", at(plot, Layout.Lines[egg.Line].Nests[egg.Slot], 2), egg.Mut, egg.Line)
		local mutation = Config.MutationById[egg.Mut]
		-- ovo mítico é raro de verdade: conta para o servidor todo (com intervalo, para não virar spam)
		if mutation and mutation.Index >= 3 and throttle(owner, "mythicAll", 90) then
			Registry.Remotes.NotifyAll("n.mythic", { player = owner.DisplayName, line = Config.Lines[egg.Line].Id }, "event")
		end
	end
	Registry.Game.PushTick(owner)
end

local function tickPlot(plot: any, dt: number)
	local owner = plot.Owner
	local data = owner and Registry.Game.Data(owner)
	if not owner or not data then
		return
	end
	local ctx = Registry.Game.Ctx(owner)
	local out = Sim.Tick(Config, data, plot.Run, ctx, dt, math.random)
	if out.Tip then
		Registry.Plots.SetTips(plot, plot.Run.Tips)
		fx(owner, "tipDrop", at(plot, Layout.Biz[1].Cash, 1))
	end
	if #out.Rare > 0 then
		Farm.RareSpawned(owner, plot, out.Rare)
	end
	if out.Apples then
		Registry.Plots.SyncRates(plot)
	end
	-- saco de dinheiro (protegido: um erro no saco não pode parar a produção nem o Tick de quem está jogando)
	if Config.MoneyBag then
		local ok, err = pcall(tickBag, owner, plot, data, dt)
		if not ok then
			warn("[Farm] saco de dinheiro:", err)
		end
	end
	-- chave secreta (protegido pelo mesmo motivo)
	if Config.Keys then
		local ok, err = pcall(tickKey, owner, plot, data, dt)
		if not ok then
			warn("[Farm] chave secreta:", err)
		end
	end
	data.Stats.PlayTime += dt
	Registry.Events.GiantAdd(dt)
	Registry.Game.PushTick(owner)
end

function Farm.Init()
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(Config.TickSeconds)
			local now = os.clock()
			local dt = math.clamp(now - last, 0, 2)
			last = now
			for _, plot in Registry.Plots.All() do
				local ok, err = pcall(tickPlot, plot, dt)
				if not ok then
					warn("[Farm] produção:", err)
				end
			end
		end
	end)

	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(Config.PollSeconds)
			local now = os.clock()
			local dt = math.clamp(now - last, 0, 1)
			last = now
			for _, player in Players:GetPlayers() do
				local plot = Registry.Plots.Of(player)
				if plot then
					local ok, err = pcall(pollPlayer, player, plot, dt)
					if not ok then
						warn("[Farm] posição:", err)
					end
					ok, err = pcall(passPerks, player, plot, dt)
					if not ok then
						warn("[Farm] passes:", err)
					end
				end
			end
		end
	end)

	-- os atributos de ritmo (Rate<i>) acompanham eventos e boosts, que mudam sem compra nenhuma
	task.spawn(function()
		while true do
			task.wait(3)
			for _, plot in Registry.Plots.All() do
				if plot.Owner then
					pcall(Registry.Plots.SyncRates, plot)
				end
			end
		end
	end)

	-- avisa quando um pet nasceu (uma vez por ovo)
	task.spawn(function()
		local told: { [Player]: { [string]: number } } = {}
		while true do
			task.wait(1)
			local now = os.time()
			for _, player in Players:GetPlayers() do
				local data = Registry.Game.Data(player)
				if data then
					local mine = told[player]
					if not mine then
						mine = {}
						told[player] = mine
					end
					for slot, hatch in data.Hatch do
						if now >= hatch.Ready and mine[slot] ~= hatch.Ready then
							mine[slot] = hatch.Ready
							Registry.Remotes.NotifyPlayer(player, "n.hatchReady", nil, "success")
							Registry.Remotes.Fx:FireClient(player, "sound", nil, "Chocar")
							Registry.Game.Push(player)
						end
					end
				end
			end
			for player in told do
				if not player.Parent then
					told[player] = nil
				end
			end
		end
	end)

	-- clique na banca pelo botão da tela. Intervalo 0: quem limita é a janela de cliques por segundo
	-- (o RequestCooldown geral de 0,25 s deixaria só 4 cliques por segundo)
	Registry.Remotes.On("Click", function(player: Player)
		Farm.Click(player, nil)
	end, 0)

	-- poderes: o cliente manda só o id; o servidor confere tipo, se está liberado e a recarga
	Registry.Remotes.On("Power", function(player: Player, id: any)
		Farm.UsePower(player, id)
	end)

	-- comprar de longe (talento/passe): compra o botão mais barato disponível
	Registry.Remotes.On("BuyNext", function(player: Player)
		local data = Registry.Game.Data(player)
		local plot = Registry.Plots.Of(player)
		if not data or not plot then
			return
		end
		if Sim.TalentLevel(Config, data, Registry.Game.Ctx(player), "remote") <= 0 then
			return
		end
		local button = Sim.NextButton(Config, data)
		if button then
			Farm.TryBuy(player, plot, button)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastMsg[player] = nil
		clicks[player] = nil
	end)
end

return Farm
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="R6982">
        <Properties>
          <string name="Name">Shop</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Shop: tudo que o jogador PEDE pela tela (o cliente só pede; o servidor confere e faz):
	renascer, selo, talentos, missões, presente, sequência de dias, códigos, renda offline,
	curtir granja, teleporte e configurações.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Sim = require(ReplicatedStorage.Shared.Sim)
local Registry = require(script.Parent.Registry)

local Shop = {}

local function notify(player: Player, key: string, args: any?, kind: string?)
	Registry.Remotes.NotifyPlayer(player, key, args, kind)
end

local function fx(player: Player, kind: string, value: any, extra: any)
	Registry.Remotes.Fx:FireClient(player, kind, nil, value, extra)
end

local function rebirth(player: Player)
	local data = Registry.Game.Data(player)
	local plot = Registry.Plots.Of(player)
	if not data or not plot then
		return
	end
	-- As moedas que ainda estão no chão também contam para as Estrelas. Confere com elas na conta e só
	-- então junta tudo (se não der para renascer, o chão fica como está: nada de pegar moeda de longe).
	local probe = { SealEarned = data.SealEarned + Sim.GroundTotal(plot.Run), StarsEarned = data.StarsEarned }
	if not Sim.CanRebirth(Config, probe) then
		notify(player, "n.rebirthNotYet", nil, "error")
		return
	end
	Registry.Farm.Sweep(player)
	local ok, gain = Sim.Rebirth(Config, data, plot.Run)
	if not ok then
		notify(player, "n.rebirthNotYet", nil, "error")
		return
	end
	Registry.Plots.Reset(plot)
	Registry.Game.ApplySpeed(player)
	Registry.Game.Push(player)
	fx(player, "rebirth", gain, data.Rebirths)
	Registry.Bonus.Badge(player, "Renasceu")
	Registry.Bonus.RefreshTitle(player)
	Registry.Remotes.NotifyAll("n.rebirth", { player = player.DisplayName, n = data.Rebirths }, "event")
	task.spawn(Registry.Data.Save, player) -- renascer é importante: salva já
end

local function evolve(player: Player)
	local data = Registry.Game.Data(player)
	local plot = Registry.Plots.Of(player)
	if not data or not plot then
		return
	end
	if not Sim.CanEvolve(Config, data) then
		notify(player, "n.sealNotYet", nil, "error")
		return
	end
	-- o Selo zera a granja: o que estava no chão entra antes no total ganho (placar)
	Registry.Farm.Sweep(player)
	if not Sim.Evolve(Config, data, plot.Run) then
		notify(player, "n.sealNotYet", nil, "error")
		return
	end
	Registry.Plots.Reset(plot)
	Registry.Game.ApplySpeed(player)
	Registry.Game.Push(player)
	local seal = Config.Seals[data.Seal]
	fx(player, "seal", data.Seal, seal and seal.Id)
	Registry.Bonus.Badge(player, "Selo")
	Registry.Bonus.RefreshTitle(player)
	Registry.Remotes.NotifyAll("n.seal", { player = player.DisplayName, seal = seal and seal.Id or "" }, "event")
	task.spawn(Registry.Data.Save, player)
end

local function buyTalent(player: Player, id: any)
	local data = Registry.Game.Data(player)
	if not data or type(id) ~= "string" or not Config.TalentById[id] then
		return
	end
	local ok, reason = Sim.BuyTalent(Config, data, id)
	if not ok then
		notify(player, if reason == "max" then "n.talentMax" else "n.noStars", nil, "error")
		return
	end
	Registry.Game.ApplySpeed(player)
	Registry.Game.Push(player)
	fx(player, "sound", "Comprar")
	notify(player, "n.talentUp", { talent = id, level = data.Talents[id] }, "success")
end

local function claimMission(player: Player, index: any)
	local data = Registry.Game.Data(player)
	if not data or type(index) ~= "number" then
		return
	end
	local ctx = Registry.Game.Ctx(player)
	Sim.CheckDaily(Config, data, ctx, os.time())
	local reward = Sim.ClaimMission(Config, data, ctx, index)
	if reward > 0 then
		fx(player, "reward", reward, "mission")
		Registry.Game.Push(player)
	end
end

local function claimGift(player: Player)
	local data = Registry.Game.Data(player)
	if not data then
		return
	end
	local reward = Sim.ClaimGift(Config, data, Registry.Game.Ctx(player))
	if reward > 0 then
		fx(player, "reward", reward, "gift")
		Registry.Game.Push(player)
	end
end

local function claimStreak(player: Player)
	local data = Registry.Game.Data(player)
	if not data then
		return
	end
	local coins, stars, day = Sim.ClaimStreak(Config, data, Registry.Game.Ctx(player), os.time())
	if day > 0 then
		fx(player, "reward", coins, "streak")
		if stars > 0 then
			notify(player, "n.starsGain", { n = stars }, "success")
		end
		Registry.Game.Push(player)
	end
end

local function redeemCode(player: Player, text: any)
	local data = Registry.Game.Data(player)
	if not data or type(text) ~= "string" or #text > 40 then
		return
	end
	local ok, coins, stars = Sim.RedeemCode(Config, data, Registry.Game.Ctx(player), text)
	if not ok then
		notify(player, "n.codeBad", nil, "error")
		return
	end
	fx(player, "reward", coins, "code")
	if stars > 0 then
		notify(player, "n.starsGain", { n = stars }, "success")
	end
	Registry.Game.Push(player)
end

local function claimOffline(player: Player)
	local data = Registry.Game.Data(player)
	if not data then
		return
	end
	local amount = Sim.ClaimOffline(data)
	if amount > 0 then
		fx(player, "reward", amount, "offline")
		Registry.Game.Push(player)
	end
end

-- Curtir a granja de outro jogador (uma vez por dono por servidor).
-- v6: guardado por quem curtiu x dono (antes era por granja e zerava quando o dono saía e voltava:
-- dava para curtir de novo e ganhar o prêmio de novo)
local likedOwners: { [number]: { [number]: boolean } } = {}

function Shop.Like(player: Player, plot: any)
	local owner = plot.Owner
	if not owner or owner == player or plot.LikedBy[player.UserId] then
		return
	end
	local mine = likedOwners[player.UserId]
	if not mine then
		mine = {}
		likedOwners[player.UserId] = mine
	end
	if mine[owner.UserId] then
		return
	end
	local ownerData = Registry.Game.Data(owner)
	if not ownerData or not Registry.Game.Data(player) then
		return
	end
	plot.LikedBy[player.UserId] = true
	mine[owner.UserId] = true
	ownerData.Likes += 1
	Registry.Plots.RefreshSign(plot)
	local reward = Registry.Game.Reward(player, Config.LikeSeconds, 10, false)
	fx(player, "reward", reward, "like")
	notify(owner, "n.liked", { player = player.DisplayName }, "success")
	Registry.Game.Push(owner)
end

-- v6: conquistas
local function claimAchievement(player: Player, id: any)
	local data = Registry.Game.Data(player)
	if not data or type(id) ~= "string" or #id > 30 then
		return
	end
	local stars = Sim.ClaimAchievement(Config, data, id)
	if stars > 0 then
		Registry.Game.ApplySpeed(player)
		Registry.Game.Push(player)
		fx(player, "sound", "Premio")
		notify(player, "n.achievement", { n = stars }, "success")
	end
end

local function teleport(player: Player, where: any)
	local character = player.Character
	local root = Registry.Plots.RootOf(player)
	if not character or not root then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Sit then
		humanoid.Sit = false -- desce do trator antes de teleportar
		task.wait(0.15)
	end
	Registry.Guard.Grace(player, 3) -- teleporte do próprio jogo
	if where == "plaza" then
		local s = Layout.PlazaSpawn
		character:PivotTo(CFrame.new(s[1], 5, s[2]))
	else
		local plot = Registry.Plots.Of(player)
		if plot then
			character:PivotTo(Registry.Plots.SpawnCFrame(plot))
		end
	end
end

-- Pets: equipar, tirar, equipar os melhores
local function equipPet(player: Player, key: any)
	local data = Registry.Game.Data(player)
	if not data or type(key) ~= "string" or #key > 40 then
		return
	end
	if Sim.EquipPet(Config, data, Registry.Game.Ctx(player), key) then
		Registry.Game.Push(player)
	else
		notify(player, "n.petFull", nil, "error")
	end
end

local function unequipPet(player: Player, key: any)
	local data = Registry.Game.Data(player)
	if not data or type(key) ~= "string" or #key > 40 then
		return
	end
	if Sim.UnequipPet(data, key) then
		Registry.Game.Push(player)
	end
end

local function equipBest(player: Player)
	local data = Registry.Game.Data(player)
	if not data then
		return
	end
	Sim.EquipBest(Config, data, Registry.Game.Ctx(player))
	Registry.Game.Push(player)
end

-- Roleta: o servidor sorteia; a tela só gira até o prêmio que veio
local function spin(player: Player)
	local data = Registry.Game.Data(player)
	if not data then
		return
	end
	local index, shown = Sim.Spin(Config, data, Registry.Game.Ctx(player), os.time(), math.random)
	if not index then
		notify(player, "n.noSpins", nil, "error")
		return
	end
	fx(player, "spin", index, shown)
	Registry.Game.Push(player)
end

local ALLOWED_SETTINGS = { Lang = "string", Music = "boolean", Sfx = "boolean", Arrow = "boolean", Light = "boolean", Tutorial = "number" }

local function setSetting(player: Player, key: any, value: any)
	local data = Registry.Game.Data(player)
	if not data or type(key) ~= "string" or ALLOWED_SETTINGS[key] ~= type(value) then
		return
	end
	if key == "Lang" and value ~= "pt" and value ~= "en" then
		return
	end
	-- v6: número tem que ser inteiro e pequeno (NaN ou infinito quebrava o save do próprio jogador)
	if type(value) == "number" and (value ~= value or math.abs(value) > 1e6 or value % 1 ~= 0) then
		return
	end
	data.Settings[key] = value
end

function Shop.Init()
	local on = Registry.Remotes.On
	on("Rebirth", rebirth)
	on("Evolve", evolve)
	on("BuyTalent", buyTalent)
	on("ClaimMission", claimMission)
	on("ClaimGift", claimGift)
	on("ClaimStreak", claimStreak)
	on("RedeemCode", redeemCode)
	on("ClaimOffline", claimOffline)
	on("Teleport", teleport)
	on("EquipPet", equipPet)
	on("UnequipPet", unequipPet)
	on("EquipBest", equipBest)
	on("Spin", spin)
	on("ClaimAchievement", claimAchievement)
	on("FavoriteAsked", function(player: Player)
		local data = Registry.Game.Data(player)
		if data then
			data.FavoriteAsked = true
		end
	end, 5)
	on("LikeAsked", function(player: Player)
		local data = Registry.Game.Data(player)
		if data then
			data.LikeAsked = true
		end
	end, 5)
	on("Setting", setSetting)
	on("Refresh", function(player: Player)
		Registry.Game.Push(player)
	end, 2) -- v6: no máximo a cada 2 s (o estado inteiro é pesado de montar e enviar)

	-- relógio do servidor: tempo do presente e virada do dia das missões
	task.spawn(function()
		local ticks = 0
		while true do
			task.wait(1)
			ticks += 1
			for _, player in Players:GetPlayers() do
				local data = Registry.Game.Data(player)
				if data then
					local before = data.GiftSeconds
					data.GiftSeconds = math.min(Config.GiftInterval, data.GiftSeconds + 1)
					if before < Config.GiftInterval and data.GiftSeconds >= Config.GiftInterval then
						notify(player, "n.giftReady", nil, "event")
						Registry.Game.Push(player)
					end
					if ticks % 30 == 0 and Sim.CheckDaily(Config, data, Registry.Game.Ctx(player), os.time()) then
						Registry.Game.Push(player)
					end
				end
			end
		end
	end)
end

return Shop
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="R6983">
        <Properties>
          <string name="Name">Events</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Events: o que acontece "sozinho" no servidor.
	  • Chuva de Milho: por um tempo, todos os negócios rodam mais rápido (Game.EventSpeed).
	  • Ovo Surpresa: um ovo gigante cai na praça; quem encostar ganha um prêmio (cada um ganha o seu).
	  • Corrida de Galinhas: todo mundo escolhe uma galinha; o prêmio depende da colocação dela.
	  • Encomenda: de tempos em tempos um freguês faz uma oferta (aceitar, pedir mais ou recusar).
	  • Caça aos Ovos: ovos dourados escondidos pelo mapa.
	  • OVO GIGANTE da praça: enche com o jogo de todo mundo; quando enche, racha e dá prêmio a todos.
	  • Obby: chegar ao baú dá prêmio e um giro na roleta.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AssetLib = require(ReplicatedStorage.Shared.AssetLib)
local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Sim = require(ReplicatedStorage.Shared.Sim)
local Registry = require(script.Parent.Registry)

local Events = {}

Events.Current = nil :: string? -- evento em andamento

local folder: Folder

local function randomBetween(range: { number }): number
	return range[1] + math.random() * (range[2] - range[1])
end

local function pushAll()
	for _, player in Players:GetPlayers() do
		Registry.Game.Push(player)
	end
end

-- ---------------------------------------------------------------------------
-- Chuva de Milho
-- ---------------------------------------------------------------------------
local function runRain(event: any)
	Registry.Game.EventSpeed = event.Speed
	Registry.Remotes.Fx:FireAllClients("event", nil, "rain", event.Duration)
	pushAll()
	task.wait(event.Duration)
	Registry.Game.EventSpeed = 1
	Registry.Remotes.Fx:FireAllClients("eventEnd", nil, "rain")
	pushAll()
end

-- ---------------------------------------------------------------------------
-- Ovo Surpresa
-- ---------------------------------------------------------------------------
local function runGift(event: any)
	local spots = Layout.GiftSpots
	local spot = spots[math.random(1, #spots)]
	local model = AssetLib.Get("Ovo_ArcoIris", 5)
	if not model then
		return
	end
	AssetLib.SetCollide(model, false)
	model.Name = "OvoSurpresa"
	model:PivotTo(CFrame.new(spot[1], 0.3, spot[2]))
	CollectionService:AddTag(model, "VUOGift")
	model.Parent = folder
	local position = Vector3.new(spot[1], 4, spot[2])
	Registry.Remotes.Fx:FireAllClients("event", position, "gift", event.Duration)
	local claimed: { [Player]: boolean } = {}
	local elapsed = 0
	while elapsed < event.Duration do
		elapsed += task.wait(0.3)
		for _, player in Players:GetPlayers() do
			if not claimed[player] then
				local root = Registry.Plots.RootOf(player)
				if root and Registry.Game.Data(player) and (root.CFrame.Position - position).Magnitude <= 11 and Registry.Guard.Ok(player) then
					claimed[player] = true
					local reward = Registry.Game.Reward(player, randomBetween(event.Seconds), 25, false)
					Registry.Remotes.Fx:FireClient(player, "reward", nil, reward, "giftEgg")
				end
			end
		end
	end
	model:Destroy()
	Registry.Remotes.Fx:FireAllClients("eventEnd", nil, "gift")
end

-- ---------------------------------------------------------------------------
-- Corrida de Galinhas
-- ---------------------------------------------------------------------------
local RACERS = { "Galinha_Comum", "Galinha_Caipira", "Pata", "Codorna" }
local picks: { [Player]: number } = {}
local raceOpen = false

local function runRace(event: any)
	local race = Layout.Race
	local base = CFrame.new(race.X, 0, race.Z) * CFrame.Angles(0, math.rad(race.Yaw), 0)
	local racers = {}
	for lane, asset in RACERS do
		local model = AssetLib.Get(asset, 1.6)
		if model then
			AssetLib.SetCollide(model, false)
			model.Name = "Racer" .. lane
			model:SetAttribute("Lane", lane)
			model:PivotTo(base * CFrame.new(race.StartX, 0.2, race.Lanes[lane]) * CFrame.Angles(0, math.rad(-90), 0))
			CollectionService:AddTag(model, "VUORacer")
			model.Parent = folder
			racers[lane] = model
		end
	end
	picks = {}
	raceOpen = true
	Registry.Remotes.Fx:FireAllClients("event", (base * CFrame.new(0, 6, 0)).Position, "race", event.Pick)
	task.wait(event.Pick)
	raceOpen = false
	-- sorteia a ordem de chegada e o tempo de cada galinha
	local order = { 1, 2, 3, 4 }
	for i = #order, 2, -1 do
		local j = math.random(1, i)
		order[i], order[j] = order[j], order[i]
	end
	local times = {}
	local place = {}
	for position, lane in order do
		times[lane] = event.Run * (0.62 + 0.1 * position) + math.random() * 0.4
		place[lane] = position
	end
	Registry.Remotes.Fx:FireAllClients("raceGo", nil, times, order)
	task.wait(event.Run + 1.5)
	for player, lane in picks do
		if player.Parent and Registry.Game.Data(player) then
			local position = place[lane] or 4
			local reward = Registry.Game.Reward(player, event.Seconds[position] or 0, 10, false)
			Registry.Remotes.Fx:FireClient(player, "raceResult", nil, reward, position)
		end
	end
	Registry.Remotes.NotifyAll("n.raceWinner", { lane = order[1] }, "event")
	picks = {}
	task.wait(4)
	for _, model in racers do
		model:Destroy()
	end
	Registry.Remotes.Fx:FireAllClients("eventEnd", nil, "race")
end

local RUNNERS = { rain = runRain, gift = runGift, race = runRace }

-- ---------------------------------------------------------------------------
-- Encomendas
-- ---------------------------------------------------------------------------
local orders: { [Player]: { Value: number, Expires: number } } = {}
local nextOrder: { [Player]: number } = {}

local function offerOrder(player: Player)
	local data = Registry.Game.Data(player)
	if not data then
		return
	end
	local _, all = Sim.Income(Config, data, Registry.Game.Ctx(player))
	if all <= 0 or Sim.Count(data.Owned) < Config.OrderMinButtons then
		return -- nos primeiros minutos a janela da encomenda atrapalharia o tutorial
	end
	local value = Sim.Reward(Config, data, Registry.Game.Ctx(player), randomBetween(Config.OrderSeconds), 20)
	orders[player] = { Value = value, Expires = os.clock() + Config.OrderTimeout }
	Registry.Remotes.Fx:FireClient(player, "order", nil, value, { Config.OrderTimeout, math.random(1, 6) })
end

local function answerOrder(player: Player, answer: any)
	local order = orders[player]
	local data = Registry.Game.Data(player)
	if not order or not data then
		return
	end
	orders[player] = nil
	if os.clock() > order.Expires + 2 or answer == "decline" then
		return
	end
	local value = order.Value
	if answer == "haggle" then
		if math.random() < Config.OrderHaggleChance then
			value = math.floor(value * (1 + randomBetween(Config.OrderHaggleBonus)))
			Registry.Remotes.NotifyPlayer(player, "n.haggleWin", nil, "success")
		else
			Registry.Remotes.NotifyPlayer(player, "n.haggleLose", nil, "error")
			return
		end
	elseif answer ~= "accept" then
		return
	end
	data.Stats.Orders += 1
	Sim.AddCoins(data, value, true)
	Registry.Remotes.Fx:FireClient(player, "reward", nil, value, "order")
	Registry.Game.Push(player)
end

-- ---------------------------------------------------------------------------
-- Caça aos Ovos
-- ---------------------------------------------------------------------------
local function pollHunt()
	local spots = Layout.Hunt
	for _, player in Players:GetPlayers() do
		local data = Registry.Game.Data(player)
		local root = Registry.Plots.RootOf(player)
		if data and root then
			for index, spot in spots do
				if not data.Hunt[tostring(index)] then
					local d = root.CFrame.Position - Vector3.new(spot[1], spot[2] + 2, spot[3])
					if d.Magnitude <= 6.5 and Registry.Guard.Ok(player) then
						local fresh, found = Sim.FindHunt(Config, data, index, #spots)
						if fresh then
							Registry.Remotes.Fx:FireClient(player, "hunt", root.CFrame.Position, found, #spots)
							if found >= #spots then
								Registry.Remotes.NotifyAll("n.huntAll", { player = player.DisplayName }, "event")
							end
							Registry.Game.Push(player)
						end
					end
				end
			end
		end
	end
end

-- ---------------------------------------------------------------------------
-- OVO GIGANTE
-- O modelo fica em workspace.Events.GiantEgg com os atributos que o cliente usa para desenhar:
--   Progress (0..1), Variant ("ouro"...), State ("fill" | "crack"), CrackAt (hora do servidor)
-- ---------------------------------------------------------------------------
local GIANT_EGG = { ouro = "Ovo_Dourado", cristal = "Ovo_Cristal", arcoiris = "Ovo_ArcoIris", lunar = "Ovo_Lunar", dragao = "Ovo_Dragao" }
local giant = { Points = 0, Target = Config.Giant.Target, Model = nil :: Model?, Busy = false, Variant = "ouro", Shown = -1 }

local function giantTarget(): number
	local n = math.max(1, #Players:GetPlayers())
	return Config.Giant.Target * n ^ 0.85
end

local function spawnGiant()
	if giant.Model then
		giant.Model:Destroy()
		giant.Model = nil
	end
	local spot = Layout.Giant
	giant.Variant = Sim.GiantVariant(Config, os.time())
	local model = AssetLib.Get(GIANT_EGG[giant.Variant] or "Ovo_Dourado", spot[4])
	if not model then
		return
	end
	AssetLib.SetCollide(model, true)
	model.Name = "GiantEgg"
	model:PivotTo(CFrame.new(spot[1], spot[2], spot[3]))
	model:SetAttribute("Progress", 0)
	model:SetAttribute("Variant", giant.Variant)
	model:SetAttribute("State", "fill")
	model:SetAttribute("CrackAt", 0)
	CollectionService:AddTag(model, "VUOGiant")
	model.Parent = folder
	giant.Model = model
	giant.Points = 0
	giant.Shown = -1
end

local function crackGiant()
	local model = giant.Model
	if giant.Busy or not model then
		return
	end
	giant.Busy = true
	local G = Config.Giant
	local spot = Layout.Giant
	local center = Vector3.new(spot[1], spot[2] + 6, spot[3])
	model:SetAttribute("Progress", 1)
	model:SetAttribute("State", "crack")
	model:SetAttribute("CrackAt", workspace:GetServerTimeNow() + G.Countdown)
	Registry.Remotes.Fx:FireAllClients("giantSoon", center, giant.Variant, G.Countdown)
	Registry.Remotes.NotifyAll("n.giantSoon", { n = G.Countdown }, "event")
	task.wait(G.Countdown)
	local winners = {}
	for _, player in Players:GetPlayers() do
		local data = Registry.Game.Data(player)
		if data then
			local root = Registry.Plots.RootOf(player)
			local near = root ~= nil and (root.CFrame.Position - center).Magnitude <= G.NearRadius and Registry.Guard.Ok(player)
			local coins, pet = Sim.GiantReward(Config, data, Registry.Game.Ctx(player), near, giant.Variant, math.random)
			Registry.Remotes.Fx:FireClient(player, "giantReward", nil, coins, { near, pet })
			if pet then
				table.insert(winners, player.DisplayName)
			end
			Registry.Game.Push(player)
		end
	end
	Registry.Remotes.Fx:FireAllClients("giantCrack", center, giant.Variant)
	for _, name in winners do
		Registry.Remotes.NotifyAll("n.giantPet", { player = name }, "event")
	end
	model:Destroy()
	giant.Model = nil
	task.wait(8)
	spawnGiant()
	giant.Busy = false
end

-- Soma pontos ao Ovo Gigante (qualquer jogador; chamado pelo Farm: tempo de jogo, cliques e ciclos na
-- mão, compras, ovos raros vendidos e pets chocados)
function Events.GiantAdd(points: number)
	if giant.Busy or not giant.Model or points ~= points or points <= 0 then
		return
	end
	giant.Points += points
end

function Events.GiantProgress(): number
	return math.clamp(giant.Points / math.max(giant.Target, 1), 0, 1)
end

local function stepGiant()
	if giant.Busy then
		return
	end
	if not giant.Model then
		spawnGiant()
		return
	end
	giant.Target = giantTarget()
	local progress = Events.GiantProgress()
	local shown = math.floor(progress * 200) / 200
	if shown ~= giant.Shown then
		giant.Shown = shown
		giant.Model:SetAttribute("Progress", shown)
	end
	if progress >= 1 and #Players:GetPlayers() > 0 then
		task.spawn(function()
			local ok, err = pcall(crackGiant)
			if not ok then
				warn("[Events] ovo gigante:", err)
				giant.Busy = false
				spawnGiant()
			end
		end)
	end
end

-- Só para teste no Studio: enche o ovo na hora
function Events.GiantFill(fraction: number)
	giant.Points = giantTarget() * math.clamp(fraction, 0, 1)
end

-- ---------------------------------------------------------------------------
-- Obby: quem chega ao baú ganha o prêmio (com tempo de espera)
-- ---------------------------------------------------------------------------
local obbyTold: { [Player]: number } = {}

local function pollObby()
	local obby = Layout.Obby
	if not obby then
		return
	end
	local chest = Vector3.new(obby.Chest[1], obby.Chest[2], obby.Chest[3])
	local start = Vector3.new(obby.Start[1], obby.Start[2], obby.Start[3])
	for _, player in Players:GetPlayers() do
		local data = Registry.Game.Data(player)
		local root = Registry.Plots.RootOf(player)
		if root and (root.CFrame.Position - start).Magnitude <= 14 then
			Registry.Guard.ObbyStarted(player) -- passou pela largada (o baú só paga quem fez o percurso)
		end
		if data and root and (root.CFrame.Position - chest).Magnitude <= Config.Obby.Radius and Registry.Guard.ObbyOk(player) then
			local now = os.time()
			local coins = Sim.ClaimObby(Config, data, Registry.Game.Ctx(player), now)
			if coins > 0 then
				Registry.Remotes.Fx:FireClient(player, "obby", chest, coins, Config.Obby.Spins)
				Registry.Remotes.NotifyAll("n.obbyDone", { player = player.DisplayName }, "event")
				Registry.Game.Push(player)
			elseif os.clock() - (obbyTold[player] or 0) > 6 then
				obbyTold[player] = os.clock()
				Registry.Remotes.NotifyPlayer(player, "n.obbyWait", { t = math.ceil((data.ObbyAt - now) / 60) }, "info")
			end
		end
	end
end

-- Só para teste no Studio (ServerStorage.VUODebug): começa um evento agora
function Events.Force(id: string): boolean
	local event = Config.EventById[id]
	local runner = RUNNERS[id]
	if not event or not runner or Events.Current then
		return false
	end
	Events.Current = id
	task.spawn(function()
		local ok, err = pcall(runner, event)
		if not ok then
			warn("[Events] " .. id .. ":", err)
			Registry.Game.EventSpeed = 1
		end
		Events.Current = nil
	end)
	return true
end

function Events.ForceOrder(player: Player)
	offerOrder(player)
end

function Events.Init()
	folder = Instance.new("Folder")
	folder.Name = "Events"
	folder.Parent = workspace
	Registry.Game.HuntTotal = #Layout.Hunt

	Registry.Remotes.On("Order", answerOrder)
	Registry.Remotes.On("RacePick", function(player: Player, lane: any)
		if raceOpen and type(lane) == "number" and lane >= 1 and lane <= #RACERS and lane % 1 == 0 then
			picks[player] = lane
		end
	end)

	-- rodízio de eventos
	task.spawn(function()
		task.wait(Config.EventFirst)
		local index = 0
		while true do
			index = index % #Config.Events + 1
			local event = Config.Events[index]
			local runner = RUNNERS[event.Id]
			-- (not Events.Current: um evento começado pelo VUODebug ainda está rodando; dois ao mesmo tempo
			-- se atropelam: duas corridas apagam os palpites uma da outra e deixam galinhas em dobro na pista)
			if runner and not Events.Current and #Players:GetPlayers() > 0 then
				Events.Current = event.Id
				local ok, err = pcall(runner, event)
				if not ok then
					warn("[Events] " .. event.Id .. ":", err)
					Registry.Game.EventSpeed = 1
				end
				Events.Current = nil
			end
			task.wait(Config.EventEvery)
		end
	end)

	-- encomendas e caça aos ovos
	task.spawn(function()
		while true do
			task.wait(0.5)
			local now = os.clock()
			for _, player in Players:GetPlayers() do
				if Registry.Game.Data(player) then
					local due = nextOrder[player]
					if not due then
						nextOrder[player] = now + randomBetween(Config.OrderEvery) * 0.5
					elseif now >= due then
						nextOrder[player] = now + randomBetween(Config.OrderEvery)
						pcall(offerOrder, player)
					end
				end
			end
			pcall(pollHunt)
			pcall(pollObby)
		end
	end)

	-- Ovo Gigante
	task.spawn(function()
		while true do
			local ok, err = pcall(stepGiant)
			if not ok then
				warn("[Events] ovo gigante:", err)
			end
			task.wait(1)
		end
	end)

	-- Roleta da praça: chegar perto e apertar abre a roleta (a tela abre no cliente)
	for _, wheel in CollectionService:GetTagged("VUOWheel") do
		local disk = wheel:FindFirstChild("Disco", true)
		if disk and disk:IsA("BasePart") then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "Spin"
			prompt.ActionText = "🎡"
			prompt.ObjectText = ""
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 16
			prompt.RequiresLineOfSight = false
			prompt.Parent = disk
			CollectionService:AddTag(prompt, "VUOWheelPrompt")
		end
	end

	Players.PlayerRemoving:Connect(function(player)
		orders[player] = nil
		nextOrder[player] = nil
		picks[player] = nil
		obbyTold[player] = nil
	end)
end

return Events
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="R6984">
        <Properties>
          <string name="Name">Store</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Store: vendas em Robux (a lista do que se vende e os preços sugeridos ficam em Config.GamePasses e
	Config.Products; Id 0 = desligado). O que cada item FAZ está nas regras puras do Sim (Sim.GrantPass,
	Sim.DeliverProduct, Sim.VipDaily...); aqui é só a conversa com o Roblox e os avisos na tela.

	  • Game passes (compra uma vez, vale para sempre):
	      - comprou dentro do jogo: PromptGamePassPurchaseFinished NO SERVIDOR entrega na hora (não depende
	        do cache do UserOwnsGamePassAsync, que pode dizer "não tem" logo depois da compra);
	      - ao entrar: UserOwnsGamePassAsync com pcall e novas tentativas (comprou pelo site, ou em outro
	        servidor). O que já estava salvo em data.Passes vale mesmo se o Roblox estiver fora do ar.
	  • Produtos (pode comprar várias vezes): ProcessReceipt. Cada compra (PurchaseId) é entregue UMA vez
	    só e o servidor só responde PurchaseGranted DEPOIS de salvar. Se o save falhar, o Roblox chama de
	    novo mais tarde; como o PurchaseId já está em data.Receipts, nada é entregue em dobro.
	  • Produto de compra única (Once, ex.: Pacote Inicial): o pedido é recusado se o jogador já comprou.
	    Se mesmo assim o Roblox cobrar (duas janelas abertas, outro servidor), ele ganha moedas no lugar:
	    a compra nunca é perdida.
	  • PolicyService: onde o Roblox restringe prêmio sorteado ligado a compra, o giro diário do VIP vira
	    um presente fixo. Se a consulta falhar, a loja funciona normal. (O Roblox não tem um aviso de
	    "este jogador não pode comprar": quem barra a compra, nesses casos, é a própria janela do Roblox.)
	  • VIP aparece para os OUTROS jogadores: etiqueta em cima da cabeça (aqui), nome na placa e brilho
	    na banca (Plots.RefreshSign / Plots.RefreshVip) e o atributo "VIP" no jogador e no terreno.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Sim = require(ReplicatedStorage.Shared.Sim)
local Registry = require(script.Parent.Registry)

-- o serviço pode não existir fora do Roblox de verdade (testes): sem ele a loja segue normal
local okPolicy, PolicyService = pcall(function()
	return game:GetService("PolicyService")
end)

local Store = {}

local MAX_RECEIPTS = 50 -- últimas compras lembradas no save (o Roblox reenvia recibo por poucos dias)
local OWN_TRIES = 3 -- tentativas de perguntar ao Roblox se o jogador tem um passe
local LOOP_SECONDS = 30 -- giro/presente diário do VIP e nova conferência de passes que falhou

local passById: { [number]: any } = {}
local passByKey: { [string]: any } = {}
local productById: { [number]: any } = {}
local productByKey: { [string]: any } = {}
local recheck: { [Player]: boolean } = {} -- a conferência de passes falhou: tenta de novo no laço
local unknownWarned: { [number]: boolean } = {}

for _, pass in Config.GamePasses do
	passByKey[pass.Key] = pass
	if (tonumber(pass.Id) or 0) > 0 then
		passById[pass.Id] = pass
	end
end
for _, product in Config.Products do
	productByKey[product.Key] = product
	if (tonumber(product.Id) or 0) > 0 then
		productById[product.Id] = product
	end
end

local function notify(player: Player, key: string, args: any?, kind: string?)
	Registry.Remotes.NotifyPlayer(player, key, args, kind)
end

-- ---------------------------------------------------------------------------
-- VIP: o que os outros jogadores veem
-- ---------------------------------------------------------------------------
-- Etiqueta "👑 VIP" em cima da cabeça. Criada no servidor: aparece para todo mundo sem código no cliente.
local function vipTag(player: Player)
	local character = player.Character
	local head = character and (character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart"))
	if not head then
		return
	end
	local old = head:FindFirstChild("VIPTag")
	if not Registry.Game.HasPass(player, "VIP") then
		if old then
			old:Destroy()
		end
		return
	end
	if old then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "VIPTag"
	gui.Size = UDim2.fromScale(3.4, 0.95)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0) -- acima do nome do jogador
	gui.MaxDistance = 90
	gui.LightInfluence = 0
	gui.Adornee = head
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Config.VIP.Color
	label.TextStrokeColor3 = Color3.fromRGB(70, 38, 15)
	label.TextStrokeTransparency = 0
	label.Text = "👑 VIP"
	label.Parent = gui
	gui.Parent = head
end

-- Atualiza tudo que mostra o VIP: atributo no jogador, etiqueta, placa e brilho da granja
function Store.RefreshVip(player: Player)
	local vip = Registry.Game.HasPass(player, "VIP")
	if player:GetAttribute("VIP") ~= vip then
		player:SetAttribute("VIP", vip)
	end
	vipTag(player)
	local plot = Registry.Plots.Of(player)
	if plot then
		Registry.Plots.RefreshSign(plot)
	end
end

local function vipNotice(player: Player, kind: string?, amount: number)
	if kind == "spins" then
		notify(player, "n.vipSpin", nil, "event")
	elseif kind == "coins" then
		notify(player, "n.vipGift", nil, "event")
		Registry.Remotes.Fx:FireClient(player, "reward", nil, amount, "vip")
	end
	if kind then
		Registry.Game.Push(player)
	end
end

-- Giro (ou presente fixo) do dia para quem tem VIP. Pode chamar à vontade: o Sim só dá uma vez por dia.
local function vipDaily(player: Player)
	local data = Registry.Game.Data(player)
	if not data then
		return
	end
	local kind, amount = Sim.VipDaily(Config, data, Registry.Game.Ctx(player), os.time())
	vipNotice(player, kind, amount)
end

-- ---------------------------------------------------------------------------
-- Game passes
-- ---------------------------------------------------------------------------
-- bought = comprou agora dentro do jogo (agradece e salva já); false = o Roblox disse ao entrar que ele tem
local function grantPass(player: Player, pass: any, bought: boolean)
	Registry.Game.Owned(player)[pass.Key] = true
	local data = Registry.Game.Data(player)
	if not data then
		return -- ainda carregando: o passe já vale na sessão e o CheckPasses guarda no save depois
	end
	local out = Sim.GrantPass(Config, data, Registry.Game.Ctx(player), pass.Key, os.time())
	if bought then
		notify(player, "n.passOn", { pass = pass.Key }, "success")
		Registry.Remotes.Fx:FireClient(player, "sound", nil, "Comprar")
	end
	if out.OfflineDoubled then
		notify(player, "n.offlineDouble", nil, "success")
	end
	vipNotice(player, out.Vip, out.VipAmount or 0)
	if pass.Key == "VIP" then
		Store.RefreshVip(player)
	end
	Registry.Game.ApplySpeed(player)
	Registry.Game.Push(player)
	if bought and out.New then
		task.spawn(Registry.Data.Save, player) -- compra é importante: salva já
	end
end

-- Pergunta ao Roblox se o jogador tem o passe. Devolve (tem?, deuParaPerguntar?).
local function ownsPass(player: Player, pass: any): (boolean, boolean)
	for attempt = 1, OWN_TRIES do
		local ok, has = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
		end)
		if ok then
			return has == true, true
		end
		if attempt < OWN_TRIES and player.Parent then
			task.wait(2 * attempt)
		end
	end
	return false, false
end

-- Regras do Roblox para o país/idade deste jogador. Falhou = segue normal (ver o cabeçalho).
local function checkPolicy(player: Player)
	if not okPolicy or not PolicyService then
		return
	end
	for attempt = 1, 2 do
		local ok, info = pcall(function()
			return PolicyService:GetPolicyInfoForPlayerAsync(player)
		end)
		if ok and type(info) == "table" then
			Registry.Game.SetPolicy(player, { NoRandom = info.ArePaidRandomItemsRestricted == true })
			return
		end
		if attempt == 1 and player.Parent then
			task.wait(2)
		end
	end
end

-- Confere os game passes de quem entrou (o que já estava salvo também vale). Chamado pelo Main em
-- task.spawn: pode esperar a internet à vontade sem atrasar a entrada do jogador.
function Store.CheckPasses(player: Player)
	checkPolicy(player)
	local failed = false
	for _, pass in Config.GamePasses do
		if not player.Parent then
			return
		end
		-- v6: comprado enquanto os dados ainda carregavam (só valia na sessão): agora guarda no save também
		local data = Registry.Game.Data(player)
		if Registry.Game.Owned(player)[pass.Key] and data and not (data.Passes and data.Passes[pass.Key]) then
			grantPass(player, pass, false)
		end
		-- passe já guardado no save (ou já entregue nesta sessão) não precisa perguntar de novo ao Roblox
		if (tonumber(pass.Id) or 0) > 0 and not Registry.Game.Owned(player)[pass.Key] and not Registry.Game.HasPass(player, pass.Key) then
			local has, asked = ownsPass(player, pass)
			if has then
				grantPass(player, pass, false)
			elseif not asked then
				failed = true
			end
		end
	end
	if not player.Parent then
		return
	end
	recheck[player] = if failed then true else nil
	Store.RefreshVip(player)
	vipDaily(player)
	Registry.Game.Push(player)
end

local function buyPass(player: Player, key: any)
	local pass = type(key) == "string" and passByKey[key]
	if not pass or (tonumber(pass.Id) or 0) <= 0 then
		return
	end
	if Registry.Game.HasPass(player, pass.Key) then
		notify(player, "n.passHave", nil, "info")
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.Id)
end

-- ---------------------------------------------------------------------------
-- Produtos
-- ---------------------------------------------------------------------------
local function buyProduct(player: Player, key: any)
	local product = type(key) == "string" and productByKey[key]
	local data = Registry.Game.Data(player)
	if not product or not data or (tonumber(product.Id) or 0) <= 0 then
		return
	end
	-- compra única já feita: nem abre a janela de compra
	if not Sim.CanOfferProduct(data, product) then
		notify(player, "n.onceHave", nil, "info")
		return
	end
	-- Chocar já: só abre a janela se houver ovo chocando (senão seriam Robux jogados fora)
	if product.Kind == "hatch" then
		local now, waiting = os.time(), false
		for _, hatch in data.Hatch or {} do
			if (tonumber(hatch.Ready) or 0) > now then
				waiting = true
			end
		end
		if not waiting then
			notify(player, "n.hatchNone", nil, "info")
			return
		end
	end
	-- Recarga de poderes: só abre a janela se houver poder recarregando (senão seriam Robux jogados fora)
	if product.Kind == "refill" then
		local refill = Sim.RefillState(Config, data, Registry.Game.Ctx(player))
		if refill ~= "ok" then
			notify(player, if refill == "locked" then "n.powerLocked" else "n.refill", nil, "info")
			return
		end
	end
	MarketplaceService:PromptProductPurchase(player, product.Id)
end

-- Mostra na tela o que o produto entregou (out = resultado do Sim.DeliverProduct)
local function announceProduct(player: Player, product: any, out: any)
	if out.Coins > 0 then
		Registry.Remotes.Fx:FireClient(player, "reward", nil, out.Coins, "robux")
	end
	if out.Again then
		notify(player, "n.onceAgain", nil, "info")
	elseif product.Kind == "refill" then
		notify(player, "n.refill", nil, "success")
	elseif product.Kind == "hatch" and out.Hatched then
		notify(player, "n.hatchNow", nil, "success")
	elseif product.Kind == "pack" then
		notify(player, "n.packOn", nil, "success")
	elseif out.Boost then
		notify(player, "n.boostOn", { boost = out.Boost }, "success")
	end
	Registry.Remotes.Fx:FireClient(player, "sound", nil, "Comprar")
	Registry.Game.Push(player)
end

local function processReceipt(receipt: any): Enum.ProductPurchaseDecision
	local NOT_YET = Enum.ProductPurchaseDecision.NotProcessedYet
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return NOT_YET -- saiu no meio da compra: o Roblox chama de novo quando ele voltar
	end
	local product = productById[receipt.ProductId]
	if not product then
		-- ID que este servidor não conhece (número errado no Config?): não confirma; sem confirmação o
		-- Roblox devolve os Robux ao jogador depois de alguns dias
		if not unknownWarned[receipt.ProductId] then
			unknownWarned[receipt.ProductId] = true
			warn("[Store] recibo de produto desconhecido: " .. tostring(receipt.ProductId) .. " (confira os Ids em Config.Products)")
		end
		return NOT_YET
	end
	local data = Registry.Game.Data(player)
	local profile = Registry.Data.Get(player)
	if not data or not profile or not profile.CanSave then
		return NOT_YET
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if not table.find(data.Receipts, purchaseId) then
		-- entrega e recibo entram nos dados juntos, sem esperar nada no meio: se o save abaixo falhar e o
		-- Roblox chamar de novo, cai no "já entregue" e só tenta salvar outra vez (nunca entrega em dobro)
		local out = Sim.DeliverProduct(Config, data, Registry.Game.Ctx(player), product, os.time())
		table.insert(data.Receipts, purchaseId)
		while #data.Receipts > MAX_RECEIPTS do
			table.remove(data.Receipts, 1)
		end
		local ok, err = pcall(announceProduct, player, product, out)
		if not ok then
			warn("[Store] aviso da compra:", err)
		end
	end
	-- só confirma ao Roblox depois de salvar (entrega + recibo vão juntos no mesmo save)
	if Registry.Data.Save(player) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return NOT_YET
end

-- Ferramenta de teste, SÓ chamada pelo VUODebug do Main (que só existe no Studio): liga passes e entrega
-- produtos sem compra nenhuma, para ver o efeito de cada item antes mesmo de criar os Ids.
--   "pass", "VIP" (ou "todos")   liga o passe      "nopass"   tira todos os passes e compras únicas
--   "product", "PacoteInicial"   entrega o produto como se o recibo tivesse chegado
function Store.Debug(player: Player, command: string, value: any): string
	local data = Registry.Game.Data(player)
	if not data then
		return "sem jogador carregado"
	end
	if command == "pass" then
		local done = {}
		for _, pass in Config.GamePasses do
			if value == "todos" or value == pass.Key then
				grantPass(player, pass, true)
				table.insert(done, pass.Key)
			end
		end
		return if #done > 0 then "passe ligado: " .. table.concat(done, ", ") else "passe desconhecido: " .. tostring(value)
	elseif command == "nopass" then
		data.Passes = {}
		data.Bought = {}
		data.VipDay = 0
		table.clear(Registry.Game.Owned(player))
		Store.RefreshVip(player)
		Registry.Game.ApplySpeed(player)
		Registry.Game.Push(player)
		return "passes e compras únicas apagados"
	elseif command == "product" then
		local product = productByKey[value]
		if not product then
			return "produto desconhecido: " .. tostring(value)
		end
		local out = Sim.DeliverProduct(Config, data, Registry.Game.Ctx(player), product, os.time())
		announceProduct(player, product, out)
		return ("produto %s: moedas %s%s%s%s%s"):format(product.Key, tostring(out.Coins), if out.Egg then ", ovo " .. out.Egg else "", if out.Boost then ", efeito " .. out.Boost else "", if out.Again then " (já tinha: só moedas)" else "", if out.Refill then (", %d poderes recarregados"):format(out.Refill) else "")
	end
	return "comando desconhecido"
end

function Store.Init()
	Registry.Remotes.On("BuyPass", buyPass)
	Registry.Remotes.On("BuyProduct", buyProduct)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
		local pass = passById[passId]
		if purchased and pass and player and player.Parent then
			local ok, err = pcall(grantPass, player, pass, true)
			if not ok then
				warn("[Store] passe:", err)
			end
		end
	end)
	MarketplaceService.ProcessReceipt = function(receipt: any): Enum.ProductPurchaseDecision
		-- um erro aqui não pode virar "compra perdida": responde "ainda não" e o Roblox tenta de novo
		local ok, result = pcall(processReceipt, receipt)
		if ok then
			return result
		end
		warn("[Store] recibo:", result)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- VIP: a etiqueta volta toda vez que o personagem nasce
	local function watch(player: Player)
		player.CharacterAdded:Connect(function(character: Model)
			-- espera a cabeça existir (uns segundos no máximo); sem ela a etiqueta vai no tronco
			local tries = 0
			while not character:FindFirstChild("Head") and character.Parent and tries < 12 do
				tries += 1
				task.wait(0.25)
			end
			if player.Character == character then
				pcall(vipTag, player)
			end
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player: Player)
		recheck[player] = nil
	end)

	-- de tempos em tempos: giro/presente do VIP quando o dia vira e passes que não deu para conferir
	task.spawn(function()
		while true do
			task.wait(LOOP_SECONDS)
			for _, player in Players:GetPlayers() do
				if Registry.Game.Data(player) then
					if recheck[player] then
						recheck[player] = nil
						task.spawn(Store.CheckPasses, player)
					else
						local ok, err = pcall(vipDaily, player)
						if not ok then
							warn("[Store] VIP:", err)
						end
					end
				end
			end
		end
	end)
end

return Store
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="R6985">
        <Properties>
          <string name="Name">Leaderboard</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Leaderboard: placar GLOBAL dos maiores vendedores (todas as moedas já ganhas na vida).
	Grava num OrderedDataStore a cada 2 min e ao sair; a placa da praça atualiza a cada 90 s.
	O OrderedDataStore só guarda inteiros, e as moedas passam muito disso: gravamos log10(moedas) * 1e6.
	Placa: workspace.Map (qualquer peça chamada "LeaderboardBoard" com um SurfaceGui "Gui").
	v6: mais duas placas, cópias da primeira, uma de cada lado dela, viradas para o meio da praça:
	  • esquerda: TOP 10 de RENASCIMENTOS (global, outro OrderedDataStore: Config.RebirthStore)
	  • direita: MAIS RICOS AGORA neste servidor (renda por segundo, ao vivo a cada 10 s)
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local Leaderboard = {}

local Sim = require(ReplicatedStorage.Shared.Sim)

local store: OrderedDataStore? = nil
local rebirthStore: OrderedDataStore? = nil
local lastRebirths: { [number]: number } = {}
local extraGuis: { [string]: SurfaceGui } = {}
local names: { [number]: string } = {}
local lastWritten: { [number]: number } = {}

local function nameOf(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	names[userId] = if ok and name then name else "?"
	return names[userId]
end

function Leaderboard.Write(player: Player)
	local data = Registry.Game.Data(player)
	if not store or not data then
		return
	end
	local value = if data.TotalEarned >= 1 then math.floor(math.log10(data.TotalEarned) * 1e6) else 0
	-- v6: renascimentos (global)
	local rebirths = math.floor(tonumber(data.Rebirths) or 0)
	if rebirthStore and rebirths > 0 and lastRebirths[player.UserId] ~= rebirths then
		local okR, errR = pcall(function()
			(rebirthStore :: OrderedDataStore):SetAsync("u_" .. player.UserId, rebirths)
		end)
		if okR then
			lastRebirths[player.UserId] = rebirths
		else
			warn("[Leaderboard] gravar renascimentos:", errR)
		end
	end
	if lastWritten[player.UserId] == value or value <= 0 then
		return
	end
	local ok, err = pcall(function()
		(store :: OrderedDataStore):SetAsync("u_" .. player.UserId, value)
	end)
	if ok then
		lastWritten[player.UserId] = value
	else
		warn("[Leaderboard] gravar:", err)
	end
end

local function boardGui(): SurfaceGui?
	local map = workspace:FindFirstChild("Map")
	local board = map and map:FindFirstChild("LeaderboardBoard", true)
	return board and board:FindFirstChildWhichIsA("SurfaceGui")
end

-- v6: cópias da placa original ao lado dela (feitas uma vez, ao ligar o servidor)
local function makeExtraBoards()
	local map = workspace:FindFirstChild("Map")
	local board = map and map:FindFirstChild("LeaderboardBoard", true)
	local sign = board and board:FindFirstAncestorOfClass("Model")
	if not sign or not board then
		return
	end
	local pivot = sign:GetPivot()
	local center = pivot.Position
	for key, side in { Rebirths = -1, Richest = 1 } do
		local copy = sign:Clone()
		copy.Name = "LeaderboardSign_" .. key
		-- 21 studs para o lado e virada uns 17° para o meio da praça
		local spot = center + pivot.RightVector * (21 * side)
		local turned = CFrame.new(spot) * CFrame.Angles(0, 0.3 * side, 0) * (pivot - center)
		copy:PivotTo(turned)
		local copyBoard = copy:FindFirstChild("LeaderboardBoard", true)
		if copyBoard then
			copyBoard.Name = "LeaderboardBoard_" .. key -- (a busca da placa original não acha a cópia)
			local gui = copyBoard:FindFirstChildWhichIsA("SurfaceGui")
			if gui then
				extraGuis[key] = gui
			end
		end
		copy.Parent = sign.Parent
	end
end

local function draw(rows: { { name: string, value: number } }, target: SurfaceGui?, heading: string?, show: ((number) -> string)?)
	local gui = target or boardGui()
	if not gui then
		return
	end
	local title = gui:FindFirstChild("Text")
	if title and title:IsA("TextLabel") then
		title.Size = UDim2.fromScale(1, 0.2)
		title.Text = heading or "🏆 TOP 10"
	end
	local list = gui:FindFirstChild("List")
	if not list then
		local frame = Instance.new("Frame")
		frame.Name = "List"
		frame.BackgroundTransparency = 1
		frame.Position = UDim2.fromScale(0.04, 0.21)
		frame.Size = UDim2.fromScale(0.92, 0.77)
		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0.01, 0)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = frame
		frame.Parent = gui
		list = frame
	end
	for _, child in (list :: Frame):GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local medals = { "🥇", "🥈", "🥉" }
	for i, row in rows do
		local label = Instance.new("TextLabel")
		label.LayoutOrder = i
		label.Size = UDim2.fromScale(1, 0.09)
		label.BackgroundColor3 = if i % 2 == 0 then Color3.fromRGB(255, 236, 190) else Color3.fromRGB(255, 246, 220)
		label.BorderSizePixel = 0
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextColor3 = Color3.fromRGB(90, 50, 20)
		label.Text = ("  %s %s   %s"):format(medals[i] or ("#" .. i), row.name, if show then show(row.value) else "💰 " .. Format.Short(row.value))
		label.Parent = list
	end
	if #rows == 0 then
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 0.2)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(90, 50, 20)
		label.Text = "🥚 ..."
		label.Parent = list
	end
end

local function refresh()
	if not store then
		draw({})
		return
	end
	local ok, pages = pcall(function()
		return (store :: OrderedDataStore):GetSortedAsync(false, 10)
	end)
	if not ok or not pages then
		return
	end
	local rows = {}
	for _, entry in pages:GetCurrentPage() do
		local userId = tonumber(string.match(entry.key, "%d+"))
		if userId then
			table.insert(rows, { name = nameOf(userId), value = 10 ^ (entry.value / 1e6) })
		end
	end
	draw(rows)
end

local function refreshRebirths()
	local gui = extraGuis.Rebirths
	if not gui then
		return
	end
	if not rebirthStore then
		draw({}, gui, "🔄 TOP RENASCIMENTOS")
		return
	end
	local ok, pages = pcall(function()
		return (rebirthStore :: OrderedDataStore):GetSortedAsync(false, 10)
	end)
	if not ok or not pages then
		return
	end
	local rows = {}
	for _, entry in pages:GetCurrentPage() do
		local userId = tonumber(string.match(entry.key, "%d+"))
		if userId then
			table.insert(rows, { name = nameOf(userId), value = entry.value })
		end
	end
	draw(rows, gui, "🔄 TOP RENASCIMENTOS", function(n)
		return "🔄 " .. tostring(math.floor(n))
	end)
end

-- quem está no servidor agora, pela renda por segundo
local function refreshRichest()
	local gui = extraGuis.Richest
	if not gui then
		return
	end
	local rows = {}
	for _, player in Players:GetPlayers() do
		local data = Registry.Game.Data(player)
		if data then
			local ok, income = pcall(Sim.Income, Config, data, Registry.Game.Ctx(player))
			table.insert(rows, { name = player.DisplayName, value = if ok then income else 0 })
		end
	end
	table.sort(rows, function(a, b)
		return a.value > b.value
	end)
	while #rows > 10 do
		table.remove(rows)
	end
	draw(rows, gui, "💰 MAIS RICOS AGORA", function(n)
		return "💰 " .. Format.Short(n) .. "/s"
	end)
end

function Leaderboard.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.LeaderboardStore)
	end)
	if ok then
		store = result
	end
	local okR, resultR = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.RebirthStore)
	end)
	if okR then
		rebirthStore = resultR
	end
	pcall(makeExtraBoards)
	task.spawn(function()
		while true do
			pcall(refreshRichest)
			task.wait(10)
		end
	end)
	task.spawn(function()
		task.wait(5)
		while true do
			pcall(refreshRebirths)
			task.wait(90)
		end
	end)
	task.spawn(function()
		while true do
			pcall(refresh)
			task.wait(90)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in Players:GetPlayers() do
				Leaderboard.Write(player)
				task.wait(1)
			end
		end
	end)
end

return Leaderboard
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="R6986">
        <Properties>
          <string name="Name">Tractor</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Tractor: o trator da granja (botão G_tractor). Dá para sentar e dirigir.
	Feito para ser simples e difícil de quebrar: o trator é um bloco só (tudo soldado no chassi),
	apoiado em 4 esferas invisíveis sem atrito. Quem empurra é um LinearVelocity (a velocidade que o
	trator deve ter, no plano do chão) e quem gira é um AngularVelocity. O servidor lê o acelerador e a
	direção do VehicleSeat e aponta a velocidade para a frente do trator.
	O jogador sentado continua comprando e pegando moedas e ovos raros: o Farm olha a posição do personagem.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AssetLib = require(ReplicatedStorage.Shared.AssetLib)
local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Registry = require(script.Parent.Registry)

local Tractor = {}

type Rig = { Model: Model, Chassis: BasePart, Seat: VehicleSeat, Move: LinearVelocity, Turn: AngularVelocity }

local rigs: { [any]: Rig } = {} -- [plot] = rig
local folder: Folder

local function homeCFrame(plot: any): CFrame
	local s = Layout.TractorSpawn
	return Registry.Plots.CF(plot, s[1], s[2], s[3], 0.4)
end

local function build(plot: any): Rig?
	local model = AssetLib.Get("Trator")
	if not model then
		return nil
	end
	local home = homeCFrame(plot)
	model.Name = "Trator"
	model:PivotTo(home)
	model:SetAttribute("PlotIndex", plot.Index)

	local chassis = Instance.new("Part")
	chassis.Name = "Chassis"
	chassis.Size = Vector3.new(4, 1, 8)
	chassis.Transparency = 1
	chassis.CanCollide = false
	chassis.CanTouch = false
	chassis.CanQuery = false
	chassis.CFrame = home * CFrame.new(0, 2.2, 0)
	chassis.CustomPhysicalProperties = PhysicalProperties.new(3, 0, 0, 100, 100)
	chassis.Parent = model

	local function weld(part: BasePart)
		local w = Instance.new("WeldConstraint")
		w.Part0 = chassis
		w.Part1 = part
		w.Parent = part
	end

	-- 4 apoios redondos sem atrito (passam por degraus pequenos sem travar)
	for _, offset in { Vector3.new(-2.2, 1.3, -3.4), Vector3.new(2.2, 1.3, -3.4), Vector3.new(-2.2, 1.3, 2.8), Vector3.new(2.2, 1.3, 2.8) } do
		local ball = Instance.new("Part")
		ball.Name = "Apoio"
		ball.Shape = Enum.PartType.Ball
		ball.Size = Vector3.new(2.6, 2.6, 2.6)
		ball.Transparency = 1
		ball.CanTouch = false
		ball.CanQuery = false
		ball.CFrame = home * CFrame.new(offset)
		ball.CustomPhysicalProperties = PhysicalProperties.new(1, 0, 0, 100, 100)
		ball.Parent = model
		weld(ball)
	end

	local seatMark = AssetLib.Find(model, "Assento")
	local seat = Instance.new("VehicleSeat")
	seat.Name = "Banco"
	seat.Size = Vector3.new(2, 0.4, 2)
	seat.Transparency = 1
	seat.CanCollide = false
	seat.HeadsUpDisplay = false
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.TurnSpeed = 0
	seat.CFrame = if seatMark then seatMark.CFrame * CFrame.new(0, 0.35, 0) else home * CFrame.new(0, 3.3, 2.4)
	seat.Parent = model

	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= chassis and d.Name ~= "Apoio" then
			d.CanCollide = false
			d.CanTouch = d == seat
			d.Massless = true
			weld(d)
		end
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
		end
	end

	local attachment = Instance.new("Attachment")
	attachment.Parent = chassis
	local move = Instance.new("LinearVelocity")
	move.Attachment0 = attachment
	move.RelativeTo = Enum.ActuatorRelativeTo.World
	move.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	move.VectorVelocity = Vector3.new(0, 0, 0)
	-- força só no plano do chão: a gravidade continua cuidando do sobe-e-desce
	move.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	move.MaxAxesForce = Vector3.new(60000, 0, 60000)
	move.Parent = chassis
	local turn = Instance.new("AngularVelocity")
	turn.Attachment0 = attachment
	turn.RelativeTo = Enum.ActuatorRelativeTo.World
	turn.AngularVelocity = Vector3.new(0, 0, 0)
	turn.MaxTorque = 2000000
	turn.Parent = chassis

	model.PrimaryPart = chassis
	model.Parent = folder
	return { Model = model, Chassis = chassis, Seat = seat, Move = move, Turn = turn }
end

local function destroy(plot: any)
	local rig = rigs[plot]
	if rig then
		rigs[plot] = nil
		rig.Model:Destroy()
	end
end

-- Cria ou apaga o trator conforme o dono tem (ou não) o botão comprado
function Tractor.Ensure(plot: any)
	local owner = plot.Owner
	local data = owner and Registry.Game.Data(owner)
	local owned = data ~= nil and data.Owned.G_tractor == true
	if owned and not rigs[plot] then
		local ok, rig = pcall(build, plot)
		if ok and rig then
			rigs[plot] = rig
		elseif not ok then
			warn("[Tractor] não deu para montar:", rig)
		end
	elseif not owned and rigs[plot] then
		destroy(plot)
	end
end

-- Leva o trator de volta para a garagem (se ninguém estiver dirigindo)
function Tractor.Home(plot: any): boolean
	local rig = rigs[plot]
	if not rig or rig.Seat.Occupant then
		return false
	end
	rig.Chassis.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	rig.Chassis.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	rig.Model:PivotTo(homeCFrame(plot) * CFrame.new(0, 2.2, 0))
	return true
end

local function step(plot: any, rig: Rig)
	local seat = rig.Seat
	local throttle, steer = 0, 0
	if seat.Occupant then
		throttle, steer = seat.Throttle, seat.Steer
	end
	local look = rig.Chassis.CFrame.LookVector * Vector3.new(1, 0, 1)
	look = if look.Magnitude > 0.01 then look.Unit else Vector3.new(0, 0, -1)
	rig.Move.VectorVelocity = look * (throttle * Config.Tractor.Speed * (if throttle < 0 then 0.5 else 1))
	local direction = if throttle < 0 then -1 else 1
	rig.Turn.AngularVelocity = Vector3.new(0, -steer * Config.Tractor.Turn * direction, 0)
	-- caiu do mundo ou capotou longe: volta para a garagem
	local position = rig.Chassis.CFrame.Position
	if position.Y < -40 or position.Y > 400 then
		rig.Chassis.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		rig.Model:PivotTo(homeCFrame(plot) * CFrame.new(0, 2.2, 0))
	end
end

function Tractor.Init()
	folder = Instance.new("Folder")
	folder.Name = "Vehicles"
	folder.Parent = workspace

	Registry.Remotes.On("TractorHome", function(player: Player)
		local plot = Registry.Plots.Of(player)
		if plot and rigs[plot] then
			if Tractor.Home(plot) then
				Registry.Remotes.NotifyPlayer(player, "n.tractorHome", nil, "success")
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.05)
			for plot, rig in rigs do
				if not rig.Model.Parent then
					rigs[plot] = nil
				else
					local ok, err = pcall(step, plot, rig)
					if not ok then
						warn("[Tractor]", err)
					end
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local plot = Registry.Plots.Of(player)
		if plot then
			destroy(plot)
		end
	end)
end

return Tractor
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="R6988">
      <Properties>
        <string name="Name">Main</string>
        <ProtectedString name="Source"><![CDATA[--[[
	VENDA UM OVO - script principal do servidor (Script "Main" em ServerScriptService).
	Liga os módulos da pasta "Game" e cuida da entrada/saída dos jogadores.
	Pra ajustar o jogo, mexa em ReplicatedStorage > Shared > Config.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Sim = require(ReplicatedStorage.Shared.Sim)
local GameFolder = script.Parent:WaitForChild("Game")
local Registry = require(GameFolder.Registry)

-- Texturas (Config.Textures): peças com o atributo "Tex" ganham a textura que repete
for _, d in workspace:GetDescendants() do
	local texName = d:IsA("BasePart") and d:GetAttribute("Tex")
	local id = texName and Config.Textures[texName]
	if id and id ~= "" then
		local faces = { Enum.NormalId.Top }
		if d:IsA("Part") and d.Shape == Enum.PartType.Cylinder then
			faces = { Enum.NormalId.Right, Enum.NormalId.Left } -- disco deitado: as tampas são as faces X
		end
		for _, face in faces do
			local texture = Instance.new("Texture")
			texture.Texture = id
			texture.Transparency = Config.TextureFade[texName] or 0
			texture.Face = face
			texture.StudsPerTileU = Config.TextureTile
			texture.StudsPerTileV = Config.TextureTile
			texture.Parent = d
		end
	end
end

Registry.Remotes = require(GameFolder.Remotes)
Registry.Data = require(GameFolder.Data)
Registry.Game = require(GameFolder.Game)
Registry.Weather = require(GameFolder.Weather)
Registry.Plots = require(GameFolder.Plots)
Registry.Farm = require(GameFolder.Farm)
Registry.Shop = require(GameFolder.Shop)
Registry.Events = require(GameFolder.Events)
Registry.Tractor = require(GameFolder.Tractor)
Registry.Store = require(GameFolder.Store)
Registry.Leaderboard = require(GameFolder.Leaderboard)
Registry.Guard = require(GameFolder.Guard)
Registry.Bonus = require(GameFolder.Bonus)

-- Cada sistema liga sozinho; se um der erro, os outros continuam
for _, name in { "Game", "Weather", "Plots", "Farm", "Shop", "Events", "Tractor", "Store", "Leaderboard", "Guard", "Bonus" } do
	local ok, err = pcall(Registry[name].Init)
	if not ok then
		warn("[Main] " .. name .. ".Init falhou:", err)
	end
end

local function onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	Registry.Game.ApplySpeed(player)
	-- renasce sozinho depois de cair/morrer
	humanoid.Died:Connect(function()
		task.wait(3)
		if player.Parent and player.Character == character then
			player:LoadCharacter()
		end
	end)
	-- nasce dentro da própria granja
	local plot = Registry.Plots.Of(player)
	if plot and character:WaitForChild("HumanoidRootPart", 10) then
		task.defer(function()
			Registry.Guard.Grace(player, 3) -- o servidor que moveu: não é teleporte de hack
			character:PivotTo(Registry.Plots.SpawnCFrame(plot))
		end)
	end
end

local function onPlayerAdded(player: Player)
	Registry.Game.SetupPlayer(player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)

	local profile = Registry.Data.Load(player)
	if not player.Parent then
		if profile.CanSave then
			Registry.Data.Save(player, true)
		end
		Registry.Data.Remove(player)
		return
	end
	if not profile.CanSave and not RunService:IsStudio() then
		player:Kick("Não deu pra carregar seu progresso agora (Roblox ocupado). Ele tá salvo, entra de novo. / Could not load your progress right now. It is safe, please rejoin.")
		return
	end
	player:SetAttribute("Loaded", true)
	local data = profile.Data
	local ctx = Registry.Game.Ctx(player)
	local now = os.time()
	-- renda offline (só dos negócios com gerente) e missões do dia
	pcall(Sim.Offline, Config, data, ctx, now)
	data.LastSeen = now
	pcall(Sim.CheckDaily, Config, data, ctx, now)

	local plot = Registry.Plots.Assign(player)
	if not plot then
		player:Kick("Servidor cheio. Tenta outro. / Server is full, try another one.")
		return
	end
	task.spawn(Registry.Store.CheckPasses, player)
	task.spawn(Registry.Game.RefreshSocial, player)
	Registry.Game.Push(player)
	player:LoadCharacter()
end

local function onPlayerRemoving(player: Player)
	-- moedas e gorjetas que ficaram no chão entram na conta antes de salvar (senão sumiriam com o terreno)
	pcall(Registry.Farm.Sweep, player)
	-- devolve o terreno JÁ (antes das chamadas que esperam a internet): daqui em diante nada mais cai no chão
	pcall(Registry.Plots.Release, player)
	Registry.Remotes.RemovePlayer(player)
	-- v6: salva PRIMEIRO (o placar espera a internet e atrasava o save; se o jogador já entrou em outro
	-- servidor nesse meio tempo, o save podia ser recusado)
	Registry.Data.Save(player, true)
	pcall(Registry.Leaderboard.Write, player)
	Registry.Data.Remove(player)
end

Players.CharacterAutoLoads = false -- nasce só depois de carregar os dados e ganhar a granja
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- ---------------------------------------------------------------------------
-- Ferramenta de teste: SÓ existe no Studio. Na barra de comandos (modo Servidor), por exemplo:
--   game.ServerStorage.VUODebug:Invoke("coins", 1e9)   moedas
--   game.ServerStorage.VUODebug:Invoke("stars", 500)   estrelas;  ("earned", 1e12) ganho desde o último selo
--   game.ServerStorage.VUODebug:Invoke("buy", 20)      compra os próximos 20 botões
--   game.ServerStorage.VUODebug:Invoke("tp", "next")   leva ao próximo botão; "sell", "home", "inc" ou um
--                                                      número de 1 a 8 (ponto de abrir/trabalhar do negócio)
--   game.ServerStorage.VUODebug:Invoke("event", "rain")  começa um evento ("rain", "gift", "race", "order")
--   game.ServerStorage.VUODebug:Invoke("rare", "m")    faz aparecer um ovo raro num ninho ("s", "g" ou "m")
--   game.ServerStorage.VUODebug:Invoke("tips", 6)      põe gorjetas no chão da banca
--   game.ServerStorage.VUODebug:Invoke("bag")          faz cair um saco de dinheiro agora;  ("bag", "gold") um dourado
--   game.ServerStorage.VUODebug:Invoke("weather", "chuva")  troca o clima agora ("limpo", "sol", "chuva", "vento", "noite",
--                                                      "arcoiris");  ("weather", "stop") para o rodízio;  ("weather", "auto") religa
--   game.ServerStorage.VUODebug:Invoke("key")          faz nascer uma chave secreta agora;  ("keys", 3) põe 3 chaves na mão
--   game.ServerStorage.VUODebug:Invoke("power", "galo")  usa um poder sem esperar a recarga ("galo", "moedas", "sorte");
--                                                      ("refill") deixa todos os poderes prontos
--   game.ServerStorage.VUODebug:Invoke("egg", "s")     ovo raro direto na cesta;  ("hatch") nasce já;  ("pet", "pata:g")
--   game.ServerStorage.VUODebug:Invoke("spins", 5)     giros;  ("giant", 1) enche o Ovo Gigante;  ("obby") vai ao baú
--   game.ServerStorage.VUODebug:Invoke("pass", "VIP")  liga um passe da loja sem comprar ("todos" = todos);
--                                                      ("nopass") tira todos;  ("product", "PacoteInicial") entrega um produto
--   game.ServerStorage.VUODebug:Invoke("info")
-- ---------------------------------------------------------------------------
if RunService:IsStudio() then
	local Layout = require(ReplicatedStorage.Shared.Layout)
	local debugFn = Instance.new("BindableFunction")
	debugFn.Name = "VUODebug"
	debugFn.OnInvoke = function(command: any, value: any): string
		local player = Players:GetPlayers()[1]
		local data = player and Registry.Game.Data(player)
		local plot = player and Registry.Plots.Of(player)
		if not player or not data or not plot then
			return "sem jogador carregado"
		end
		if command == "coins" then
			data.Coins = tonumber(value) or 0
		elseif command == "stars" then
			data.Stars = tonumber(value) or 0
			data.StarsTotal = math.max(data.StarsTotal, data.Stars)
		elseif command == "earned" then
			data.SealEarned = tonumber(value) or 0
		elseif command == "buy" then
			for _ = 1, tonumber(value) or 1 do
				local button = Sim.NextButton(Config, data)
				if not button then
					break
				end
				data.Coins = math.max(data.Coins, button.Cost)
				Registry.Farm.TryBuy(player, plot, button)
			end
		elseif command == "tp" then
			local point = Layout.Spawn
			local biz = Layout.Biz[tonumber(value) or 0]
			if biz then
				point = biz.U
			elseif value == "next" then
				local button = Sim.NextButton(Config, data)
				point = if button then Registry.Plots.ButtonPoint(button) else point
			elseif value == "sell" then
				point = Layout.Sell
			elseif value == "inc" then
				point = Layout.Incubators[1]
			end
			if player.Character then
				player.Character:PivotTo(Registry.Plots.CF(plot, point[1], point[2], 180, 4))
			end
		elseif command == "event" then
			if value == "order" then
				Registry.Events.ForceOrder(player)
			else
				return tostring(Registry.Events.Force(tostring(value)))
			end
		elseif command == "rare" then -- ovo raro num ninho: "s", "g" ou "m" (precisa da Granja aberta)
			local egg = Sim.SpawnRare(Config, data, plot.Run, math.random, if Config.MutationById[value] then value else "s")
			if not egg then
				return "sem Granja aberta ou ninhos cheios"
			end
			Registry.Farm.RareSpawned(player, plot, { egg })
		elseif command == "tips" then -- gorjetas no chão da banca (até Config.TipMax)
			plot.Run.Tips = math.clamp(math.floor(tonumber(value) or Config.TipMax), 0, Config.TipMax)
			Registry.Plots.SetTips(plot, plot.Run.Tips)
		elseif command == "bag" then -- saco de dinheiro agora (troca o que estiver no chão): ("bag") normal, ("bag", "gold") dourado
			plot.Run.Bag = nil
			if not Registry.Farm.DropBag(player, plot, value == "gold") then
				Registry.Plots.SyncBag(plot)
				return "sem banca aberta: o saco de dinheiro só cai para quem já abriu a banca"
			end
		elseif command == "weather" then -- clima agora: id do Config.Weather; "stop" / "auto" = para / religa o rodízio
			local W = Registry.Weather
			if value == "stop" or value == "auto" then
				W.Auto = value == "auto"
				return "rodízio do clima " .. (if W.Auto then "ligado" else "parado") .. " (clima de agora: " .. tostring(W.Current) .. ")"
			elseif not W.Force(value) then
				local ids = {}
				for _, def in Config.Weather.List do
					table.insert(ids, def.Id)
				end
				return "clima desconhecido: " .. tostring(value) .. " (use " .. table.concat(ids, ", ") .. ", stop ou auto)"
			end
		elseif command == "key" then -- nasce uma chave secreta agora (num lugar longe do jogador)
			if not Registry.Farm.DropKey(player, plot) then
				return if not Sim.KeysOpen(Config, data)
					then "sem chave: as chaves secretas só aparecem depois de abrir " .. Config.Keys.MinBiz .. " negócios"
					elseif plot.Run.Key then "já tem uma chave escondida no terreno (lugar " .. tostring(plot.Run.Key.Spot) .. ")"
					else "já está com todas as chaves na mão: abra o Baú Secreto"
			end
		elseif command == "keys" then -- põe n chaves na mão (0 a Config.Keys.Need)
			data.Keys = math.clamp(math.floor(tonumber(value) or Config.Keys.Need), 0, Config.Keys.Need)
			Registry.Plots.SyncChest(plot)
		elseif command == "power" then -- usa o poder agora, sem esperar a recarga (trancado continua trancado)
			if type(value) ~= "string" or not Config.PowerById[value] then
				return "poder desconhecido: " .. tostring(value)
			end
			data.Powers[value] = nil
			local ok, reason = Registry.Farm.UsePower(player, value, true)
			if not ok then
				return "não usou o poder " .. value .. ": " .. tostring(reason)
			end
		elseif command == "refill" then -- todos os poderes prontos
			data.Powers = {}
		elseif command == "egg" then -- põe um ovo raro direto na cesta: "s", "g" ou "m"
			local line = Config.Lines[math.max(1, Sim.BestLine(Config, data))]
			local key = Sim.EggKey(line.Id, if Config.MutationById[value] then value else "s")
			data.Basket[key] = (data.Basket[key] or 0) + 1
		elseif command == "hatch" then -- faz os ovos das chocadeiras nascerem agora
			for _, hatch in data.Hatch do
				hatch.Ready = os.time()
			end
			Registry.Plots.SyncHatch(plot)
		elseif command == "pet" then -- ganha um pet: "branco:s", "dragao:m", "ovinho:ouro"...
			Sim.AddPet(Config, data, Registry.Game.Ctx(player), tostring(value))
		elseif command == "spins" then
			Sim.AddSpins(Config, data, tonumber(value) or 1)
		elseif command == "giant" then -- enche o Ovo Gigante (0 a 1)
			Registry.Events.GiantFill(tonumber(value) or 1)
		elseif command == "pass" or command == "nopass" or command == "product" then -- loja em Robux, sem gastar nada
			return Registry.Store.Debug(player, command, value)
		elseif command == "obby" then
			local chest = Layout.Obby.Chest
			if player.Character then
				player.Character:PivotTo(CFrame.new(chest[1], chest[2] + 3, chest[3]))
			end
		end
		Registry.Game.Push(player)
		local auto, all = Sim.Income(Config, data, Registry.Game.Ctx(player))
		return ("moedas %s | no chão %s | estrelas %d | botoes %d/%d | negócios %d | aves %d | renda %s/s (com gerente %s/s) | cesta %d | renascimentos %d | selo %d"):format(
			tostring(data.Coins), tostring(Sim.GroundTotal(plot.Run)), data.Stars, Sim.Count(data.Owned), #Config.Buttons, Sim.BizCount(Config, data), Sim.BirdCount(Config, data), tostring(all), tostring(auto), Sim.BasketCount(data), data.Rebirths, data.Seal
		)
	end
	debugFn.Parent = game:GetService("ServerStorage")
end

-- Salva todo mundo de tempos em tempos
task.spawn(function()
	while true do
		task.wait(60)
		for _, player in Players:GetPlayers() do
			task.spawn(Registry.Data.Save, player)
		end
	end
end)

-- Salva quando o servidor fecha
game:BindToClose(function()
	local pending = 0
	for _, player in Players:GetPlayers() do
		pending += 1
		task.spawn(function()
			pcall(Registry.Farm.Sweep, player) -- o que está no chão entra na conta antes do último save
			Registry.Data.Save(player, true)
			pcall(Registry.Leaderboard.Write, player)
			pending -= 1
		end)
	end
	local started = os.clock()
	while (pending > 0 or Registry.Data.ActiveSaves() > 0) and os.clock() - started < 25 do
		task.wait(0.1)
	end
end)
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="SoundService" referent="R7003">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="R6993">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">70</float>
      <float name="CharacterWalkSpeed">18</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="R6992">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="R6989">
        <Properties>
          <string name="Name">ClientMain</string>
          <ProtectedString name="Source"><![CDATA[--[[
	VENDA UM OVO - tela do jogador (LocalScript em StarterPlayerScripts). Versão 4: tycoon de 8 negócios.
	Só MOSTRA as coisas e PEDE ações ao servidor. Nenhum valor de moeda sai daqui.
	Módulos filhos: UI (peças de interface) e World (efeitos no mapa: botões, banca, tapetes, pets, seta, eventos).

	Tela enxuta (filhos do quadro raiz "Root"):
	  em cima     Top (pílulas pequenas: estrelas, cesta de ovos raros, chaves secretas), Giant (Mega Ovo) e
	              Weather (chip do clima) LADO A LADO (um embaixo do outro só em tela estreita), Banner, Toasts
	  esquerda    Side: 5 botões (Biz = Negócios, Pets, Rebirth, Prizes, Shop); cada um abre um painel (com abas)
	  direita     Right: Home, Plaza, Settings;   Sell: o botão redondo VENDER (aparece perto da banca);
	              Powers: os 3 poderes, em fila, à esquerda do VENDER (e PowerHint, a explicação de um poder)
	  embaixo     no meio, de baixo para cima: Coins (o CONTADOR DE MOEDAS: a peça principal de baixo, colada no
	              fundo, com a renda por segundo), BuyNext (comprar de longe, quando existe), Tip (uma dica
	              por vez), Work (barra do ciclo feito na mão)
	No celular a coluna da esquerda sobe (o joystick fica embaixo) e o VENDER fica logo acima do botão de pulo.
	Quem arruma o que depende do tamanho da tela é a tabela Hud (Hud.Top e Hud.Bottom).
	Versão 5 (clima, chaves/Baú Secreto, poderes): tudo que é dela na tela mora na tabela V5 (função V5.Build).
]]

local LocalizationService = game:GetService("LocalizationService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Lang = require(Shared:WaitForChild("Lang"))
local Sim = require(Shared:WaitForChild("Sim"))
local UI = require(script:WaitForChild("UI"))
local World: any = require(script:WaitForChild("World"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local C = UI.C
local new = UI.New
local T = Lang.T
local short = Format.Short

local state: any = nil
local langChosen = false
-- Loja em Robux: funções e memória das ofertas (preenchido mais abaixo, junto do painel da Loja).
-- Uma tabela só, e não vários "local": este script já está perto do limite de 200 locais do Luau.
local Loja: any = { NoMoney = {}, Hinted = false }
-- Versão 5 (clima, chaves secretas, poderes): a mesma ideia, uma tabela só (montada em V5.Build, mais abaixo).
local V5: any = {}
-- Arrumação da tela (o que fica em cima e o que fica embaixo, em cada tamanho de tela): idem (ver Hud.Top / Hud.Bottom).
local Hud: any = {}

-- idioma: português para quem usa o Roblox em português; inglês para o resto
do
	local ok, locale = pcall(function()
		return LocalizationService.RobloxLocaleId
	end)
	Lang.Set(if ok and type(locale) == "string" and string.sub(string.lower(locale), 1, 2) == "pt" then "pt" else "en")
end

local function request(action: string, a: any?, b: any?)
	Remotes.Request:FireServer(action, a, b)
end

-- ---------------------------------------------------------------------------
-- Leitura segura do estado. O servidor novo pode demorar a mandar um campo (ou mandar nil):
-- a tela nunca pode travar por isso, então todo campo passa por num()/tbl().
-- ---------------------------------------------------------------------------
local EMPTY: any = {}

local function num(value: any, default: number?): number
	local n = tonumber(value)
	if n == nil or n ~= n then
		return default or 0
	end
	return n
end

local function tbl(value: any): any
	return if type(value) == "table" then value else EMPTY
end

-- Negócio i como o servidor mandou em state.Biz. Se ainda não veio, faz a mesma conta do Sim com o que
-- a tela já tem (botões comprados e multiplicadores gerais): é só para MOSTRAR, nunca para pagar.
local function bizOf(index: number): any
	local sent = tbl(state and state.Biz)[index]
	if type(sent) == "table" then
		return sent
	end
	local def = Config.Businesses[index]
	local info = Sim.BizInfo(Config, { Owned = tbl(state and state.Owned) }, index)
	if def and info.Unlocked then
		info.Payout = def.Payout * info.Cash * num(state.Cash, 1)
		info.Cycle = def.Cycle / math.max(info.Speed * num(state.Speed, 1), 0.001)
		info.Income = info.Payout / info.Cycle
	end
	return info
end

-- Moedas no chão do negócio i. O Tick manda a lista Ground (mais nova que o Ground de cada state.Biz).
local function groundOf(index: number): number
	local list = state and state.Ground
	if type(list) == "table" then
		return num(list[index] or list[tostring(index)])
	end
	return num(bizOf(index).Ground)
end

local function groundTotal(): number
	local total = 0
	for index in Config.Businesses do
		total += groundOf(index)
	end
	return total
end

-- O próximo botão a comprar (o servidor manda o id; sem ele, a mesma regra do Sim)
local function nextButtonOf(): any?
	if not state then
		return nil
	end
	local button = if state.Next ~= nil then Config.ButtonById[state.Next] else nil
	if button == nil and state.Next == nil and state.Owned ~= nil then
		button = Sim.NextButton(Config, { Owned = tbl(state.Owned) })
	end
	return button
end

-- string.upper não conhece acento ("mítico" virava "MíTICO"): sobe também as letras acentuadas (UTF-8 C3 A0..BE)
local function upper(text: string): string
	return (string.gsub(string.upper(text), "\195([\160-\190])", function(c: string)
		return "\195" .. string.char(string.byte(c) - 32)
	end))
end

-- segundos de um ciclo: "0.4s", "3.0s", "0:12"
local function secs(seconds: number): string
	if seconds < 0.1 then
		return "<0.1s" -- ciclo tão rápido que "0.0s" pareceria erro
	end
	return if seconds < 10 then string.format("%.1fs", seconds) else Format.Time(seconds)
end

