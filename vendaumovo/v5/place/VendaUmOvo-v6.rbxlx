-- ---------------------------------------------------------------------------
-- HUD
-- ---------------------------------------------------------------------------
local eventBanner: { Text: string, Ends: number }? = nil
local lastCoins = 0
local isNear = false -- perto da banca (o World responde; conferido algumas vezes por segundo)
local lastWorkAt = -100 -- os.clock() da última vez em que havia um ciclo na mão em andamento
local workFx: { Biz: number, Start: number, Len: number }? = nil -- último Fx "work" (reserva se o World não souber)
local workShown: number? = nil -- negócio escrito na barra de trabalho (para não refazer o texto todo quadro)

local function hatchReady(): boolean
	if not state then
		return false
	end
	local now = workspace:GetServerTimeNow()
	for _, hatch in tbl(state.Hatch) do
		if type(hatch) == "table" and num(hatch.ReadyAt, math.huge) <= now then
			return true
		end
	end
	return false
end

-- Ciclo na mão em andamento: (índice do negócio, fração 0..1). Quem sabe é o World (tapete azul);
-- se ele ainda não tiver a função, vale o último Fx "work" (o servidor manda a duração).
local function workInfo(): (number?, number)
	if World.WorkInfo then
		local ok, index, fraction = pcall(World.WorkInfo)
		if ok then
			return tonumber(index), math.clamp(num(fraction), 0, 1)
		end
	end
	local w = workFx
	if w then
		local elapsed = os.clock() - w.Start
		if elapsed <= w.Len + 0.3 then
			return w.Biz, math.clamp(elapsed / w.Len, 0, 1)
		end
		workFx = nil
	end
	return nil, 0
end

-- Tutorial: uma frase por vez, a mais importante primeiro. Só no começo (os primeiros TIP_BUTTONS botões
-- da vida); as dicas de pet valem até o jogador ter chocado alguns.
local TIP_BUTTONS = 20
local function pickTip(): string
	if not state then
		return ""
	end
	local early = num(state.Buttons) < TIP_BUTTONS
	local banca = bizOf(1)
	if not banca.Unlocked then
		return if early then "tip.first" else ""
	end
	-- saco de dinheiro no meu terreno (state.Bag vem no Tick): tem hora para sumir, então passa na frente das
	-- outras dicas. Só até ele ter pegado alguns: depois o aviso, o facho de luz e a seta já bastam.
	local bag = state.Bag
	if type(bag) == "table" and num(state.Bags) < 3 and num(bag.Until) > workspace:GetServerTimeNow() then
		return "tip.bag"
	end
	-- Baú Secreto com as chaves todas na mão: a seta de ajuda já aponta para ele; a dica diz o que fazer
	if V5.ChestReady() then
		return "tip.chest"
	end
	local hatched = num(state.Hatched)
	if hatched < 3 and hatchReady() then
		return "tip.hatchReady"
	end
	local coins = num(state.Coins)
	local nextButton = nextButtonOf()
	local working = os.clock() - lastWorkAt < 2.5 -- com folga: entre um ciclo e outro o jogador continua no tapete
	local clicking = isNear and not banca.Manager
	if early then
		-- 1) gastar: o gerente da banca é a compra que muda o jogo (começa a render sozinho)
		local manager = Config.ButtonById.banca_gerente
		if manager and not banca.Manager and coins >= manager.Cost then
			return "tip.manager"
		end
		if nextButton and coins >= nextButton.Cost then
			return "tip.buy"
		end
		-- 2) moedas no chão: quando elas já pagam o próximo botão, quando o jogador está à toa, ou gorjetas juntando
		local ground = groundTotal()
		local enough = nextButton ~= nil and coins + ground >= nextButton.Cost
		if (ground > 0 and (enough or not (working or clicking))) or num(state.Tips) >= math.ceil(Config.TipMax / 2) then
			return "tip.coins"
		end
	end
	-- 3) ovos raros: cesta -> chocadeira (ou balcão); ninho -> cesta
	if state.Mutant and state.HatchFree and hatched < 3 then
		return "tip.hatch"
	elseif state.Mutant and num(state.HatchSlots) <= 0 and hatched < 1 then
		return "tip.rare"
	end
	if not early then
		return ""
	end
	-- state.Rare é a LISTA dos ovos raros que estão nos ninhos ({ Line, Slot, Mut }), como vem no State e no Tick
	if #tbl(state.Rare) > 0 and num(state.BasketCount) < num(state.BasketCap, 1) then
		return "tip.rareNest"
	end
	-- 4) produzir: clicar na banca (sem gerente) ou ficar no tapete azul de um negócio sem gerente
	if clicking then
		return "tip.click"
	end
	if not working then
		for index = 2, #Config.Businesses do
			local b = bizOf(index)
			if b.Unlocked and not b.Manager then
				return "tip.work"
			end
		end
		if not banca.Manager and num(state.Auto) <= 0 then
			return "tip.banca" -- sem renda nenhuma e longe da banca: volta para lá
		end
	end
	return ""
end

local tipKey = ""
local lastPulse = 0
local function updateTip()
	local key = pickTip()
	if key == "" and state then
		key = V5.Tip() -- dicas da versão 5 (chave, poder, clima): só quando o tutorial não tem nada a dizer
	end
	local fresh = key ~= tipKey
	if fresh then
		tipKey = key
		tip.Text = if key == "" then "" else T(key)
	end
	-- com um painel aberto a dica não aparece (ficaria por baixo dele); volta quando ele fecha
	local show = key ~= "" and UI.OpenPanel == nil
	if show ~= tip.Visible then
		tip.Visible = show
		Hud.Bottom() -- (a barra de trabalho sobe ou desce conforme a dica)
	end
	if fresh and show then
		UI.Pop(tip, 1.08)
	end
	-- enquanto a dica manda tocar em VENDER, o botão pulsa de leve para a criança achar
	if key == "tip.click" and sell.Visible and holdInput == nil and os.clock() - lastPulse > 1.8 and os.clock() - lastClick > 1.2 then
		lastPulse = os.clock()
		UI.Pop(sell, 1.1)
	end
end
Hud.PanelChanged = function()
	updateTip()
	if UI.OpenPanel ~= nil then
		workBar.Visible = false -- (a barra de trabalho volta sozinha no próximo quadro depois que o painel fecha)
	end
	Hud.Bottom() -- os painéis ficam entre as pílulas de cima e o contador de moedas
end

-- Moedas voando do meio da tela até a moeda grande do contador (embaixo, no meio); o NÚMERO dá o pulinho
function Hud.Fly(amount: number)
	UI.FlyCoins(gui, Hud.CoinIcon, amount, nil, coinText)
end

-- v6: o próximo degrau do prêmio por tempo jogado (ou o Baú do Grupo) já pode ser pego?
local function playReadyNow(): boolean
	local now = workspace:GetServerTimeNow()
	if state and state.InGroup and Config.GroupId > 0 and num(state.GroupChestAt) <= now then
		return true
	end
	local step = Config.PlayRewards[num(player:GetAttribute("PlayClaimed")) + 1]
	local start = player:GetAttribute("PlayStart")
	return step ~= nil and type(start) == "number" and now >= start + step.Minutes * 60
end

local function updateHud()
	if not state then
		return
	end
	local coins = num(state.Coins)
	-- v6: ganho grande "conta" até o número novo (0,6 s); renda pingando e gasto mudam na hora
	if coins > lastCoins * 1.02 + 5 and lastCoins > 0 then
		Hud.RollFrom, Hud.RollTo, Hud.RollAt = Hud.RollShown or lastCoins, coins, os.clock()
	else
		Hud.RollTo, Hud.RollShown = nil, nil
		coinText.Text = short(coins)
	end
	-- o número "pula" quando o dinheiro sobe: forte quando sobe de uma vez (moedas do chão, prêmio), bem de
	-- leve e no máximo uma vez por segundo quando é a renda dos gerentes pingando
	if coins > lastCoins and lastCoins > 0 then
		local clock = os.clock()
		if coins > lastCoins * 1.02 + 5 then
			Hud.PopAt = clock
			Hud.Gain(true)
		elseif clock - num(Hud.PopAt) >= 1 then
			Hud.PopAt = clock
			Hud.Gain(false)
		end
	end
	lastCoins = coins
	local auto = num(state.Auto)
	rateText.Text = if auto > 0 then T("hud.perSec", { n = short(auto) }) else ""
	if rateText.Visible ~= (auto > 0) then
		rateText.Visible = auto > 0
		Hud.Bottom() -- (sem a renda ao lado, o número ocupa a placa toda)
	end
	local stars = num(state.Stars)
	starText.Text = short(stars)
	starPill.Visible = stars > 0 or num(state.StarsTotal) > 0 or num(state.StarsGain) > 0
	-- cesta de OVOS RAROS: só existe depois que a Granja abre (ou se sobrou ovo de antes de renascer)
	local count, cap = num(state.BasketCount), num(state.BasketCap)
	basketPill.Visible = bizOf(2).Unlocked == true or count > 0
	basketText.Text = ("%d/%d"):format(count, cap)
	local fill = math.clamp(count / math.max(cap, 1), 0, 1)
	basketFill.Size = UDim2.new(fill, 0, 1, 0)
	basketFill.BackgroundColor3 = if fill >= 1 then C.Red else C.Green
	-- valor de um toque no VENDER: um ciclo da banca feito na mão (quem paga é o servidor; aqui é só o letreiro)
	sellValue.Text = T("pop.reward", { n = short(num(bizOf(1).Payout) * num(state.Hand, 1)) })
	petsBadge.Visible = hatchReady()
	prizesBadge.Visible = num(state.GiftLeft) <= 0 or state.StreakCan == true or num(state.Spins) > 0 or playReadyNow()
	rebirthBadge.Visible = state.CanRebirth == true or state.CanEvolve == true or achievementReady()
	-- comprar de longe
	local nextButton = nextButtonOf()
	if nextButton and num(tbl(state.Talents).remote) > 0 then
		buyNext.Visible = true
		buyNext.Text = T("hud.buyNext", { name = (Lang.Button(Config, nextButton, short)), cost = short(nextButton.Cost) })
		buyNext.BackgroundColor3 = if coins >= nextButton.Cost then C.Green else C.Gray
	else
		buyNext.Visible = false
	end
	V5.Hud()
	Hud.Top() -- (as pílulas aparecem e somem; só mexe na tela quando algo mudou)
	Hud.Bottom() -- (com o botão de comprar de longe o contador sobe um degrau)
	updateTip()
end

applyLanguage = function()
	for l, key in labelKeys do
		if l.Parent then
			l.Text = T(key)
		end
	end
	for _, info in panelTitles do
		info.Label.Text = T(info.Key)
	end
	for _, tab in tabButtons do
		if tab.Button.Parent then
			tab.Button.Text = T(tab.Key)
		end
	end
	tipKey = "" -- a dica e a barra de trabalho são refeitas no idioma novo
	workShown = nil
	V5.Relabel()
	updateHud()
	World.Relabel()
	UI.RefreshOpen()
end

local function mergeTick(t: any)
	if not state or type(t) ~= "table" then
		return
	end
	state.Mutant = nil -- campo nil não viaja: sem isso o "tem ovo raro na cesta" nunca apagava
	for key, value in t do
		state[key] = value
	end
	updateHud()
	World.SetState(state)
end

Remotes:WaitForChild("State").OnClientEvent:Connect(function(newState: any)
	if type(newState) ~= "table" then
		return
	end
	local first = state == nil
	state = newState
	if first or not langChosen then
		local settings = tbl(state.Settings)
		local saved = settings.Lang
		if (saved == "pt" or saved == "en") and saved ~= Lang.Current then
			Lang.Set(saved)
			applyLanguage()
		end
		langChosen = true
		if settings.Sfx == false then
			UI.SfxOn = false
		end
		if settings.Arrow == false then
			World.ArrowOn = false
		end
		if settings.Light == true then
			World.SetLight(true)
		end
		if settings.Music == false then
			musicOn = false
		end
		applyMusic()
	end
	updateHud()
	World.SetState(state)
	UI.RefreshOpen()
	showOffline()
	if Loja.OfflineRefresh then
		Loja.OfflineRefresh()
	end
end)

Remotes:WaitForChild("Tick").OnClientEvent:Connect(mergeTick)

Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(key: string, args: any, kind: string?)
	args = if type(args) == "table" then args else {}
	-- nomes que vêm como id (negócio, ave, selo, pet) viram texto no idioma do jogador
	if args.biz ~= nil then
		local def = Config.Businesses[args.biz] -- aceita índice...
		args.biz = T("biz." .. (if def then def.Id else tostring(args.biz))) -- ...ou id
	end
	if args.line ~= nil then
		local line = Config.Lines[args.line]
		local id = if line then line.Id else tostring(args.line)
		-- quem acha um mítico acha um OVO; nos outros avisos o assunto é a ave
		args.line = if key == "n.mythic" then T("egg." .. id) else T("bird." .. id)
	end
	if args.seal ~= nil then
		args.seal = T("seal." .. tostring(args.seal))
	end
	if args.pet ~= nil then
		args.pet = petName(tostring(args.pet))
	end
	if args.pass ~= nil then
		args.pass = T("pass." .. tostring(args.pass)) -- nome do passe comprado
	end
	UI.Toast(T(tostring(key), args), kind)
	if kind == "error" then
		UI.Sound("Erro", 0.5)
	end
end)

-- relógios na tela (evento, boosts, presente, Ovo Gigante) contados no cliente
local function everySecond()
	if state then
		local now = workspace:GetServerTimeNow()
		local parts = {}
		if eventBanner then
			local left = eventBanner.Ends - os.clock()
			if left > 0 then
				table.insert(parts, ("%s  %s"):format(eventBanner.Text, Format.Time(left)))
			else
				eventBanner = nil
			end
		end
		for key, ends in tbl(state.Boosts) do
			local left = num(ends) - now
			if left > 0 then
				table.insert(parts, ("%s %s"):format(T("boost." .. tostring(key)), Format.Time(left)))
			end
		end
		banner.Text = table.concat(parts, "   ")
		local giftLeft = num(state.GiftLeft)
		if giftLeft > 0 then
			state.GiftLeft = giftLeft - 1
		end
		-- contagens regressivas dos painéis: só o texto muda; quando uma chega a zero, o painel é refeito 1 vez
		if UI.TickLive() and UI.OpenPanel and not (UI.OpenPanel == "Wheel" and wheelSpinning) then
			UI.RefreshOpen()
		end
		petsBadge.Visible = hatchReady()
		if not prizesBadge.Visible and playReadyNow() then
			prizesBadge.Visible = true
		end
		if playClock and playClock.Parent and UI.OpenPanel == "Playtime" then
			playClock.Text = T("play.clock", { t = Format.Time(playedSeconds()) })
		end
		Hud.PlayChip()
	end
	-- Ovo Gigante
	local progress, giantState, crackAt = World.GiantInfo()
	if (progress ~= nil) ~= giantBar.Visible then
		giantBar.Visible = progress ~= nil
		Hud.Top() -- (o chip do clima dá lugar ao Mega Ovo, ou fica com a fila toda)
	end
	if progress then
		giantFill.Size = UDim2.new(math.clamp(progress, 0, 1), 0, 1, 0)
		if giantState == "crack" then
			local left = math.max(0, (crackAt or 0) - workspace:GetServerTimeNow())
			giantText.Text = T("giant.cracking", { t = math.ceil(left) })
			giantFill.BackgroundColor3 = C.Red
		else
			giantText.Text = T("giant.bar", { n = math.floor(progress * 100) })
			giantFill.BackgroundColor3 = C.Yellow
		end
	end
end

-- v6: o contador de moedas rolando até o valor novo (ver updateHud)
RunService.RenderStepped:Connect(function()
	local target = Hud.RollTo
	if not target then
		return
	end
	local t = math.clamp((os.clock() - Hud.RollAt) / 0.6, 0, 1)
	local eased = 1 - (1 - t) ^ 3
	local shown = Hud.RollFrom + (target - Hud.RollFrom) * eased
	Hud.RollShown = shown
	coinText.Text = short(math.floor(shown))
	if t >= 1 then
		Hud.RollTo, Hud.RollShown = nil, nil
	end
end)

-- v6: depois de FavoriteAfter segundos jogando nesta visita, pergunta UMA vez na vida se quer favoritar
-- (janela do próprio Roblox). Espera um momento calmo: sem painel aberto.
task.spawn(function()
	local after = num(Config.FavoriteAfter)
	if after <= 0 then
		return
	end
	while true do
		task.wait(10)
		local start = player:GetAttribute("PlayStart")
		if state and state.FavoriteAsked then
			return
		end
		if state and type(start) == "number" and workspace:GetServerTimeNow() - start >= after and not UI.OpenPanel then
			request("FavoriteAsked")
			pcall(function()
				game:GetService("AvatarEditorService"):PromptSetFavorite(game.PlaceId, Enum.AvatarItemType.Asset, true)
			end)
			return
		end
	end
end)

-- v6: lembrete de curtir (uma vez na vida, depois de LikeReminderAfter segundos nesta visita). Cartão
-- pequeno no meio da tela que não segura o toque (só o X), some sozinho em 10 s. Sem prêmio: é proibido.
task.spawn(function()
	local after = num(Config.LikeReminderAfter)
	if after <= 0 then
		return
	end
	while true do
		task.wait(10)
		local start = player:GetAttribute("PlayStart")
		if state and state.LikeAsked then
			return
		end
		if state and type(start) == "number" and workspace:GetServerTimeNow() - start >= after and not UI.OpenPanel then
			request("LikeAsked")
			local f = new("Frame", {
				Name = "LikeReminder",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, 0, 0.5, 0),
				Size = UDim2.fromOffset(440, 110),
				BackgroundColor3 = C.Panel,
				BackgroundTransparency = 0.05,
				Active = false,
				ZIndex = 35,
				Parent = gui,
			}, { UI.Corner(0.18), UI.Stroke(C.Green, 4) })
			if isTouch then
				new("UIScale", { Scale = 0.8, Parent = f })
			end
			UI.Icon("", { Position = UDim2.new(0, 10, 0.12, 0), Size = UDim2.new(0, 76, 0.76, 0), ZIndex = 36, Parent = f }, "👍")
			UI.Label({ Position = UDim2.new(0, 94, 0.08, 0), Size = UDim2.new(1, -170, 0.46, 0), Text = T("like.title"), TextXAlignment = Enum.TextXAlignment.Left, Dark = true, MaxText = 26, ZIndex = 36, Parent = f })
			UI.Label({ Position = UDim2.new(0, 94, 0.54, 0), Size = UDim2.new(1, -170, 0.38, 0), Text = T("like.desc"), TextXAlignment = Enum.TextXAlignment.Left, Dark = true, TextColor3 = C.Brown, Font = UI.Font2, MaxText = 18, ZIndex = 36, Parent = f })
			UI.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(60, 60), Text = "X", BackgroundColor3 = C.Gray, ZIndex = 36, Parent = f }, function()
				f:Destroy()
			end)
			UI.Pop(f, 0.8)
			task.delay(10, UI.Vanish, f)
			return
		end
	end
end)

player:GetAttributeChangedSignal("PlayClaimed"):Connect(function()
	Hud.PlayChip()
	if UI.OpenPanel == "Playtime" then
		UI.RefreshOpen()
	end
end)

task.spawn(function()
	while true do
		task.wait(1)
		-- um erro aqui (campo estranho no estado, World em obras) não pode parar os relógios para sempre
		local ok, err = pcall(everySecond)
		if not ok then
			warn("[VendaUmOvo] relógio da tela: " .. tostring(err))
		end
	end
end)

-- ---------------------------------------------------------------------------
-- Todo quadro: dedo parado no VENDER e barra de trabalho. Algumas vezes por segundo: o botão VENDER
-- aparece/some (perto da banca) e a dica muda (ela depende de onde o jogador está, não só do servidor).
-- Uma conexão só, para a vida toda da tela.
-- ---------------------------------------------------------------------------
local function nearBanca(): boolean
	if not state or bizOf(1).Unlocked ~= true then
		return false
	end
	if World.NearBanca then
		local ok, near = pcall(World.NearBanca)
		if ok then
			return near == true
		end
	end
	-- o World ainda não sabe responder: o botão fica à mostra (o servidor confere a distância de qualquer jeito)
	return true
end

local slowAt = 0
RunService.RenderStepped:Connect(function()
	local now = os.clock()
	-- segurar o dedo (ou a tecla) repete o toque sozinho
	local held = holdInput
	if held and (held.UserInputState == Enum.UserInputState.End or held.UserInputState == Enum.UserInputState.Cancel) then
		releaseHold()
	end
	if holdInput ~= nil or next(holdKeys) ~= nil then
		if not sell.Visible then
			releaseHold()
			table.clear(holdKeys)
		elseif now - lastClick >= HOLD_EVERY then
			sellTap()
		end
	end
	-- barra de trabalho
	local index, fraction = workInfo()
	local def = index and Config.Businesses[index]
	if def then
		lastWorkAt = now
		if workShown ~= index then
			workShown = index
			workText.Text = ("%s  %s"):format(T("biz." .. def.Id), T("work.busy"))
			workFill.BackgroundColor3 = def.Color
		end
		workFill.Size = UDim2.new(fraction, 0, 1, 0)
		workBar.Visible = UI.OpenPanel == nil -- (com um painel aberto ela ficaria por baixo dele)
	elseif workBar.Visible and now - lastWorkAt > 0.4 then
		-- 0,4 s de folga: entre um ciclo e o seguinte a barra não pisca
		workBar.Visible = false
		workShown = nil
	end
	if now >= slowAt then
		slowAt = now + 0.2
		local near = nearBanca()
		isNear = near
		if sell.Visible ~= near then
			sell.Visible = near
			if near then
				UI.Pop(sell, 0.6) -- chega "pulando": é o botão mais importante do começo
			end
		end
		V5.Slow() -- relógio do clima e dos poderes
		updateTip()
	end
end)

-- ---------------------------------------------------------------------------
-- Efeitos pedidos pelo servidor: Fx(tipo, posição?, valor, extra). Um tratador por tipo.
-- ---------------------------------------------------------------------------
local FX: { [string]: (position: Vector3?, value: any, extra: any) -> () } = {}

-- v6: prêmio do dia a dia (missão, presente, curtida, tempo jogado...) vira um aviso pequeno no canto;
-- o texto grande fica só para compra, renda offline e VIP
local BIG_REWARDS = { robux = true, offline = true, vip = true }
local function rewardPopup(value: number, source: any)
	if BIG_REWARDS[source] then
		UI.BigPopup(gui, T("pop.reward", { n = short(value) }), C.Yellow, 1.8)
	else
		UI.Toast(T("pop.reward", { n = short(value) }), "success")
	end
	World.CoinBurst(nil, 12)
	Hud.Fly(8)
	UI.Sound("Premio", 0.7, 1, 0.05)
	if source == "offline" then
		offlineShown = true
	end
end

-- clique na banca: muitos por segundo, então texto e som têm limite (senão vira barulho e chuva de números)
local lastClickPop = 0
local lastClickSound = 0
FX.click = function(position, value)
	if World.BancaSale then
		pcall(World.BancaSale)
	end
	local now = os.clock()
	if now - lastClickPop >= 0.18 then
		lastClickPop = now
		local text = "+" .. short(num(value))
		if sell.Visible then
			UI.Rise(sell, text, C.Yellow)
		elseif position then
			World.FloatText(position, text, C.Yellow) -- clicou direto na banca, de longe do botão
		end
	end
	if now - lastClickSound >= 0.4 then
		lastClickSound = now
		UI.Sound("Vender", 0.22, 0.95 + math.random() * 0.2)
	end
end

-- começou um ciclo na mão: guarda para a barra de trabalho (o World, quando sabe, tem prioridade)
FX.work = function(_position, value, extra)
	local index = tonumber(value)
	if index and Config.Businesses[index] then
		workFx = { Biz = index, Start = os.clock(), Len = math.max(num(extra, 1), 0.05) }
	end
end

local lastWorkSound = 0
FX.workDone = function(position, value, extra)
	if position then
		World.FloatText(position, "+" .. short(num(value)), C.Yellow)
	end
	if workFx and workFx.Biz == tonumber(extra) then
		workFx = nil
	end
	-- ciclos melhorados chegam a 3 por segundo: o som toca no máximo 2 vezes por segundo
	if os.clock() - lastWorkSound >= 0.5 then
		lastWorkSound = os.clock()
		UI.Sound("Vender", 0.35, 0.85, 0.05) -- ciclo feito na mão: a "caixa registradora", mais grave que a da banca
	end
end

-- alguém pegou dinheiro (moedas do chão, gorjetas, venda de ovo raro): todos veem o texto; o dono vê as moedas voando.
-- Quem clica parado em cima das moedas recebe um "money" a cada passada do servidor (5 por segundo), e os
-- vizinhos também mandam os deles: texto, moedas voando e som têm limite.
local lastMoneyText = { [true] = 0, [false] = 0 } -- [é meu?] = os.clock() do último texto
local lastMoneyFly = 0
FX.money = function(position, value, extra)
	local now = os.clock()
	local mine = extra == player.UserId
	if position and now - lastMoneyText[mine] >= 0.2 then
		lastMoneyText[mine] = now
		World.FloatText(position, "+" .. short(num(value)), C.Yellow)
	end
	if mine and now - lastMoneyFly >= 0.6 then
		lastMoneyFly = now
		if position then
			World.CoinBurst(position, 10)
		end
		Hud.Fly(6)
		UI.Sound("Coletar", 0.5, 1.05, 0.1)
	end
end

FX.tips = function(position, value)
	if position then
		World.FloatText(position + Vector3.new(0, 3, 0), T("pop.tips", { n = short(num(value)) }), C.Green)
	end
	UI.Sound("Coletar", 0.45, 1.3) -- gorjetas: o mesmo "plim" das moedas, mais agudo
end

FX.tipDrop = function(position)
	if position then
		World.Puff(position) -- brilho discreto onde a gorjeta caiu (sem som: cai uma a cada poucos segundos)
	end
end

-- SACO DE DINHEIRO. O saco, o facho de luz, o relógio e a seta são do World (tag VUOBag); aqui só o aviso,
-- o som e as moedas. O servidor manda (Farm.lua):
--   bagDrop  só para o dono:  posição, dourado?, segundos que fica no chão
--   bagTake  para todos:      posição, moedas, { userId de quem pegou, dourado? }
--   bagGone  para todos:      posição, dourado?, userId do dono (sumiu sem ninguém pegar)
FX.bagDrop = function(position, value)
	local golden = value == true
	if golden then
		UI.BigPopup(gui, T("bag.dropGold", { n = num(tbl(Config.MoneyBag).GoldenMult, 1) }), C.Yellow, 2.8)
	else
		UI.Toast(T("bag.drop"), "event")
	end
	UI.Sound("Evento", if golden then 0.7 else 0.45, if golden then 1.25 else 1)
	if position then
		World.Ping(position, C.Yellow)
	end
end

FX.bagTake = function(position, value, extra)
	local info = tbl(extra)
	local golden = info[2] == true
	local amount = num(value)
	-- o "+valor" e o brilho aparecem para todo mundo que está olhando; a festa é só de quem pegou
	if position then
		World.FloatText(position, "+" .. short(amount), C.Yellow)
		World.Puff(position)
	end
	if info[1] ~= player.UserId then
		return
	end
	if golden then
		UI.BigPopup(gui, T("bag.takeGold", { n = short(amount) }), C.Yellow, 2.6)
	else
		UI.Toast(T("bag.take", { n = short(amount) }), "success")
	end
	World.CoinBurst(position, if golden then 16 else 12)
	Hud.Fly(if golden then 12 else 8)
	UI.Sound("Premio", if golden then 0.8 else 0.55, if golden then 1.2 else 1)
	task.delay(0.3, UI.Sound, "Coletar", 0.5, 1.1) -- as moedas chegando no contador
end

FX.bagGone = function(position, _value, extra)
	if position then
		World.Poof(position) -- "puf" de fumaça onde o saco estava
	end
	if extra == player.UserId then
		UI.Toast(T("bag.gone"), "info")
		UI.Sound("Erro", 0.25, 0.8) -- perdeu o saco: um "ah..." baixinho
	end
end

-- apareceu um ovo raro no ninho. Letreiro grande: sempre para o mítico; os comuns só de vez em quando e
-- nunca por cima de um painel (com Sorte alta eles aparecem toda hora).
local RARE_SOUND = { s = 0.7, g = 0.85, m = 1 }
local RARE_TONE = { s = 1.15, g = 1, m = 0.85 } -- quanto mais raro, mais grave e mais alto
local RARE_GAP = { s = 20, g = 8, m = 0 } -- segundos entre letreiros grandes de cada raridade
local lastRarePopup: { [string]: number } = {}
FX.rare = function(position, value)
	local mutation = Config.MutationById[tostring(value)]
	if not mutation then
		return
	end
	local now = os.clock()
	local gap = RARE_GAP[mutation.Id] or 0
	local text = T("pop.mutant", { mut = upper(T("mut." .. mutation.Key)) })
	if now - (lastRarePopup[mutation.Id] or -100) >= gap and (gap == 0 or UI.OpenPanel == nil) then
		lastRarePopup[mutation.Id] = now
		UI.BigPopup(gui, text, mutation.Color, 1.8)
		UI.Sound("Mutante", RARE_SOUND[mutation.Id], RARE_TONE[mutation.Id])
	elseif position then
		World.FloatText(position, text, mutation.Color)
		-- sem letreiro (eles aparecem toda hora com Sorte alta): só um brilho baixinho, no máximo a cada 3 s
		if now - num(V5.RareSoundAt) >= 3 then
			V5.RareSoundAt = now
			UI.Sound("Mutante", 0.25, 1.4)
		end
	end
	if position then
		World.Ping(position, mutation.Color)
		-- Ovo da Sorte (poder): faísca verde no ninho em que o ovo apareceu (o Fx "power" pode vir antes ou depois)
		if V5.LuckAt and now - V5.LuckAt < 3 then
			V5.LuckAt = nil
			World.Puff(position, tbl(tbl(Config.PowerById).sorte).Color)
		else
			V5.Rare = { position, now }
		end
	end
end

FX.pickRare = function(_position, value)
	UI.Toast(T("pop.pickRare", { egg = Lang.Egg(Config, tostring(value)) }), "success")
	UI.Sound("Coletar", 0.6, 1.25)
	UI.Pop(basketPill)
end

FX.sold = function()
	UI.Sound("Vender", 0.75, 0.92) -- venda de ovo raro: a caixa registradora cheia
	UI.Pop(basketPill)
end

FX.album = function(_position, value)
	UI.Toast(T("pop.album", { egg = Lang.Egg(Config, tostring(value)) }), "success")
	task.delay(0.25, UI.Sound, "Premio", 0.4, 1.35) -- figurinha nova (um instante depois do som da venda)
end

-- Comprou um botão do chão: no lugar dele a tampa afunda, sai um anel e confete (o World desenha: o botão de
-- verdade o servidor já apagou). Todo mundo vê; o som é só de quem comprou.
FX.buy = function(position, value, extra)
	local mine = extra == player.UserId
	if position then
		if World.PadBought then
			World.PadBought(position, value, mine)
		else
			World.Puff(position)
		end
	end
	if mine then
		UI.Sound("Comprar", 0.75, 1, 0.05)
	end
end

-- v6: comemoração das conquistas grandes: a câmera "respira" (campo de visão abre e volta) e o celular vibra
local punching = false
local function celebrate(strength: number)
	local camera = workspace.CurrentCamera
	if camera and not punching then
		punching = true
		local base = camera.FieldOfView
		local out = TweenService:Create(camera, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = base + 6 * strength })
		out:Play()
		out.Completed:Once(function()
			local back = TweenService:Create(camera, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { FieldOfView = base })
			back:Play()
			back.Completed:Once(function()
				punching = false
			end)
		end)
	end
	if isTouch then
		task.spawn(function()
			local HapticService = game:GetService("HapticService")
			local motor = Enum.VibrationMotor.Large
			local ok, supported = pcall(HapticService.IsMotorSupported, HapticService, Enum.UserInputType.Gamepad1, motor)
			if ok and supported then
				pcall(HapticService.SetMotor, HapticService, Enum.UserInputType.Gamepad1, motor, 0.6 * strength)
				task.wait(0.15)
				pcall(HapticService.SetMotor, HapticService, Enum.UserInputType.Gamepad1, motor, 0)
			end
		end)
	end
end

FX.newbiz = function(position, value)
	local def = Config.Businesses[tonumber(value) or 0]
	if def then
		celebrate(1)
		UI.BigPopup(gui, T("pop.newbiz", { biz = T("biz." .. def.Id) }), def.Color, 3.2)
		-- som de festa, um instante depois do som da compra (os dois chegam juntos do servidor)
		task.delay(0.18, UI.Sound, "Premio", 0.85, 0.95)
		if position then
			World.Ping(position, def.Color)
		end
		-- poeira de obra onde estava o lote trancado (o servidor já apagou o canteiro e pôs o prédio)
		World.LotOpened(tonumber(value) or 0)
	end
end

FX.manager = function(_position, value)
	local def = Config.Businesses[tonumber(value) or 0]
	if def then
		UI.BigPopup(gui, T("pop.manager", { name = T("mgr." .. def.Id) }), C.Green, 2.4)
		task.delay(0.18, UI.Sound, "Premio", 0.65, 1.2) -- gerente contratado: o som de prêmio, mais agudo que o de negócio novo
	end
end

FX.newline = function(_position, value)
	local line = Config.Lines[tonumber(value) or 0]
	if line then
		UI.BigPopup(gui, T("pop.newline") .. "\n" .. T("bird." .. line.Id), line.Color, 2.6)
		task.delay(0.18, UI.Sound, "Mutante", 0.7, 1.08) -- ave nova
	end
end

FX.nomoney = function(_position, value)
	World.FloatText(nil, T("pop.nomoney", { n = short(num(value)) }), C.Red)
	Hud.NoMoney() -- o contador de moedas treme e pisca vermelho
	UI.Sound("Erro", 0.4, 1, 0.04)
	-- Faltou dinheiro 3 vezes no mesmo minuto: UM aviso pequeno lembrando que a Loja existe, uma vez por
	-- sessão. É só o aviso (some sozinho); nenhuma janela abre e nada é oferecido se a loja está vazia.
	if not Loja.Hinted then
		local now = os.clock()
		local times = Loja.NoMoney
		table.insert(times, now)
		while times[1] and now - times[1] > 60 do
			table.remove(times, 1)
		end
		if #times >= 3 and Loja.HasItems() then
			Loja.Hinted = true
			UI.Toast(T("shop.hint"), "info")
		end
	end
end

FX.apples = function(position, value)
	if position then
		World.FloatText(position, T("pop.apples", { n = short(num(value)) }), C.Red)
	end
	UI.Sound("Coletar", 0.6, 0.85) -- maçãs: o "plim" das moedas, mais grave
end

FX.reward = function(_position, value, extra)
	rewardPopup(num(value), extra)
end

FX.rebirth = function(_position, value)
	UI.BigPopup(gui, T("pop.rebirth", { n = short(num(value)) }), C.Purple, 3)
	UI.Sound("Renascer", 0.85)
	celebrate(1.6)
	World.CoinBurst(nil, 30)
	Hud.Fly(14)
end

FX.seal = function(_position, _value, extra)
	UI.BigPopup(gui, T("pop.seal", { seal = upper(T("seal." .. tostring(extra))) }), C.Yellow, 3.5)
	UI.Sound("Renascer", 0.95, 0.85) -- selo: o som de renascer, mais grave e solene
	task.delay(0.6, UI.Sound, "Premio", 0.6, 1.1)
end

FX.hunt = function(_position, value, extra)
	UI.BigPopup(gui, T("pop.hunt", { a = value, b = extra }), C.Yellow, 2.2)
	UI.Sound("Mutante", 0.6, 1.25)
end

FX.event = function(position, value, extra)
	local duration = num(extra, 30)
	local text = T("event." .. tostring(value), { n = Config.EventById.rain.Speed })
	eventBanner = { Text = text, Ends = os.clock() + duration }
	UI.Toast(text, "event")
	UI.Sound("Evento", 0.7)
	World.EventStart(tostring(value), position, duration)
	if value == "race" then
		showRacePick(duration)
	end
end

FX.eventEnd = function(_position, value)
	eventBanner = nil
	World.EventEnd(tostring(value))
end

FX.order = function(_position, value, extra)
	local info = tbl(extra)
	showOrder(num(value), num(info[1], Config.OrderTimeout), num(info[2], 1))
	UI.Sound("Evento", 0.5, 1.2) -- o telefone da encomenda
end

FX.raceGo = function(_position, value)
	World.RaceGo(value)
	UI.Sound("Evento", 0.5, 1.4) -- largada da corrida
end

FX.raceResult = function(_position, value, extra)
	UI.BigPopup(gui, T("race.result", { place = extra, n = short(num(value)) }), C.Yellow, 2.5)
	UI.Sound("Premio", 0.55, if num(extra, 4) <= 1 then 1.2 else 0.95)
end

FX.hatchStart = function(position, value, extra)
	UI.Toast(T("pop.hatchStart", { pet = petName(tostring(value)), t = Format.Time(num(extra)) }), "info")
	UI.Sound("Coletar", 0.6, 0.9) -- o ovo entrou na chocadeira (o som de chocar fica para quando o pet nasce)
	if position then
		World.Ping(position, C.Pink)
	end
end

FX.hatched = function(position, value, extra)
	local info = tbl(extra)
	showPet(tostring(value), info[1] == true, num(info[2], 1))
	UI.Sound("Chocar", 0.85, if info[1] == true then 1 else 1.12) -- (pet repetido que subiu de nível: um tom acima)
	if position then
		World.Puff(position)
		World.Ping(position, C.Pink)
	end
end

FX.spin = function(_position, value, extra)
	World.WheelSpin()
	playSpin(num(value, 1), extra)
end

FX.giantSoon = function()
	UI.BigPopup(gui, T("giant.soon"), C.Yellow, 3.2)
	UI.Sound("Evento", 0.8, 0.82) -- aviso grave: o Mega Ovo vai rachar
end

FX.giantCrack = function(position)
	World.GiantCrack(position)
	UI.Sound("Gigante", 0.9)
end

FX.giantReward = function(_position, value, extra)
	local info = tbl(extra)
	local near, pet = info[1] == true, info[2]
	UI.BigPopup(gui, T(if near then "giant.rewardNear" else "giant.reward", { n = short(num(value)) }), C.Yellow, 3)
	Hud.Fly(10)
	UI.Sound("Premio", if near then 0.8 else 0.6, if near then 1.1 else 1)
	if pet then
		task.delay(1.4, function()
			local level = math.clamp(num(tbl(state and state.Pets)[pet], 1), 1, Config.Pets.MaxLevel)
			showPet(tostring(pet), level <= 1, level)
			UI.Sound("Chocar", 0.85)
		end)
	end
end

FX.obby = function(position, value)
	UI.BigPopup(gui, T("pop.obby", { n = short(num(value)) }), C.Yellow, 3)
	UI.Sound("Premio", 0.8, 1.1)
	World.CoinBurst(position, 16)
	Hud.Fly(10)
end

FX.sound = function(_position, value)
	UI.Sound(tostring(value))
end

-- VERSÃO 5. O servidor manda:
--   weather    para todos:    sem posição, id do clima, segundos que dura
--   keyDrop    só para o dono: sem posição (a chave está ESCONDIDA: nada de apontar o lugar)
--   keyTake    só para o dono: posição, chaves que tem agora, quantas precisa
--   chestOpen  para todos:    posição do baú, moedas, { userId de quem abriu, dourado?, giros }
--   power      para todos:    banca do dono, id do poder, { userId, coins?, seconds? } (lista ou com nomes)
-- O desenho no mundo (céu, chave, baú, onda do poder) é do World; aqui, os avisos, o som e as moedas voando.
FX.weather = function(_position, value, extra)
	if World.SetWeather then
		World.SetWeather(value, extra) -- (o chip, o aviso e a dica saem do World.OnWeather: vale também para os atributos)
	end
end

FX.keyDrop = function()
	UI.Toast(T("key.drop"), "event")
	UI.Sound("Evento", 0.4, 1.45) -- chave escondida: um toque agudo e discreto
end

FX.keyTake = function(position, value, extra)
	local have = num(value)
	local need = num(extra, num(tbl(Config.Keys).Need))
	UI.Toast(T("key.take", { n = have, m = need }), "success")
	UI.Sound("Coletar", 0.65, 1.4) -- chave pega: o "plim" bem agudo
	if need > 0 and have >= need then
		UI.Toast(T("key.full", { m = need }), "event")
		task.delay(0.3, UI.Sound, "Premio", 0.55, 1.3) -- todas as chaves: o baú já pode ser aberto
	end
	if position then
		World.Puff(position) -- brilho onde a chave estava
	end
end

FX.chestOpen = function(position, value, extra)
	-- (a lista { userId, dourado?, giros } pode chegar cortada se "dourado" vier vazio; aceita também com nomes)
	local info = tbl(extra)
	local who = info[1] or info.userId or info.UserId
	local golden = info[2] == true or info.golden == true or info.Golden == true
	World.ChestOpen(position, golden) -- pulo do baú, clarão e moedas: todo mundo vê
	if who ~= player.UserId then
		return
	end
	local spins = num(info[3] or info.spins or info.Spins, num(tbl(tbl(Config.Keys).Chest).Spins))
	local text = T(if golden then "chest.openGold" else "chest.open", { n = short(num(value)), s = spins })
	if golden then
		UI.BigPopup(gui, text, C.Yellow, 3)
	else
		UI.Toast(text, "success")
	end
	Hud.Fly(if golden then 12 else 8)
	UI.Sound("Premio", if golden then 0.85 else 0.65, if golden then 1.2 else 0.95)
	task.delay(0.35, UI.Sound, "Coletar", 0.5, 1.1) -- as moedas chegando no contador
end

FX.power = function(position, value, extra)
	local info = tbl(extra)
	local who = info[1] or info.userId or info.UserId
	-- (o servidor pode mandar também a ave e o ninho do ovo da sorte: aí a faísca verde sai do ninho para todos)
	local atNest = World.PowerFx(value, position, who, info[4], info[5])
	if who == player.UserId then
		V5.PowerUsed(tostring(value), num(info.coins or info.Coins or info[2]), num(info.seconds or info.Seconds or info[3]), atNest == true)
	end
end

Remotes:WaitForChild("Fx").OnClientEvent:Connect(function(kind: string, position: Vector3?, value: any, extra: any)
	local handler = FX[kind]
	if handler then
		handler(position, value, extra)
	end
end)

-- ---------------------------------------------------------------------------
-- Teclado e controle: ESC/B fecham painéis; E, X ou o gatilho direito vendem (segurar repete)
-- ---------------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed then
		return -- o jogador está digitando (código de presente, chat) ou o Roblox já usou a tecla
	end
	local key = input.KeyCode
	if key == Enum.KeyCode.Escape or key == Enum.KeyCode.B or key == Enum.KeyCode.ButtonB then
		UI.Show(nil)
	elseif SELL_KEYS[key.Name] and sell.Visible then
		holdKeys[key.Name] = true
		sellTap()
	end
end)

UserInputService.InputEnded:Connect(function(input: InputObject)
	holdKeys[input.KeyCode.Name] = nil
	local held = holdInput
	-- o dedo é o mesmo objeto do começo ao fim do toque; o mouse pode vir como outro objeto do mesmo tipo
	if held and (input == held or (input.UserInputType == Enum.UserInputType.MouseButton1 and held.UserInputType == Enum.UserInputType.MouseButton1)) then
		releaseHold()
	end
end)

-- trocou de janela com a tecla apertada: o "soltou" nunca chega, então solta tudo aqui
UserInputService.WindowFocusReleased:Connect(function()
	table.clear(holdKeys)
	releaseHold()
end)

-- Roleta da praça: apertar o botão perto dela abre a aba da roleta
World.OnWheel = function()
	openGroup("Prizes", "Wheel")
end

-- Versão 5: o clima mudou (chip, aviso e dica) e a MINHA chave escondida começou a brilhar forte (um aviso por chave)
World.OnWeather = V5.OnWeather
V5.Hinted = {}
World.OnKeyHint = function(keyId: any)
	local id = tostring(keyId)
	if not V5.Hinted[id] then
		V5.Hinted[id] = true
		UI.Toast(T("key.hint"), "info")
		UI.Sound("Mutante", 0.3, 1.45) -- a chave começou a brilhar forte
	end
end

-- (os painéis foram criados depois da 1ª arrumação: agora ganham o lugar deles, entre as pílulas e o contador)
Hud.BottomKey = nil
Hud.Bottom()

World.Start(gui)
request("Refresh")
]]></ProtectedString>
        </Properties>
        <Item class="ModuleScript" referent="R6990">
          <Properties>
            <string name="Name">UI</string>
            <ProtectedString name="Source"><![CDATA[--[[
	UI: peças de interface (cores, botões, painéis, avisos) usadas pela tela do jogo.
	Feito para celular: tudo em escala, botões grandes (alvo de toque de 60 px virtuais ou mais), painéis com rolagem.
	Jogo infantil: botão tem cara de botão (brilho em cima, contorno grosso) e sempre responde ao toque (pulinho + som).
]]

local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local UI = {}

UI.C = {
	Cream = Color3.fromRGB(255, 248, 230),
	Panel = Color3.fromRGB(255, 241, 205),
	Brown = Color3.fromRGB(110, 62, 28),
	DarkBrown = Color3.fromRGB(70, 38, 15),
	Yellow = Color3.fromRGB(255, 205, 50),
	Orange = Color3.fromRGB(255, 140, 40),
	Green = Color3.fromRGB(80, 200, 90),
	DarkGreen = Color3.fromRGB(40, 140, 55),
	Red = Color3.fromRGB(235, 70, 60),
	Blue = Color3.fromRGB(70, 160, 255),
	Purple = Color3.fromRGB(170, 90, 230),
	Pink = Color3.fromRGB(255, 110, 190),
	Gray = Color3.fromRGB(170, 160, 150),
	White = Color3.new(1, 1, 1),
	Black = Color3.new(0, 0, 0),
}
UI.Font = Enum.Font.FredokaOne
UI.Font2 = Enum.Font.GothamBold

local C = UI.C

local EMOJI = {
	Moeda = "💰",
	Cesta = "🧺",
	Raio = "⚡",
	Estrela = "⭐",
	Presente = "🎁",
	Trofeu = "🏆",
	R_Galinha_Comum = "🐔",
	R_Galinha_Caipira = "🐔",
	R_Pata = "🦆",
	R_Codorna = "🐦",
	R_Galinha_Dourada = "🐔",
	R_Galinha_Cristal = "🐔",
	R_Galinha_ArcoIris = "🐔",
	R_Galinha_Lunar = "🐔",
	R_Filhote_Dragao = "🐉",
}

UI.SfxOn = true

function UI.New(className: string, props: { [string]: any }, children: { Instance }?): any
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(inst :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local new = UI.New

function UI.Corner(radius: number?): UICorner
	return new("UICorner", { CornerRadius = UDim.new(radius or 0.25, 0) })
end

function UI.Stroke(color: Color3?, thickness: number?): UIStroke
	return new("UIStroke", { Color = color or C.DarkBrown, Thickness = thickness or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function UI.TextStroke(thickness: number?): UIStroke
	return new("UIStroke", { Color = C.DarkBrown, Thickness = thickness or 2 })
end

-- Brilho de botão: claro em cima, um pouco mais escuro embaixo (dá volume sem precisar de imagem)
-- v6: brilho de "bala de goma": claro em cima, uma faixa de luz e escuro embaixo (botão com volume)
function UI.Shine(): UIGradient
	return new("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, C.White),
			ColorSequenceKeypoint.new(0.45, Color3.fromRGB(235, 235, 235)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(205, 205, 205)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(165, 165, 165)),
		}),
	})
end

-- Texto. MaxText = tamanho máximo da letra (o texto encolhe para caber). Dark = letra marrom sem contorno.
-- Menor tamanho de letra (px). 6 deixava descrição ilegível no celular (a tela encolhe tudo pela metade).
UI.MinText = 9

function UI.Label(props: { [string]: any }): TextLabel
	local base: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextScaled = true,
		TextColor3 = C.White,
	}
	local maxText = props.MaxText or 40
	local dark = props.Dark
	for k, v in props do
		if k ~= "MaxText" and k ~= "Dark" then
			base[k] = v
		end
	end
	if dark then
		base.TextColor3 = props.TextColor3 or C.DarkBrown
	end
	local l = new("TextLabel", base)
	if not dark then
		UI.TextStroke().Parent = l
	end
	new("UITextSizeConstraint", { MaxTextSize = maxText, MinTextSize = UI.MinText, Parent = l })
	return l
end

-- Ícone: imagem do Config.Images se tiver ID, senão um emoji
function UI.Icon(name: string, props: { [string]: any }, emoji: string?): GuiObject
	local id = Config.Images[name]
	if id and id ~= "" then
		local base: { [string]: any } = { BackgroundTransparency = 1, Image = id, ScaleType = Enum.ScaleType.Fit }
		for k, v in props do
			base[k] = v
		end
		return new("ImageLabel", base)
	end
	local text = emoji or EMOJI[name] or (if string.sub(name, 1, 3) == "Ovo" or string.sub(name, 1, 5) == "R_Ovo" then "🥚" else "⭐")
	local base: { [string]: any } = { BackgroundTransparency = 1, Font = UI.Font2, TextScaled = true, Text = text, TextColor3 = C.White }
	for k, v in props do
		if k ~= "ImageColor3" and k ~= "ImageTransparency" then
			base[k] = v
		end
	end
	if props.ImageTransparency then
		base.TextTransparency = props.ImageTransparency
	end
	return new("TextLabel", base)
end

-- "Pulo" rápido de um elemento. from > 1 = cresce e volta (chama a atenção); from < 1 = afunda e volta (toque).
function UI.Pop(object: Instance, from: number?)
	local scale: any = object:FindFirstChild("PopScale")
	if not scale then
		scale = new("UIScale", { Name = "PopScale", Parent = object })
	end
	scale.Scale = from or 1.16
	TweenService:Create(scale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

-- Some encolhendo (fundo, texto e contorno juntos) e destrói. Mudar só a transparência do texto deixava o contorno para trás.
function UI.Vanish(object: Instance)
	if not object.Parent then
		return
	end
	local scale: any = object:FindFirstChild("PopScale")
	if not scale then
		scale = new("UIScale", { Name = "PopScale", Parent = object })
	end
	TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.01 }):Play()
	task.delay(0.26, function()
		object:Destroy()
	end)
end

function UI.Button(props: { [string]: any }, onClick: () -> ()): TextButton
	local base: { [string]: any } = {
		AutoButtonColor = true,
		Font = UI.Font,
		TextScaled = true,
		TextColor3 = C.White,
		BackgroundColor3 = C.Green,
	}
	local maxText = props.MaxText or 30
	for k, v in props do
		if k ~= "MaxText" then
			base[k] = v
		end
	end
	local b = new("TextButton", base, { UI.Corner(0.3), UI.Stroke(C.DarkBrown, 3.5), UI.TextStroke(2), UI.Shine() })
	new("UITextSizeConstraint", { MaxTextSize = maxText, MinTextSize = UI.MinText, Parent = b })
	b.Activated:Connect(function()
		UI.Sound("Clique", 0.35)
		UI.Pop(b, 0.92)
		onClick()
	end)
	return b
end

-- ---------------------------------------------------------------------------
-- SONS. Um Sound por nome (os 13 do Config.Sounds), criado UMA vez no SoundService e tocado de novo a cada vez.
-- (Criar e destruir um Sound por clique enchia o SoundService: 5 cliques por segundo no botão VENDER.)
-- O dono do jogo não ouviu som nenhum no jogo publicado, então aqui nada fica por conta da sorte:
--   * UI.InitSounds cria todos logo que a tela liga e manda carregar (ContentProvider:PreloadAsync): o 1º
--     clique já sai com som, em vez de tocar atrasado ou nem tocar;
--   * som que FALHA ao carregar (ID apagado, áudio sem permissão para este jogo) ou que não carrega em
--     SOUND_WAIT segundos ganha um warn claro no Output, uma vez por som, com o nome e o ID;
--   * a música toca de novo quando termina de carregar (Loaded) e no 1º toque/clique/tecla do jogador, se a
--     essa altura ainda não estiver tocando;
--   * se alguém apagar um Sound do SoundService no meio do jogo, ele é criado de novo na próxima vez.
-- UI.SfxOn / UI.MusicOn são as opções do jogador (Configurações); a tela aplica o que veio salvo do servidor.
-- ---------------------------------------------------------------------------
local SOUND_WAIT = 10 -- segundos para um som carregar antes do aviso
local sounds: { [string]: Sound } = {}
local soundWarned: { [string]: boolean } = {}
local soundsStarted = false
local musicAsked = false -- a tela já mandou ligar a música (UI.SetMusic)? Antes disso ninguém toca nada sozinho
UI.MusicOn = true
UI.Sounds = sounds -- (à mostra para o teste e para quem for investigar no Studio)

local function soundWarn(name: string, why: string)
	if soundWarned[name] then
		return
	end
	soundWarned[name] = true
	warn(("[VendaUmOvo] SOM '%s' (%s) %s. Confira no Studio se esse áudio existe e se está liberado para este jogo (Creator Hub > áudio > Permissões > adicionar a experiência)."):format(name, tostring(Config.Sounds[name]), why))
end

-- (propriedades que dependem do motor: lidas com cuidado, para um erro de leitura nunca calar o resto)
local function soundFlag(s: Sound, property: string): boolean
	local ok, value = pcall(function()
		return (s :: any)[property]
	end)
	return ok and value == true
end

local function musicKick()
	local m = sounds.Musica
	if not musicAsked or not UI.MusicOn or not m or not m.Parent then
		return
	end
	-- "tocando" mas parada no zero = o Play saiu antes de o áudio chegar e não pegou: toca de novo
	local stuck = false
	pcall(function()
		stuck = m.TimePosition < 0.05
	end)
	if not soundFlag(m, "IsPlaying") or stuck then
		m:Play()
	end
end

local function getSound(name: string): Sound?
	local id = Config.Sounds[name]
	if type(id) ~= "string" or id == "" then
		return nil
	end
	local s = sounds[name]
	if s and s.Parent then
		return s
	end
	local music = name == "Musica"
	local made: Sound = new("Sound", { Name = if music then "VUOMusic" else "VUO_" .. name, SoundId = id, Volume = if music then Config.MusicVolume else 0.7, Looped = music, Parent = SoundService })
	sounds[name] = made
	if music then
		made.Loaded:Connect(musicKick)
	end
	-- não carregou em SOUND_WAIT segundos: avisa (uma vez por som). No jogo de verdade o motivo de sempre é o
	-- áudio não estar liberado para a experiência; o Output do Studio mostra também o erro do próprio Roblox.
	task.delay(SOUND_WAIT, function()
		if made.Parent and not soundFlag(made, "IsLoaded") then
			soundWarn(name, ("não carregou em %d s"):format(SOUND_WAIT))
		end
	end)
	return made
end

-- Cria e pré-carrega os 13 sons (chamado uma vez, quando a tela liga). Não trava nada: roda à parte.
function UI.InitSounds()
	if soundsStarted then
		return
	end
	soundsStarted = true
	local list: { Instance } = {}
	local byId: { [string]: string } = {}
	for name, id in Config.Sounds do
		local s = getSound(name)
		if s then
			table.insert(list, s)
			byId[tostring(id)] = name
			byId[string.match(tostring(id), "%d+$") or tostring(id)] = name
		end
	end
	task.spawn(function()
		local ok, err = pcall(function()
			ContentProvider:PreloadAsync(list, function(assetId: string, status: Enum.AssetFetchStatus)
				if status == Enum.AssetFetchStatus.Failure or status == Enum.AssetFetchStatus.TimedOut then
					local name = byId[tostring(assetId)] or byId[string.match(tostring(assetId), "%d+$") or ""]
					soundWarn(name or tostring(assetId), "FALHOU ao carregar (" .. status.Name .. ")")
				end
			end)
		end)
		if not ok then
			warn("[VendaUmOvo] pré-carga dos sons não rodou: " .. tostring(err))
		end
		musicKick()
		-- no Studio, uma linha de resumo no Output para quem está conferindo os sons
		if RunService:IsStudio() then
			local loaded, missing = 0, {}
			for name, s in sounds do
				if soundFlag(s, "IsLoaded") then
					loaded += 1
				else
					table.insert(missing, name)
				end
			end
			table.sort(missing)
			print(("[VendaUmOvo] sons carregados: %d de %d%s"):format(loaded, #list, if #missing > 0 then " (ainda faltam: " .. table.concat(missing, ", ") .. ")" else ""))
		end
	end)
	-- 1º toque, clique ou tecla do jogador: se a música já devia estar tocando e não está, toca agora
	local first: RBXScriptConnection? = nil
	first = UserInputService.InputBegan:Connect(function(input: InputObject)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Focus then
			return
		end
		if musicAsked then
			if first then
				first:Disconnect()
				first = nil
			end
			musicKick()
		end
	end)
end

-- Toca um som. volume 0..1 (padrão 0,7); speed = altura (1 = normal; mais alto = mais agudo); jitter = quanto
-- a altura varia ao acaso para cima e para baixo (0,06 = 6%), para o mesmo som repetido não enjoar.
-- v6: o mesmo som tocado de novo antes de acabar cortava o anterior. Agora cada som tem até 2 cópias
-- extras: toca na primeira que estiver livre.
local soundPool: { [string]: { Sound } } = {}
local function freeVoice(name: string, s: Sound): Sound
	if not s.IsPlaying then
		return s
	end
	local pool = soundPool[name]
	if not pool then
		pool = {}
		soundPool[name] = pool
	end
	for _, copy in pool do
		if not copy.IsPlaying then
			return copy
		end
	end
	if #pool < 2 then
		local copy = s:Clone()
		copy.Parent = s.Parent
		table.insert(pool, copy)
		return copy
	end
	return s
end

function UI.Sound(name: string, volume: number?, speed: number?, jitter: number?)
	if not UI.SfxOn or name == "Musica" then
		return
	end
	local base = getSound(name)
	if not base then
		return
	end
	local s = freeVoice(name, base)
	local pitch = speed or 1
	if jitter then
		pitch *= 1 + (math.random() * 2 - 1) * jitter
	end
	s.Volume = math.clamp(volume or 0.7, 0, 1)
	s.PlaybackSpeed = math.clamp(pitch, 0.4, 2.5)
	s:Play()
end

-- Liga ou desliga a música de fundo (a opção do jogador). Pode ser chamada quantas vezes for.
function UI.SetMusic(on: boolean)
	UI.MusicOn = on
	musicAsked = true
	local m = getSound("Musica")
	if not m then
		return
	end
	m.Looped = true
	m.Volume = Config.MusicVolume
	if on then
		if not soundFlag(m, "IsPlaying") then
			m:Play()
		end
	else
		m:Stop()
	end
end

-- ---------------------------------------------------------------------------
-- Escala: a tela é desenhada numa "tela virtual" de ~720 de altura e encolhida/esticada para caber.
-- No celular tudo fica do mesmo jeito que no PC, só menor (os botões continuam grandes para o dedo).
-- Devolve o quadro raiz: TUDO da interface vai dentro dele.
-- UI.OnScale (opcional) é chamado sempre que a escala muda: a tela reposiciona o que depende do tamanho real.
-- ---------------------------------------------------------------------------
UI.Scale = 1
UI.Root = nil :: Frame?
UI.OnScale = nil :: (() -> ())?

function UI.InitScale(gui: ScreenGui): Frame
	local root = new("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui })
	local scale = new("UIScale", { Parent = root })
	local function apply()
		local camera = workspace.CurrentCamera
		local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
		if size.X < 50 or size.Y < 50 then
			return
		end
		-- no celular a escala não desce de 0.6: abaixo disso letras e botões ficam pequenos demais para o dedo
		local touch = game:GetService("UserInputService").TouchEnabled
		local s = math.clamp(math.min(size.Y / 720, size.X / 1100), if touch then 0.6 else 0.5, 1.25)
		UI.Scale = s
		scale.Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
		if UI.OnScale then
			UI.OnScale()
		end
	end
	apply()
	-- se o Roblox trocar a câmera, a tela continua acompanhando o tamanho da nova
	local viewportConn: RBXScriptConnection? = nil
	local function watchCamera()
		if viewportConn then
			viewportConn:Disconnect()
			viewportConn = nil
		end
		local camera = workspace.CurrentCamera
		if camera then
			viewportConn = camera:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
		end
		apply()
	end
	watchCamera()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
	UI.Root = root
	return root
end

-- Moedas voando do meio da tela até o contador. target = para onde elas vão (a moeda grande do contador, que
-- hoje fica embaixo, no meio); at = ponto dentro do alvo, de 0 a 1 (padrão: o meio dele); pop = o que dá o
-- pulinho quando a primeira moeda chega (padrão: o próprio alvo).
function UI.FlyCoins(gui: Instance, target: GuiObject, amount: number, at: Vector2?, pop: GuiObject?)
	local root = UI.Root
	if not root or not target.Parent or UI.OpenPanel then
		return -- com painel aberto as moedas passariam por cima dele
	end
	local s = UI.Scale
	local origin = root.AbsolutePosition
	local goal = (target.AbsolutePosition + target.AbsoluteSize * (at or Vector2.new(0.5, 0.5)) - origin) / s
	local size = root.AbsoluteSize / s
	for i = 1, math.min(amount, 12) do
		-- nascem espalhadas no meio da tela, um pouco acima do centro (o contador fica embaixo: o caminho é para baixo)
		local start = Vector2.new(size.X * (0.38 + math.random() * 0.24), size.Y * (0.38 + math.random() * 0.14))
		local coin = UI.Icon("Moeda", { Name = "FlyCoin", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(start.X, start.Y), Size = UDim2.fromOffset(38, 38), ZIndex = 30, Parent = gui }) -- abaixo das janelas (40+): moeda voando não tampa texto de janela
		task.delay(0.04 * i, function()
			local tween = TweenService:Create(coin, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.fromOffset(goal.X, goal.Y), Size = UDim2.fromOffset(22, 22) })
			tween:Play()
			task.wait(0.58)
			coin:Destroy()
			if i == 1 then
				UI.Pop(pop or target)
			end
		end)
	end
end

-- Texto curto que sobe e some a partir de um elemento (o "+2" em cima do botão VENDER)
function UI.Rise(from: GuiObject, text: string, color: Color3)
	local x = 0.5 + (math.random() - 0.5) * 0.3
	local l = UI.Label({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(x, 0, 0, 4), Size = UDim2.new(1.2, 0, 0, 40), Text = text, TextColor3 = color, MaxText = 34, ZIndex = from.ZIndex + 5, Parent = from })
	TweenService:Create(l, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.new(x, 0, 0, -64) }):Play()
	task.delay(0.5, UI.Vanish, l)
end

-- ---------------------------------------------------------------------------
-- Painéis (janelas com título, X e lista com rolagem)
-- ---------------------------------------------------------------------------
UI.Panels = {} :: { [string]: Frame }
UI.Refreshers = {} :: { [string]: () -> () }
UI.OpenPanel = nil :: string?
UI.OnShow = nil :: ((name: string?) -> ())? -- (opcional) chamado sempre que um painel abre ou fecha: a tela esconde o que ficaria por baixo

function UI.Show(name: string?)
	local wasClosed = UI.OpenPanel == nil
	for key, panel in UI.Panels do
		panel.Visible = key == name
	end
	UI.OpenPanel = name
	if name and UI.Refreshers[name] then
		UI.Refreshers[name]()
	end
	-- o painel "salta" ao abrir (trocar de aba não repete o salto: ficaria tremendo)
	local panel = name and UI.Panels[name]
	if panel and wasClosed then
		UI.Pop(panel, 0.86)
		UI.Sound("Clique", 0.35, 1.3) -- abrir: clique mais agudo
	elseif not name and not wasClosed then
		UI.Sound("Clique", 0.3, 0.8) -- fechar: clique mais grave
	end
	if UI.OnShow then
		UI.OnShow(name)
	end
end

function UI.Toggle(name: string)
	UI.Show(if UI.OpenPanel == name then nil else name)
end

function UI.RefreshOpen()
	local name = UI.OpenPanel
	if name and UI.Refreshers[name] then
		UI.Refreshers[name]()
	end
end

-- Cria o painel e devolve (lista com rolagem, rótulo do título).
-- Cabeçalho e X têm altura fixa (o X precisa de 60 px para o dedo mesmo quando o painel encolhe no celular).
function UI.MakePanel(gui: Instance, name: string, color: Color3): (ScrollingFrame, TextLabel)
	local panel = new("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.53, 0),
		Size = UDim2.new(0.66, 0, 0.8, 0),
		BackgroundColor3 = C.Panel,
		Visible = false,
		ZIndex = 5,
		Parent = gui,
	}, {
		UI.Corner(0.06),
		UI.Stroke(C.DarkBrown, 5),
		new("UISizeConstraint", { MaxSize = Vector2.new(1000, 600), MinSize = Vector2.new(300, 250) }),
		-- v6: fundo com um degradê quente (antes era uma cor lisa)
		new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 250, 225), Color3.fromRGB(245, 215, 160)) }),
	})
	local header = new("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, 68), BackgroundColor3 = color, ZIndex = 5, Parent = panel }, { UI.Corner(0.3), UI.Stroke(C.DarkBrown, 3), UI.Shine() })
	local title = UI.Label({ Name = "Title", Position = UDim2.new(0, 22, 0.12, 0), Size = UDim2.new(1, -110, 0.76, 0), Text = name, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6, Parent = header })
	UI.Button({ Name = "Close", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(66, 60), Text = "X", BackgroundColor3 = C.Red, ZIndex = 6, Parent = header }, function()
		UI.Show(nil)
	end)
	local list = new("ScrollingFrame", {
		Name = "List",
		Position = UDim2.new(0, 14, 0, 78),
		Size = UDim2.new(1, -28, 1, -90),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = C.Brown,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		ZIndex = 5,
		Parent = panel,
	}, { new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	UI.Panels[name] = panel
	return list, title
end

-- Apaga o conteúdo da lista (menos o que tem o atributo Keep: ex. a caixa de código, que não pode
-- sumir enquanto a pessoa digita)
function UI.Clear(list: Instance)
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") and not child:GetAttribute("Keep") then
			child:Destroy()
		end
	end
end

-- Linha de texto simples dentro de uma lista
function UI.Note(list: Instance, order: number, text: string, height: number?): TextLabel
	return UI.Label({
		Size = UDim2.new(1, -10, 0, height or 30),
		Text = text,
		Dark = true,
		TextColor3 = C.Brown,
		Font = UI.Font2,
		TextWrapped = true,
		MaxText = 20,
		LayoutOrder = order,
		ZIndex = 6,
		Parent = list,
	})
end

-- Cartão padrão: ícone | título + descrição | botão (onClick nil = botão apagado)
function UI.Card(list: Instance, order: number, iconObj: GuiObject, title: string, desc: string, buttonText: string, buttonColor: Color3, onClick: (() -> ())?): Frame
	-- v6: cartão com volume (degradê + borda grossa) e o ícone dentro de um "selo" redondo na cor do botão
	local f = new("Frame", { Size = UDim2.new(1, -10, 0, 88), BackgroundColor3 = C.Cream, LayoutOrder = order, ZIndex = 6, Parent = list }, {
		UI.Corner(0.2),
		UI.Stroke(C.DarkBrown, 2.5),
		new("UIGradient", { Rotation = 90, Color = ColorSequence.new(C.White, Color3.fromRGB(238, 228, 205)) }),
	})
	local slot = new("Frame", { Position = UDim2.new(0, 8, 0.09, 0), Size = UDim2.new(0, 70, 0.82, 0), BackgroundColor3 = buttonColor:Lerp(C.White, 0.55), ZIndex = 7, Parent = f }, {
		UI.Corner(1),
		UI.Stroke(buttonColor:Lerp(C.DarkBrown, 0.35), 3),
		new("UIAspectRatioConstraint", { AspectRatio = 1 }),
	})
	iconObj.AnchorPoint = Vector2.new(0.5, 0.5)
	iconObj.Position = UDim2.fromScale(0.5, 0.5)
	iconObj.Size = UDim2.fromScale(0.78, 0.78)
	iconObj.ZIndex = 8
	iconObj.Parent = slot
	UI.Label({ Position = UDim2.new(0, 84, 0.08, 0), Size = UDim2.new(0.64, -84, 0.44, 0), Text = title, TextXAlignment = Enum.TextXAlignment.Left, Dark = true, MaxText = 26, ZIndex = 7, Parent = f })
	local d = UI.Label({ Position = UDim2.new(0, 84, 0.52, 0), Size = UDim2.new(0.64, -84, 0.38, 0), Text = desc, TextXAlignment = Enum.TextXAlignment.Left, Dark = true, TextColor3 = C.Brown, MaxText = 18, Font = UI.Font2, ZIndex = 7, Parent = f })
	local b = UI.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0.33, 0, 0, 64), Text = buttonText, BackgroundColor3 = buttonColor, MaxText = 24, ZIndex = 7, Parent = f }, function()
		if onClick then
			onClick()
		end
	end)
	b.Active = onClick ~= nil
	b.AutoButtonColor = onClick ~= nil
	return f, b, d
end

-- ---------------------------------------------------------------------------
-- Textos com contagem regressiva. Em vez de refazer o painel inteiro a cada segundo (perdia o toque do
-- jogador e criava centenas de peças por segundo), o painel registra só o texto que muda.
--   UI.LiveText(rótulo, fim (horário do servidor), function(segundos que faltam) -> texto)
-- UI.TickLive() atualiza todos e devolve true se algum chegou a zero (aí vale refazer o painel uma vez).
-- ---------------------------------------------------------------------------
UI.Live = {} :: { { Label: TextLabel | TextButton, Ends: number, Text: (number) -> string } }

function UI.LiveText(label: TextLabel | TextButton, ends: number, text: (number) -> string)
	label.Text = text(math.max(0, ends - workspace:GetServerTimeNow()))
	table.insert(UI.Live, { Label = label, Ends = ends, Text = text })
end

function UI.TickLive(): boolean
	local now = workspace:GetServerTimeNow()
	local crossed = false
	local keep = {}
	for _, entry in UI.Live do
		if entry.Label.Parent then
			local left = entry.Ends - now
			if left <= 0 then
				crossed = true
			else
				entry.Label.Text = entry.Text(left)
				table.insert(keep, entry)
			end
		end
	end
	UI.Live = keep
	return crossed
end

-- Barra de progresso
function UI.Bar(parent: Instance, fraction: number, color: Color3, text: string?, props: { [string]: any }?): Frame
	local base: { [string]: any } = { BackgroundColor3 = C.Gray, ZIndex = 7, Parent = parent }
	for k, v in props or {} do
		base[k] = v
	end
	local bar = new("Frame", base, { UI.Corner(0.5), UI.Stroke(C.DarkBrown, 2) })
	new("Frame", { Name = "Fill", Size = UDim2.new(math.clamp(fraction, 0, 1), 0, 1, 0), BackgroundColor3 = color, ZIndex = base.ZIndex, Parent = bar }, { UI.Corner(0.5) })
	if text then
		UI.Label({ Name = "Text", Size = UDim2.new(1, 0, 1, 0), Text = text, MaxText = 20, ZIndex = base.ZIndex + 1, Parent = bar })
	end
	return bar
end

-- ---------------------------------------------------------------------------
-- Avisos (toasts) e textos grandes no meio da tela
-- ---------------------------------------------------------------------------
local toastHolder: Frame? = nil
local KIND_COLOR = { success = C.Green, error = C.Red, event = C.Purple, info = C.Blue }

function UI.InitToasts(gui: Instance)
	toastHolder = new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 130),
		Size = UDim2.new(0.6, 0, 0.3, 0),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = gui,
	}, { new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center }), new("UISizeConstraint", { MaxSize = Vector2.new(560, 400) }) })
end

function UI.Toast(text: string, kind: string?)
	local holder = toastHolder
	if not holder then
		return
	end
	local f = new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = KIND_COLOR[kind or "info"] or C.Blue, ZIndex = 20, Parent = holder }, { UI.Corner(0.4), UI.Stroke(C.DarkBrown, 3) })
	UI.Label({ Position = UDim2.new(0.03, 0, 0.1, 0), Size = UDim2.new(0.94, 0, 0.8, 0), Text = text, MaxText = 24, ZIndex = 21, Parent = f })
	UI.Pop(f, 0.7)
	task.delay(3.5, UI.Vanish, f)
	-- no máximo 4 avisos na tela: os mais antigos saem
	local frames = {}
	for _, child in holder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(frames, child)
		end
	end
	for i = 1, #frames - 4 do
		frames[i]:Destroy()
	end
end

local bigPopup: TextLabel? = nil

function UI.BigPopup(gui: Instance, text: string, color: Color3, seconds: number?)
	-- um de cada vez: o novo entra no lugar do antigo (senão os textos ficam um por cima do outro)
	if bigPopup and bigPopup.Parent then
		bigPopup:Destroy()
	end
	-- v6: menor e mais alto (antes ocupava 70% da largura bem no meio da tela, em cima do personagem)
	local l = UI.Label({ Name = "BigPopup", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.27, 0), Size = UDim2.new(0.1, 0, 0.02, 0), Text = text, TextColor3 = color, MaxText = 46, ZIndex = 30, Parent = gui })
	new("UISizeConstraint", { MaxSize = Vector2.new(620, 96), Parent = l })
	bigPopup = l
	l.Active = false -- o texto nunca segura o toque (dá para girar a câmera por cima dele)
	TweenService:Create(l, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Size = UDim2.new(0.5, 0, 0.1, 0) }):Play()
	task.delay(seconds or 2.2, UI.Vanish, l)
end

return UI
]]></ProtectedString>
          </Properties>
