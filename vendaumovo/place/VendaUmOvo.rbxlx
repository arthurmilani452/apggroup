      </Item>
      <Item class="ModuleScript" referent="601">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Remotes: canais entre servidor e jogadores (todos criados aqui).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Remotes = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local function event(name: string, unreliable: boolean?): any
	local e = Instance.new(if unreliable then "UnreliableRemoteEvent" else "RemoteEvent")
	e.Name = name
	e.Parent = folder
	return e
end

Remotes.Request = event("Request") -- jogador -> servidor: (ação: string, a, b)
Remotes.State = event("State") -- servidor -> jogador: tabela com o estado dele (moedas, cesta, missões...)
Remotes.Notify = event("Notify") -- servidor -> jogador(es): (texto, args, tipo)
Remotes.Fx = event("Fx") -- servidor -> jogador(es): efeitos ("money", "rare", "sound"...) (posição, valor)

folder.Parent = ReplicatedStorage

function Remotes.NotifyPlayer(player: Player, key: string, args: { [string]: any }?, kind: string?)
	Remotes.Notify:FireClient(player, key, args or {}, kind or "info")
end

function Remotes.NotifyAll(key: string, args: { [string]: any }?, kind: string?)
	Remotes.Notify:FireAllClients(key, args or {}, kind or "info")
end

-- Pedidos do jogador: cada ação tem o próprio limite de tempo (lição do Steal a Critter v28)
local handlers: { [string]: (Player, any, any) -> () } = {}
local lastRequest: { [Player]: { [string]: number } } = {}

function Remotes.On(action: string, handler: (Player, any, any) -> ())
	handlers[action] = handler
end

Remotes.Request.OnServerEvent:Connect(function(player: Player, action: any, a: any, b: any)
	if type(action) ~= "string" then
		return
	end
	local handler = handlers[action]
	if not handler then
		return
	end
	local times = lastRequest[player]
	if not times then
		times = {}
		lastRequest[player] = times
	end
	local now = os.clock()
	if now - (times[action] or 0) < Config.RequestCooldown then
		return
	end
	times[action] = now
	local ok, err = pcall(handler, player, a, b)
	if not ok then
		warn("[Remotes] " .. action .. " falhou:", err)
	end
end)

function Remotes.RemovePlayer(player: Player)
	lastRequest[player] = nil
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="602">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[--[[
	Shop: Loja de Galinhas, Loja de Upgrades e Rebirth.
	O cliente só PEDE ("quero a Pata"); o servidor confere distância da loja, saldo e preço do Config.
	O builder deixa em workspace.Plaza: HenShopPoint e UpgradeShopPoint (onde fica o balcão de cada loja).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Registry = require(script.Parent.Registry)

local Shop = {}

local function point(name: string): BasePart?
	local plaza = workspace:FindFirstChild("Plaza")
	return plaza and plaza:FindFirstChild(name, true) :: BasePart?
end

local function nearShop(player: Player, name: string): boolean
	local part = point(name)
	if not part then
		return true -- sem o ponto no mapa, não trava o jogo
	end
	if Registry.Plots.Near(player, part, Config.ShopDistance) then
		return true
	end
	Registry.Remotes.NotifyPlayer(player, "Chega mais perto do balcão.", nil, "error")
	return false
end

local function sound(player: Player, name: string)
	Registry.Remotes.Fx:FireClient(player, "sound", nil, name)
end

local function buyHen(player: Player, henId: any)
	local data = Registry.Economy.Data(player)
	local hen = type(henId) == "string" and Config.HenById[henId]
	if not data or not hen or not nearShop(player, "HenShopPoint") then
		return
	end
	local cap = Formulas.UpgradeValue(Config, data, "Ninhos")
	local replaceIndex = nil
	if #data.Hens >= cap then
		-- ninhos cheios: troca a ave mais fraca, se a nova for melhor
		local weakest, weakestTier = nil, math.huge
		for i, id in data.Hens do
			local h = Config.HenById[id]
			local tier = if h then h.Tier else 0
			if tier < weakestTier then
				weakest, weakestTier = i, tier
			end
		end
		if not weakest or weakestTier >= hen.Tier then
			Registry.Remotes.NotifyPlayer(player, "Sem ninho livre. Compra Mais Ninhos ou uma ave melhor.", nil, "error")
			return
		end
		replaceIndex = weakest
	end
	if not Registry.Economy.Spend(player, hen.Price) then
		Registry.Remotes.NotifyPlayer(player, "Falta moeda.", nil, "error")
		return
	end
	if replaceIndex then
		local old = Config.HenById[data.Hens[replaceIndex]]
		data.Hens[replaceIndex] = hen.Id
		if old then
			Registry.Economy.AddCoins(player, math.floor(old.Price * Config.ReplaceRefund), false)
			Registry.Remotes.NotifyPlayer(player, ("%s saiu, %s entrou."):format(old.Name, hen.Name), nil, "success")
		end
		local plot = Registry.Plots.Of(player)
		if plot then
			plot.NestEggs[replaceIndex] = {}
			Registry.Plots.RefreshNest(plot, replaceIndex)
		end
	else
		table.insert(data.Hens, hen.Id)
		Registry.Remotes.NotifyPlayer(player, ("%s chegou na granja."):format(hen.Name), nil, "success")
	end
	data.Stats.HensBought += 1
	Registry.Economy.Mission(player, "buyHen", 1)
	local plot = Registry.Plots.Of(player)
	if plot then
		Registry.Plots.RefreshHens(plot)
	end
	sound(player, "Comprar")
	Registry.Economy.Push(player)
end

local function buyUpgrade(player: Player, upgradeId: any)
	local data = Registry.Economy.Data(player)
	local upgrade = type(upgradeId) == "string" and Config.UpgradeById[upgradeId]
	if not data or not upgrade or not nearShop(player, "UpgradeShopPoint") then
		return
	end
	local cost = Formulas.UpgradeCost(Config, data, upgrade.Id)
	if not cost then
		Registry.Remotes.NotifyPlayer(player, "Essa já tá no máximo.", nil, "info")
		return
	end
	if not Registry.Economy.Spend(player, cost) then
		Registry.Remotes.NotifyPlayer(player, "Falta moeda.", nil, "error")
		return
	end
	data.Upgrades[upgrade.Id] = Formulas.UpgradeLevel(data, upgrade.Id) + 1
	Registry.Remotes.NotifyPlayer(player, ("%s nível %d"):format(upgrade.Name, data.Upgrades[upgrade.Id]), nil, "success")
	local plot = Registry.Plots.Of(player)
	if plot then
		Registry.Plots.RefreshUpgrades(plot)
	end
	Registry.Economy.ApplySpeed(player)
	sound(player, "Comprar")
	Registry.Economy.Push(player)
end

local function rebirth(player: Player)
	local data = Registry.Economy.Data(player)
	if not data then
		return
	end
	local cost = Formulas.RebirthCost(Config, data)
	if data.Coins < cost then
		Registry.Remotes.NotifyPlayer(player, "Ainda falta moeda pro rebirth.", nil, "error")
		return
	end
	data.Rebirths += 1
	data.Coins = Config.StartCoins
	data.Hens = table.clone(Config.StartHens)
	data.Basket = {}
	for _, upgrade in Config.Upgrades do
		data.Upgrades[upgrade.Id] = 0
	end
	local plot = Registry.Plots.Of(player)
	if plot then
		for i = 1, #plot.Nests do
			plot.NestEggs[i] = {}
		end
		Registry.Plots.RefreshAll(plot)
	end
	Registry.Economy.ApplySpeed(player)
	Registry.Remotes.NotifyAll(("%s fez o rebirth %d"):format(player.DisplayName, data.Rebirths), nil, "event")
	Registry.Remotes.Fx:FireClient(player, "rebirth", nil, data.Rebirths)
	sound(player, "Rebirth")
	Registry.Economy.Push(player)
	task.spawn(Registry.Data.Save, player) -- rebirth é importante: salva já
end

function Shop.Init()
	-- balcões da praça: chegar perto e apertar E abre o painel certo na tela
	for pointName, info in { HenShopPoint = { "Hens", "Ver aves", "Galinheiro do Seu Zé" }, UpgradeShopPoint = { "Upgrades", "Ver melhorias", "Oficina" }, RebirthPoint = { "Rebirth", "Rebirth", "Altar" }, MissionPoint = { "Missions", "Ver missões", "Quadro" } } do
		local part = point(pointName)
		if part then
			local prompt = Registry.Plots.MakePrompt(part, info[2], info[3], "all", 0, 14)
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt:SetAttribute("Opens", info[1])
		end
	end
	Registry.Remotes.On("BuyHen", buyHen)
	Registry.Remotes.On("BuyUpgrade", buyUpgrade)
	Registry.Remotes.On("Rebirth", rebirth)
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="603">
        <Properties>
          <string name="Name">Store</string>
          <string name="Source"><![CDATA[--[[
	Store: vendas em Robux.
	  • Game passes (compra uma vez): Dinheiro x2, Cesta VIP, Coleta Automática.
	    Entrega pelo evento PromptGamePassPurchaseFinished NO SERVIDOR (não depende do cache do
	    UserOwnsGamePassAsync, que pode dizer "não tem" logo depois da compra) e guarda nos dados.
	  • Produtos (compra várias vezes): pacotes de moedas e boosts por tempo.
	    Entrega pelo ProcessReceipt: cada compra (PurchaseId) é entregue UMA vez só, e só confirma
	    para o Roblox depois de salvar. Se o save falhar, o Roblox tenta de novo e nada é dado em dobro.
	IDs ficam em Config.GamePasses e Config.Products (0 = desligado).
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Registry = require(script.Parent.Registry)

local Store = {}

local MAX_RECEIPTS = 50

local passById: { [number]: any } = {}
local passByKey: { [string]: any } = {}
local productById: { [number]: any } = {}
local productByKey: { [string]: any } = {}

for _, pass in Config.GamePasses do
	passByKey[pass.Key] = pass
	if pass.Id and pass.Id > 0 then
		passById[pass.Id] = pass
	end
end
for _, product in Config.Products do
	productByKey[product.Key] = product
	if product.Id and product.Id > 0 then
		productById[product.Id] = product
	end
end

local function grantPass(player: Player, pass: any)
	local data = Registry.Economy.Data(player)
	Registry.Economy.Owned(player)[pass.Key] = true
	if data then
		data.Passes[pass.Key] = true
	end
	Registry.Remotes.NotifyPlayer(player, ("Valeu! %s ligado."):format(pass.Name), nil, "success")
	Registry.Remotes.Fx:FireClient(player, "sound", nil, "Comprar")
	Registry.Economy.Push(player)
end

-- Confere os game passes de quem entrou (o que já estava salvo também vale)
function Store.CheckPasses(player: Player)
	for _, pass in Config.GamePasses do
		if pass.Id and pass.Id > 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if ok and has then
				Registry.Economy.Owned(player)[pass.Key] = true
				local data = Registry.Economy.Data(player)
				if data then
					data.Passes[pass.Key] = true
				end
			end
		end
	end
	Registry.Economy.Push(player)
end

local function buyPass(player: Player, key: any)
	local pass = type(key) == "string" and passByKey[key]
	if not pass or not pass.Id or pass.Id <= 0 then
		return
	end
	if Registry.Economy.HasPass(player, pass.Key) then
		Registry.Remotes.NotifyPlayer(player, "Você já tem esse.", nil, "info")
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.Id)
end

local function buyProduct(player: Player, key: any)
	local product = type(key) == "string" and productByKey[key]
	if not product or not product.Id or product.Id <= 0 then
		return
	end
	MarketplaceService:PromptProductPurchase(player, product.Id)
end

local function deliverProduct(player: Player, data: any, product: any)
	if product.Kind == "coins" then
		local coins = Formulas.ProductCoins(Config, product, data)
		Registry.Economy.AddCoins(player, coins, false)
		Registry.Remotes.NotifyPlayer(player, ("Valeu! +%d moedas."):format(coins), nil, "success")
		Registry.Remotes.Fx:FireClient(player, "gift", nil, coins)
	elseif product.Kind == "boost" then
		local now = os.time()
		local current = math.max(now, tonumber(data.Boosts[product.Boost]) or 0)
		data.Boosts[product.Boost] = current + product.Seconds
		Registry.Remotes.NotifyPlayer(player, ("Valeu! %s ligado."):format(product.Name), nil, "success")
	end
	Registry.Remotes.Fx:FireClient(player, "sound", nil, "Comprar")
	Registry.Economy.Push(player)
end

local function processReceipt(receipt: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local product = productById[receipt.ProductId]
	if not player or not product then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = Registry.Economy.Data(player)
	local profile = Registry.Data.Get(player)
	if not data or not profile or not profile.CanSave then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if table.find(data.Receipts, purchaseId) then
		-- já entregue nesta sessão: só confirma ao Roblox depois que estiver salvo
		return if Registry.Data.Save(player) then Enum.ProductPurchaseDecision.PurchaseGranted else Enum.ProductPurchaseDecision.NotProcessedYet
	end
	deliverProduct(player, data, product)
	table.insert(data.Receipts, purchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
	if Registry.Data.Save(player) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- não salvou agora: o Roblox chama de novo; como o PurchaseId já está nos dados, não entrega em dobro
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function Store.Init()
	Registry.Remotes.On("BuyPass", buyPass)
	Registry.Remotes.On("BuyProduct", buyProduct)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
		local pass = passById[passId]
		if purchased and pass then
			grantPass(player, pass)
		end
	end)
	MarketplaceService.ProcessReceipt = processReceipt
end

return Store
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="604">
      <Properties>
        <string name="Name">Main</string>
        <string name="Source"><![CDATA[--[[
	VENDA UM OVO - script principal do servidor (Script "Main" em ServerScriptService).
	Liga os módulos da pasta "Game" e cuida da entrada/saída dos jogadores.
	Pra ajustar o jogo, mexa em ReplicatedStorage > Shared > Config.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local AssetLib = require(ReplicatedStorage.Shared.AssetLib)
local Config = require(ReplicatedStorage.Shared.Config)
local GameFolder = script.Parent:WaitForChild("Game")
local Registry = require(GameFolder.Registry)

-- Cenário: troca cada objeto pela versão atual de ReplicatedStorage > Assets (arte 3D nova entra aqui)
local okScenery, errScenery = pcall(AssetLib.RefreshScenery, workspace)
if not okScenery then
	warn("[Main] cenário:", errScenery)
end

-- Texturas (Config.Textures): peças com o atributo "Tex" ganham a textura que repete
for _, d in workspace:GetDescendants() do
	local texName = d:IsA("BasePart") and d:GetAttribute("Tex")
	local id = texName and Config.Textures[texName]
	if id and id ~= "" then
		for _, face in { Enum.NormalId.Top, Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right } do
			local texture = Instance.new("Texture")
			texture.Texture = id
			texture.Face = face
			texture.StudsPerTileU = Config.TextureTile
			texture.StudsPerTileV = Config.TextureTile
			texture.Parent = d
		end
	end
end

Registry.Remotes = require(GameFolder.Remotes)
Registry.Data = require(GameFolder.Data)
Registry.Economy = require(GameFolder.Economy)
Registry.Plots = require(GameFolder.Plots)
Registry.Farm = require(GameFolder.Farm)
Registry.Shop = require(GameFolder.Shop)
Registry.Daily = require(GameFolder.Daily)
Registry.Store = require(GameFolder.Store)
Registry.Leaderboard = require(GameFolder.Leaderboard)

-- Cada sistema liga sozinho; se um der erro, os outros continuam
for _, name in { "Economy", "Plots", "Farm", "Shop", "Daily", "Store", "Leaderboard" } do
	local ok, err = pcall(Registry[name].Init)
	if not ok then
		warn("[Main] " .. name .. ".Init falhou:", err)
	end
end

local function onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	Registry.Economy.ApplySpeed(player)
	-- renasce sozinho depois de cair/morrer
	humanoid.Died:Connect(function()
		task.wait(3)
		if player.Parent and player.Character == character then
			player:LoadCharacter()
		end
	end)
	-- nasce dentro da própria granja
	local plot = Registry.Plots.Of(player)
	if plot and character:WaitForChild("HumanoidRootPart", 10) then
		task.defer(function()
			character:PivotTo(Registry.Plots.SpawnCFrame(plot))
		end)
	end
end

local function onPlayerAdded(player: Player)
	Registry.Economy.SetupPlayer(player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)

	local profile = Registry.Data.Load(player)
	if not player.Parent then
		if profile.CanSave then
			Registry.Data.Save(player, true)
		end
		Registry.Data.Remove(player)
		return
	end
	if not profile.CanSave and not RunService:IsStudio() then
		player:Kick("Não deu pra carregar seu progresso agora (Roblox ocupado). Ele tá salvo, entra de novo.")
		return
	end
	player:SetAttribute("Loaded", true)
	local plot = Registry.Plots.Assign(player)
	if not plot then
		player:Kick("Servidor cheio. Tenta outro.")
		return
	end
	Registry.Daily.Check(player)
	task.spawn(Registry.Store.CheckPasses, player)
	Registry.Economy.Push(player)
	player:LoadCharacter()
end

local function onPlayerRemoving(player: Player)
	pcall(Registry.Leaderboard.Write, player)
	pcall(Registry.Plots.Release, player)
	Registry.Remotes.RemovePlayer(player)
	Registry.Data.Save(player, true)
	Registry.Data.Remove(player)
end

Players.CharacterAutoLoads = false -- nasce só depois de carregar os dados e ganhar a granja
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- Salva todo mundo de tempos em tempos
task.spawn(function()
	while true do
		task.wait(60)
		for _, player in Players:GetPlayers() do
			task.spawn(Registry.Data.Save, player)
		end
	end
end)

-- Salva quando o servidor fecha
game:BindToClose(function()
	local pending = 0
	for _, player in Players:GetPlayers() do
		pending += 1
		task.spawn(function()
			pcall(Registry.Leaderboard.Write, player)
			Registry.Data.Save(player, true)
			pending -= 1
		end)
	end
	local started = os.clock()
	while (pending > 0 or Registry.Data.ActiveSaves() > 0) and os.clock() - started < 25 do
		task.wait(0.1)
	end
end)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="SoundService" referent="605">
