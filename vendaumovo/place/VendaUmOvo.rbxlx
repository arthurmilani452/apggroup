      <Item class="ModuleScript" referent="594">
        <Properties>
          <string name="Name">Daily</string>
          <string name="Source"><![CDATA[--[[
	Daily: missões diárias e presente por tempo de jogo.
	Usa SÓ o relógio do servidor (os.time no servidor): mudar a hora do celular não adianta.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Registry = require(script.Parent.Registry)

local Daily = {}

-- Dia novo (UTC do servidor) = missões novas
function Daily.Check(player: Player)
	local data = Registry.Economy.Data(player)
	if not data then
		return
	end
	local today = Formulas.DayKey(os.time())
	if data.Daily.Day ~= today then
		data.Daily = { Day = today, List = Formulas.MakeMissions(Config, data, today) }
		Registry.Economy.Push(player)
	end
end

local function claimMission(player: Player, index: any)
	local data = Registry.Economy.Data(player)
	if not data or type(index) ~= "number" then
		return
	end
	Daily.Check(player)
	local mission = data.Daily.List[index]
	if not mission or mission.Claimed or mission.Progress < mission.Target then
		return
	end
	mission.Claimed = true
	Registry.Economy.AddCoins(player, mission.Reward, false)
	Registry.Remotes.NotifyPlayer(player, ("Missão feita. +%d moedas"):format(mission.Reward), nil, "success")
	Registry.Remotes.Fx:FireClient(player, "sound", nil, "Comprar")
	Registry.Economy.Push(player)
end

local function claimGift(player: Player)
	local data = Registry.Economy.Data(player)
	if not data or data.GiftSeconds < Config.GiftInterval then
		return
	end
	local reward = Formulas.GiftReward(Config, data, Registry.Economy.Owned(player), os.time())
	data.GiftSeconds = 0
	Registry.Economy.AddCoins(player, reward, false)
	Registry.Remotes.NotifyPlayer(player, ("+%d moedas do presente"):format(reward), nil, "success")
	Registry.Remotes.Fx:FireClient(player, "gift", nil, reward)
	Registry.Economy.Push(player)
end

function Daily.Init()
	Registry.Remotes.On("ClaimMission", claimMission)
	Registry.Remotes.On("ClaimGift", claimGift)

	-- conta o tempo de jogo (no servidor) e troca as missões na virada do dia
	task.spawn(function()
		local ticks = 0
		while true do
			task.wait(1)
			ticks += 1
			for _, player in Players:GetPlayers() do
				local data = Registry.Economy.Data(player)
				if data then
					local before = data.GiftSeconds
					data.GiftSeconds = math.min(Config.GiftInterval, data.GiftSeconds + 1)
					if before < Config.GiftInterval and data.GiftSeconds >= Config.GiftInterval then
						Registry.Remotes.NotifyPlayer(player, "Tem presente pra abrir", nil, "event")
						Registry.Economy.Push(player)
					end
					if ticks % 30 == 0 then
						Daily.Check(player)
					end
				end
			end
		end
	end)
end

return Daily
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="595">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[--[[
	Data: salva e carrega o progresso (mesma base segura do Steal a Critter e do Zona Zero):
	  • UpdateAsync com trava de sessão (dois servidores nunca mexem nos dados do mesmo jogador)
	  • várias tentativas quando o Roblox falha
	  • salva ao sair, a cada 60 s e quando o servidor fecha
	  • se o carregamento falhar, NÃO salva por cima (o progresso antigo fica seguro)
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local Data = {}

export type Profile = {
	Data: any,
	CanSave: boolean,
	Saving: boolean,
	Final: boolean,
}

local SESSION_TIMEOUT = 150

local profiles: { [Player]: Profile } = {}
local finalSaving: { [number]: boolean } = {}
local activeSaves = 0

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Data] DataStore indisponível:", result)
	end
end

-- Hens: lista de ids de ave (a ordem = o ninho de cada uma)
-- Basket: { [ovo] = quantidade }, ovos raros com "*" no fim (ex.: "dourado*")
local function defaultData()
	local upgrades = {}
	for _, upgrade in Config.Upgrades do
		upgrades[upgrade.Id] = 0
	end
	return {
		Coins = Config.StartCoins,
		Rebirths = 0,
		Hens = table.clone(Config.StartHens),
		Basket = {},
		Upgrades = upgrades,
		TotalEarned = 0, -- tudo que já vendeu (placar global)
		Passes = {}, -- game passes entregues (cópia de segurança do UserOwnsGamePassAsync)
		Boosts = {}, -- { Sorte = os.time() em que acaba, Turbo = ... }
		Receipts = {}, -- últimas compras de produtos já entregues (nunca entrega duas vezes)
		Daily = { Day = 0, List = {} },
		GiftSeconds = 0,
		Stats = { Collected = 0, Sold = 0, Rare = 0, SellTrips = 0, HensBought = 0 },
		SaveSeq = 0,
	}
end

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

-- Tabelas que ganham chaves novas quando o jogo cresce (melhoria nova, estatística nova...)
local NESTED = { Upgrades = true, Stats = true }

-- Completa o que faltar (versões antigas do save), sem mexer em listas que já existem
local function reconcile(data: any)
	for key, value in defaultData() do
		if data[key] == nil then
			data[key] = value
		elseif NESTED[key] and type(data[key]) == "table" then
			for subKey, subValue in value do
				if data[key][subKey] == nil then
					data[key][subKey] = subValue
				end
			end
		end
	end
	return data
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function lockedByOther(value: any): boolean
	if type(value) ~= "table" or type(value.Session) ~= "table" then
		return false
	end
	local session = value.Session
	return session.JobId ~= game.JobId and os.time() - (tonumber(session.Time) or 0) < SESSION_TIMEOUT
end

function Data.Load(player: Player): Profile
	-- quem saiu e voltou no MESMO servidor espera o save da saída terminar
	local waited = 0
	while finalSaving[player.UserId] and waited < 40 and player.Parent do
		waited += task.wait(0.25)
	end
	local loaded, result = false, nil
	if store then
		local attempts = 6
		for attempt = 1, attempts do
			if not player.Parent then
				break
			end
			local locked = false
			local ok, err = pcall(function()
				(store :: DataStore):UpdateAsync(keyFor(player), function(old)
					if lockedByOther(old) and attempt < attempts then
						locked = true
						return nil
					end
					locked = false
					local data = reconcile(if type(old) == "table" then old else defaultData())
					data.Session = { JobId = game.JobId, Time = os.time() }
					result = data
					return data, { player.UserId }
				end)
			end)
			if ok and not locked then
				loaded = true
				break
			end
			if not ok then
				warn(("[Data] Falha ao carregar %s (tentativa %d): %s"):format(player.Name, attempt, tostring(err)))
				if RunService:IsStudio() then
					break
				end
			end
			task.wait(if locked then 3 else 2)
		end
	end
	local profile: Profile = {
		Data = if loaded and result then result else defaultData(),
		CanSave = loaded,
		Saving = false,
		Final = false,
	}
	profiles[player] = profile
	if not loaded then
		warn("[Data] O progresso de " .. player.Name .. " NÃO será salvo nesta sessão.")
	end
	return profile
end

function Data.Get(player: Player): Profile?
	return profiles[player]
end

function Data.ActiveSaves(): number
	return activeSaves
end

function Data.Save(player: Player, isFinal: boolean?): boolean
	local profile = profiles[player]
	if not profile or not profile.CanSave or not store then
		return false
	end
	activeSaves += 1
	if isFinal then
		finalSaving[player.UserId] = true
	end
	local waited = 0
	local limit = if isFinal then 30 else 15
	while profile.Saving and waited < limit do
		waited += task.wait(0.1)
	end
	if profile.Final or not profile.CanSave or (profile.Saving and not isFinal) then
		if isFinal and not profile.Saving then
			finalSaving[player.UserId] = nil
		end
		activeSaves -= 1
		return false
	end
	profile.Saving = true
	if isFinal then
		profile.Final = true
	end
	profile.Data.SaveSeq = (tonumber(profile.Data.SaveSeq) or 0) + 1
	local snapshot = deepCopy(profile.Data)

	local success, lostLock = false, false
	for attempt = 1, if isFinal then 5 else 3 do
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(keyFor(player), function(old)
				if lockedByOther(old) then
					lostLock = true
					return nil
				end
				lostLock = false
				if type(old) == "table" and (tonumber(old.SaveSeq) or 0) > snapshot.SaveSeq then
					return nil
				end
				snapshot.Session = if isFinal then nil else { JobId = game.JobId, Time = os.time() }
				return snapshot, { player.UserId }
			end)
		end)
		if ok then
			success = not lostLock
			break
		end
		warn(("[Data] Falha ao salvar %s (tentativa %d): %s"):format(player.Name, attempt, tostring(err)))
		task.wait(1)
	end
	if lostLock then
		profile.CanSave = false
		if player.Parent and not isFinal then
			player:Kick("Seu progresso abriu em outro servidor. Entra de novo.")
		end
	end
	profile.Saving = false
	if isFinal then
		finalSaving[player.UserId] = nil
	end
	activeSaves -= 1
	return success
end

function Data.Remove(player: Player)
	profiles[player] = nil
end

return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="596">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--[[
	Economy: moedas, leaderstats, velocidade, missões (progresso) e o "estado" que vai para a tela.
	Todo lugar que muda os dados de alguém chama Economy.Push(player) no final.
	Só o SERVIDOR mexe em moedas: o cliente nunca manda valores, só pede ações.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Registry = require(script.Parent.Registry)

local Economy = {}

local dirty: { [Player]: boolean } = {}
local owned: { [Player]: { [string]: boolean } } = {} -- game passes desta sessão

function Economy.Data(player: Player): any?
	if player:GetAttribute("Loaded") ~= true then
		return nil
	end
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

function Economy.Owned(player: Player): { [string]: boolean }
	local t = owned[player]
	if not t then
		t = {}
		owned[player] = t
	end
	return t
end

function Economy.HasPass(player: Player, key: string): boolean
	local data = Economy.Data(player)
	return data ~= nil and Formulas.HasPass(data, key, owned[player])
end

function Economy.Multiplier(player: Player): number
	local data = Economy.Data(player)
	return if data then Formulas.Multiplier(Config, data, owned[player], os.time()) else 1
end

function Economy.BasketCapacity(player: Player): number
	local data = Economy.Data(player)
	return if data then Formulas.BasketCapacity(Config, data, owned[player]) else 0
end

function Economy.SetupPlayer(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Moedas"
	coins.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player
end

-- Moedas ganhas (venda, missão, presente, compra). "earned" conta para o placar e a missão "ganhe moedas".
function Economy.AddCoins(player: Player, amount: number, earned: boolean)
	local data = Economy.Data(player)
	amount = math.floor(amount)
	if not data or amount <= 0 then
		return
	end
	data.Coins += amount
	if earned then
		data.TotalEarned += amount
		Economy.Mission(player, "earn", amount)
	end
	Economy.Push(player)
end

function Economy.Spend(player: Player, amount: number): boolean
	local data = Economy.Data(player)
	if not data or amount < 0 or amount ~= amount or data.Coins < amount then
		return false
	end
	data.Coins -= amount
	Economy.Push(player)
	return true
end

-- Progresso de missão diária (troca de dia é feita em Daily)
function Economy.Mission(player: Player, missionId: string, amount: number)
	local data = Economy.Data(player)
	if not data or not data.Daily or not data.Daily.List then
		return
	end
	for _, mission in data.Daily.List do
		if mission.Id == missionId and not mission.Claimed and mission.Progress < mission.Target then
			mission.Progress = math.min(mission.Target, mission.Progress + amount)
			Economy.Push(player)
		end
	end
end

function Economy.ApplySpeed(player: Player)
	local data = Economy.Data(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if data and humanoid then
		humanoid.WalkSpeed = Formulas.UpgradeValue(Config, data, "Velocidade")
	end
end

function Economy.Push(player: Player)
	dirty[player] = true
end

local function snapshot(player: Player, data: any): any
	local now = os.time()
	local serverNow = workspace:GetServerTimeNow()
	local plot = Registry.Plots.Of(player)
	local boosts = {}
	for key, ends in data.Boosts do
		if ends > now then
			boosts[key] = serverNow + (ends - now)
		end
	end
	local passes = {}
	for _, pass in Config.GamePasses do
		passes[pass.Key] = Formulas.HasPass(data, pass.Key, owned[player])
	end
	return {
		Coins = data.Coins,
		Rebirths = data.Rebirths,
		Basket = data.Basket,
		BasketCount = Formulas.BasketCount(data),
		BasketCap = Formulas.BasketCapacity(Config, data, owned[player]),
		Mult = Formulas.Multiplier(Config, data, owned[player], now),
		Upgrades = data.Upgrades,
		Hens = data.Hens,
		NestCap = Formulas.UpgradeValue(Config, data, "Ninhos"),
		RebirthCost = Formulas.RebirthCost(Config, data),
		Daily = data.Daily.List,
		GiftLeft = math.max(0, Config.GiftInterval - data.GiftSeconds),
		GiftReward = Formulas.GiftReward(Config, data, owned[player], now),
		Passes = passes,
		Boosts = boosts,
		TotalEarned = data.TotalEarned,
		Plot = if plot then plot.Index else 0,
	}
end

function Economy.Init()
	task.spawn(function()
		while true do
			task.wait(0.2)
			for player in dirty do
				dirty[player] = nil
				local data = Economy.Data(player)
				if data and player.Parent then
					local ok, err = pcall(function()
						local stats = player:FindFirstChild("leaderstats")
						if stats then
							local coins = stats:FindFirstChild("Moedas") :: IntValue
							local rebirths = stats:FindFirstChild("Rebirths") :: IntValue
							coins.Value = math.floor(data.Coins)
							rebirths.Value = data.Rebirths
						end
						Registry.Remotes.State:FireClient(player, snapshot(player, data))
					end)
					if not ok then
						warn("[Economy] push falhou:", err)
					end
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
		owned[player] = nil
	end)
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="597">
        <Properties>
          <string name="Name">Farm</string>
          <string name="Source"><![CDATA[--[[
	Farm: o ciclo da granja.
	  ave bota no ninho → jogador coleta (cesta) → leva até a banca → vende
	Também a coleta automática e a esteira (leva os ovos até a banca e vende sozinha).
	Tudo é conferido aqui no servidor: dono, distância, espaço na cesta, intervalo entre ações.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AssetLib = require(ReplicatedStorage.Shared.AssetLib)
local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Registry = require(script.Parent.Registry)

local Farm = {}

local timers: { [any]: { number } } = {} -- [plot][ninho] = segundos acumulados
local lastAction: { [Player]: { [string]: number } } = {}
local beltCount: { [any]: number } = {}

local MAX_BELT_EGGS = 8

local function cooldown(player: Player, action: string, seconds: number): boolean
	local t = lastAction[player]
	if not t then
		t = {}
		lastAction[player] = t
	end
	local now = os.clock()
	if now - (t[action] or 0) < seconds then
		return false
	end
	t[action] = now
	return true
end

local function notify(player: Player, text: string, kind: string?)
	Registry.Remotes.NotifyPlayer(player, text, nil, kind)
end

-- Move ovos de um ninho para a cesta. Devolve quantos foram.
local function takeFromNest(player: Player, plot: any, index: number, data: any): number
	local eggs = plot.NestEggs[index]
	if not eggs or #eggs == 0 then
		return 0
	end
	local space = Registry.Economy.BasketCapacity(player) - Formulas.BasketCount(data)
	local moved, rares = 0, 0
	while space > 0 and #eggs > 0 do
		local entry = table.remove(eggs, 1)
		local key = Formulas.EggKey(entry.Egg, entry.Rare)
		data.Basket[key] = (data.Basket[key] or 0) + 1
		space -= 1
		moved += 1
		if entry.Rare then
			rares += 1
		end
	end
	if moved > 0 then
		data.Stats.Collected += moved
		Registry.Economy.Mission(player, "collect", moved)
		if rares > 0 then
			data.Stats.Rare += rares
			Registry.Economy.Mission(player, "rare", rares)
		end
		Registry.Plots.RefreshNest(plot, index)
	end
	return moved
end

function Farm.Collect(player: Player, plot: any, index: number)
	if plot.Owner ~= player or type(index) ~= "number" then
		return
	end
	local data = Registry.Economy.Data(player)
	local nest = plot.Nests[index]
	if not data or not nest or not Registry.Plots.Near(player, nest, Config.CollectDistance) then
		return
	end
	if not cooldown(player, "collect" .. index, 0.3) then
		return
	end
	if Formulas.BasketCount(data) >= Registry.Economy.BasketCapacity(player) then
		if cooldown(player, "fullMsg", 3) then
			notify(player, "Cesta cheia. Leva pra banca!", "error")
		end
		return
	end
	local moved = takeFromNest(player, plot, index, data)
	if moved > 0 then
		Registry.Remotes.Fx:FireClient(player, "collect", nest.Position, moved)
		Registry.Economy.Push(player)
	end
end

function Farm.Sell(player: Player, plot: any)
	if plot.Owner ~= player then
		return
	end
	local data = Registry.Economy.Data(player)
	local point = plot.Parts.SellPoint
	if not data or not Registry.Plots.Near(player, point, Config.SellDistance) then
		return
	end
	if not cooldown(player, "sell", 0.75) then
		return
	end
	local value, count = Formulas.BasketValue(Config, data, Registry.Economy.Owned(player), os.time())
	if count <= 0 then
		if cooldown(player, "emptyMsg", 4) then
			notify(player, "Cesta vazia. Pega ovo nos ninhos primeiro.", "info")
		end
		return
	end
	data.Basket = {}
	data.Stats.Sold += count
	data.Stats.SellTrips += 1
	Registry.Economy.AddCoins(player, value, true)
	Registry.Economy.Mission(player, "sell", count)
	Registry.Economy.Mission(player, "sellTrips", 1)
	Registry.Remotes.Fx:FireAllClients("money", point.Position + Vector3.new(0, 4, 0), value)
	Registry.Remotes.Fx:FireClient(player, "sold", point.Position, count)
	Registry.Economy.Push(player)
end

-- Ovo na esteira: anda pelos pontos ConvPath até a banca e vende sozinho
local function sendOnBelt(player: Player, plot: any, eggId: string, rare: boolean)
	local data = Registry.Economy.Data(player)
	if not data then
		return
	end
	local function credit()
		if plot.Owner ~= player then
			return
		end
		local value = math.floor(Formulas.EggValue(Config, eggId, rare) * Registry.Economy.Multiplier(player) + 0.5)
		data.Stats.Sold += 1
		Registry.Economy.AddCoins(player, value, true)
		Registry.Economy.Mission(player, "sell", 1)
	end
	local path = plot.Path
	if #path < 2 or (beltCount[plot] or 0) >= MAX_BELT_EGGS then
		credit() -- esteira lotada: vende direto (sem o ovo andando)
		return
	end
	local model = Registry.Plots.MakeEgg(eggId, rare)
	if not model then
		credit()
		return
	end
	beltCount[plot] = (beltCount[plot] or 0) + 1
	local beltFolder = plot.Visuals:FindFirstChild("Belt")
	model.Parent = beltFolder
	task.spawn(function()
		local total = 0
		for i = 1, #path - 1 do
			total += (path[i + 1].Position - path[i].Position).Magnitude
		end
		local speed = math.max(total / Config.ConveyorTravelTime, 1)
		for i = 1, #path - 1 do
			local a, b = path[i].Position, path[i + 1].Position
			local length = (b - a).Magnitude
			local t = 0
			while t < length and model.Parent do
				t = math.min(length, t + speed * 0.1)
				local p = a:Lerp(b, if length > 0 then t / length else 1)
				AssetLib.PlaceAt(model, p, 0)
				task.wait(0.1)
			end
		end
		model:Destroy()
		beltCount[plot] = math.max(0, (beltCount[plot] or 1) - 1)
		credit()
	end)
end

function Farm.Init()
	-- aves botam
	task.spawn(function()
		local STEP = 0.5
		while true do
			task.wait(STEP)
			for _, plot in Registry.Plots.All() do
				local owner = plot.Owner
				if not owner then
					timers[plot] = nil
					continue
				end
				local ok, err = pcall(function()
					local data = Registry.Economy.Data(owner)
					if not data then
						return
					end
					local t = timers[plot]
					if not t then
						t = {}
						timers[plot] = t
					end
					local now = os.time()
					local conveyor = Formulas.UpgradeValue(Config, data, "Esteira") > 0
					for i, henId in data.Hens do
						local hen = Config.HenById[henId]
						if not hen or not plot.Nests[i] then
							continue
						end
						local layTime = Formulas.LayTime(Config, data, henId)
						t[i] = (t[i] or math.random() * layTime * 0.5) + STEP
						if t[i] < layTime then
							continue
						end
						local rare = math.random() < Formulas.RareChance(Config, data, now)
						if conveyor then
							t[i] = 0
							sendOnBelt(owner, plot, hen.Egg, rare)
						elseif #plot.NestEggs[i] < Config.EggsPerNest then
							t[i] = 0
							table.insert(plot.NestEggs[i], { Egg = hen.Egg, Rare = rare })
							Registry.Plots.RefreshNest(plot, i)
						else
							t[i] = layTime -- ninho cheio: espera coletar
							continue
						end
						if rare then
							local egg = Config.EggById[hen.Egg]
							Registry.Remotes.Fx:FireClient(owner, "rare", plot.Nests[i].Position, egg and egg.Name or "")
							if egg and egg.Legendary then
								Registry.Remotes.NotifyAll(owner.DisplayName .. " tirou um " .. egg.Name .. " raro!", nil, "event")
							end
						end
					end
				end)
				if not ok then
					warn("[Farm] erro:", err)
				end
			end
		end
	end)

	-- coleta automática (melhoria ou game pass): pega os ovos de todos os ninhos sozinha
	task.spawn(function()
		while true do
			task.wait(Config.AutoCollectInterval)
			for _, plot in Registry.Plots.All() do
				local owner = plot.Owner
				local data = owner and Registry.Economy.Data(owner)
				if not owner or not data then
					continue
				end
				local auto = Formulas.UpgradeValue(Config, data, "ColetaAuto") > 0 or Registry.Economy.HasPass(owner, "ColetaAuto")
				if not auto then
					continue
				end
				local moved = 0
				for i = 1, #plot.Nests do
					moved += takeFromNest(owner, plot, i, data)
				end
				if moved > 0 then
					Registry.Economy.Push(owner)
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastAction[player] = nil
	end)
end

return Farm
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="598">
        <Properties>
          <string name="Name">Leaderboard</string>
          <string name="Source"><![CDATA[--[[
	Leaderboard: placar GLOBAL dos maiores vendedores (todas as moedas já ganhas vendendo).
	Grava num OrderedDataStore a cada 2 min e ao sair; a placa da praça atualiza a cada 90 s.
	Placa: workspace.Plaza (qualquer peça chamada "LeaderboardBoard" com um SurfaceGui "Gui").
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local Leaderboard = {}

local store: OrderedDataStore? = nil
local names: { [number]: string } = {}
local lastWritten: { [number]: number } = {}

local function nameOf(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	names[userId] = if ok and name then name else "Jogador"
	return names[userId]
end

function Leaderboard.Write(player: Player)
	local data = Registry.Economy.Data(player)
	if not store or not data then
		return
	end
	local value = math.floor(data.TotalEarned)
	if lastWritten[player.UserId] == value or value <= 0 then
		return
	end
	local ok, err = pcall(function()
		(store :: OrderedDataStore):SetAsync("u_" .. player.UserId, value)
	end)
	if ok then
		lastWritten[player.UserId] = value
	else
		warn("[Leaderboard] gravar:", err)
	end
end

local function boardGui(): SurfaceGui?
	local plaza = workspace:FindFirstChild("Plaza")
	local board = plaza and plaza:FindFirstChild("LeaderboardBoard", true)
	return board and board:FindFirstChildWhichIsA("SurfaceGui")
end

local function draw(rows: { { name: string, value: number } })
	local gui = boardGui()
	if not gui then
		return
	end
	local list = gui:FindFirstChild("List")
	if not list then
		local frame = Instance.new("Frame")
		frame.Name = "List"
		frame.BackgroundTransparency = 1
		frame.Position = UDim2.fromScale(0.05, 0.2)
		frame.Size = UDim2.fromScale(0.9, 0.78)
		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0.01, 0)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = frame
		frame.Parent = gui
		list = frame
	end
	for _, child in (list :: Frame):GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local medals = { "🥇", "🥈", "🥉" }
	for i, row in rows do
		local label = Instance.new("TextLabel")
		label.LayoutOrder = i
		label.Size = UDim2.fromScale(1, 0.088)
		label.BackgroundColor3 = if i % 2 == 0 then Color3.fromRGB(255, 236, 190) else Color3.fromRGB(255, 246, 220)
		label.BorderSizePixel = 0
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextColor3 = Color3.fromRGB(90, 50, 20)
		label.Text = ("  %s %s   🪙 %s"):format(medals[i] or ("#" .. i), row.name, Format.Short(row.value))
		label.Parent = list
	end
	if #rows == 0 then
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 0.2)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(90, 50, 20)
		label.Text = "Venda ovos para entrar no placar!"
		label.Parent = list
	end
end

local function refresh()
	if not store then
		draw({})
		return
	end
	local ok, pages = pcall(function()
		return (store :: OrderedDataStore):GetSortedAsync(false, 10)
	end)
	if not ok or not pages then
		return
	end
	local rows = {}
	for _, entry in pages:GetCurrentPage() do
		local userId = tonumber(string.match(entry.key, "%d+"))
		if userId then
			table.insert(rows, { name = nameOf(userId), value = entry.value })
		end
	end
	draw(rows)
end

function Leaderboard.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.LeaderboardStore)
	end)
	if ok then
		store = result
	end
	task.spawn(function()
		while true do
			pcall(refresh)
			task.wait(90)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in Players:GetPlayers() do
				Leaderboard.Write(player)
				task.wait(1)
			end
		end
	end)
end

return Leaderboard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="599">
        <Properties>
          <string name="Name">Plots</string>
          <string name="Source"><![CDATA[--[[
	Plots: as granjas (bases) do mapa. Dá uma para cada jogador, devolve quando ele sai
	e desenha o que é dele: aves, ovos nos ninhos, esteira, decorações e a placa com o nome.

	Cada granja (workspace.Plots.PlotN) vem do builder com:
	  Zone, Spawn, Sign (SurfaceGui Gui > Text), SellPoint, SellPad,
	  Nest1..12, HenSpot1..12, ConvPath1..N, Conveyor (Model), Decor1..6 (Models)
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AssetLib = require(ReplicatedStorage.Shared.AssetLib)
local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Registry = require(script.Parent.Registry)

local Plots = {}

export type Plot = {
	Index: number,
	Model: Model,
	Owner: Player?,
	Parts: { [string]: BasePart },
	Nests: { BasePart },
	HenSpots: { BasePart },
	Path: { BasePart },
	NestEggs: { { { Egg: string, Rare: boolean } } },
	NestPrompts: { ProximityPrompt },
	Visuals: Folder,
	SellPrompt: ProximityPrompt,
}

local plots: { Plot } = {}
local byPlayer: { [Player]: Plot } = {}

-- Prompt com dono: o cliente só mostra para quem pode usar ("owner" = só o dono da granja)
function Plots.MakePrompt(parent: Instance, action: string, object: string, forWho: string, hold: number?, distance: number?): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = distance or 10
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("For", forWho)
	prompt:SetAttribute("Active", true)
	prompt:SetAttribute("Owner", 0)
	prompt.Parent = parent
	CollectionService:AddTag(prompt, "VUOPrompt")
	return prompt
end

function Plots.All(): { Plot }
	return plots
end

function Plots.Of(player: Player): Plot?
	return byPlayer[player]
end

function Plots.IsInside(plot: Plot, position: Vector3): boolean
	local zone = plot.Parts.Zone
	local p = zone.CFrame:PointToObjectSpace(position)
	local half = zone.Size / 2
	return math.abs(p.X) <= half.X and math.abs(p.Y) <= half.Y + 20 and math.abs(p.Z) <= half.Z
end

function Plots.RootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Plots.Near(player: Player, part: BasePart, distance: number): boolean
	local root = Plots.RootOf(player)
	return root ~= nil and (root.Position - part.Position).Magnitude <= distance
end

local function folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function clear(f: Instance)
	for _, child in f:GetChildren() do
		child:Destroy()
	end
end

local function sub(plot: Plot, name: string): Folder
	return plot.Visuals:FindFirstChild(name) :: Folder
end

-- ---------------------------------------------------------------------------
-- Desenho
-- ---------------------------------------------------------------------------
local function rareFx(model: Model, color: Color3)
	local _, size = model:GetBoundingBox()
	local anchor = Instance.new("Part")
	anchor.Name = "Glow"
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	local cf = model:GetBoundingBox()
	anchor.CFrame = cf
	anchor.Parent = model
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 8
	light.Brightness = 2
	light.Parent = anchor
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 240, 150))
	sparkle.Size = NumberSequence.new(0.5, 0)
	sparkle.Lifetime = NumberRange.new(0.6, 1)
	sparkle.Rate = 8
	sparkle.Speed = NumberRange.new(1, 2.5)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.LightEmission = 1
	sparkle.Parent = anchor
	local highlight = Instance.new("Highlight")
	highlight.FillTransparency = 0.7
	highlight.OutlineColor = Color3.fromRGB(255, 230, 90)
	highlight.FillColor = color
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = model
	model:SetAttribute("Rare", size.Y > 0)
end

function Plots.MakeEgg(eggId: string, rare: boolean): Model?
	local egg = Config.EggById[eggId]
	if not egg then
		return nil
	end
	local model = AssetLib.Get(egg.Asset, Config.AssetHeights.Ovo)
	if not model then
		return nil
	end
	AssetLib.SetCollide(model, false)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanQuery = false
		end
	end
	if rare then
		rareFx(model, egg.Color)
	end
	return model
end

function Plots.RefreshNest(plot: Plot, index: number)
	local nestFolder = sub(plot, "Eggs"):FindFirstChild("Nest" .. index)
	if nestFolder then
		nestFolder:Destroy()
	end
	local eggs = plot.NestEggs[index]
	local nest = plot.Nests[index]
	local prompt = plot.NestPrompts[index]
	if prompt then
		prompt:SetAttribute("Active", eggs ~= nil and #eggs > 0)
	end
	if not eggs or #eggs == 0 or not nest then
		return
	end
	local f = folder(sub(plot, "Eggs"), "Nest" .. index)
	local top = nest.Position + Vector3.new(0, nest.Size.Y / 2, 0)
	for i, entry in eggs do
		local model = Plots.MakeEgg(entry.Egg, entry.Rare)
		if model then
			local angle = (i - 1) * (math.pi * 2 / 3) + index
			AssetLib.PlaceAt(model, top + Vector3.new(math.cos(angle) * 0.7, -0.35, math.sin(angle) * 0.7), math.deg(angle))
			-- encostar no ovo também coleta (só o dono)
			for _, d in model:GetDescendants() do
				if d:IsA("BasePart") then
					d.CanTouch = true
					d.Touched:Connect(function(hit)
						local player = game:GetService("Players"):GetPlayerFromCharacter(hit.Parent)
						if player and player == plot.Owner then
							Registry.Farm.Collect(player, plot, index)
						end
					end)
					break
				end
			end
			model.Parent = f
		end
	end
end

function Plots.RefreshHens(plot: Plot)
	local f = sub(plot, "Hens")
	clear(f)
	local owner = plot.Owner
	local data = owner and Registry.Economy.Data(owner)
	if not data then
		return
	end
	for i, henId in data.Hens do
		local hen = Config.HenById[henId]
		local spot = plot.HenSpots[i]
		if hen and spot then
			local model = AssetLib.Get(hen.Asset, Config.AssetHeights.Ave)
			if model then
				AssetLib.SetCollide(model, false)
				AssetLib.PlaceAt(model, spot.Position - Vector3.new(0, spot.Size.Y / 2, 0), spot:GetAttribute("Yaw") or 0)
				model.Name = "Ave" .. i
				model:SetAttribute("Hen", henId)
				CollectionService:AddTag(model, "VUOHen")
				model.Parent = f
			end
		end
	end
	-- ninhos sem ave ficam vazios (e somem os ovos de quem saiu)
	for i = 1, #plot.Nests do
		local nest = plot.Nests[i]
		nest:SetAttribute("Used", data.Hens[i] ~= nil)
	end
end

function Plots.RefreshUpgrades(plot: Plot)
	local owner = plot.Owner
	local data = owner and Registry.Economy.Data(owner)
	local hasConveyor = data ~= nil and Formulas.UpgradeValue(Config, data, "Esteira") > 0
	local decor = if data then Formulas.UpgradeLevel(data, "Decoracao") else 0
	local nestCap = if data then Formulas.UpgradeValue(Config, data, "Ninhos") else 0
	local function show(model: Instance?, visible: boolean)
		if not model then
			return
		end
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				if d:GetAttribute("T0") == nil then
					d:SetAttribute("T0", d.Transparency)
					d:SetAttribute("C0", d.CanCollide)
				end
				d.Transparency = if visible then d:GetAttribute("T0") else 1
				d.CanCollide = visible and d:GetAttribute("C0") == true
			elseif d:IsA("Decal") or d:IsA("Texture") then
				d.Transparency = if visible then 0 else 1
			elseif d:IsA("Light") or d:IsA("ParticleEmitter") then
				d.Enabled = visible
			end
		end
	end
	show(plot.Model:FindFirstChild("Conveyor"), hasConveyor)
	for i = 1, 6 do
		show(plot.Model:FindFirstChild("Decor" .. i), decor >= i)
	end
	-- ninhos liberados aparecem; os outros ficam escondidos
	for i = 1, 12 do
		show(plot.Model:FindFirstChild("NestLook" .. i), owner ~= nil and i <= nestCap)
	end
end

function Plots.RefreshSign(plot: Plot)
	local sign = plot.Parts.Sign
	local gui = sign and sign:FindFirstChildWhichIsA("SurfaceGui")
	local label = gui and gui:FindFirstChildWhichIsA("TextLabel")
	if label then
		label.Text = if plot.Owner then "Granja de " .. plot.Owner.DisplayName else "Granja livre"
	end
	plot.Model:SetAttribute("OwnerId", if plot.Owner then plot.Owner.UserId else 0)
end

function Plots.RefreshAll(plot: Plot)
	Plots.RefreshSign(plot)
	Plots.RefreshHens(plot)
	Plots.RefreshUpgrades(plot)
	for i = 1, #plot.Nests do
		Plots.RefreshNest(plot, i)
	end
end

local function setOwnerAttr(plot: Plot)
	local id = if plot.Owner then plot.Owner.UserId else 0
	for _, d in plot.Model:GetDescendants() do
		if d:IsA("ProximityPrompt") then
			d:SetAttribute("Owner", id)
		end
	end
end

-- ---------------------------------------------------------------------------
function Plots.Assign(player: Player): Plot?
	if byPlayer[player] then
		return byPlayer[player]
	end
	for _, plot in plots do
		if not plot.Owner then
			plot.Owner = player
			byPlayer[player] = plot
			plot.NestEggs = {}
			for i = 1, #plot.Nests do
				plot.NestEggs[i] = {}
			end
			setOwnerAttr(plot)
			Plots.RefreshAll(plot)
			return plot
		end
	end
	return nil
end

function Plots.Release(player: Player)
	local plot = byPlayer[player]
	if not plot then
		return
	end
	byPlayer[player] = nil
	plot.Owner = nil
	plot.NestEggs = {}
	setOwnerAttr(plot)
	clear(sub(plot, "Eggs"))
	clear(sub(plot, "Hens"))
	clear(sub(plot, "Belt"))
	Plots.RefreshAll(plot)
end

function Plots.SpawnCFrame(plot: Plot): CFrame
	local spawn = plot.Parts.Spawn
	return spawn.CFrame + Vector3.new(0, 4, 0)
end

function Plots.Init()
	local root = workspace:WaitForChild("Plots")
	local models = root:GetChildren()
	table.sort(models, function(a, b)
		return (a:GetAttribute("Index") or 0) < (b:GetAttribute("Index") or 0)
	end)
	for _, model in models do
		if not model:IsA("Model") then
			continue
		end
		local parts: { [string]: BasePart } = {}
		for _, child in model:GetChildren() do
			if child:IsA("BasePart") then
				parts[child.Name] = child
			end
		end
		local function list(prefix: string): { BasePart }
			local out = {}
			local i = 1
			while parts[prefix .. i] do
				table.insert(out, parts[prefix .. i])
				i += 1
			end
			return out
		end
		local visuals = folder(model, "Visuals")
		for _, name in { "Eggs", "Hens", "Belt" } do
			folder(visuals, name)
		end
		local plot: Plot = {
			Index = model:GetAttribute("Index") or (#plots + 1),
			Model = model,
			Owner = nil,
			Parts = parts,
			Nests = list("Nest"),
			HenSpots = list("HenSpot"),
			Path = list("ConvPath"),
			NestEggs = {},
			NestPrompts = {},
			Visuals = visuals,
			SellPrompt = nil :: any,
		}
		for i, nest in plot.Nests do
			local prompt = Plots.MakePrompt(nest, "Coletar", "Ninho", "owner", 0, 9)
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt:SetAttribute("Active", false)
			plot.NestPrompts[i] = prompt
			prompt.Triggered:Connect(function(player)
				Registry.Farm.Collect(player, plot, i)
			end)
		end
		plot.SellPrompt = Plots.MakePrompt(parts.SellPoint, "Vender tudo", "Banca", "owner", 0, 12)
		plot.SellPrompt.KeyboardKeyCode = Enum.KeyCode.E
		plot.SellPrompt.Triggered:Connect(function(player)
			Registry.Farm.Sell(player, plot)
		end)
		local pad = parts.SellPad
		if pad then
			pad.Touched:Connect(function(hit)
				local player = game:GetService("Players"):GetPlayerFromCharacter(hit.Parent)
				if player and player == plot.Owner then
					Registry.Farm.Sell(player, plot)
				end
			end)
		end
		table.insert(plots, plot)
		Plots.RefreshAll(plot)
	end
end

return Plots
]]></string>
        </Properties>
