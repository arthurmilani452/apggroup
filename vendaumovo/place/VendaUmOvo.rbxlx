      <Item class="ModuleScript" referent="600">
        <Properties>
          <string name="Name">Registry</string>
          <string name="Source"><![CDATA[-- Tabela compartilhada para os módulos do servidor se encontrarem (evita require circular).
local Registry: any = {}
return Registry
