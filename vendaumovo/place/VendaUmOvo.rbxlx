  <Item class="ServerScriptService" referent="627">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="628">
      <Properties>
        <string name="Name">Game</string>
      </Properties>
      <Item class="ModuleScript" referent="629">
        <Properties>
          <string name="Name">Customers</string>
          <string name="Source"><![CDATA[--[[
	Customers: clientes NPC que andam pela estrada asfaltada e param nas bancas das granjas.
	Cada um entra na fila (até Config.Customers.QueueSize), chega no balcão e leva de 1 a 3 ovos
	da cesta do dono da granja. O dinheiro cai na hora para o dono (mesmo se ele estiver longe).
	Tudo acontece no servidor; o cliente do jogador só vê os bonecos andando.
]]

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Registry = require(script.Parent.Registry)

local Customers = {}

local CC = Config.Customers
local ROAD_RADIUS = 232 -- meio da estrada asfaltada (igual ao builder: OUTER_R)
local WALK_ANIM = "rbxassetid://180426354" -- caminhada R6 padrão do Roblox

type Customer = {
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Plot: any,
	Owner: Player,
	Alive: boolean,
	Walk: AnimationTrack?,
}

local queues: { [any]: { Customer } } = {}
local accumulators: { [any]: number } = {}
local alive = 0
local template: Model? = nil
local folder: Folder

local SKIN = { Color3.fromRGB(255, 220, 185), Color3.fromRGB(234, 184, 146), Color3.fromRGB(198, 134, 98), Color3.fromRGB(141, 85, 56), Color3.fromRGB(90, 56, 37) }
local SHIRTS = { Color3.fromRGB(230, 80, 80), Color3.fromRGB(80, 150, 230), Color3.fromRGB(90, 190, 110), Color3.fromRGB(240, 200, 60), Color3.fromRGB(170, 100, 210), Color3.fromRGB(250, 140, 60) }
local PANTS = { Color3.fromRGB(40, 50, 90), Color3.fromRGB(60, 60, 60), Color3.fromRGB(110, 80, 50), Color3.fromRGB(30, 90, 70) }

local function pick(list: { any }): any
	return list[math.random(1, #list)]
end

-- ---------------------------------------------------------------------------
-- Boneco
-- ---------------------------------------------------------------------------
local function fallbackRig(): Model
	-- boneco simples de peças, caso o Roblox não monte o R6 (ex.: Studio sem internet)
	local model = Instance.new("Model")
	model.Name = "Cliente"
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.Parent = model
	local function limb(name: string, size: Vector3, offset: Vector3)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = root.CFrame * CFrame.new(offset)
		p.Massless = true
		p.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = p
	end
	limb("Torso", Vector3.new(2, 2, 1), Vector3.zero)
	limb("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 1.6, 0))
	limb("Left Leg", Vector3.new(1, 2, 1), Vector3.new(-0.5, -2, 0))
	limb("Right Leg", Vector3.new(1, 2, 1), Vector3.new(0.5, -2, 0))
	limb("Left Arm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 0, 0))
	limb("Right Arm", Vector3.new(1, 2, 1), Vector3.new(1.5, 0, 0))
	local humanoid = Instance.new("Humanoid")
	humanoid.HipHeight = 2
	humanoid.Parent = model
	model.PrimaryPart = root
	return model
end

local function buildTemplate(): Model
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R6)
	end)
	if ok and model then
		for _, d in model:GetDescendants() do
			if d:IsA("LuaSourceContainer") then
				d:Destroy()
			end
		end
		model.Name = "Cliente"
		return model
	end
	warn("[Customers] usando boneco simples:", model)
	return fallbackRig()
end

local function colorize(model: Model)
	local skin, shirt, pants = pick(SKIN), pick(SHIRTS), pick(PANTS)
	local bodyColors = model:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		bodyColors.HeadColor3 = skin
		bodyColors.LeftArmColor3 = skin
		bodyColors.RightArmColor3 = skin
		bodyColors.TorsoColor3 = shirt
		bodyColors.LeftLegColor3 = pants
		bodyColors.RightLegColor3 = pants
	end
	for name, color in { Head = skin, ["Left Arm"] = skin, ["Right Arm"] = skin, Torso = shirt, ["Left Leg"] = pants, ["Right Leg"] = pants } do
		local part = model:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			part.Color = color
		end
	end
end

local function bubble(c: Customer, text: string, color: Color3)
	local head = c.Model:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local gui = head:FindFirstChild("Bubble") :: BillboardGui?
	if not gui then
		local g = Instance.new("BillboardGui")
		g.Name = "Bubble"
		g.Size = UDim2.fromOffset(120, 44)
		g.StudsOffset = Vector3.new(0, 2.6, 0)
		g.MaxDistance = 80
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundColor3 = Color3.new(1, 1, 1)
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.Parent = g
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.4, 0)
		corner.Parent = label
		g.Parent = head
		gui = g
	end
	local label = (gui :: BillboardGui):FindFirstChild("Text") :: TextLabel
	label.Text = text
	label.TextColor3 = color
end

-- ---------------------------------------------------------------------------
-- Caminho: pela estrada em anel até a frente da granja, depois a fila
-- ---------------------------------------------------------------------------
local function plotAngle(plot: any): number
	local p = plot.Parts.Zone.Position
	return math.atan2(p.Z, p.X)
end

local function roadPoint(angle: number): Vector3
	return Vector3.new(math.cos(angle) * ROAD_RADIUS, 3, math.sin(angle) * ROAD_RADIUS)
end

-- Lugar k da fila: na calçada, em frente ao balcão e indo para o lado do portão
local function queueSpot(plot: any, k: number): Vector3
	local cf = plot.Parts.SellPoint.CFrame * CFrame.new(-5.5 * (k - 1), 0, -5)
	return Vector3.new(cf.Position.X, 3, cf.Position.Z)
end

local function flatDistance(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function playWalk(c: Customer, on: boolean)
	if not c.Walk then
		return
	end
	if on and not c.Walk.IsPlaying then
		c.Walk:Play()
	elseif not on and c.Walk.IsPlaying then
		c.Walk:Stop(0.2)
	end
end

local function walkTo(c: Customer, target: Vector3, timeout: number): boolean
	local started = os.clock()
	local issued = 0
	playWalk(c, true)
	while c.Alive and c.Model.Parent do
		if flatDistance(c.Root.Position, target) < 2.5 then
			return true
		end
		local now = os.clock()
		if now - started > timeout then
			return false
		end
		if now - issued > 3 then
			c.Humanoid:MoveTo(target)
			issued = now
		end
		task.wait(0.2)
	end
	return false
end

-- Anda pela estrada de "from" até "to" (ângulos), passando por pontos a cada ~8°
local function walkRoad(c: Customer, from: number, to: number)
	local diff = (to - from + math.pi) % (2 * math.pi) - math.pi
	local steps = math.max(1, math.floor(math.abs(diff) / math.rad(8)))
	for i = 1, steps do
		if not c.Alive then
			return
		end
		walkTo(c, roadPoint(from + diff * i / steps), 10)
	end
end

local function leaveQueue(c: Customer)
	local queue = queues[c.Plot]
	local index = queue and table.find(queue, c)
	if index then
		table.remove(queue, index)
	end
end

-- ---------------------------------------------------------------------------
-- Compra: leva ovos da cesta do dono
-- ---------------------------------------------------------------------------
local function serve(c: Customer)
	local owner = c.Owner
	local plot = c.Plot
	if plot.Owner ~= owner then
		return
	end
	local data = Registry.Economy.Data(owner)
	if not data then
		return
	end
	local want = math.random(CC.BuyMin, CC.BuyMax)
	local keys = {}
	for key, n in data.Basket do
		if n > 0 then
			table.insert(keys, key)
		end
	end
	if #keys == 0 then
		bubble(c, "😢", Color3.fromRGB(90, 90, 90))
		return
	end
	local value, taken = 0, 0
	while taken < want and #keys > 0 do
		local i = math.random(1, #keys)
		local key = keys[i]
		local eggId, rare = Formulas.ParseKey(key)
		data.Basket[key] -= 1
		if data.Basket[key] <= 0 then
			data.Basket[key] = nil
			table.remove(keys, i)
		end
		value += Formulas.EggValue(Config, eggId, rare)
		taken += 1
	end
	local paid = math.floor(value * Registry.Economy.Multiplier(owner) + 0.5)
	data.Stats.Sold += taken
	data.Stats.Customers += 1
	Registry.Economy.AddCoins(owner, paid, true)
	Registry.Economy.Mission(owner, "sell", taken)
	bubble(c, "😋 +" .. paid, Color3.fromRGB(30, 150, 60))
	Registry.Remotes.Fx:FireAllClients("money", plot.Parts.SellPoint.Position + Vector3.new(0, 4, 0), paid)
	Registry.Remotes.Fx:FireClient(owner, "customer", nil, paid)
	Registry.Economy.Push(owner)
end

local function run(c: Customer)
	local plot = c.Plot
	local angle = plotAngle(plot)
	local queue = queues[plot]
	walkRoad(c, plotAngle(plot) + (if math.random() < 0.5 then -1 else 1) * math.rad(math.random(14, 28)), angle)
	local joined = os.clock()
	local lastTarget: Vector3? = nil
	local issued = 0
	while c.Alive and c.Model.Parent do
		if plot.Owner ~= c.Owner then
			break
		end
		local index = table.find(queue, c) or #queue
		local target = queueSpot(plot, math.clamp(index, 1, CC.QueueSize))
		local now = os.clock()
		if lastTarget ~= target or now - issued > 3 then
			c.Humanoid:MoveTo(target)
			lastTarget = target
			issued = now
		end
		local arrived = flatDistance(c.Root.Position, target) < 2.5
		playWalk(c, not arrived)
		if index == 1 and arrived then
			local counter = plot.Parts.SellPoint.Position
			c.Root.CFrame = CFrame.lookAt(c.Root.Position, Vector3.new(counter.X, c.Root.Position.Y, counter.Z))
			task.wait(CC.ServeTime)
			if c.Alive then
				local ok, err = pcall(serve, c)
				if not ok then
					warn("[Customers] serve:", err)
				end
				task.wait(0.8)
			end
			break
		end
		if now - joined > CC.Patience then
			bubble(c, "😴", Color3.fromRGB(90, 90, 90))
			break
		end
		task.wait(0.25)
	end
	leaveQueue(c)
	-- volta para a estrada e segue em frente até sumir
	walkTo(c, roadPoint(angle), 12)
	walkRoad(c, angle, angle + (if math.random() < 0.5 then -1 else 1) * math.rad(30))
end

local function spawnCustomer(plot: any, owner: Player)
	if not template then
		return
	end
	local model = template:Clone()
	colorize(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root then
		model:Destroy()
		return
	end
	humanoid.WalkSpeed = CC.WalkSpeed
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.BreakJointsOnDeath = false
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Customers"
		end
	end
	local side = if math.random() < 0.5 then -1 else 1
	local startAngle = plotAngle(plot) + side * math.rad(math.random(14, 28))
	model:PivotTo(CFrame.new(roadPoint(startAngle)))
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local c: Customer = { Model = model, Humanoid = humanoid, Root = root, Plot = plot, Owner = owner, Alive = true, Walk = nil }
	pcall(function()
		local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
		animator.Parent = humanoid
		local animation = Instance.new("Animation")
		animation.AnimationId = WALK_ANIM
		c.Walk = (animator :: Animator):LoadAnimation(animation)
	end)
	table.insert(queues[plot], c)
	alive += 1
	task.spawn(function()
		local ok, err = pcall(run, c)
		if not ok then
			warn("[Customers] run:", err)
		end
		c.Alive = false
		leaveQueue(c)
		model:Destroy()
		alive -= 1
	end)
	task.delay(CC.MaxLife, function()
		c.Alive = false -- ninguém fica para sempre
	end)
end

function Customers.Init()
	pcall(function()
		PhysicsService:RegisterCollisionGroup("Customers")
		PhysicsService:RegisterCollisionGroup("Players")
		PhysicsService:CollisionGroupSetCollidable("Customers", "Customers", false)
		PhysicsService:CollisionGroupSetCollidable("Customers", "Players", false)
	end)
	folder = Instance.new("Folder")
	folder.Name = "Clientes"
	folder.Parent = workspace
	template = buildTemplate()
	for _, plot in Registry.Plots.All() do
		queues[plot] = {}
		accumulators[plot] = 0
	end

	task.spawn(function()
		local STEP = 0.5
		while true do
			task.wait(STEP)
			for _, plot in Registry.Plots.All() do
				local owner = plot.Owner
				local data = owner and Registry.Economy.Data(owner)
				if not owner or not data then
					accumulators[plot] = 0
					continue
				end
				local rate = Formulas.CustomerRate(Config, data, Formulas.BasketCount(data))
				accumulators[plot] = math.min(accumulators[plot] + rate * STEP / 60, 2)
				if accumulators[plot] >= 1 and alive < CC.MaxAlive and #queues[plot] < CC.QueueSize then
					accumulators[plot] -= 1
					local ok, err = pcall(spawnCustomer, plot, owner)
					if not ok then
						warn("[Customers] spawn:", err)
					end
				end
			end
		end
	end)
end

return Customers
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="630">
        <Properties>
          <string name="Name">Daily</string>
          <string name="Source"><![CDATA[--[[
	Daily: missões diárias, presente por tempo de jogo, sequência de dias, ganho offline,
	códigos e a preferência de música.
	Usa SÓ o relógio do servidor (os.time no servidor): mudar a hora do celular não adianta.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Registry = require(script.Parent.Registry)

local Daily = {}

-- Dia novo (UTC do servidor) = missões novas
function Daily.Check(player: Player)
	local data = Registry.Economy.Data(player)
	if not data then
		return
	end
	local today = Formulas.DayKey(os.time())
	if data.Daily.Day ~= today then
		data.Daily = { Day = today, List = Formulas.MakeMissions(Config, data, today) }
		Registry.Economy.Push(player)
	end
end

local function claimMission(player: Player, index: any)
	local data = Registry.Economy.Data(player)
	if not data or type(index) ~= "number" then
		return
	end
	Daily.Check(player)
	local mission = data.Daily.List[index]
	if not mission or mission.Claimed or mission.Progress < mission.Target then
		return
	end
	mission.Claimed = true
	Registry.Economy.AddCoins(player, mission.Reward, false)
	Registry.Remotes.NotifyPlayer(player, ("Missão feita. +%d moedas"):format(mission.Reward), nil, "success")
	Registry.Remotes.Fx:FireClient(player, "sound", nil, "Comprar")
	Registry.Economy.Push(player)
end

local function claimGift(player: Player)
	local data = Registry.Economy.Data(player)
	if not data or data.GiftSeconds < Config.GiftInterval then
		return
	end
	local reward = Formulas.GiftReward(Config, data, Registry.Economy.Owned(player), os.time())
	data.GiftSeconds = 0
	Registry.Economy.AddCoins(player, reward, false)
	Registry.Remotes.NotifyPlayer(player, ("+%d moedas do presente"):format(reward), nil, "success")
	Registry.Remotes.Fx:FireClient(player, "gift", nil, reward)
	Registry.Economy.Push(player)
end

-- Sequência: um prêmio por dia; dia seguido soma, pulou um dia volta para o 1
local function claimStreak(player: Player)
	local data = Registry.Economy.Data(player)
	if not data then
		return
	end
	local today = Formulas.DayKey(os.time())
	local day = Formulas.StreakNext(data.Streak, today)
	if not day then
		return
	end
	local reward = Formulas.StreakReward(Config, data, day)
	data.Streak = { Day = day, Last = today }
	Registry.Economy.AddCoins(player, reward, false)
	if day == 7 then
		local now = os.time()
		data.Boosts[Config.Streak.Day7Boost] = math.max(now, tonumber(data.Boosts[Config.Streak.Day7Boost]) or 0) + Config.Streak.Day7Seconds
		Registry.Remotes.NotifyPlayer(player, ("Dia 7! +%d moedas e Sorte x3 por 15 min"):format(reward), nil, "success")
	else
		Registry.Remotes.NotifyPlayer(player, ("Dia %d da sequência. +%d moedas"):format(day, reward), nil, "success")
	end
	Registry.Remotes.Fx:FireClient(player, "gift", nil, reward)
	Registry.Economy.Push(player)
end

-- Códigos: cada conta usa uma vez; tentativas erradas têm limite (ninguém fica chutando)
local attempts: { [Player]: { number } } = {}

local function redeemCode(player: Player, text: any)
	local data = Registry.Economy.Data(player)
	if not data or type(text) ~= "string" or #text > 40 then
		return
	end
	local now = os.clock()
	local list = attempts[player] or {}
	local recent = {}
	for _, t in list do
		if now - t < Config.CodeWindow then
			table.insert(recent, t)
		end
	end
	attempts[player] = recent
	if #recent >= Config.CodeAttempts then
		Registry.Remotes.NotifyPlayer(player, "Muitas tentativas. Espera um minuto.", nil, "error")
		return
	end
	local entry = Formulas.FindCode(Config, text)
	if not entry or (entry.Expires > 0 and os.time() > entry.Expires) then
		table.insert(recent, now)
		Registry.Remotes.NotifyPlayer(player, "Código inválido ou vencido.", nil, "error")
		return
	end
	if data.Codes[entry.Code] then
		Registry.Remotes.NotifyPlayer(player, "Você já usou esse código.", nil, "info")
		return
	end
	data.Codes[entry.Code] = true
	local reward = Formulas.CodeReward(Config, data, entry)
	Registry.Economy.AddCoins(player, reward, false)
	Registry.Remotes.NotifyPlayer(player, ("Código %s: +%d moedas"):format(entry.Code, reward), nil, "success")
	Registry.Remotes.Fx:FireClient(player, "gift", nil, reward)
	Registry.Economy.Push(player)
end

local function setMusic(player: Player, on: any)
	local data = Registry.Economy.Data(player)
	if data and type(on) == "boolean" then
		data.Settings.Music = on
		Registry.Economy.Push(player)
	end
end

-- Chamado logo depois de carregar os dados: paga o que as aves botaram enquanto a pessoa estava fora
function Daily.Offline(player: Player)
	local data = Registry.Economy.Data(player)
	if not data then
		return
	end
	local now = os.time()
	local last = tonumber(data.LastSeen) or 0
	data.LastSeen = now
	if last <= 0 or last > now then
		return
	end
	local eggs, coins = Formulas.OfflineEarnings(Config, data, Registry.Economy.Owned(player), now - last, now)
	if coins <= 0 then
		return
	end
	data.Stats.Sold += eggs
	Registry.Economy.AddCoins(player, coins, true)
	task.delay(2, function()
		if player.Parent then
			Registry.Remotes.Fx:FireClient(player, "offline", nil, { Eggs = eggs, Coins = coins, Seconds = math.min(now - last, Config.Offline.MaxSeconds) })
		end
	end)
end

-- Marca a hora (do servidor) em que a pessoa foi vista pela última vez
function Daily.Touch(player: Player)
	local data = Registry.Economy.Data(player)
	if data then
		data.LastSeen = os.time()
	end
end

function Daily.Init()
	Registry.Remotes.On("ClaimMission", claimMission)
	Registry.Remotes.On("ClaimGift", claimGift)
	Registry.Remotes.On("ClaimStreak", claimStreak)
	Registry.Remotes.On("RedeemCode", redeemCode)
	Registry.Remotes.On("SetMusic", setMusic)
	Players.PlayerRemoving:Connect(function(player)
		attempts[player] = nil
	end)

	-- conta o tempo de jogo (no servidor) e troca as missões na virada do dia
	task.spawn(function()
		local ticks = 0
		while true do
			task.wait(1)
			ticks += 1
			for _, player in Players:GetPlayers() do
				local data = Registry.Economy.Data(player)
				if data then
					local before = data.GiftSeconds
					data.GiftSeconds = math.min(Config.GiftInterval, data.GiftSeconds + 1)
					if before < Config.GiftInterval and data.GiftSeconds >= Config.GiftInterval then
						Registry.Remotes.NotifyPlayer(player, "Tem presente pra abrir", nil, "event")
						Registry.Economy.Push(player)
					end
					if ticks % 30 == 0 then
						Daily.Check(player)
					end
				end
			end
		end
	end)
end

return Daily
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="631">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[--[[
	Data: salva e carrega o progresso (mesma base segura do Steal a Critter e do Zona Zero):
	  • UpdateAsync com trava de sessão (dois servidores nunca mexem nos dados do mesmo jogador)
	  • várias tentativas quando o Roblox falha
	  • salva ao sair, a cada 60 s e quando o servidor fecha
	  • se o carregamento falhar, NÃO salva por cima (o progresso antigo fica seguro)
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local Data = {}

export type Profile = {
	Data: any,
	CanSave: boolean,
	Saving: boolean,
	Final: boolean,
}

local SESSION_TIMEOUT = 150

local profiles: { [Player]: Profile } = {}
local finalSaving: { [number]: boolean } = {}
local activeSaves = 0

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Data] DataStore indisponível:", result)
	end
end

-- Hens: lista de ids de ave (a ordem = o ninho de cada uma)
-- Basket: { [ovo] = quantidade }, ovos raros com "*" no fim (ex.: "dourado*")
local function defaultData()
	local upgrades = {}
	for _, upgrade in Config.Upgrades do
		upgrades[upgrade.Id] = 0
	end
	return {
		Coins = Config.StartCoins,
		Rebirths = 0,
		Hens = table.clone(Config.StartHens),
		Basket = {},
		Upgrades = upgrades,
		TotalEarned = 0, -- tudo que já vendeu (placar global)
		Passes = {}, -- game passes entregues (cópia de segurança do UserOwnsGamePassAsync)
		Boosts = {}, -- { Sorte = os.time() em que acaba, Turbo = ... }
		Receipts = {}, -- últimas compras de produtos já entregues (nunca entrega duas vezes)
		Daily = { Day = 0, List = {} },
		GiftSeconds = 0,
		LastSeen = 0, -- os.time() do servidor no último save (ganho offline)
		Streak = { Day = 0, Last = 0 },
		Codes = {}, -- códigos já usados
		Settings = { Music = true },
		Stats = { Collected = 0, Sold = 0, Rare = 0, SellTrips = 0, HensBought = 0, Customers = 0, GoldenEggs = 0 },
		SaveSeq = 0,
	}
end

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

-- Tabelas que ganham chaves novas quando o jogo cresce (melhoria nova, estatística nova...)
local NESTED = { Upgrades = true, Stats = true, Settings = true }

-- Completa o que faltar (versões antigas do save), sem mexer em listas que já existem
local function reconcile(data: any)
	for key, value in defaultData() do
		if data[key] == nil then
			data[key] = value
		elseif NESTED[key] and type(data[key]) == "table" then
			for subKey, subValue in value do
				if data[key][subKey] == nil then
					data[key][subKey] = subValue
				end
			end
		end
	end
	return data
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function lockedByOther(value: any): boolean
	if type(value) ~= "table" or type(value.Session) ~= "table" then
		return false
	end
	local session = value.Session
	return session.JobId ~= game.JobId and os.time() - (tonumber(session.Time) or 0) < SESSION_TIMEOUT
end

function Data.Load(player: Player): Profile
	-- quem saiu e voltou no MESMO servidor espera o save da saída terminar
	local waited = 0
	while finalSaving[player.UserId] and waited < 40 and player.Parent do
		waited += task.wait(0.25)
	end
	local loaded, result = false, nil
	if store then
		local attempts = 6
		for attempt = 1, attempts do
			if not player.Parent then
				break
			end
			local locked = false
			local ok, err = pcall(function()
				(store :: DataStore):UpdateAsync(keyFor(player), function(old)
					if lockedByOther(old) and attempt < attempts then
						locked = true
						return nil
					end
					locked = false
					local data = reconcile(if type(old) == "table" then old else defaultData())
					data.Session = { JobId = game.JobId, Time = os.time() }
					result = data
					return data, { player.UserId }
				end)
			end)
			if ok and not locked then
				loaded = true
				break
			end
			if not ok then
				warn(("[Data] Falha ao carregar %s (tentativa %d): %s"):format(player.Name, attempt, tostring(err)))
				if RunService:IsStudio() then
					break
				end
			end
			task.wait(if locked then 3 else 2)
		end
	end
	local profile: Profile = {
		Data = if loaded and result then result else defaultData(),
		CanSave = loaded,
		Saving = false,
		Final = false,
	}
	profiles[player] = profile
	if not loaded then
		warn("[Data] O progresso de " .. player.Name .. " NÃO será salvo nesta sessão.")
	end
	return profile
end

function Data.Get(player: Player): Profile?
	return profiles[player]
end

function Data.ActiveSaves(): number
	return activeSaves
end

function Data.Save(player: Player, isFinal: boolean?): boolean
	local profile = profiles[player]
	if not profile or not profile.CanSave or not store then
		return false
	end
	activeSaves += 1
	if isFinal then
		finalSaving[player.UserId] = true
	end
	local waited = 0
	local limit = if isFinal then 30 else 15
	while profile.Saving and waited < limit do
		waited += task.wait(0.1)
	end
	if profile.Final or not profile.CanSave or (profile.Saving and not isFinal) then
		if isFinal and not profile.Saving then
			finalSaving[player.UserId] = nil
		end
		activeSaves -= 1
		return false
	end
	profile.Saving = true
	if isFinal then
		profile.Final = true
	end
	profile.Data.SaveSeq = (tonumber(profile.Data.SaveSeq) or 0) + 1
	local snapshot = deepCopy(profile.Data)

	local success, lostLock = false, false
	for attempt = 1, if isFinal then 5 else 3 do
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(keyFor(player), function(old)
				if lockedByOther(old) then
					lostLock = true
					return nil
				end
				lostLock = false
				if type(old) == "table" and (tonumber(old.SaveSeq) or 0) > snapshot.SaveSeq then
					return nil
				end
				snapshot.Session = if isFinal then nil else { JobId = game.JobId, Time = os.time() }
				return snapshot, { player.UserId }
			end)
		end)
		if ok then
			success = not lostLock
			break
		end
		warn(("[Data] Falha ao salvar %s (tentativa %d): %s"):format(player.Name, attempt, tostring(err)))
		task.wait(1)
	end
	if lostLock then
		profile.CanSave = false
		if player.Parent and not isFinal then
			player:Kick("Seu progresso abriu em outro servidor. Entra de novo.")
		end
	end
	profile.Saving = false
	if isFinal then
		finalSaving[player.UserId] = nil
	end
	activeSaves -= 1
	return success
end

function Data.Remove(player: Player)
	profiles[player] = nil
end

return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="632">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--[[
	Economy: moedas, leaderstats, velocidade, missões (progresso) e o "estado" que vai para a tela.
	Todo lugar que muda os dados de alguém chama Economy.Push(player) no final.
	Só o SERVIDOR mexe em moedas: o cliente nunca manda valores, só pede ações.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Registry = require(script.Parent.Registry)

local Economy = {}

local dirty: { [Player]: boolean } = {}
local owned: { [Player]: { [string]: boolean } } = {} -- game passes desta sessão

function Economy.Data(player: Player): any?
	if player:GetAttribute("Loaded") ~= true then
		return nil
	end
	local profile = Registry.Data.Get(player)
	return profile and profile.Data
end

function Economy.Owned(player: Player): { [string]: boolean }
	local t = owned[player]
	if not t then
		t = {}
		owned[player] = t
	end
	return t
end

function Economy.HasPass(player: Player, key: string): boolean
	local data = Economy.Data(player)
	return data ~= nil and Formulas.HasPass(data, key, owned[player])
end

function Economy.Multiplier(player: Player): number
	local data = Economy.Data(player)
	return if data then Formulas.Multiplier(Config, data, owned[player], os.time()) else 1
end

function Economy.BasketCapacity(player: Player): number
	local data = Economy.Data(player)
	return if data then Formulas.BasketCapacity(Config, data, owned[player]) else 0
end

function Economy.SetupPlayer(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Moedas"
	coins.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player
end

-- Moedas ganhas (venda, missão, presente, compra). "earned" conta para o placar e a missão "ganhe moedas".
function Economy.AddCoins(player: Player, amount: number, earned: boolean)
	local data = Economy.Data(player)
	amount = math.floor(amount)
	if not data or amount <= 0 then
		return
	end
	data.Coins += amount
	if earned then
		data.TotalEarned += amount
		Economy.Mission(player, "earn", amount)
	end
	Economy.Push(player)
end

function Economy.Spend(player: Player, amount: number): boolean
	local data = Economy.Data(player)
	if not data or amount < 0 or amount ~= amount or data.Coins < amount then
		return false
	end
	data.Coins -= amount
	Economy.Push(player)
	return true
end

-- Progresso de missão diária (troca de dia é feita em Daily)
function Economy.Mission(player: Player, missionId: string, amount: number)
	local data = Economy.Data(player)
	if not data or not data.Daily or not data.Daily.List then
		return
	end
	for _, mission in data.Daily.List do
		if mission.Id == missionId and not mission.Claimed and mission.Progress < mission.Target then
			mission.Progress = math.min(mission.Target, mission.Progress + amount)
			Economy.Push(player)
		end
	end
end

function Economy.ApplySpeed(player: Player)
	local data = Economy.Data(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if data and humanoid then
		humanoid.WalkSpeed = Formulas.UpgradeValue(Config, data, "Velocidade")
	end
end

function Economy.Push(player: Player)
	dirty[player] = true
end

local function snapshot(player: Player, data: any): any
	local now = os.time()
	local serverNow = workspace:GetServerTimeNow()
	local plot = Registry.Plots.Of(player)
	local boosts = {}
	for key, ends in data.Boosts do
		if ends > now then
			boosts[key] = serverNow + (ends - now)
		end
	end
	local passes = {}
	for _, pass in Config.GamePasses do
		passes[pass.Key] = Formulas.HasPass(data, pass.Key, owned[player])
	end
	return {
		Coins = data.Coins,
		Rebirths = data.Rebirths,
		Basket = data.Basket,
		BasketCount = Formulas.BasketCount(data),
		BasketCap = Formulas.BasketCapacity(Config, data, owned[player]),
		Mult = Formulas.Multiplier(Config, data, owned[player], now),
		Upgrades = data.Upgrades,
		Hens = data.Hens,
		NestCap = Formulas.UpgradeValue(Config, data, "Ninhos"),
		RebirthCost = Formulas.RebirthCost(Config, data),
		Daily = data.Daily.List,
		GiftLeft = math.max(0, Config.GiftInterval - data.GiftSeconds),
		GiftReward = Formulas.GiftReward(Config, data, owned[player], now),
		Passes = passes,
		Boosts = boosts,
		TotalEarned = data.TotalEarned,
		StreakDay = Formulas.StreakNext(data.Streak, Formulas.DayKey(now)), -- nil = já pegou hoje
		StreakLast = data.Streak.Day,
		StreakReward = Formulas.StreakReward(Config, data, Formulas.StreakNext(data.Streak, Formulas.DayKey(now)) or 1),
		Music = data.Settings.Music,
		Plot = if plot then plot.Index else 0,
	}
end

function Economy.Init()
	task.spawn(function()
		while true do
			task.wait(0.2)
			for player in dirty do
				dirty[player] = nil
				local data = Economy.Data(player)
				if data and player.Parent then
					local ok, err = pcall(function()
						local stats = player:FindFirstChild("leaderstats")
						if stats then
							local coins = stats:FindFirstChild("Moedas") :: IntValue
							local rebirths = stats:FindFirstChild("Rebirths") :: IntValue
							coins.Value = math.floor(data.Coins)
							rebirths.Value = data.Rebirths
						end
						Registry.Remotes.State:FireClient(player, snapshot(player, data))
					end)
					if not ok then
						warn("[Economy] push falhou:", err)
					end
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
		owned[player] = nil
	end)
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="633">
        <Properties>
          <string name="Name">Events</string>
          <string name="Source"><![CDATA[--[[
	Events: CHUVA DE OVOS DOURADOS.
	A cada Config.GoldenRain.Interval, avisa o servidor todo e, por alguns segundos, caem ovos dourados
	em volta do centro da ilha. Quem encostar leva o ovo para a cesta.
	O servidor cria cada ovo e confere quem pegou (dono da cesta, distância, limite por jogador por chuva).
	O fim da chuva fica no atributo workspace.GoldenRainEnd (a tela mostra a contagem).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Registry = require(script.Parent.Registry)

local Events = {}

local R = Config.GoldenRain
local alive = 0
local taken: { [Player]: number } = {}
local folder: Folder

-- Ponto aleatório no gramado do centro, fora do celeiro e do silo
local function randomSpot(): Vector3
	for _ = 1, 20 do
		local a = math.random() * math.pi * 2
		local r = math.sqrt(math.random()) * R.Radius
		local x, z = math.cos(a) * r, math.sin(a) * r
		if not (x > -38 and x < 38 and z > -2 and z < 50) then
			return Vector3.new(x, 0, z)
		end
	end
	return Vector3.new(0, 0, -30)
end

local function collect(player: Player, egg: BasePart, rare: boolean): boolean
	local data = Registry.Economy.Data(player)
	if not data or not egg.Parent then
		return false
	end
	local root = Registry.Plots.RootOf(player)
	if not root or (root.Position - egg.Position).Magnitude > R.PickDistance then
		return false
	end
	if (taken[player] or 0) >= R.MaxPerPlayer then
		return false
	end
	if Formulas.BasketCount(data) >= Registry.Economy.BasketCapacity(player) then
		return false
	end
	local key = Formulas.EggKey(R.Egg, rare)
	data.Basket[key] = (data.Basket[key] or 0) + 1
	data.Stats.GoldenEggs += 1
	data.Stats.Collected += 1
	taken[player] = (taken[player] or 0) + 1
	Registry.Economy.Mission(player, "collect", 1)
	if rare then
		data.Stats.Rare += 1
		Registry.Economy.Mission(player, "rare", 1)
	end
	Registry.Remotes.Fx:FireClient(player, "collect", egg.Position, 1)
	Registry.Economy.Push(player)
	return true
end

local function dropEgg()
	local egg = Instance.new("Part")
	egg.Name = "OvoDourado"
	egg.Size = Vector3.new(1.6, 2.1, 1.6)
	egg.Color = Color3.fromRGB(255, 200, 40)
	egg.Material = Enum.Material.Metal
	egg.Reflectance = 0.3
	local rare = math.random() < R.RareChance
	if rare then
		egg.Material = Enum.Material.Neon
	end
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = egg
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 215, 110)
	light.Range = 8
	light.Brightness = 1.5
	light.Parent = egg
	local spot = randomSpot()
	egg.CFrame = CFrame.new(spot + Vector3.new(0, 45 + math.random() * 20, 0)) * CFrame.Angles(math.random(), math.random(), math.random())
	egg.Parent = folder
	pcall(function()
		egg:SetNetworkOwner(nil) -- o servidor cuida da queda (ninguém "puxa" o ovo)
	end)
	alive += 1
	local done = false
	local function finish()
		if done then
			return
		end
		done = true
		alive -= 1
		egg:Destroy()
	end
	egg.Touched:Connect(function(hit)
		if done then
			return
		end
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if player and collect(player, egg, rare) then
			finish()
		end
	end)
	task.delay(R.EggLife, finish)
end

local function rain()
	workspace:SetAttribute("GoldenRainEnd", workspace:GetServerTimeNow() + R.Warning + R.Duration)
	Registry.Remotes.NotifyAll(("Chuva de ovos dourados em %ds no cercadinho do centro!"):format(R.Warning), nil, "event")
	task.wait(R.Warning)
	taken = {}
	Registry.Remotes.Fx:FireAllClients("sound", nil, "ChuvaDourada")
	Registry.Remotes.NotifyAll("Começou! Corre pro centro da ilha!", nil, "event")
	local ends = os.clock() + R.Duration
	while os.clock() < ends do
		if alive < R.MaxAlive then
			local ok, err = pcall(dropEgg)
			if not ok then
				warn("[Events] ovo:", err)
			end
		end
		task.wait(R.SpawnEvery)
	end
	workspace:SetAttribute("GoldenRainEnd", 0)
end

function Events.Init()
	folder = Instance.new("Folder")
	folder.Name = "ChuvaDourada"
	folder.Parent = workspace
	workspace:SetAttribute("GoldenRainEnd", 0)
	task.spawn(function()
		while true do
			task.wait(math.max(R.Interval - R.Warning, 30))
			local ok, err = pcall(rain)
			if not ok then
				warn("[Events] chuva:", err)
				workspace:SetAttribute("GoldenRainEnd", 0)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		taken[player] = nil
	end)
end

return Events
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="634">
        <Properties>
          <string name="Name">Farm</string>
          <string name="Source"><![CDATA[--[[
	Farm: o ciclo da granja.
	  ave bota no ninho → jogador coleta (cesta) → leva até a banca → vende
	Também a coleta automática e a esteira (leva os ovos até a banca e vende sozinha).
	Tudo é conferido aqui no servidor: dono, distância, espaço na cesta, intervalo entre ações.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AssetLib = require(ReplicatedStorage.Shared.AssetLib)
local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Registry = require(script.Parent.Registry)

local Farm = {}

local timers: { [any]: { number } } = {} -- [plot][ninho] = segundos acumulados
local lastAction: { [Player]: { [string]: number } } = {}
local beltCount: { [any]: number } = {}

local MAX_BELT_EGGS = 8

local function cooldown(player: Player, action: string, seconds: number): boolean
	local t = lastAction[player]
	if not t then
		t = {}
		lastAction[player] = t
	end
	local now = os.clock()
	if now - (t[action] or 0) < seconds then
		return false
	end
	t[action] = now
	return true
end

local function notify(player: Player, text: string, kind: string?)
	Registry.Remotes.NotifyPlayer(player, text, nil, kind)
end

-- Move ovos de um ninho para a cesta. Devolve quantos foram.
local function takeFromNest(player: Player, plot: any, index: number, data: any): number
	local eggs = plot.NestEggs[index]
	if not eggs or #eggs == 0 then
		return 0
	end
	local space = Registry.Economy.BasketCapacity(player) - Formulas.BasketCount(data)
	local moved, rares = 0, 0
	while space > 0 and #eggs > 0 do
		local entry = table.remove(eggs, 1)
		local key = Formulas.EggKey(entry.Egg, entry.Rare)
		data.Basket[key] = (data.Basket[key] or 0) + 1
		space -= 1
		moved += 1
		if entry.Rare then
			rares += 1
		end
	end
	if moved > 0 then
		data.Stats.Collected += moved
		Registry.Economy.Mission(player, "collect", moved)
		if rares > 0 then
			data.Stats.Rare += rares
			Registry.Economy.Mission(player, "rare", rares)
		end
		Registry.Plots.RefreshNest(plot, index)
	end
	return moved
end

function Farm.Collect(player: Player, plot: any, index: number)
	if plot.Owner ~= player or type(index) ~= "number" then
		return
	end
	local data = Registry.Economy.Data(player)
	local nest = plot.Nests[index]
	if not data or not nest or not Registry.Plots.Near(player, nest, Config.CollectDistance) then
		return
	end
	if not cooldown(player, "collect" .. index, 0.3) then
		return
	end
	if Formulas.BasketCount(data) >= Registry.Economy.BasketCapacity(player) then
		if cooldown(player, "fullMsg", 3) then
			notify(player, "Cesta cheia. Leva pra banca!", "error")
		end
		return
	end
	local moved = takeFromNest(player, plot, index, data)
	if moved > 0 then
		Registry.Remotes.Fx:FireClient(player, "collect", nest.Position, moved)
		Registry.Economy.Push(player)
	end
end

function Farm.Sell(player: Player, plot: any)
	if plot.Owner ~= player then
		return
	end
	local data = Registry.Economy.Data(player)
	local point = plot.Parts.SellPoint
	if not data or not Registry.Plots.Near(player, point, Config.SellDistance) then
		return
	end
	if not cooldown(player, "sell", 0.75) then
		return
	end
	local value, count = Formulas.BasketValue(Config, data, Registry.Economy.Owned(player), os.time())
	if count <= 0 then
		if cooldown(player, "emptyMsg", 4) then
			notify(player, "Cesta vazia. Pega ovo nos ninhos primeiro.", "info")
		end
		return
	end
	data.Basket = {}
	data.Stats.Sold += count
	data.Stats.SellTrips += 1
	Registry.Economy.AddCoins(player, value, true)
	Registry.Economy.Mission(player, "sell", count)
	Registry.Economy.Mission(player, "sellTrips", 1)
	Registry.Remotes.Fx:FireAllClients("money", point.Position + Vector3.new(0, 4, 0), value)
	Registry.Remotes.Fx:FireClient(player, "sold", point.Position, count)
	Registry.Economy.Push(player)
end

-- Ovo na esteira: anda pelos pontos ConvPath até a banca e vende sozinho
local function sendOnBelt(player: Player, plot: any, eggId: string, rare: boolean)
	local data = Registry.Economy.Data(player)
	if not data then
		return
	end
	local function credit()
		if plot.Owner ~= player then
			return
		end
		local value = math.floor(Formulas.EggValue(Config, eggId, rare) * Registry.Economy.Multiplier(player) + 0.5)
		data.Stats.Sold += 1
		Registry.Economy.AddCoins(player, value, true)
		Registry.Economy.Mission(player, "sell", 1)
	end
	local path = plot.Path
	if #path < 2 or (beltCount[plot] or 0) >= MAX_BELT_EGGS then
		credit() -- esteira lotada: vende direto (sem o ovo andando)
		return
	end
	local model = Registry.Plots.MakeEgg(eggId, rare)
	if not model then
		credit()
		return
	end
	beltCount[plot] = (beltCount[plot] or 0) + 1
	local beltFolder = plot.Visuals:FindFirstChild("Belt")
	model.Parent = beltFolder
	task.spawn(function()
		local total = 0
		for i = 1, #path - 1 do
			total += (path[i + 1].Position - path[i].Position).Magnitude
		end
		local speed = math.max(total / Config.ConveyorTravelTime, 1)
		for i = 1, #path - 1 do
			local a, b = path[i].Position, path[i + 1].Position
			local length = (b - a).Magnitude
			local t = 0
			while t < length and model.Parent do
				t = math.min(length, t + speed * 0.1)
				local p = a:Lerp(b, if length > 0 then t / length else 1)
				AssetLib.PlaceAt(model, p, 0)
				task.wait(0.1)
			end
		end
		model:Destroy()
		beltCount[plot] = math.max(0, (beltCount[plot] or 1) - 1)
		credit()
	end)
end

function Farm.Init()
	-- aves botam
	task.spawn(function()
		local STEP = 0.5
		while true do
			task.wait(STEP)
			for _, plot in Registry.Plots.All() do
				local owner = plot.Owner
				if not owner then
					timers[plot] = nil
					continue
				end
				local ok, err = pcall(function()
					local data = Registry.Economy.Data(owner)
					if not data then
						return
					end
					local t = timers[plot]
					if not t then
						t = {}
						timers[plot] = t
					end
					local now = os.time()
					local conveyor = Formulas.UpgradeValue(Config, data, "Esteira") > 0
					for i, henId in data.Hens do
						local hen = Config.HenById[henId]
						if not hen or not plot.Nests[i] then
							continue
						end
						local layTime = Formulas.LayTime(Config, data, henId)
						t[i] = (t[i] or math.random() * layTime * 0.5) + STEP
						if t[i] < layTime then
							continue
						end
						local rare = math.random() < Formulas.RareChance(Config, data, now)
						if conveyor then
							t[i] = 0
							sendOnBelt(owner, plot, hen.Egg, rare)
						elseif #plot.NestEggs[i] < Config.EggsPerNest then
							t[i] = 0
							table.insert(plot.NestEggs[i], { Egg = hen.Egg, Rare = rare })
							Registry.Plots.RefreshNest(plot, i)
						else
							t[i] = layTime -- ninho cheio: espera coletar
							continue
						end
						if rare then
							local egg = Config.EggById[hen.Egg]
							Registry.Remotes.Fx:FireClient(owner, "rare", plot.Nests[i].Position, egg and egg.Name or "")
							if egg and egg.Legendary then
								Registry.Remotes.NotifyAll(owner.DisplayName .. " tirou um " .. egg.Name .. " raro!", nil, "event")
							end
						end
					end
				end)
				if not ok then
					warn("[Farm] erro:", err)
				end
			end
		end
	end)

	-- coleta automática (melhoria ou game pass): pega os ovos de todos os ninhos sozinha
	task.spawn(function()
		while true do
			task.wait(Config.AutoCollectInterval)
			for _, plot in Registry.Plots.All() do
				local owner = plot.Owner
				local data = owner and Registry.Economy.Data(owner)
				if not owner or not data then
					continue
				end
				local auto = Formulas.UpgradeValue(Config, data, "ColetaAuto") > 0 or Registry.Economy.HasPass(owner, "ColetaAuto")
				if not auto then
					continue
				end
				local moved = 0
				for i = 1, #plot.Nests do
					moved += takeFromNest(owner, plot, i, data)
				end
				if moved > 0 then
					Registry.Economy.Push(owner)
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastAction[player] = nil
	end)
end

return Farm
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="635">
        <Properties>
          <string name="Name">Leaderboard</string>
          <string name="Source"><![CDATA[--[[
	Leaderboard: placar GLOBAL dos maiores vendedores (todas as moedas já ganhas vendendo).
	Grava num OrderedDataStore a cada 2 min e ao sair; a placa da praça atualiza a cada 90 s.
	Placa: workspace.Plaza (qualquer peça chamada "LeaderboardBoard" com um SurfaceGui "Gui").
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Registry = require(script.Parent.Registry)

local Leaderboard = {}

local store: OrderedDataStore? = nil
local names: { [number]: string } = {}
local lastWritten: { [number]: number } = {}

local function nameOf(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	names[userId] = if ok and name then name else "Jogador"
	return names[userId]
end

function Leaderboard.Write(player: Player)
	local data = Registry.Economy.Data(player)
	if not store or not data then
		return
	end
	local value = math.floor(data.TotalEarned)
	if lastWritten[player.UserId] == value or value <= 0 then
		return
	end
	local ok, err = pcall(function()
		(store :: OrderedDataStore):SetAsync("u_" .. player.UserId, value)
	end)
	if ok then
		lastWritten[player.UserId] = value
	else
		warn("[Leaderboard] gravar:", err)
	end
end

local function boardGui(): SurfaceGui?
	local plaza = workspace:FindFirstChild("Plaza")
	local board = plaza and plaza:FindFirstChild("LeaderboardBoard", true)
	return board and board:FindFirstChildWhichIsA("SurfaceGui")
end

local function draw(rows: { { name: string, value: number } })
	local gui = boardGui()
	if not gui then
		return
	end
	local list = gui:FindFirstChild("List")
	if not list then
		local frame = Instance.new("Frame")
		frame.Name = "List"
		frame.BackgroundTransparency = 1
		frame.Position = UDim2.fromScale(0.05, 0.2)
		frame.Size = UDim2.fromScale(0.9, 0.78)
		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0.01, 0)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = frame
		frame.Parent = gui
		list = frame
	end
	for _, child in (list :: Frame):GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local medals = { "🥇", "🥈", "🥉" }
	for i, row in rows do
		local label = Instance.new("TextLabel")
		label.LayoutOrder = i
		label.Size = UDim2.fromScale(1, 0.088)
		label.BackgroundColor3 = if i % 2 == 0 then Color3.fromRGB(255, 236, 190) else Color3.fromRGB(255, 246, 220)
		label.BorderSizePixel = 0
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextColor3 = Color3.fromRGB(90, 50, 20)
		label.Text = ("  %s %s   🪙 %s"):format(medals[i] or ("#" .. i), row.name, Format.Short(row.value))
		label.Parent = list
	end
	if #rows == 0 then
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 0.2)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(90, 50, 20)
		label.Text = "Venda ovos para entrar no placar!"
		label.Parent = list
	end
end

local function refresh()
	if not store then
		draw({})
		return
	end
	local ok, pages = pcall(function()
		return (store :: OrderedDataStore):GetSortedAsync(false, 10)
	end)
	if not ok or not pages then
		return
	end
	local rows = {}
	for _, entry in pages:GetCurrentPage() do
		local userId = tonumber(string.match(entry.key, "%d+"))
		if userId then
			table.insert(rows, { name = nameOf(userId), value = entry.value })
		end
	end
	draw(rows)
end

function Leaderboard.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.LeaderboardStore)
	end)
	if ok then
		store = result
	end
	task.spawn(function()
		while true do
			pcall(refresh)
			task.wait(90)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in Players:GetPlayers() do
				Leaderboard.Write(player)
				task.wait(1)
			end
		end
	end)
end

return Leaderboard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="636">
        <Properties>
          <string name="Name">Plots</string>
          <string name="Source"><![CDATA[--[[
	Plots: as granjas (bases) do mapa. Dá uma para cada jogador, devolve quando ele sai
	e desenha o que é dele: aves, ovos nos ninhos, esteira, decorações e a placa com o nome.

	Cada granja (workspace.Plots.PlotN) vem do builder com:
	  Zone, Spawn, Sign (SurfaceGui Gui > Text), SellPoint, SellPad,
	  Nest1..12, HenSpot1..12, ConvPath1..N, Conveyor (Model), Decor1..6 (Models)
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AssetLib = require(ReplicatedStorage.Shared.AssetLib)
local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Registry = require(script.Parent.Registry)

local Plots = {}

export type Plot = {
	Index: number,
	Model: Model,
	Owner: Player?,
	Parts: { [string]: BasePart },
	Nests: { BasePart },
	HenSpots: { BasePart },
	Path: { BasePart },
	NestEggs: { { { Egg: string, Rare: boolean } } },
	NestPrompts: { ProximityPrompt },
	Visuals: Folder,
	SellPrompt: ProximityPrompt,
}

local plots: { Plot } = {}
local byPlayer: { [Player]: Plot } = {}

-- Prompt com dono: o cliente só mostra para quem pode usar ("owner" = só o dono da granja)
function Plots.MakePrompt(parent: Instance, action: string, object: string, forWho: string, hold: number?, distance: number?): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = distance or 10
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("For", forWho)
	prompt:SetAttribute("Active", true)
	prompt:SetAttribute("Owner", 0)
	prompt.Parent = parent
	CollectionService:AddTag(prompt, "VUOPrompt")
	return prompt
end

function Plots.All(): { Plot }
	return plots
end

function Plots.Of(player: Player): Plot?
	return byPlayer[player]
end

function Plots.IsInside(plot: Plot, position: Vector3): boolean
	local zone = plot.Parts.Zone
	local p = zone.CFrame:PointToObjectSpace(position)
	local half = zone.Size / 2
	return math.abs(p.X) <= half.X and math.abs(p.Y) <= half.Y + 20 and math.abs(p.Z) <= half.Z
end

function Plots.RootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Plots.Near(player: Player, part: BasePart, distance: number): boolean
	local root = Plots.RootOf(player)
	return root ~= nil and (root.Position - part.Position).Magnitude <= distance
end

local function folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function clear(f: Instance)
	for _, child in f:GetChildren() do
		child:Destroy()
	end
end

local function sub(plot: Plot, name: string): Folder
	return plot.Visuals:FindFirstChild(name) :: Folder
end

-- ---------------------------------------------------------------------------
-- Desenho
-- ---------------------------------------------------------------------------
local function rareFx(model: Model, color: Color3)
	local _, size = model:GetBoundingBox()
	local anchor = Instance.new("Part")
	anchor.Name = "Glow"
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	local cf = model:GetBoundingBox()
	anchor.CFrame = cf
	anchor.Parent = model
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 8
	light.Brightness = 2
	light.Parent = anchor
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 240, 150))
	sparkle.Size = NumberSequence.new(0.5, 0)
	sparkle.Lifetime = NumberRange.new(0.6, 1)
	sparkle.Rate = 8
	sparkle.Speed = NumberRange.new(1, 2.5)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.LightEmission = 1
	sparkle.Parent = anchor
	local highlight = Instance.new("Highlight")
	highlight.FillTransparency = 0.7
	highlight.OutlineColor = Color3.fromRGB(255, 230, 90)
	highlight.FillColor = color
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = model
	model:SetAttribute("Rare", size.Y > 0)
end

function Plots.MakeEgg(eggId: string, rare: boolean): Model?
	local egg = Config.EggById[eggId]
	if not egg then
		return nil
	end
	local model = AssetLib.Get(egg.Asset, Config.AssetHeights.Ovo)
	if not model then
		return nil
	end
	AssetLib.SetCollide(model, false)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanQuery = false
		end
	end
	if rare then
		rareFx(model, egg.Color)
	end
	return model
end

function Plots.RefreshNest(plot: Plot, index: number)
	local nestFolder = sub(plot, "Eggs"):FindFirstChild("Nest" .. index)
	if nestFolder then
		nestFolder:Destroy()
	end
	local eggs = plot.NestEggs[index]
	local nest = plot.Nests[index]
	local prompt = plot.NestPrompts[index]
	if prompt then
		prompt:SetAttribute("Active", eggs ~= nil and #eggs > 0)
	end
	if not eggs or #eggs == 0 or not nest then
		return
	end
	local f = folder(sub(plot, "Eggs"), "Nest" .. index)
	local top = nest.Position + Vector3.new(0, nest.Size.Y / 2, 0)
	for i, entry in eggs do
		local model = Plots.MakeEgg(entry.Egg, entry.Rare)
		if model then
			local angle = (i - 1) * (math.pi * 2 / 3) + index
			AssetLib.PlaceAt(model, top + Vector3.new(math.cos(angle) * 0.7, -0.35, math.sin(angle) * 0.7), math.deg(angle))
			-- encostar no ovo também coleta (só o dono)
			for _, d in model:GetDescendants() do
				if d:IsA("BasePart") then
					d.CanTouch = true
					d.Touched:Connect(function(hit)
						local player = game:GetService("Players"):GetPlayerFromCharacter(hit.Parent)
						if player and player == plot.Owner then
							Registry.Farm.Collect(player, plot, index)
						end
					end)
					break
				end
			end
			model.Parent = f
		end
	end
end

function Plots.RefreshHens(plot: Plot)
	local f = sub(plot, "Hens")
	clear(f)
	local owner = plot.Owner
	local data = owner and Registry.Economy.Data(owner)
	if not data then
		return
	end
	for i, henId in data.Hens do
		local hen = Config.HenById[henId]
		local spot = plot.HenSpots[i]
		if hen and spot then
			local model = AssetLib.Get(hen.Asset, Config.AssetHeights.Ave)
			if model then
				AssetLib.SetCollide(model, false)
				AssetLib.PlaceAt(model, spot.Position - Vector3.new(0, spot.Size.Y / 2, 0), spot:GetAttribute("Yaw") or 0)
				model.Name = "Ave" .. i
				model:SetAttribute("Hen", henId)
				CollectionService:AddTag(model, "VUOHen")
				model.Parent = f
			end
		end
	end
	-- ninhos sem ave ficam vazios (e somem os ovos de quem saiu)
	for i = 1, #plot.Nests do
		local nest = plot.Nests[i]
		nest:SetAttribute("Used", data.Hens[i] ~= nil)
	end
end

function Plots.RefreshUpgrades(plot: Plot)
	local owner = plot.Owner
	local data = owner and Registry.Economy.Data(owner)
	local hasConveyor = data ~= nil and Formulas.UpgradeValue(Config, data, "Esteira") > 0
	local decor = if data then Formulas.UpgradeLevel(data, "Decoracao") else 0
	local nestCap = if data then Formulas.UpgradeValue(Config, data, "Ninhos") else 0
	local function show(model: Instance?, visible: boolean)
		if not model then
			return
		end
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				if d:GetAttribute("T0") == nil then
					d:SetAttribute("T0", d.Transparency)
					d:SetAttribute("C0", d.CanCollide)
				end
				d.Transparency = if visible then d:GetAttribute("T0") else 1
				d.CanCollide = visible and d:GetAttribute("C0") == true
			elseif d:IsA("Decal") or d:IsA("Texture") then
				d.Transparency = if visible then 0 else 1
			elseif d:IsA("Light") or d:IsA("ParticleEmitter") then
				d.Enabled = visible
			end
		end
	end
	show(plot.Model:FindFirstChild("Conveyor"), hasConveyor)
	for i = 1, 6 do
		show(plot.Model:FindFirstChild("Decor" .. i), decor >= i)
	end
	-- ninhos liberados aparecem; os outros ficam escondidos
	for i = 1, 12 do
		show(plot.Model:FindFirstChild("NestLook" .. i), owner ~= nil and i <= nestCap)
	end
end

function Plots.RefreshSign(plot: Plot)
	local sign = plot.Parts.Sign
	local gui = sign and sign:FindFirstChildWhichIsA("SurfaceGui")
	local label = gui and gui:FindFirstChildWhichIsA("TextLabel")
	if label then
		label.Text = if plot.Owner then "Granja de " .. plot.Owner.DisplayName else "Granja livre"
	end
	plot.Model:SetAttribute("OwnerId", if plot.Owner then plot.Owner.UserId else 0)
end

function Plots.RefreshAll(plot: Plot)
	Plots.RefreshSign(plot)
	Plots.RefreshHens(plot)
	Plots.RefreshUpgrades(plot)
	for i = 1, #plot.Nests do
		Plots.RefreshNest(plot, i)
	end
end

local function setOwnerAttr(plot: Plot)
	local id = if plot.Owner then plot.Owner.UserId else 0
	for _, d in plot.Model:GetDescendants() do
		if d:IsA("ProximityPrompt") then
			d:SetAttribute("Owner", id)
		end
	end
end

-- ---------------------------------------------------------------------------
function Plots.Assign(player: Player): Plot?
	if byPlayer[player] then
		return byPlayer[player]
	end
	for _, plot in plots do
		if not plot.Owner then
			plot.Owner = player
			byPlayer[player] = plot
			plot.NestEggs = {}
			for i = 1, #plot.Nests do
				plot.NestEggs[i] = {}
			end
			setOwnerAttr(plot)
			Plots.RefreshAll(plot)
			return plot
		end
	end
	return nil
end

function Plots.Release(player: Player)
	local plot = byPlayer[player]
	if not plot then
		return
	end
	byPlayer[player] = nil
	plot.Owner = nil
	plot.NestEggs = {}
	setOwnerAttr(plot)
	clear(sub(plot, "Eggs"))
	clear(sub(plot, "Hens"))
	clear(sub(plot, "Belt"))
	Plots.RefreshAll(plot)
end

function Plots.SpawnCFrame(plot: Plot): CFrame
	local spawn = plot.Parts.Spawn
	return spawn.CFrame + Vector3.new(0, 4, 0)
end

function Plots.Init()
	local root = workspace:WaitForChild("Plots")
	local models = root:GetChildren()
	table.sort(models, function(a, b)
		return (a:GetAttribute("Index") or 0) < (b:GetAttribute("Index") or 0)
	end)
	for _, model in models do
		if not model:IsA("Model") then
			continue
		end
		local parts: { [string]: BasePart } = {}
		for _, child in model:GetChildren() do
			if child:IsA("BasePart") then
				parts[child.Name] = child
			end
		end
		local function list(prefix: string): { BasePart }
			local out = {}
			local i = 1
			while parts[prefix .. i] do
				table.insert(out, parts[prefix .. i])
				i += 1
			end
			return out
		end
		local visuals = folder(model, "Visuals")
		for _, name in { "Eggs", "Hens", "Belt" } do
			folder(visuals, name)
		end
		local plot: Plot = {
			Index = model:GetAttribute("Index") or (#plots + 1),
			Model = model,
			Owner = nil,
			Parts = parts,
			Nests = list("Nest"),
			HenSpots = list("HenSpot"),
			Path = list("ConvPath"),
			NestEggs = {},
			NestPrompts = {},
			Visuals = visuals,
			SellPrompt = nil :: any,
		}
		for i, nest in plot.Nests do
			local prompt = Plots.MakePrompt(nest, "Coletar", "Ninho", "owner", 0, 9)
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt:SetAttribute("Active", false)
			plot.NestPrompts[i] = prompt
			prompt.Triggered:Connect(function(player)
				Registry.Farm.Collect(player, plot, i)
			end)
		end
		plot.SellPrompt = Plots.MakePrompt(parts.SellPoint, "Vender tudo", "Banca", "owner", 0, 12)
		plot.SellPrompt.KeyboardKeyCode = Enum.KeyCode.E
		plot.SellPrompt.Triggered:Connect(function(player)
			Registry.Farm.Sell(player, plot)
		end)
		local pad = parts.SellPad
		if pad then
			pad.Touched:Connect(function(hit)
				local player = game:GetService("Players"):GetPlayerFromCharacter(hit.Parent)
				if player and player == plot.Owner then
					Registry.Farm.Sell(player, plot)
				end
			end)
		end
		table.insert(plots, plot)
		Plots.RefreshAll(plot)
	end
end

return Plots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="637">
        <Properties>
          <string name="Name">Registry</string>
          <string name="Source"><![CDATA[-- Tabela compartilhada para os módulos do servidor se encontrarem (evita require circular).
local Registry: any = {}
return Registry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="638">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Remotes: canais entre servidor e jogadores (todos criados aqui).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Remotes = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local function event(name: string, unreliable: boolean?): any
	local e = Instance.new(if unreliable then "UnreliableRemoteEvent" else "RemoteEvent")
	e.Name = name
	e.Parent = folder
	return e
end

Remotes.Request = event("Request") -- jogador -> servidor: (ação: string, a, b)
Remotes.State = event("State") -- servidor -> jogador: tabela com o estado dele (moedas, cesta, missões...)
Remotes.Notify = event("Notify") -- servidor -> jogador(es): (texto, args, tipo)
Remotes.Fx = event("Fx") -- servidor -> jogador(es): efeitos ("money", "rare", "sound"...) (posição, valor)

folder.Parent = ReplicatedStorage

function Remotes.NotifyPlayer(player: Player, key: string, args: { [string]: any }?, kind: string?)
	Remotes.Notify:FireClient(player, key, args or {}, kind or "info")
end

function Remotes.NotifyAll(key: string, args: { [string]: any }?, kind: string?)
	Remotes.Notify:FireAllClients(key, args or {}, kind or "info")
end

-- Pedidos do jogador: cada ação tem o próprio limite de tempo (lição do Steal a Critter v28)
local handlers: { [string]: (Player, any, any) -> () } = {}
local lastRequest: { [Player]: { [string]: number } } = {}

function Remotes.On(action: string, handler: (Player, any, any) -> ())
	handlers[action] = handler
end

Remotes.Request.OnServerEvent:Connect(function(player: Player, action: any, a: any, b: any)
	if type(action) ~= "string" then
		return
	end
	local handler = handlers[action]
	if not handler then
		return
	end
	local times = lastRequest[player]
	if not times then
		times = {}
		lastRequest[player] = times
	end
	local now = os.clock()
	if now - (times[action] or 0) < Config.RequestCooldown then
		return
	end
	times[action] = now
	local ok, err = pcall(handler, player, a, b)
	if not ok then
		warn("[Remotes] " .. action .. " falhou:", err)
	end
end)

function Remotes.RemovePlayer(player: Player)
	lastRequest[player] = nil
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="639">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[--[[
	Shop: Loja de Galinhas, Loja de Upgrades e Rebirth.
	O cliente só PEDE ("quero a Pata"); o servidor confere distância da loja, saldo e preço do Config.
	O builder deixa em workspace.Plaza: HenShopPoint e UpgradeShopPoint (onde fica o balcão de cada loja).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Registry = require(script.Parent.Registry)

local Shop = {}

local function point(name: string): BasePart?
	local plaza = workspace:FindFirstChild("Plaza")
	return plaza and plaza:FindFirstChild(name, true) :: BasePart?
end

local function nearShop(player: Player, name: string): boolean
	local part = point(name)
	if not part then
		return true -- sem o ponto no mapa, não trava o jogo
	end
	if Registry.Plots.Near(player, part, Config.ShopDistance) then
		return true
	end
	Registry.Remotes.NotifyPlayer(player, "Chega mais perto do balcão.", nil, "error")
	return false
end

local function sound(player: Player, name: string)
	Registry.Remotes.Fx:FireClient(player, "sound", nil, name)
end

local function buyHen(player: Player, henId: any)
	local data = Registry.Economy.Data(player)
	local hen = type(henId) == "string" and Config.HenById[henId]
	if not data or not hen or not nearShop(player, "HenShopPoint") then
		return
	end
	local cap = Formulas.UpgradeValue(Config, data, "Ninhos")
	local replaceIndex = nil
	if #data.Hens >= cap then
		-- ninhos cheios: troca a ave mais fraca, se a nova for melhor
		local weakest, weakestTier = nil, math.huge
		for i, id in data.Hens do
			local h = Config.HenById[id]
			local tier = if h then h.Tier else 0
			if tier < weakestTier then
				weakest, weakestTier = i, tier
			end
		end
		if not weakest or weakestTier >= hen.Tier then
			Registry.Remotes.NotifyPlayer(player, "Sem ninho livre. Compra Mais Ninhos ou uma ave melhor.", nil, "error")
			return
		end
		replaceIndex = weakest
	end
	if not Registry.Economy.Spend(player, hen.Price) then
		Registry.Remotes.NotifyPlayer(player, "Falta moeda.", nil, "error")
		return
	end
	if replaceIndex then
		local old = Config.HenById[data.Hens[replaceIndex]]
		data.Hens[replaceIndex] = hen.Id
		if old then
			Registry.Economy.AddCoins(player, math.floor(old.Price * Config.ReplaceRefund), false)
			Registry.Remotes.NotifyPlayer(player, ("%s saiu, %s entrou."):format(old.Name, hen.Name), nil, "success")
		end
		local plot = Registry.Plots.Of(player)
		if plot then
			plot.NestEggs[replaceIndex] = {}
			Registry.Plots.RefreshNest(plot, replaceIndex)
		end
	else
		table.insert(data.Hens, hen.Id)
		Registry.Remotes.NotifyPlayer(player, ("%s chegou na granja."):format(hen.Name), nil, "success")
	end
	data.Stats.HensBought += 1
	Registry.Economy.Mission(player, "buyHen", 1)
	local plot = Registry.Plots.Of(player)
	if plot then
		Registry.Plots.RefreshHens(plot)
	end
	sound(player, "Comprar")
	Registry.Economy.Push(player)
end

local function buyUpgrade(player: Player, upgradeId: any)
	local data = Registry.Economy.Data(player)
	local upgrade = type(upgradeId) == "string" and Config.UpgradeById[upgradeId]
	if not data or not upgrade or not nearShop(player, "UpgradeShopPoint") then
		return
	end
	local cost = Formulas.UpgradeCost(Config, data, upgrade.Id)
	if not cost then
		Registry.Remotes.NotifyPlayer(player, "Essa já tá no máximo.", nil, "info")
		return
	end
	if not Registry.Economy.Spend(player, cost) then
		Registry.Remotes.NotifyPlayer(player, "Falta moeda.", nil, "error")
		return
	end
	data.Upgrades[upgrade.Id] = Formulas.UpgradeLevel(data, upgrade.Id) + 1
	Registry.Remotes.NotifyPlayer(player, ("%s nível %d"):format(upgrade.Name, data.Upgrades[upgrade.Id]), nil, "success")
	local plot = Registry.Plots.Of(player)
	if plot then
		Registry.Plots.RefreshUpgrades(plot)
	end
	Registry.Economy.ApplySpeed(player)
	sound(player, "Comprar")
	Registry.Economy.Push(player)
end

local function rebirth(player: Player)
	local data = Registry.Economy.Data(player)
	if not data then
		return
	end
	local cost = Formulas.RebirthCost(Config, data)
	if data.Coins < cost then
		Registry.Remotes.NotifyPlayer(player, "Ainda falta moeda pro rebirth.", nil, "error")
		return
	end
	data.Rebirths += 1
	data.Coins = Config.StartCoins
	data.Hens = table.clone(Config.StartHens)
	data.Basket = {}
	for _, upgrade in Config.Upgrades do
		data.Upgrades[upgrade.Id] = 0
	end
	local plot = Registry.Plots.Of(player)
	if plot then
		for i = 1, #plot.Nests do
			plot.NestEggs[i] = {}
		end
		Registry.Plots.RefreshAll(plot)
	end
	Registry.Economy.ApplySpeed(player)
	Registry.Remotes.NotifyAll(("%s fez o rebirth %d"):format(player.DisplayName, data.Rebirths), nil, "event")
	Registry.Remotes.Fx:FireClient(player, "rebirth", nil, data.Rebirths)
	sound(player, "Rebirth")
	Registry.Economy.Push(player)
	task.spawn(Registry.Data.Save, player) -- rebirth é importante: salva já
end

function Shop.Init()
	-- balcões da praça: chegar perto e apertar E abre o painel certo na tela
	for pointName, info in { HenShopPoint = { "Hens", "Ver aves", "Galinheiro do Seu Zé" }, UpgradeShopPoint = { "Upgrades", "Ver melhorias", "Oficina" }, RebirthPoint = { "Rebirth", "Rebirth", "Altar" }, MissionPoint = { "Missions", "Ver missões", "Quadro" }, StorePoint = { "Robux", "Ver loja", "Banco" } } do
		local part = point(pointName)
		if part then
			local prompt = Registry.Plots.MakePrompt(part, info[2], info[3], "all", 0, 14)
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt:SetAttribute("Opens", info[1])
		end
	end
	Registry.Remotes.On("BuyHen", buyHen)
	Registry.Remotes.On("BuyUpgrade", buyUpgrade)
	Registry.Remotes.On("Rebirth", rebirth)
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="640">
        <Properties>
          <string name="Name">Store</string>
          <string name="Source"><![CDATA[--[[
	Store: vendas em Robux.
	  • Game passes (compra uma vez): Dinheiro x2, Cesta VIP, Coleta Automática.
	    Entrega pelo evento PromptGamePassPurchaseFinished NO SERVIDOR (não depende do cache do
	    UserOwnsGamePassAsync, que pode dizer "não tem" logo depois da compra) e guarda nos dados.
	  • Produtos (compra várias vezes): pacotes de moedas e boosts por tempo.
	    Entrega pelo ProcessReceipt: cada compra (PurchaseId) é entregue UMA vez só, e só confirma
	    para o Roblox depois de salvar. Se o save falhar, o Roblox tenta de novo e nada é dado em dobro.
	IDs ficam em Config.GamePasses e Config.Products (0 = desligado).
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Registry = require(script.Parent.Registry)

local Store = {}

local MAX_RECEIPTS = 50

local passById: { [number]: any } = {}
local passByKey: { [string]: any } = {}
local productById: { [number]: any } = {}
local productByKey: { [string]: any } = {}

for _, pass in Config.GamePasses do
	passByKey[pass.Key] = pass
	if pass.Id and pass.Id > 0 then
		passById[pass.Id] = pass
	end
end
for _, product in Config.Products do
	productByKey[product.Key] = product
	if product.Id and product.Id > 0 then
		productById[product.Id] = product
	end
end

local function grantPass(player: Player, pass: any)
	local data = Registry.Economy.Data(player)
	Registry.Economy.Owned(player)[pass.Key] = true
	if data then
		data.Passes[pass.Key] = true
	end
	Registry.Remotes.NotifyPlayer(player, ("Valeu! %s ligado."):format(pass.Name), nil, "success")
	Registry.Remotes.Fx:FireClient(player, "sound", nil, "Comprar")
	Registry.Economy.Push(player)
end

-- Confere os game passes de quem entrou (o que já estava salvo também vale)
function Store.CheckPasses(player: Player)
	for _, pass in Config.GamePasses do
		if pass.Id and pass.Id > 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if ok and has then
				Registry.Economy.Owned(player)[pass.Key] = true
				local data = Registry.Economy.Data(player)
				if data then
					data.Passes[pass.Key] = true
				end
			end
		end
	end
	Registry.Economy.Push(player)
end

local function buyPass(player: Player, key: any)
	local pass = type(key) == "string" and passByKey[key]
	if not pass or not pass.Id or pass.Id <= 0 then
		return
	end
	if Registry.Economy.HasPass(player, pass.Key) then
		Registry.Remotes.NotifyPlayer(player, "Você já tem esse.", nil, "info")
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.Id)
end

local function buyProduct(player: Player, key: any)
	local product = type(key) == "string" and productByKey[key]
	if not product or not product.Id or product.Id <= 0 then
		return
	end
	MarketplaceService:PromptProductPurchase(player, product.Id)
end

local function deliverProduct(player: Player, data: any, product: any)
	if product.Kind == "coins" then
		local coins = Formulas.ProductCoins(Config, product, data)
		Registry.Economy.AddCoins(player, coins, false)
		Registry.Remotes.NotifyPlayer(player, ("Valeu! +%d moedas."):format(coins), nil, "success")
		Registry.Remotes.Fx:FireClient(player, "gift", nil, coins)
	elseif product.Kind == "boost" then
		local now = os.time()
		local current = math.max(now, tonumber(data.Boosts[product.Boost]) or 0)
		data.Boosts[product.Boost] = current + product.Seconds
		Registry.Remotes.NotifyPlayer(player, ("Valeu! %s ligado."):format(product.Name), nil, "success")
	end
	Registry.Remotes.Fx:FireClient(player, "sound", nil, "Comprar")
	Registry.Economy.Push(player)
end

local function processReceipt(receipt: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local product = productById[receipt.ProductId]
	if not player or not product then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = Registry.Economy.Data(player)
	local profile = Registry.Data.Get(player)
	if not data or not profile or not profile.CanSave then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if table.find(data.Receipts, purchaseId) then
		-- já entregue nesta sessão: só confirma ao Roblox depois que estiver salvo
		return if Registry.Data.Save(player) then Enum.ProductPurchaseDecision.PurchaseGranted else Enum.ProductPurchaseDecision.NotProcessedYet
	end
	deliverProduct(player, data, product)
	table.insert(data.Receipts, purchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
	if Registry.Data.Save(player) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- não salvou agora: o Roblox chama de novo; como o PurchaseId já está nos dados, não entrega em dobro
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function Store.Init()
	Registry.Remotes.On("BuyPass", buyPass)
	Registry.Remotes.On("BuyProduct", buyProduct)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
		local pass = passById[passId]
		if purchased and pass then
			grantPass(player, pass)
		end
	end)
	MarketplaceService.ProcessReceipt = processReceipt
end

return Store
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="641">
      <Properties>
        <string name="Name">Main</string>
        <string name="Source"><![CDATA[--[[
	VENDA UM OVO - script principal do servidor (Script "Main" em ServerScriptService).
	Liga os módulos da pasta "Game" e cuida da entrada/saída dos jogadores.
	Pra ajustar o jogo, mexa em ReplicatedStorage > Shared > Config.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local AssetLib = require(ReplicatedStorage.Shared.AssetLib)
local Config = require(ReplicatedStorage.Shared.Config)
local GameFolder = script.Parent:WaitForChild("Game")
local Registry = require(GameFolder.Registry)

-- Cenário: troca cada objeto pela versão atual de ReplicatedStorage > Assets (arte 3D nova entra aqui)
local okScenery, errScenery = pcall(AssetLib.RefreshScenery, workspace)
if not okScenery then
	warn("[Main] cenário:", errScenery)
end

-- Texturas (Config.Textures): peças com o atributo "Tex" ganham a textura que repete
for _, d in workspace:GetDescendants() do
	local texName = d:IsA("BasePart") and d:GetAttribute("Tex")
	local id = texName and Config.Textures[texName]
	if id and id ~= "" then
		for _, face in { Enum.NormalId.Top, Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right } do
			local texture = Instance.new("Texture")
			texture.Texture = id
			texture.Face = face
			texture.StudsPerTileU = Config.TextureTile
			texture.StudsPerTileV = Config.TextureTile
			texture.Parent = d
		end
	end
end

Registry.Remotes = require(GameFolder.Remotes)
Registry.Data = require(GameFolder.Data)
Registry.Economy = require(GameFolder.Economy)
Registry.Plots = require(GameFolder.Plots)
Registry.Farm = require(GameFolder.Farm)
Registry.Shop = require(GameFolder.Shop)
Registry.Daily = require(GameFolder.Daily)
Registry.Store = require(GameFolder.Store)
Registry.Leaderboard = require(GameFolder.Leaderboard)
Registry.Customers = require(GameFolder.Customers)
Registry.Events = require(GameFolder.Events)

-- Cada sistema liga sozinho; se um der erro, os outros continuam
for _, name in { "Economy", "Plots", "Farm", "Shop", "Daily", "Store", "Leaderboard", "Customers", "Events" } do
	local ok, err = pcall(Registry[name].Init)
	if not ok then
		warn("[Main] " .. name .. ".Init falhou:", err)
	end
end

local function onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	Registry.Economy.ApplySpeed(player)
	-- clientes NPC não esbarram nos jogadores (não bloqueiam a fila nem o caminho)
	local function setGroup(part: Instance)
		if part:IsA("BasePart") then
			part.CollisionGroup = "Players"
		end
	end
	for _, d in character:GetDescendants() do
		setGroup(d)
	end
	character.DescendantAdded:Connect(setGroup)
	-- renasce sozinho depois de cair/morrer
	humanoid.Died:Connect(function()
		task.wait(3)
		if player.Parent and player.Character == character then
			player:LoadCharacter()
		end
	end)
	-- nasce dentro da própria granja
	local plot = Registry.Plots.Of(player)
	if plot and character:WaitForChild("HumanoidRootPart", 10) then
		task.defer(function()
			character:PivotTo(Registry.Plots.SpawnCFrame(plot))
		end)
	end
end

local function onPlayerAdded(player: Player)
	Registry.Economy.SetupPlayer(player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)

	local profile = Registry.Data.Load(player)
	if not player.Parent then
		if profile.CanSave then
			Registry.Data.Save(player, true)
		end
		Registry.Data.Remove(player)
		return
	end
	if not profile.CanSave and not RunService:IsStudio() then
		player:Kick("Não deu pra carregar seu progresso agora (Roblox ocupado). Ele tá salvo, entra de novo.")
		return
	end
	player:SetAttribute("Loaded", true)
	local plot = Registry.Plots.Assign(player)
	if not plot then
		player:Kick("Servidor cheio. Tenta outro.")
		return
	end
	Registry.Daily.Check(player)
	Registry.Daily.Offline(player)
	task.spawn(Registry.Store.CheckPasses, player)
	Registry.Economy.Push(player)
	player:LoadCharacter()
end

local function onPlayerRemoving(player: Player)
	pcall(Registry.Leaderboard.Write, player)
	pcall(Registry.Plots.Release, player)
	Registry.Remotes.RemovePlayer(player)
	pcall(Registry.Daily.Touch, player)
	Registry.Data.Save(player, true)
	Registry.Data.Remove(player)
end

Players.CharacterAutoLoads = false -- nasce só depois de carregar os dados e ganhar a granja
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- Salva todo mundo de tempos em tempos
task.spawn(function()
	while true do
		task.wait(60)
		for _, player in Players:GetPlayers() do
			pcall(Registry.Daily.Touch, player)
			task.spawn(Registry.Data.Save, player)
		end
	end
end)

-- Salva quando o servidor fecha
game:BindToClose(function()
	local pending = 0
	for _, player in Players:GetPlayers() do
		pending += 1
		task.spawn(function()
			pcall(Registry.Leaderboard.Write, player)
			pcall(Registry.Daily.Touch, player)
			Registry.Data.Save(player, true)
			pending -= 1
		end)
	end
	local started = os.clock()
	while (pending > 0 or Registry.Data.ActiveSaves() > 0) and os.clock() - started < 25 do
		task.wait(0.1)
	end
end)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="SoundService" referent="642">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="643">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="644">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="645">
        <Properties>
          <string name="Name">ClientMain</string>
          <string name="Source"><![CDATA[--[[
	VENDA UM OVO - tela do jogador (LocalScript em StarterPlayerScripts).
	Só MOSTRA as coisas e PEDE ações ao servidor. Nenhum valor de moeda sai daqui.
	Feita para celular: botões grandes, tudo em escala, painéis com rolagem.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local state: any = nil

-- ---------------------------------------------------------------------------
-- Cores e peças de interface
-- ---------------------------------------------------------------------------
local C = {
	Cream = Color3.fromRGB(255, 248, 230),
	Panel = Color3.fromRGB(255, 241, 205),
	Brown = Color3.fromRGB(110, 62, 28),
	DarkBrown = Color3.fromRGB(70, 38, 15),
	Yellow = Color3.fromRGB(255, 205, 50),
	Orange = Color3.fromRGB(255, 140, 40),
	Green = Color3.fromRGB(80, 200, 90),
	DarkGreen = Color3.fromRGB(40, 140, 55),
	Red = Color3.fromRGB(235, 70, 60),
	Blue = Color3.fromRGB(70, 160, 255),
	Purple = Color3.fromRGB(170, 90, 230),
	Gray = Color3.fromRGB(170, 160, 150),
	White = Color3.new(1, 1, 1),
}
local FONT = Enum.Font.FredokaOne

local EMOJI = {
	Moeda = "🪙",
	Cesta = "🧺",
	Raio = "⚡",
	Estrela = "⭐",
	Presente = "🎁",
	Trofeu = "🏆",
}

local function new(className: string, props: { [string]: any }, children: { Instance }?): any
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(inst :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(radius: number?): UICorner
	return new("UICorner", { CornerRadius = UDim.new(radius or 0.25, 0) })
end

local function stroke(color: Color3?, thickness: number?): UIStroke
	return new("UIStroke", { Color = color or C.DarkBrown, Thickness = thickness or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function textStroke(): UIStroke
	return new("UIStroke", { Color = C.DarkBrown, Thickness = 2 })
end

local function label(props: { [string]: any }): TextLabel
	local base = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextScaled = true,
		TextColor3 = C.White,
	}
	for k, v in props do
		if k ~= "MaxText" then -- MaxText é nosso, não é propriedade do TextLabel
			base[k] = v
		end
	end
	local l = new("TextLabel", base)
	if props.TextColor3 == nil or props.TextColor3 == C.White then
		textStroke().Parent = l
	end
	new("UITextSizeConstraint", { MaxTextSize = props.MaxText or 40, Parent = l })
	return l
end

-- Ícone: imagem do Config.Images se tiver ID, senão o emoji
local function icon(name: string, emoji: string?, props: { [string]: any }): GuiObject
	local id = Config.Images[name]
	if id and id ~= "" then
		local base = { BackgroundTransparency = 1, Image = id, ScaleType = Enum.ScaleType.Fit }
		for k, v in props do
			base[k] = v
		end
		return new("ImageLabel", base)
	end
	local base = { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextScaled = true, Text = emoji or EMOJI[name] or "🥚" }
	for k, v in props do
		base[k] = v
	end
	return new("TextLabel", base)
end

local function eggIcon(eggId: string, props: { [string]: any }): GuiObject
	local egg = Config.EggById[eggId]
	return icon(if egg then egg.Asset else "", "🥚", props)
end

local function button(props: { [string]: any }, onClick: () -> ()): TextButton
	local base = {
		AutoButtonColor = true,
		Font = FONT,
		TextScaled = true,
		TextColor3 = C.White,
		BackgroundColor3 = C.Green,
	}
	for k, v in props do
		if k ~= "MaxText" then
			base[k] = v
		end
	end
	local b = new("TextButton", base, { corner(0.3), stroke(C.DarkBrown, 3), textStroke() })
	new("UITextSizeConstraint", { MaxTextSize = props.MaxText or 32, Parent = b })
	b.Activated:Connect(onClick)
	return b
end

local function request(action: string, a: any?, b: any?)
	Remotes.Request:FireServer(action, a, b)
end

local function playSound(name: string)
	local id = Config.Sounds[name]
	if not id or id == "" then
		return
	end
	local s = new("Sound", { SoundId = id, Volume = 0.7, Parent = SoundService })
	s:Play()
	s.Ended:Connect(function()
		s:Destroy()
	end)
end

-- ---------------------------------------------------------------------------
-- Tela principal
-- ---------------------------------------------------------------------------
local gui = new("ScreenGui", { Name = "VendaUmOvo", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = playerGui })

-- Barra de cima: moedas, multiplicador e cesta
local top = new("Frame", {
	Name = "Top",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 8),
	Size = UDim2.new(0.62, 0, 0, 56),
	BackgroundTransparency = 1,
	Parent = gui,
}, {
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 8), VerticalAlignment = Enum.VerticalAlignment.Center }),
	new("UISizeConstraint", { MaxSize = Vector2.new(640, 56) }),
})

local function pill(name: string, color: Color3, widthScale: number, order: number): (Frame, TextLabel)
	local f = new("Frame", { Name = name, Size = UDim2.new(widthScale, 0, 1, 0), BackgroundColor3 = color, LayoutOrder = order, Parent = top }, { corner(0.5), stroke(C.DarkBrown, 3) })
	local text = label({ Name = "Text", Position = UDim2.new(0.3, 0, 0.12, 0), Size = UDim2.new(0.66, 0, 0.76, 0), TextXAlignment = Enum.TextXAlignment.Left, Text = "0", Parent = f })
	return f, text
end

local coinPill, coinText = pill("Coins", C.Yellow, 0.42, 1)
icon("Moeda", nil, { Position = UDim2.new(0.03, 0, 0.08, 0), Size = UDim2.new(0.24, 0, 0.84, 0), Parent = coinPill })
local multPill, multText = pill("Mult", C.Purple, 0.22, 2)
icon("Estrela", nil, { Position = UDim2.new(0.04, 0, 0.12, 0), Size = UDim2.new(0.26, 0, 0.76, 0), Parent = multPill })
local basketPill, basketText = pill("Basket", C.Orange, 0.32, 3)
icon("Cesta", nil, { Position = UDim2.new(0.03, 0, 0.08, 0), Size = UDim2.new(0.24, 0, 0.84, 0), Parent = basketPill })
local basketFill = new("Frame", { Name = "Fill", BackgroundColor3 = C.Red, BackgroundTransparency = 0.35, Size = UDim2.new(0, 0, 1, 0), ZIndex = 0, Parent = basketPill }, { corner(0.5) })

-- Boosts ativos (embaixo da barra)
local boostBar = new("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 68),
	Size = UDim2.new(0.5, 0, 0, 24),
	BackgroundTransparency = 1,
	Font = FONT,
	TextScaled = true,
	TextColor3 = C.Yellow,
	Text = "",
	Parent = gui,
}, { textStroke() })

-- Botões da esquerda
local side = new("Frame", {
	Name = "Side",
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 10, 0.52, 0),
	Size = UDim2.new(0, 84, 0.66, 0),
	BackgroundTransparency = 1,
	Parent = gui,
}, {
	new("UIListLayout", { Padding = UDim.new(0.015, 0), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
})

local panels: { [string]: Frame } = {}
local openPanel: string? = nil
local refreshers: { [string]: () -> () } = {}

local function showPanel(name: string?)
	for key, panel in panels do
		panel.Visible = key == name
	end
	openPanel = name
	if name and refreshers[name] then
		refreshers[name]()
	end
end

local function sideButton(name: string, iconName: string, text: string, color: Color3, order: number): TextButton
	local b = new("TextButton", {
		Name = name,
		Size = UDim2.new(1, 0, 0.15, 0),
		BackgroundColor3 = color,
		Text = "",
		LayoutOrder = order,
		AutoButtonColor = true,
		Parent = side,
	}, { corner(0.25), stroke(C.DarkBrown, 3), new("UIAspectRatioConstraint", { AspectRatio = 1 }) })
	icon(iconName, nil, { Position = UDim2.new(0.18, 0, 0.06, 0), Size = UDim2.new(0.64, 0, 0.58, 0), Parent = b })
	label({ Name = "Label", Position = UDim2.new(0, 0, 0.64, 0), Size = UDim2.new(1, 0, 0.32, 0), Text = text, MaxText = 18, Parent = b })
	b.Activated:Connect(function()
		showPanel(if openPanel == name then nil else name)
	end)
	return b
end

sideButton("Hens", "Ovo_Caipira", "Aves", C.Orange, 1)
sideButton("Upgrades", "Raio", "Melhorias", C.Blue, 2)
sideButton("Rebirth", "Estrela", "Rebirth", C.Purple, 3)
sideButton("Missions", "Trofeu", "Missões", C.Green, 4)
local giftButton = sideButton("Gift", "Presente", "Presente", C.Red, 5)
sideButton("Robux", "Moeda", "Loja", C.Yellow, 6)

-- ---------------------------------------------------------------------------
-- Painéis
-- ---------------------------------------------------------------------------
local function makePanel(name: string, title: string, color: Color3): ScrollingFrame
	local panel = new("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.54, 0),
		Size = UDim2.new(0.62, 0, 0.72, 0),
		BackgroundColor3 = C.Panel,
		Visible = false,
		Parent = gui,
	}, { corner(0.06), stroke(C.DarkBrown, 4), new("UISizeConstraint", { MaxSize = Vector2.new(720, 560), MinSize = Vector2.new(300, 260) }) })
	local header = new("Frame", { Size = UDim2.new(1, 0, 0.14, 0), BackgroundColor3 = color, Parent = panel }, { corner(0.3), stroke(C.DarkBrown, 3) })
	label({ Position = UDim2.new(0.04, 0, 0.12, 0), Size = UDim2.new(0.75, 0, 0.76, 0), Text = title, TextXAlignment = Enum.TextXAlignment.Left, Parent = header })
	button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(0.98, 0, 0.5, 0), Size = UDim2.new(0.12, 0, 0.8, 0), Text = "X", BackgroundColor3 = C.Red, Parent = header }, function()
		showPanel(nil)
	end)
	local list = new("ScrollingFrame", {
		Name = "List",
		Position = UDim2.new(0.03, 0, 0.17, 0),
		Size = UDim2.new(0.94, 0, 0.8, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = C.Brown,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		Parent = panel,
	}, { new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	panels[name] = panel
	return list
end

local function clearList(list: ScrollingFrame)
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") and not child:GetAttribute("Keep") then
			child:Destroy()
		end
	end
end

-- Cartão padrão: ícone | título + descrição | botão
local function card(list: ScrollingFrame, order: number, iconObj: GuiObject, title: string, desc: string, buttonText: string, buttonColor: Color3, onClick: (() -> ())?): Frame
	local f = new("Frame", { Size = UDim2.new(1, -10, 0, 78), BackgroundColor3 = C.Cream, LayoutOrder = order, Parent = list }, { corner(0.2), stroke(C.Brown, 2) })
	iconObj.Position = UDim2.new(0, 8, 0.1, 0)
	iconObj.Size = UDim2.new(0, 62, 0.8, 0)
	iconObj.Parent = f
	label({ Position = UDim2.new(0, 80, 0.08, 0), Size = UDim2.new(0.6, -80, 0.44, 0), Text = title, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.DarkBrown, MaxText = 26, Parent = f })
	label({ Position = UDim2.new(0, 80, 0.52, 0), Size = UDim2.new(0.6, -80, 0.38, 0), Text = desc, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Brown, MaxText = 18, Font = Enum.Font.GothamBold, Parent = f })
	local b = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0.36, 0, 0.7, 0), Text = buttonText, BackgroundColor3 = buttonColor, MaxText = 24, Parent = f }, function()
		if onClick then
			onClick()
		end
	end)
	b.Active = onClick ~= nil
	b.AutoButtonColor = onClick ~= nil
	return f
end

-- AVES
local hensList = makePanel("Hens", "Galinheiro do Seu Zé", C.Orange)
refreshers.Hens = function()
	clearList(hensList)
	if not state then
		return
	end
	local counts = {}
	for _, id in state.Hens do
		counts[id] = (counts[id] or 0) + 1
	end
	new("TextLabel", {
		Size = UDim2.new(1, -10, 0, 30),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		TextColor3 = C.Brown,
		Text = ("Ninhos usados: %d de %d. Pra comprar, vá no balcão do Seu Zé, na praça."):format(#state.Hens, state.NestCap),
		LayoutOrder = 0,
		Parent = hensList,
	})
	for i, hen in Config.Hens do
		local egg = Config.EggById[hen.Egg]
		local canPay = state.Coins >= hen.Price
		local owned = counts[hen.Id] or 0
		card(
			hensList,
			i,
			eggIcon(hen.Egg, {}),
			hen.Name .. (if owned > 0 then ("  (x%d)"):format(owned) else ""),
			("%s, vale %s. Bota a cada %ds"):format(egg.Name, Format.Short(egg.Value), hen.LayTime),
			"🪙 " .. Format.Short(hen.Price),
			if canPay then C.Green else C.Gray,
			function()
				request("BuyHen", hen.Id)
			end
		)
	end
end

-- MELHORIAS
local upgradesList = makePanel("Upgrades", "Melhorias", C.Blue)
refreshers.Upgrades = function()
	clearList(upgradesList)
	if not state then
		return
	end
	for i, upgrade in Config.Upgrades do
		local level = state.Upgrades[upgrade.Id] or 0
		local cost = upgrade.Costs[level + 1]
		local nextValue = upgrade.Values[math.min(level + 2, #upgrade.Values)]
		local desc = string.gsub(upgrade.Format, "{v}", tostring(nextValue))
		desc = string.gsub(desc, "{p}", tostring(math.floor((1 - nextValue) * 100 + 0.5)))
		local title = ("%s  (nível %d/%d)"):format(upgrade.Name, level, #upgrade.Costs)
		if cost then
			card(upgradesList, i, icon(upgrade.Icon, nil, {}), title, "Próximo: " .. desc, "🪙 " .. Format.Short(cost), if state.Coins >= cost then C.Green else C.Gray, function()
				request("BuyUpgrade", upgrade.Id)
			end)
		else
			card(upgradesList, i, icon(upgrade.Icon, nil, {}), title, "Já tá no máximo.", "MÁXIMO", C.Purple, nil)
		end
	end
	new("TextLabel", {
		Size = UDim2.new(1, -10, 0, 28),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		TextColor3 = C.Brown,
		Text = "Compra no balcão da oficina, na praça.",
		LayoutOrder = 100,
		Parent = upgradesList,
	})
end

-- REBIRTH
local rebirthList = makePanel("Rebirth", "Rebirth", C.Purple)
refreshers.Rebirth = function()
	clearList(rebirthList)
	if not state then
		return
	end
	local current = 1 + Config.RebirthBonus * state.Rebirths
	local after = 1 + Config.RebirthBonus * (state.Rebirths + 1)
	local progress = math.clamp(state.Coins / state.RebirthCost, 0, 1)
	local info = new("Frame", { Size = UDim2.new(1, -10, 0, 170), BackgroundColor3 = C.Cream, LayoutOrder = 1, Parent = rebirthList }, { corner(0.1), stroke(C.Brown, 2) })
	label({ Position = UDim2.new(0.05, 0, 0.04, 0), Size = UDim2.new(0.9, 0, 0.22, 0), Text = ("Rebirths: %d. Bônus x%.1f, depois x%.1f"):format(state.Rebirths, current, after), TextColor3 = C.DarkBrown, Parent = info })
	label({ Position = UDim2.new(0.05, 0, 0.28, 0), Size = UDim2.new(0.9, 0, 0.2, 0), Text = "Você perde moedas, aves e melhorias, mas toda venda passa a render mais. Pra sempre.", TextColor3 = C.Brown, Font = Enum.Font.GothamBold, MaxText = 18, Parent = info })
	local bar = new("Frame", { Position = UDim2.new(0.05, 0, 0.54, 0), Size = UDim2.new(0.9, 0, 0.18, 0), BackgroundColor3 = C.Gray, Parent = info }, { corner(0.5), stroke(C.DarkBrown, 2) })
	new("Frame", { Size = UDim2.new(progress, 0, 1, 0), BackgroundColor3 = C.Purple, Parent = bar }, { corner(0.5) })
	label({ Size = UDim2.new(1, 0, 1, 0), Text = ("🪙 %s / %s"):format(Format.Short(state.Coins), Format.Short(state.RebirthCost)), MaxText = 20, Parent = bar })
	button({ Position = UDim2.new(0.25, 0, 0.77, 0), Size = UDim2.new(0.5, 0, 0.2, 0), Text = "Fazer rebirth", BackgroundColor3 = if progress >= 1 then C.Purple else C.Gray, Parent = info }, function()
		request("Rebirth")
	end)
end

-- MISSÕES
local missionsList = makePanel("Missions", "Missões de hoje", C.Green)
local MISSION_TEXT = {}
for _, m in Config.Missions do
	MISSION_TEXT[m.Id] = m.Text
end
local function makeCodeRow()
	local codeRow = new("Frame", { Name = "Codes", Size = UDim2.new(1, -10, 0, 64), BackgroundColor3 = C.Cream, LayoutOrder = 60, Parent = missionsList }, { corner(0.2), stroke(C.Brown, 2) })
	codeRow:SetAttribute("Keep", true)
	local box = new("TextBox", {
		Position = UDim2.new(0, 10, 0.15, 0),
		Size = UDim2.new(0.6, -10, 0.7, 0),
		BackgroundColor3 = C.White,
		PlaceholderText = "Digite um código",
		Text = "",
		ClearTextOnFocus = false,
		Font = FONT,
		TextScaled = true,
		TextColor3 = C.DarkBrown,
		Parent = codeRow,
	}, { corner(0.3), stroke(C.Brown, 2), new("UITextSizeConstraint", { MaxTextSize = 26 }) })
	button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0.36, 0, 0.7, 0), Text = "Usar código", BackgroundColor3 = C.Blue, MaxText = 24, Parent = codeRow }, function()
		if box.Text ~= "" then
			request("RedeemCode", box.Text)
			box.Text = ""
		end
	end)
end

refreshers.Missions = function()
	clearList(missionsList)
	if not state then
		return
	end
	-- sequência de dias
	local streakTitle, streakDesc, streakButton, streakColor, streakAction
	if state.StreakDay then
		streakTitle = ("Sequência: dia %d de 7"):format(state.StreakDay)
		streakDesc = ("Hoje vale %s moedas%s"):format(Format.Short(state.StreakReward), if state.StreakDay == 7 then " + Sorte x3" else "")
		streakButton, streakColor = "Pegar", C.Green
		streakAction = function()
			request("ClaimStreak")
		end
	else
		streakTitle = ("Sequência: dia %d de 7"):format(math.max(state.StreakLast or 1, 1))
		streakDesc = "Volta amanhã pra continuar (pulou um dia, recomeça)"
		streakButton, streakColor = "Amanhã", C.Gray
	end
	card(missionsList, 0, icon("Presente", nil, {}), streakTitle, streakDesc, streakButton, streakColor, streakAction)
	for i, mission in state.Daily do
		local text = string.gsub(MISSION_TEXT[mission.Id] or mission.Id, "{n}", Format.Short(mission.Target))
		local done = mission.Progress >= mission.Target
		local desc = ("%s de %s. Prêmio: %s moedas"):format(Format.Short(mission.Progress), Format.Short(mission.Target), Format.Short(mission.Reward))
		local buttonText, color, action = "Em andamento", C.Gray, nil
		if mission.Claimed then
			buttonText, color = "Pego", C.DarkGreen
		elseif done then
			buttonText, color = "Pegar", C.Green
			action = function()
				request("ClaimMission", i)
			end
		end
		local f = card(missionsList, i, icon("Trofeu", nil, {}), text, desc, buttonText, color, action)
		local bar = new("Frame", { Position = UDim2.new(0, 80, 0.9, 0), Size = UDim2.new(0.6, -80, 0.06, 0), BackgroundColor3 = C.Gray, BorderSizePixel = 0, Parent = f })
		new("Frame", { Size = UDim2.new(math.clamp(mission.Progress / math.max(mission.Target, 1), 0, 1), 0, 1, 0), BackgroundColor3 = C.Green, BorderSizePixel = 0, Parent = bar })
	end
	new("TextLabel", {
		Size = UDim2.new(1, -10, 0, 26),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		TextColor3 = C.Brown,
		Text = "Amanhã tem missão nova.",
		LayoutOrder = 50,
		Parent = missionsList,
	})
	-- códigos (a caixa é criada uma vez só: a tela atualiza o tempo todo e não pode apagar o que você digita)
	if not missionsList:FindFirstChild("Codes") then
		makeCodeRow()
	end
end

-- PRESENTE
local giftList = makePanel("Gift", "Presente", C.Red)
refreshers.Gift = function()
	clearList(giftList)
	if not state then
		return
	end
	local ready = state.GiftLeft <= 0
	card(
		giftList,
		1,
		icon("Presente", nil, {}),
		if ready then "Presente liberado" else "Presente de quem fica jogando",
		if ready then ("Vale %s moedas"):format(Format.Short(state.GiftReward)) else ("Libera em %s"):format(Format.Time(state.GiftLeft)),
		if ready then "Abrir" else Format.Time(state.GiftLeft),
		if ready then C.Green else C.Gray,
		if ready
			then function()
				request("ClaimGift")
			end
			else nil
	)
end

-- LOJA (ROBUX)
local robuxList = makePanel("Robux", "Loja", C.Yellow)
refreshers.Robux = function()
	clearList(robuxList)
	if not state then
		return
	end
	local order = 0
	for _, pass in Config.GamePasses do
		if pass.Id and pass.Id > 0 then
			order += 1
			local has = state.Passes[pass.Key]
			card(robuxList, order, icon(pass.Icon, nil, {}), pass.Name, pass.Desc, if has then "Já é seu" else "Comprar", if has then C.DarkGreen else C.Blue, if has
				then nil
				else function()
					request("BuyPass", pass.Key)
				end)
		end
	end
	for _, product in Config.Products do
		if product.Id and product.Id > 0 then
			order += 1
			local desc = product.Desc
			if product.Kind == "coins" and state then
				desc = "Quanto maior sua granja, mais moedas vêm"
			end
			card(robuxList, order, icon(product.Icon, nil, {}), product.Name, desc or "", ("R$ %d"):format(product.Robux or 0), C.Green, function()
				request("BuyProduct", product.Key)
			end)
		end
	end
	if order == 0 then
		new("TextLabel", {
			Size = UDim2.new(1, -10, 0, 60),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			TextScaled = true,
			TextWrapped = true,
			TextColor3 = C.Brown,
			Text = "Loja fechada por enquanto.",
			Parent = robuxList,
		})
	end
end

-- ---------------------------------------------------------------------------
-- Avisos
-- ---------------------------------------------------------------------------
local toastHolder = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 96),
	Size = UDim2.new(0.6, 0, 0.3, 0),
	BackgroundTransparency = 1,
	Parent = gui,
}, { new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center }), new("UISizeConstraint", { MaxSize = Vector2.new(560, 400) }) })

local KIND_COLOR = { success = C.Green, error = C.Red, event = C.Purple, info = C.Blue }

local function toast(text: string, kind: string?)
	local f = new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = KIND_COLOR[kind or "info"] or C.Blue, Parent = toastHolder }, { corner(0.4), stroke(C.DarkBrown, 3) })
	label({ Position = UDim2.new(0.03, 0, 0.1, 0), Size = UDim2.new(0.94, 0, 0.8, 0), Text = text, MaxText = 24, Parent = f })
	task.delay(3.5, function()
		local tween = TweenService:Create(f, TweenInfo.new(0.4), { BackgroundTransparency = 1 })
		tween:Play()
		tween.Completed:Wait()
		f:Destroy()
	end)
	while #toastHolder:GetChildren() > 5 do
		for _, child in toastHolder:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
				break
			end
		end
	end
end

Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(text: string, _args: any, kind: string?)
	toast(text, kind)
end)

-- ---------------------------------------------------------------------------
-- Efeitos
-- ---------------------------------------------------------------------------
local function floatText(position: Vector3, text: string, color: Color3)
	local anchor = new("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2), Position = position, Parent = workspace })
	local bb = new("BillboardGui", { Size = UDim2.new(0, 200, 0, 56), AlwaysOnTop = true, Adornee = anchor, Parent = anchor })
	local l = label({ Size = UDim2.new(1, 0, 1, 0), Text = text, TextColor3 = color, Parent = bb })
	textStroke().Parent = l
	local tween = TweenService:Create(anchor, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = position + Vector3.new(0, 6, 0) })
	tween:Play()
	TweenService:Create(l, TweenInfo.new(1.4), { TextTransparency = 1 }):Play()
	task.delay(1.5, function()
		anchor:Destroy()
	end)
end

local function bigPopup(text: string, color: Color3)
	local l = label({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.35, 0), Size = UDim2.new(0.6, 0, 0.12, 0), Text = text, TextColor3 = color, MaxText = 64, Parent = gui })
	textStroke().Parent = l
	l.Size = UDim2.new(0.1, 0, 0.02, 0)
	TweenService:Create(l, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Size = UDim2.new(0.6, 0, 0.12, 0) }):Play()
	task.delay(2.2, function()
		TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		task.wait(0.45)
		l:Destroy()
	end)
end

Remotes:WaitForChild("Fx").OnClientEvent:Connect(function(kind: string, position: Vector3?, value: any)
	if kind == "money" and position then
		floatText(position, "+" .. Format.Short(value), C.Yellow)
	elseif kind == "sold" then
		playSound("Vender")
	elseif kind == "collect" and position then
		floatText(position + Vector3.new(0, 2, 0), "+" .. tostring(value) .. " 🥚", C.White)
		playSound("Coletar")
	elseif kind == "rare" then
		bigPopup("OVO RARO!\n" .. tostring(value), C.Yellow)
		playSound("OvoRaro")
	elseif kind == "rebirth" then
		bigPopup("REBIRTH " .. tostring(value), C.Purple)
	elseif kind == "gift" then
		bigPopup("+" .. Format.Short(value) .. " moedas", C.Green)
	elseif kind == "sound" then
		playSound(tostring(value))
	elseif kind == "customer" then
		playSound("Cliente")
	elseif kind == "offline" and type(value) == "table" then
		local minutes = math.floor((value.Seconds or 0) / 60)
		bigPopup(("Enquanto você estava fora (%d min)\nsuas aves botaram %s ovos: +%s moedas"):format(minutes, Format.Short(value.Eggs or 0), Format.Short(value.Coins or 0)), C.Yellow)
		playSound("Vender")
	end
end)

-- ---------------------------------------------------------------------------
-- Estado vindo do servidor
-- ---------------------------------------------------------------------------
local function updateHud()
	if not state then
		return
	end
	coinText.Text = Format.Short(state.Coins)
	multText.Text = if state.Mult >= 100 then "x" .. Format.Short(state.Mult) else string.gsub(string.format("x%.1f", state.Mult), "%.0$", "")
	basketText.Text = ("%d/%d"):format(state.BasketCount, state.BasketCap)
	local fill = math.clamp(state.BasketCount / math.max(state.BasketCap, 1), 0, 1)
	TweenService:Create(basketFill, TweenInfo.new(0.25), { Size = UDim2.new(fill, 0, 1, 0) }):Play()
	basketFill.BackgroundColor3 = if fill >= 1 then C.Red else C.Green
	local giftLabel = giftButton:FindFirstChild("Label") :: TextLabel
	giftLabel.Text = if state.GiftLeft <= 0 then "Abrir" else "Presente"
	if openPanel and refreshers[openPanel] then
		refreshers[openPanel]()
	end
end

Remotes:WaitForChild("State").OnClientEvent:Connect(function(newState: any)
	state = newState
	updateHud()
end)

-- relógios na tela (boosts e presente) contados no cliente a partir do horário do servidor
task.spawn(function()
	while true do
		task.wait(1)
		if state then
			local now = workspace:GetServerTimeNow()
			local parts = {}
			for key, ends in state.Boosts do
				local left = ends - now
				if left > 0 then
					table.insert(parts, (if key == "Sorte" then "Sorte x3  " else "Venda x2  ") .. Format.Time(left))
				end
			end
			local rainEnd = workspace:GetAttribute("GoldenRainEnd")
			if type(rainEnd) == "number" and rainEnd > now then
				table.insert(parts, 1, "Chuva dourada " .. Format.Time(rainEnd - now))
			end
			boostBar.Text = table.concat(parts, "    ")
			if state.GiftLeft > 0 then
				state.GiftLeft -= 1
				if openPanel == "Gift" then
					refreshers.Gift()
				end
			end
			local giftLabel = giftButton:FindFirstChild("Label") :: TextLabel
			giftLabel.Text = if state.GiftLeft <= 0 then "Abrir" else Format.Time(state.GiftLeft)
		end
	end
end)

-- ---------------------------------------------------------------------------
-- Prompts: cada jogador só vê os da própria granja; balcões das lojas abrem o painel
-- ---------------------------------------------------------------------------
local function promptAllowed(prompt: ProximityPrompt): boolean
	if prompt:GetAttribute("Active") == false then
		return false
	end
	local forWho = prompt:GetAttribute("For")
	if forWho == "owner" then
		return prompt:GetAttribute("Owner") == player.UserId
	end
	return true
end

task.spawn(function()
	while true do
		for _, prompt in CollectionService:GetTagged("VUOPrompt") do
			if prompt:IsA("ProximityPrompt") then
				local allowed = promptAllowed(prompt)
				if prompt.Enabled ~= allowed then
					prompt.Enabled = allowed
				end
			end
		end
		task.wait(0.3)
	end
end)

ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
	local opens = prompt:GetAttribute("Opens")
	if type(opens) == "string" and panels[opens] then
		showPanel(opens)
	end
end)

-- ---------------------------------------------------------------------------
-- Seta de ajuda no começo: aponta o ninho com ovos ou a banca
-- ---------------------------------------------------------------------------
local arrowAttachA: Attachment? = nil
local arrowPart = new("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2), Parent = workspace })
local arrowAttachB = new("Attachment", { Parent = arrowPart })
local beam = new("Beam", {
	Attachment1 = arrowAttachB,
	Width0 = 1.2,
	Width1 = 1.2,
	FaceCamera = true,
	Color = ColorSequence.new(C.Yellow),
	LightEmission = 0.6,
	Enabled = false,
	Parent = arrowPart,
})

local function myPlot(): Model?
	local plots = workspace:FindFirstChild("Plots")
	if not plots then
		return nil
	end
	for _, plot in plots:GetChildren() do
		if plot:GetAttribute("OwnerId") == player.UserId then
			return plot
		end
	end
	return nil
end

RunService.Heartbeat:Connect(function()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not state or state.TotalEarned >= 2000 then
		beam.Enabled = false
		return
	end
	if not arrowAttachA or arrowAttachA.Parent ~= root then
		arrowAttachA = new("Attachment", { Parent = root })
		beam.Attachment0 = arrowAttachA
	end
	local plot = myPlot()
	if not plot then
		beam.Enabled = false
		return
	end
	local target: Vector3? = nil
	if state.BasketCount > 0 and (state.BasketCount >= state.BasketCap or state.BasketCount >= 5) then
		local point = plot:FindFirstChild("SellPoint")
		target = point and point.Position
	else
		local visuals = plot:FindFirstChild("Visuals")
		local eggs = visuals and visuals:FindFirstChild("Eggs")
		local best, bestDist = nil, math.huge
		if eggs then
			for _, nestFolder in eggs:GetChildren() do
				local nest = plot:FindFirstChild(nestFolder.Name)
				if nest and #nestFolder:GetChildren() > 0 then
					local d = (nest.Position - root.Position).Magnitude
					if d < bestDist then
						best, bestDist = nest.Position, d
					end
				end
			end
		end
		target = best
		if not target and state.BasketCount > 0 then
			local point = plot:FindFirstChild("SellPoint")
			target = point and point.Position
		end
	end
	if target then
		arrowPart.Position = target + Vector3.new(0, 2, 0)
		beam.Enabled = (target - root.Position).Magnitude > 6
	else
		beam.Enabled = false
	end
end)

-- ---------------------------------------------------------------------------
-- Aves balançando (só visual, no cliente)
-- ---------------------------------------------------------------------------
local bases: { [Model]: CFrame } = {}
RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for _, hen in CollectionService:GetTagged("VUOHen") do
		if hen:IsA("Model") and hen.Parent then
			local base = bases[hen]
			if not base then
				base = hen:GetPivot()
				bases[hen] = base
			end
			local phase = (hen:GetAttribute("Phase") or (#hen.Name * 0.7)) :: number
			local hop = math.max(0, math.sin(t * 3 + phase)) * 0.25
			local tilt = math.sin(t * 1.5 + phase) * 0.08
			hen:PivotTo(base * CFrame.new(0, hop, 0) * CFrame.Angles(0, tilt, 0))
		end
	end
	for hen in bases do
		if not hen.Parent then
			bases[hen] = nil
		end
	end
end)

-- ---------------------------------------------------------------------------
-- Música (liga/desliga fica salvo no seu progresso) e cacarejos perto das aves
-- ---------------------------------------------------------------------------
local music: Sound? = nil
if Config.Sounds.Musica ~= "" then
	music = new("Sound", { Name = "Musica", SoundId = Config.Sounds.Musica, Looped = true, Volume = Config.MusicVolume, Parent = SoundService })
end
local musicButton = button({
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -10, 0, 8),
	Size = UDim2.new(0, 56, 0, 56),
	Text = "♪",
	BackgroundColor3 = C.Purple,
	MaxText = 30,
	Parent = gui,
}, function()
	if state then
		request("SetMusic", not state.Music)
	end
end)
musicButton.Visible = music ~= nil

task.spawn(function()
	while true do
		task.wait(1)
		if music and state then
			if state.Music and not music.IsPlaying then
				music:Play()
			elseif not state.Music and music.IsPlaying then
				music:Pause()
			end
			musicButton.BackgroundColor3 = if state.Music then C.Purple else C.Gray
		end
	end
end)

task.spawn(function()
	if Config.Sounds.Cacarejo == "" then
		return
	end
	while true do
		task.wait(6 + math.random() * 8)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			local near = {}
			for _, hen in CollectionService:GetTagged("VUOHen") do
				if hen:IsA("Model") and (hen:GetPivot().Position - root.Position).Magnitude < 60 then
					table.insert(near, hen)
				end
			end
			if #near > 0 then
				local hen = near[math.random(1, #near)]
				local anchor = hen:FindFirstChildWhichIsA("BasePart")
				if anchor then
					local s = new("Sound", { SoundId = Config.Sounds.Cacarejo, Volume = 0.5, RollOffMaxDistance = 60, PlaybackSpeed = 0.9 + math.random() * 0.3, Parent = anchor })
					s:Play()
					s.Ended:Connect(function()
						s:Destroy()
					end)
				end
			end
		end
	end
end)

-- Fecha painéis com ESC/B no PC
game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
	if not processed and (input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.B) then
		showPanel(nil)
	end
end)
