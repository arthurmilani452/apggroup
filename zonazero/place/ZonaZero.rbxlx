      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">WeaponBuilder</string>
          <string name="Source"><![CDATA[--[[
	WeaponBuilder (ModuleScript em ReplicatedStorage > Shared)
	Monta armas, curas e caixas de munição em 3D com peças.

	MODELOS 3D DE VERDADE: coloque um Model (ou MeshPart) dentro de ReplicatedStorage > Models3D
	com o MESMO nome da coisa (Pistol, SMG, Rifle, Shotgun, Sniper, Bandage, Medkit, ShieldCell, Ammo).
	O jogo usa esse modelo no lugar das peças: ajusta o tamanho sozinho e encaixa na mão.
	Dica: deixe o cano da arma apontando para a frente (-Z, o "Front" do Studio).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(script.Parent.Config)

local WeaponBuilder = {}

local DARK = Color3.fromRGB(30, 32, 36)

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.Parent = parent
	return p
end

-- cilindro deitado ao longo do eixo Z (o Cylinder do Roblox fica no eixo X)
local function tube(parent: Instance, name: string, length: number, diameter: number, center: CFrame, color: Color3, material: Enum.Material?): Part
	return part(parent, name, Vector3.new(length, diameter, diameter), center * CFrame.Angles(0, math.rad(90), 0), color, material, Enum.PartType.Cylinder)
end

local function weldAll(model: Model, root: BasePart)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = d
			w.Parent = d
		end
	end
end

-- Usa um modelo 3D importado (Models3D) no lugar das peças, se existir
local function try3D(id: string, holder: Model, root: BasePart, length: number, center: CFrame): boolean
	local folder = ReplicatedStorage:FindFirstChild("Models3D")
	local source = folder and folder:FindFirstChild(id)
	if not source then
		return false
	end
	local clone = source:Clone()
	local model: Model
	if clone:IsA("Model") then
		model = clone
	elseif clone:IsA("BasePart") then
		model = Instance.new("Model")
		clone.Parent = model
	else
		clone:Destroy()
		return false
	end
	local _, size = model:GetBoundingBox()
	local longest = math.max(size.X, size.Y, size.Z)
	if longest > 0 then
		model:ScaleTo(length / longest)
	end
	model:PivotTo(center)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy() -- nada de scripts vindos de modelos importados
		end
	end
	model.Name = "Model3D"
	model.Parent = holder
	-- esconde as peças feitas por código (o modelo 3D toma o lugar delas)
	for _, d in holder:GetChildren() do
		if d:IsA("BasePart") and d ~= root and d.Name ~= "Glow" then
			d.Transparency = 1
		end
	end
	return true
end

local function rarityColor(rarity: string?): Color3
	for _, r in Config.Rarities do
		if r.Id == rarity then
			return r.Color
		end
	end
	return Config.Rarities[1].Color
end
WeaponBuilder.RarityColor = rarityColor

--[[ Monta a arma. Devolve (model, handle, muzzleAttachment).
	O Handle fica no lugar da mão; o cano aponta para -Z. ]]
function WeaponBuilder.Weapon(id: string, rarity: string?): (Model, BasePart, Attachment)
	local def = Config.Weapons[id] or Config.Weapons.Pistol
	local L = def.Length
	local accent = rarityColor(rarity)
	local model = Instance.new("Model")
	model.Name = id

	local handle = part(model, "Handle", Vector3.new(0.35, 0.8, 0.45), CFrame.new(0, -0.15, 0) * CFrame.Angles(math.rad(-15), 0, 0), DARK, Enum.Material.SmoothPlastic)
	local bodyLen = math.max(L * 0.45, 0.9)
	local bodyCenter = CFrame.new(0, 0.32, -bodyLen * 0.35)
	local body = part(model, "Body", Vector3.new(0.4, 0.42, bodyLen), bodyCenter, def.Color, Enum.Material.Metal)
	local barrelLen = math.max(L - bodyLen * 0.85 - (if id == "Pistol" then 0 else 0.6), 0.5)
	local barrelZ = body.Position.Z - bodyLen / 2 - barrelLen / 2 + 0.05
	tube(model, "Barrel", barrelLen, if id == "Shotgun" then 0.32 else 0.2, CFrame.new(0, 0.38, barrelZ), DARK, Enum.Material.Metal)
	-- faixa colorida da raridade
	part(model, "Glow", Vector3.new(0.42, 0.08, bodyLen * 0.7), bodyCenter * CFrame.new(0, 0.12, 0), accent, Enum.Material.Neon)

	if id ~= "Pistol" then
		-- coronha
		part(model, "Stock", Vector3.new(0.3, 0.45, 0.9), CFrame.new(0, 0.18, 0.55), def.Color, Enum.Material.Metal)
		-- pente
		local magH = if id == "Shotgun" then 0.25 else 0.75
		part(model, "Mag", Vector3.new(0.26, magH, 0.34), CFrame.new(0, 0.32 - 0.2 - magH / 2, body.Position.Z - bodyLen * 0.15) * CFrame.Angles(math.rad(10), 0, 0), DARK)
		-- guarda-mão
		part(model, "Handguard", Vector3.new(0.34, 0.3, math.min(barrelLen * 0.6, 1.4)), CFrame.new(0, 0.33, barrelZ + barrelLen * 0.15), def.Color, Enum.Material.Metal)
	end
	if id == "Rifle" or id == "Sniper" then
		-- luneta
		tube(model, "Scope", if id == "Sniper" then 1.4 else 0.8, if id == "Sniper" then 0.3 else 0.24, CFrame.new(0, 0.72, body.Position.Z), DARK, Enum.Material.Metal)
		part(model, "Lens", Vector3.new(0.2, 0.2, 0.04), CFrame.new(0, 0.72, body.Position.Z - (if id == "Sniper" then 0.71 else 0.41)), Color3.fromRGB(80, 180, 255), Enum.Material.Glass)
	end

	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.Position = handle.CFrame:PointToObjectSpace(Vector3.new(0, 0.38, barrelZ - barrelLen / 2 - 0.1))
	muzzle.Parent = handle

	try3D(id, model, handle, L, CFrame.new(0, 0.3, -L * 0.3))
	weldAll(model, handle)
	model.PrimaryPart = handle
	return model, handle, muzzle
end

-- Curas e munição (para segurar na mão ou para o loot no chão)
function WeaponBuilder.Item(id: string): (Model, BasePart)
	local model = Instance.new("Model")
	model.Name = id
	local handle: BasePart
	if id == "Bandage" then
		handle = part(model, "Handle", Vector3.new(0.6, 0.6, 0.6), CFrame.new(), Color3.fromRGB(235, 230, 215), Enum.Material.Fabric, Enum.PartType.Cylinder)
		part(model, "Stripe", Vector3.new(0.62, 0.62, 0.15), CFrame.new(), Color3.fromRGB(200, 60, 60), Enum.Material.Fabric, Enum.PartType.Cylinder)
	elseif id == "Medkit" then
		handle = part(model, "Handle", Vector3.new(1.2, 0.8, 0.45), CFrame.new(), Color3.fromRGB(220, 50, 55), Enum.Material.SmoothPlastic)
		part(model, "CrossA", Vector3.new(0.5, 0.14, 0.47), CFrame.new(), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
		part(model, "CrossB", Vector3.new(0.14, 0.5, 0.47), CFrame.new(), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
		part(model, "Grip", Vector3.new(0.5, 0.15, 0.15), CFrame.new(0, 0.47, 0), DARK)
	elseif id == "ShieldCell" then
		handle = part(model, "Handle", Vector3.new(0.9, 0.5, 0.5), CFrame.new(), Color3.fromRGB(40, 45, 60), Enum.Material.Metal, Enum.PartType.Cylinder)
		part(model, "Glow", Vector3.new(0.6, 0.42, 0.42), CFrame.new(), Color3.fromRGB(70, 160, 255), Enum.Material.Neon, Enum.PartType.Cylinder)
		model:PivotTo(CFrame.Angles(0, 0, math.rad(90)))
	else
		-- caixa de munição (id = tipo de munição)
		local ammo = Config.AmmoTypes[id]
		handle = part(model, "Handle", Vector3.new(0.9, 0.6, 0.6), CFrame.new(), Color3.fromRGB(70, 75, 60), Enum.Material.Metal)
		part(model, "Glow", Vector3.new(0.92, 0.15, 0.62), CFrame.new(0, 0.15, 0), if ammo then ammo.Color else Color3.new(1, 1, 1), Enum.Material.Neon)
		try3D("Ammo", model, handle, 0.9, CFrame.new())
		weldAll(model, handle)
		model.PrimaryPart = handle
		return model, handle
	end
	try3D(id, model, handle, 1.2, CFrame.new())
	weldAll(model, handle)
	model.PrimaryPart = handle
	return model, handle
end

return WeaponBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">ZoneMath</string>
          <string name="Source"><![CDATA[-- ZoneMath: calcula onde a zona está agora (o servidor e as telas usam a mesma conta).
-- Atributos do Workspace: ZoneCX, ZoneCZ, ZoneR (círculo antigo), ZoneNCX, ZoneNCZ, ZoneNR (próximo),
-- ZoneShrinkStart, ZoneShrinkEnd (hora do servidor), ZoneStage (fase atual, 0 = sem zona).
local ZoneMath = {}

function ZoneMath.Current(now: number?): (number, number, number)
	local w = workspace
	local t = now or w:GetServerTimeNow()
	local cx, cz, r = w:GetAttribute("ZoneCX") or 0, w:GetAttribute("ZoneCZ") or 0, w:GetAttribute("ZoneR") or 0
	local ncx, ncz, nr = w:GetAttribute("ZoneNCX") or cx, w:GetAttribute("ZoneNCZ") or cz, w:GetAttribute("ZoneNR") or r
	local s, e = w:GetAttribute("ZoneShrinkStart") or 0, w:GetAttribute("ZoneShrinkEnd") or 0
	if t <= s or e <= s then
		return cx, cz, r
	end
	local a = math.clamp((t - s) / (e - s), 0, 1)
	return cx + (ncx - cx) * a, cz + (ncz - cz) * a, r + (nr - r) * a
end

function ZoneMath.Next(): (number, number, number)
	local w = workspace
	return w:GetAttribute("ZoneNCX") or 0, w:GetAttribute("ZoneNCZ") or 0, w:GetAttribute("ZoneNR") or 0
end

function ZoneMath.IsInside(position: Vector3, now: number?): boolean
	if (workspace:GetAttribute("ZoneStage") or 0) <= 0 then
		return true
	end
	local cx, cz, r = ZoneMath.Current(now)
	local dx, dz = position.X - cx, position.Z - cz
	return dx * dx + dz * dz <= r * r
end

return ZoneMath
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="12">
      <Properties>
        <string name="Name">Models3D</string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">Game</string>
      </Properties>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Bots</string>
          <string name="Source"><![CDATA[--[[
	Bots: completam a partida quando tem pouca gente online (Config.Match.FillWithBots).
	Cada bot é um avatar R15 padrão do Roblox com uma arma, que:
	  • anda pelo mapa (PathfindingService) e fica dentro da próxima zona
	  • quando vê alguém (linha de visão), espera um tempo de reação e atira em rajadas, errando um pouco
	Os tiros usam o mesmo Combat.Shoot dos jogadores (mesmo dano, mesmas regras).
]]

local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local WeaponBuilder = require(ReplicatedStorage.Shared.WeaponBuilder)
local ZoneMath = require(ReplicatedStorage.Shared.ZoneMath)
local Registry = require(script.Parent.Registry)

local Bots = {}

local rng = Random.new()
local folder: Folder
local SKIN = {
	Color3.fromRGB(255, 205, 170), Color3.fromRGB(234, 184, 146), Color3.fromRGB(198, 140, 100),
	Color3.fromRGB(160, 105, 70), Color3.fromRGB(110, 70, 45),
}
local SHIRT = {
	Color3.fromRGB(70, 80, 60), Color3.fromRGB(40, 45, 55), Color3.fromRGB(120, 90, 60),
	Color3.fromRGB(90, 30, 30), Color3.fromRGB(30, 60, 90), Color3.fromRGB(60, 60, 60),
}

local function between(range: { number }): number
	return rng:NextNumber(range[1], range[2])
end

-- Avatar R15 padrão; se o Roblox não deixar criar, monta um boneco simples de peças
local function buildBody(name: string): Model
	local skin = SKIN[rng:NextInteger(1, #SKIN)]
	local shirt = SHIRT[rng:NextInteger(1, #SHIRT)]
	local pants = SHIRT[rng:NextInteger(1, #SHIRT)]
	local ok, model = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		desc.HeadColor = skin
		desc.LeftArmColor = skin
		desc.RightArmColor = skin
		desc.TorsoColor = shirt
		desc.LeftLegColor = pants
		desc.RightLegColor = pants
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and model then
		model.Name = name
		local animate = model:FindFirstChild("Animate")
		if animate then
			animate:Destroy() -- o Animate é para jogadores; os bots tocam as animações pelo servidor
		end
		return model
	end
	-- plano B: boneco de peças (sem animação)
	local rig = Instance.new("Model")
	rig.Name = name
	local function p(partName, size, offset, color)
		local part = Instance.new("Part")
		part.Name = partName
		part.Size = size
		part.Color = color
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.CFrame = CFrame.new(offset)
		part.Parent = rig
		return part
	end
	local root = p("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), shirt)
	root.Transparency = 1
	local parts = {
		p("Torso", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), shirt),
		p("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 4.6, 0), skin),
		p("Left Arm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 3, 0), skin),
		p("Right Arm", Vector3.new(1, 2, 1), Vector3.new(1.5, 3, 0), skin),
		p("Left Leg", Vector3.new(1, 2, 1), Vector3.new(-0.5, 1, 0), pants),
		p("Right Leg", Vector3.new(1, 2, 1), Vector3.new(0.5, 1, 0), pants),
	}
	for _, part in parts do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.HipHeight = 0
	humanoid.Parent = rig
	rig.PrimaryPart = root
	return rig
end

local function attachWeapon(entry: any)
	local model = entry.Model
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local weapon, handle, muzzle = WeaponBuilder.Weapon(entry.Weapon, entry.Rarity)
	weapon:PivotTo(root.CFrame * CFrame.new(0.9, 0.5, -1.1))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = handle
	weld.Parent = handle
	weapon.Parent = model
	entry.Muzzle = muzzle
	-- braço direito levantado segurando a arma
	local upper = model:FindFirstChild("RightUpperArm")
	local shoulder = upper and upper:FindFirstChild("RightShoulder")
	if shoulder and shoulder:IsA("Motor6D") then
		shoulder.C0 = shoulder.C0 * CFrame.Angles(math.rad(80), 0, 0)
	end
end

-- Um ponto no chão perto do centro (usa os LootSpots do mapa, que estão sempre no chão)
function Bots.GroundPoint(center: Vector3): Vector3
	local map = workspace:FindFirstChild("Map")
	local spots = map and map:FindFirstChild("LootSpots")
	local list = {}
	if spots then
		for _, spot in spots:GetChildren() do
			if spot:IsA("BasePart") then
				local dx, dz = spot.Position.X - center.X, spot.Position.Z - center.Z
				if dx * dx + dz * dz < (Config.Zone.StartRadius * 0.8) ^ 2 then
					table.insert(list, spot.Position)
				end
			end
		end
	end
	if #list > 0 then
		return list[rng:NextInteger(1, #list)] + Vector3.new(rng:NextNumber(-4, 4), 4, rng:NextNumber(-4, 4))
	end
	return center + Vector3.new(rng:NextNumber(-200, 200), 6, rng:NextNumber(-200, 200))
end

---------------------------------------------------------------------
-- Inteligência
---------------------------------------------------------------------
local function headOf(model: Model): BasePart?
	return model:FindFirstChild("Head") :: BasePart?
end

local function canSee(entry: any, target: any): boolean
	local myHead, theirHead = headOf(entry.Model), headOf(target.Model)
	if not myHead or not theirHead then
		return false
	end
	local delta = theirHead.Position - myHead.Position
	if delta.Magnitude > Config.Bots.SightRange then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = { entry.Model }
	local loot = workspace:FindFirstChild("Loot")
	if loot then
		table.insert(exclude, loot)
	end
	params.FilterDescendantsInstances = exclude
	local result = workspace:Raycast(myHead.Position, delta, params)
	return result ~= nil and result.Instance:IsDescendantOf(target.Model)
end

local function findTarget(entry: any): any
	local best, bestDist = nil, math.huge
	local myRoot = entry.Model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not myRoot then
		return nil
	end
	for _, other in Registry.Match.AliveEntries() do
		if other ~= entry and other.Model then
			local root = other.Model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local dist = (root.Position - myRoot.Position).Magnitude
				if dist < bestDist and dist <= Config.Bots.SightRange and canSee(entry, other) then
					best, bestDist = other, dist
				end
			end
		end
	end
	return best
end

-- Escolhe um destino dentro da próxima zona
local function wanderPoint(): Vector3
	local cx, cz, r = ZoneMath.Next()
	if (workspace:GetAttribute("ZoneStage") or 0) <= 0 or r <= 0 then
		cx, cz, r = 0, 0, Config.Zone.StartRadius
	end
	local angle = rng:NextNumber() * math.pi * 2
	local dist = math.sqrt(rng:NextNumber()) * math.max(r * 0.7, 4)
	return Vector3.new(cx + math.cos(angle) * dist, 0, cz + math.sin(angle) * dist)
end

local function computePath(from: Vector3, to: Vector3): { PathWaypoint }?
	local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 8 })
	local ok = pcall(function()
		path:ComputeAsync(from, to)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		return path:GetWaypoints()
	end
	return nil
end

local function run(entry: any)
	local model = entry.Model
	local humanoid = entry.Humanoid :: Humanoid
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local def = Config.Weapons[entry.Weapon]
	local waypoints: { PathWaypoint }? = nil
	local wpIndex = 1
	local lastPos = root.Position
	local lastMoveCheck = os.clock()
	local target, seenAt = nil, 0
	local nextShot, burstLeft = 0, 0

	-- animações
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	local tracks = {}
	for key, id in Config.BotAnimations do
		local ok, track = pcall(function()
			local anim = Instance.new("Animation")
			anim.AnimationId = id
			return animator:LoadAnimation(anim)
		end)
		if ok and track then
			tracks[key] = track
		end
	end
	local playing = nil
	local function play(key: string)
		if playing == key then
			return
		end
		if playing and tracks[playing] then
			tracks[playing]:Stop(0.2)
		end
		playing = key
		if tracks[key] then
			tracks[key]:Play(0.2)
		end
	end

	while entry.Alive and model.Parent and humanoid.Health > 0 do
		task.wait(0.15)
		if Registry.Match.Phase() ~= "Match" then
			humanoid:MoveTo(root.Position)
			play("Idle")
			continue
		end
		local now = os.clock()
		play(if root.AssemblyLinearVelocity.Magnitude > 2 then "Run" else "Idle")

		-- alvo
		if not target or not target.Alive or now - seenAt > 1.2 then
			local found = findTarget(entry)
			if found and found ~= target then
				target = found
				nextShot = now + between(Config.Bots.ReactionTime)
				burstLeft = rng:NextInteger(Config.Bots.BurstShots[1], Config.Bots.BurstShots[2])
			end
			if found then
				seenAt = now
			else
				target = nil
			end
		elseif canSee(entry, target) then
			seenAt = now
		end

		if target and target.Model then
			local targetRoot = target.Model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if targetRoot then
				-- vira para o alvo e anda de lado
				humanoid.AutoRotate = false
				local flat = Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z)
				root.CFrame = CFrame.lookAt(root.Position, flat)
				local dist = (targetRoot.Position - root.Position).Magnitude
				local side = root.CFrame.RightVector * (if math.floor(now / 1.5) % 2 == 0 then 6 else -6)
				local forward = if dist > def.Falloff then root.CFrame.LookVector * 6 else Vector3.zero
				humanoid:MoveTo(root.Position + side + forward)
				waypoints = nil
				-- atira
				if now >= nextShot then
					local head = headOf(model)
					if head and canSee(entry, target) then
						local aim = targetRoot.Position + Vector3.new(0, rng:NextNumber(-0.5, 1.6), 0)
						Registry.Combat.Shoot(entry, head.Position, aim, entry.Weapon, entry.Rarity, false, if entry.Muzzle then entry.Muzzle.WorldPosition else head.Position, Config.Bots.AccuracyDegrees)
					end
					burstLeft -= 1
					if burstLeft <= 0 then
						burstLeft = rng:NextInteger(Config.Bots.BurstShots[1], Config.Bots.BurstShots[2])
						nextShot = now + between(Config.Bots.BurstPause)
					else
						nextShot = now + math.max(60 / def.Rpm, 0.12)
					end
				end
				continue
			end
		end
		humanoid.AutoRotate = true

		-- andar: segue o caminho até um ponto dentro da próxima zona
		local outsideNext = false
		do
			local cx, cz, r = ZoneMath.Next()
			local dx, dz = root.Position.X - cx, root.Position.Z - cz
			outsideNext = (workspace:GetAttribute("ZoneStage") or 0) > 0 and dx * dx + dz * dz > r * r
		end
		if not waypoints or wpIndex > #waypoints or (outsideNext and rng:NextNumber() < 0.05) then
			local goal = wanderPoint()
			waypoints = computePath(root.Position, Vector3.new(goal.X, root.Position.Y, goal.Z))
			wpIndex = 2
			if not waypoints then
				humanoid:MoveTo(Vector3.new(goal.X, root.Position.Y, goal.Z))
				waypoints = {}
			end
		end
		if waypoints and waypoints[wpIndex] then
			local wp = waypoints[wpIndex]
			if wp.Action == Enum.PathWaypointAction.Jump then
				humanoid.Jump = true
			end
			humanoid:MoveTo(wp.Position)
			if (Vector3.new(wp.Position.X, 0, wp.Position.Z) - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude < 4 then
				wpIndex += 1
			end
		end
		-- travou: pula e escolhe outro caminho
		if now - lastMoveCheck > 2 then
			if (root.Position - lastPos).Magnitude < 1.5 then
				humanoid.Jump = true
				waypoints = nil
			end
			lastPos = root.Position
			lastMoveCheck = now
		end
	end
	play("Idle")
end

function Bots.Spawn(entry: any, position: Vector3)
	local model = buildBody(entry.Name)
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayName = entry.Name
	humanoid.MaxHealth = Config.Bots.Health
	humanoid.Health = Config.Bots.Health
	humanoid.WalkSpeed = Config.Bots.WalkSpeed
	humanoid.BreakJointsOnDeath = false
	humanoid.NameDisplayDistance = 60
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	model:SetAttribute("Shield", 0)
	model:SetAttribute("IsBot", true)
	model:PivotTo(CFrame.new(position))
	model.Parent = folder
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	pcall(function()
		root:SetNetworkOwner(nil) -- o servidor controla o bot
	end)
	entry.Model = model
	entry.Humanoid = humanoid
	entry.Weapon = Config.Bots.Weapons[rng:NextInteger(1, #Config.Bots.Weapons)]
	entry.Rarity = Registry.Loot.RandomRarity()
	attachWeapon(entry)
	task.spawn(function()
		local ok, err = pcall(run, entry)
		if not ok then
			warn("[Bots] erro na IA de " .. entry.Name .. ":", err)
		end
	end)
end

-- O que o bot deixa cair ao morrer
function Bots.DropLoot(entry: any, position: Vector3)
	local items = {
		{ Kind = "Weapon", Id = entry.Weapon, Rarity = entry.Rarity },
		{ Kind = "Ammo", Id = Config.Weapons[entry.Weapon].Ammo },
	}
	if rng:NextNumber() < 0.5 then
		table.insert(items, { Kind = "Item", Id = if rng:NextNumber() < 0.5 then "Bandage" else "ShieldCell" })
	end
	Registry.Loot.DropList(items, position)
	-- o corpo some depois de um tempo
	local model = entry.Model
	task.delay(6, function()
		if model and model.Parent then
			model:Destroy()
		end
	end)
end

function Bots.Cleanup()
	for _, child in folder:GetChildren() do
		child:Destroy()
	end
end

function Bots.Init()
	folder = Instance.new("Folder")
	folder.Name = "Bots"
	folder.Parent = workspace
end

return Bots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Combat</string>
          <string name="Source"><![CDATA[--[[
	Combat: armas (Tools), tiros, dano, escudo, recarga e curas. TUDO é decidido no servidor:
	o jogador só manda "atirei mirando aqui"; o servidor confere a arma, a munição, a cadência,
	faz o próprio raycast a partir da cabeça do personagem e aplica o dano.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local WeaponBuilder = require(ReplicatedStorage.Shared.WeaponBuilder)
local Registry = require(script.Parent.Registry)

local Combat = {}

local lastShot: { [any]: number } = {}
local reloading: { [Player]: boolean } = {}
local lastAttacker: { [Humanoid]: { Entry: any, Time: number } } = {}

local rng = Random.new()

local function rarityMultiplier(rarity: string?): number
	for _, r in Config.Rarities do
		if r.Id == rarity then
			return r.Damage
		end
	end
	return 1
end

local function broadcast(kind: string, data: any)
	Registry.Remotes.Effect:FireAllClients(kind, data)
end

local function finite(v: Vector3): boolean
	return v.X == v.X and v.Y == v.Y and v.Z == v.Z and math.abs(v.X) < 1e6 and math.abs(v.Y) < 1e6 and math.abs(v.Z) < 1e6
end

-- Direção com imprecisão aleatória dentro de um cone (graus)
local function spreadDirection(direction: Vector3, degrees: number): Vector3
	if degrees <= 0 then
		return direction
	end
	local angle = math.rad(degrees) * math.sqrt(rng:NextNumber())
	local spin = rng:NextNumber() * math.pi * 2
	local cf = CFrame.lookAt(Vector3.zero, direction)
	return (cf * CFrame.Angles(0, 0, spin) * CFrame.Angles(angle, 0, 0)).LookVector
end

---------------------------------------------------------------------
-- Ferramentas (o que vai para a mochila do jogador)
---------------------------------------------------------------------
function Combat.MakeWeaponTool(id: string, rarity: string, mag: number?): Tool
	local def = Config.Weapons[id]
	local tool = Instance.new("Tool")
	tool.Name = id
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = id .. " (" .. rarity .. ")"
	tool:SetAttribute("WeaponId", id)
	tool:SetAttribute("Rarity", rarity)
	tool:SetAttribute("Mag", math.clamp(mag or def.Mag, 0, def.Mag))
	local model = WeaponBuilder.Weapon(id, rarity)
	for _, child in model:GetChildren() do
		child.Parent = tool
	end
	model:Destroy()
	tool.Grip = CFrame.new(0, -0.1, 0.15)
	return tool
end

function Combat.MakeItemTool(id: string, count: number): Tool
	local tool = Instance.new("Tool")
	tool.Name = id
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("ItemId", id)
	tool:SetAttribute("Count", count)
	local model = WeaponBuilder.Item(id)
	for _, child in model:GetChildren() do
		child.Parent = tool
	end
	model:Destroy()
	tool.Activated:Connect(function()
		local player = Players:GetPlayerFromCharacter(tool.Parent)
		if player then
			Combat.UseItem(player, tool)
		end
	end)
	return tool
end

function Combat.PlayerTools(player: Player): { Tool }
	local list = {}
	for _, container in { player:FindFirstChildOfClass("Backpack"), player.Character } do
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") then
					table.insert(list, child)
				end
			end
		end
	end
	return list
end

function Combat.WeaponCount(player: Player): number
	local n = 0
	for _, tool in Combat.PlayerTools(player) do
		if tool:GetAttribute("WeaponId") then
			n += 1
		end
	end
	return n
end

-- Junta a cura com uma que o jogador já tem (pilha) ou cria uma nova
function Combat.GiveItem(player: Player, id: string, count: number)
	for _, tool in Combat.PlayerTools(player) do
		if tool:GetAttribute("ItemId") == id then
			tool:SetAttribute("Count", (tool:GetAttribute("Count") or 0) + count)
			return
		end
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		Combat.MakeItemTool(id, count).Parent = backpack
	end
end

function Combat.AddAmmo(player: Player, ammoType: string, amount: number): number
	local info = Config.AmmoTypes[ammoType]
	if not info then
		return 0
	end
	local key = "Ammo_" .. ammoType
	local current = player:GetAttribute(key) or 0
	local added = math.max(0, math.min(amount, info.Max - current))
	player:SetAttribute(key, current + added)
	return added
end

function Combat.ResetPlayer(player: Player)
	for ammoType in Config.AmmoTypes do
		player:SetAttribute("Ammo_" .. ammoType, 0)
	end
	reloading[player] = nil
	player:SetAttribute("Using", nil)
end

---------------------------------------------------------------------
-- Dano
---------------------------------------------------------------------
function Combat.LastAttacker(humanoid: Humanoid): any
	local info = lastAttacker[humanoid]
	if info and os.clock() - info.Time < 30 then
		return info.Entry
	end
	return nil
end

-- Aplica dano: primeiro no escudo (atributo "Shield" do personagem), depois na vida
function Combat.Damage(victim: any, amount: number, attacker: any?, ignoreShield: boolean?)
	local humanoid: Humanoid = victim.Humanoid
	if not humanoid or humanoid.Health <= 0 or amount <= 0 then
		return
	end
	local model = victim.Model
	if not ignoreShield then
		local shield = model:GetAttribute("Shield") or 0
		if shield > 0 then
			local absorbed = math.min(shield, amount)
			model:SetAttribute("Shield", shield - absorbed)
			amount -= absorbed
		end
	end
	if attacker then
		lastAttacker[humanoid] = { Entry = attacker, Time = os.clock() }
	end
	if amount > 0 then
		humanoid.Health = math.max(0, humanoid.Health - amount)
	end
	-- usar uma cura é cancelado ao levar dano de outro jogador
	if attacker and victim.Player then
		victim.Player:SetAttribute("Using", nil)
	end
end

--[[ Dispara a arma de "shooter" (entrada da partida: jogador ou bot).
	origin = de onde sai o raio (cabeça); aimPoint = para onde mirou; extraSpread = erro extra (bots). ]]
function Combat.Shoot(shooter: any, origin: Vector3, aimPoint: Vector3, weaponId: string, rarity: string?, aiming: boolean, muzzle: Vector3, extraSpread: number?)
	local def = Config.Weapons[weaponId]
	if not def then
		return
	end
	local Match = Registry.Match
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = { shooter.Model }
	local loot = workspace:FindFirstChild("Loot")
	if loot then
		table.insert(exclude, loot)
	end
	params.FilterDescendantsInstances = exclude
	params.IgnoreWater = true

	local baseDir = aimPoint - origin
	if baseDir.Magnitude < 0.01 then
		return
	end
	baseDir = baseDir.Unit
	local spread = def.Spread * (if aiming then def.AimSpread else 1) + (extraSpread or 0)
	local damageBy: { [any]: { Amount: number, Head: boolean } } = {}
	local ends = {}
	for _ = 1, def.Pellets do
		local dir = spreadDirection(baseDir, spread)
		local result = workspace:Raycast(origin, dir * def.Range, params)
		local hitPos = if result then result.Position else origin + dir * def.Range
		table.insert(ends, hitPos)
		if result then
			local model = result.Instance:FindFirstAncestorOfClass("Model")
			local victim = model and Match.EntryFromModel(model)
			if victim and victim ~= shooter and victim.Alive then
				local distance = (hitPos - origin).Magnitude
				local falloff = if distance <= def.Falloff then 1 else math.max(0.6, 1 - (distance - def.Falloff) / math.max(def.Range - def.Falloff, 1) * 0.4)
				local head = result.Instance.Name == "Head"
				local amount = def.Damage * rarityMultiplier(rarity) * falloff * (if head then def.Headshot else 1)
				local acc = damageBy[victim] or { Amount = 0, Head = false }
				acc.Amount += amount
				acc.Head = acc.Head or head
				damageBy[victim] = acc
			end
		end
	end
	-- efeito do tiro para todos (o próprio atirador já desenhou o dele na hora)
	broadcast("Shot", { From = muzzle, Ends = ends, W = weaponId, S = if shooter.Player then shooter.Player.UserId else 0 })
	for victim, acc in damageBy do
		local before = victim.Humanoid.Health
		Combat.Damage(victim, acc.Amount, shooter)
		local killed = before > 0 and victim.Humanoid.Health <= 0
		if shooter.Player then
			Registry.Remotes.Effect:FireClient(shooter.Player, "Hit", { Head = acc.Head, Kill = killed, Damage = math.floor(acc.Amount + 0.5) })
		end
		if victim.Player then
			Registry.Remotes.Effect:FireClient(victim.Player, "Damaged", { From = origin })
		end
	end
end

---------------------------------------------------------------------
-- Recarregar
---------------------------------------------------------------------
function Combat.Reload(player: Player)
	if reloading[player] then
		return
	end
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	local id = tool and tool:GetAttribute("WeaponId")
	local def = id and Config.Weapons[id]
	if not tool or not def then
		return
	end
	local mag = tool:GetAttribute("Mag") or 0
	local key = "Ammo_" .. def.Ammo
	if mag >= def.Mag or (player:GetAttribute(key) or 0) <= 0 then
		return
	end
	reloading[player] = true
	tool:SetAttribute("Reloading", true)
	task.delay(def.Reload, function()
		reloading[player] = nil
		if tool.Parent then
			tool:SetAttribute("Reloading", nil)
		end
		-- trocou de arma ou morreu no meio: cancela
		if not player.Parent or tool.Parent ~= player.Character then
			return
		end
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			return
		end
		local current = tool:GetAttribute("Mag") or 0
		local reserve = player:GetAttribute(key) or 0
		local take = math.min(def.Mag - current, reserve)
		tool:SetAttribute("Mag", current + take)
		player:SetAttribute(key, reserve - take)
	end)
end

---------------------------------------------------------------------
-- Curas
---------------------------------------------------------------------
function Combat.UseItem(player: Player, tool: Tool)
	local id = tool:GetAttribute("ItemId")
	local def = id and Config.Items[id]
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not def or not humanoid or humanoid.Health <= 0 or player:GetAttribute("Using") then
		return
	end
	local entry = Registry.Match.EntryFor(player)
	if not entry or not entry.Alive then
		return
	end
	if def.Heal and humanoid.Health >= def.MaxHeal then
		Registry.Remotes.NotifyPlayer(player, "HEALTH_FULL")
		return
	end
	if def.Shield and (character:GetAttribute("Shield") or 0) >= Config.Player.MaxShield then
		Registry.Remotes.NotifyPlayer(player, "SHIELD_FULL")
		return
	end
	player:SetAttribute("Using", id)
	player:SetAttribute("UseEnds", workspace:GetServerTimeNow() + def.UseTime)
	local started = os.clock()
	while os.clock() - started < def.UseTime do
		task.wait(0.1)
		-- cancelou (guardou a cura, levou tiro, morreu)
		if player:GetAttribute("Using") ~= id or tool.Parent ~= player.Character or humanoid.Health <= 0 then
			if player:GetAttribute("Using") == id then
				player:SetAttribute("Using", nil)
			end
			return
		end
	end
	if player:GetAttribute("Using") ~= id then
		return
	end
	player:SetAttribute("Using", nil)
	if def.Heal then
		humanoid.Health = math.max(humanoid.Health, math.min(def.MaxHeal, humanoid.Health + def.Heal))
	end
	if def.Shield then
		character:SetAttribute("Shield", math.min(Config.Player.MaxShield, (character:GetAttribute("Shield") or 0) + def.Shield))
	end
	local count = (tool:GetAttribute("Count") or 1) - 1
	if count <= 0 then
		tool:Destroy()
	else
		tool:SetAttribute("Count", count)
	end
end

---------------------------------------------------------------------
function Combat.Init()
	local Remotes = Registry.Remotes
	Remotes.Fire.OnServerEvent:Connect(function(player: Player, aimPoint: any, aiming: any)
		if typeof(aimPoint) ~= "Vector3" or not finite(aimPoint) then
			return
		end
		local entry = Registry.Match.EntryFor(player)
		local character = player.Character
		local tool = character and character:FindFirstChildOfClass("Tool")
		local id = tool and tool:GetAttribute("WeaponId")
		local def = id and Config.Weapons[id]
		local head = character and character:FindFirstChild("Head") :: BasePart?
		if not entry or not entry.Alive or not def or not head or reloading[player] or player:GetAttribute("Using") then
			return
		end
		local now = os.clock()
		if now - (lastShot[player] or 0) < 60 / def.Rpm * 0.85 then
			return -- mais rápido que a arma permite
		end
		local mag = tool:GetAttribute("Mag") or 0
		if mag <= 0 then
			return
		end
		lastShot[player] = now
		tool:SetAttribute("Mag", mag - 1)
		local handle = tool:FindFirstChild("Handle") :: BasePart?
		local muzzleAtt = handle and handle:FindFirstChild("Muzzle") :: Attachment?
		local muzzle = if muzzleAtt then muzzleAtt.WorldPosition else head.Position
		Combat.Shoot(entry, head.Position, aimPoint, id, tool:GetAttribute("Rarity"), aiming == true, muzzle)
	end)
	Remotes.Reload.OnServerEvent:Connect(function(player: Player)
		Combat.Reload(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastShot[player] = nil
		reloading[player] = nil
	end)
	-- limpa o "último atacante" de quem já não existe
	task.spawn(function()
		while true do
			task.wait(30)
			for humanoid in lastAttacker do
				if not humanoid.Parent then
					lastAttacker[humanoid] = nil
				end
			end
		end
	end)
end

return Combat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[--[[
	Data: salva e carrega o progresso (mesma base segura do Steal a Critter):
	  • UpdateAsync com trava de sessão (dois servidores nunca mexem nos dados do mesmo jogador)
	  • várias tentativas quando o Roblox falha
	  • salva ao sair, a cada 60 s e quando o servidor fecha
	  • se o carregamento falhar, NÃO salva por cima (o progresso antigo fica seguro)
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local Data = {}

export type Profile = {
	Data: any,
	CanSave: boolean,
	Saving: boolean,
	Final: boolean,
}

local SESSION_TIMEOUT = 150

local profiles: { [Player]: Profile } = {}
local finalSaving: { [number]: boolean } = {}
local activeSaves = 0

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Data] DataStore indisponível:", result)
	end
end

local function defaultData()
	return {
		XP = 0,
		Level = 1,
		Wins = 0,
		Kills = 0,
		Deaths = 0,
		Matches = 0,
		BestPlace = 0,
		SaveSeq = 0,
	}
end

local function reconcile(data: any)
	for key, value in defaultData() do
		if data[key] == nil then
			data[key] = value
		end
	end
	return data
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function lockedByOther(value: any): boolean
	if type(value) ~= "table" or type(value.Session) ~= "table" then
		return false
	end
	local session = value.Session
	return session.JobId ~= game.JobId and os.time() - (tonumber(session.Time) or 0) < SESSION_TIMEOUT
end

function Data.Load(player: Player): Profile
	-- quem saiu e voltou no MESMO servidor espera o save da saída terminar
	local waited = 0
	while finalSaving[player.UserId] and waited < 40 and player.Parent do
		waited += task.wait(0.25)
	end
	local loaded, result = false, nil
	if store then
		local attempts = 6
		for attempt = 1, attempts do
			if not player.Parent then
				break
			end
			local locked = false
			local ok, err = pcall(function()
				(store :: DataStore):UpdateAsync(keyFor(player), function(old)
					if lockedByOther(old) and attempt < attempts then
						locked = true
						return nil
					end
					locked = false
					local data = reconcile(if type(old) == "table" then old else defaultData())
					data.Session = { JobId = game.JobId, Time = os.time() }
					result = data
					return data, { player.UserId }
				end)
			end)
			if ok and not locked then
				loaded = true
				break
			end
			if not ok then
				warn(("[Data] Falha ao carregar %s (tentativa %d): %s"):format(player.Name, attempt, tostring(err)))
				if RunService:IsStudio() then
					break
				end
			end
			task.wait(if locked then 3 else 2)
		end
	end
	local profile: Profile = {
		Data = if loaded and result then result else defaultData(),
		CanSave = loaded,
		Saving = false,
		Final = false,
	}
	profiles[player] = profile
	if not loaded then
		warn("[Data] O progresso de " .. player.Name .. " NÃO será salvo nesta sessão.")
	end
	return profile
end

function Data.Get(player: Player): Profile?
	return profiles[player]
end

function Data.ActiveSaves(): number
	return activeSaves
end

function Data.Save(player: Player, isFinal: boolean?): boolean
	local profile = profiles[player]
	if not profile or not profile.CanSave or not store then
		return false
	end
	activeSaves += 1
	if isFinal then
		finalSaving[player.UserId] = true
	end
	local waited = 0
	local limit = if isFinal then 30 else 15
	while profile.Saving and waited < limit do
		waited += task.wait(0.1)
	end
	if profile.Final or not profile.CanSave or (profile.Saving and not isFinal) then
		if isFinal and not profile.Saving then
			finalSaving[player.UserId] = nil
		end
		activeSaves -= 1
		return false
	end
	profile.Saving = true
	if isFinal then
		profile.Final = true
	end
	profile.Data.SaveSeq = (tonumber(profile.Data.SaveSeq) or 0) + 1
	local snapshot = table.clone(profile.Data)

	local success, lostLock = false, false
	for attempt = 1, if isFinal then 5 else 3 do
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(keyFor(player), function(old)
				if lockedByOther(old) then
					lostLock = true
					return nil
				end
				lostLock = false
				if type(old) == "table" and (tonumber(old.SaveSeq) or 0) > snapshot.SaveSeq then
					return nil
				end
				snapshot.Session = if isFinal then nil else { JobId = game.JobId, Time = os.time() }
				return snapshot, { player.UserId }
			end)
		end)
		if ok then
			success = not lostLock
			break
		end
		warn(("[Data] Falha ao salvar %s (tentativa %d): %s"):format(player.Name, attempt, tostring(err)))
		task.wait(1)
	end
	if lostLock then
		profile.CanSave = false
		if player.Parent and not isFinal then
			player:Kick("Your progress was loaded in another server. Please rejoin!")
		end
	end
	profile.Saving = false
	if isFinal then
		finalSaving[player.UserId] = nil
	end
	activeSaves -= 1
	return success
end

function Data.Remove(player: Player)
	profiles[player] = nil
end

return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Loot</string>
          <string name="Source"><![CDATA[--[[
	Loot: armas, munição e curas no chão.
	O mapa tem peças invisíveis "LootSpot" (Workspace > Map > LootSpots); no começo da partida
	cada uma pode receber um item. Quem morre deixa tudo cair no chão.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Config = require(ReplicatedStorage.Shared.Config)
local WeaponBuilder = require(ReplicatedStorage.Shared.WeaponBuilder)
local Registry = require(script.Parent.Registry)

local Loot = {}

local rng = Random.new()
local folder: Folder

local function pickWeighted(list: { any }, weightKey: string): any
	local total = 0
	for _, item in list do
		total += item[weightKey]
	end
	local roll = rng:NextNumber() * total
	for _, item in list do
		roll -= item[weightKey]
		if roll <= 0 then
			return item
		end
	end
	return list[#list]
end

function Loot.RandomRarity(): string
	return pickWeighted(Config.Rarities, "Weight").Id
end

local function anchorAll(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		elseif d:IsA("WeldConstraint") then
			d:Destroy()
		end
	end
end

--[[ Cria um item no chão.
	info = { Kind = "Weapon"|"Ammo"|"Item", Id, Rarity?, Amount?, Mag? } ]]
function Loot.Spawn(info: any, position: Vector3): Model
	local model: Model
	local label: string
	if info.Kind == "Weapon" then
		info.Rarity = info.Rarity or Loot.RandomRarity()
		model = WeaponBuilder.Weapon(info.Id, info.Rarity)
		label = "W_" .. info.Id
	elseif info.Kind == "Ammo" then
		info.Amount = info.Amount or Config.AmmoTypes[info.Id].Pickup
		model = WeaponBuilder.Item(info.Id)
		label = "A_" .. info.Id
	else
		info.Amount = info.Amount or 1
		model = WeaponBuilder.Item(info.Id)
		label = "I_" .. info.Id
	end
	anchorAll(model)
	model:PivotTo(CFrame.new(position + Vector3.new(0, 1.4, 0)) * CFrame.Angles(0, rng:NextNumber() * math.pi * 2, 0))
	model:SetAttribute("Kind", info.Kind)
	model:SetAttribute("Id", info.Id)
	model:SetAttribute("Rarity", info.Rarity)
	model:SetAttribute("Amount", info.Amount)
	model:SetAttribute("Mag", info.Mag)
	model:SetAttribute("Label", label) -- chave do texto (a tela traduz)

	local root = model.PrimaryPart :: BasePart
	-- brilho no chão com a cor da raridade (ajuda a achar no escuro)
	local light = Instance.new("PointLight")
	light.Range = 6
	light.Brightness = 0.8
	light.Color = if info.Kind == "Weapon" then WeaponBuilder.RarityColor(info.Rarity) else Color3.fromRGB(255, 240, 200)
	light.Shadows = false
	light.Parent = root

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Pick up"
	prompt.ObjectText = info.Id
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = Config.Loot.PickupRange
	prompt.RequiresLineOfSight = false
	prompt.Parent = root
	prompt.Triggered:Connect(function(player)
		Loot.Take(player, model)
	end)

	CollectionService:AddTag(model, "Loot")
	model.Parent = folder
	return model
end

-- O jogador pegou um item do chão
function Loot.Take(player: Player, model: Model)
	if not model.Parent then
		return
	end
	local entry = Registry.Match.EntryFor(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not entry or not entry.Alive or not root or not model.PrimaryPart then
		return
	end
	if (root.Position - model.PrimaryPart.Position).Magnitude > Config.Loot.PickupRange + 4 then
		return
	end
	local Combat = Registry.Combat
	local kind, id = model:GetAttribute("Kind"), model:GetAttribute("Id")
	if kind == "Weapon" then
		local def = Config.Weapons[id]
		if not def then
			return
		end
		if Combat.WeaponCount(player) >= Config.Match.MaxWeapons then
			-- mochila cheia: troca pela arma que está na mão
			local held = character:FindFirstChildOfClass("Tool")
			if not held or not held:GetAttribute("WeaponId") then
				Registry.Remotes.NotifyPlayer(player, "BACKPACK_FULL", nil, "warning")
				return
			end
			Loot.Spawn({ Kind = "Weapon", Id = held:GetAttribute("WeaponId"), Rarity = held:GetAttribute("Rarity"), Mag = held:GetAttribute("Mag") }, root.Position + root.CFrame.LookVector * 2)
			held:Destroy()
		end
		local tool = Combat.MakeWeaponTool(id, model:GetAttribute("Rarity") or "Common", model:GetAttribute("Mag"))
		local backpack = player:FindFirstChildOfClass("Backpack")
		tool.Parent = backpack
		-- arma nova vai direto para a mão se a mão estiver vazia
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid and not character:FindFirstChildOfClass("Tool") then
			humanoid:EquipTool(tool)
		end
		-- vem com um pouco de munição de brinde
		Combat.AddAmmo(player, def.Ammo, math.floor(def.Mag / 2))
	elseif kind == "Ammo" then
		local amount = model:GetAttribute("Amount") or 0
		local added = Combat.AddAmmo(player, id, amount)
		if added <= 0 then
			Registry.Remotes.NotifyPlayer(player, "AMMO_FULL")
			return
		end
		if added < amount then
			model:SetAttribute("Amount", amount - added) -- o que não coube fica no chão
			return
		end
	elseif kind == "Item" then
		Combat.GiveItem(player, id, model:GetAttribute("Amount") or 1)
	else
		return
	end
	Registry.Remotes.Effect:FireClient(player, "Pickup", { Label = model:GetAttribute("Label") })
	model:Destroy()
end

-- Espalha o loot inicial nos LootSpots do mapa
function Loot.SpawnAll()
	Loot.Clear()
	local map = workspace:FindFirstChild("Map")
	local spots = map and map:FindFirstChild("LootSpots")
	if not spots then
		warn("[Loot] Workspace.Map.LootSpots não existe")
		return
	end
	for _, spot in spots:GetChildren() do
		if spot:IsA("BasePart") and rng:NextNumber() <= Config.Loot.SpotChance then
			local pick = pickWeighted(Config.Loot.Table, "Weight")
			Loot.Spawn({ Kind = pick.Kind, Id = pick.Id }, spot.Position)
			-- arma sempre vem com uma caixa da munição dela ao lado
			if pick.Kind == "Weapon" then
				local ammo = Config.Weapons[pick.Id].Ammo
				Loot.Spawn({ Kind = "Ammo", Id = ammo }, spot.Position + Vector3.new(2, 0, 1))
			end
			task.wait() -- não trava o servidor criando tudo de uma vez
		end
	end
end

function Loot.Clear()
	for _, child in folder:GetChildren() do
		child:Destroy()
	end
end

-- Tudo que o jogador tinha cai no chão em volta do corpo
function Loot.DropAll(player: Player, position: Vector3)
	local Combat = Registry.Combat
	local items = {}
	for _, tool in Combat.PlayerTools(player) do
		if tool:GetAttribute("WeaponId") then
			table.insert(items, { Kind = "Weapon", Id = tool:GetAttribute("WeaponId"), Rarity = tool:GetAttribute("Rarity"), Mag = tool:GetAttribute("Mag") })
		elseif tool:GetAttribute("ItemId") then
			table.insert(items, { Kind = "Item", Id = tool:GetAttribute("ItemId"), Amount = tool:GetAttribute("Count") })
		end
		tool:Destroy()
	end
	for ammoType in Config.AmmoTypes do
		local amount = player:GetAttribute("Ammo_" .. ammoType) or 0
		if amount > 0 then
			table.insert(items, { Kind = "Ammo", Id = ammoType, Amount = amount })
		end
	end
	Loot.DropList(items, position)
end

function Loot.DropList(items: { any }, position: Vector3)
	for i, info in items do
		local angle = (i / math.max(#items, 1)) * math.pi * 2
		local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (2 + #items * 0.25)
		-- acha o chão embaixo
		local origin = position + offset + Vector3.new(0, 4, 0)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		local map = workspace:FindFirstChild("Map")
		params.FilterDescendantsInstances = if map then { map } else {}
		local hit = workspace:Raycast(origin, Vector3.new(0, -60, 0), params)
		Loot.Spawn(info, if hit then hit.Position else position + offset)
	end
end

function Loot.Init()
	folder = Instance.new("Folder")
	folder.Name = "Loot"
	folder.Parent = workspace
end

return Loot
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Match</string>
          <string name="Source"><![CDATA[--[[
	Match: o ciclo da partida.
	  Lobby -> Countdown -> Match (salto de paraquedas, loot, zona) -> Ended -> Lobby
	Cada participante (jogador ou bot) é uma "entrada":
	  { Id, Player?, IsBot, Name, Model, Humanoid, Alive, Kills, Place }
	Atributos do Workspace para as telas: Phase, PhaseEndsAt, Alive, Total.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Registry = require(script.Parent.Registry)

local Match = {}

local entries: { any } = {}
local byPlayer: { [Player]: any } = {}
local byModel: { [Model]: any } = {}
local total = 0
local ended = false
local rng = Random.new()

local function setPhase(phase: string, endsAt: number?)
	workspace:SetAttribute("Phase", phase)
	workspace:SetAttribute("PhaseEndsAt", endsAt or 0)
end

function Match.Phase(): string
	return workspace:GetAttribute("Phase") or "Lobby"
end

function Match.EntryFor(player: Player): any
	return byPlayer[player]
end

function Match.EntryFromModel(model: Model): any
	return byModel[model]
end

function Match.AliveEntries(): { any }
	local list = {}
	for _, entry in entries do
		if entry.Alive then
			table.insert(list, entry)
		end
	end
	return list
end

local function aliveCount(): number
	return #Match.AliveEntries()
end

local function humansAlive(): number
	local n = 0
	for _, entry in entries do
		if entry.Alive and entry.Player then
			n += 1
		end
	end
	return n
end

local function updateCounts()
	workspace:SetAttribute("Alive", aliveCount())
	workspace:SetAttribute("Total", total)
end

-- Liga o modelo (personagem ou bot) à entrada e escuta a morte
function Match.BindModel(entry: any, model: Model)
	if entry.Model then
		byModel[entry.Model] = nil
	end
	entry.Model = model
	entry.Humanoid = model:FindFirstChildOfClass("Humanoid")
	byModel[model] = entry
	if entry.DiedConn then
		entry.DiedConn:Disconnect()
	end
	if entry.Humanoid then
		entry.DiedConn = entry.Humanoid.Died:Connect(function()
			Match.Eliminate(entry, "died")
		end)
	end
end

local function pickSpectateTarget(exclude: any?): any
	local alive = Match.AliveEntries()
	for _, entry in alive do
		if entry ~= exclude and entry.Player then
			return entry -- prefere assistir gente de verdade
		end
	end
	return alive[1]
end

local function sendSpectate(player: Player, target: any?)
	if target and target.Model then
		Registry.Remotes.SpectateTarget:FireClient(player, target.Model, target.Name)
	else
		Registry.Remotes.SpectateTarget:FireClient(player, nil, "")
	end
end

---------------------------------------------------------------------
-- Morte / eliminação
---------------------------------------------------------------------
function Match.Eliminate(entry: any, _reason: string)
	if not entry.Alive or ended then
		return
	end
	entry.Alive = false
	entry.Place = aliveCount() + 1
	local Combat = Registry.Combat
	local killer = entry.Humanoid and Combat.LastAttacker(entry.Humanoid)
	local root = entry.Model and entry.Model:FindFirstChild("HumanoidRootPart") :: BasePart?
	local position = if root then root.Position else nil

	-- killfeed
	if killer and killer ~= entry then
		killer.Kills += 1
		if killer.Player then
			killer.Player:SetAttribute("MatchKills", killer.Kills)
		end
		Registry.Remotes.Killfeed:FireAllClients("KILLFEED", { killer = killer.Name, victim = entry.Name })
	elseif entry.LastZoneDamage and os.clock() - entry.LastZoneDamage < 2 then
		Registry.Remotes.Killfeed:FireAllClients("KILLFEED_ZONE", { victim = entry.Name })
	else
		Registry.Remotes.Killfeed:FireAllClients("KILLFEED_FALL", { victim = entry.Name })
	end

	-- tudo cai no chão
	if position then
		if entry.Player then
			Registry.Loot.DropAll(entry.Player, position)
		else
			Registry.Bots.DropLoot(entry, position)
		end
	end

	if entry.Player then
		local player = entry.Player
		player:SetAttribute("InMatch", false)
		Match.GiveResult(entry, false)
		entry.Spectating = if killer and killer.Alive then killer else pickSpectateTarget(entry)
		sendSpectate(player, entry.Spectating)
	end
	-- quem estava assistindo esta pessoa passa para outra
	for _, other in entries do
		if other.Player and not other.Alive and other.Spectating == entry then
			other.Spectating = pickSpectateTarget()
			sendSpectate(other.Player, other.Spectating)
		end
	end
	updateCounts()
	Match.CheckEnd()
end

-- XP e estatísticas de quem saiu da partida (morreu ou venceu)
function Match.GiveResult(entry: any, won: boolean)
	local player = entry.Player
	if not player or entry.ResultGiven then
		return
	end
	entry.ResultGiven = true
	local profile = Registry.Data.Get(player)
	local xp = Config.XP.Match + entry.Kills * Config.XP.Kill + math.max(0, total - entry.Place) * Config.XP.PerPlaceAbove
	if won then
		xp += Config.XP.Win
	end
	local leveledTo = nil
	if profile then
		local data = profile.Data
		data.Matches += 1
		data.Kills += entry.Kills
		if won then
			data.Wins += 1
		else
			data.Deaths += 1
		end
		if data.BestPlace == 0 or entry.Place < data.BestPlace then
			data.BestPlace = entry.Place
		end
		data.XP += xp
		while data.XP >= Config.XPForLevel(data.Level) do
			data.XP -= Config.XPForLevel(data.Level)
			data.Level += 1
			leveledTo = data.Level
		end
		Match.PublishStats(player)
	end
	Registry.Remotes.Result:FireClient(player, {
		Place = entry.Place,
		Total = total,
		Kills = entry.Kills,
		XP = xp,
		Won = won,
		Level = leveledTo,
	})
end

function Match.PublishStats(player: Player)
	local profile = Registry.Data.Get(player)
	if not profile then
		return
	end
	local data = profile.Data
	player:SetAttribute("Level", data.Level)
	player:SetAttribute("XP", data.XP)
	player:SetAttribute("XPNeed", Config.XPForLevel(data.Level))
	player:SetAttribute("Wins", data.Wins)
	player:SetAttribute("TotalKills", data.Kills)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		(stats :: any).Wins.Value = data.Wins;
		(stats :: any).Kills.Value = data.Kills
	end
end

function Match.CheckEnd()
	if ended or Match.Phase() ~= "Match" then
		return
	end
	local alive = Match.AliveEntries()
	if #alive <= 1 then
		Match.End(alive[1])
	elseif Config.Match.EndWhenOnlyBots and humansAlive() == 0 then
		Match.End(nil, true)
	end
end

function Match.End(winner: any?, onlyBots: boolean?)
	if ended then
		return
	end
	ended = true
	Registry.Zone.Stop()
	setPhase("Ended", workspace:GetServerTimeNow() + Config.Match.EndDelay)
	if winner then
		winner.Place = 1
		if winner.Player then
			winner.Player:SetAttribute("InMatch", false)
			Match.GiveResult(winner, true)
		end
		Registry.Remotes.NotifyAll("WINNER_IS", { name = winner.Name }, "big")
	elseif onlyBots then
		Registry.Remotes.NotifyAll("BOTS_WON", nil, "big")
	end
end

---------------------------------------------------------------------
-- Começo da partida
---------------------------------------------------------------------
local function clearTools(player: Player)
	for _, tool in Registry.Combat.PlayerTools(player) do
		tool:Destroy()
	end
end

-- Paraquedas: força para cima que segura parte da gravidade até tocar o chão
local function giveParachute(character: Model)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "ParachuteAttachment"
	attachment.Parent = root
	local force = Instance.new("VectorForce")
	force.Name = "Parachute"
	force.Attachment0 = attachment
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.ApplyAtCenterOfMass = true
	force.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity * (1 - Config.Match.ParachuteGravity), 0)
	force.Parent = root
	-- velame colorido em cima da cabeça
	local canopy = Instance.new("Part")
	canopy.Name = "Canopy"
	canopy.Size = Vector3.new(9, 1.2, 6)
	canopy.Color = Color3.fromHSV(rng:NextNumber(), 0.7, 0.95)
	canopy.Material = Enum.Material.Fabric
	canopy.CanCollide = false
	canopy.CanQuery = false
	canopy.CanTouch = false
	canopy.Massless = true
	canopy.CFrame = root.CFrame * CFrame.new(0, 8, 0)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = canopy
	weld.Parent = canopy
	canopy.Parent = character
	task.spawn(function()
		local started = os.clock()
		task.wait(1)
		while character.Parent and humanoid.Health > 0 and os.clock() - started < 40 do
			if humanoid.FloorMaterial ~= Enum.Material.Air then
				break
			end
			task.wait(0.1)
		end
		force:Destroy()
		attachment:Destroy()
		canopy:Destroy()
	end)
end

local function randomDropPoint(center: Vector3): Vector3
	local angle = rng:NextNumber() * math.pi * 2
	local dist = math.sqrt(rng:NextNumber()) * (Config.Zone.StartRadius * 0.75)
	return center + Vector3.new(math.cos(angle) * dist, Config.Match.DropHeight, math.sin(angle) * dist)
end

local function start()
	ended = false
	table.clear(entries)
	table.clear(byPlayer)
	table.clear(byModel)

	Registry.Loot.SpawnAll()
	local center = Vector3.new(rng:NextNumber(-120, 120), 0, rng:NextNumber(-120, 120))

	-- humanos
	for _, player in Players:GetPlayers() do
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if Registry.Data.Get(player) and humanoid and humanoid.Health > 0 and #entries < Config.Match.MaxParticipants then
			local entry = { Id = "p" .. player.UserId, Player = player, IsBot = false, Name = player.DisplayName, Alive = true, Kills = 0, Place = 0 }
			table.insert(entries, entry)
			byPlayer[player] = entry
		end
	end
	-- bots completam
	local botsNeeded = math.clamp(Config.Match.FillWithBots - #entries, 0, Config.Match.MaxParticipants - #entries)
	local names = table.clone(Config.Bots.Names)
	for i = 1, botsNeeded do
		local name = table.remove(names, rng:NextInteger(1, #names)) or ("Bot_" .. i)
		table.insert(entries, { Id = "b" .. i, Player = nil, IsBot = true, Name = name, Alive = true, Kills = 0, Place = 0 })
	end
	total = #entries

	for _, entry in entries do
		if entry.Player then
			local player = entry.Player
			local character = player.Character :: Model
			local humanoid = character:FindFirstChildOfClass("Humanoid") :: Humanoid
			clearTools(player)
			Registry.Combat.ResetPlayer(player)
			humanoid.MaxHealth = Config.Player.MaxHealth
			humanoid.Health = Config.Player.MaxHealth
			character:SetAttribute("Shield", 0)
			player:SetAttribute("MatchKills", 0)
			player:SetAttribute("InMatch", true)
			Match.BindModel(entry, character)
			if Config.Match.StartWeapon then
				local tool = Registry.Combat.MakeWeaponTool(Config.Match.StartWeapon, "Common")
				tool.Parent = player:FindFirstChildOfClass("Backpack")
				for ammoType, amount in Config.Match.StartAmmo do
					Registry.Combat.AddAmmo(player, ammoType, amount)
				end
			end
			character:PivotTo(CFrame.new(randomDropPoint(center)))
			giveParachute(character)
		else
			Registry.Bots.Spawn(entry, Registry.Bots.GroundPoint(center))
			Match.BindModel(entry, entry.Model)
		end
	end
	Registry.Remotes.NotifyAll("MATCH_DROP", nil, "big")
	setPhase("Match")
	updateCounts()
	Registry.Zone.Start(center)
end

local function backToLobby()
	Registry.Bots.Cleanup()
	Registry.Loot.Clear()
	for _, entry in entries do
		if entry.DiedConn then
			entry.DiedConn:Disconnect()
		end
	end
	table.clear(entries)
	table.clear(byPlayer)
	table.clear(byModel)
	total = 0
	updateCounts()
	setPhase("Lobby")
	for _, player in Players:GetPlayers() do
		player:SetAttribute("InMatch", false)
		Registry.Combat.ResetPlayer(player)
		clearTools(player)
		task.spawn(function()
			pcall(function()
				player:LoadCharacter()
			end)
		end)
	end
end

local function humansReady(): number
	local n = 0
	for _, player in Players:GetPlayers() do
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if Registry.Data.Get(player) and humanoid and humanoid.Health > 0 then
			n += 1
		end
	end
	return n
end

---------------------------------------------------------------------
function Match.OnPlayerRemoving(player: Player)
	local entry = byPlayer[player]
	if entry and entry.Alive then
		Match.Eliminate(entry, "left")
	end
	byPlayer[player] = nil
end

function Match.Init()
	setPhase("Lobby")
	updateCounts()
	Registry.Remotes.Spectate.OnServerEvent:Connect(function(player: Player)
		local me = byPlayer[player]
		if not me or me.Alive then
			return
		end
		local alive = Match.AliveEntries()
		if #alive == 0 then
			return
		end
		local index = table.find(alive, me.Spectating) or 0
		me.Spectating = alive[index % #alive + 1]
		sendSpectate(player, me.Spectating)
	end)

	-- ciclo principal
	task.spawn(function()
		while true do
			local ok, err = pcall(function()
				-- LOBBY: espera gente suficiente
				setPhase("Lobby")
				while humansReady() < Config.Match.MinHumans do
					task.wait(1)
				end
				local lobbyEnds = workspace:GetServerTimeNow() + Config.Match.LobbyWait
				setPhase("Lobby", lobbyEnds)
				while workspace:GetServerTimeNow() < lobbyEnds do
					if humansReady() < Config.Match.MinHumans then
						return -- todo mundo saiu: recomeça a espera
					end
					task.wait(0.5)
				end
				local countdownEnds = workspace:GetServerTimeNow() + Config.Match.Countdown
				setPhase("Countdown", countdownEnds)
				task.wait(Config.Match.Countdown)
				if humansReady() < Config.Match.MinHumans then
					return
				end
				-- PARTIDA
				start()
				while not ended do
					task.wait(0.5)
					Match.CheckEnd()
				end
				task.wait(Config.Match.EndDelay)
				backToLobby()
			end)
			if not ok then
				warn("[Match] erro no ciclo:", err)
				ended = true
				pcall(Registry.Zone.Stop)
				pcall(backToLobby)
				task.wait(3)
			end
		end
	end)
end

return Match
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Registry</string>
          <string name="Source"><![CDATA[-- Tabela compartilhada para os módulos do servidor se encontrarem (evita require circular).
local Registry: any = {}
return Registry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Remotes: canais entre servidor e jogadores (todos criados aqui).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local function event(name: string, unreliable: boolean?): any
	local e = Instance.new(if unreliable then "UnreliableRemoteEvent" else "RemoteEvent")
	e.Name = name
	e.Parent = folder
	return e
end

Remotes.Fire = event("Fire") -- jogador -> servidor: (aimPoint: Vector3, aiming: boolean)
Remotes.Reload = event("Reload") -- jogador -> servidor: ()
Remotes.Spectate = event("Spectate") -- jogador -> servidor: () pede o próximo para assistir
Remotes.Effect = event("Effect", true) -- servidor -> jogadores: efeitos visuais (tracer, acerto...)
Remotes.Notify = event("Notify") -- servidor -> jogador(es): (chave do texto, args, tipo)
Remotes.Killfeed = event("Killfeed") -- servidor -> todos: (chave, args)
Remotes.Result = event("Result") -- servidor -> jogador: fim de partida { Place, Total, Kills, XP, Won, Winner }
Remotes.SpectateTarget = event("SpectateTarget") -- servidor -> jogador: (Model?, nome)

folder.Parent = ReplicatedStorage

function Remotes.NotifyPlayer(player: Player, key: string, args: { [string]: any }?, kind: string?)
	Remotes.Notify:FireClient(player, key, args or {}, kind or "info")
end

function Remotes.NotifyAll(key: string, args: { [string]: any }?, kind: string?)
	Remotes.Notify:FireAllClients(key, args or {}, kind or "info")
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Zone</string>
          <string name="Source"><![CDATA[--[[
	Zone: a tempestade que fecha (Config.Zone.Phases). Quem fica fora toma dano por segundo.
	Os números ficam em atributos do Workspace; cada tela desenha a parede da zona sozinha (ZoneMath).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local ZoneMath = require(ReplicatedStorage.Shared.ZoneMath)
local Registry = require(script.Parent.Registry)

local Zone = {}

local rng = Random.new()
local runId = 0
local damagePerSecond = 0

local function set(cx, cz, r, ncx, ncz, nr, shrinkStart, shrinkEnd, stage)
	workspace:SetAttribute("ZoneCX", cx)
	workspace:SetAttribute("ZoneCZ", cz)
	workspace:SetAttribute("ZoneR", r)
	workspace:SetAttribute("ZoneNCX", ncx)
	workspace:SetAttribute("ZoneNCZ", ncz)
	workspace:SetAttribute("ZoneNR", nr)
	workspace:SetAttribute("ZoneShrinkStart", shrinkStart)
	workspace:SetAttribute("ZoneShrinkEnd", shrinkEnd)
	workspace:SetAttribute("ZoneStage", stage)
end

function Zone.Stop()
	runId += 1
	damagePerSecond = 0
	set(0, 0, Config.Zone.StartRadius, 0, 0, Config.Zone.StartRadius, 0, 0, 0)
	workspace:SetAttribute("ZonePhaseEnds", 0)
end

-- Começa a sequência de fases (roda até a partida acabar)
function Zone.Start(center: Vector3)
	runId += 1
	local myRun = runId
	local cx, cz, r = center.X, center.Z, Config.Zone.StartRadius
	set(cx, cz, r, cx, cz, r, 0, 0, 1)
	task.spawn(function()
		for index, phase in Config.Zone.Phases do
			if runId ~= myRun then
				return
			end
			-- escolhe o próximo círculo inteiro dentro do atual
			local maxOffset = math.max(0, r - phase.Radius)
			local angle = rng:NextNumber() * math.pi * 2
			local dist = math.sqrt(rng:NextNumber()) * maxOffset
			local ncx, ncz = cx + math.cos(angle) * dist, cz + math.sin(angle) * dist
			local now = workspace:GetServerTimeNow()
			local shrinkStart = now + phase.Wait
			local shrinkEnd = shrinkStart + phase.Shrink
			set(cx, cz, r, ncx, ncz, phase.Radius, shrinkStart, shrinkEnd, index)
			workspace:SetAttribute("ZonePhaseEnds", shrinkStart)
			damagePerSecond = if index == 1 then 1 else Config.Zone.Phases[index - 1].Damage
			task.wait(phase.Wait)
			if runId ~= myRun then
				return
			end
			workspace:SetAttribute("ZonePhaseEnds", shrinkEnd)
			damagePerSecond = phase.Damage
			task.wait(phase.Shrink)
			if runId ~= myRun then
				return
			end
			cx, cz, r = ncx, ncz, phase.Radius
		end
		-- última zona: fica parada e o dano continua
		set(cx, cz, r, cx, cz, r, 0, 0, #Config.Zone.Phases + 1)
		workspace:SetAttribute("ZonePhaseEnds", 0)
	end)
end

function Zone.Init()
	Zone.Stop()
	-- dano de quem está fora, 1 vez por segundo (ignora escudo)
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(function()
				if (workspace:GetAttribute("ZoneStage") or 0) <= 0 or damagePerSecond <= 0 then
					return
				end
				for _, entry in Registry.Match.AliveEntries() do
					local root = entry.Model and entry.Model:FindFirstChild("HumanoidRootPart") :: BasePart?
					if root and not ZoneMath.IsInside(root.Position) then
						entry.LastZoneDamage = os.clock()
						Registry.Combat.Damage(entry, damagePerSecond, nil, true)
					end
				end
			end)
			if not ok then
				warn("[Zone] erro:", err)
			end
		end
	end)
end

return Zone
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="23">
      <Properties>
        <string name="Name">Main</string>
        <string name="Source"><![CDATA[--[[
	ZONA ZERO - script principal do servidor (Script "Main" em ServerScriptService).
	Liga os módulos da pasta "Game" e cuida da entrada/saída dos jogadores.
	Pra ajustar o jogo, mexa em ReplicatedStorage > Shared > Config.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local GameFolder = script.Parent:WaitForChild("Game")
local Registry = require(GameFolder.Registry)

Registry.Remotes = require(GameFolder.Remotes)
Registry.Data = require(GameFolder.Data)
Registry.Combat = require(GameFolder.Combat)
Registry.Loot = require(GameFolder.Loot)
Registry.Zone = require(GameFolder.Zone)
Registry.Bots = require(GameFolder.Bots)
Registry.Match = require(GameFolder.Match)

Players.CharacterAutoLoads = false -- o jogo decide quando cada um nasce (lobby / partida)

-- Cada sistema liga sozinho; se um der erro, os outros continuam
for _, name in { "Combat", "Loot", "Zone", "Bots", "Match" } do
	local ok, err = pcall(Registry[name].Init)
	if not ok then
		warn("[Main] " .. name .. ".Init falhou:", err)
	end
end

local function onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	humanoid.WalkSpeed = Config.Player.WalkSpeed
	humanoid.UseJumpPower = true
	humanoid.JumpPower = Config.Player.JumpPower
	humanoid.MaxHealth = Config.Player.MaxHealth
	humanoid.Health = Config.Player.MaxHealth
	humanoid.BreakJointsOnDeath = false
	character:SetAttribute("Shield", 0)
	-- morreu fora de uma partida (no lobby): renasce. Quem morreu NA partida espera ela acabar.
	humanoid.Died:Connect(function()
		task.wait(4)
		if player.Parent and player.Character == character and not Registry.Match.EntryFor(player) then
			player:LoadCharacter()
		end
	end)
end

local function onPlayerAdded(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local wins = Instance.new("IntValue")
	wins.Name = "Wins"
	wins.Parent = stats
	local kills = Instance.new("IntValue")
	kills.Name = "Kills"
	kills.Parent = stats
	stats.Parent = player

	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)

	local profile = Registry.Data.Load(player)
	if not player.Parent then
		if profile.CanSave then
			Registry.Data.Save(player, true)
		end
		Registry.Data.Remove(player)
		return
	end
	if not profile.CanSave and not RunService:IsStudio() then
		player:Kick("Couldn't load your save (Roblox servers are busy). Your progress is safe - please rejoin!")
		return
	end
	Registry.Match.PublishStats(player)
	Registry.Combat.ResetPlayer(player)
	player:SetAttribute("Loaded", true)
	player:LoadCharacter() -- nasce no lobby (SpawnLocation do lobby)
end

local function onPlayerRemoving(player: Player)
	pcall(Registry.Match.OnPlayerRemoving, player)
	Registry.Data.Save(player, true)
	Registry.Data.Remove(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- Salva todo mundo de tempos em tempos
task.spawn(function()
	while true do
		task.wait(60)
		for _, player in Players:GetPlayers() do
			task.spawn(Registry.Data.Save, player)
		end
	end
end)

-- Salva quando o servidor fecha
game:BindToClose(function()
	local pending = 0
	for _, player in Players:GetPlayers() do
		pending += 1
		task.spawn(function()
			Registry.Data.Save(player, true)
			pending -= 1
		end)
	end
	local started = os.clock()
	while (pending > 0 or Registry.Data.ActiveSaves() > 0) and os.clock() - started < 25 do
		task.wait(0.1)
	end
end)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="SoundService" referent="24">
